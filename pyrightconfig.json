{
  "include": [
    "src/agents",
    "src/_agents_shared",
    "packages/codex/src/_agents_codex",
    "packages/codex/tests/test_native_agent_typing.py",
    "packages/codex/tests/test_native_agent_checkpoint_typing.py",
    "packages/codex/tests/test_native_mcp_typing.py",
    "packages/codex/tests/test_native_mcp_mypy.py",
    "packages/codex/tests/test_native_manual_tools_typing.py"
  ],
  "exclude": [
    "packages/codex/tests/test_native_agent_typing_errors.py"
  ],
  "extraPaths": [
    "src",
    "packages/codex/src",
    "packages/codex"
  ],
  "pythonVersion": "3.10",
  "typeCheckingMode": "basic",
  "reportMissingImports": "error",
  "reportPrivateImportUsage": "none",
  "reportUnsupportedDunderAll": "none",
  "executionEnvironments": [
    {
      "root": "src/agents/classic",
      "reportAttributeAccessIssue": "none",
      "reportArgumentType": "none",
      "reportGeneralTypeIssues": "none",
      "reportIndexIssue": "none",
      "reportTypedDictNotRequiredAccess": "none"
    },
    {
      "root": "."
    }
  ]
}
