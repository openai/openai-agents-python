+/// Carries start-only attachment policy through the existing submission envelope.
+/// PreparedTurnInputSettings unwraps this before storing the original initializer.
+#[derive(Debug)]
+pub(crate) struct NewTurnOnlyData(pub(crate) ExtensionDataInit);
+
+impl WithTurnExtensionData<codex_protocol::turn_input::TurnInputRequest> {
+    /// Replaces saved host data only when this request starts a new turn.
+    /// Steering preserves the previously saved initializer.
+    pub fn new_turn_only(
+        request: codex_protocol::turn_input::TurnInputRequest,
+        turn_extension_init: ExtensionDataInit,
+    ) -> Self {
+        let mut init = ExtensionDataInit::new();
+        init.insert(NewTurnOnlyData(turn_extension_init));
+        Self::new(request, init)
+    }
+}
