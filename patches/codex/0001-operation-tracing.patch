+use crate::JsonSchema;
+use crate::TS;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+
+/// Per-turn operation observation, delivered only to its initiating connection.
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum OperationTracingMode {
+    Metadata,
+    Content,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum OperationTracingKind {
+    Model,
+    Tool,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum OperationTracingOutcome {
+    Success,
+    Error,
+    Interrupted,
+}
+
+/// Content projected before delivery, with explicit capture completeness.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct OperationTracingContent {
+    pub value: Value,
+    pub truncated: bool,
+    pub omitted: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub reason: Option<String>,
+}
+
+/// Source operation facts. Times are UTC RFC 3339, duration uses a monotonic clock.
+/// Input and output are absent in metadata mode and must never enter logs or history.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct OperationTracingNotification {
+    pub operation_id: String,
+    pub thread_id: String,
+    pub turn_id: String,
+    pub kind: OperationTracingKind,
+    pub started_at: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub completed_at: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub duration_ms: Option<f64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub outcome: Option<OperationTracingOutcome>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub parent_operation_id: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub requested_model: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub observed_model: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub response_id: Option<String>,
+    #[serde(default)]
+    pub response_id_trusted: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub usage: Option<Value>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub tool_name: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub call_id: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub input: Option<OperationTracingContent>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub output: Option<OperationTracingContent>,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::TurnStartParams;
+    use crate::experimental_api::ExperimentalApi;
+    use serde_json::json;
+
+    #[test]
+    fn opt_in_requires_experimental_capability() {
+        let request: TurnStartParams = serde_json::from_value(json!({
+            "threadId": "thread", "input": [], "operationTracing": "metadata"
+        }))
+        .unwrap();
+        assert_eq!(
+            request.operation_tracing,
+            Some(OperationTracingMode::Metadata)
+        );
+        assert_eq!(
+            request.experimental_reason(),
+            Some("turn/start.operationTracing")
+        );
+        let request: TurnStartParams =
+            serde_json::from_value(json!({"threadId": "thread", "input": []})).unwrap();
+        assert!(request.operation_tracing.is_none());
+    }
+
+    #[test]
+    fn metadata_notification_roundtrip_preserves_source_identity() {
+        let value = json!({
+            "operationId": "op", "threadId": "thread", "turnId": "turn",
+            "kind": "model", "startedAt": "2026-11-20T00:00:00.000Z",
+            "requestedModel": "test-model", "responseIdTrusted": false
+        });
+        let notification: OperationTracingNotification =
+            serde_json::from_value(value.clone()).unwrap();
+        assert!(notification.input.is_none());
+        assert!(notification.output.is_none());
+        assert_eq!(serde_json::to_value(notification).unwrap(), value);
+    }
+}
