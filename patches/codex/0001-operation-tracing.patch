+        ));
+        let mut first_waiter = observer.turn_finished("thread", "turn");
+        assert!(futures::poll!(&mut first_waiter).is_pending());
+        drop(first_waiter);
+        let second_waiter = observer.turn_finished("thread", "turn");
+        let receive_operations = async {
+            for expected in ["turn/operation/started", "turn/operation/completed"] {
+                let OutgoingEnvelope::ToConnection { message, .. } = receiver.recv().await.unwrap()
+                else {
+                    panic!("expected owner delivery");
+                };
+                assert_eq!(serde_json::to_value(message).unwrap()["method"], expected);
+            }
+        };
+        tokio::time::timeout(std::time::Duration::from_secs(1), async {
+            tokio::join!(second_waiter, receive_operations);
+        })
+        .await
+        .unwrap();
+    }
+}
