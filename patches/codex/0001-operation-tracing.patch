index 0000000..d07036a
--- /dev/null
+++ b/codex-rs/core/src/tools/operation_observation.rs
@@ -0,0 +1,174 @@
+//! Execution observations, separate from admission, approval, and result hooks.
+
+use std::sync::Arc;
+use std::sync::Mutex;
+
+use serde::Serialize;
+use serde_json::Value;
+
+use crate::function_tool::FunctionCallError;
+use crate::operation_observation::OperationGuard;
+use crate::operation_observation::OperationKind;
+use crate::operation_observation::OperationMetadata;
+use crate::operation_observation::OperationObservation;
+use crate::operation_observation::OperationOutcome;
+use crate::tools::context::ToolCallSource;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolOutput;
+use crate::tools::context::ToolPayload;
+use crate::tools::registry::CoreToolRuntime;
+
+tokio::task_local! {
+    static CURRENT_EXECUTION: Arc<ExecutionObservation>;
+}
+
+struct ExecutionObservation {
+    observation: Arc<OperationObservation>,
+    thread_id: String,
+    turn_id: String,
+    metadata: OperationMetadata,
+    input: Option<Value>,
+    guard: Mutex<Option<OperationGuard>>,
+}
+
+impl ExecutionObservation {
+    fn start(&self, input: Option<&Value>) {
+        let mut guard = self
+            .guard
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        // Sandbox retries still belong to the same native tool execution.
+        if guard.is_some() {
+            return;
+        }
+        let started = self.observation.start(
+            self.thread_id.clone(),
+            self.turn_id.clone(),
+            OperationKind::Tool,
+            self.metadata.clone(),
+        );
+        if let Some(input) = input.or(self.input.as_ref()) {
+            started.capture_input(input);
+        }
+        *guard = Some(started);
+    }
+
+    fn operation_id(&self) -> Option<String> {
+        self.guard
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .as_ref()
+            .map(|guard| guard.operation_id().to_string())
+    }
+
+    fn finish(
+        &self,
+        invocation: &ToolInvocation,
+        result: &Result<Box<dyn ToolOutput>, FunctionCallError>,
+    ) {
+        let guard = self
+            .guard
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let Some(guard) = guard.as_ref() else {
+            // A rejected approval has not executed a tool.
+            return;
+        };
+        let outcome = if invocation.cancellation_token.is_cancelled() {
+            OperationOutcome::Interrupted
+        } else if result
+            .as_ref()
+            .is_ok_and(|output| output.success_for_logging())
+        {
+            OperationOutcome::Success
+        } else {
+            OperationOutcome::Error
+        };
+        guard.finish_with_output_fn(outcome, || match result {
+            Ok(output) => output.code_mode_result(&invocation.payload),
+            Err(error) => serde_json::json!({"error": error.to_string()}),
+        });
+    }
+}
+
+/// Called immediately before an approved sandbox or MCP execution starts.
+pub(crate) fn start_current_execution() {
+    let _ = CURRENT_EXECUTION.try_with(|execution| execution.start(None));
+}
+
+/// MCP preparation can rewrite arguments before sending them to the server.
+pub(crate) fn start_current_execution_with_input(input: &impl Serialize) {
+    let _ = CURRENT_EXECUTION.try_with(|execution| {
+        let input = execution
+            .observation
+            .captures_content()
+            .then(|| serde_json::to_value(input).ok())
+            .flatten();
+        execution.start(input.as_ref());
+    });
+}
+
+pub(crate) fn current_tool_operation_id() -> Option<String> {
+    CURRENT_EXECUTION
+        .try_with(|execution| execution.operation_id())
+        .ok()
+        .flatten()
+}
+
+pub(crate) async fn observe_execution(
+    tool: &dyn CoreToolRuntime,
+    invocation: &ToolInvocation,
+) -> Result<Box<dyn ToolOutput>, FunctionCallError> {
+    let Some(observation) = invocation.turn.extension_data.get::<OperationObservation>() else {
+        return tool.handle(invocation.clone()).await;
+    };
+    if tool.is_client_tool_handoff() {
+        return tool.handle(invocation.clone()).await;
+    }
+
+    let parent_operation_id = match &invocation.source {
+        ToolCallSource::CodeMode { cell_id, .. } => invocation
+            .session
+            .services
+            .code_mode_service
+            .cell_originating_call(&codex_code_mode::CellId::new(cell_id.clone()))
+            .and_then(|origin| origin.operation_id),
+        _ => current_tool_operation_id(),
+    };
+    let input = observation
+        .captures_content()
+        .then(|| match &invocation.payload {
+            ToolPayload::Function { arguments } => {
+                serde_json::from_str(arguments).unwrap_or_else(|_| Value::String(arguments.clone()))
+            }
+            ToolPayload::Custom { input } => Value::String(input.clone()),
+            ToolPayload::ToolSearch { arguments } => {
+                serde_json::to_value(arguments).unwrap_or(Value::Null)
+            }
+        });
+    let execution = Arc::new(ExecutionObservation {
+        observation,
+        thread_id: invocation.session.thread_id.to_string(),
+        turn_id: invocation.turn.sub_id.clone(),
+        metadata: OperationMetadata {
+            tool_name: Some(crate::tools::flat_tool_name(&invocation.tool_name).into_owned()),
+            call_id: Some(invocation.call_id.clone()),
+            parent_operation_id,
+            ..Default::default()
+        },
+        input,
+        guard: Mutex::new(None),
+    });
+    if !tool.approves_inside_handler() {
+        execution.start(None);
+    }
+    let result = CURRENT_EXECUTION
+        .scope(Arc::clone(&execution), tool.handle(invocation.clone()))
+        .await;
+    execution.finish(invocation, &result);
+    result
+}
