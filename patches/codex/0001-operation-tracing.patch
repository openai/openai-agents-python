+#[tokio::test]
+async fn abort_emits_one_interrupted_terminal() {
+    let (invocation, events) = fixture(OperationCaptureMode::Metadata).await;
+    let entered = Arc::new(Notify::new());
+    let handler = Handler {
+        entered: Some(Arc::clone(&entered)),
+        complete: Some(Arc::new(Notify::new())),
+        ..Default::default()
+    };
+    let task = tokio::spawn(async move { observe_execution(&handler, &invocation).await });
+    entered.notified().await;
+    task.abort();
+    assert!(task.await.err().unwrap().is_cancelled());
+    let events = events.0.lock().unwrap();
+    assert_eq!(events.len(), 2);
+    assert_eq!(events[0].operation_id, events[1].operation_id);
+    assert_eq!(events[1].outcome, Some(OperationOutcome::Interrupted));
+}
