+        hook_command: None,
+        tool_cwd: None,
+    };
+    assert_eq!(
+        output.bounded_code_mode_result(&payload, 1024),
+        Ok(output.code_mode_result(&payload))
+    );
+    output.raw_output.text = "x".repeat(1024 * 1024);
+    assert_eq!(
+        output.bounded_code_mode_result(&payload, 1024),
+        Err("capture_budget")
+    );
+    output.max_output_tokens = Some(1);
+    assert_eq!(
+        output.bounded_code_mode_result(&payload, 1024),
+        Err("capture_budget")
+    );
+}
