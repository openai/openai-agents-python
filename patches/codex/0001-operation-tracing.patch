+tokio::task_local! {
+    static CURRENT_MODEL_OPERATION: ModelOperation;
+}
+
+pub struct OperationGuard {
+    operation_id: String,
+    observation: OperationObservation,
+    started: Instant,
+    state: Mutex<OperationEvent>,
+}
+
+impl OperationGuard {
+    pub fn operation_id(&self) -> &str {
+        &self.operation_id
+    }
+
+    pub fn capture_input<T: Serialize + ?Sized>(&self, value: &T) {
+        if self.observation.mode == OperationCaptureMode::Content {
+            self.update(|event| event.input = Some(project_content(value)));
+        }
+    }
+
+    pub fn capture_output<T: Serialize + ?Sized>(&self, value: &T) {
+        if self.observation.mode == OperationCaptureMode::Content {
+            self.update(|event| event.output = Some(project_content(value)));
+        }
+    }
+
+    fn update(&self, update: impl FnOnce(&mut OperationEvent)) {
+        let mut event = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if event.phase == OperationPhase::Started {
+            update(&mut event);
+        }
+    }
+
+    pub fn finish_with_output_fn<T: Serialize>(
+        &self,
+        outcome: OperationOutcome,
+        output: impl FnOnce() -> T,
+    ) {
+        let completed_at = timestamp();
+        let duration_ms = self.started.elapsed().as_secs_f64() * 1000.0;
+        if self.observation.captures_content() {
+            self.capture_output(&output());
+        }
+        self.finish_at(outcome, completed_at, duration_ms);
+    }
+
+    pub fn finish_with_output<T: Serialize + ?Sized>(&self, outcome: OperationOutcome, output: &T) {
+        let completed_at = timestamp();
+        let duration_ms = self.started.elapsed().as_secs_f64() * 1000.0;
+        self.capture_output(output);
+        self.finish_at(outcome, completed_at, duration_ms);
+    }
+
+    pub fn finish(&self, outcome: OperationOutcome) {
+        self.finish_at(
+            outcome,
+            timestamp(),
+            self.started.elapsed().as_secs_f64() * 1000.0,
+        );
+    }
+
+    fn finish_at(&self, outcome: OperationOutcome, completed_at: String, duration_ms: f64) {
+        let terminal = {
+            let mut event = self
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if event.phase == OperationPhase::Completed {
+                return;
+            }
+            event.phase = OperationPhase::Completed;
+            event.completed_at = Some(completed_at);
+            event.duration_ms = Some(duration_ms);
+            event.outcome = Some(outcome);
+            event.clone()
+        };
+        self.observation.emit(terminal);
+    }
+}
+
+impl Drop for OperationGuard {
+    fn drop(&mut self) {
+        self.finish(OperationOutcome::Interrupted);
+    }
+}
+
+fn timestamp() -> String {
+    Utc::now().to_rfc3339_opts(SecondsFormat::Millis, true)
+}
+
+/// Projects JSON in memory, omitting binary/hidden reasoning and transport secrets.
+/// Inline markers survive consumers that extract values from the wire envelope.
+pub fn project_content<T: Serialize + ?Sized>(value: &T) -> OperationContent {
+    let value = match serde_json::to_value(value) {
+        Ok(value) => value,
+        Err(_) => return omitted_content("serialization_failed"),
+    };
+    let mut projection = ContentProjection {
+        truncated: false,
+        omitted: false,
+    };
+    let value = projection.project(value, CONTENT_LIMIT_BYTES - 256, 0);
+    let content = OperationContent {
+        value,
+        truncated: projection.truncated,
+        omitted: projection.omitted,
+        reason: if projection.truncated {
+            Some("capture_budget".into())
+        } else if projection.omitted {
+            Some("unsupported_content".into())
+        } else {
+            None
+        },
+    };
+    if json_size(&content) <= CONTENT_LIMIT_BYTES {
+        content
+    } else {
+        omitted_content("capture_budget")
+    }
+}
+
+fn omitted_content(reason: &str) -> OperationContent {
+    OperationContent {
+        value: serde_json::json!({"omitted":true,"reason":reason}),
+        truncated: reason == "capture_budget",
+        omitted: true,
+        reason: Some(reason.into()),
+    }
+}
+
+fn json_size(value: &(impl Serialize + ?Sized)) -> usize {
+    serde_json::to_vec(value).map_or(usize::MAX, |value| value.len())
+}
+
+struct ContentProjection {
+    truncated: bool,
+    omitted: bool,
+}
+
+impl ContentProjection {
+    fn project(&mut self, value: Value, budget: usize, depth: usize) -> Value {
+        if depth > 32 {
+            self.truncated = true;
+            return Value::String("[truncated]".into());
+        }
+        match value {
+            Value::String(text) => self.text(text, budget, depth),
+            Value::Array(items) => {
+                let mut result = Vec::new();
+                let mut used: usize = 2;
+                for item in items {
+                    let available = budget.saturating_sub(used + 34);
+                    if available < 84 {
+                        self.truncated = true;
+                        result.push(serde_json::json!({"truncated":true}));
+                        break;
+                    }
+                    let item = self.project(item, available, depth + 1);
+                    used += json_size(&item) + 2;
+                    result.push(item);
+                }
+                Value::Array(result)
+            }
+            Value::Object(items) => {
+                self.truncated |= items.get("truncated") == Some(&Value::Bool(true));
+                self.omitted |= items.get("omitted") == Some(&Value::Bool(true));
+                let kind = items.get("type").and_then(Value::as_str);
+                let binary_resource = kind == Some("resource")
+                    && items
+                        .get("resource")
+                        .and_then(|value| value.get("blob"))
+                        .is_some();
+                if binary_resource
+                    || kind.is_some_and(|kind| {
+                        matches!(
+                            kind,
+                            "reasoning"
+                                | "reasoning_text"
+                                | "thinking"
+                                | "redacted_thinking"
+                                | "compaction"
+                                | "encrypted_content"
+                                | "image"
+                                | "input_image"
+                                | "output_image"
+                                | "image_url"
+                                | "computer_screenshot"
+                                | "image_generation_call"
+                                | "audio"
+                                | "input_audio"
+                                | "output_audio"
+                                | "file"
+                                | "input_file"
+                                | "video"
+                                | "input_video"
+                        )
+                    })
+                {
+                    self.omitted = true;
+                    return serde_json::json!({"type":kind,"omitted":true,"reason":"unsupported_content"});
+                }
+                let mut result = serde_json::Map::new();
+                let mut used: usize = 2;
+                let mut items: Vec<_> = items.into_iter().collect();
+                items.sort_by_key(|(key, _)| {
+                    !matches!(key.as_str(), "type" | "role" | "id" | "call_id" | "name")
+                });
+                for (key, value) in items {
+                    let available = budget.saturating_sub(used + json_size(&key) + 36);
+                    if available < 84 {
+                        self.truncated = true;
+                        result.insert("truncated".into(), Value::Bool(true));
+                        break;
+                    }
+                    let normalized = key.to_ascii_lowercase().replace(['-', '_'], "");
+                    let value = if matches!(
+                        normalized.as_str(),
+                        "apikey"
+                            | "xapikey"
+                            | "authorization"
+                            | "accesstoken"
+                            | "refreshtoken"
+                            | "password"
+                            | "headers"
+                            | "clientmetadata"
+                            | "encryptedcontent"
+                            | "reasoning"
+                            | "reasoningcontent"
+                            | "reasoningdetails"
+                            | "thinking"
+                            | "imageurl"
+                            | "filedata"
+                            | "imagedata"
+                            | "audiodata"
+                            | "b64json"
+                    ) {
+                        self.omitted = true;
+                        Value::String("[omitted]".into())
+                    } else {
+                        self.project(value, available, depth + 1)
+                    };
+                    used += json_size(&key) + json_size(&value) + 4;
+                    result.insert(key, value);
+                }
+                Value::Object(result)
+            }
+            value => value,
+        }
+    }
+
+    fn text(&mut self, text: String, budget: usize, depth: usize) -> Value {
+        static DATA_URI: std::sync::LazyLock<regex_lite::Regex> = std::sync::LazyLock::new(|| {
+            regex_lite::Regex::new(r#"(?i)data:[^\s;,]+(?:;[^\s,]*)?,[^\s\"'<>]+"#)
+                .expect("valid data URI pattern")
+        });
+        self.truncated |= text.ends_with("[truncated]");
+        self.omitted |= text.contains("[omitted]") || text.contains("[omitted: media]");
+        if text.trim_start().starts_with(['{', '[']) {
+            if let Ok(embedded) = serde_json::from_str::<Value>(&text) {
+                let safe = self.project(embedded.clone(), budget, depth + 1);
+                if safe == embedded && json_size(&text) <= budget {
+                    return Value::String(text);
+                }
+                let mut encoded = safe.to_string();
+                if json_size(&encoded) > budget {
+                    // Rebudget the value so escaped JSON remains valid.
+                    encoded = self
+                        .project(embedded, budget.saturating_sub(2) / 2, depth + 1)
+                        .to_string();
+                }
+                return Value::String(encoded);
+            }
+        }
+        let projected = DATA_URI.replace_all(&text, "[omitted: media]");
+        self.omitted |= projected != text;
+        let text = projected.into_owned();
+        if json_size(&text) <= budget {
+            return Value::String(text);
+        }
+        self.truncated = true;
+        let mut low = 0;
+        let mut high = text.len().min(budget);
+        while low < high {
+            let middle = low + (high - low + 1) / 2;
+            let mut end = middle;
+            while !text.is_char_boundary(end) {
+                end -= 1;
+            }
+            if json_size(&format!("{}[truncated]", &text[..end])) <= budget {
+                low = middle;
+            } else {
+                high = middle - 1;
+            }
+        }
+        while !text.is_char_boundary(low) {
+            low -= 1;
+        }
+        Value::String(format!("{}[truncated]", &text[..low]))
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct ModelOperation {
+    observation: Arc<OperationObservation>,
+    thread_id: String,
+    turn_id: String,
+    requested_model: String,
+    stream_generation: Option<u64>,
+    state: Arc<Mutex<ModelOperationState>>,
+}
+
+#[derive(Default)]
+struct ModelOperationState {
+    guard: Option<OperationGuard>,
+    output: Vec<Value>,
+    output_bytes: usize,
+    partial_text: String,
+    partial_truncated: bool,
+    fingerprint: Option<u64>,
+    generation: u64,
+    source_end: Option<(String, f64)>,
+    retry_waiting: bool,
+    authoritative_model: bool,
+}
+
+impl ModelOperation {
+    pub(crate) fn new(
+        observation: Arc<OperationObservation>,
+        thread_id: String,
+        turn_id: String,
+        requested_model: String,
+    ) -> Self {
+        Self {
+            observation,
+            thread_id,
+            turn_id,
+            requested_model,
+            stream_generation: None,
+            state: Arc::new(Mutex::new(ModelOperationState::default())),
+        }
+    }
+
+    pub(crate) async fn scope<F: Future>(&self, future: F) -> F::Output {
+        CURRENT_MODEL_OPERATION.scope(self.clone(), future).await
+    }
+
+    pub(crate) fn finish(&self, outcome: OperationOutcome) {
+        // Only the source response.completed event establishes inference success.
+        // An outer successful turn handoff can still have preempted this stream.
+        let outcome = if outcome == OperationOutcome::Success {
+            OperationOutcome::Interrupted
+        } else {
+            outcome
+        };
+        let state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(guard) = &state.guard {
+            if let Some((completed_at, duration_ms)) = &state.source_end
+                && (outcome != OperationOutcome::Interrupted || !state.retry_waiting)
+            {
+                if self.observation.captures_content() {
+                    guard.capture_output(&model_output(&state));
+                }
+                guard.finish_at(outcome, completed_at.clone(), *duration_ms);
+            } else {
+                guard.finish_with_output_fn(outcome, || model_output(&state));
+            }
+        }
+    }
+
+    pub(crate) fn interruption_guard(&self) -> ModelInterruptionGuard {
+        ModelInterruptionGuard(self.clone())
+    }
+
+    pub(crate) fn retry_waiting(&self, waiting: bool) {
+        self.state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .retry_waiting = waiting;
+    }
+
+    pub(crate) fn source_ended(&self) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if self
+            .stream_generation
+            .is_some_and(|generation| generation != state.generation)
+        {
+            return;
+        }
+        if state.source_end.is_none() {
+            let source_end = state
+                .guard
+                .as_ref()
+                .map(|guard| (timestamp(), guard.started.elapsed().as_secs_f64() * 1000.0));
+            if source_end.is_some() {
+                state.source_end = source_end;
+            }
+        }
+    }
+
+    pub(crate) fn source_error(&self, error: &codex_api::ApiError) {
+        self.source_ended();
+        let state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if self
+            .stream_generation
+            .is_some_and(|generation| generation != state.generation)
+        {
+            return;
+        }
+        if let codex_api::ApiError::ResponseIncomplete(incomplete) = error
+            && let Some(guard) = &state.guard
+        {
+            guard.update(|event| {
+                event.metadata.response_id = incomplete.response_id.clone();
+                event.metadata.usage = incomplete
+                    .token_usage
+                    .as_ref()
+                    .and_then(|usage| serde_json::to_value(usage).ok());
+            });
+        }
+    }
+
+    fn request<T: Serialize + ?Sized>(
+        &self,
+        request: &T,
+        identity: &impl Serialize,
+        endpoint: &str,
+    ) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.generation = state.generation.wrapping_add(1);
+        let previous_source_end = state.source_end.take();
+        state.retry_waiting = false;
+        state.authoritative_model = false;
+        // Exclude routing metadata and changing transport fields from retry identity.
+        let fingerprint = request_fingerprint(identity);
+        if state.guard.is_some() && state.fingerprint == Some(fingerprint) {
+            if let Some(guard) = &state.guard {
+                guard.update(|event| {
+                    event.metadata.response_id = None;
+                    event.metadata.observed_model = None;
+                    event.metadata.usage = None;
+                    event.metadata.response_id_trusted = trusted_response_endpoint(endpoint);
+                });
+                if self.observation.captures_content() {
+                    guard.capture_input(&model_request_content(request));
+                }
+            }
+            // A retried stream replaces any partial output from the failed attempt.
+            state.output.clear();
+            state.output_bytes = 0;
+            state.partial_text.clear();
+            state.partial_truncated = false;
+            return;
+        }
+        if let Some(previous) = state.guard.take() {
+            if self.observation.captures_content() {
+                previous.capture_output(&model_output(&state));
+            }
+            if let Some((completed_at, duration_ms)) = previous_source_end {
+                previous.finish_at(OperationOutcome::Error, completed_at, duration_ms);
+            } else {
+                previous.finish(OperationOutcome::Error);
+            }
+        }
+        state.output.clear();
+        state.output_bytes = 0;
+        state.partial_text.clear();
+        state.partial_truncated = false;
+        state.fingerprint = Some(fingerprint);
+        let guard = self.observation.start(
+            self.thread_id.clone(),
+            self.turn_id.clone(),
+            OperationKind::Model,
+            OperationMetadata {
+                requested_model: Some(self.requested_model.clone()),
+                response_id_trusted: trusted_response_endpoint(endpoint),
+                ..Default::default()
+            },
+        );
+        // Capture the assembled wire body, rather than the caller's input.
+        if self.observation.captures_content() {
+            guard.capture_input(&model_request_content(request));
+        }
+        state.guard = Some(guard);
+    }
+
+    pub(crate) fn for_stream(mut self) -> Self {
+        self.stream_generation = Some(
+            self.state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .generation,
+        );
+        self
+    }
+
+    pub(crate) fn event(&self, event: &codex_api::ResponseEvent) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if self
+            .stream_generation
+            .is_some_and(|generation| generation != state.generation)
+            || state.source_end.is_some()
+        {
+            return;
+        }
+        match event {
+            codex_api::ResponseEvent::OutputTextDelta(text)
+                if self.observation.captures_content() =>
+            {
+                let mut end = text
+                    .len()
+                    .min(CONTENT_LIMIT_BYTES.saturating_sub(state.partial_text.len()));
+                while !text.is_char_boundary(end) {
+                    end -= 1;
+                }
+                state.partial_text.push_str(&text[..end]);
+                state.partial_truncated |= end < text.len();
+            }
+            codex_api::ResponseEvent::OutputItemDone(item)
+                if self.observation.mode == OperationCaptureMode::Content =>
+            {
+                if matches!(item, codex_protocol::models::ResponseItem::Message { .. }) {
+                    state.partial_text.clear();
+                    state.partial_truncated = false;
+                }
+                if state.output_bytes < CONTENT_LIMIT_BYTES {
+                    let content = project_content(item);
+                    state.output_bytes += serde_json::to_vec(&content.value)
+                        .map_or(CONTENT_LIMIT_BYTES, |value| value.len());
+                    state.output.push(content.value);
+                    if content.truncated || content.omitted {
+                        state.output.push(serde_json::json!({"omitted":content.omitted,"truncated":content.truncated,"reason":content.reason}));
+                    }
+                } else if state
+                    .output
+                    .last()
+                    .and_then(|item| item.get("reason"))
+                    .and_then(Value::as_str)
+                    != Some("capture_budget")
+                {
+                    state
+                        .output
+                        .push(serde_json::json!({"truncated":true,"reason":"capture_budget"}));
+                }
+            }
+            codex_api::ResponseEvent::ModelObservation(model) => {
+                if !state.authoritative_model
+                    && let Some(guard) = &state.guard
+                {
+                    guard.update(|event| event.metadata.observed_model = Some(model.clone()));
+                }
+            }
+            codex_api::ResponseEvent::ServerModel(model) => {
+                state.authoritative_model = true;
+                if let Some(guard) = &state.guard {
+                    guard.update(|event| event.metadata.observed_model = Some(model.clone()));
+                }
+            }
+            codex_api::ResponseEvent::Created { response_id } => {
+                if let Some(guard) = &state.guard {
+                    guard.update(|event| event.metadata.response_id = response_id.clone());
+                }
+            }
+            codex_api::ResponseEvent::Completed {
+                response_id,
+                token_usage,
+                ..
+            } => {
+                if let Some(guard) = &state.guard {
+                    guard.update(|event| {
+                        event.metadata.response_id = Some(response_id.clone());
+                        event.metadata.usage = token_usage
+                            .as_ref()
+                            .and_then(|usage| serde_json::to_value(usage).ok());
+                    });
+                    guard.finish_with_output_fn(OperationOutcome::Success, || model_output(&state));
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+fn model_output(state: &ModelOperationState) -> Vec<Value> {
+    let mut output = state.output.clone();
+    if !state.partial_text.is_empty() {
+        output.push(serde_json::json!({"type":"output_text","text":state.partial_text,"partial":true,"truncated":state.partial_truncated}));
+    }
+    output
+}
+
+pub(crate) fn current_model_operation() -> Option<ModelOperation> {
+    CURRENT_MODEL_OPERATION.try_with(Clone::clone).ok()
+}
+
+pub(crate) fn observe_model_request<T: Serialize + ?Sized>(
+    request: &T,
+    identity: &impl Serialize,
+    endpoint: &str,
+) {
+    if let Some(operation) = current_model_operation() {
+        operation.request(request, identity, endpoint);
+    }
+}
+
+pub(crate) struct ModelInterruptionGuard(ModelOperation);
+
+impl Drop for ModelInterruptionGuard {
+    fn drop(&mut self) {
+        self.0.finish(OperationOutcome::Interrupted);
+    }
+}
+
+fn model_request_content(request: &(impl Serialize + ?Sized)) -> Value {
+    let mut value = model_request_identity(request);
+    if let Value::Object(body) = &mut value {
+        // The per-direction content budget belongs to messages and instructions.
+        // Tool definitions affect request identity but must not consume that budget.
+        body.retain(|key, _| {
+            matches!(
+                key.as_str(),
+                "instructions" | "input" | "previous_response_id"
+            )
+        });
+    }
+    value
+}
+
+fn model_request_identity(request: &(impl Serialize + ?Sized)) -> Value {
+    let Ok(Value::Object(mut body)) = serde_json::to_value(request) else {
+        return Value::Null;
+    };
+    // Preserve semantic request changes when grouping same-input transport retries.
+    body.retain(|key, _| {
+        matches!(
+            key.as_str(),
+            "model"
+                | "instructions"
+                | "input"
+                | "previous_response_id"
+                | "tools"
+                | "tool_choice"
+                | "text"
+        )
+    });
+    Value::Object(body)
+}
+
+fn request_fingerprint(request: &impl Serialize) -> u64 {
+    use std::hash::Hash;
+    use std::hash::Hasher;
+    let value = model_request_identity(request);
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    // The digest only lives with this operation; request content is not retained in metadata mode.
+    value.to_string().hash(&mut hasher);
+    hasher.finish()
+}
+
+fn trusted_response_endpoint(endpoint: &str) -> bool {
+    url::Url::parse(endpoint)
+        .is_ok_and(|url| url.scheme() == "https" && url.host_str() == Some("api.openai.com"))
+}
