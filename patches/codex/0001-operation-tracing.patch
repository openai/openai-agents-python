diff --git a/codex-rs/app-server/src/operation_observation.rs b/codex-rs/app-server/src/operation_observation.rs
new file mode 100644
index 0000000..7e36f8a
--- /dev/null
+++ b/codex-rs/app-server/src/operation_observation.rs
@@ -0,0 +1,361 @@
+//! Private operation delivery. Payloads bypass telemetry, history, and broadcasts.
+
+use super::ConnectionId;
+use super::OutgoingEnvelope;
+use super::OutgoingMessageSender;
+use super::timestamped_server_notification;
+use codex_app_server_protocol::OperationTracingContent;
+use codex_app_server_protocol::OperationTracingKind;
+use codex_app_server_protocol::OperationTracingNotification;
+use codex_app_server_protocol::OperationTracingOutcome;
+use codex_app_server_protocol::ServerNotification;
+use codex_core::operation_observation::OperationContent;
+use codex_core::operation_observation::OperationEvent;
+use codex_core::operation_observation::OperationKind;
+use codex_core::operation_observation::OperationMetadata;
+use codex_core::operation_observation::OperationObserver;
+use codex_core::operation_observation::OperationOutcome;
+use codex_core::operation_observation::OperationPhase;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::sync::Mutex;
+use tokio::sync::mpsc;
+use tokio::sync::watch;
+
+struct PrivateOperationObserver {
+    thread_id: String,
+    turn_id: Mutex<Option<String>>,
+    sender: Mutex<Option<mpsc::UnboundedSender<ServerNotification>>>,
+    drained: watch::Receiver<bool>,
+}
+
+impl PrivateOperationObserver {
+    fn owns_turn(&self, thread_id: &str, turn_id: &str) -> bool {
+        if thread_id != self.thread_id {
+            return false;
+        }
+        let mut bound = self
+            .turn_id
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if bound.as_ref().is_some_and(|id| id != turn_id) {
+            return false;
+        }
+        bound.get_or_insert_with(|| turn_id.to_owned());
+        true
+    }
+}
+
+impl OperationObserver for PrivateOperationObserver {
+    fn emit(&self, event: OperationEvent) {
+        if !self.owns_turn(&event.thread_id, &event.turn_id) {
+            return;
+        }
+        let phase = event.phase;
+        let payload = operation_notification(event);
+        let notification = match phase {
+            OperationPhase::Started => ServerNotification::TurnOperationStarted(payload),
+            OperationPhase::Completed => ServerNotification::TurnOperationCompleted(payload),
+        };
+        let sender = self
+            .sender
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(sender) = sender.as_ref() {
+            let _ = sender.send(notification);
+        }
+    }
+
+    fn turn_finished<'a>(
+        &'a self,
+        thread_id: &'a str,
+        turn_id: &'a str,
+    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
+        let owns_turn = self.owns_turn(thread_id, turn_id);
+        Box::pin(async move {
+            if !owns_turn {
+                return;
+            }
+            // Closing admission also fences empty turns and late finalizers.
+            drop(
+                self.sender
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                    .take(),
+            );
+            // Shared completion survives cancellation of an earlier terminal waiter.
+            let mut drained = self.drained.clone();
+            let _ = drained.wait_for(|complete| *complete).await;
+        })
+    }
+}
+
+impl OutgoingMessageSender {
+    pub(crate) fn operation_observer(
+        self: &Arc<Self>,
+        connection_id: ConnectionId,
+        thread_id: String,
+    ) -> Arc<dyn OperationObserver> {
+        let (sender, mut receiver) = mpsc::unbounded_channel();
+        let (completed, drained) = watch::channel(false);
+        let outgoing = Arc::downgrade(self);
+        tokio::spawn(async move {
+            while let Some(notification) = receiver.recv().await {
+                let Some(outgoing) = outgoing.upgrade() else {
+                    break;
+                };
+                // Explicit owner delivery, without notification logging or analytics.
+                if outgoing
+                    .sender
+                    .send(OutgoingEnvelope::ToConnection {
+                        connection_id,
+                        message: timestamped_server_notification(notification),
+                        write_complete_tx: None,
+                    })
+                    .await
+                    .is_err()
+                {
+                    break;
+                }
+            }
+            let _ = completed.send(true);
+        });
+        Arc::new(PrivateOperationObserver {
+            thread_id,
+            turn_id: Mutex::new(None),
+            sender: Mutex::new(Some(sender)),
+            drained,
+        })
+    }
+}
+
+fn operation_notification(event: OperationEvent) -> OperationTracingNotification {
+    let OperationEvent {
+        phase: _,
+        operation_id,
+        thread_id,
+        turn_id,
+        kind,
+        started_at,
+        completed_at,
+        duration_ms,
+        outcome,
+        metadata,
+        input,
+        output,
+    } = event;
+    let OperationMetadata {
+        parent_operation_id,
+        requested_model,
+        observed_model,
+        response_id,
+        response_id_trusted,
+        usage,
+        tool_name,
+        call_id,
+    } = metadata;
+    OperationTracingNotification {
+        operation_id,
+        thread_id,
+        turn_id,
+        started_at,
+        completed_at,
+        duration_ms,
+        kind: match kind {
+            OperationKind::Model => OperationTracingKind::Model,
+            OperationKind::Tool => OperationTracingKind::Tool,
+        },
+        outcome: outcome.map(|outcome| match outcome {
+            OperationOutcome::Success => OperationTracingOutcome::Success,
+            OperationOutcome::Error => OperationTracingOutcome::Error,
+            OperationOutcome::Interrupted => OperationTracingOutcome::Interrupted,
+        }),
+        parent_operation_id,
+        requested_model,
+        observed_model,
+        response_id,
+        response_id_trusted,
+        usage,
+        tool_name,
+        call_id,
+        input: input.map(operation_content),
+        output: output.map(operation_content),
+    }
+}
+
+fn operation_content(content: OperationContent) -> OperationTracingContent {
+    let OperationContent {
+        value,
+        truncated,
+        omitted,
+        reason,
+    } = content;
+    OperationTracingContent {
+        value,
+        truncated,
+        omitted,
+        reason,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_core::operation_observation::OperationCaptureMode;
+    use codex_core::operation_observation::OperationObservation;
+
+    #[tokio::test]
+    async fn owner_only_delivery_and_source_terminal_fence() {
+        let (sender, mut receiver) = mpsc::channel(8);
+        let outgoing = Arc::new(OutgoingMessageSender::new(
+            sender,
+            codex_analytics::AnalyticsEventsClient::disabled(),
+        ));
+        let observer = outgoing.operation_observer(ConnectionId(7), "thread".into());
+        let observation =
+            OperationObservation::new(OperationCaptureMode::Metadata, observer.clone());
+        let operation = observation.start(
+            "thread".into(),
+            "turn".into(),
+            OperationKind::Model,
+            OperationMetadata::default(),
+        );
+        operation.capture_input(&serde_json::json!({"value": "metadata-canary"}));
+        drop(operation);
+        observer.turn_finished("thread", "turn").await;
+        let mut phases = Vec::new();
+        while let Ok(envelope) = receiver.try_recv() {
+            let OutgoingEnvelope::ToConnection {
+                connection_id,
+                message,
+                ..
+            } = envelope
+            else {
+                panic!("operation observations must never broadcast");
+            };
+            assert_eq!(connection_id, ConnectionId(7));
+            let value = serde_json::to_value(message).unwrap();
+            assert!(!value.to_string().contains("metadata-canary"));
+            phases.push(value["method"].as_str().unwrap().to_owned());
+        }
+        assert_eq!(
+            phases,
+            ["turn/operation/started", "turn/operation/completed"]
+        );
+        drop(observation.start(
+            "thread".into(),
+            "turn".into(),
+            OperationKind::Model,
+            OperationMetadata::default(),
+        ));
+        tokio::task::yield_now().await;
+        assert!(receiver.try_recv().is_err());
+    }
+
+    #[tokio::test]
+    async fn private_content_preserves_capture_fields() {
+        let (sender, mut receiver) = mpsc::channel(8);
+        let outgoing = Arc::new(OutgoingMessageSender::new(
+            sender,
+            codex_analytics::AnalyticsEventsClient::disabled(),
+        ));
+        let observer = outgoing.operation_observer(ConnectionId(9), "thread".into());
+        let observation =
+            OperationObservation::new(OperationCaptureMode::Content, observer.clone());
+        let operation = observation.start(
+            "thread".into(),
+            "turn".into(),
+            OperationKind::Tool,
+            OperationMetadata::default(),
+        );
+        operation.capture_input(&serde_json::json!({"value": "private-canary"}));
+        operation.finish_with_output(
+            OperationOutcome::Success,
+            &serde_json::json!({"value": "private-output"}),
+        );
+        observer.turn_finished("thread", "turn").await;
+        for phase in ["turn/operation/started", "turn/operation/completed"] {
+            let OutgoingEnvelope::ToConnection {
+                connection_id,
+                message,
+                ..
+            } = receiver.recv().await.unwrap()
+            else {
+                panic!("expected private delivery");
+            };
+            assert_eq!(connection_id, ConnectionId(9));
+            let value = serde_json::to_value(message).unwrap();
+            assert_eq!(value["method"], phase);
+            if phase.ends_with("completed") {
+                assert_eq!(value["params"]["input"]["value"]["value"], "private-canary");
+                assert_eq!(
+                    value["params"]["output"]["value"]["value"],
+                    "private-output"
+                );
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn empty_source_terminal_excludes_all_late_observations() {
+        let (sender, mut receiver) = mpsc::channel(8);
+        let outgoing = Arc::new(OutgoingMessageSender::new(
+            sender,
+            codex_analytics::AnalyticsEventsClient::disabled(),
+        ));
+        let observer = outgoing.operation_observer(ConnectionId(7), "thread".into());
+        let observation =
+            OperationObservation::new(OperationCaptureMode::Metadata, observer.clone());
+        observer.turn_finished("thread", "empty-turn").await;
+        for (thread_id, turn_id) in [
+            ("thread", "empty-turn"),
+            ("thread", "later-turn"),
+            ("child", "empty-turn"),
+        ] {
+            drop(observation.start(
+                thread_id.into(),
+                turn_id.into(),
+                OperationKind::Model,
+                OperationMetadata::default(),
+            ));
+        }
+        tokio::task::yield_now().await;
+        assert!(receiver.try_recv().is_err());
+    }
+    #[tokio::test]
+    async fn cancelled_terminal_waiter_does_not_release_a_later_terminal_early() {
+        let (sender, mut receiver) = mpsc::channel(1);
+        let outgoing = Arc::new(OutgoingMessageSender::new(
+            sender,
+            codex_analytics::AnalyticsEventsClient::disabled(),
+        ));
