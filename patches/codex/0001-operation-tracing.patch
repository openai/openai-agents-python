+async fn bounded_capture_marks_unknown_outputs_and_large_errors_without_materialization() {
+    struct Unknown(Arc<std::sync::atomic::AtomicUsize>);
+    impl ToolOutput for Unknown {
+        fn bounded_code_mode_result(
+            &self,
+            _: &ToolPayload,
+            _: usize,
+        ) -> Result<Value, &'static str> {
+            self.0.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            Err("unsupported_output")
+        }
+        fn log_output(&self) -> String {
+            panic!("unexpected conversion")
+        }
+        fn success_for_logging(&self) -> bool {
+            true
+        }
+        fn to_response_item(
+            &self,
+            _: &str,
+            _: &ToolPayload,
+        ) -> codex_protocol::models::ResponseInputItem {
+            panic!("unexpected conversion")
+        }
+        fn code_mode_result(&self, _: &ToolPayload) -> Value {
+            panic!("unexpected conversion")
+        }
+    }
+    for mode in [
+        OperationCaptureMode::Metadata,
+        OperationCaptureMode::Content,
+    ] {
+        let (invocation, events) = fixture(mode).await;
+        let observation = invocation
+            .turn
+            .extension_data
+            .get::<OperationObservation>()
+            .unwrap();
+        let execution = ExecutionObservation {
+            observation,
+            thread_id: "thread".into(),
+            turn_id: "turn".into(),
+            metadata: OperationMetadata::default(),
+            input: None,
+            guard: Mutex::new(None),
+        };
+        execution.start(None);
+        let captures = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        execution.finish(&invocation, &Ok(Box::new(Unknown(captures.clone()))));
+        assert_eq!(
+            captures.load(std::sync::atomic::Ordering::Relaxed),
+            usize::from(mode == OperationCaptureMode::Content)
+        );
+        let output = events.0.lock().unwrap()[1].output.clone();
+        if mode == OperationCaptureMode::Content {
+            assert_eq!(
+                output.unwrap().reason.as_deref(),
+                Some("unsupported_output")
+            );
+        } else {
+            assert!(output.is_none());
+        }
+    }
+    for (error, expected) in [
+        (
+            FunctionCallError::RespondToModel("x".repeat(1024 * 1024)),
+            None,
+        ),
+        (FunctionCallError::Fatal("x".repeat(1024 * 1024)), None),
+        (
+            FunctionCallError::RespondToModel("visible".into()),
+            Some("visible"),
+        ),
+        (
+            FunctionCallError::Fatal("visible".into()),
+            Some("Fatal error: visible"),
+        ),
+    ] {
+        let (invocation, events) = fixture(OperationCaptureMode::Content).await;
+        let execution = ExecutionObservation {
+            observation: invocation
+                .turn
+                .extension_data
+                .get::<OperationObservation>()
+                .unwrap(),
+            thread_id: "thread".into(),
+            turn_id: "turn".into(),
+            metadata: OperationMetadata::default(),
+            input: None,
+            guard: Mutex::new(None),
+        };
+        execution.start(None);
+        execution.finish(&invocation, &Err(error));
+        let events = events.0.lock().unwrap();
+        let output = events[1].output.as_ref().unwrap();
+        assert_eq!(events[1].outcome, Some(OperationOutcome::Error));
+        if let Some(expected) = expected {
+            assert_eq!(output.value, serde_json::json!({"error": expected}));
+            assert!(!output.omitted && !output.truncated);
+        } else {
+            assert!(output.omitted && output.truncated);
+            assert_eq!(output.reason.as_deref(), Some("capture_budget"));
+        }
+    }
+}
