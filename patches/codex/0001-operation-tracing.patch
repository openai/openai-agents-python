+use super::*;
+use crate::operation_observation::OperationCaptureMode;
+use crate::operation_observation::OperationEvent;
+use crate::operation_observation::OperationObserver;
+use crate::operation_observation::OperationPhase;
+use crate::session::step_context::StepContext;
+use crate::session::tests::make_session_and_context;
+use crate::tools::context::FunctionToolOutput;
+use crate::tools::context::ToolCallOrigin;
+use crate::tools::registry::ToolExecutor;
+use crate::turn_diff_tracker::TurnDiffTracker;
+use pretty_assertions::assert_eq;
+use tokio::sync::Notify;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Default)]
+struct Events(Mutex<Vec<OperationEvent>>);
+
+impl OperationObserver for Events {
+    fn emit(&self, event: OperationEvent) {
+        self.0.lock().unwrap().push(event);
+    }
+}
+
+struct Handler {
+    approved: Option<Arc<Notify>>,
+    entered: Option<Arc<Notify>>,
+    complete: Option<Arc<Notify>>,
+    denied: bool,
+    handoff: bool,
+    success: bool,
+}
+
+impl Default for Handler {
+    fn default() -> Self {
+        Self {
+            approved: None,
+            entered: None,
+            complete: None,
+            denied: false,
+            handoff: false,
+            success: true,
+        }
+    }
+}
+
+impl ToolExecutor<ToolInvocation> for Handler {
+    fn tool_name(&self) -> codex_tools::ToolName {
+        codex_tools::ToolName::plain("test_tool")
+    }
+
+    fn spec(&self) -> codex_tools::ToolSpec {
+        codex_tools::ToolSpec::Function(codex_tools::ResponsesApiTool {
+            name: "test_tool".to_string(),
+            description: "Observation fixture.".to_string(),
+            strict: false,
+            defer_loading: None,
+            parameters: codex_tools::JsonSchema::default(),
+            output_schema: None,
+        })
+    }
+
+    fn handle<'a>(&'a self, _invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            if let Some(approved) = &self.approved {
+                approved.notified().await;
+            }
+            if self.denied {
+                return Err(FunctionCallError::RespondToModel(
+                    "Denied fixture.".to_string(),
+                ));
+            }
+            if self.approved.is_some() {
+                start_current_execution();
+            }
+            if let Some(entered) = &self.entered {
+                entered.notify_one();
+            }
+            if let Some(complete) = &self.complete {
+                complete.notified().await;
+            }
+            Ok(Box::new(FunctionToolOutput::from_text(
+                "private-tool-result".to_string(),
+                Some(self.success),
+            )) as Box<dyn ToolOutput>)
+        })
+    }
+}
+
+impl CoreToolRuntime for Handler {
+    fn approves_inside_handler(&self) -> bool {
+        self.approved.is_some() || self.denied
+    }
+
+    fn is_client_tool_handoff(&self) -> bool {
+        self.handoff
+    }
+}
+
+async fn fixture(mode: OperationCaptureMode) -> (ToolInvocation, Arc<Events>) {
+    let (session, turn) = make_session_and_context().await;
+    let events = Arc::new(Events::default());
+    turn.extension_data
+        .insert(OperationObservation::new(mode, events.clone()));
+    let turn = Arc::new(turn);
+    let invocation = ToolInvocation {
+        session: Arc::new(session),
+        step_context: StepContext::for_test(Arc::clone(&turn)),
+        turn,
+        cancellation_token: CancellationToken::new(),
+        tracker: Arc::new(tokio::sync::Mutex::new(TurnDiffTracker::new())),
+        call_id: "call-1".to_string(),
+        tool_name: codex_tools::ToolName::plain("test_tool"),
+        source: ToolCallSource::Direct,
+        payload: ToolPayload::Function {
+            arguments: r#"{"query":"private-tool-argument"}"#.to_string(),
+        },
+        environments: Default::default(),
+    };
+    (invocation, events)
+}
+
+#[tokio::test]
+async fn approval_precedes_live_execution_start() {
+    let (invocation, events) = fixture(OperationCaptureMode::Content).await;
+    let approved = Arc::new(Notify::new());
+    let entered = Arc::new(Notify::new());
+    let complete = Arc::new(Notify::new());
+    let handler = Handler {
+        approved: Some(Arc::clone(&approved)),
+        entered: Some(Arc::clone(&entered)),
+        complete: Some(Arc::clone(&complete)),
+        ..Default::default()
+    };
+    let task = tokio::spawn(async move { observe_execution(&handler, &invocation).await });
+    tokio::task::yield_now().await;
+    assert!(events.0.lock().unwrap().is_empty());
+    approved.notify_one();
+    entered.notified().await;
+    {
+        let events = events.0.lock().unwrap();
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].phase, OperationPhase::Started);
+        assert_eq!(events[0].metadata.call_id.as_deref(), Some("call-1"));
+    }
+    complete.notify_one();
+    assert!(task.await.unwrap().is_ok());
+    let events = events.0.lock().unwrap();
+    assert_eq!(events.len(), 2);
+    assert_eq!(events[0].operation_id, events[1].operation_id);
+    assert_eq!(events[1].outcome, Some(OperationOutcome::Success));
+    let content = serde_json::to_string(&events[1]).unwrap();
+    assert!(content.contains("private-tool-argument"));
+    assert!(content.contains("private-tool-result"));
+}
+
+#[tokio::test]
+async fn denied_execution_and_client_handoff_emit_no_native_operation() {
+    let (invocation, events) = fixture(OperationCaptureMode::Content).await;
+    assert!(
+        observe_execution(
+            &Handler {
+                denied: true,
+                ..Default::default()
+            },
+            &invocation
+        )
+        .await
+        .is_err()
+    );
+    assert!(
+        observe_execution(
+            &Handler {
+                handoff: true,
+                ..Default::default()
+            },
+            &invocation
+        )
+        .await
+        .is_ok()
+    );
+    assert!(events.0.lock().unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn metadata_omits_payloads_and_retains_failed_execution() {
+    let (invocation, events) = fixture(OperationCaptureMode::Metadata).await;
+    let registry = crate::tools::registry::ToolRegistry::with_handler_for_test(Arc::new(Handler {
+        success: false,
+        ..Default::default()
+    }));
+    assert!(
+        registry
+            .dispatch_any_with_state(invocation, None)
+            .await
+            .is_ok()
+    );
+    let events = events.0.lock().unwrap();
+    assert_eq!(events.len(), 2);
+    assert_eq!(events[1].outcome, Some(OperationOutcome::Error));
+    assert!(events[1].input.is_none());
+    assert!(events[1].output.is_none());
+    let serialized = serde_json::to_string(&*events).unwrap();
+    assert!(!serialized.contains("private-tool-argument"));
+    assert!(!serialized.contains("private-tool-result"));
+}
+
+#[tokio::test]
+async fn abort_emits_one_interrupted_terminal() {
+    let (invocation, events) = fixture(OperationCaptureMode::Metadata).await;
+    let entered = Arc::new(Notify::new());
+    let handler = Handler {
+        entered: Some(Arc::clone(&entered)),
+        complete: Some(Arc::new(Notify::new())),
+        ..Default::default()
+    };
+    let task = tokio::spawn(async move { observe_execution(&handler, &invocation).await });
+    entered.notified().await;
+    task.abort();
+    assert!(task.await.err().unwrap().is_cancelled());
+    let events = events.0.lock().unwrap();
+    assert_eq!(events.len(), 2);
+    assert_eq!(events[0].operation_id, events[1].operation_id);
+    assert_eq!(events[1].outcome, Some(OperationOutcome::Interrupted));
+}
+
+#[tokio::test]
+async fn detached_parallel_code_cell_tools_retain_the_issuing_operation() {
+    let (mut first, events) = fixture(OperationCaptureMode::Metadata).await;
+    let cell_id = codex_code_mode::CellId::new("cell-1".to_string());
+    first
+        .session
+        .services
+        .code_mode_service
+        .mark_cell_ready_for_dispatch(
+            &cell_id,
+            Some(ToolCallOrigin {
+                operation_id: Some("issuing-exec-operation".to_string()),
+                item_id: None,
+                window_id: "window-1".to_string(),
+            }),
+        );
+    first.source = ToolCallSource::CodeMode {
+        cell_id: "cell-1".to_string(),
+        runtime_tool_call_id: "nested-1".to_string(),
+    };
+    let mut second = first.clone();
+    second.call_id = "call-2".to_string();
+    second.source = ToolCallSource::CodeMode {
+        cell_id: "cell-1".to_string(),
+        runtime_tool_call_id: "nested-2".to_string(),
+    };
+    let first_entered = Arc::new(Notify::new());
+    let second_entered = Arc::new(Notify::new());
+    let complete = Arc::new(Notify::new());
+    let first_handler = Handler {
+        entered: Some(Arc::clone(&first_entered)),
+        complete: Some(Arc::clone(&complete)),
+        ..Default::default()
+    };
+    let second_handler = Handler {
+        entered: Some(Arc::clone(&second_entered)),
+        complete: Some(Arc::clone(&complete)),
+        ..Default::default()
+    };
+    let first_task = tokio::spawn(async move { observe_execution(&first_handler, &first).await });
+    let second_task =
+        tokio::spawn(async move { observe_execution(&second_handler, &second).await });
+    first_entered.notified().await;
+    second_entered.notified().await;
+    assert_eq!(events.0.lock().unwrap().len(), 2);
+    complete.notify_waiters();
+    assert!(first_task.await.unwrap().is_ok());
+    assert!(second_task.await.unwrap().is_ok());
+    let events = events.0.lock().unwrap();
+    let starts: Vec<_> = events
+        .iter()
+        .filter(|event| event.phase == OperationPhase::Started)
+        .collect();
+    assert_eq!(starts.len(), 2);
+    assert_ne!(starts[0].operation_id, starts[1].operation_id);
+    for event in starts {
+        assert_eq!(
+            event.metadata.parent_operation_id.as_deref(),
+            Some("issuing-exec-operation")
+        );
+    }
+}
