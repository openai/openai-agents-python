+//! Opt-in, in-memory operation facts for the host that owns a turn.
+//!
+//! These observations never enter the rollout or the telemetry logger. The host
+//! owns delivery and tracing policy; core owns operation boundaries and content.
+
+use chrono::SecondsFormat;
+use chrono::Utc;
+use futures::FutureExt;
+use serde::Serialize;
+use serde_json::Value;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Instant;
+
+pub const CONTENT_LIMIT_BYTES: usize = 32 * 1024;
+pub(crate) const CONTENT_VALUE_LIMIT_BYTES: usize = CONTENT_LIMIT_BYTES - 256;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub enum OperationCaptureMode {
+    Metadata,
+    Content,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub enum OperationKind {
+    Model,
+    Tool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub enum OperationOutcome {
+    Success,
+    Error,
+    Interrupted,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OperationPhase {
+    Started,
+    Completed,
+}
+
+#[derive(Clone, Debug, Default, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct OperationMetadata {
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub parent_operation_id: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub requested_model: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub observed_model: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub response_id: Option<String>,
+    pub response_id_trusted: bool,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub usage: Option<Value>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub tool_name: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub call_id: Option<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct OperationContent {
+    pub value: Value,
+    pub truncated: bool,
+    pub omitted: bool,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub reason: Option<String>,
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct OperationEvent {
+    #[serde(skip)]
+    pub phase: OperationPhase,
+    pub operation_id: String,
+    pub thread_id: String,
+    pub turn_id: String,
+    pub kind: OperationKind,
+    pub started_at: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub completed_at: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub duration_ms: Option<f64>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub outcome: Option<OperationOutcome>,
+    #[serde(flatten)]
+    pub metadata: OperationMetadata,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub input: Option<OperationContent>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub output: Option<OperationContent>,
+}
+
+pub trait OperationObserver: Send + Sync {
+    /// Must return promptly. Delivery failures must not affect execution.
+    fn emit(&self, event: OperationEvent);
+
+    /// Closes admission for this source turn before its terminal event.
+    fn turn_finished<'a>(
+        &'a self,
+        _thread_id: &'a str,
+        _turn_id: &'a str,
+    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
+        Box::pin(async {})
+    }
+}
+
+#[derive(Clone)]
+pub struct OperationObservation {
+    mode: OperationCaptureMode,
+    sink: Arc<dyn OperationObserver>,
+}
+
+impl std::fmt::Debug for OperationObservation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("OperationObservation")
+            .field("mode", &self.mode)
+            .finish_non_exhaustive()
+    }
+}
+
+impl OperationObservation {
+    pub fn new(mode: OperationCaptureMode, sink: Arc<dyn OperationObserver>) -> Self {
+        Self { mode, sink }
+    }
+
+    pub fn captures_content(&self) -> bool {
+        self.mode == OperationCaptureMode::Content
+    }
+
+    pub fn start(
+        &self,
+        thread_id: String,
+        turn_id: String,
+        kind: OperationKind,
+        metadata: OperationMetadata,
+    ) -> OperationGuard {
+        let started = Instant::now();
+        let event = OperationEvent {
+            phase: OperationPhase::Started,
+            operation_id: uuid::Uuid::new_v4().to_string(),
+            thread_id,
+            turn_id,
+            kind,
+            started_at: timestamp(),
+            completed_at: None,
+            duration_ms: None,
+            outcome: None,
+            metadata,
+            input: None,
+            output: None,
+        };
+        self.emit(event.clone());
+        OperationGuard {
+            operation_id: event.operation_id.clone(),
+            observation: self.clone(),
+            started,
+            state: Mutex::new(event),
+        }
+    }
+
+    pub async fn turn_finished(&self, thread_id: &str, turn_id: &str) {
+        let future = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            self.sink.turn_finished(thread_id, turn_id)
+        }));
+        if let Ok(future) = future {
+            let _ = std::panic::AssertUnwindSafe(future).catch_unwind().await;
+        }
+    }
+
+    fn emit(&self, event: OperationEvent) {
+        // An optional host observer must never unwind an agent operation.
+        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| self.sink.emit(event)));
+    }
+}
+
+tokio::task_local! {
+    static CURRENT_MODEL_OPERATION: ModelOperation;
+}
+
+pub struct OperationGuard {
+    operation_id: String,
+    observation: OperationObservation,
+    started: Instant,
+    state: Mutex<OperationEvent>,
+}
+
+impl OperationGuard {
+    pub fn operation_id(&self) -> &str {
+        &self.operation_id
+    }
+
+    pub fn capture_input(&self, value: &Value) {
+        if self.observation.mode == OperationCaptureMode::Content {
+            self.update(|event| event.input = Some(project_content(value)));
+        }
+    }
+
+    pub(crate) fn capture_input_content(&self, content: OperationContent) {
+        if self.observation.captures_content() {
+            self.update(|event| event.input = Some(content));
+        }
+    }
+
+    pub fn capture_output(&self, value: &Value) {
+        if self.observation.mode == OperationCaptureMode::Content {
+            self.update(|event| event.output = Some(project_content(value)));
+        }
+    }
+
+    fn update(&self, update: impl FnOnce(&mut OperationEvent)) {
+        let mut event = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if event.phase == OperationPhase::Started {
+            update(&mut event);
+        }
+    }
+
+    pub fn finish_with_output_fn(&self, outcome: OperationOutcome, output: impl FnOnce() -> Value) {
+        let completed_at = timestamp();
+        let duration_ms = self.started.elapsed().as_secs_f64() * 1000.0;
+        if self.observation.captures_content() {
+            self.capture_output(&output());
+        }
+        self.finish_at(outcome, completed_at, duration_ms);
+    }
+
+    pub(crate) fn finish_with_bounded_output_fn(
+        &self,
+        outcome: OperationOutcome,
+        output: impl FnOnce() -> Result<Value, &'static str>,
+    ) {
+        let completed_at = timestamp();
+        let duration_ms = self.started.elapsed().as_secs_f64() * 1000.0;
+        if self.observation.captures_content() {
+            let content = match output() {
+                Ok(value) => project_content(&value),
+                Err(reason) => omitted_content(reason),
+            };
+            self.update(|event| event.output = Some(content));
+        }
+        self.finish_at(outcome, completed_at, duration_ms);
+    }
+
+    pub fn finish_with_output(&self, outcome: OperationOutcome, output: &Value) {
+        let completed_at = timestamp();
+        let duration_ms = self.started.elapsed().as_secs_f64() * 1000.0;
+        self.capture_output(output);
+        self.finish_at(outcome, completed_at, duration_ms);
+    }
+
+    pub fn finish(&self, outcome: OperationOutcome) {
+        self.finish_at(
+            outcome,
+            timestamp(),
+            self.started.elapsed().as_secs_f64() * 1000.0,
+        );
+    }
+
+    fn finish_at(&self, outcome: OperationOutcome, completed_at: String, duration_ms: f64) {
+        let terminal = {
+            let mut event = self
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if event.phase == OperationPhase::Completed {
+                return;
+            }
+            event.phase = OperationPhase::Completed;
+            event.completed_at = Some(completed_at);
+            event.duration_ms = Some(duration_ms);
+            event.outcome = Some(outcome);
+            event.clone()
+        };
+        self.observation.emit(terminal);
+    }
+}
+
+impl Drop for OperationGuard {
+    fn drop(&mut self) {
+        self.finish(OperationOutcome::Interrupted);
+    }
+}
+
+fn timestamp() -> String {
+    Utc::now().to_rfc3339_opts(SecondsFormat::Millis, true)
+}
+
+/// Projects JSON in memory, omitting binary/hidden reasoning and transport secrets.
+/// Inline markers survive consumers that extract values from the wire envelope.
+pub fn project_content(value: &Value) -> OperationContent {
+    project_with(|projection| projection.project(value, CONTENT_VALUE_LIMIT_BYTES, 0))
+}
+
+pub(crate) fn project_text(text: &str) -> OperationContent {
+    project_with(|projection| projection.text(text, CONTENT_VALUE_LIMIT_BYTES, 0))
+}
+
+/// Typed adapters stop serialization before constructing an oversized owned JSON value.
+fn bounded_value(value: &(impl Serialize + ?Sized)) -> Result<Value, &'static str> {
+    struct BoundedWriter(Vec<u8>);
+    impl std::io::Write for BoundedWriter {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            if bytes.len() > CONTENT_VALUE_LIMIT_BYTES.saturating_sub(self.0.len()) {
+                return Err(std::io::Error::other("capture_budget"));
+            }
+            self.0.extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut writer = BoundedWriter(Vec::new());
+    serde_json::to_writer(&mut writer, value).map_err(|error| {
+        if error.is_io() {
+            "capture_budget"
+        } else {
+            "serialization_failed"
+        }
+    })?;
+    serde_json::from_slice(&writer.0).map_err(|_| "serialization_failed")
+}
+
+pub(crate) fn project_serializable_content(value: &(impl Serialize + ?Sized)) -> OperationContent {
+    match bounded_value(value) {
+        Ok(value) => project_content(&value),
+        Err(reason) => omitted_content(reason),
+    }
+}
+
+fn project_with(project: impl FnOnce(&mut ContentProjection) -> Value) -> OperationContent {
+    let mut projection = ContentProjection {
+        truncated: false,
+        omitted: false,
+    };
+    let value = project(&mut projection);
+    let content = OperationContent {
+        value,
+        truncated: projection.truncated,
+        omitted: projection.omitted,
+        reason: if projection.truncated {
+            Some("capture_budget".into())
+        } else if projection.omitted {
+            Some("unsupported_content".into())
+        } else {
+            None
+        },
+    };
+    if json_size(&content) <= CONTENT_LIMIT_BYTES {
+        content
+    } else {
+        omitted_content("capture_budget")
+    }
+}
+
+fn omitted_content(reason: &str) -> OperationContent {
+    OperationContent {
+        value: if reason == "capture_budget" {
+            serde_json::json!({"omitted":true,"truncated":true,"reason":reason})
+        } else {
+            serde_json::json!({"omitted":true,"reason":reason})
+        },
+        truncated: reason == "capture_budget",
+        omitted: true,
+        reason: Some(reason.into()),
+    }
+}
+
+fn json_size(value: &(impl Serialize + ?Sized)) -> usize {
+    struct Counter(usize);
+    impl std::io::Write for Counter {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0 = self.0.saturating_add(bytes.len());
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut counter = Counter(0);
+    serde_json::to_writer(&mut counter, value).map_or(usize::MAX, |_| counter.0)
+}
+
+struct ContentProjection {
+    truncated: bool,
+    omitted: bool,
+}
+
+impl ContentProjection {
+    fn project(&mut self, value: &Value, budget: usize, depth: usize) -> Value {
+        if depth > 32 {
+            self.truncated = true;
+            return Value::String("[truncated]".into());
+        }
+        match value {
+            Value::String(text) => self.text(text, budget, depth),
+            Value::Array(items) => {
+                let mut result = Vec::new();
+                let mut used: usize = 2;
+                for item in items {
+                    let available = budget.saturating_sub(used + 34);
+                    if available < 84 {
+                        self.truncated = true;
+                        result.push(serde_json::json!({"truncated":true}));
+                        break;
+                    }
+                    let item = self.project(item, available, depth + 1);
+                    used += json_size(&item) + 2;
+                    result.push(item);
+                }
+                Value::Array(result)
+            }
+            Value::Object(items) => {
+                self.truncated |= items.get("truncated") == Some(&Value::Bool(true));
+                self.omitted |= items.get("omitted") == Some(&Value::Bool(true));
+                let kind = items.get("type").and_then(Value::as_str);
+                let binary_resource = kind == Some("resource")
+                    && items
+                        .get("resource")
+                        .and_then(|value| value.get("blob"))
+                        .is_some();
+                if binary_resource
+                    || kind.is_some_and(|kind| {
+                        matches!(
+                            kind,
+                            "reasoning"
+                                | "reasoning_text"
+                                | "thinking"
+                                | "redacted_thinking"
+                                | "compaction"
+                                | "encrypted_content"
+                                | "image"
+                                | "input_image"
+                                | "output_image"
+                                | "image_url"
+                                | "computer_screenshot"
+                                | "image_generation_call"
+                                | "audio"
+                                | "input_audio"
+                                | "output_audio"
+                                | "file"
+                                | "input_file"
+                                | "video"
+                                | "input_video"
+                        )
+                    })
+                {
+                    self.omitted = true;
+                    return serde_json::json!({"type":kind,"omitted":true,"reason":"unsupported_content"});
+                }
+                let mut result = serde_json::Map::new();
+                let mut used: usize = 2;
+                // Preserve structural keys without collecting an unbounded list of references.
+                let structural =
+                    |key: &str| matches!(key, "type" | "role" | "id" | "call_id" | "name");
+                let ordered = items
+                    .iter()
+                    .filter(|(key, _)| structural(key))
+                    .chain(items.iter().filter(|(key, _)| !structural(key)));
+                for (key, value) in ordered {
+                    let available = budget.saturating_sub(used + json_size(&key) + 36);
+                    if available < 84 {
+                        self.truncated = true;
+                        result.insert("truncated".into(), Value::Bool(true));
+                        break;
+                    }
+                    let normalized = key.to_ascii_lowercase().replace(['-', '_'], "");
+                    let value = if matches!(
+                        normalized.as_str(),
+                        "apikey"
+                            | "xapikey"
+                            | "authorization"
+                            | "accesstoken"
+                            | "refreshtoken"
+                            | "password"
+                            | "headers"
+                            | "clientmetadata"
+                            | "encryptedcontent"
+                            | "reasoning"
+                            | "reasoningcontent"
+                            | "reasoningdetails"
+                            | "thinking"
+                            | "imageurl"
+                            | "filedata"
+                            | "imagedata"
+                            | "audiodata"
+                            | "b64json"
+                    ) {
+                        self.omitted = true;
+                        Value::String("[omitted]".into())
+                    } else {
+                        self.project(value, available, depth + 1)
+                    };
+                    used += json_size(&key) + json_size(&value) + 4;
+                    result.insert(key.clone(), value);
+                }
+                Value::Object(result)
+            }
+            value => value.clone(),
+        }
+    }
+
+    fn response_item(
+        &mut self,
+        item: &codex_protocol::models::ResponseItem,
+        budget: usize,
+    ) -> Value {
+        use codex_protocol::models::ContentItem;
+        use codex_protocol::models::ResponseItem;
+        match bounded_value(item) {
+            Ok(value) => return self.project(&value, budget, 0),
+            Err("capture_budget") => {}
+            Err(reason) => {
+                self.omitted = true;
+                return omitted_content(reason).value;
+            }
+        }
+        if let Some(value) = self.oversized_tool_result(item, budget) {
+            return value;
+        }
+        let ResponseItem::Message {
+            role,
+            content,
+            id,
+            status,
+            phase,
+            encrypted_content,
+            internal_chat_message_metadata_passthrough,
+            ..
+        } = item
+        else {
+            self.truncated = true;
+            self.omitted = true;
+            return omitted_content("capture_budget").value;
+        };
+        // Large messages retain borrowed visible text without cloning media or the full item.
+        let mut result = serde_json::Map::new();
+        result.insert("type".into(), Value::String("message".into()));
+        result.insert("role".into(), self.text(role, budget.min(256), 0));
+        for (key, value) in [
+            ("id", bounded_value(id)),
+            ("status", bounded_value(status)),
+            ("phase", bounded_value(phase)),
+        ] {
+            if let Ok(value) = value {
+                if !value.is_null() {
+                    result.insert(key.into(), self.project(&value, 256, 0));
+                }
+            } else {
+                self.omitted = true;
+                result.insert("omitted".into(), Value::Bool(true));
+            }
+        }
+        if encrypted_content.is_some() || internal_chat_message_metadata_passthrough.is_some() {
+            self.omitted = true;
+            result.insert("omitted".into(), Value::Bool(true));
+        }
+        let mut used = json_size(&result) + 24;
+        let mut parts = Vec::new();
+        for part in content {
+            let available = budget.saturating_sub(used + 96);
+            if available < 84 {
+                self.truncated = true;
+                parts.push(serde_json::json!({"truncated":true,"reason":"capture_budget"}));
+                break;
+            }
+            let value = match part {
+                ContentItem::InputText { text } => {
+                    serde_json::json!({"type":"input_text","text":self.text(text, available, 0)})
+                }
+                ContentItem::OutputText {
+                    text,
+                    annotations,
+                    logprobs,
+                } => {
+                    let mut value = serde_json::json!({"type":"output_text","text":self.text(text, available, 0)});
+                    if annotations.is_some() || logprobs.is_some() {
+                        self.omitted = true;
+                        value["omitted"] = Value::Bool(true);
+                    }
+                    value
+                }
+                ContentItem::InputImage { .. } | ContentItem::InputAudio { .. } => {
+                    self.omitted = true;
+                    serde_json::json!({"type":if matches!(part, ContentItem::InputImage { .. }) {"input_image"} else {"input_audio"},"omitted":true,"reason":"unsupported_content"})
+                }
+            };
+            used += json_size(&value) + 2;
+            parts.push(value);
+        }
+        result.insert("content".into(), Value::Array(parts));
+        Value::Object(result)
+    }
+
+    fn oversized_tool_result(
+        &mut self,
+        item: &codex_protocol::models::ResponseItem,
+        budget: usize,
+    ) -> Option<Value> {
+        use codex_protocol::models::{
+            FunctionCallOutputBody, FunctionCallOutputContentItem, ResponseItem,
+        };
+        let (kind, call_id, name, output) = match item {
+            ResponseItem::FunctionCallOutput {
+                call_id,
+                name,
+                output,
+                ..
+            } => (
+                "function_call_output",
+                call_id.as_deref(),
+                name.as_deref(),
+                output,
+            ),
+            ResponseItem::CustomToolCallOutput {
+                call_id,
+                name,
+                output,
+                ..
+            } => (
+                "custom_tool_call_output",
+                Some(call_id.as_str()),
+                name.as_deref(),
+                output,
+            ),
+            _ => return None,
+        };
+        self.omitted = true;
+        let mut result = serde_json::json!({"type":kind,"omitted":true,"reason":"capture_budget"});
+        for (key, value) in [("call_id", call_id), ("name", name)] {
+            if let Some(value) = value {
+                result[key] = self.text(value, budget.min(256), 0);
+            }
+        }
+        let mut used = json_size(&result) + 24;
+        result["output"] = match &output.body {
+            FunctionCallOutputBody::Text(text) => {
+                self.text(text, budget.saturating_sub(used + 64), 0)
+            }
+            FunctionCallOutputBody::ContentItems(items) => {
+                let mut parts = Vec::new();
+                for part in items {
+                    let available = budget.saturating_sub(used + 96);
+                    if available < 84 {
+                        self.truncated = true;
+                        parts.push(serde_json::json!({"truncated":true,"reason":"capture_budget"}));
+                        break;
+                    }
+                    let value = match part {
+                        FunctionCallOutputContentItem::InputText { text } => {
+                            serde_json::json!({"type":"input_text","text":self.text(text, available, 0)})
+                        }
+                        _ => {
+                            let kind = match part {
+                                FunctionCallOutputContentItem::InputImage { .. } => "input_image",
+                                FunctionCallOutputContentItem::InputAudio { .. } => "input_audio",
+                                FunctionCallOutputContentItem::EncryptedContent { .. } => {
+                                    "encrypted_content"
+                                }
+                                FunctionCallOutputContentItem::InputText { .. } => unreachable!(),
+                            };
+                            serde_json::json!({"type":kind,"omitted":true,"reason":"unsupported_content"})
+                        }
+                    };
+                    used += json_size(&value) + 2;
+                    parts.push(value);
+                }
+                Value::Array(parts)
+            }
+        };
+        Some(self.project(&result, budget, 0))
+    }
+
+    fn text(&mut self, text: &str, budget: usize, depth: usize) -> Value {
+        static DATA_URI: std::sync::LazyLock<regex_lite::Regex> = std::sync::LazyLock::new(|| {
+            regex_lite::Regex::new(r#"(?i)data:[^\s;,]+(?:;[^\s,]*)?,[^\s\"'<>]+"#)
+                .expect("valid data URI pattern")
+        });
+        self.truncated |= text.ends_with("[truncated]");
+        self.omitted |= text.contains("[omitted]") || text.contains("[omitted: media]");
+        // Classification borrows the text; bound raw bytes before allocating a JSON tree.
+        let parse_limit = budget.min(CONTENT_LIMIT_BYTES);
+        if text.trim_start().starts_with(['{', '[']) {
+            if text.len() > parse_limit {
+                self.truncated = true;
+                self.omitted = true;
+                return Value::String(
+                    serde_json::json!({"omitted":true,"truncated":true,"reason":"capture_budget"})
+                        .to_string(),
+                );
+            }
+            if let Ok(embedded) = serde_json::from_str::<Value>(&text) {
+                let safe = self.project(&embedded, budget, depth + 1);
+                if safe == embedded && json_size(&text) <= budget {
+                    return Value::String(text.to_owned());
+                }
+                let mut encoded = safe.to_string();
+                if json_size(&encoded) > budget {
+                    // Rebudget the value so escaped JSON remains valid.
+                    encoded = self
+                        .project(&embedded, budget.saturating_sub(2) / 2, depth + 1)
+                        .to_string();
+                }
+                return Value::String(encoded);
+            }
+        }
+        // Regex replacement and JSON sizing only see a bounded UTF-8 prefix.
+        let mut end = text.len().min(budget);
+        while !text.is_char_boundary(end) {
+            end -= 1;
+        }
+        let source_truncated = end < text.len();
+        self.truncated |= source_truncated;
+        let text = &text[..end];
+        let projected = DATA_URI.replace_all(text, "[omitted: media]");
+        self.omitted |= projected != text;
+        let text = projected.into_owned();
+        if !source_truncated && json_size(&text) <= budget {
+            return Value::String(text);
+        }
+        self.truncated = true;
+        let mut low = 0;
+        let mut high = text.len().min(budget);
+        while low < high {
+            let middle = low + (high - low + 1) / 2;
+            let mut end = middle;
+            while !text.is_char_boundary(end) {
+                end -= 1;
+            }
+            if json_size(&&text[..end]).saturating_add("[truncated]".len()) <= budget {
+                low = middle;
+            } else {
+                high = middle - 1;
+            }
+        }
+        while !text.is_char_boundary(low) {
+            low -= 1;
+        }
+        Value::String(format!("{}[truncated]", &text[..low]))
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct ModelOperation {
+    observation: Arc<OperationObservation>,
+    thread_id: String,
+    turn_id: String,
+    requested_model: String,
+    stream_generation: Option<u64>,
+    state: Arc<Mutex<ModelOperationState>>,
+}
+
+#[derive(Default)]
+struct ModelOperationState {
+    guard: Option<OperationGuard>,
+    output: Vec<Value>,
+    output_bytes: usize,
+    partial_text: String,
+    partial_truncated: bool,
+    fingerprint: Option<u64>,
+    generation: u64,
+    source_end: Option<(String, f64)>,
+    retry_waiting: bool,
+    authoritative_model: bool,
+}
+
+impl ModelOperation {
+    pub(crate) fn new(
+        observation: Arc<OperationObservation>,
+        thread_id: String,
+        turn_id: String,
+        requested_model: String,
+    ) -> Self {
+        Self {
+            observation,
+            thread_id,
+            turn_id,
+            requested_model,
+            stream_generation: None,
+            state: Arc::new(Mutex::new(ModelOperationState::default())),
+        }
+    }
+
+    pub(crate) async fn scope<F: Future>(&self, future: F) -> F::Output {
+        CURRENT_MODEL_OPERATION.scope(self.clone(), future).await
+    }
+
+    pub(crate) fn finish(&self, outcome: OperationOutcome) {
+        // Only the source response.completed event establishes inference success.
+        // An outer successful turn handoff can still have preempted this stream.
+        let outcome = if outcome == OperationOutcome::Success {
+            OperationOutcome::Interrupted
+        } else {
+            outcome
+        };
+        let state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(guard) = &state.guard {
+            if let Some((completed_at, duration_ms)) = &state.source_end
+                && (outcome != OperationOutcome::Interrupted || !state.retry_waiting)
+            {
+                if self.observation.captures_content() {
+                    guard.capture_output(&model_output(&state));
+                }
+                guard.finish_at(outcome, completed_at.clone(), *duration_ms);
+            } else {
+                guard.finish_with_output_fn(outcome, || model_output(&state));
+            }
+        }
+    }
+
+    pub(crate) fn interruption_guard(&self) -> ModelInterruptionGuard {
+        ModelInterruptionGuard(self.clone())
+    }
+
+    pub(crate) fn retry_waiting(&self, waiting: bool) {
+        self.state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .retry_waiting = waiting;
+    }
+
+    pub(crate) fn source_ended(&self) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if self
+            .stream_generation
+            .is_some_and(|generation| generation != state.generation)
+        {
+            return;
+        }
+        if state.source_end.is_none() {
+            let source_end = state
+                .guard
+                .as_ref()
+                .map(|guard| (timestamp(), guard.started.elapsed().as_secs_f64() * 1000.0));
+            if source_end.is_some() {
+                state.source_end = source_end;
+            }
+        }
+    }
+
+    pub(crate) fn source_error(&self, error: &codex_api::ApiError) {
+        self.source_ended();
+        let state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if self
+            .stream_generation
+            .is_some_and(|generation| generation != state.generation)
+        {
+            return;
+        }
+        if let codex_api::ApiError::ResponseIncomplete(incomplete) = error
+            && let Some(guard) = &state.guard
+        {
+            guard.update(|event| {
+                event.metadata.response_id = incomplete.response_id.clone();
+                event.metadata.usage = incomplete
+                    .token_usage
+                    .as_ref()
+                    .and_then(|usage| serde_json::to_value(usage).ok());
+            });
+        }
+    }
+
+    fn request<T: Serialize + ?Sized>(
+        &self,
+        request: &T,
+        identity: &codex_api::ResponsesApiRequest,
+        endpoint: &str,
+    ) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.generation = state.generation.wrapping_add(1);
+        let previous_source_end = state.source_end.take();
+        state.retry_waiting = false;
+        state.authoritative_model = false;
+        // Exclude routing metadata and changing transport fields from retry identity.
+        let fingerprint = request_fingerprint(identity);
+        if state.guard.is_some() && state.fingerprint == Some(fingerprint) {
+            if let Some(guard) = &state.guard {
+                guard.update(|event| {
+                    event.metadata.response_id = None;
+                    event.metadata.observed_model = None;
+                    event.metadata.usage = None;
+                    event.metadata.response_id_trusted = trusted_response_endpoint(endpoint);
+                });
+                if self.observation.captures_content() {
+                    guard.capture_input(&model_request_content(request));
+                }
+            }
+            // A retried stream replaces any partial output from the failed attempt.
+            state.output.clear();
+            state.output_bytes = 0;
+            state.partial_text.clear();
+            state.partial_truncated = false;
+            return;
+        }
+        if let Some(previous) = state.guard.take() {
+            if self.observation.captures_content() {
+                previous.capture_output(&model_output(&state));
+            }
+            if let Some((completed_at, duration_ms)) = previous_source_end {
+                previous.finish_at(OperationOutcome::Error, completed_at, duration_ms);
+            } else {
+                previous.finish(OperationOutcome::Error);
+            }
+        }
+        state.output.clear();
+        state.output_bytes = 0;
+        state.partial_text.clear();
+        state.partial_truncated = false;
+        state.fingerprint = Some(fingerprint);
+        let guard = self.observation.start(
+            self.thread_id.clone(),
+            self.turn_id.clone(),
+            OperationKind::Model,
+            OperationMetadata {
+                requested_model: Some(self.requested_model.clone()),
+                response_id_trusted: trusted_response_endpoint(endpoint),
+                ..Default::default()
+            },
+        );
+        // Capture the assembled wire body, rather than the caller's input.
+        if self.observation.captures_content() {
+            guard.capture_input(&model_request_content(request));
+        }
+        state.guard = Some(guard);
+    }
+
+    pub(crate) fn for_stream(mut self) -> Self {
+        self.stream_generation = Some(
+            self.state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .generation,
+        );
+        self
+    }
+
+    pub(crate) fn event(&self, event: &codex_api::ResponseEvent) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if self
+            .stream_generation
+            .is_some_and(|generation| generation != state.generation)
+            || state.source_end.is_some()
+        {
+            return;
+        }
+        match event {
+            codex_api::ResponseEvent::OutputTextDelta(text)
+                if self.observation.captures_content() =>
+            {
+                let mut end = text
+                    .len()
+                    .min(CONTENT_LIMIT_BYTES.saturating_sub(state.partial_text.len()));
+                while !text.is_char_boundary(end) {
+                    end -= 1;
+                }
+                state.partial_text.push_str(&text[..end]);
+                state.partial_truncated |= end < text.len();
+            }
+            codex_api::ResponseEvent::OutputItemDone(item)
+                if self.observation.mode == OperationCaptureMode::Content =>
+            {
+                if matches!(item, codex_protocol::models::ResponseItem::Message { .. }) {
+                    state.partial_text.clear();
+                    state.partial_truncated = false;
+                }
+                if state.output_bytes < CONTENT_LIMIT_BYTES {
+                    let content = project_response_item(item);
+                    state.output_bytes += serde_json::to_vec(&content.value)
+                        .map_or(CONTENT_LIMIT_BYTES, |value| value.len());
+                    state.output.push(content.value);
+                    if content.truncated || content.omitted {
+                        state.output.push(serde_json::json!({"omitted":content.omitted,"truncated":content.truncated,"reason":content.reason}));
+                    }
+                } else if state
+                    .output
+                    .last()
+                    .and_then(|item| item.get("reason"))
+                    .and_then(Value::as_str)
+                    != Some("capture_budget")
+                {
+                    state
+                        .output
+                        .push(serde_json::json!({"truncated":true,"reason":"capture_budget"}));
+                }
+            }
+            codex_api::ResponseEvent::ModelObservation(model) => {
+                if !state.authoritative_model
+                    && let Some(guard) = &state.guard
+                {
+                    guard.update(|event| event.metadata.observed_model = Some(model.clone()));
+                }
+            }
+            codex_api::ResponseEvent::ServerModel(model) => {
+                state.authoritative_model = true;
+                if let Some(guard) = &state.guard {
+                    guard.update(|event| event.metadata.observed_model = Some(model.clone()));
+                }
+            }
+            codex_api::ResponseEvent::Created { response_id } => {
+                if let Some(guard) = &state.guard {
+                    guard.update(|event| event.metadata.response_id = response_id.clone());
+                }
+            }
+            codex_api::ResponseEvent::Completed {
+                response_id,
+                token_usage,
+                ..
+            } => {
+                if let Some(guard) = &state.guard {
+                    guard.update(|event| {
+                        event.metadata.response_id = Some(response_id.clone());
+                        event.metadata.usage = token_usage
+                            .as_ref()
+                            .and_then(|usage| serde_json::to_value(usage).ok());
+                    });
+                    guard.finish_with_output_fn(OperationOutcome::Success, || model_output(&state));
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+fn model_output(state: &ModelOperationState) -> Value {
+    let mut output = state.output.clone();
+    if !state.partial_text.is_empty() {
+        output.push(serde_json::json!({"type":"output_text","text":state.partial_text,"partial":true,"truncated":state.partial_truncated}));
+    }
+    Value::Array(output)
+}
+
+pub(crate) fn current_model_operation() -> Option<ModelOperation> {
+    CURRENT_MODEL_OPERATION.try_with(Clone::clone).ok()
+}
+
+/// Only wire messages and continuation identity consume the content budget.
+#[derive(Serialize)]
+pub(crate) struct ModelRequestContent<'a> {
+    #[serde(serialize_with = "serialize_model_inputs")]
+    pub input: &'a [codex_protocol::models::ResponseItem],
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub previous_response_id: Option<&'a str>,
+}
+
+fn serialize_model_inputs<S: serde::Serializer>(
+    input: &[codex_protocol::models::ResponseItem],
+    serializer: S,
+) -> Result<S::Ok, S::Error> {
+    use serde::ser::SerializeSeq;
+    let mut sequence = serializer.serialize_seq(None)?;
+    let mut projection = ContentProjection {
+        truncated: false,
+        omitted: false,
+    };
+    let mut used = 0;
+    for item in input {
+        let available = CONTENT_VALUE_LIMIT_BYTES.saturating_sub(used + 512);
+        if available < 84 {
+            sequence.serialize_element(
+                &serde_json::json!({"truncated":true,"reason":"capture_budget"}),
+            )?;
+            break;
+        }
+        let value = projection.response_item(item, available);
+        used += json_size(&value) + 2;
+        sequence.serialize_element(&value)?;
+    }
+    sequence.end()
+}
+
+fn project_response_item(item: &codex_protocol::models::ResponseItem) -> OperationContent {
+    project_with(|projection| projection.response_item(item, CONTENT_VALUE_LIMIT_BYTES))
+}
+
+pub(crate) fn observe_model_request<T: Serialize + ?Sized>(
+    request: &T,
+    identity: &codex_api::ResponsesApiRequest,
+    endpoint: &str,
+) {
+    if let Some(operation) = current_model_operation() {
+        operation.request(request, identity, endpoint);
+    }
+}
