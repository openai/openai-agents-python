+pub(crate) struct ModelInterruptionGuard(ModelOperation);
+
+impl Drop for ModelInterruptionGuard {
+    fn drop(&mut self) {
+        self.0.finish(OperationOutcome::Interrupted);
+    }
+}
+
+fn model_request_content(request: &(impl Serialize + ?Sized)) -> Value {
+    let mut value = match bounded_value(request) {
+        Ok(value) => value,
+        Err(reason) => return omitted_content(reason).value,
+    };
+    if let Value::Object(body) = &mut value {
+        // The per-direction content budget belongs to messages and instructions.
+        // Tool definitions affect request identity but must not consume that budget.
+        body.retain(|key, _| {
+            matches!(
+                key.as_str(),
+                "instructions" | "input" | "previous_response_id"
+            )
+        });
+    }
+    value
+}
+
+fn model_request_identity(request: &codex_api::ResponsesApiRequest) -> impl Serialize + '_ {
+    #[derive(Serialize)]
+    struct Identity<'a> {
+        input: &'a [codex_protocol::models::ResponseItem],
+        model: &'a str,
+        #[serde(skip_serializing_if = "Option::is_none")]
+        text: Option<&'a codex_api::TextControls>,
+        tool_choice: &'a str,
+        #[serde(skip_serializing_if = "Option::is_none")]
+        tools: Option<&'a codex_api::ResponsesApiTools>,
+    }
+    Identity {
+        input: &request.input,
+        model: &request.model,
+        text: request.text.as_ref(),
+        tool_choice: &request.tool_choice,
+        tools: request.tools.as_ref(),
+    }
+}
+
+fn request_fingerprint(request: &codex_api::ResponsesApiRequest) -> u64 {
+    use std::hash::Hasher;
+    struct Digest(std::collections::hash_map::DefaultHasher);
+    impl std::io::Write for Digest {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0.write(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut digest = Digest(std::collections::hash_map::DefaultHasher::new());
+    // Typed semantic fields borrow the prepared body. Transport metadata is excluded;
+    // request retries clone history and retain its map ordering and raw tool JSON.
+    let _ = serde_json::to_writer(&mut digest, &model_request_identity(request));
+    digest.0.finish()
+}
+
+fn trusted_response_endpoint(endpoint: &str) -> bool {
+    url::Url::parse(endpoint)
+        .is_ok_and(|url| url.scheme() == "https" && url.host_str() == Some("api.openai.com"))
+}
