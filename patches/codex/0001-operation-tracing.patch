index 0000000..1344548
--- /dev/null
+++ b/codex-rs/core/src/operation_observation.rs
@@ -0,0 +1,1348 @@
+//! Opt-in, in-memory operation facts for the host that owns a turn.
+//!
+//! These observations never enter the rollout or the telemetry logger. The host
+//! owns delivery and tracing policy; core owns operation boundaries and content.
+
+use chrono::SecondsFormat;
+use chrono::Utc;
+use futures::FutureExt;
+use serde::Serialize;
+use serde_json::Value;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Instant;
+
+pub const CONTENT_LIMIT_BYTES: usize = 32 * 1024;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub enum OperationCaptureMode {
+    Metadata,
+    Content,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub enum OperationKind {
+    Model,
+    Tool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub enum OperationOutcome {
+    Success,
+    Error,
+    Interrupted,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OperationPhase {
+    Started,
+    Completed,
+}
+
+#[derive(Clone, Debug, Default, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct OperationMetadata {
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub parent_operation_id: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub requested_model: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub observed_model: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub response_id: Option<String>,
+    pub response_id_trusted: bool,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub usage: Option<Value>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub tool_name: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub call_id: Option<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct OperationContent {
+    pub value: Value,
+    pub truncated: bool,
+    pub omitted: bool,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub reason: Option<String>,
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct OperationEvent {
+    #[serde(skip)]
+    pub phase: OperationPhase,
+    pub operation_id: String,
+    pub thread_id: String,
+    pub turn_id: String,
+    pub kind: OperationKind,
+    pub started_at: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub completed_at: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub duration_ms: Option<f64>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub outcome: Option<OperationOutcome>,
+    #[serde(flatten)]
+    pub metadata: OperationMetadata,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub input: Option<OperationContent>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub output: Option<OperationContent>,
+}
+
+pub trait OperationObserver: Send + Sync {
+    /// Must return promptly. Delivery failures must not affect execution.
+    fn emit(&self, event: OperationEvent);
+
+    /// Closes admission for this source turn before its terminal event.
+    fn turn_finished<'a>(
+        &'a self,
+        _thread_id: &'a str,
+        _turn_id: &'a str,
+    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
+        Box::pin(async {})
+    }
+}
+
+#[derive(Clone)]
+pub struct OperationObservation {
+    mode: OperationCaptureMode,
+    sink: Arc<dyn OperationObserver>,
+}
+
+impl std::fmt::Debug for OperationObservation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("OperationObservation")
+            .field("mode", &self.mode)
+            .finish_non_exhaustive()
+    }
+}
+
+impl OperationObservation {
+    pub fn new(mode: OperationCaptureMode, sink: Arc<dyn OperationObserver>) -> Self {
+        Self { mode, sink }
+    }
+
+    pub fn captures_content(&self) -> bool {
+        self.mode == OperationCaptureMode::Content
+    }
+
+    pub fn start(
+        &self,
+        thread_id: String,
+        turn_id: String,
+        kind: OperationKind,
+        metadata: OperationMetadata,
+    ) -> OperationGuard {
+        let started = Instant::now();
+        let event = OperationEvent {
+            phase: OperationPhase::Started,
+            operation_id: uuid::Uuid::new_v4().to_string(),
+            thread_id,
+            turn_id,
+            kind,
+            started_at: timestamp(),
+            completed_at: None,
+            duration_ms: None,
+            outcome: None,
+            metadata,
+            input: None,
+            output: None,
+        };
+        self.emit(event.clone());
+        OperationGuard {
+            operation_id: event.operation_id.clone(),
+            observation: self.clone(),
+            started,
+            state: Mutex::new(event),
+        }
+    }
+
+    pub async fn turn_finished(&self, thread_id: &str, turn_id: &str) {
+        let future = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            self.sink.turn_finished(thread_id, turn_id)
+        }));
+        if let Ok(future) = future {
+            let _ = std::panic::AssertUnwindSafe(future).catch_unwind().await;
+        }
+    }
+
+    fn emit(&self, event: OperationEvent) {
+        // An optional host observer must never unwind an agent operation.
+        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| self.sink.emit(event)));
+    }
+}
