+//! Filesystem preconditions for restoring an interrupted native patch approval.
+
+use crate::session::step_context::StepContext;
+use crate::tools::ApprovalContext;
+use codex_file_system::EnvironmentAccess;
+use codex_file_system::GetMetadataOptions;
+use codex_file_system::ReadFileOptions;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::ApplyPatchApprovalRequestEvent;
+use codex_protocol::protocol::FileChange;
+use codex_utils_path_uri::PathUri;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeMap;
+use std::io::ErrorKind;
+use std::path::Component;
+use std::path::Path;
+use std::path::PathBuf;
+
+#[derive(Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+struct PatchPreconditions {
+    version: u32,
+    files: BTreeMap<PathBuf, Option<String>>,
+}
+
+fn invalid(message: impl Into<String>) -> CodexErr {
+    CodexErr::InvalidRequest(message.into())
+}
+
+pub(crate) async fn capture_patch_approval_preconditions(
+    context: &ApprovalContext,
+    approval: &ApplyPatchApprovalRequestEvent,
+) -> CodexResult<Value> {
+    let review = &context.review_context;
+    let environment = review
+        .environments()
+        .single_local_environment()
+        .ok_or_else(|| {
+            invalid("Restoring patch approvals requires a single selected local environment")
+        })?;
+    let grants = review
+        .turn()
+        .granted_permissions(&environment.selection.environment_id);
+    serde_json::to_value(capture(&environment.fs_accessor(grants), approval).await?)
+        .map_err(|error| invalid(error.to_string()))
+}
+
+async fn capture_step(
+    step: &StepContext,
+    approval: &ApplyPatchApprovalRequestEvent,
+) -> CodexResult<PatchPreconditions> {
+    let environment = step
+        .environments
+        .single_local_environment()
+        .ok_or_else(|| {
+            invalid("Restoring patch approvals requires a single selected local environment")
+        })?;
+    capture(&step.fs_accessor(environment), approval).await
+}
+
+pub(crate) async fn validate_patch_preconditions(
+    step: &StepContext,
+    approval: &ApplyPatchApprovalRequestEvent,
+    checkpoint: &Value,
+) -> CodexResult<()> {
+    let expected: PatchPreconditions = serde_json::from_value(checkpoint.clone())
+        .map_err(|error| invalid(format!("Invalid patch approval preconditions: {error}")))?;
+    let observed = capture_step(step, approval).await?;
+    if expected != observed {
+        return Err(invalid(
+            "The pending patch or its files have changed since the original approval request",
+        ));
+    }
+    Ok(())
+}
+
+async fn capture(
+    fs: &impl EnvironmentAccess,
+    approval: &ApplyPatchApprovalRequestEvent,
+) -> CodexResult<PatchPreconditions> {
+    if approval.changes.is_empty() {
+        return Err(invalid("A pending patch must include file changes"));
+    }
+    let mut files = BTreeMap::new();
+    for (path, change) in &approval.changes {
+        let is_add = matches!(change, FileChange::Add { .. });
+        let original = observe_file(fs, path, is_add).await?;
+        if let FileChange::Delete { content } = change
+            && original.as_deref() != Some(&digest(content.as_bytes()))
+        {
+            return Err(invalid(
+                "The pending deletion no longer matches its original file",
+            ));
+        }
+        files.insert(path.clone(), original);
+        if let FileChange::Update {
+            move_path: Some(destination),
+            ..
+        } = change
+        {
+            if approval.changes.contains_key(destination) || files.contains_key(destination) {
+                return Err(invalid(
+                    "Pending patch move destinations must be distinct from changed files",
+                ));
+            }
+            files.insert(
+                destination.clone(),
+                observe_file(fs, destination, true).await?,
+            );
+        }
+    }
+    Ok(PatchPreconditions { version: 1, files })
+}
+
+fn digest(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+async fn observe_file(
+    fs: &impl EnvironmentAccess,
+    path: &Path,
+    must_be_absent: bool,
+) -> CodexResult<Option<String>> {
+    if !path.is_absolute()
+        || path
+            .components()
+            .any(|part| matches!(part, Component::ParentDir | Component::CurDir))
+    {
+        return Err(invalid(
+            "Pending patch paths must be normalized absolute local paths",
+        ));
+    }
+    // The selected local filesystem's no-follow operations reject symlinks in
+    // every component, including directory ancestors, without opening targets.
+    let uri = PathUri::from_host_native_path(path).map_err(|error| invalid(error.to_string()))?;
+    match fs
+        .get_metadata(
+            &uri,
+            GetMetadataOptions {
+                follow_symlinks: false,
+            },
+        )
+        .await
+    {
+        Err(error) if must_be_absent && error.kind() == ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(invalid(format!(
+            "Cannot inspect pending patch file: {error}"
+        ))),
+        Ok(_) if must_be_absent => Err(invalid("A pending patch destination already exists")),
+        Ok(metadata) if !metadata.is_file || metadata.is_symlink => {
+            Err(invalid("Pending patch sources must be regular files"))
+        }
+        Ok(_) => {
+            let bytes = fs
+                .read_file(
+                    &uri,
+                    ReadFileOptions {
+                        follow_symlinks: false,
+                    },
+                )
+                .await
+                .map_err(|error| invalid(format!("Cannot read pending patch file: {error}")))?;
+            Ok(Some(digest(&bytes)))
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_exec_server::LOCAL_FS;
+    use codex_file_system::FileSystemEnvironmentAccessor;
+
+    fn approval(path: PathBuf, change: FileChange) -> ApplyPatchApprovalRequestEvent {
+        ApplyPatchApprovalRequestEvent {
+            call_id: "original-call".into(),
+            turn_id: "original-turn".into(),
+            started_at_ms: 0,
+            changes: [(path, change)].into_iter().collect(),
+            reason: None,
+            grant_root: None,
+        }
+    }
+
+    #[tokio::test]
+    async fn existing_update_binds_full_original_contents() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("existing.txt");
+        std::fs::write(&path, "old\nuntouched\n").unwrap();
+        let fs = FileSystemEnvironmentAccessor::unrestricted(&LOCAL_FS);
+        let request = approval(
+            path.clone(),
+            FileChange::Update {
+                unified_diff: "-old\n+new\n".into(),
+                move_path: None,
+            },
+        );
+        let original = capture(&fs, &request).await.unwrap();
+        assert_eq!(original, capture(&fs, &request).await.unwrap());
+        std::fs::write(&path, "old\nchanged outside patch context\n").unwrap();
+        assert_ne!(original, capture(&fs, &request).await.unwrap());
+    }
+
+    #[tokio::test]
+    async fn add_requires_absent_destination_and_blocks_completed_replay() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("new.txt");
+        let fs = FileSystemEnvironmentAccessor::unrestricted(&LOCAL_FS);
+        let request = approval(
+            path.clone(),
+            FileChange::Add {
+                content: "new\n".into(),
+            },
+        );
+        assert!(capture(&fs, &request).await.is_ok());
+        std::fs::write(path, "new\n").unwrap();
+        assert!(capture(&fs, &request).await.is_err());
+    }
+
+    #[tokio::test]
+    async fn move_requires_absent_destination() {
+        let dir = tempfile::tempdir().unwrap();
+        let source = dir.path().join("old.txt");
+        let destination = dir.path().join("new.txt");
+        std::fs::write(&source, "old\n").unwrap();
+        let fs = FileSystemEnvironmentAccessor::unrestricted(&LOCAL_FS);
+        let request = approval(
+            source,
+            FileChange::Update {
+                unified_diff: "-old\n+new\n".into(),
+                move_path: Some(destination.clone()),
+            },
+        );
+        assert!(capture(&fs, &request).await.is_ok());
+        std::fs::write(destination, "pre-existing work\n").unwrap();
+        assert!(capture(&fs, &request).await.is_err());
+    }
+
+    #[tokio::test]
+    async fn delete_requires_original_contents() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("old.txt");
+        std::fs::write(&path, "original\n").unwrap();
+        let fs = FileSystemEnvironmentAccessor::unrestricted(&LOCAL_FS);
+        let request = approval(
+            path.clone(),
+            FileChange::Delete {
+                content: "original\n".into(),
+            },
+        );
+        assert!(capture(&fs, &request).await.is_ok());
+        std::fs::write(path, "changed\n").unwrap();
+        assert!(capture(&fs, &request).await.is_err());
+    }
+
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn rejects_symlink_sources_and_ancestors() {
+        let dir = tempfile::tempdir().unwrap();
+        let original = dir.path().join("original");
+        std::fs::create_dir(&original).unwrap();
+        std::fs::write(original.join("file"), "original\n").unwrap();
+        let link = dir.path().join("link");
+        std::os::unix::fs::symlink(&original, &link).unwrap();
+        let fs = FileSystemEnvironmentAccessor::unrestricted(&LOCAL_FS);
+        let request = approval(
+            link.join("file"),
+            FileChange::Update {
+                unified_diff: "-original\n+new\n".into(),
+                move_path: None,
+            },
+        );
+        assert!(capture(&fs, &request).await.is_err());
+        let request = approval(
+            link.join("new"),
+            FileChange::Add {
+                content: "new".into(),
+            },
+        );
+        assert!(capture(&fs, &request).await.is_err());
+        let file_link = dir.path().join("file-link");
+        std::os::unix::fs::symlink(original.join("file"), &file_link).unwrap();
+        let request = approval(
+            file_link,
+            FileChange::Update {
+                unified_diff: "-original\n+new\n".into(),
+                move_path: None,
+            },
+        );
+        assert!(capture(&fs, &request).await.is_err());
+        let dangling_link = dir.path().join("dangling-link");
+        std::os::unix::fs::symlink(dir.path().join("absent"), &dangling_link).unwrap();
+        let request = approval(
+            dangling_link,
+            FileChange::Add {
+                content: "new".into(),
+            },
+        );
+        assert!(capture(&fs, &request).await.is_err());
+    }
+}
