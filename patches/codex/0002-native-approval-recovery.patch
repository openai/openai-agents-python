+    let link = allowed.join("link");
+    symlink(&file, &link)?;
+    let directory_link = allowed.join("directory-link");
+    symlink(&allowed, &directory_link)?;
+    let sandbox = read_only_sandbox(allowed);
+    let options = ReadFileOptions {
+        follow_symlinks: false,
+    };
+    for permissions in [None, Some(&sandbox)] {
+        let fs = &context.file_system;
+        assert_eq!(
+            fs.read_file_bounded(
+                &PathUri::from_host_native_path(&file)?,
+                options,
+                5,
+                permissions
+            )
+            .await?,
+            b"hello"
+        );
+        let oversized = fs
+            .read_file_bounded(
+                &PathUri::from_host_native_path(&file)?,
+                options,
+                4,
+                permissions,
+            )
+            .await
+            .unwrap_err();
+        assert!(oversized.to_string().contains("limit is 4 bytes"));
+        for path in [&link, &directory_link.join("file")] {
+            assert!(
+                fs.read_file_bounded(
+                    &PathUri::from_host_native_path(path)?,
+                    options,
+                    16,
+                    permissions
+                )
+                .await
+                .is_err()
+            );
+        }
+    }
+    let error = context
+        .file_system
+        .read_file_bounded(
+            &PathUri::from_host_native_path(&secret)?,
+            options,
+            16,
+            Some(&sandbox),
+        )
+        .await
+        .unwrap_err();
+    assert_sandbox_denied(&error);
+    Ok(())
+}
