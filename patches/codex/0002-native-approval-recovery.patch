+
+    fn approval(path: PathBuf, change: FileChange) -> ApplyPatchApprovalRequestEvent {
+        ApplyPatchApprovalRequestEvent {
+            call_id: "original-call".into(),
+            turn_id: "original-turn".into(),
+            started_at_ms: 0,
+            changes: [(path, change)].into_iter().collect(),
+            reason: None,
+            grant_root: None,
+        }
+    }
+
+    #[tokio::test]
+    async fn existing_update_binds_full_original_contents() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("existing.txt");
+        std::fs::write(&path, "old\nuntouched\n").unwrap();
+        let fs = FileSystemEnvironmentAccessor::unrestricted(&LOCAL_FS);
+        let request = approval(
+            path.clone(),
+            FileChange::Update {
+                unified_diff: "-old\n+new\n".into(),
+                move_path: None,
+            },
+        );
+        let original = capture(&fs, &request.changes).await.unwrap();
+        assert_eq!(original, capture(&fs, &request.changes).await.unwrap());
+        std::fs::write(&path, "old\nchanged outside patch context\n").unwrap();
+        assert_ne!(original, capture(&fs, &request.changes).await.unwrap());
+    }
+
+    #[tokio::test]
+    async fn add_requires_absent_destination_and_blocks_completed_replay() {
+        let dir = tempfile::tempdir().unwrap();
