@@ -0,0 +1,692 @@
+//! Model-free replay of one native call, requiring the same fresh human approval.
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, OnceLock};
+
+use codex_protocol::approvals::ExecApprovalKind;
+use codex_protocol::config_types::ApprovalsReviewer;
+use codex_protocol::error::{CodexErr, Result as CodexResult};
+use codex_protocol::models::ResponseItem;
+use codex_protocol::openai_models::ToolMode;
+use codex_protocol::protocol::{EventMsg, FileChange, ReviewDecision};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use tokio_util::sync::CancellationToken;
+
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::session::turn_context::TurnContext;
+use crate::state::TaskKind;
+use crate::tools::ApprovalContext;
+use crate::tools::parallel::ToolCallRuntime;
+use crate::tools::router::ToolRouter;
+use crate::tools::sandboxing::ApprovalAction;
+
+fn refusal(message: &str) -> CodexErr {
+    CodexErr::InvalidRequest(format!("Native tool restoration refused: {message}"))
+}
+
+#[derive(Debug)]
+struct CapturedPatch {
+    changes: Arc<HashMap<PathBuf, FileChange>>,
+    preconditions: Value,
+}
+
+#[derive(Debug)]
+struct CapturableApproval {
+    event: Option<EventMsg>,
+    permissions: Value,
+    patch: Option<CapturedPatch>,
+}
+
+impl CapturableApproval {
+    fn checkpoint(&self, expected: &EventMsg) -> CodexResult<Value> {
+        // Reuse the pre-approval scan only for the exact changes on this live lease.
+        let patch = match (&self.patch, expected) {
+            (Some(patch), EventMsg::ApplyPatchApprovalRequest(event))
+                if patch.changes.as_ref() == &event.changes =>
+            {
+                Some(&patch.preconditions)
+            }
+            (None, EventMsg::ExecApprovalRequest(_)) => None,
+            _ => return Err(refusal("approval does not match the captured action")),
+        };
+        let expected =
+            serde_json::to_value(expected).map_err(|_| refusal("invalid approval event"))?;
+        if self
+            .event
+            .as_ref()
+            .and_then(|event| serde_json::to_value(event).ok())
+            != Some(expected)
+        {
+            return Err(refusal("approval does not match the live request"));
+        }
+        Ok(json!({"version":1,"first_approval":true,"permissions":self.permissions,"patch":patch}))
+    }
+}
+
+#[derive(Debug, Default)]
+struct CapturableApprovals(Mutex<HashMap<String, CapturableApproval>>);
+
+impl crate::WithTurnExtensionData<crate::TurnInputRequest> {
+    /// Enables pre-execution native approval checkpoint capture for SDK-owned turns.
+    pub fn capture_native_approvals(mut self) -> Self {
+        self.turn_extension_init
+            .get_or_insert_with(Default::default)
+            .insert(CapturableApprovals::default());
+        self
+    }
+}
+
+fn permission_snapshot(
+    turn: &TurnContext,
+    environments: &crate::environment_selection::TurnEnvironmentSnapshot,
+    policy: codex_protocol::protocol::AskForApproval,
+    reviewer: ApprovalsReviewer,
+) -> Value {
+    let environments: Vec<_> = environments
+        .turn_environments()
+        .map(|environment| {
+            json!({
+                "id": environment.selection.environment_id,
+                "profile": environment.permission_profile_with_workspace_roots(),
+                "symbolic_profile": environment.permission_profile(),
+                "network": environment.config().network_policy,
+                "grants": turn.granted_permissions(&environment.selection.environment_id),
+            })
+        })
+        .collect();
+    let mut snapshot = json!({
+        "approval_policy": policy, "reviewer": reviewer, "environments": environments,
+        "managed_network": turn.config.permissions.network.as_ref().map(|network| network.environment_policy()),
+    });
+    snapshot.sort_all_objects();
+    json!(format!(
+        "{:x}",
+        Sha256::digest(snapshot.to_string().as_bytes())
+    ))
+}
+
+pub(crate) struct CaptureLease {
+    state: Arc<CapturableApprovals>,
+    call_id: String,
+}
+
+impl Drop for CaptureLease {
+    fn drop(&mut self) {
+        self.state.0.lock().unwrap().remove(&self.call_id);
+    }
+}
+
+pub(crate) async fn capture_lease(
+    action: &ApprovalAction,
+    ctx: &ApprovalContext,
+) -> Option<CaptureLease> {
+    if ctx.retry_reason.is_some()
+        || ctx.network_approval_context.is_some()
+        || !matches!(
+            action,
+            ApprovalAction::ExecCommand { .. } | ApprovalAction::ApplyPatch { .. }
+        )
+    {
+        return None;
+    }
+    let state = ctx
+        .review_context
+        .turn()
+        .extension_data
+        .get::<CapturableApprovals>()?;
+    let patch = if let ApprovalAction::ApplyPatch { changes, .. } = action {
+        let preconditions =
+            crate::patch_preconditions::capture_patch_approval_preconditions(ctx, changes)
+                .await
+                .ok()?;
+        Some(CapturedPatch {
+            changes: Arc::clone(changes),
+            preconditions,
+        })
+    } else {
+        None
+    };
+    state.0.lock().unwrap().insert(
+        ctx.call_id.clone(),
+        CapturableApproval {
+            event: None,
+            patch,
+            permissions: permission_snapshot(
+                ctx.review_context.turn(),
+                ctx.review_context.environments(),
+                ctx.review_context.approval_policy,
+                ctx.review_context.approvals_reviewer,
+            ),
+        },
+    );
+    Some(CaptureLease {
+        state,
+        call_id: ctx.call_id.clone(),
+    })
+}
+
+fn approval_id(event: &EventMsg) -> Option<&str> {
+    match event {
+        EventMsg::ExecApprovalRequest(event)
+            if event.kind == ExecApprovalKind::Command
+                && event.approval_id.is_none()
+                && event.network_approval_context.is_none() =>
+        {
+            Some(&event.call_id)
+        }
+        EventMsg::ApplyPatchApprovalRequest(event) if event.grant_root.is_none() => {
+            Some(&event.call_id)
+        }
+        _ => None,
+    }
+}
+
+fn comparable(event: &EventMsg) -> CodexResult<Value> {
+    let mut value = serde_json::to_value(event).map_err(|_| refusal("invalid approval event"))?;
+    let object = value
+        .as_object_mut()
+        .ok_or_else(|| refusal("invalid approval event"))?;
+    object.remove("turn_id");
+    object.remove("started_at_ms");
+    Ok(value)
+}
+
+pub(crate) fn record_capture_event(turn: &TurnContext, event: &EventMsg) {
+    let Some(id) = approval_id(event) else { return };
+    if let Some(state) = turn.extension_data.get::<CapturableApprovals>() {
+        if let Some(pending) = state.0.lock().unwrap().get_mut(id) {
+            pending.event = Some(event.clone());
+        }
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct RestoreToolCall {
+    call: ResponseItem,
+    expected: EventMsg,
+    checkpoint: Value,
+    owner: OnceLock<String>,
+    requested: AtomicBool,
+    approved: AtomicBool,
+    executed: AtomicBool,
+}
+
+impl RestoreToolCall {
+    pub(crate) fn new(
+        call: ResponseItem,
+        expected: EventMsg,
+        checkpoint: Option<Value>,
+    ) -> CodexResult<Self> {
+        let id = approval_id(&expected).ok_or_else(|| refusal("unsupported approval request"))?;
+        let supported = match (&call, &expected) {
+            (
+                ResponseItem::FunctionCall {
+                    name,
+                    call_id,
+                    namespace,
+                    ..
+                },
+                EventMsg::ExecApprovalRequest(_),
+            ) => {
+                name == "exec_command"
+                    && call_id == id
+                    && namespace.as_deref().is_none_or(|ns| ns == "functions")
+            }
+            (
+                ResponseItem::CustomToolCall {
+                    name,
+                    call_id,
+                    namespace,
+                    ..
+                },
+                EventMsg::ApplyPatchApprovalRequest(_),
+            ) => {
+                name == "apply_patch"
+                    && call_id == id
+                    && namespace.as_deref().is_none_or(|ns| ns == "functions")
+            }
+            _ => false,
+        };
+        if !supported {
+            return Err(refusal(
+                "only one direct exec_command or apply_patch call is supported",
+            ));
+        }
+        let checkpoint =
+            checkpoint.ok_or_else(|| refusal("missing original pre-execution checkpoint"))?;
+        if checkpoint.get("version") != Some(&json!(1))
+            || checkpoint.get("first_approval") != Some(&json!(true))
+        {
+            return Err(refusal("checkpoint does not match the original approval"));
+        }
+        Ok(Self {
+            call,
+            expected,
+            checkpoint,
+            owner: OnceLock::new(),
+            requested: AtomicBool::new(false),
+            approved: AtomicBool::new(false),
+            executed: AtomicBool::new(false),
+        })
+    }
+
+    pub(crate) fn accepts_approval(&self, action: &ApprovalAction, ctx: &ApprovalContext) -> bool {
+        if ctx.retry_reason.is_some()
+            || ctx.network_approval_context.is_some()
+            || ctx.strict_auto_review
+            || self.requested.load(Ordering::SeqCst)
+            || approval_id(&self.expected) != Some(ctx.call_id.as_str())
+        {
+            return false;
+        }
+        matches!(
+            (&self.expected, action),
+            (
+                EventMsg::ExecApprovalRequest(_),
+                ApprovalAction::ExecCommand { .. }
+            ) | (
+                EventMsg::ApplyPatchApprovalRequest(_),
+                ApprovalAction::ApplyPatch { .. }
+            )
+        )
+    }
+
+    pub(crate) fn is_patch(&self) -> bool {
+        matches!(self.expected, EventMsg::ApplyPatchApprovalRequest(_))
+    }
+
+    pub(crate) fn claim(&self, turn: &TurnContext) -> bool {
+        self.owner.set(turn.sub_id.clone()).is_ok()
+    }
+}
+
+pub(crate) fn active(turn: &TurnContext) -> Option<Arc<RestoreToolCall>> {
+    turn.extension_data
+        .get::<RestoreToolCall>()
+        .filter(|restore| restore.owner.get() == Some(&turn.sub_id))
+}
+
+async fn validate_step(session: &Arc<Session>, step: &StepContext) -> CodexResult<()> {
+    let config = session.get_config().await;
+    let requirements = config.config_layer_stack.requirements();
+    if requirements.auto_review_required_for_model(&step.settings.model_info.slug)
+        || requirements
+            .approvals_reviewer
+            .can_set(&ApprovalsReviewer::User)
+            .is_err()
+    {
+        return Err(refusal("managed automatic review is unsupported"));
+    }
+    if step.tool_router.tool_mode() != ToolMode::Direct
+        || step.environments.single_local_environment().is_none()
+    {
+        return Err(refusal(
+            "only direct tools in one local environment are supported",
+        ));
+    }
+    if step.settings.approvals_reviewer() != ApprovalsReviewer::User
+        || step.turn.strict_auto_review_enabled()
+    {
+        return Err(refusal("automatic approval review is unsupported"));
+    }
+    let hooks = session.hooks().list_with_environment_hooks(
+        crate::hook_environment_executor::environment_hook_sources(&step.environments, &[]),
+    );
+    if !hooks.hooks.is_empty()
+        || !hooks.warnings.is_empty()
+        || !step.executor_hook_sources.is_empty()
+    {
+        return Err(refusal("configured hooks are unsupported"));
+    }
+    if let Some(restore) = active(&step.turn) {
+        if restore.checkpoint.get("permissions")
+            != Some(&permission_snapshot(
+                &step.turn,
+                &step.environments,
+                step.settings.approval_policy(),
+                step.settings.approvals_reviewer(),
+            ))
+        {
+            return Err(refusal("permissions or approval policy changed"));
+        }
+    }
+    Ok(())
+}
+
+pub(crate) async fn capture(session: &Arc<Session>, expected: EventMsg) -> CodexResult<Value> {
+    let (turn, cancellation) = session
+        .active_turn_context_and_cancellation_token()
+        .await
+        .ok_or_else(|| refusal("no active approval"))?;
+    let id = approval_id(&expected).ok_or_else(|| refusal("unsupported approval request"))?;
+    let state = turn
+        .extension_data
+        .get::<CapturableApprovals>()
+        .ok_or_else(|| refusal("not a first pre-execution approval"))?;
+    let step = session.capture_step_context(turn, &cancellation).await?;
+    validate_step(session, &step).await?;
+    let approvals = state.0.lock().unwrap();
+    approvals
+        .get(id)
+        .ok_or_else(|| refusal("not a pending first pre-execution approval"))?
+        .checkpoint(&expected)
+}
+
+pub(crate) fn compare_request(turn: &TurnContext, event: &EventMsg) -> bool {
+    record_capture_event(turn, event);
+    let Some(restore) = active(turn) else {
+        return true;
+    };
+    !restore.requested.swap(true, Ordering::SeqCst)
+        && approval_id(event) == approval_id(&restore.expected)
+        && matches!((comparable(event), comparable(&restore.expected)), (Ok(observed), Ok(expected)) if observed == expected)
+}
+
+pub(crate) fn record_decision(turn: &TurnContext, decision: ReviewDecision) -> ReviewDecision {
+    if let Some(restore) = active(turn) {
+        if decision == ReviewDecision::Approved {
+            restore.approved.store(true, Ordering::SeqCst);
+        } else if !matches!(
+            decision,
+            ReviewDecision::Denied { .. } | ReviewDecision::Abort
+        ) {
+            return ReviewDecision::Abort;
+        }
+    }
+    decision
+}
+
+pub(crate) async fn validate_before_execution(
+    session: &Arc<Session>,
+    step: &StepContext,
+) -> CodexResult<()> {
+    let Some(restore) = active(&step.turn) else {
+        return Ok(());
+    };
+    validate_step(session, step).await?;
+    if !restore.approved.load(Ordering::SeqCst) {
+        return Err(refusal("a matching fresh human approval is required"));
+    }
+    if let EventMsg::ApplyPatchApprovalRequest(event) = &restore.expected {
+        let checkpoint = restore
+            .checkpoint
+            .get("patch")
+            .ok_or_else(|| refusal("missing patch preimages"))?;
+        crate::patch_preconditions::validate_patch_preconditions(step, event, checkpoint).await?;
+    }
+    if restore.executed.swap(true, Ordering::SeqCst) {
+        return Err(refusal("a restored native call cannot retry execution"));
+    }
+    Ok(())
+}
+
+pub(crate) async fn run(
+    session: Arc<Session>,
+    turn: Arc<TurnContext>,
+    restore: Arc<RestoreToolCall>,
+    cancellation: CancellationToken,
+) -> crate::tasks::SessionTaskResult {
+    session.emit_turn_started(&turn, TaskKind::Regular).await;
+    let step = session
+        .capture_step_context(Arc::clone(&turn), &cancellation)
+        .await?;
+    validate_step(&session, &step).await?;
+    if let EventMsg::ApplyPatchApprovalRequest(event) = &restore.expected {
+        let checkpoint = restore
+            .checkpoint
+            .get("patch")
+            .ok_or_else(|| refusal("missing patch preimages"))?;
+        crate::patch_preconditions::validate_patch_preconditions(&step, event, checkpoint).await?;
+    }
+    let call = ToolRouter::build_tool_call(restore.call.clone())
+        .map_err(|_| refusal("invalid native call"))?
+        .ok_or_else(|| refusal("unsupported native call"))?;
+    if !step.tool_router.exposes_tool(&call.tool_name) {
+        return Err(refusal("tool is unavailable in the replacement worker"));
+    }
+    crate::stream_events_utils::record_completed_response_item(&session, &step, &restore.call)
+        .await;
+    let result = ToolCallRuntime::new(Arc::clone(&session), Arc::clone(&step), Default::default())
+        .handle_tool_call(call, cancellation)
+        .await?;
+    crate::stream_events_utils::record_completed_response_item(&session, &step, &result.item).await;
+    Ok(None)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::protocol::AskForApproval;
+
+    fn command() -> ResponseItem {
+        serde_json::from_value(json!({
+            "type":"function_call", "call_id":"original", "name":"exec_command",
+            "arguments":"{\"cmd\":\"printf original\"}",
+        }))
+        .unwrap()
+    }
+
+    fn approval() -> EventMsg {
+        serde_json::from_value(json!({
+            "type":"exec_approval_request", "kind":"command", "call_id":"original",
+            "turn_id":"first-turn", "started_at_ms":1, "command":["sh","-c","printf original"],
+            "cwd":"/workspace", "environmentId":"local", "parsed_cmd":[],
+        }))
+        .unwrap()
+    }
+
+    fn checkpoint() -> Value {
+        json!({"version":1,"first_approval":true,"permissions":"test-fingerprint","patch":null})
+    }
+
+    #[test]
+    fn reuses_patch_snapshot_only_for_the_live_event_and_original_changes() {
+        let path = PathBuf::from("/workspace/new");
+        let changes = HashMap::from([(
+            path.clone(),
+            FileChange::Add {
+                content: "first".into(),
+            },
+        )]);
+        let mut request = codex_protocol::approvals::ApplyPatchApprovalRequestEvent {
+            call_id: "original".into(),
+            turn_id: "first-turn".into(),
+            started_at_ms: 1,
+            changes: changes.clone(),
+            reason: None,
+            grant_root: None,
+        };
+        let original = EventMsg::ApplyPatchApprovalRequest(request.clone());
+        let snapshot = json!({"version":1,"files":{"/workspace/new":null}});
+        let mut lease = CapturableApproval {
+            event: Some(original.clone()),
+            permissions: json!("test-fingerprint"),
+            patch: Some(CapturedPatch {
+                changes: Arc::new(changes),
+                preconditions: snapshot.clone(),
+            }),
+        };
+        assert_eq!(lease.checkpoint(&original).unwrap()["patch"], snapshot);
+        request.started_at_ms += 1;
+        assert!(
+            lease
+                .checkpoint(&EventMsg::ApplyPatchApprovalRequest(request.clone()))
+                .is_err()
+        );
+        request.changes.insert(
+            path,
+            FileChange::Add {
+                content: "second".into(),
+            },
+        );
+        let changed = EventMsg::ApplyPatchApprovalRequest(request);
+        lease.event = Some(changed.clone());
+        assert!(lease.checkpoint(&changed).is_err());
+    }
+
+    #[test]
+    fn rejects_unrelated_calls_and_noninitial_approvals() {
+        let mut call = command();
+        if let ResponseItem::FunctionCall { call_id, .. } = &mut call {
+            *call_id = "sibling".into();
+        }
+        assert!(RestoreToolCall::new(call, approval(), Some(checkpoint())).is_err());
+        let mut request = approval();
+        if let EventMsg::ExecApprovalRequest(event) = &mut request {
+            event.approval_id = Some("subcommand".into());
+        }
+        assert!(RestoreToolCall::new(command(), request, Some(checkpoint())).is_err());
+        assert!(RestoreToolCall::new(command(), approval(), None).is_err());
+    }
+
+    #[tokio::test]
+    async fn requires_exact_fresh_approval_and_consumes_execution_once() {
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let session = Arc::new(session);
+        let turn = Arc::new(turn);
+        let step = session
+            .capture_step_context(Arc::clone(&turn), &CancellationToken::new())
+            .await
+            .unwrap();
+        let mut preconditions = checkpoint();
+        preconditions["permissions"] = permission_snapshot(
+            &turn,
+            &step.environments,
+            step.settings.approval_policy(),
+            step.settings.approvals_reviewer(),
+        );
+        let restore = RestoreToolCall::new(command(), approval(), Some(preconditions)).unwrap();
+        turn.extension_data.insert(restore);
+        let restore = turn.extension_data.get::<RestoreToolCall>().unwrap();
+        assert!(restore.claim(&turn));
+        assert!(!restore.claim(&turn));
+        assert!(validate_before_execution(&session, &step).await.is_err());
+        assert!(compare_request(&turn, &approval()));
+        assert_eq!(
+            record_decision(&turn, ReviewDecision::Approved),
+            ReviewDecision::Approved
+        );
+        assert!(validate_before_execution(&session, &step).await.is_ok());
+        assert!(validate_before_execution(&session, &step).await.is_err());
+        assert!(!compare_request(&turn, &approval()));
+    }
+
+    #[tokio::test]
+    async fn refuses_changed_command_before_approval() {
+        let (_, turn) = crate::session::tests::make_session_and_context().await;
+        turn.extension_data
+            .insert(RestoreToolCall::new(command(), approval(), Some(checkpoint())).unwrap());
+        assert!(
