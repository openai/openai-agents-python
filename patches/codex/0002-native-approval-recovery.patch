+//! Filesystem preconditions for restoring an interrupted native patch approval.
+
+use crate::session::step_context::StepContext;
+use crate::tools::ApprovalContext;
+use codex_file_system::EnvironmentAccess;
+use codex_file_system::GetMetadataOptions;
+use codex_file_system::ReadFileOptions;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::ApplyPatchApprovalRequestEvent;
+use codex_protocol::protocol::FileChange;
+use codex_utils_path_uri::PathUri;
+use serde::Serialize;
+use serde_json::Value;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeMap;
+use std::collections::HashMap;
+use std::io::ErrorKind;
+use std::path::Component;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::Duration;
+
+// Approval recovery fails closed for larger preimages instead of retaining large reads.
+const MAX_PATCH_PREIMAGE_BYTES: u64 = 8 * 1024 * 1024;
+const MAX_PATCH_PATHS: usize = 32;
+const MAX_PATCH_SCAN_BYTES: u64 = 16 * 1024 * 1024;
+const MAX_PATCH_SCAN_DURATION: Duration = Duration::from_secs(10);
+
+#[derive(Debug, Serialize, PartialEq)]
+struct PatchPreconditions {
+    version: u32,
+    files: BTreeMap<PathBuf, Option<String>>,
+}
+
+fn invalid(message: impl Into<String>) -> CodexErr {
+    CodexErr::InvalidRequest(message.into())
+}
+
+pub(crate) async fn capture_patch_approval_preconditions(
+    context: &ApprovalContext,
+    changes: &HashMap<PathBuf, FileChange>,
+) -> CodexResult<Value> {
+    let review = &context.review_context;
+    let environment = review
+        .environments()
+        .single_local_environment()
+        .ok_or_else(|| {
+            invalid("Restoring patch approvals requires a single selected local environment")
+        })?;
+    let grants = review
+        .turn()
+        .granted_permissions(&environment.selection.environment_id);
+    serde_json::to_value(capture(&environment.fs_accessor(grants), changes).await?)
+        .map_err(|error| invalid(error.to_string()))
+}
+
+async fn capture_step(
+    step: &StepContext,
+    changes: &HashMap<PathBuf, FileChange>,
+) -> CodexResult<PatchPreconditions> {
+    let environment = step
+        .environments
+        .single_local_environment()
+        .ok_or_else(|| {
+            invalid("Restoring patch approvals requires a single selected local environment")
+        })?;
+    capture(&step.fs_accessor(environment), changes).await
+}
+
+pub(crate) async fn validate_patch_preconditions(
+    step: &StepContext,
+    approval: &ApplyPatchApprovalRequestEvent,
+    checkpoint: &Value,
+) -> CodexResult<()> {
+    let expected = validate_checkpoint(&approval.changes, checkpoint)?;
+    let observed = capture_step(step, &approval.changes).await?;
+    if observed.files.iter().any(|(path, digest)| {
+        match (digest, path.to_str().and_then(|path| expected.get(path))) {
+            (Some(digest), Some(Value::String(expected))) => digest != expected,
+            (None, Some(Value::Null)) => false,
+            _ => true,
+        }
+    }) {
+        return Err(invalid(
+            "The pending patch or its files have changed since the original approval request",
+        ));
+    }
+    Ok(())
+}
+
+fn patch_paths(changes: &HashMap<PathBuf, FileChange>) -> CodexResult<BTreeMap<&PathBuf, bool>> {
+    if changes.is_empty() {
+        return Err(invalid("A pending patch must include file changes"));
+    }
+    if changes.len() > MAX_PATCH_PATHS {
+        return Err(invalid("Pending patch scans are limited to 32 paths"));
+    }
+    let mut count = changes.len();
+    for change in changes.values() {
+        if matches!(
+            change,
+            FileChange::Update {
+                move_path: Some(_),
+                ..
+            }
+        ) {
+            count += 1;
+            if count > MAX_PATCH_PATHS {
+                return Err(invalid("Pending patch scans are limited to 32 paths"));
+            }
+        }
+    }
+    let mut paths: BTreeMap<_, _> = changes
+        .iter()
+        .map(|(path, change)| (path, matches!(change, FileChange::Add { .. })))
+        .collect();
+    for change in changes.values() {
+        if let FileChange::Update {
+            move_path: Some(destination),
+            ..
+        } = change
+            && paths.insert(destination, true).is_some()
+        {
+            return Err(invalid(
+                "Pending patch move destinations must be distinct from changed files",
+            ));
+        }
+    }
+    Ok(paths)
+}
+
+fn validate_checkpoint<'a>(
+    changes: &HashMap<PathBuf, FileChange>,
+    checkpoint: &'a Value,
+) -> CodexResult<&'a serde_json::Map<String, Value>> {
+    let paths = patch_paths(changes)?;
+    let root = checkpoint
+        .as_object()
+        .ok_or_else(|| invalid("Invalid patch approval preconditions"))?;
+    let files = root
+        .get("files")
+        .and_then(Value::as_object)
+        .ok_or_else(|| invalid("Invalid patch approval file map"))?;
+    if root.len() != 2
+        || root.get("version").and_then(Value::as_u64) != Some(1)
+        || files.len() > MAX_PATCH_PATHS
+        || files.len() != paths.len()
+    {
+        return Err(invalid("Invalid patch approval version or file count"));
+    }
+    for (path, absent) in paths {
+        let value = path
+            .to_str()
+            .and_then(|path| files.get(path))
+            .ok_or_else(|| invalid("Patch approval file paths do not match the pending patch"))?;
+        if absent {
+            if !value.is_null() {
+                return Err(invalid(
+                    "Pending patch destinations must have absent preimages",
+                ));
+            }
+        } else if !value.as_str().is_some_and(|value| {
+            value.len() == 64
+                && value
+                    .bytes()
+                    .all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
+        }) {
+            return Err(invalid("Invalid patch approval preimage digest"));
+        }
+    }
+    Ok(files)
+}
+
+async fn capture(
+    fs: &impl EnvironmentAccess,
+    changes: &HashMap<PathBuf, FileChange>,
+) -> CodexResult<PatchPreconditions> {
+    patch_paths(changes)?;
+    tokio::time::timeout(MAX_PATCH_SCAN_DURATION, async {
+        let mut files = BTreeMap::new();
+        let mut remaining = MAX_PATCH_SCAN_BYTES;
+        for (path, change) in changes {
+            let deleted = match change {
+                FileChange::Delete { content } => Some(content.as_bytes()),
+                _ => None,
+            };
+            let original = observe_file(
+                fs,
+                path,
+                matches!(change, FileChange::Add { .. }),
+                &mut remaining,
+                deleted,
+            )
+            .await?;
+            files.insert(path.clone(), original);
+            if let FileChange::Update {
+                move_path: Some(destination),
+                ..
+            } = change
+            {
+                files.insert(
+                    destination.clone(),
+                    observe_file(fs, destination, true, &mut remaining, None).await?,
+                );
+            }
+        }
+        Ok(PatchPreconditions { version: 1, files })
+    })
+    .await
+    .map_err(|_| invalid("Pending patch scan exceeded the 10 second limit"))?
+}
+
+fn digest(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+async fn observe_file(
+    fs: &impl EnvironmentAccess,
+    path: &Path,
+    must_be_absent: bool,
+    remaining: &mut u64,
+    deleted: Option<&[u8]>,
+) -> CodexResult<Option<String>> {
+    if !path.is_absolute()
+        || path
+            .components()
+            .any(|part| matches!(part, Component::ParentDir | Component::CurDir))
+    {
+        return Err(invalid(
+            "Pending patch paths must be normalized absolute local paths",
+        ));
+    }
+    // The selected local filesystem's no-follow operations reject symlinks in
+    // every component, including directory ancestors, without opening targets.
+    let uri = PathUri::from_host_native_path(path).map_err(|error| invalid(error.to_string()))?;
+    match fs
+        .get_metadata(
+            &uri,
+            GetMetadataOptions {
+                follow_symlinks: false,
+            },
+        )
+        .await
+    {
+        Err(error) if must_be_absent && error.kind() == ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(invalid(format!(
+            "Cannot inspect pending patch file: {error}"
+        ))),
+        Ok(_) if must_be_absent => Err(invalid("A pending patch destination already exists")),
+        Ok(metadata) if !metadata.is_file || metadata.is_symlink => {
+            Err(invalid("Pending patch sources must be regular files"))
+        }
+        Ok(_) => {
+            let bytes = fs
+                .read_file_bounded(
+                    &uri,
+                    ReadFileOptions {
+                        follow_symlinks: false,
+                    },
+                    MAX_PATCH_PREIMAGE_BYTES.min(*remaining),
+                )
+                .await
+                .map_err(|error| invalid(format!("Cannot read pending patch file: {error}")))?;
+            *remaining -= bytes.len() as u64;
+            if deleted.is_some_and(|expected| expected != bytes.as_slice()) {
+                return Err(invalid(
+                    "The pending deletion no longer matches its original file",
+                ));
+            }
+            Ok(Some(digest(&bytes)))
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
