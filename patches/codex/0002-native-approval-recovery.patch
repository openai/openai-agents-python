+    #[tokio::test]
+    async fn deletion_rejects_oversized_event_content_against_small_preimage() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir
+            .path()
+            .canonicalize()
+            .unwrap()
+            .join("changed-before-capture");
+        std::fs::write(&path, b"small replacement").unwrap();
+        let fs = FileSystemEnvironmentAccessor::unrestricted(&LOCAL_FS);
+        let changes = [(
+            path,
+            FileChange::Delete {
+                content: "x".repeat(MAX_PATCH_SCAN_BYTES as usize + 1),
+            },
+        )]
+        .into_iter()
+        .collect();
+        assert!(
+            capture(&fs, &changes)
+                .await
+                .unwrap_err()
+                .to_string()
+                .contains("pending deletion")
+        );
+    }
+
+    #[test]
+    fn checkpoint_requires_bounded_exact_path_set_and_version_without_cloning() {
+        let source = PathBuf::from("/source");
+        let destination = PathBuf::from("/destination");
+        let changes = [(source.clone(), update(Some(destination.clone())))]
+            .into_iter()
+            .collect();
+        let mut files = serde_json::Map::new();
+        files.insert(
+            source.to_str().unwrap().into(),
+            Value::String(digest(b"old")),
+        );
+        files.insert(destination.to_str().unwrap().into(), Value::Null);
+        let valid = serde_json::json!({"version": 1, "files": files});
+        assert!(validate_checkpoint(&changes, &valid).is_ok());
+        let mut invalid = valid.clone();
+        invalid["version"] = serde_json::json!(2);
+        assert!(validate_checkpoint(&changes, &invalid).is_err());
+        let mut invalid = valid.clone();
+        invalid["files"]
+            .as_object_mut()
+            .unwrap()
+            .remove(destination.to_str().unwrap());
+        assert!(validate_checkpoint(&changes, &invalid).is_err());
+        let mut invalid = valid.clone();
+        invalid["files"]
+            .as_object_mut()
+            .unwrap()
+            .remove(destination.to_str().unwrap());
+        invalid["files"]["/unexpected"] = Value::Null;
+        assert!(validate_checkpoint(&changes, &invalid).is_err());
+        let mut invalid = valid.clone();
+        invalid["files"][destination.to_str().unwrap()] = Value::String(digest(b"occupied"));
+        assert!(validate_checkpoint(&changes, &invalid).is_err());
+        let mut invalid = valid;
+        invalid["files"][source.to_str().unwrap()] =
+            Value::String("x".repeat(MAX_PATCH_SCAN_BYTES as usize + 1));
+        assert!(validate_checkpoint(&changes, &invalid).is_err());
+        let oversized: serde_json::Map<_, _> = (0..MAX_PATCH_PATHS + 1)
+            .map(|index| (format!("/{index}"), Value::Null))
+            .collect();
+        assert!(
+            validate_checkpoint(
+                &changes,
+                &serde_json::json!({"version":1,"files":oversized})
+            )
+            .is_err()
+        );
+    }
+}
