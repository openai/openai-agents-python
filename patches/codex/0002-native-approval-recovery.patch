+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::protocol::AskForApproval;
+
+    fn command() -> ResponseItem {
+        serde_json::from_value(json!({
+            "type":"function_call", "call_id":"original", "name":"exec_command",
+            "arguments":"{\"cmd\":\"printf original\"}",
+        }))
+        .unwrap()
+    }
+
+    fn approval() -> EventMsg {
+        serde_json::from_value(json!({
+            "type":"exec_approval_request", "kind":"command", "call_id":"original",
+            "turn_id":"first-turn", "started_at_ms":1, "command":["sh","-c","printf original"],
+            "cwd":"/workspace", "environmentId":"local", "parsed_cmd":[],
+        }))
+        .unwrap()
+    }
+
+    fn checkpoint() -> Value {
+        json!({"version":1,"first_approval":true,"permissions":"test-fingerprint","patch":null})
+    }
+
+    #[test]
+    fn rejects_unrelated_calls_and_noninitial_approvals() {
+        let mut call = command();
+        if let ResponseItem::FunctionCall { call_id, .. } = &mut call {
+            *call_id = "sibling".into();
+        }
+        assert!(RestoreToolCall::new(call, approval(), Some(checkpoint())).is_err());
+        let mut request = approval();
+        if let EventMsg::ExecApprovalRequest(event) = &mut request {
+            event.approval_id = Some("subcommand".into());
+        }
+        assert!(RestoreToolCall::new(command(), request, Some(checkpoint())).is_err());
+        assert!(RestoreToolCall::new(command(), approval(), None).is_err());
+    }
+
+    #[tokio::test]
+    async fn requires_exact_fresh_approval_and_consumes_execution_once() {
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let session = Arc::new(session);
+        let turn = Arc::new(turn);
+        let step = session
+            .capture_step_context(Arc::clone(&turn), &CancellationToken::new())
+            .await
+            .unwrap();
+        let mut preconditions = checkpoint();
+        preconditions["permissions"] = permission_snapshot(
+            &turn,
+            &step.environments,
+            step.settings.approval_policy(),
+            step.settings.approvals_reviewer(),
+        );
+        let restore = RestoreToolCall::new(command(), approval(), Some(preconditions)).unwrap();
+        turn.extension_data.insert(restore);
+        let restore = turn.extension_data.get::<RestoreToolCall>().unwrap();
+        assert!(restore.claim(&turn));
+        assert!(!restore.claim(&turn));
+        assert!(validate_before_execution(&session, &step).await.is_err());
+        assert!(compare_request(&turn, &approval()));
+        assert_eq!(
+            record_decision(&turn, ReviewDecision::Approved),
+            ReviewDecision::Approved
+        );
+        assert!(validate_before_execution(&session, &step).await.is_ok());
+        assert!(validate_before_execution(&session, &step).await.is_err());
+        assert!(!compare_request(&turn, &approval()));
+    }
+
+    #[tokio::test]
+    async fn refuses_changed_command_before_approval() {
+        let (_, turn) = crate::session::tests::make_session_and_context().await;
+        turn.extension_data
+            .insert(RestoreToolCall::new(command(), approval(), Some(checkpoint())).unwrap());
+        assert!(
+            turn.extension_data
+                .get::<RestoreToolCall>()
+                .unwrap()
+                .claim(&turn)
+        );
+        let mut changed = approval();
+        if let EventMsg::ExecApprovalRequest(event) = &mut changed {
+            event.command.push("unexpected".into());
+        }
+        assert!(!compare_request(&turn, &changed));
+        assert!(!compare_request(&turn, &approval()));
+        assert!(!active(&turn).unwrap().approved.load(Ordering::SeqCst));
+    }
+
+    #[tokio::test]
+    async fn refuses_changed_authority_even_with_matching_approval() {
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let session = Arc::new(session);
+        let turn = Arc::new(turn);
+        let step = session
+            .capture_step_context(Arc::clone(&turn), &CancellationToken::new())
+            .await
+            .unwrap();
+        assert_ne!(
+            permission_snapshot(
+                &turn,
+                &step.environments,
+                AskForApproval::OnRequest,
+                ApprovalsReviewer::User
+            ),
+            permission_snapshot(
+                &turn,
+                &step.environments,
+                AskForApproval::Never,
+                ApprovalsReviewer::User
+            ),
+        );
+        turn.extension_data
+            .insert(RestoreToolCall::new(command(), approval(), Some(checkpoint())).unwrap());
+        assert!(
+            turn.extension_data
+                .get::<RestoreToolCall>()
+                .unwrap()
+                .claim(&turn)
+        );
+        assert!(compare_request(&turn, &approval()));
+        record_decision(&turn, ReviewDecision::Approved);
+        assert!(validate_before_execution(&session, &step).await.is_err());
+    }
+    #[tokio::test]
+    async fn capture_is_opt_in_and_excludes_execution_retries() {
+        let (_, turn) = crate::session::tests::make_session_and_context().await;
+        let turn = Arc::new(turn);
+        let action = ApprovalAction::ExecCommand {
+            id: "original".into(),
+            environment_id: "local".into(),
+            command: vec!["printf".into(), "original".into()],
+            hook_command: "printf original".into(),
+            cwd: turn.cwd.clone().into(),
+            sandbox_permissions: crate::sandboxing::SandboxPermissions::UseDefault,
+            additional_permissions: None,
+            justification: None,
+            tty: false,
+            proposed_execpolicy_amendment: None,
+        };
+        let mut ctx = ApprovalContext {
+            review_context: crate::guardian::GuardianReviewContext::from(&turn),
+            cancellation_token: None,
+            call_id: "original".into(),
+            tool_name: codex_tools::ToolName {
+                name: "exec_command".into(),
+                namespace: None,
+            },
+            strict_auto_review: false,
+            approval_reason: None,
+            retry_reason: None,
+            network_approval_context: None,
+        };
+        assert!(capture_lease(&action, &ctx).await.is_none());
+        let restore = RestoreToolCall::new(command(), approval(), Some(checkpoint())).unwrap();
+        assert!(restore.accepts_approval(&action, &ctx));
+        ctx.network_approval_context = Some(codex_protocol::approvals::NetworkApprovalContext {
+            host: "unexpected.invalid".into(),
+            protocol: codex_protocol::approvals::NetworkApprovalProtocol::Http,
+        });
+        assert!(!restore.accepts_approval(&action, &ctx));
+        ctx.network_approval_context = None;
+        turn.extension_data.insert(CapturableApprovals::default());
+        ctx.retry_reason = Some("sandbox retry".into());
+        assert!(!restore.accepts_approval(&action, &ctx));
+        assert!(capture_lease(&action, &ctx).await.is_none());
+        ctx.retry_reason = None;
+        let lease = capture_lease(&action, &ctx).await.unwrap();
+        record_capture_event(&turn, &approval());
+        let state = turn.extension_data.get::<CapturableApprovals>().unwrap();
+        assert!(
+            state
+                .0
+                .lock()
+                .unwrap()
+                .get("original")
+                .unwrap()
+                .event
+                .is_some()
+        );
+        drop(lease);
+        assert!(state.0.lock().unwrap().is_empty());
+    }
+}
