+        let request = approval(
+            path.clone(),
+            FileChange::Add {
+                content: "new\n".into(),
+            },
+        );
+        assert!(capture(&fs, &request.changes).await.is_ok());
+        std::fs::write(path, "new\n").unwrap();
+        assert!(capture(&fs, &request.changes).await.is_err());
+    }
