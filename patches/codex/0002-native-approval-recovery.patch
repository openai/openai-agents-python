+    #[tokio::test]
+    async fn move_sources_share_total_byte_budget_with_other_files() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().canonicalize().unwrap();
+        let fs = FileSystemEnvironmentAccessor::unrestricted(&LOCAL_FS);
+        let mut changes = HashMap::new();
+        for index in 0..2 {
+            let path = root.join(format!("source-{index}"));
+            std::fs::File::create(&path)
+                .unwrap()
+                .set_len(MAX_PATCH_PREIMAGE_BYTES)
+                .unwrap();
+            changes.insert(
+                path,
+                update(Some(root.join(format!("destination-{index}")))),
+            );
+        }
+        let empty = root.join("empty");
