+    #[tokio::test]
+    async fn bounds_all_paths_before_inspecting_any_file() {
+        let fs = FileSystemEnvironmentAccessor::unrestricted(&LOCAL_FS);
+        let mut changes: HashMap<_, _> = (0..MAX_PATCH_PATHS + 1)
+            .map(|index| {
+                (
+                    PathBuf::from(format!("relative-{index}")),
+                    FileChange::Add {
+                        content: String::new(),
+                    },
+                )
+            })
+            .collect();
+        assert!(
+            capture(&fs, &changes)
+                .await
+                .unwrap_err()
+                .to_string()
+                .contains("32 paths")
+        );
+        changes.remove(&PathBuf::from(format!("relative-{MAX_PATCH_PATHS}")));
+        changes.insert(
+            PathBuf::from("relative-0"),
+            update(Some(PathBuf::from("move-destination"))),
+        );
+        assert!(
+            capture(&fs, &changes)
+                .await
+                .unwrap_err()
+                .to_string()
+                .contains("32 paths")
+        );
+        changes.remove(&PathBuf::from("relative-1"));
+        assert_eq!(patch_paths(&changes).unwrap().len(), MAX_PATCH_PATHS);
+    }
