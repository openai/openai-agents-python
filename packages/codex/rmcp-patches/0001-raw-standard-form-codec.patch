+use rmcp::model::ServerRequest;
+use serde_json::{Value, json};
+
+#[test]
+fn standard_forms_preserve_root_keywords_and_metadata_before_typed_decoding() {
+    for mode in [Some("form"), None] {
+        let mut original = json!({
+            "method": "elicitation/create",
+            "params": {
+                "message": "Synthetic form",
+                "_meta": {"synthetic": true},
+                "requestedSchema": {
+                    "type": "object",
+                    "properties": {"count": {"type": "integer"}},
+                    "allOf": [{"properties": {"count": {"minimum": 2}}}],
+                    "$defs": {"tag": {"type": "string"}}
+                }
+            }
+        });
+        if let Some(mode) = mode {
+            original["params"]["mode"] = Value::from(mode);
+        }
+        let parsed: ServerRequest = serde_json::from_value(original.clone()).unwrap();
+        assert!(matches!(parsed, ServerRequest::CustomRequest(_)));
+        assert_eq!(serde_json::to_value(parsed).unwrap(), original);
+    }
+}
+
+#[test]
+fn other_server_requests_keep_their_existing_codec_route() {
+    let ping: ServerRequest = serde_json::from_value(json!({"method": "ping"})).unwrap();
+    assert!(matches!(ping, ServerRequest::PingRequest(_)));
+    let url = json!({
+        "method": "elicitation/create",
+        "params": {"mode": "url", "message": "Verify", "url": "https://example.invalid/verify", "elicitationId": "sample"}
+    });
+    let parsed: ServerRequest = serde_json::from_value(url).unwrap();
+    assert!(matches!(parsed, ServerRequest::ElicitRequest(_)));
+}
