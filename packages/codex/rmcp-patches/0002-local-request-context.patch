+    #[tokio::test]
+    async fn post_stream_carries_only_opt_in_weak_context() {
+        use crate::transport::Transport;
+
+        tokio::time::timeout(Duration::from_secs(5), async {
+            for opted_in in [false, true] {
+                let mut transport = StreamableHttpClientTransport::with_client(
+                    ResponseContextClient,
+                    StreamableHttpClientTransportConfig::with_uri("http://localhost/mcp"),
+                );
+                transport
+                    .send(
+                        serde_json::from_value(json!({
+                            "jsonrpc": "2.0", "id": 0, "method": "initialize",
+                            "params": {
+                                "protocolVersion": "2025-11-25", "capabilities": {},
+                                "clientInfo": {"name": "context-test", "version": "1"}
+                            }
+                        }))
+                        .expect("initialize request"),
+                    )
+                    .await
+                    .expect("send initialize");
+                assert!(matches!(
+                    transport.receive().await,
+                    Some(ServerJsonRpcMessage::Response(_))
+                ));
+                transport
+                    .send(
+                        serde_json::from_value(json!({
+                            "jsonrpc": "2.0", "method": "notifications/initialized"
+                        }))
+                        .expect("initialized notification"),
+                    )
+                    .await
+                    .expect("send initialized");
+                let owner = Arc::new(());
+                let weak_owner = Arc::downgrade(&owner);
+                let unselected = Arc::new(());
+                let weak_unselected = Arc::downgrade(&unselected);
+                let mut outgoing: ClientJsonRpcMessage = serde_json::from_value(json!({
+                    "jsonrpc": "2.0", "id": 3, "method": "tools/list", "params": {}
+                }))
+                .expect("tools/list request");
+                let ClientJsonRpcMessage::Request(request) = &mut outgoing else {
+                    panic!("expected outbound request");
+                };
+                request.request.extensions_mut().insert(unselected);
+                if opted_in {
+                    let mut context = crate::model::Extensions::new();
+                    context.insert(weak_owner.clone());
+                    request
+                        .request
+                        .extensions_mut()
+                        .insert(crate::service::ResponseStreamContext(context));
+                }
+                transport.send(outgoing).await.expect("send tools/list");
+                drop(owner);
+                let Some(ServerJsonRpcMessage::Request(request)) = transport.receive().await else {
+                    panic!("expected actual inbound SSE request");
+                };
+                assert_eq!(
+                    request.request.extensions().get::<InboundStreamOrigin>(),
+                    Some(&InboundStreamOrigin::OutboundRequest(RequestId::Number(3)))
+                );
+                assert!(request.request.extensions().get::<Arc<()>>().is_none());
+                assert!(
+                    weak_unselected.upgrade().is_none(),
+                    "outer request map must not be retained"
+                );
+                let context = request
+                    .request
+                    .extensions()
+                    .get::<crate::service::ResponseStreamContext>();
+                if opted_in {
+                    let weak = context
+                        .expect("explicit context forwarded")
+                        .0
+                        .get::<std::sync::Weak<()>>()
+                        .expect("weak context present even after expiration");
+                    assert!(std::sync::Weak::ptr_eq(weak, &weak_owner));
+                    assert!(
+                        weak.upgrade().is_none(),
+                        "the carrier must not retain its owner"
+                    );
+                } else {
+                    assert!(
+                        context.is_none(),
+                        "non-opted-in root operations keep no call context"
+                    );
+                }
+                let Some(ServerJsonRpcMessage::Error(error)) = transport.receive().await else {
+                    panic!("expected the original final error");
+                };
+                assert_eq!(error.id, Some(RequestId::Number(3)));
+                assert_eq!(error.error.code.0, -32042);
+                assert_eq!(error.error.data, Some(json!({"elicitations": []})));
+                transport.close().await.expect("close transport");
+            }
+        })
+        .await
+        .expect("worker context probe completes");
     }
 
