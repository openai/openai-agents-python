+    #[derive(Clone)]
+    struct ResponseContextClient;
+
+    impl StreamableHttpClient for ResponseContextClient {
+        type Error = std::io::Error;
+
+        async fn post_message(
+            &self,
+            _uri: Arc<str>,
+            message: ClientJsonRpcMessage,
+            _session_id: Option<Arc<str>>,
+            _auth_header: Option<String>,
+            _custom_headers: HashMap<HeaderName, HeaderValue>,
+        ) -> Result<StreamableHttpPostResponse, StreamableHttpError<Self::Error>> {
+            let wire = serde_json::to_value(&message).expect("serialize outbound message");
+            assert!(
+                wire.get("extensions").is_none(),
+                "local context stays off wire"
+            );
+            match wire["method"].as_str() {
+                Some("initialize") => Ok(StreamableHttpPostResponse::Json(
+                    serde_json::from_value(json!({
+                        "jsonrpc": "2.0", "id": wire["id"],
+                        "result": {
+                            "protocolVersion": "2025-11-25",
+                            "capabilities": {},
+                            "serverInfo": {"name": "context-fixture", "version": "1"}
+                        }
+                    }))
+                    .expect("initialize response"),
+                    None,
+                )),
+                Some("notifications/initialized") => Ok(StreamableHttpPostResponse::Accepted),
+                Some("tools/list") => {
+                    let request = json!({
+                        "jsonrpc": "2.0", "id": 9, "method": "elicitation/create",
+                        "params": {
+                            "mode": "url", "message": "Consent", "url": "https://example.invalid/",
+                            "elicitationId": "context-fixture"
+                        }
+                    });
+                    let error = json!({
+                        "jsonrpc": "2.0", "id": wire["id"],
+                        "error": {"code": -32042, "message": "URL interaction required", "data": {"elicitations": []}}
+                    });
+                    Ok(StreamableHttpPostResponse::Sse(
+                        futures::stream::iter([request, error].map(|message| {
+                            Ok(Sse {
+                                event: None,
+                                data: Some(message.to_string()),
+                                id: None,
+                                retry: None,
+                            })
+                        }))
+                        .boxed(),
+                        None,
+                    ))
+                }
+                _ => Err(StreamableHttpError::UnexpectedServerResponse(
+                    "unexpected POST".into(),
+                )),
+            }
+        }
+
+        async fn delete_session(
+            &self,
+            _uri: Arc<str>,
+            _session_id: Arc<str>,
+            _auth_header: Option<String>,
+            _custom_headers: HashMap<HeaderName, HeaderValue>,
+        ) -> Result<(), StreamableHttpError<Self::Error>> {
+            Ok(())
+        }
+
+        async fn get_stream(
+            &self,
+            _uri: Arc<str>,
+            _session_id: Option<Arc<str>>,
+            _last_event_id: Option<String>,
+            _auth_header: Option<String>,
+            _custom_headers: HashMap<HeaderName, HeaderValue>,
+        ) -> Result<BoxedSseStream, StreamableHttpError<Self::Error>> {
+            Err(StreamableHttpError::ServerDoesNotSupportSse)
+        }
+    }
