+// Untagged result enums buffer JSON numbers before deserializing annotations.
+// With serde_json/arbitrary_precision, fractional numbers use Number's private
+// map representation, which the primitive f32 visitor cannot read directly.
+fn deserialize_priority<'de, D>(deserializer: D) -> Result<Option<f32>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    Option::<serde_json::Number>::deserialize(deserializer)?
+        .map(|number| {
+            number
+                .as_f64()
+                .map(|value| value as f32)
+                .ok_or_else(|| serde::de::Error::custom("priority is outside the supported range"))
+        })
+        .transpose()
+}
