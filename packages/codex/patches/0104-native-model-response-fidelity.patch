+/// Convert one completed application model response through the provider fact policy.
+/// Validate the complete output before admitting any tool-bearing item.
+pub fn completed_model_response(
+    response_id: String,
+    output: Vec<Value>,
+    token_usage: Option<codex_protocol::protocol::TokenUsage>,
+) -> Vec<Result<crate::ResponseEvent, crate::ApiError>> {
+    use crate::{ApiError, ResponseEvent};
+    use codex_protocol::error::ResponseIntegrityReason;
+    let mut events = vec![Ok(ResponseEvent::Created {
+        response_id: Some(response_id.clone()),
+    })];
+    for (index, item) in output.iter().enumerate() {
+        events.extend(
+            output_item_facts(item, u64::try_from(index).ok(), true)
+                .into_iter()
+                .map(|fact| Ok(ResponseEvent::ResponseFact(fact.into()))),
+        );
+    }
+    if output.iter().any(contains_refusal) {
+        events.push(Err(ApiError::ResponseIntegrity {
+            reason: ResponseIntegrityReason::ProviderRefusal,
+        }));
+        return events;
+    }
+    let items = output
+        .into_iter()
+        .map(serde_json::from_value::<codex_protocol::models::ResponseItem>)
+        .collect::<Result<Vec<_>, _>>();
+    let items = match items {
+        Ok(items) => items,
+        Err(_) => {
+            events.push(Err(ApiError::ResponseIntegrity {
+                reason: ResponseIntegrityReason::UndecodableOutputItem,
+            }));
+            return events;
+        }
+    };
+    events.extend(
+        items
+            .into_iter()
+            .map(|item| Ok(ResponseEvent::OutputItemDone(item))),
+    );
+    events.push(Ok(ResponseEvent::Completed {
+        response_id,
+        token_usage,
+        usage_metadata: None,
+        end_turn: None,
+    }));
+    events
+}
+
+#[cfg(test)]
+mod completed_model_response_tests {
+    use super::*;
+    use crate::{ApiError, ResponseEvent};
+    use codex_protocol::error::ResponseIntegrityReason;
+    use serde_json::json;
+    fn call() -> Value {
+        json!({"type":"function_call", "call_id":"call", "name":"echo", "arguments":"{}"})
+    }
+    fn no_items_or_terminal(events: &[Result<ResponseEvent, ApiError>]) {
+        assert!(!events.iter().any(|event| matches!(
+            event,
+            Ok(ResponseEvent::OutputItemDone(_) | ResponseEvent::Completed { .. })
+        )));
+    }
+    #[test]
+    fn later_refusal_preserves_fact_before_failure_and_admits_no_tool() {
+        let events = completed_model_response(
+            "response".into(),
+            vec![
+                call(),
+                json!({"type":"message", "role":"assistant", "content":[{"type":"refusal", "refusal":"private refusal"}]}),
+            ],
+            None,
+        );
+        assert!(matches!(
+            events.first(),
+            Some(Ok(ResponseEvent::Created { .. }))
+        ));
+        assert!(
+            events
+                .iter()
+                .any(|event| matches!(event, Ok(ResponseEvent::ResponseFact(_))))
+        );
+        assert!(matches!(
+            events.last(),
+            Some(Err(ApiError::ResponseIntegrity {
+                reason: ResponseIntegrityReason::ProviderRefusal
+            }))
+        ));
+        no_items_or_terminal(&events);
+    }
+    #[test]
+    fn malformed_later_item_admits_no_tool() {
+        let events = completed_model_response(
+            "response".into(),
+            vec![call(), json!({"type":"message", "role":"assistant", "content":[{"type":"output_text", "text":7}]})],
+            None,
+        );
+        assert!(matches!(
+            events.last(),
+            Some(Err(ApiError::ResponseIntegrity {
+                reason: ResponseIntegrityReason::UndecodableOutputItem
+            }))
+        ));
+        no_items_or_terminal(&events);
+    }
+    #[test]
+    fn probabilities_precede_output_and_completion() {
+        let events = completed_model_response(
+            "response".into(),
+            vec![
+                json!({"type":"message", "role":"assistant", "content":[{"type":"output_text", "text":"ok", "logprobs":[{"token":"ok", "bytes":[111,107], "logprob":-0.1, "top_logprobs":[]}]}]}),
+            ],
+            None,
+        );
+        assert!(matches!(
+            events.get(1),
+            Some(Ok(ResponseEvent::ResponseFact(_)))
+        ));
+        assert!(matches!(
+            events.get(2),
+            Some(Ok(ResponseEvent::OutputItemDone(_)))
+        ));
+        assert!(matches!(
+            events.last(),
+            Some(Ok(ResponseEvent::Completed { .. }))
+        ));
+    }
+}
