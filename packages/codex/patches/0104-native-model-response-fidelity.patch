+mod empty_include_wire_tests {
+    #[test]
+    fn explicit_empty_include_is_a_patch_without_wire_values() {
+        for include in [serde_json::json!([]), serde_json::Value::Null] {
+            let controls: super::ModelRequestControls =
+                serde_json::from_value(serde_json::json!({"include":include})).unwrap();
