+        })).unwrap()
+    }
+    #[test]
+    fn equal_payloads_and_repeated_acknowledgment_keep_exact_positions() {
+        let row = item("same");
+        let batch = StagedInputBatch::selected_after_terminal("turn".into(), vec![row.clone(), row.clone()]);
+        let shared = batch.clone();
+        assert!(batch.pending_occurrences_for("other").is_empty());
+        batch.acknowledge_occurrences(&[1, 1]).unwrap();
+        shared.acknowledge_occurrences(&[1]).unwrap();
+        assert_eq!(batch.pending_occurrences_for("turn"), vec![(0, row)]);
+        assert!(batch.is_pending());
+        batch.acknowledge_occurrences(&[0]).unwrap();
+        assert!(!shared.is_pending());
+    }
+    #[test]
+    fn invalid_acknowledgment_does_not_partially_accept() {
+        let batch = StagedInputBatch::selected_after_terminal("turn".into(), vec![item("A"), item("B")]);
+        assert!(batch.acknowledge_occurrences(&[0, 99]).is_err());
+        assert_eq!(batch.pending_occurrences_for("turn").len(), 2);
+    }
+    #[test]
+    fn default_batch_keeps_its_original_whole_batch_acknowledgment() {
+        let batch = StagedInputBatch::new("turn".into(), vec![item("A"), item("A")]);
+        assert!(!batch.projects_occurrences());
+        assert_eq!(batch.items_for("turn").unwrap().len(), 2);
+        assert!(matches!(batch.guard_items_for("turn"), Some(std::borrow::Cow::Borrowed(_))));
+        batch.acknowledge();
+        assert!(batch.items_for("turn").is_none());
+        assert!(!batch.is_pending());
+    }
+}
