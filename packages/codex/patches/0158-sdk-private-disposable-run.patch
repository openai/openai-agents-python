+#[tokio::test]
+async fn private_response_record_retains_the_returned_identity_and_received_facts() {
+    use codex_protocol::protocol::{
+        ResponseIncompleteReason, ResponseObservation, ResponseObservationStatus,
+    };
+
+    let (session, context) = make_session_and_context().await;
+    assert!(session.live_thread().is_none());
+    let observation = ResponseObservation {
+        response_id: Some("synthetic-response".to_string()),
+        upstream_request_id: Some("synthetic-provider-request".to_string()),
+        status: ResponseObservationStatus::Incomplete,
+        incomplete_reason: Some(ResponseIncompleteReason::MaxOutputTokens),
+        usage: None,
+    };
+    // Ordinary ephemeral sessions keep their existing absent-record behavior.
+    assert!(
+        session
+            .record_response_observation(&context, observation.clone())
+            .await
+            .unwrap()
+            .is_none()
+    );
+    session
+        .services
+        .thread_extension_data
+        .insert(super::PrivateDisposableRun::default());
+    let id = session
+        .record_response_observation(&context, observation.clone())
+        .await
+        .unwrap()
+        .unwrap();
+    let owner = session
+        .services
+        .thread_extension_data
+        .get::<super::PrivateDisposableRun>()
+        .unwrap();
+    let records = owner.records.lock().unwrap();
+    assert_eq!(records.len(), 1);
+    assert_eq!(records[0].id, id);
+    assert_eq!(records[0].thread_id, session.thread_id);
+    assert_eq!(records[0].turn_id, context.sub_id);
+    assert_eq!(records[0].observation, observation);
+}
