+#[test]
+fn provider_compaction_projects_latest_window_and_preserves_canonical_history() {
+    let compaction = |id: &str| ResponseItemEnvelope {
+        item: ResponseItem::Compaction {
+            id: None,
+            encrypted_content: id.to_owned(),
+            internal_chat_message_metadata_passthrough: None,
+        },
+        metadata: Some(CodexHarnessMetadata {
+            provider_compaction: true,
+            ..Default::default()
+        }),
+    };
+    let mut history =
+        create_history_with_items(vec![user_msg("original user"), assistant_msg("old")]);
+    history.set_reference_context_item(Some(reference_context_item()));
+    let first = compaction("first");
+    history.replay_annotated_item(&first, TruncationPolicy::Tokens(10_000));
+    assert!(history.reference_context_item().is_none());
+    history.record_items(
+        [&user_msg("middle")].into_iter(),
+        TruncationPolicy::Tokens(10_000),
+    );
+    let latest = compaction("latest");
+    // Persisted provenance survives a cold JSON round trip and ordinary history replay.
+    let latest: ResponseItemEnvelope =
+        serde_json::from_str(&serde_json::to_string(&latest).unwrap()).unwrap();
+    history.replay_annotated_item(&latest, TruncationPolicy::Tokens(10_000));
+    let later = user_msg("later");
+    history.record_items([&later].into_iter(), TruncationPolicy::Tokens(10_000));
+    let audit = raw_items(&history);
+    assert_eq!(
+        history.clone().for_prompt(&default_input_modalities()),
+        vec![latest.item, later]
+    );
+    assert_eq!(raw_items(&history), audit);
+    assert_eq!(audit.len(), 6);
+}
+
+#[test]
+fn native_compaction_replacement_keeps_its_retained_user_items() {
+    let user = user_msg("retained outside the native summary");
+    let summary = ResponseItem::Compaction {
+        id: None,
+        encrypted_content: "native replacement".to_owned(),
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let mut history = create_history_with_items(vec![user.clone()]);
+    history.set_reference_context_item(Some(reference_context_item()));
+    let envelope = ResponseItemEnvelope {
+        item: summary.clone(),
+        metadata: Some(CodexHarnessMetadata::default()),
+    };
+    let saved = serde_json::to_string(&envelope).unwrap();
+    assert!(!saved.contains("provider_compaction"));
+    let legacy: ResponseItemEnvelope = serde_json::from_str(&saved).unwrap();
+    history.replay_annotated_item(&legacy, TruncationPolicy::Tokens(10_000));
+    assert!(history.reference_context_item().is_some());
+    assert_eq!(
+        history.for_prompt(&default_input_modalities()),
+        vec![user, summary]
+    );
+}
+
+#[test]
+fn provider_compaction_accounting_ignores_old_files_and_reasoning() {
+    use codex_protocol::input_file::InputFile;
+    let encrypted_reasoning = |text: &str, size: usize| {
+        let mut item = reasoning_msg(text);
+        let ResponseItem::Reasoning {
+            encrypted_content, ..
+        } = &mut item
+        else {
+            unreachable!()
+        };
+        *encrypted_content = Some("A".repeat(size));
+        item
+    };
+    let mut old_file = user_msg("old opaque file");
+    let ResponseItem::Message { content, .. } = &mut old_file else {
+        unreachable!()
+    };
+    content.push(ContentItem::InputFile {
+        file: InputFile::from_file_id("file-before-provider-compaction".into(), None).unwrap(),
+    });
+    let mut history = create_history_with_items(vec![
+        old_file,
+        encrypted_reasoning("old", 1024),
+        assistant_msg("old assistant"),
+    ]);
+    let boundary = ResponseItemEnvelope {
+        item: ResponseItem::Compaction {
+            id: None,
+            encrypted_content: "current opaque window".to_owned(),
+            internal_chat_message_metadata_passthrough: None,
+        },
+        metadata: Some(CodexHarnessMetadata {
+            provider_compaction: true,
+            ..Default::default()
+        }),
+    };
+    history.replay_annotated_item(&boundary, TruncationPolicy::Tokens(10_000));
+    let current = vec![
+        user_msg("current user"),
+        encrypted_reasoning("current", 128),
+        assistant_msg("current assistant"),
+        user_msg("next user"),
+    ];
+    history.record_items(current.iter(), TruncationPolicy::Tokens(10_000));
+    let mut expected =
+        create_history_with_items(std::iter::once(boundary.item).chain(current).collect());
+    for context in [&mut history, &mut expected] {
+        context.update_token_info(
+            &TokenUsage {
+                total_tokens: 321,
+                ..Default::default()
+            },
+            Some(8192),
+        );
+    }
+    let audit = raw_items(&history);
+    assert_eq!(audit.len(), 8);
+    assert!(!history.has_file_content());
+    let base = BaseInstructions {
+        text: "current instructions".to_owned(),
+        provenance: None,
+    };
+    assert_eq!(
+        history.estimate_token_count_with_base_instructions(&base),
+        expected.estimate_token_count_with_base_instructions(&base)
+    );
+    assert!(
+        history
+            .estimate_token_count_with_base_instructions(&base)
+            .is_some()
+    );
+    for server_reasoning_included in [false, true] {
+        assert_eq!(
+            history.get_total_token_usage(server_reasoning_included),
+            expected.get_total_token_usage(server_reasoning_included)
+        );
+    }
+    assert_eq!(
+        history.estimated_tokens_after_last_model_generated_item(),
+        expected.estimated_tokens_after_last_model_generated_item()
+    );
+    assert_eq!(
+        history.token_info().unwrap().last_token_usage.total_tokens,
+        321
+    );
+    assert_eq!(raw_items(&history), audit);
+}
