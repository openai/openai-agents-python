new file mode 100644
index 00000000..f02202ea
--- /dev/null
+++ b/codex-rs/ext/extension-api/src/model_provider_metadata.rs
@@ -0,0 +1,272 @@
+//! Exact model-output occurrences and private current-input replay data.
+
+use codex_history::ModelProviderMetadata;
+use codex_protocol::models::ResponseItem;
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::BTreeMap,
+    io::Write,
+    sync::{Arc, Mutex},
+};
+
+const MAX_ITEMS: usize = 4096;
+const MAX_BYTES: usize = 8 * 1024 * 1024;
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ModelOutputProviderMetadata {
+    pub output_index: usize,
+    pub metadata: ModelProviderMetadata,
+}
+
+/// One authenticated producer response on the existing native step owner.
+#[derive(Clone, Default)]
+pub struct CapturedModelProviderOutput(Arc<Mutex<OutputState>>);
+#[derive(Default)]
+struct OutputState {
+    expected_count: Option<usize>,
+    seen: usize,
+    bytes: usize,
+    metadata: BTreeMap<usize, (ResponseItem, ModelProviderMetadata)>,
+}
+
+struct ByteBudget(usize);
+impl Write for ByteBudget {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        self.0 = self.0.checked_sub(bytes.len()).ok_or_else(|| {
+            std::io::Error::other("Model provider metadata exceeds the response byte limit")
+        })?;
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+/// Bounded private replay projection before allocating its serialized rows.
+pub struct ModelProviderMetadataBudget {
+    bytes: ByteBudget,
+    items: usize,
+}
+impl Default for ModelProviderMetadataBudget {
+    fn default() -> Self {
+        Self {
+            bytes: ByteBudget(MAX_BYTES - 2),
+            items: 0,
+        }
+    }
+}
+impl ModelProviderMetadataBudget {
+    pub fn charge<T: Serialize>(&mut self, value: &T) -> Result<(), String> {
+        if self.items >= MAX_ITEMS {
+            return Err("Model provider replay metadata exceeds its item limit".into());
+        }
+        serde_json::to_writer(&mut self.bytes, value).map_err(|error| error.to_string())?;
+        self.bytes
+            .write_all(b",")
+            .map_err(|error| error.to_string())?;
+        self.items += 1;
+        Ok(())
+    }
+}
+
+impl CapturedModelProviderOutput {
+    pub fn capture(
+        &self,
+        output: Vec<ResponseItem>,
+        annotations: Vec<ModelOutputProviderMetadata>,
+    ) -> Result<(), String> {
+        if output.len() > MAX_ITEMS || annotations.len() > MAX_ITEMS {
+            return Err("Model provider metadata exceeds the response item limit".into());
+        }
+        let mut budget = ByteBudget(MAX_BYTES);
+        serde_json::to_writer(&mut budget, &output).map_err(|error| error.to_string())?;
+        serde_json::to_writer(&mut budget, &annotations).map_err(|error| error.to_string())?;
+        let mut metadata = vec![None; output.len()];
+        for annotation in annotations {
+            if annotation.metadata.provider.trim().is_empty()
+                || annotation.metadata.model.trim().is_empty()
+            {
+                return Err("Model provider metadata requires its provider and model scope".into());
+            }
+            let slot = metadata
+                .get_mut(annotation.output_index)
+                .ok_or("Model provider metadata has no matching output occurrence")?;
+            if slot.is_some() {
+                return Err("Duplicate model provider output occurrence".into());
+            }
+            *slot = Some(annotation.metadata);
+        }
+        let mut state = self
+            .0
+            .lock()
+            .map_err(|_| "Model provider metadata poisoned")?;
+        if state.expected_count.is_some() || state.seen != 0 || !state.metadata.is_empty() {
+            return Err("Model provider metadata response already captured".into());
+        }
+        state.expected_count = Some(output.len());
+        state.bytes = MAX_BYTES - budget.0;
+        state.metadata = output
+            .into_iter()
+            .zip(metadata)
+            .enumerate()
+            .filter_map(|(index, (item, metadata))| {
+                metadata.map(|metadata| (index, (item, metadata)))
+            })
+            .collect();
+        Ok(())
+    }
+
+    pub fn append_stream_output(
+        &self,
+        index: usize,
+        item: ResponseItem,
+        metadata: ModelProviderMetadata,
+    ) -> Result<(), String> {
+        if index >= MAX_ITEMS
+            || metadata.provider.trim().is_empty()
+            || metadata.model.trim().is_empty()
+        {
+            return Err("Invalid model provider stream metadata occurrence".into());
+        }
+        let mut state = self
+            .0
+            .lock()
+            .map_err(|_| "Model provider metadata poisoned")?;
+        if state.expected_count.is_some()
+            || index < state.seen
+            || state.metadata.contains_key(&index)
+        {
+            return Err("Model provider stream metadata occurrence already settled".into());
+        }
+        let mut budget = ByteBudget(MAX_BYTES - state.bytes);
+        serde_json::to_writer(&mut budget, &(&item, &metadata))
+            .map_err(|error| error.to_string())?;
+        state.bytes = MAX_BYTES - budget.0;
+        state.metadata.insert(index, (item, metadata));
+        Ok(())
+    }
+
+    pub fn take_for(&self, item: &ResponseItem) -> Result<Option<ModelProviderMetadata>, String> {
+        let mut state = self
+            .0
+            .lock()
+            .map_err(|_| "Model provider metadata poisoned")?;
+        let index = state.seen;
+        if state.expected_count.is_some_and(|count| index >= count) {
+            return Err("Model provider metadata has an extra output occurrence".into());
+        }
+        if let Some((expected, _)) = state.metadata.get(&index) {
+            if expected != item {
+                return Err("Model provider metadata does not match its output occurrence".into());
+            }
+        }
+        state.seen = index
+            .checked_add(1)
+            .ok_or("Model provider metadata occurrence overflow")?;
+        Ok(state.metadata.remove(&index).map(|(_, metadata)| metadata))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn item(text: &str) -> ResponseItem {
+        serde_json::from_value(json!({"type":"message", "role":"assistant",
+            "content":[{"type":"output_text", "text":text}]}))
+        .unwrap()
+    }
+    fn annotation(index: usize, value: &str) -> ModelOutputProviderMetadata {
+        ModelOutputProviderMetadata {
+            output_index: index,
+            metadata: ModelProviderMetadata {
+                provider: "fixture.metadata".into(),
+                model: "fixture".into(),
+                value: serde_json::from_value(json!({"fixture":{"continuation":value}})).unwrap(),
+            },
+        }
+    }
+    #[test]
+    fn duplicate_items_keep_their_ordered_metadata_and_no_global_identity() {
+        let state = CapturedModelProviderOutput::default();
+        let repeated = item("same");
+        state
+            .capture(
+                vec![repeated.clone(), repeated.clone(), repeated.clone()],
+                vec![annotation(0, "first"), annotation(2, "third")],
+            )
+            .unwrap();
+        assert_eq!(
+            state.take_for(&repeated).unwrap().unwrap().value["fixture"]["continuation"],
+            "first"
+        );
+        assert!(state.take_for(&repeated).unwrap().is_none());
+        assert_eq!(
+            state.take_for(&repeated).unwrap().unwrap().value["fixture"]["continuation"],
+            "third"
+        );
+        assert!(state.take_for(&repeated).is_err());
+        assert!(
+            CapturedModelProviderOutput::default()
+                .take_for(&repeated)
+                .unwrap()
+                .is_none()
+        );
+    }
+    #[test]
+    fn mismatch_does_not_consume_another_occurrences_metadata() {
+        let state = CapturedModelProviderOutput::default();
+        state
+            .capture(vec![item("first")], vec![annotation(0, "owned")])
+            .unwrap();
+        assert!(state.take_for(&item("other")).is_err());
+        assert!(state.take_for(&item("first")).unwrap().is_some());
+    }
+    #[test]
+    fn invalid_batches_leave_the_capture_unpublished() {
+        for annotations in [
+            vec![annotation(1, "out-of-range")],
+            vec![annotation(0, "first"), annotation(0, "duplicate")],
+        ] {
+            let state = CapturedModelProviderOutput::default();
+            assert!(state.capture(vec![item("first")], annotations).is_err());
+            assert!(state.take_for(&item("first")).unwrap().is_none());
+        }
+    }
+    #[test]
+    fn stream_annotations_keep_prefix_occurrences_and_the_original_owner() {
+        let state = CapturedModelProviderOutput::default();
+        assert!(state.take_for(&item("prefix")).unwrap().is_none());
+        let shared = state.clone();
+        shared
+            .append_stream_output(1, item("tool"), annotation(1, "owned").metadata)
+            .unwrap();
+        assert!(state.take_for(&item("tool")).unwrap().is_some());
+        assert!(
+            shared
+                .append_stream_output(1, item("tool"), annotation(1, "late").metadata)
+                .is_err()
+        );
+        assert!(
+            CapturedModelProviderOutput::default()
+                .take_for(&item("tool"))
+                .unwrap()
+                .is_none()
+        );
+    }
+    #[test]
+    fn oversized_metadata_is_rejected_before_retention() {
+        let state = CapturedModelProviderOutput::default();
+        assert!(
+            state
+                .capture(
+                    vec![item("first")],
+                    vec![annotation(0, &"x".repeat(MAX_BYTES))]
+                )
+                .is_err()
+        );
+        assert!(state.take_for(&item("first")).unwrap().is_none());
+    }
+}
