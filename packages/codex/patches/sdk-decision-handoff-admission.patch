+/// The immutable producing profile owns both the tool and its allowed destinations.
+pub(crate) fn admits_handoff(
+    data: &codex_extension_api::ExtensionDataInit,
+    name: &codex_tools::ToolName,
+    target: Option<&str>,
+) -> bool {
+    let name = name.clone().with_default_namespace();
+    data.get::<codex_extension_api::AgentProfileHandoffTools>()
+        .and_then(|tools| tools.targets.get(&name).cloned())
+        .is_some_and(|allowed| target.is_none_or(|target| target == allowed))
+        || data
+            .get::<codex_extension_api::AgentProfileDecisionHandoffTools>()
+            .and_then(|tools| tools.targets.get(&name).cloned())
+            .is_some_and(|allowed| {
+                target.is_none_or(|target| allowed.iter().any(|allowed| allowed == target))
+            })
+}
