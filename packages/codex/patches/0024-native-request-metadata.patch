+//! Passive, metadata-only observations for an exact SDK-owned root sampling turn.
+use std::sync::Arc;
+
+/// Effort's serialized scalar kind. Bindings must preserve it before JSON parsing.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ModelRequestEffort {
+    Text(String),
+    Integer(u64),
+}
+impl ModelRequestEffort {
+    /// Private binding encoding; decimal text prevents host JSON-number rounding.
+    pub fn to_bridge_value(&self) -> serde_json::Value {
+        match self {
+            Self::Text(value) => serde_json::json!({"kind": "text", "value": value}),
+            Self::Integer(value) => {
+                serde_json::json!({"kind": "integer", "decimal": value.to_string()})
+            }
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ModelRequestWire {
+    Responses,
+    ResponsesLite,
+}
+impl ModelRequestWire {
+    fn as_str(self) -> &'static str {
+        match self {
+            Self::Responses => "responses",
+            Self::ResponsesLite => "responses_lite",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ModelRequestTransport {
+    HttpSse,
+    Websocket,
+}
+impl ModelRequestTransport {
+    fn as_str(self) -> &'static str {
+        match self {
+            Self::HttpSse => "http_sse",
+            Self::Websocket => "websocket",
+        }
+    }
+}
+
+/// Reaching this notification does not establish serialization or a network send.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ModelRequestDispatching {
+    pub request_id: String,
+    pub thread_id: String,
+    pub turn_id: String,
+    pub model: String,
+    pub reasoning_effort: Option<ModelRequestEffort>,
+    pub reasoning_summary: Option<String>,
+    pub service_tier: Option<String>,
+    pub wire: ModelRequestWire,
+    pub transport: ModelRequestTransport,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ModelResponseLinked {
+    pub request_id: String,
+    pub thread_id: String,
+    pub turn_id: String,
+    pub response_observation_id: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ModelRequestObservation {
+    Dispatching(ModelRequestDispatching),
+    ResponseLinked(ModelResponseLinked),
+}
+impl ModelRequestObservation {
+    /// Safe private native-to-host bridge. Contains no body, endpoint or headers.
+    pub fn to_bridge_value(&self) -> serde_json::Value {
+        match self {
+            Self::Dispatching(event) => serde_json::json!({
+                "type": "model_request_dispatching",
+                "request_id": event.request_id,
+                "thread_id": event.thread_id,
+                "turn_id": event.turn_id,
+                "model": event.model,
+                "reasoning_effort": event.reasoning_effort.as_ref().map(ModelRequestEffort::to_bridge_value),
+                "reasoning_summary": event.reasoning_summary,
+                "service_tier": event.service_tier,
+                "wire": event.wire.as_str(),
+                "transport": event.transport.as_str(),
+            }),
+            Self::ResponseLinked(event) => serde_json::json!({
+                "type": "model_response_linked",
+                "request_id": event.request_id,
+                "thread_id": event.thread_id,
+                "turn_id": event.turn_id,
+                "response_observation_id": event.response_observation_id,
+            }),
+        }
+    }
+}
+
+/// Internal SDK route, captured for one immutable public submission/handle.
+///
+/// Implementations must use bounded, nonblocking delivery and return immediately.
+/// Full/closed/retired routes drop the record. Never invoke application callbacks,
+/// look up a current turn, await capacity, or propagate delivery failure to inference.
+/// The captured owner must fence retired submissions without redirecting records.
+pub trait ModelRequestObserver: Send + Sync + std::fmt::Debug {
+    fn observe(&self, observation: ModelRequestObservation);
+}
+
+/// Install only in a managed direct-root turn's exact ExtensionData store.
+/// Missing routes leave execution unchanged. Children must not inherit this value.
+#[derive(Clone, Debug)]
+pub struct ModelRequestObservationRoute(pub Arc<dyn ModelRequestObserver>);
