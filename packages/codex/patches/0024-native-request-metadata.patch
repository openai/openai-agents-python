+//! Final scalar projection at selected client invocation; delivery is best effort.
+use codex_api::Reasoning;
+use codex_extension_api::ModelRequestDispatching;
+use codex_extension_api::ModelRequestEffort;
+use codex_extension_api::ModelRequestObservation;
+use codex_extension_api::ModelRequestObservationRoute;
+use codex_extension_api::ModelRequestTransport;
+use codex_extension_api::ModelRequestWire;
+use codex_extension_api::ModelResponseLinked;
+use codex_extension_api::ModelToolAdmission;
+use std::sync::Arc;
+
+/// Transient request identity and the original immutable SDK submission route.
+#[derive(Debug)]
+pub(crate) struct RequestObservationContext {
+    // Retain original store object identity; never re-query a current turn.
+    _admission: Arc<dyn ModelToolAdmission>,
+    request_id: String,
+    thread_id: String,
+    turn_id: String,
+    route: Arc<ModelRequestObservationRoute>,
+}
+impl RequestObservationContext {
+    pub(crate) fn response_linked(&self, response_observation_id: &str) {
+        self.route
+            .0
+            .observe(ModelRequestObservation::ResponseLinked(
+                ModelResponseLinked {
+                    request_id: self.request_id.clone(),
+                    thread_id: self.thread_id.clone(),
+                    turn_id: self.turn_id.clone(),
+                    response_observation_id: response_observation_id.to_owned(),
+                },
+            ));
+    }
+}
+
+/// Serialize only Reasoning so effort follows the native wire serializer exactly.
+/// A projection failure drops metadata; it must never reject an inference request.
+fn resolved_reasoning(
+    reasoning: Option<&Reasoning>,
+) -> Option<(Option<ModelRequestEffort>, Option<String>)> {
+    let Some(reasoning) = reasoning else {
+        return Some((None, None));
+    };
+    let value = serde_json::to_value(reasoning).ok()?;
+    let effort = match value.get("effort") {
+        None | Some(serde_json::Value::Null) => None,
+        Some(serde_json::Value::String(value)) => Some(ModelRequestEffort::Text(value.clone())),
+        Some(value) => Some(ModelRequestEffort::Integer(value.as_u64()?)),
+    };
+    let summary = match value.get("summary") {
+        None | Some(serde_json::Value::Null) => None,
+        Some(value) => Some(value.as_str()?.to_owned()),
+    };
+    Some((effort, summary))
+}
+
+/// Invoke synchronously after applicable existing checks, before entering the API.
+/// The transport may still fail encoding or send zero bytes. Its internal retries
+/// share this invocation; later client invocations call this function afresh.
+pub(crate) fn dispatching(
+    admission: Option<&Arc<dyn ModelToolAdmission>>,
+    model: &str,
+    reasoning: Option<&Reasoning>,
+    service_tier: Option<&str>,
+    wire: ModelRequestWire,
+    transport: ModelRequestTransport,
+) -> Option<Arc<RequestObservationContext>> {
+    let admission = admission?;
+    let route = admission
+        .turn_store()
+        .get::<ModelRequestObservationRoute>()?;
+    let (reasoning_effort, reasoning_summary) = resolved_reasoning(reasoning)?;
+    let context = Arc::new(RequestObservationContext {
+        _admission: Arc::clone(admission),
+        request_id: uuid::Uuid::now_v7().to_string(),
+        thread_id: admission.thread_id().to_owned(),
+        turn_id: admission.turn_store().level_id().to_owned(),
+        route,
+    });
+    context
+        .route
+        .0
+        .observe(ModelRequestObservation::Dispatching(
+            ModelRequestDispatching {
+                request_id: context.request_id.clone(),
+                thread_id: context.thread_id.clone(),
+                turn_id: context.turn_id.clone(),
+                model: model.to_owned(),
+                reasoning_effort,
+                reasoning_summary,
+                service_tier: service_tier.map(str::to_owned),
+                wire,
+                transport,
+            },
+        ));
+    Some(context)
+}
+
