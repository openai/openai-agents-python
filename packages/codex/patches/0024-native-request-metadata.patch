@@ -0,0 +1,205 @@
+use super::*;
+use codex_extension_api::ExtensionData;
+use codex_extension_api::ModelRequestObserver;
+use codex_protocol::config_types::ReasoningSummary;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::openai_models::ReasoningEffort;
+use serde_json::json;
+use std::sync::atomic::{AtomicBool, Ordering};
+use tokio::sync::mpsc;
+
+#[derive(Debug)]
+struct BoundedRoute {
+    sender: mpsc::Sender<ModelRequestObservation>,
+    retired: AtomicBool,
+}
+impl ModelRequestObserver for BoundedRoute {
+    fn observe(&self, observation: ModelRequestObservation) {
+        if !self.retired.load(Ordering::Acquire) {
+            // Full and closed queues intentionally lose observations.
+            let _ = self.sender.try_send(observation);
+        }
+    }
+}
+#[derive(Debug)]
+struct Admission {
+    thread: String,
+    store: ExtensionData,
+}
+impl ModelToolAdmission for Admission {
+    fn thread_id(&self) -> &str {
+        &self.thread
+    }
+    fn turn_store(&self) -> &ExtensionData {
+        &self.store
+    }
+    fn admits(&self, _: &ResponseItem) -> bool {
+        false
+    }
+}
+
+fn fixture(
+    capacity: usize,
+) -> (
+    Arc<dyn ModelToolAdmission>,
+    Arc<BoundedRoute>,
+    mpsc::Receiver<ModelRequestObservation>,
+) {
+    let (sender, receiver) = mpsc::channel(capacity);
+    let route = Arc::new(BoundedRoute {
+        sender,
+        retired: AtomicBool::new(false),
+    });
+    let admission = Arc::new(Admission {
+        thread: "original-thread".into(),
+        store: ExtensionData::new("original-turn"),
+    });
+    admission
+        .store
+        .get_or_init(|| ModelRequestObservationRoute(route.clone()));
+    (admission, route, receiver)
+}
+fn notify(
+    admission: Option<&Arc<dyn ModelToolAdmission>>,
+) -> Option<Arc<RequestObservationContext>> {
+    dispatching(
+        admission,
+        "resolved-model",
+        None,
+        None,
+        ModelRequestWire::Responses,
+        ModelRequestTransport::HttpSse,
+    )
+}
+
+#[test]
+fn effort_bridge_preserves_wire_scalar_kind_and_exact_integer() {
+    for (input, expected) in [
+        (
+            "18446744073709551615",
+            json!({"kind":"integer", "decimal":"18446744073709551615"}),
+        ),
+        (
+            "9007199254740993",
+            json!({"kind":"integer", "decimal":"9007199254740993"}),
+        ),
+        ("00042", json!({"kind":"integer", "decimal":"42"})),
+        (
+            "18446744073709551616",
+            json!({"kind":"text", "value":"18446744073709551616"}),
+        ),
+        ("1e3", json!({"kind":"text", "value":"1e3"})),
+        ("high", json!({"kind":"text", "value":"high"})),
+    ] {
+        let reasoning = Reasoning {
+            effort: Some(ReasoningEffort::Custom(input.into())),
+            summary: None,
+            context: None,
+        };
+        let (effort, summary) =
+            resolved_reasoning(Some(&reasoning)).expect("known scalar reasoning");
+        assert_eq!(effort.expect("present effort").to_bridge_value(), expected);
+        assert_eq!(summary, None);
+    }
+    assert_eq!(resolved_reasoning(None), Some((None, None)));
+    let reasoning = Reasoning {
+        effort: None,
+        summary: Some(ReasoningSummary::Detailed),
+        context: None,
+    };
+    assert_eq!(
+        resolved_reasoning(Some(&reasoning)),
+        Some((None, Some("detailed".into())))
+    );
+}
+
+#[test]
+fn no_captured_route_produces_no_observation_or_rejection() {
+    assert!(notify(None).is_none());
+    let admission: Arc<dyn ModelToolAdmission> = Arc::new(Admission {
+        thread: "thread".into(),
+        store: ExtensionData::new("turn"),
+    });
+    assert!(notify(Some(&admission)).is_none());
+}
+
+#[test]
+fn invocation_and_terminal_link_share_exact_original_identity() {
+    let (admission, _, mut receiver) = fixture(8);
+    let first = notify(Some(&admission)).expect("captured root route");
+    let second = dispatching(
+        Some(&admission),
+        "resolved-model-2",
+        None,
+        Some("flex"),
+        ModelRequestWire::ResponsesLite,
+        ModelRequestTransport::Websocket,
+    )
+    .expect("captured root route");
+    assert!(std::ptr::eq(
+        first._admission.turn_store(),
+        admission.turn_store()
+    ));
+    let first_event = receiver
+        .try_recv()
+        .expect("first invocation")
+        .to_bridge_value();
+    let second_event = receiver
+        .try_recv()
+        .expect("second invocation")
+        .to_bridge_value();
+    assert_ne!(first_event["request_id"], second_event["request_id"]);
+    assert_eq!(first_event["thread_id"], "original-thread");
+    assert_eq!(first_event["turn_id"], "original-turn");
+    assert_eq!(first_event["model"], "resolved-model");
+    assert_eq!(first_event["service_tier"], serde_json::Value::Null);
+    assert_eq!(first_event["reasoning_effort"], serde_json::Value::Null);
+    assert_eq!(first_event["transport"], "http_sse");
+    assert_eq!(second_event["wire"], "responses_lite");
+    assert_eq!(second_event["transport"], "websocket");
+    assert_eq!(second_event["service_tier"], "flex");
+    first.response_linked("occurrence-A");
+    second.response_linked("occurrence-B");
+    let first_link = receiver
+        .try_recv()
+        .expect("first retained occurrence")
+        .to_bridge_value();
+    let second_link = receiver
+        .try_recv()
+        .expect("second retained occurrence")
+        .to_bridge_value();
+    assert_eq!(first_link["request_id"], first_event["request_id"]);
+    assert_eq!(first_link["response_observation_id"], "occurrence-A");
+    assert_eq!(second_link["request_id"], second_event["request_id"]);
+    assert_eq!(second_link["response_observation_id"], "occurrence-B");
+    assert_eq!(first_link["thread_id"], "original-thread");
+    assert_eq!(first_link["turn_id"], "original-turn");
+    assert_eq!(first_event.as_object().expect("object").len(), 10);
+    assert_eq!(first_link.as_object().expect("object").len(), 5);
+}
+
+#[test]
+fn native_full_closed_and_retired_routes_are_nonblocking_and_do_not_redirect() {
+    let (admission, route, mut receiver) = fixture(1);
+    let first = notify(Some(&admission)).expect("first context");
+    // The queue is already full. A second invocation still receives its context.
+    assert!(notify(Some(&admission)).is_some());
+    receiver.try_recv().expect("only retained notification");
+    assert!(receiver.try_recv().is_err());
+    route.retired.store(true, Ordering::Release);
+    first.response_linked("retained-before-retirement");
+    assert!(receiver.try_recv().is_err());
+    let (later_admission, _, mut later_receiver) = fixture(1);
+    let later = notify(Some(&later_admission)).expect("later owner");
+    assert_ne!(first.request_id, later.request_id);
+    first.response_linked("late-old-occurrence");
+    let later_event = later_receiver
+        .try_recv()
+        .expect("later owner event")
+        .to_bridge_value();
+    assert_eq!(later_event["request_id"], later.request_id);
+    assert!(later_receiver.try_recv().is_err());
+    drop(receiver);
+    route.retired.store(false, Ordering::Release);
+    assert!(notify(Some(&admission)).is_some());
+}
