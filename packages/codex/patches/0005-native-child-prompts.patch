diff --git a/codex-rs/rmcp-client/src/elicitation_owner.rs b/codex-rs/rmcp-client/src/elicitation_owner.rs
new file mode 100644
index 0000000000000000000000000000000000000000..64e26be4d66b37579ad6543fd48f55ef49e7a550
--- /dev/null
+++ b/codex-rs/rmcp-client/src/elicitation_owner.rs
@@ -0,0 +1,335 @@
+//! Trusted call ownership carried through local RMCP extensions, never peer metadata.
+use rmcp::model::{ClientRequest, GetExtensions, JsonRpcMessage, RequestId};
+use rmcp::service::{InboundStreamOrigin, RoleClient, RxJsonRpcMessage, TxJsonRpcMessage};
+use rmcp::transport::{IntoTransport, Transport};
+use std::collections::HashMap;
+use std::future::Future;
+use std::sync::{Arc, Mutex};
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone)]
+pub struct ElicitationOwner {
+    pub turn_id: String,
+    pub admission: Arc<dyn std::any::Any + Send + Sync>,
+    revoked: CancellationToken,
+}
+impl ElicitationOwner {
+    pub fn for_admission(turn_id: String, admission: Arc<dyn std::any::Any + Send + Sync>) -> Self {
+        Self {
+            turn_id,
+            admission,
+            revoked: CancellationToken::new(),
+        }
+    }
+    pub fn revoke(&self) {
+        self.revoked.cancel();
+    }
+    pub fn same_admission(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.admission, &other.admission)
+    }
+    pub fn is_live(&self) -> bool {
+        !self.revoked.is_cancelled()
+    }
+    pub async fn cancelled(&self) {
+        self.revoked.cancelled().await;
+    }
+}
+tokio::task_local! { static OWNER: Option<ElicitationOwner>; }
+pub fn current_elicitation_owner() -> Option<ElicitationOwner> {
+    OWNER
+        .try_with(Clone::clone)
+        .ok()
+        .flatten()
+        .filter(ElicitationOwner::is_live)
+}
+pub async fn with_elicitation_owner<T>(
+    turn_id: String,
+    admission: Option<Arc<dyn std::any::Any + Send + Sync>>,
+    future: impl Future<Output = T>,
+) -> T {
+    let Some(admission) = admission else {
+        return OWNER.scope(None, future).await;
+    };
+    struct Revoke(CancellationToken);
+    impl Drop for Revoke {
+        fn drop(&mut self) {
+            self.0.cancel();
+        }
+    }
+    let owner = ElicitationOwner {
+        turn_id,
+        admission,
+        revoked: CancellationToken::new(),
+    };
+    let _revoke = Revoke(owner.revoked.clone());
+    OWNER.scope(Some(owner), future).await
+}
+pub async fn scope_owner<T>(owner: Option<ElicitationOwner>, future: impl Future<Output = T>) -> T {
+    OWNER.scope(owner, future).await
+}
+pub(crate) fn owned_tool_request(params: rmcp::model::CallToolRequestParams) -> ClientRequest {
+    let mut request = rmcp::model::CallToolRequest::new(params);
+    if let Some(owner) = current_elicitation_owner() {
+        request.extensions.insert(owner);
+    }
+    ClientRequest::CallToolRequest(request)
+}
+#[derive(Clone, Default)]
+pub(crate) struct RequestOwners(Arc<Mutex<HashMap<RequestId, ElicitationOwner>>>);
+impl RequestOwners {
+    pub(crate) fn get(&self, origin: Option<&InboundStreamOrigin>) -> Option<ElicitationOwner> {
+        let Some(InboundStreamOrigin::OutboundRequest(id)) = origin else {
+            return None;
+        };
+        self.0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .get(id)
+            .cloned()
+            .filter(ElicitationOwner::is_live)
+    }
+}
+pub(crate) fn capture_request_owners<T, E, A>(
+    transport: T,
+    owners: RequestOwners,
+) -> impl Transport<RoleClient, Error = E> + 'static
+where
+    T: IntoTransport<RoleClient, E, A>,
+    E: std::error::Error + Send + Sync + 'static,
+{
+    OwnedTransport {
+        inner: transport.into_transport(),
+        owners,
+    }
+}
+struct OwnedTransport<T> {
+    inner: T,
+    owners: RequestOwners,
+}
+impl<T: Transport<RoleClient> + 'static> Transport<RoleClient> for OwnedTransport<T> {
+    type Error = T::Error;
+    fn send(
+        &mut self,
+        message: TxJsonRpcMessage<RoleClient>,
+    ) -> impl Future<Output = Result<(), Self::Error>> + Send + 'static {
+        let id = if let JsonRpcMessage::Request(envelope) = &message {
+            if let Some(owner) = envelope
+                .request
+                .extensions()
+                .get::<ElicitationOwner>()
+                .cloned()
+            {
+                self.owners
+                    .0
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                    .insert(envelope.id.clone(), owner);
+                Some(envelope.id.clone())
+            } else {
+                None
+            }
+        } else {
+            None
+        };
+        let owners = self.owners.clone();
+        let send = self.inner.send(message);
+        async move {
+            let result = send.await;
+            if result.is_err() {
+                if let Some(id) = id {
+                    owners
+                        .0
+                        .lock()
+                        .unwrap_or_else(std::sync::PoisonError::into_inner)
+                        .remove(&id);
+                }
+            }
+            result
+        }
+    }
+    async fn close(&mut self) -> Result<(), Self::Error> {
+        self.owners
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clear();
+        self.inner.close().await
+    }
+
+    async fn receive(&mut self) -> Option<RxJsonRpcMessage<RoleClient>> {
+        let message = self.inner.receive().await;
+        let mut owners = self
+            .owners
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        match &message {
+            Some(JsonRpcMessage::Response(response)) => {
+                owners.remove(&response.id);
+            }
+            Some(JsonRpcMessage::Error(error)) => {
+                if let Some(id) = &error.id {
+                    owners.remove(id);
+                }
+            }
+            None => owners.clear(),
+            _ => {}
+        }
+        owners.retain(|_, owner| owner.is_live());
+        message
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn exact_stream_identity_and_call_retirement_bound_ownership() {
+        let owners = RequestOwners::default();
+        let id = RequestId::Number(7);
+        with_elicitation_owner("original".to_owned(), Some(Arc::new(())), async {
+            let owner = current_elicitation_owner().expect("call owner");
+            owners.0.lock().unwrap().insert(id.clone(), owner);
+            assert!(owners.get(None).is_none());
+            assert!(
+                owners
+                    .get(Some(&InboundStreamOrigin::Unassociated))
+                    .is_none()
+            );
+            assert!(
+                owners
+                    .get(Some(&InboundStreamOrigin::OutboundRequest(
+                        RequestId::Number(8)
+                    )))
+                    .is_none()
+            );
+            assert_eq!(
+                owners
+                    .get(Some(&InboundStreamOrigin::OutboundRequest(id.clone())))
+                    .unwrap()
+                    .turn_id,
+                "original"
+            );
+        })
+        .await;
+        // A remembered request ID does not revive the source call after its result.
+        assert!(
+            owners
+                .get(Some(&InboundStreamOrigin::OutboundRequest(id)))
+                .is_none()
+        );
+    }
+
+    #[tokio::test]
+    async fn cancelling_source_revokes_owned_request_without_a_successor_lookup() {
+        let owners = RequestOwners::default();
+        let ready = Arc::new(tokio::sync::Notify::new());
+        let task = tokio::spawn({
+            let owners = owners.clone();
+            let ready = ready.clone();
+            async move {
+                with_elicitation_owner("cancelled".to_owned(), Some(Arc::new(())), async {
+                    owners
+                        .0
+                        .lock()
+                        .unwrap()
+                        .insert(RequestId::Number(1), current_elicitation_owner().unwrap());
+                    ready.notify_one();
+                    std::future::pending::<()>().await;
+                })
+                .await;
+            }
+        });
+        ready.notified().await;
+        task.abort();
+        assert!(task.await.unwrap_err().is_cancelled());
+        with_elicitation_owner("successor".to_owned(), Some(Arc::new(())), async {
+            assert!(
+                owners
+                    .get(Some(&InboundStreamOrigin::OutboundRequest(
+                        RequestId::Number(1)
+                    )))
+                    .is_none()
+            );
+        })
+        .await;
+    }
+
+    #[tokio::test]
+    async fn call_owner_is_not_serialized_or_reconstructed_from_peer_metadata() {
+        with_elicitation_owner("private-admission".to_owned(), Some(Arc::new(())), async {
+            let request = owned_tool_request(rmcp::model::CallToolRequestParams::new("search"));
+            assert!(request.extensions().get::<ElicitationOwner>().is_some());
+            assert!(
+                !serde_json::to_string(&request)
+                    .unwrap()
+                    .contains("private-admission")
+            );
+        })
+        .await;
+    }
+
+    #[tokio::test]
+    async fn close_clears_owners_and_waits_for_inner_success_or_failure() {
+        struct Gate {
+            entered: Arc<tokio::sync::Notify>,
+            release: Arc<tokio::sync::Notify>,
+            fail: bool,
+        }
+        impl Transport<RoleClient> for Gate {
+            type Error = std::io::Error;
+            fn send(
+                &mut self,
+                _: TxJsonRpcMessage<RoleClient>,
+            ) -> impl Future<Output = Result<(), Self::Error>> + Send + 'static {
+                std::future::ready(Ok(()))
+            }
+            async fn receive(&mut self) -> Option<RxJsonRpcMessage<RoleClient>> {
+                std::future::pending().await
+            }
+            async fn close(&mut self) -> Result<(), Self::Error> {
+                self.entered.notify_one();
+                self.release.notified().await;
+                if self.fail {
+                    Err(std::io::Error::other("controlled inner close failure"))
+                } else {
+                    Ok(())
+                }
+            }
+        }
+        for fail in [false, true] {
+            let entered = Arc::new(tokio::sync::Notify::new());
+            let release = Arc::new(tokio::sync::Notify::new());
+            let owners = RequestOwners::default();
+            owners.0.lock().unwrap().insert(
+                RequestId::Number(7),
+                ElicitationOwner::for_admission("source".into(), Arc::new(())),
+            );
+            let mut transport = OwnedTransport {
+                inner: Gate {
+                    entered: entered.clone(),
+                    release: release.clone(),
+                    fail,
+                },
+                owners: owners.clone(),
+            };
+            let close = transport.close();
+            tokio::pin!(close);
+            tokio::select! {
+                result = &mut close => panic!("outer close returned before inner cleanup: {result:?}"),
+                _ = entered.notified() => {},
+            }
+            assert!(owners.0.lock().unwrap().is_empty());
+            release.notify_one();
+            let result = close.await;
+            assert_eq!(result.is_err(), fail);
+            if fail {
+                assert_eq!(
+                    result.unwrap_err().to_string(),
+                    "controlled inner close failure"
+                );
+            }
+        }
+    }
+}
