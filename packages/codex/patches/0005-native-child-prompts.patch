+// Only admission-owned stdio moves the existing RMCP join owner out of request handles.
+// The join task owns RunningService; this wrapper owns its peer and the join receipt.
+// A canceled request cannot retain RunningService or make cleanup depend on itself.
+pub(crate) enum ClientService {
+    Shared(RunningService<RoleClient, ElicitationClientService>),
+    Owned {
+        peer: rmcp::service::Peer<RoleClient>,
+        handler: ElicitationClientService,
+        cancellation: std::sync::Mutex<Option<rmcp::service::RunningServiceCancellationToken>>,
+        completion: futures::future::Shared<BoxFuture<'static, Result<(), String>>>,
+    },
+}
+impl ClientService {
+    fn new(service: RunningService<RoleClient, ElicitationClientService>, owned: bool) -> Self {
+        if !owned {
+            return Self::Shared(service);
+        }
+        let peer = service.peer().clone();
+        let handler = service.service().clone();
+        let cancellation = service.cancellation_token();
+        let task = tokio::spawn(async move {
+            service
+                .waiting()
+                .await
+                .map(|_| ())
+                .map_err(|error| error.to_string())
+        });
+        Self::Owned {
+            peer,
+            handler,
+            cancellation: std::sync::Mutex::new(Some(cancellation)),
+            completion: async move { task.await.map_err(|error| error.to_string())? }
+                .boxed()
+                .shared(),
+        }
+    }
+    pub(crate) fn peer(&self) -> &rmcp::service::Peer<RoleClient> {
+        match self {
+            Self::Shared(service) => service.peer(),
+            Self::Owned { peer, .. } => peer,
+        }
+    }
+    pub(crate) fn service(&self) -> &ElicitationClientService {
+        match self {
+            Self::Shared(service) => service.service(),
+            Self::Owned { handler, .. } => handler,
+        }
+    }
+    pub(crate) fn is_closed(&self) -> bool {
+        match self {
+            Self::Shared(service) => service.is_closed(),
+            Self::Owned {
+                peer, cancellation, ..
+            } => {
+                cancellation
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                    .is_none()
+                    || peer.is_transport_closed()
+            }
+        }
+    }
+    async fn stop_owned(&self) -> Result<()> {
+        if let Self::Owned {
+            cancellation,
+            completion,
+            ..
+        } = self
+        {
