@@ -0,0 +1,182 @@
+//! Native process regression for an old binding retained across a same-admission refresh.
+use super::*;
+use codex_protocol::models::PermissionProfile;
+use std::path::Path;
+
+const SERVER: &str = r#"
+import json, os, signal, sys
+from pathlib import Path
+log = Path(sys.argv[1]) / (str(os.getpid()) + '.jsonl')
+label = sys.argv[2]
+def record(event):
+    with log.open('a') as stream:
+        stream.write(json.dumps({'event': event, 'pid': os.getpid(), 'label': label}) + '\n')
+def stop(*args):
+    record('signal_exit')
+    sys.exit(0)
+signal.signal(signal.SIGTERM, stop)
+record('start')
+for line in sys.stdin:
+    message = json.loads(line)
+    method = message.get('method')
+    if method is None:
+        record('answer')
+        continue
+    if 'id' not in message:
+        continue
+    if method == 'initialize':
+        result = {'protocolVersion':'2025-06-18','capabilities':{'tools':{},'experimental':{'codex/tool-catalog-cache':{'cacheable':False}}},'serverInfo':{'name':'owned-stdio','version':'1'}}
+    elif method == 'tools/list':
+        result = {'tools':[{'name':'search','description':'Wait for user input','inputSchema':{'type':'object','properties':{}}}]}
+    elif method == 'tools/call':
+        record('pending')
+        print(json.dumps({'jsonrpc':'2.0','id':873,'method':'elicitation/create','params':{'mode':'form','message':label,'requestedSchema':{'type':'object','properties':{'answer':{'type':'string'}},'required':['answer']}}}), flush=True)
+        continue
+    else:
+        result = {}
+    print(json.dumps({'jsonrpc':'2.0','id':message['id'],'result':result}), flush=True)
+record('eof_exit')
+"#;
+
+fn input(home: &Path, log: &Path, label: &str, tx: Sender<Event>) -> McpRuntimeInput {
+    let server: codex_config::McpServerConfig = serde_json::from_value(serde_json::json!({
+        "command": "python3", "args": ["-u", "-c", SERVER, log, label],
+        "required": true, "enabled_tools": ["search"],
+    }))
+    .expect("stdio config");
+    let mut config = crate::mcp::tests::test_mcp_config(home.to_path_buf());
+    config.permission_profile = PermissionProfile::Disabled;
+    config.client_elicitation_capability =
+        rmcp::model::ElicitationCapability::default().with_form(Default::default());
+    let mut catalog = crate::ResolvedMcpCatalog::builder();
+    catalog.register(crate::McpServerRegistration::from_config(
+        "docs".to_owned(),
+        server.clone(),
+    ));
+    config.mcp_server_catalog = catalog.build();
+    McpRuntimeInput {
+        startup_policy: McpStartupPolicy::Eager,
+        config: Arc::new(config),
+        plugins_available: false,
+        ready_selected_capability_roots: Vec::new(),
+        mcp_servers: HashMap::from([(
+            "docs".to_owned(),
+            EffectiveMcpServer::from_host_config(server),
+        )]),
+        submit_id: "admission".to_owned(),
+        tx_event: Some(tx),
+        startup_cancellation_token: CancellationToken::new(),
+        runtime_context: McpRuntimeContext::new(
+            Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+            home.to_path_buf(),
+        ),
+        codex_apps_tools_cache: ConnectorRuntimeManager::new_without_cache(),
+        tool_catalog_cache: McpToolCatalogCache::default(),
+        codex_apps_tools_cache_key: ConnectorRuntimeContextKey::personal(None, None),
+        client_mcp_extensions: ClientMcpExtensions::default(),
+        auth: None,
+        auth_manager: None,
+        elicitation_reviewer: None,
+        elicitation_lifecycle: None,
+    }
+}
+
+async fn question(
+    rx: &async_channel::Receiver<Event>,
+) -> codex_protocol::approvals::ElicitationRequestEvent {
+    loop {
+        if let EventMsg::ElicitationRequest(request) = rx.recv().await.expect("native event") {
+            return request;
+        }
+    }
+}
+
+#[tokio::test]
+async fn retirement_joins_old_and_current_stdio_bindings_from_one_admission() -> anyhow::Result<()>
+{
+    tokio::time::timeout(Duration::from_secs(45), async {
+        let home = tempfile::tempdir()?;
+        let log = home.path().join("processes");
+        std::fs::create_dir(&log)?;
+        let (tx, rx) = async_channel::unbounded();
+        let runtime = McpRuntime::empty(true);
+        runtime.enable_full_access_form_input();
+        runtime.begin_owned_prompt_startup();
+        assert!(runtime.finish_owned_prompt_startup());
+        // The unit tests MCP lifetime, while SDK native tests use real Core TurnContext owners.
+        let owner = codex_rmcp_client::ElicitationOwner::for_admission(
+            "one-admission".to_owned(),
+            Arc::new(()),
+        );
+        runtime.set_stdio_admission(owner.clone());
+        runtime
+            .replace(input(home.path(), &log, "old", tx.clone()))
+            .await;
+        runtime.validate_required_servers().await?;
+        let old_binding = runtime.current_binding().await.expect("old binding");
+        let old_call = old_binding
+            .prepare_call("docs", "search")
+            .expect("old call");
+        let old_request = tokio::spawn(async move { old_call.call(None, None, None).await });
+        let original = question(&rx).await;
+        assert_eq!(original.turn_id.as_deref(), Some("one-admission"));
+        // A changed command forces a new connection, while the old request/binding stay alive.
+        runtime
+            .replace(input(home.path(), &log, "current", tx.clone()))
+            .await;
+        runtime.validate_required_servers().await?;
+        let current_binding = runtime.current_binding().await.expect("current binding");
+        let current_call = current_binding
+            .prepare_call("docs", "search")
+            .expect("current call");
+        let current_request =
+            tokio::spawn(async move { current_call.call(None, None, None).await });
+        let current = question(&rx).await;
+        assert_eq!(current.turn_id, original.turn_id);
+        assert_ne!(current.id, original.id);
+        // An unchanged refresh reuses the current connection and must not retain it twice.
+        runtime
+            .replace(input(home.path(), &log, "current", tx))
+            .await;
+        assert_eq!(runtime.stdio_retirement.lock().unwrap().len(), 2);
+        runtime.retire_owned_stdio().await?;
+        assert!(!owner.is_live());
+        assert!(runtime.stdio_retirement.lock().unwrap().is_empty());
+        assert!(old_request.await?.is_err());
+        assert!(current_request.await?.is_err());
+        assert!(
+            old_binding
+                .prepare_call("docs", "search")
+                .unwrap()
+                .call(None, None, None)
+                .await
+                .is_err()
+        );
+        let processes = std::fs::read_dir(&log)?.collect::<Result<Vec<_>, _>>()?;
+        assert_eq!(processes.len(), 2);
+        for process in processes {
+            let rows = std::fs::read_to_string(process.path())?;
+            let values = rows
+                .lines()
+                .map(serde_json::from_str::<serde_json::Value>)
+                .collect::<Result<Vec<_>, _>>()?;
+            assert!(values.iter().any(|row| row["event"] == "pending"));
+            assert!(
+                values.iter().any(|row| {
+                    matches!(row["event"].as_str(), Some("signal_exit" | "eof_exit"))
+                })
+            );
+            let pid = values[0]["pid"].as_u64().unwrap();
+            // A zombie still responds to kill -0; this proves native cleanup reaped each child.
+            assert!(
+                !std::process::Command::new("kill")
+                    .args(["-0", &pid.to_string()])
+                    .output()?
+                    .status
+                    .success()
+            );
+        }
+        anyhow::Ok(())
+    })
+    .await?
+}
