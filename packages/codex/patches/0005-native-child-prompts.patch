index 0000000000000000000000000000000000000000..dd75a6fdb4c7dee446ea158d1a3e7900ac7a9810
--- /dev/null
+++ b/codex-rs/core/src/owned_question.rs
@@ -0,0 +1,253 @@
+//! A pending prompt captured from its original native turn, never the active successor.
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use crate::state::TurnState;
+use codex_protocol::protocol::{Event, EventMsg, Op, ReviewDecision};
+use rmcp::model::RequestId;
+use std::sync::Arc;
+use tokio::sync::Mutex;
+
+#[derive(Clone)]
+enum QuestionKey {
+    Approval(String),
+    Elicitation(String, RequestId),
+}
+#[derive(Clone)]
+pub struct OwnedQuestion {
+    session: Arc<Session>,
+    turn: Arc<TurnContext>,
+    state: Arc<Mutex<TurnState>>,
+    key: QuestionKey,
+    identity: Option<Arc<String>>,
+}
+impl OwnedQuestion {
+    pub(crate) async fn capture(session: Arc<Session>, event: &Event) -> Option<Self> {
+        let (turn_id, key) = match &event.msg {
+            EventMsg::ExecApprovalRequest(request) => (
+                request.turn_id.as_str(),
+                QuestionKey::Approval(
+                    request
+                        .approval_id
+                        .clone()
+                        .unwrap_or_else(|| request.call_id.clone()),
+                ),
+            ),
+            EventMsg::ApplyPatchApprovalRequest(request) => (
+                request.turn_id.as_str(),
+                QuestionKey::Approval(request.call_id.clone()),
+            ),
+            EventMsg::ElicitationRequest(request) => {
+                let id = match &request.id {
+                    codex_protocol::mcp::RequestId::String(id) => {
+                        RequestId::String(id.clone().into())
+                    }
+                    codex_protocol::mcp::RequestId::Integer(id) => RequestId::Number(*id),
+                };
+                (
+                    request.turn_id.as_deref()?,
+                    QuestionKey::Elicitation(request.server_name.clone(), id),
+                )
+            }
+            _ => return None,
+        };
+        let active = session.active_turn.lock().await;
+        let active = active.as_ref()?;
+        let task = active.task.as_ref()?;
+        if task.turn_context.sub_id != turn_id || task.cancellation_token.is_cancelled() {
+            return None;
+        }
+        let mut grant = Self {
+            session: session.clone(),
+            turn: task.turn_context.clone(),
+            state: active.turn_state.clone(),
+            key,
+            identity: None,
+        };
+        let state = grant.state.lock().await;
+        let identity = match &grant.key {
+            QuestionKey::Approval(id) => state.approval_identity(id),
+            QuestionKey::Elicitation(server, id) => state.elicitation_identity(server, id),
+        };
+        drop(state);
+        if let Some(identity) = &identity {
+            if event.id != format!("sdk-question:{}", identity.as_str()) {
+                return None;
+            }
+        } else if let QuestionKey::Elicitation(server, id) = &grant.key {
+            let original = grant
+                .session
+                .services
+                .mcp_runtime
+                .owned_elicitation_admission(server, id)?
+                .downcast::<TurnContext>()
+                .ok()?;
+            if !Arc::ptr_eq(&original, &grant.turn) {
+                return None;
+            }
+        } else {
+            return None;
+        }
+        grant.identity = identity;
+        let state = grant.state.lock().await;
+        let pending = grant.pending_in(&state);
+        drop(state);
+        pending.then_some(grant)
+    }
+    fn pending_in(&self, state: &TurnState) -> bool {
+        let current = match &self.key {
+            QuestionKey::Approval(id) => state.approval_identity(id),
+            QuestionKey::Elicitation(server, id) => state.elicitation_identity(server, id),
+        };
+        if let Some(expected) = &self.identity {
+            return current.is_some_and(|current| Arc::ptr_eq(&current, expected));
+        }
+        match &self.key {
+            QuestionKey::Approval(_) => false,
+            QuestionKey::Elicitation(server, id) => self
+                .session
+                .services
+                .mcp_runtime
+                .owned_elicitation_pending(server, id, &self.turn.sub_id),
+        }
+    }
+    pub async fn is_pending(&self) -> bool {
+        let active = self.session.active_turn.lock().await;
+        let Some(active) = active.as_ref() else {
+            return false;
+        };
+        if !active.task.as_ref().is_some_and(|task| {
+            Arc::ptr_eq(&task.turn_context, &self.turn) && !task.cancellation_token.is_cancelled()
+        }) || !Arc::ptr_eq(&active.turn_state, &self.state)
+        {
+            return false;
+        }
+        let state = self.state.lock().await;
+        self.pending_in(&state)
+    }
+    pub async fn respond(&self, operation: Op) -> bool {
+        // Hold the same admission lock through responder removal and send. No queued
+        // operation may resolve against a different active turn after this check.
+        let active = self.session.active_turn.lock().await;
+        let Some(active) = active.as_ref() else {
+            return false;
+        };
+        if !active.task.as_ref().is_some_and(|task| {
+            Arc::ptr_eq(&task.turn_context, &self.turn) && !task.cancellation_token.is_cancelled()
+        }) || !Arc::ptr_eq(&active.turn_state, &self.state)
+        {
+            return false;
+        }
+        let mut state = self.state.lock().await;
+        if !self.pending_in(&state) {
+            return false;
+        }
+        match (&self.key, operation) {
+            (
+                QuestionKey::Approval(expected),
+                Op::ExecApproval { id, decision, .. } | Op::PatchApproval { id, decision },
+            ) if expected == &id => {
+                // Persistent decisions and abort are outside the SDK grant.
+                if !matches!(
+                    decision,
+                    ReviewDecision::Approved | ReviewDecision::Denied { .. }
+                ) {
+                    return false;
+                }
+                state
+                    .remove_pending_approval(&id)
+                    .is_some_and(|sender| sender.send(decision).is_ok())
+            }
+            (
+                QuestionKey::Elicitation(server, expected),
+                Op::ResolveElicitation {
+                    server_name,
+                    request_id,
+                    decision,
+                    content,
+                    meta,
+                },
+            ) if server == &server_name => {
+                let id = match request_id {
+                    codex_protocol::mcp::RequestId::String(id) => RequestId::String(id.into()),
+                    codex_protocol::mcp::RequestId::Integer(id) => RequestId::Number(id),
+                };
+                if expected != &id {
+                    return false;
+                }
+                let action = match decision {
+                    codex_protocol::approvals::ElicitationAction::Accept => {
+                        codex_rmcp_client::ElicitationAction::Accept
+                    }
+                    codex_protocol::approvals::ElicitationAction::Decline => {
+                        codex_rmcp_client::ElicitationAction::Decline
+                    }
+                    codex_protocol::approvals::ElicitationAction::Cancel => {
+                        codex_rmcp_client::ElicitationAction::Cancel
+                    }
+                };
+                let response = codex_rmcp_client::ElicitationResponse {
+                    action,
+                    content,
+                    meta,
+                };
+                if let Some(sender) = state.remove_pending_elicitation(server, &id) {
+                    sender.send(response).is_ok()
+                } else {
+                    self.session.services.mcp_runtime.resolve_owned_elicitation(
+                        server,
+                        &id,
+                        &self.turn.sub_id,
+                        response,
+                    )
+                }
+            }
+            _ => false,
+        }
+    }
+}
+
+/// SDK-only prompt identity. Ordinary clients keep their original event IDs.
+pub(crate) async fn event_identity(
+    session: &Session,
+    turn: &TurnContext,
+    msg: &EventMsg,
+) -> Option<String> {
+    if !matches!(
+        msg,
+        EventMsg::ExecApprovalRequest(_)
+            | EventMsg::ApplyPatchApprovalRequest(_)
+            | EventMsg::ElicitationRequest(_)
+    ) || !turn.session_source.is_non_root_agent()
+        || !session
+            .services
+            .client_mcp_extensions
+            .contains("openai/sdk-child-prompts")
+    {
+        return None;
+    }
+    let active = session.active_turn.lock().await;
+    let active = active.as_ref()?;
+    if !active
+        .task
+        .as_ref()
+        .is_some_and(|task| std::ptr::eq(task.turn_context.as_ref(), turn))
+    {
+        return None;
+    }
+    let state = active.turn_state.lock().await;
+    let identity = match msg {
+        EventMsg::ExecApprovalRequest(request) => {
+            state.approval_identity(request.approval_id.as_deref().unwrap_or(&request.call_id))
+        }
+        EventMsg::ApplyPatchApprovalRequest(request) => state.approval_identity(&request.call_id),
+        EventMsg::ElicitationRequest(request) => {
+            let id = match &request.id {
+                codex_protocol::mcp::RequestId::String(id) => RequestId::String(id.clone().into()),
+                codex_protocol::mcp::RequestId::Integer(id) => RequestId::Number(*id),
+            };
+            state.elicitation_identity(&request.server_name, &id)
+        }
+        _ => None,
+    }?;
+    Some(format!("sdk-question:{}", identity.as_str()))
+}
