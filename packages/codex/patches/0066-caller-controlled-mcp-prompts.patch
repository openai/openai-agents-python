+    for method in ["prompts/list", "prompts/get"] {
+        // No terminator: the raw limit must reject before the SSE parser emits a message.
+        let (adapter, _) = sse_adapter(vec![b"data: ".to_vec(), vec![b'x'; 8 * 1024 * 1024]]);
+        let mut request = json!({"jsonrpc": "2.0", "id": 1, "method": method});
+        if method == "prompts/get" {
+            request["params"] = json!({"name": "large"});
+        }
+        let response = adapter
+            .post_message(
+                Arc::from("https://mcp.example/mcp"),
+                serde_json::from_value(request).expect("prompt request"),
+                None,
+                None,
+                sse_protocol_headers(false),
+            )
+            .await
+            .expect("open POST SSE stream");
+        let StreamableHttpPostResponse::Sse(mut events, _) = response else {
+            panic!("expected POST SSE response");
+        };
+        let error = events
+            .next()
+            .await
+            .expect("raw size error")
+            .expect_err("oversized prompt event must fail before parsing");
+        assert!(
+            error
+                .to_string()
+                .contains("MCP response body exceeds 8388608 bytes"),
+            "{error}"
+        );
+    }
+}
