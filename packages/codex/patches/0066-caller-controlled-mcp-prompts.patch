+#[tokio::test]
+async fn legacy_http_rejects_oversized_prompt_json_and_post_sse() -> anyhow::Result<()> {
+    for prompt_method in ["prompts/list", "prompts/get"] {
+        for sse in [false, true] {
+            let server = MockServer::start().await;
+            let padding = Arc::new("x".repeat(MAX_MCP_MESSAGE_BYTES + 1));
+            Mock::given(method("POST"))
+                .and(path("/mcp"))
+                .respond_with(move |request: &Request| {
+                    let body: Value = request.body_json().expect("JSON-RPC request");
+                    match body["method"].as_str() {
+                        Some("initialize") => ResponseTemplate::new(200).set_body_json(json!({
+                            "jsonrpc": "2.0",
+                            "id": body["id"],
+                            "result": {
+                                "protocolVersion": "2025-06-18",
+                                "capabilities": {"prompts": {}},
+                                "serverInfo": {"name": "legacy-prompt-limit", "version": "1.0.0"},
+                            },
+                        })),
+                        Some("notifications/initialized" | "notifications/cancelled") => {
+                            ResponseTemplate::new(202)
+                        }
+                        Some(method) if method == prompt_method => {
+                            let result = if method == "prompts/list" {
+                                json!({"prompts": [{"name": "large", "description": padding.as_str()}]})
+                            } else {
+                                json!({"messages": [{"role": "user", "content": {
+                                    "type": "text", "text": padding.as_str(),
+                                }}]})
+                            };
+                            let response = json!({"jsonrpc": "2.0", "id": body["id"], "result": result});
+                            if sse {
+                                ResponseTemplate::new(200).set_body_raw(
+                                    format!("event: message\ndata: {response}\n\n"),
+                                    "text/event-stream",
+                                )
+                            } else {
+                                ResponseTemplate::new(200).set_body_json(response)
+                            }
+                        }
+                        other => panic!("unexpected legacy MCP method {other:?}"),
+                    }
+                })
+                .mount(&server)
+                .await;
+
+            let client = http_client(&server, McpProtocolMode::Legacy).await?;
+            initialize(&client).await?;
+            let timeout = Some(Duration::from_secs(5));
+            let result = if prompt_method == "prompts/list" {
+                client.list_prompts(None, timeout).await.map(|_| ())
+            } else {
+                client
+                    .get_prompt(rmcp::model::GetPromptRequestParams::new("large"), timeout)
+                    .await
+                    .map(|_| ())
+            };
+            let error = result.expect_err("oversized prompt response must be rejected");
+            let error = format!("{error:#}");
+            // RMCP can surface a rejected POST SSE stream as a closed transport or timeout.
+            assert!(
+                error.contains("8388608 bytes")
+                    || (sse && (error.contains("timed out") || error.contains("Transport closed"))),
+                "unexpected {prompt_method} error (sse={sse}): {error}"
+            );
+            client.shutdown().await;
+        }
+    }
+    Ok(())
+}
