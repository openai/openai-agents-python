+    pub async fn list_prompts(
+        &self,
+        params: Option<PaginatedRequestParams>,
+        timeout: Option<Duration>,
+    ) -> Result<ListPromptsResult> {
+        let params = crate::trace_context::traced_pagination(params);
+        self.refresh_oauth_if_needed().await?;
+        let result = self
+            .run_service_operation("prompts/list", timeout, move |service| {
+                let params = params.clone();
+                async move {
+                    let info = service.peer().peer_info().ok_or_else(|| {
+                        ServiceError::McpError(rmcp::model::ErrorData::invalid_request(
+                            "prompts/list requires an initialized MCP client",
+                            None,
+                        ))
+                    })?;
+                    if info.capabilities.prompts.is_none() {
+                        return Ok(ListPromptsResult::with_all_items(Vec::new()));
+                    }
+                    service.peer().list_prompts(params).await
+                }
+                .boxed()
+            })
+            .await?;
+        self.persist_oauth_tokens().await;
+        Ok(result)
+    }
+
+    pub async fn get_prompt(
+        &self,
+        mut params: GetPromptRequestParams,
+        timeout: Option<Duration>,
+    ) -> Result<GetPromptResult> {
+        params.meta = crate::trace_context::with_current_trace(params.meta);
+        self.refresh_oauth_if_needed().await?;
+        let result = self
+            .run_service_operation("prompts/get", timeout, move |service| {
+                let params = params.clone();
+                async move {
+                    let info = service.peer().peer_info().ok_or_else(|| {
+                        ServiceError::McpError(rmcp::model::ErrorData::invalid_request(
+                            "prompts/get requires an initialized MCP client",
+                            None,
+                        ))
+                    })?;
+                    if info.capabilities.prompts.is_none() {
+                        return Err(ServiceError::McpError(
+                            rmcp::model::ErrorData::invalid_request(
+                                "prompts/get is unsupported by this MCP server",
+                                None,
+                            ),
+                        ));
+                    }
+                    service.peer().get_prompt(params).await
+                }
+                .boxed()
+            })
+            .await?;
+        self.persist_oauth_tokens().await;
+        Ok(result)
+    }
