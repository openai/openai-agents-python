+    pub async fn list_prompts(&self, server: &str) -> Result<Vec<rmcp::model::Prompt>> {
+        let (managed, timeout) = self.client_by_name(server).await?;
+        let client = &managed.client;
+        collect_paginated("prompts/list", timeout, |params| async move {
+            let response = client.list_prompts(params, timeout).await?;
+            Ok((response.prompts, response.next_cursor))
+        })
+        .await
+        .with_context(|| format!("prompts/list failed for `{server}`"))
+    }
+
+    pub async fn get_prompt(
+        &self,
+        server: &str,
+        params: rmcp::model::GetPromptRequestParams,
+    ) -> Result<rmcp::model::GetPromptResult> {
+        let (managed, timeout) = self.client_by_name(server).await?;
+        managed
+            .client
+            .get_prompt(params, timeout)
+            .await
+            .with_context(|| format!("prompts/get failed for `{server}`"))
+    }
