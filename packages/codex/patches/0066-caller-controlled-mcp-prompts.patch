+#[tokio::test(flavor = "multi_thread", worker_threads = 1)]
+async fn missing_prompt_capability_is_empty_for_list_and_unsupported_for_get() -> anyhow::Result<()>
+{
+    let client = resource_client().await?;
+    assert!(
+        client
+            .list_prompts(None, Some(Duration::from_secs(5)))
+            .await?
+            .prompts
+            .is_empty()
+    );
+    let error = client
+        .get_prompt(
+            rmcp::model::GetPromptRequestParams::new(""),
+            Some(Duration::from_secs(5)),
+        )
+        .await
+        .unwrap_err();
+    assert!(error.to_string().contains("unsupported"), "{error:#}");
+    client.shutdown().await;
+    Ok(())
+}
