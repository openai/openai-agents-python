+// Use the shared HTTP capability mock so chunk boundaries are deterministic.
+#[derive(Default)]
+struct SseHttpClient {
+    chunks: Mutex<Vec<Vec<u8>>>,
+    requests: Mutex<Vec<HttpRequestParams>>,
+}
+
+impl HttpClient for SseHttpClient {
+    fn http_request(
+        &self,
+        _params: HttpRequestParams,
+    ) -> BoxFuture<'_, Result<HttpRequestResponse, ExecServerError>> {
+        Box::pin(async { panic!("expected a streaming HTTP request") })
+    }
+
+    fn http_request_stream(
+        &self,
+        params: HttpRequestParams,
+    ) -> BoxFuture<'_, Result<(HttpRequestResponse, HttpResponseBodyStream), ExecServerError>> {
+        self.requests.lock().expect("request lock").push(params);
+        let chunks = std::mem::take(&mut *self.chunks.lock().expect("body lock"));
+        Box::pin(async move {
+            Ok((
+                HttpRequestResponse {
+                    status: 200,
+                    headers: vec![HttpHeader {
+                        name: "content-type".to_string(),
+                        value: "text/event-stream".to_string(),
+                        value_env_var: None,
+                    }],
+                    body: Vec::new().into(),
+                },
+                HttpResponseBodyStream::from_chunks(chunks),
+            ))
+        })
+    }
+}
+
+fn sse_adapter(chunks: Vec<Vec<u8>>) -> (StreamableHttpClientAdapter, Arc<SseHttpClient>) {
+    let http = Arc::new(SseHttpClient {
+        chunks: Mutex::new(chunks),
+        ..Default::default()
+    });
+    let adapter = StreamableHttpClientAdapter::new(
+        http.clone(),
+        HeaderMap::new(),
+        None,
+        false,
+        StreamableHttpRedirectMode::Legacy,
+        Arc::new(Mutex::new(None)),
+    );
+    (adapter, http)
+}
+
+fn sse_protocol_headers(modern: bool) -> HashMap<http::HeaderName, HeaderValue> {
+    HashMap::from([(
+        http::HeaderName::from_static("mcp-protocol-version"),
+        HeaderValue::from_static(if modern { "2026-07-28" } else { "2025-06-18" }),
+    )])
+}
