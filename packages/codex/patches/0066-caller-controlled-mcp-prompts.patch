+impl std::io::Write for PromptCatalogBudget {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        if bytes.len() > self.0 {
+            return Err(std::io::Error::other("prompt catalog byte limit exceeded"));
+        }
+        self.0 -= bytes.len();
+        Ok(bytes.len())
+    }
+
