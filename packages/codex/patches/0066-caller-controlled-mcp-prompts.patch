+#[tokio::test(flavor = "multi_thread", worker_threads = 1)]
+async fn prompt_operations_reject_uninitialized_and_closed_clients() -> anyhow::Result<()> {
+    let client = RmcpClient::new_stdio_client(
+        stdio_server_bin()?.into(),
+        Vec::<OsString>::new(),
+        None,
+        &[],
+        None,
+        Arc::new(LocalStdioServerLauncher::new(std::env::current_dir()?)),
+    )
+    .await?;
+    for expected in ["not initialized", "shut down"] {
+        let list = client
+            .list_prompts(None, Some(Duration::from_secs(5)))
+            .await
+            .unwrap_err();
+        assert!(list.to_string().contains(expected), "{list:#}");
+        let get = client
+            .get_prompt(
+                rmcp::model::GetPromptRequestParams::new(""),
+                Some(Duration::from_secs(5)),
+            )
+            .await
+            .unwrap_err();
+        assert!(get.to_string().contains(expected), "{get:#}");
+        client.shutdown().await;
+    }
+    Ok(())
+}
