+        .await
+        .expect("unrelated teardown failure must not become a managed process failure");
+}
+
+#[tokio::test]
+async fn managed_process_shutdown_waits_for_members_and_reports_failure() {
+    let runtime = LocalAgentRuntime::new(
+        Weak::default(),
+        default_thread_id_generator(),
+        /*rollout_budget*/ None,
+    );
+    let member = runtime.admit_start().expect("admit teardown member");
+    let shutdown = runtime.request_shutdown();
+    let result = shutdown.wait_for_managed_process_shutdown();
+    tokio::pin!(result);
+    assert!(futures::poll!(result.as_mut()).is_pending());
+
+    runtime.record_managed_process_shutdown_failure();
+    drop(member);
+
+    result.await.expect_err("managed process shutdown failed");
+    shutdown
+        .wait()
+        .await
+        .expect_err("tree shutdown also failed");
 }
