+// The receipt revision belongs to native history, not to the model's instructions.
+// Normalize only SDK-tagged parts on the request copy; retain IDs and occurrence
+// metadata so provider history can still map each item to its canonical source.
+fn normalize_sdk_application_instruction_revisions(items: &mut [ResponseItem]) {
+    for item in items {
+        let ResponseItem::Message {
+            role,
+            content,
+            internal_chat_message_metadata_passthrough: Some(metadata),
+            ..
+        } = item
+        else {
+            continue;
+        };
+        let Some(kinds) = &metadata.content_item_kinds else {
+            continue;
+        };
+        if role != "developer" || kinds.len() != content.len() {
+            continue;
+        }
+        for (part, kind) in content.iter_mut().zip(kinds) {
+            if !matches!(
+                kind.0.as_str(),
+                "sdk_application.accepted" | "sdk_application.instructions"
+            ) {
+                continue;
+            }
+            let ContentItem::InputText { text } = part else {
+                continue;
+            };
+            if let Some((revision, body)) = text
+                .strip_prefix(
+                    "<application_instructions>Native instruction revision: msg_sdk_application_",
+                )
+                .and_then(|text| text.split_once('\n'))
+                && uuid::Uuid::try_parse(revision).is_ok()
+                && body.ends_with("</application_instructions>")
+            {
+                *text = format!("<application_instructions>{body}");
+            }
+        }
+    }
+}
