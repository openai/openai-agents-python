+#[test]
+fn sdk_instruction_request_formatting_preserves_caller_lookalikes() {
+    let model = model_info_from_slug("gpt-5.4");
+    for (role, kinds) in [
+        ("developer", serde_json::json!(["caller.instructions"])),
+        ("developer", serde_json::json!(null)),
+        (
+            "developer",
+            serde_json::json!(["sdk_application.instructions"]),
+        ),
+        (
+            "developer",
+            serde_json::json!(["sdk_application.instructions", "other"]),
+        ),
+        ("user", serde_json::json!(["sdk_application.instructions"])),
+    ] {
+        let item: ResponseItem = serde_json::from_value(serde_json::json!({
+            "type": "message", "role": role,
+            "content": [{"type": "input_text", "text": "<application_instructions>Native instruction revision: msg_sdk_application_caller\nCaller text</application_instructions>"}],
+            "internal_chat_message_metadata_passthrough": {"content_item_kinds": kinds}
+        })).unwrap();
+        let prompt = Prompt {
+            input: vec![item.clone()],
+            ..Default::default()
+        };
+        assert_eq!(prompt.get_formatted_input_for_request(&model), vec![item]);
+    }
+}
