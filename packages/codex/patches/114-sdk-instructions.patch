+#[test]
+fn sdk_application_instruction_request_text_is_stable_without_rewriting_receipts() {
+    let model = model_info_from_slug("gpt-5.4");
+    for kind in ["sdk_application.accepted", "sdk_application.instructions"] {
+        let mut projected = Vec::new();
+        for revision in [
+            "00000000-0000-7000-8000-000000000001",
+            "00000000-0000-7000-8000-000000000002",
+        ] {
+            let id = format!("msg_sdk_application_{revision}");
+            let text = format!(
+                "<application_instructions>Native instruction revision: {id}\nThe following application instructions replace all earlier application instructions. An empty value clears them.\nAnswer.\nNative instruction revision: caller text</application_instructions>"
+            );
+            let item: ResponseItem = serde_json::from_value(serde_json::json!({
+                "type": "message", "id": id, "role": "developer",
+                "content": [{"type": "input_text", "text": text}],
+                "internal_chat_message_metadata_passthrough": {"content_item_kinds": [kind]}
+            }))
+            .unwrap();
+            let prompt = Prompt {
+                input: vec![item.clone()],
+                ..Default::default()
+            };
+            let formatted = prompt.get_formatted_input_for_request(&model);
+            assert_eq!(prompt.input, vec![item.clone()]);
+            assert_eq!(formatted[0].id(), item.id());
+            let ResponseItem::Message {
+                content,
+                internal_chat_message_metadata_passthrough,
+                ..
+            } = &formatted[0]
+            else {
+                panic!("expected message");
+            };
+            let ResponseItem::Message {
+                internal_chat_message_metadata_passthrough: original_metadata,
+                ..
+            } = &item
+            else {
+                panic!("expected message");
+            };
+            assert_eq!(
+                internal_chat_message_metadata_passthrough,
+                original_metadata
+            );
+            assert_eq!(content, &[ContentItem::InputText { text: "<application_instructions>The following application instructions replace all earlier application instructions. An empty value clears them.\nAnswer.\nNative instruction revision: caller text</application_instructions>".into() }]);
+            projected.push(content.clone());
+        }
+        assert_eq!(projected[0], projected[1]);
+    }
+}
