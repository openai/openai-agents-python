 impl ConfigLayerStack {
+    /// Rebind only the empty sources produced by the isolated SDK loader.
+    /// Configured/managed layers and hooks always keep the ordinary loader path.
+    pub fn rebind_isolated_sdk_sources(
+        mut self,
+        home: &AbsolutePathBuf,
+        system_config: &AbsolutePathBuf,
+    ) -> Option<Self> {
+        if self.cloud_config_binding.is_some()
+            || self.requirements != ConfigRequirements::default()
+            || self.requirements_toml != ConfigRequirementsToml::default()
+            || !self.ignore_user_and_project_exec_policy_rules
+            || self.startup_warnings.as_ref().is_some_and(|v| !v.is_empty())
+        {
+            return None;
+        }
+        let (mut packaged, mut system, mut user, mut flags) = (0, 0, 0, 0);
+        for layer in Arc::make_mut(&mut self.layers) {
+            if layer.disabled_reason.is_some() || layer.hooks_config_folder_override.is_some() {
+                return None;
+            }
+            match &mut layer.name {
+                ConfigLayerSource::PackagedDefaults { file } => {
+                    packaged += 1;
+                    let raw = layer.raw_toml.as_mut()?;
+                    if raw.contents != include_str!("../defaults.toml") {
+                        return None;
+                    }
+                    raw.base_dir = home.clone();
+                    *file = AbsolutePathBuf::from_absolute_path(std::env::current_exe().ok()?).ok()?;
+                }
+                ConfigLayerSource::System { file } => {
+                    system += 1;
+                    if !layer.config.as_table()?.is_empty() || layer.raw_toml.is_some() {
+                        return None;
+                    }
+                    *file = system_config.clone();
+                }
+                ConfigLayerSource::User { file, profile } => {
+                    user += 1;
+                    if profile.is_some() || !layer.config.as_table()?.is_empty() || layer.raw_toml.is_some() {
+                        return None;
+                    }
+                    *file = home.join("config.toml");
+                }
+                ConfigLayerSource::SessionFlags => {
+                    flags += 1;
+                    if layer.raw_toml.is_some() { return None; }
+                }
+                _ => return None,
+            }
+        }
+        (packaged == 1 && system == 1 && user == 1 && flags == 1).then_some(self)
+    }
+
