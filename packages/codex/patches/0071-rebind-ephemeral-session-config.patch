+//! Narrow prepared configuration for isolated SDK memory sessions.
+use super::*;
+
+#[derive(Clone)]
+pub struct SdkEphemeralConfigBindings {
+    pub home: AbsolutePathBuf,
+    pub cwd: AbsolutePathBuf,
+    pub system_config: AbsolutePathBuf,
+}
+
+#[derive(Clone)]
+pub struct SdkEphemeralConfigTemplate {
+    config: Config,
+    openai_base_url: Option<String>,
+}
+
+impl SdkEphemeralConfigTemplate {
+    /// Caller must first establish the SDK recipe; this checks only relocation preconditions.
+    pub fn capture(config: &Config, bindings: &SdkEphemeralConfigBindings) -> Option<Self> {
+        if config.codex_home != bindings.home
+            || config.cwd != bindings.cwd
+            || config.workspace_roots_explicit
+            || config.workspace_roots != vec![bindings.cwd.clone()]
+            || config.permissions.workspace_roots() != [bindings.cwd.clone()]
+            || config.permissions.active_permission_profile().is_some_and(|profile| {
+                profile != ActivePermissionProfile::read_only()
+            })
+            || !config.permissions.profile_workspace_roots().is_empty()
+            || config.permissions.managed_deny_read_policy.is_some()
+            || config.permissions.legacy_sandbox_policy(bindings.cwd.as_path())
+                != SandboxPolicy::new_read_only_policy()
+            || config.permissions.file_system_sandbox_policy().entries.iter().any(|entry| {
+                matches!(&entry.path, FileSystemPath::Path { .. })
+            })
+            || !config.startup_warnings.is_empty()
+            || config.log_dir != bindings.home.join("log").to_path_buf()
+            || std::env::var_os(codex_state::SQLITE_HOME_ENV).is_some()
+            || config.model_provider_id != "native_agent"
+            || config.model_provider.http_headers.as_ref().is_some_and(|v| !v.is_empty())
+            || config.model_provider.env_http_headers.as_ref().is_some_and(|v| !v.is_empty())
+            || config.model_provider.experimental_bearer_token.is_some()
+            || config.model_provider.env_key.is_some()
+            || config.model_provider.auth.is_some()
+            || config.model_provider.gateway_oauth.is_some()
+            || config.model_provider.aws.is_some()
+        {
+            return None;
+        }
+        let mut config = config.clone();
+        config.config_layer_stack = config.config_layer_stack.rebind_isolated_sdk_sources(
+            &bindings.home, &bindings.system_config,
+        )?;
+        let openai_base_url = config.model_providers.get("openai")?.base_url.clone();
+        // Do not retain ambient OSS provider URLs between openings.
+        config.model_providers.retain(|name, _| name == "native_agent");
+        Some(Self { config, openai_base_url })
+    }
+
+    /// The same typed path constructor serves fresh and cached configurations.
+    pub fn bind(&self, bindings: &SdkEphemeralConfigBindings) -> Option<Config> {
+        if std::env::var_os(codex_state::SQLITE_HOME_ENV).is_some() {
+            return None;
+        }
+        let mut config = self.config.clone();
+        config.config_layer_stack = config.config_layer_stack.rebind_isolated_sdk_sources(
+            &bindings.home, &bindings.system_config,
+        )?;
+        bind_isolated_sdk_runtime_paths(&mut config, bindings);
+        // The SDK recipe has no explicit zsh override; resource presence remains live.
+        config.zsh_path = InstallContext::current().bundled_zsh_path()
+            .map(AbsolutePathBuf::into_path_buf);
+        config.model_providers = built_in_model_providers(self.openai_base_url.clone());
+        config.model_providers.insert(config.model_provider_id.clone(), config.model_provider.clone());
+        Some(config)
+    }
+}
+
+pub(super) struct RuntimePaths {
+    pub(super) home: AbsolutePathBuf,
+    pub(super) cwd: AbsolutePathBuf,
+    pub(super) workspace_roots: Vec<AbsolutePathBuf>,
+    pub(super) log_dir: PathBuf,
+}
+
+impl RuntimePaths {
+    pub(super) fn new(home: &AbsolutePathBuf, cwd: &AbsolutePathBuf) -> Self {
+        Self { home: home.clone(), cwd: cwd.clone(), workspace_roots: vec![cwd.clone()],
+               log_dir: home.join("log").to_path_buf() }
+    }
+}
+
+fn bind_isolated_sdk_runtime_paths(config: &mut Config, bindings: &SdkEphemeralConfigBindings) {
+    let paths = RuntimePaths::new(&bindings.home, &bindings.cwd);
+    config.codex_home = paths.home;
+    config.cwd = paths.cwd;
+    config.workspace_roots = paths.workspace_roots;
+    config.permissions.set_workspace_roots(config.workspace_roots.clone());
+    config.sqlite = codex_state::SqliteConfig::from_sqlite_home(bindings.home.clone());
+    config.log_dir = paths.log_dir;
+}
+
+#[cfg(all(test, target_os = "linux"))]
+mod tests {
+    use super::*;
+
+    fn bindings(root: &Path, name: &str) -> SdkEphemeralConfigBindings {
+        let home = AbsolutePathBuf::from_absolute_path(root.join(name)).unwrap();
+        std::fs::create_dir_all(home.join("workspace")).unwrap();
+        SdkEphemeralConfigBindings { cwd: home.join("workspace"), system_config: home.join("empty-system"), home }
+    }
+
+    fn fresh(paths: &SdkEphemeralConfigBindings) -> Config {
+        let runtime = tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap();
+        runtime.block_on(async {
+            ConfigBuilder::default()
+                .codex_home(paths.home.to_path_buf())
+                .harness_overrides(ConfigOverrides { cwd: Some(paths.cwd.to_path_buf()), ephemeral: Some(true), ..Default::default() })
+                .loader_overrides(LoaderOverrides {
+                    system_config_path: Some(paths.system_config.to_path_buf()),
+                    managed_config_path: Some(paths.home.join("empty-managed").to_path_buf()),
+                    system_requirements_path: Some(paths.home.join("empty-requirements").to_path_buf()),
+                    ignore_managed_requirements: true, ignore_login_requirements: true,
+                    ignore_user_config: true, ignore_project_config: true,
+                    ignore_user_and_project_exec_policy_rules: true,
+                    ..LoaderOverrides::default()
+                })
+                .cli_overrides(vec![
+                    ("model_provider".into(), toml::Value::String("native_agent".into())),
+                    ("openai_base_url".into(), toml::Value::String("https://api.openai.com/v1".into())),
+                    ("model_providers.native_agent".into(), toml::toml! {
+                        name = "SDK test provider"
+                        base_url = "http://127.0.0.1:1/v1"
+                        wire_api = "responses"
+                        requires_openai_auth = true
+                    }.into()),
+                ]).build().await.unwrap()
+        })
+        // Runtime drop joins its file workers before the isolated child changes env.
+    }
+
+    #[test]
+    fn prepared_sdk_config_preserves_fresh_paths_and_ambient_builtin_providers() {
+        const CHILD: &str = "CODEX_SDK_TEMPLATE_TEST_CHILD";
+        if std::env::var_os(CHILD).is_none() {
+            let output = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", "config::sdk_ephemeral::tests::prepared_sdk_config_preserves_fresh_paths_and_ambient_builtin_providers", "--nocapture", "--test-threads=1"])
+                .env(CHILD, "1").env_remove(codex_state::SQLITE_HOME_ENV)
+                .env("CODEX_OSS_PORT", "46321").env_remove("CODEX_OSS_BASE_URL")
+                .output().unwrap();
+            assert!(output.status.success(), "{}\n{}", String::from_utf8_lossy(&output.stdout), String::from_utf8_lossy(&output.stderr));
+            return;
+        }
+        let root = tempfile::tempdir().unwrap();
+        let first = bindings(root.path(), "first");
+        let second = bindings(root.path(), "second");
+        let original = fresh(&first);
+        assert_eq!(original.permissions.active_permission_profile(), Some(ActivePermissionProfile::read_only()));
+        let template = SdkEphemeralConfigTemplate::capture(&original, &first).expect("ordinary recipe is cacheable");
+        std::fs::remove_dir_all(first.home.as_path()).unwrap();
+        // Isolated single-test child; no Tokio runtime or its workers remain live.
+        unsafe { std::env::set_var("CODEX_OSS_PORT", "46322"); }
+        let bound = template.bind(&second).unwrap();
+        let expected = fresh(&second);
+        assert_eq!(bound.cwd, expected.cwd);
+        assert_eq!(bound.codex_home, expected.codex_home);
+        assert_eq!(bound.workspace_roots, expected.workspace_roots);
+        assert_eq!(bound.permissions.workspace_roots(), expected.permissions.workspace_roots());
+        assert_eq!(bound.permissions.permission_profile(), expected.permissions.permission_profile());
+        assert_eq!(bound.permissions.effective_permission_profile(), expected.permissions.effective_permission_profile());
+        assert_eq!(bound.permissions.active_permission_profile(), expected.permissions.active_permission_profile());
+        assert_eq!(bound.log_dir, expected.log_dir);
+        assert_eq!(bound.zsh_path, expected.zsh_path);
+        assert_eq!(bound.sqlite.home(), expected.sqlite.home());
+        assert_eq!(bound.config_layer_stack, expected.config_layer_stack);
+        assert_eq!(bound.startup_warnings, expected.startup_warnings);
+        assert_eq!(bound.model_provider_id, expected.model_provider_id);
+        for (name, provider) in &expected.model_providers {
+            assert_eq!(serde_json::to_value(&bound.model_providers[name]).unwrap(), serde_json::to_value(provider).unwrap());
+        }
+        assert_ne!(original.model_providers["ollama"].base_url, bound.model_providers["ollama"].base_url);
+        assert!(!first.home.as_path().exists());
+        let third = bindings(root.path(), "third");
+        let sibling = template.bind(&third).unwrap();
+        assert_ne!(sibling.cwd, bound.cwd);
+        assert_ne!(sibling.config_layer_stack, bound.config_layer_stack);
+        for profile in [
+            ActivePermissionProfile::new("custom-read-only"),
+            ActivePermissionProfile {
+                extends: Some("custom-parent".into()),
+                ..ActivePermissionProfile::read_only()
+            },
+        ] {
+            let mut rejected = expected.clone();
+            rejected.permissions.set_permission_profile_from_session_snapshot(
+                PermissionProfileSnapshot::active(PermissionProfile::read_only(), profile),
+            ).unwrap();
+            assert!(SdkEphemeralConfigTemplate::capture(&rejected, &second).is_none());
+        }
+        let mut legacy = expected.clone();
+        legacy.permissions.set_permission_profile_from_session_snapshot(
+            PermissionProfileSnapshot::legacy(PermissionProfile::read_only()),
+        ).unwrap();
+        assert!(SdkEphemeralConfigTemplate::capture(&legacy, &second).is_some());
+        let mut rejected = expected.clone();
+        rejected.startup_warnings.push("fresh warning must retain full load".into());
+        assert!(SdkEphemeralConfigTemplate::capture(&rejected, &second).is_none());
+        rejected = expected;
+        rejected.workspace_roots_explicit = true;
+        assert!(SdkEphemeralConfigTemplate::capture(&rejected, &second).is_none());
+        unsafe { std::env::set_var(codex_state::SQLITE_HOME_ENV, ""); }
+        assert!(template.bind(&second).is_none());
+        unsafe { std::env::remove_var(codex_state::SQLITE_HOME_ENV); }
+        assert!(template.bind(&second).is_some());
+    }
+}
