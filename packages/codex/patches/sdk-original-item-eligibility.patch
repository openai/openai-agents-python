+/// SDK originals omit native developer configuration without changing model context.
+/// Explicit SDK-original entries retain their admitted values independently of this native-row filter.
+pub(crate) fn is_sdk_original_item(
+    item: &ResponseItem,
+    metadata: Option<&CodexHarnessMetadata>,
+) -> bool {
+    if let ResponseItem::Message {
+        role,
+        internal_chat_message_metadata_passthrough: Some(message_metadata),
+        ..
+    } = item
+        && role == "developer"
+        && !metadata.is_some_and(|metadata| metadata.client_authored)
+        && message_metadata
+            .content_item_kinds
+            .as_ref()
+            .is_some_and(|kinds| {
+                kinds
+                    .iter()
+                    .any(|kind| !kind.0.is_empty() && kind.0 != "unknown")
+            })
+    {
+        return false;
+    }
+    is_api_message(item, metadata)
+}
