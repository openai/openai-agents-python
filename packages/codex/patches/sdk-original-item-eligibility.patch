+#[cfg(test)]
+mod sdk_original_eligibility_tests {
+    use super::*;
+    use serde_json::json;
+
+    fn message(role: &str, kind: Option<&str>) -> ResponseItem {
+        let mut value = json!({
+            "type": "message", "role": role,
+            "content": [{"type":"input_text", "text":"developer data"}],
+        });
+        if let Some(kind) = kind {
+            value["internal_chat_message_metadata_passthrough"] =
+                json!({"content_item_kinds":[kind]});
+        }
+        serde_json::from_value(value).unwrap()
+    }
+
+    #[test]
+    fn native_configuration_remains_in_model_context_but_not_sdk_originals() {
+        for kind in [
+            "collaboration_mode.instructions",
+            "sdk_application.accepted",
+        ] {
+            let item = message("developer", Some(kind));
+            assert!(is_api_message(&item, None));
+            assert!(!is_sdk_original_item(&item, None));
+        }
+    }
+
+    #[test]
+    fn caller_developer_and_ordinary_messages_remain_originals() {
+        let caller = CodexHarnessMetadata {
+            client_authored: true,
+            ..Default::default()
+        };
+        assert!(is_sdk_original_item(&message("developer", None), None));
+        assert!(is_sdk_original_item(
+            &message("developer", Some("unknown")),
+            None
+        ));
+        assert!(is_sdk_original_item(
+            &message("developer", Some("sdk_application.accepted")),
+            Some(&caller)
+        ));
+        assert!(is_sdk_original_item(
+            &message("user", Some("additional_content.user")),
+            None
+        ));
+        assert!(is_sdk_original_item(&message("assistant", None), None));
+        assert!(!is_sdk_original_item(&message("system", None), None));
+    }
+}
