+/// A separately captured opening permission for runtime-created application callbacks.
+/// The owner is the native thread, not any serialized profile or tool result.
+pub struct RuntimeHandoffCallbackPermission {
+    thread_id: String,
+}
+impl RuntimeHandoffCallbackPermission {
+    pub fn new(thread_id: String) -> Self {
+        Self { thread_id }
+    }
+    pub fn thread_id(&self) -> &str {
+        &self.thread_id
+    }
+}
+
+/// Exact application callbacks of an accepted live profile.
+#[derive(Clone)]
+pub struct AgentProfileRuntimeCallbacks {
+    pub permission: std::sync::Arc<RuntimeHandoffCallbackPermission>,
+    pub profile_id: String,
+    pub names: std::collections::HashSet<codex_tools::ToolName>,
+}
+
+/// The exact application executors constructed by the SDK for one captured step.
+#[derive(Clone)]
+pub struct RuntimeHandoffCallbackExecutors {
+    pub permission: std::sync::Arc<RuntimeHandoffCallbackPermission>,
+    pub receipt: AgentProfileReceipt,
+    pub executors:
+        Vec<std::sync::Arc<dyn for<'call> codex_tools::ToolExecutor<codex_tools::ToolCall<'call>>>>,
+}
