+    /// Automatic discovery preserves unchanged prepared calls and the explicit refresh fence.
+    pub(crate) async fn refresh_for_discovery<F, Fut>(&self, fetch: F) -> Result<()>
+    where
+        F: FnOnce() -> Fut,
+        Fut: Future<Output = Result<Vec<ToolInfo>>>,
+    {
+        let _refresh = self.refresh_lock.lock().await;
+        let tools = fetch().await?;
+        let (current, snapshot) = self.read_current().await;
+        if catalogs_match(&snapshot.tools, &tools) {
+            return Ok(());
+        }
+        drop(current);
+        let mut current = self.current.write().await;
+        match &mut current.source {
+            CatalogSource::Local(current_tools) => *current_tools = tools.into(),
+            CatalogSource::Live { .. } => {
+                anyhow::bail!("SDK fresh discovery requires an ordinary MCP client");
+            }
+        }
+        current.revision += 1;
+        Ok(())
+    }
