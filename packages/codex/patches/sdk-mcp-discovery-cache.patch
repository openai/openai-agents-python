     /// Returns all tools with model-visible names normalized.
+    pub(crate) async fn refresh_uncached_tool_catalogs(&self) -> Result<()> {
+        let refreshes = self
+            .servers
+            .iter()
+            .filter(|(_, view)| !view.cache_tools_list)
+            .map(|(server_name, view)| async move {
+                anyhow::ensure!(
+                    server_name != CODEX_APPS_MCP_SERVER_NAME,
+                    "SDK fresh discovery requires an ordinary MCP server"
+                );
+                view.connection.client.reconnect_failed_startup().await;
+                let client = view
+                    .connection
+                    .client()
+                    .await
+                    .with_context(|| format!("MCP discovery client unavailable: {server_name}"))?;
+                client
+                    .tool_catalog
+                    .refresh_for_discovery(|| async {
+                        list_tools_for_client_uncached(
+                            server_name,
+                            false,
+                            "sdk_discovery",
+                            &client.client,
+                            view.tool_timeout,
+                            view.catalog_item_limit,
+                            client.server_instructions.as_deref(),
+                        )
+                        .await
+                    })
+                    .await
+                    .with_context(|| format!("MCP discovery failed: {server_name}"))
+            });
+        for result in join_all(refreshes).await {
+            result?;
+        }
+        Ok(())
+    }
+
     pub async fn list_all_tools(&self) -> Vec<ToolInfo> {
         Box::pin(self.list_tools_with_errors(|_| true)).await.0
     }
