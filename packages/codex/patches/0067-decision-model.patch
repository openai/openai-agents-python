index 0000000000000000000000000000000000000000..bcfd3bee0b885b8bc30791711ce2d50078885a09
--- /dev/null
+++ b/codex-rs/core/src/client_decisions.rs
@@ -0,0 +1,633 @@
+//! Decisions inference uses the existing native admission, accounting, and tool loop.
+use super::*;
+use crate::client_common::{ResponseAttempt, ResponseAttempts};
+use codex_api::decisions::{DecisionAction, DecisionError, DecisionPlan};
+use codex_model_provider_info::DecisionModelOptions;
+use codex_protocol::ResponseUsageMetadata;
+use codex_protocol::protocol::{
+    ReceivedResponseUsage, ResponseObservation, ResponseObservationStatus, TokenUsage,
+};
+use serde_json::{Value, json};
+
+struct Completion {
+    id: String,
+    model: String,
+    usage: Option<TokenUsage>,
+    metadata: ResponseUsageMetadata,
+    observation: ResponseObservation,
+}
+
+fn counter(value: Option<&Value>, required: bool) -> Result<i64> {
+    match value {
+        Some(value) => value
+            .as_i64()
+            .filter(|value| (0..=9_007_199_254_740_991).contains(value))
+            .ok_or_else(|| {
+                CodexErr::InvalidRequest("Decisions returned invalid token usage".into())
+            }),
+        None if !required => Ok(0),
+        None => Err(CodexErr::InvalidRequest(
+            "Decisions omitted required token usage".into(),
+        )),
+    }
+}
+
+fn completion(body: &Value, requested_model: &str) -> Result<Completion> {
+    let reported_model = body
+        .get("model")
+        .and_then(Value::as_str)
+        .filter(|model| !model.trim().is_empty());
+    let model = reported_model.unwrap_or(requested_model).to_owned();
+    // Decisions has no response ID. Keep its local identity separate from x-request-id.
+    let id = format!("sdk_decision_{}", Uuid::new_v4());
+    let usage = match body.get("usage").filter(|value| !value.is_null()) {
+        None => None,
+        Some(raw) => {
+            let input = counter(raw.get("input_tokens"), true)?;
+            let output = counter(raw.get("output_tokens"), true)?;
+            let cached = counter(
+                raw.get("input_tokens_details")
+                    .and_then(|value| value.get("cached_tokens")),
+                false,
+            )?;
+            let cache_write = counter(
+                raw.get("input_tokens_details")
+                    .and_then(|value| value.get("cache_write_tokens")),
+                false,
+            )?;
+            let reasoning = counter(
+                raw.get("output_tokens_details")
+                    .and_then(|value| value.get("reasoning_tokens")),
+                false,
+            )?;
+            let total = counter(raw.get("total_tokens"), true)?;
+            if cached > input
+                || cache_write > input
+                || reasoning > output
+                || total != input + output
+            {
+                return Err(CodexErr::InvalidRequest(
+                    "Decisions returned inconsistent token usage".into(),
+                ));
+            }
+            Some(TokenUsage {
+                input_tokens: input,
+                cached_input_tokens: cached,
+                cache_write_input_tokens: cache_write,
+                output_tokens: output,
+                reasoning_output_tokens: reasoning,
+                total_tokens: total,
+                ..TokenUsage::default()
+            })
+        }
+    };
+    let observed_usage = usage.as_ref().map(|usage| ReceivedResponseUsage {
+        input_tokens: Some(usage.input_tokens),
+        cached_input_tokens: Some(usage.cached_input_tokens),
+        cache_write_input_tokens: Some(usage.cache_write_input_tokens),
+        output_tokens: Some(usage.output_tokens),
+        reasoning_output_tokens: Some(usage.reasoning_output_tokens),
+        total_tokens: Some(usage.total_tokens),
+    });
+    Ok(Completion {
+        observation: ResponseObservation {
+            response_id: Some(id.clone()),
+            status: ResponseObservationStatus::Completed,
+            incomplete_reason: None,
+            usage: observed_usage,
+        },
+        id,
+        model,
+        usage,
+        metadata: ResponseUsageMetadata {
+            amount: None,
+            metadata: Some(
+                json!({"decisions": {"model": reported_model, "answers": body.get("answers")}}),
+            ),
+        },
+    })
+}
+
+fn remember_attempt(
+    attempts: &ResponseAttempts,
+    id: &str,
+    model: &str,
+    observation: Option<Arc<crate::request_observation::RequestObservationContext>>,
+) {
+    attempts.lock().expect("response attempts poisoned").insert(
+        id.to_owned(),
+        ResponseAttempt {
+            model: model.to_owned(),
+            observation,
+        },
+    );
+}
+
+fn buffered_stream(
+    events: Vec<ResponseEvent>,
+    request_id: Option<String>,
+) -> codex_api::ResponseStream {
+    let (sender, receiver) = mpsc::channel(events.len().max(1));
+    for event in events {
+        sender
+            .try_send(Ok(event))
+            .expect("buffered Decisions response fits its channel");
+    }
+    codex_api::ResponseStream {
+        rx_event: receiver,
+        upstream_request_id: request_id,
+        interrupt: None,
+    }
+}
+
+fn decision_error(error: DecisionError, provider: &SharedModelProvider) -> CodexErr {
+    if error == DecisionError::Refusal {
+        provider.map_api_error(ApiError::ContentFilter)
+    } else {
+        CodexErr::InvalidRequest(error.to_string())
+    }
+}
+
+impl ModelClientSession {
+    #[allow(clippy::too_many_arguments)]
+    pub(super) async fn stream_decisions(
+        &self,
+        prompt: &Prompt,
+        model_info: &ModelInfo,
+        session_telemetry: &SessionTelemetry,
+        effort: Option<ReasoningEffortConfig>,
+        summary: ReasoningSummaryConfig,
+        service_tier: Option<String>,
+        responses_metadata: &CodexResponsesMetadata,
+        inference_trace: &InferenceTraceContext,
+        options: DecisionModelOptions,
+    ) -> Result<ResponseStream> {
+        options
+            .validate(&model_info.slug)
+            .map_err(CodexErr::InvalidRequest)?;
+        if model_info.use_responses_lite || self.client.state.session_source.is_non_root_agent() {
+            return Err(CodexErr::InvalidRequest(
+                "Decisions inference requires a direct root using standard Responses output".into(),
+            ));
+        }
+        let mut request = self.client.build_responses_request(
+            prompt,
+            model_info,
+            effort.clone(),
+            summary,
+            service_tier.clone(),
+            responses_metadata,
+            false,
+        )?;
+        self.client
+            .prepare_response_items_for_request(&mut request.input);
+        let mut decision_request = serde_json::to_value(&request)?;
+        for contributor in self.client.request_contributors.iter() {
+            contributor
+                .restore_decision_request(&mut decision_request, prompt.tool_admission.as_ref())
+                .await
+                .map_err(CodexErr::InvalidRequest)?;
+        }
+        let mut plan = DecisionPlan::new(&decision_request, options.min_route_probability)
+            .map_err(|error| decision_error(error, &self.client.state.provider))?;
+        let first = plan
+            .next()
+            .map_err(|error| decision_error(error, &self.client.state.provider))?;
+        if let DecisionAction::Handoff(reason) = &first
+            && options.fallback_model.is_none()
+        {
+            return Err(CodexErr::InvalidRequest(format!(
+                "Decisions inference requires an explicit fallback: {reason}"
+            )));
+        }
+        let client = self.client.clone();
+        let prompt = prompt.clone();
+        let model_info = model_info.clone();
+        let telemetry = session_telemetry.clone();
+        let metadata = responses_metadata.clone();
+        let trace = inference_trace.clone();
+        let attempts = ResponseAttempts::default();
+        let staged_attempts = Arc::clone(&attempts);
+        let stages = async_stream::stream! {
+            let mut action = first;
+            loop {
+                match action {
+                    DecisionAction::Questions(questions) => {
+                        let mut client_metadata = request.client_metadata.clone();
+                        let mut interceptors = Some(crate::model_request::prepare(
+                            &client.request_contributors,
+                            &client.state.thread_id.to_string(),
+                            &options.model,
+                            codex_extension_api::ModelRequestKind::Generation,
+                            &mut client_metadata,
+                            prompt.tool_admission.clone(),
+                        ));
+                        crate::model_request::wait_if_sampling_stopped(
+                            prompt.sampling_stop.as_deref(),
+                        )
+                        .await;
+                        if let Some(admission) = &prompt.prepared_request_admission {
+                            if let Err(error) = admission.admit_request() {
+                                yield Err(CodexErr::Fatal(error));
+                                break;
+                            }
+                        }
+                        if let Err(error) = crate::model_request::admit_request(
+                            interceptors.as_ref().expect("active decision interceptors"),
+                        ) {
+                            yield Err(CodexErr::InvalidRequest(error));
+                            break;
+                        }
+                        let setup =
+                            match client.current_client_setup(ClientRouting::Workspace).await {
+                                Ok(setup) => setup,
+                                Err(error) => {
+                                    yield Err(error);
+                                    break;
+                                }
+                            };
+                        if setup
+                            .auth
+                            .as_ref()
+                            .is_some_and(CodexAuth::uses_codex_backend)
+                        {
+                            yield Err(CodexErr::InvalidRequest(
+                                "Decisions inference requires API-key provider authentication".into(),
+                            ));
+                            break;
+                        }
+                        let url = setup.api_provider.url_for_path("/decisions");
+                        let mut dispatchers = client
+                            .request_contributors
+                            .iter()
+                            .filter_map(|contributor| contributor.http_stream(&url));
+                        let direct = dispatchers.next();
+                        if dispatchers.next().is_some() {
+                            yield Err(CodexErr::Fatal(
+                                "Multiple model HTTP dispatchers claimed the route".into(),
+                            ));
+                            break;
+                        }
+                        let private_dispatch = direct.is_some();
+                        let physical = if private_dispatch {
+                            None
+                        } else {
+                            match client.build_api_transport(
+                                &setup.api_provider,
+                                "/decisions",
+                                setup.redirect_policy,
+                            ) {
+                                Ok(transport) => Some(transport),
+                                Err(error) => {
+                                    yield Err(error);
+                                    break;
+                                }
+                            }
+                        };
+                        let transport = ModelResponsesTransport {
+                            direct,
+                            fallback: || {
+                                physical.clone().ok_or_else(|| {
+                                    codex_client::TransportError::Build(
+                                        "Claimed Decisions route cannot fall back to I/O".into(),
+                                    )
+                                })
+                            },
+                            defaults: codex_login::default_client::default_headers(),
+                        };
+                        let auth_context = AuthRequestTelemetryContext::new(
+                            setup.auth.as_ref().map(CodexAuth::auth_mode),
+                            setup.api_auth.as_ref(),
+                            setup.agent_identity_telemetry.clone(),
+                            PendingUnauthorizedRetry::default(),
+                        );
+                        let (request_telemetry, _) = Self::build_streaming_telemetry(
+                            &telemetry,
+                            auth_context,
+                            RequestRouteTelemetry::for_endpoint("/decisions"),
+                            client.state.auth_env_telemetry.clone(),
+                        );
+                        let mut headers =
+                            client.responses_headers(setup.auth.as_ref(), &options.model);
+                        headers.extend(build_session_headers(
+                            Some(metadata.session_id.clone()),
+                            Some(metadata.thread_id.clone()),
+                        ));
+                        let attempt = trace.start_attempt();
+                        attempt.add_request_headers(&mut headers);
+                        let mut body = json!({"model": options.model, "input": plan.input(), "questions": questions});
+                        if let Some(key) = &request.prompt_cache_key {
+                            body["prompt_cache_key"] = json!(key);
+                        }
+                        attempt.record_started(&body);
+                        if private_dispatch {
+                            body["client_metadata"] = json!(client_metadata);
+                        }
+                        let observation = crate::request_observation::dispatching(
+                            prompt.tool_admission.as_ref(),
+                            &options.model,
+                            None,
+                            None,
+                            codex_extension_api::ModelRequestWire::Decisions,
+                            codex_extension_api::ModelRequestTransport::HttpJson,
+                        );
+                        let api = codex_api::DecisionsClient::new(
+                            crate::model_request::SamplingStopTransport {
+                                inner: transport,
+                                stop: prompt.sampling_stop.clone(),
+                            },
+                            setup.api_provider,
+                            setup.api_auth,
+                        )
+                        .with_telemetry(Some(request_telemetry));
+                        let response = match api.create(body, headers).await {
+                            Ok(response) => response,
+                            Err(error) => {
+                                attempt.record_failed(&error, None, &[]);
+                                yield Err(client.state.provider.map_api_error(error));
+                                break;
+                            }
+                        };
+                        let completed = match completion(&response.body, &options.model) {
+                            Ok(completed) => completed,
+                            Err(error) => {
+                                attempt.record_failed(&error, response.request_id.as_deref(), &[]);
+                                yield Err(error);
+                                break;
+                            }
+                        };
+                        remember_attempt(
+                            &staged_attempts,
+                            &completed.id,
+                            &completed.model,
+                            observation,
+                        );
+                        let next = response
+                            .body
+                            .get("answers")
+                            .and_then(Value::as_array)
+                            .ok_or(DecisionError::InvalidAnswer)
+                            .and_then(|answers| plan.accept(answers));
+                        let mut output = None;
+                        let next = match next {
+                            Ok(DecisionAction::Output(value)) => {
+                                match serde_json::from_value::<ResponseItem>(value) {
+                                    Ok(item) => {
+                                        output = Some(item);
+                                        Ok(None)
+                                    }
+                                    Err(_) => Err(DecisionError::InvalidAnswer),
+                                }
+                            }
+                            Ok(action) => Ok(Some(action)),
+                            Err(error) => Err(error),
+                        };
+                        attempt.record_completed(
+                            &completed.id,
+                            response.request_id.as_deref(),
+                            &completed.usage,
+                            output.as_slice(),
+                        );
+                        if let Some(usage) = &completed.usage {
+                            telemetry.sse_event_completed(usage, None);
+                        }
+                        let final_response = output.is_some();
+                        let response_id = completed.id.clone();
+                        yield Ok(ResponseEvent::IntermediateCompleted {
+                            observation: completed.observation,
+                            model: completed.model,
+                            final_response,
+                            response_id: completed.id,
+                            token_usage: completed.usage,
+                            usage_metadata: Some(completed.metadata),
+                        });
+                        if let Some(output) = output {
+                            // Account for the physical response before any output policy can reject it.
+                            crate::model_request::wait_if_sampling_stopped(
+                                prompt.sampling_stop.as_deref(),
+                            )
+                            .await;
+                            if let Err(error) = crate::model_request::admit_request(
+                                interceptors.as_ref().expect("active decision interceptors"),
+                            ) {
+                                yield Err(CodexErr::InvalidRequest(error));
+                                break;
+                            }
+                            let end_turn = matches!(output, ResponseItem::Message { .. });
+                            let stream = buffered_stream(
+                                vec![
+                                    ResponseEvent::Created {
+                                        response_id: Some(response_id.clone()),
+                                    },
+                                    ResponseEvent::OutputItemDone(output),
+                                    ResponseEvent::Completed {
+                                        response_id,
+                                        token_usage: None,
+                                        usage_metadata: None,
+                                        end_turn: Some(end_turn),
+                                    },
+                                ],
+                                response.request_id,
+                            );
+                            let (mut stream, _) = map_response_stream(
+                                stream,
+                                telemetry.clone(),
+                                InferenceTraceAttempt::disabled(),
+                                Arc::clone(&client.state.provider),
+                                interceptors.take().expect("active decision interceptors"),
+                            );
+                            while let Some(event) = stream.next().await {
+                                yield event;
+                            }
+                            break;
+                        }
+                        match next {
+                            Ok(Some(next)) => action = next,
+                            Err(error) => {
+                                yield Err(decision_error(error, &client.state.provider));
+                                break;
+                            }
+                            Ok(None) => unreachable!("a final decision has an output item"),
+                        }
+                    }
+                    DecisionAction::Handoff(reason) => {
+                        if options.fallback_model.is_none() {
+                            yield Err(CodexErr::InvalidRequest(format!(
+                                "Decisions inference requires an explicit fallback: {reason}"
+                            )));
+                            break;
+                        }
+                        let session = client.new_session();
+                        let mut recovery = RequestAuthRecovery::new(&client.state.provider);
+                        let fallback = session
+                            .stream_responses_api(
+                                &prompt,
+                                &model_info,
+                                &telemetry,
+                                effort.clone(),
+                                summary,
+                                service_tier.clone(),
+                                &metadata,
+                                &trace,
+                                &mut recovery,
+                            )
+                            .await;
+                        match fallback {
+                            Ok(mut stream) => {
+                                while let Some(event) = stream.next().await {
+                                    if let Ok(ResponseEvent::ResponseObserved(observed)) = &event {
+                                        if let Some(id) = &observed.response_id {
+                                            remember_attempt(
+                                                &staged_attempts,
+                                                id,
+                                                &model_info.slug,
+                                                stream.request_observation.clone(),
