+#[tokio::test]
+async fn dropping_accounting_stage_retires_producer_before_next_request() {
+    use codex_protocol::protocol::{ResponseObservation, ResponseObservationStatus, TokenUsage};
+    use futures::StreamExt;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use tokio::sync::Notify;
+
+    struct ProducerDrop(Arc<Notify>);
+    impl Drop for ProducerDrop {
+        fn drop(&mut self) {
+            self.0.notify_one();
+        }
+    }
+
+    let retired = Arc::new(Notify::new());
+    let advanced = Arc::new(AtomicUsize::new(0));
+    let producer_retired = retired.clone();
+    let producer_advanced = advanced.clone();
+    let stages = async_stream::stream! {
+        let _guard = ProducerDrop(producer_retired);
+        yield Ok(ResponseEvent::IntermediateCompleted {
+            observation: ResponseObservation {
+                response_id: Some("route_before_fill".into()),
+                status: ResponseObservationStatus::Completed,
+                incomplete_reason: None,
+                usage: None,
+            },
+            model: "decision-test".into(),
+            final_response: false,
+            response_id: "route_before_fill".into(),
+            token_usage: Some(TokenUsage::default()),
+            usage_metadata: None,
+        });
+        producer_advanced.fetch_add(1, Ordering::SeqCst);
+        yield Ok(ResponseEvent::Created { response_id: Some("fill_must_not_start".into()) });
+    };
+    let mut stream = ResponseStream::from_stages(stages, Default::default());
+    assert!(matches!(
+        stream.next().await,
+        Some(Ok(ResponseEvent::IntermediateCompleted { .. }))
+    ));
+    drop(stream);
+    tokio::time::timeout(std::time::Duration::from_secs(5), retired.notified())
+        .await
+        .expect("dropping the stream must retire the producer");
+    assert_eq!(advanced.load(Ordering::SeqCst), 0);
+}
