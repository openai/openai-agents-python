+impl ResponseStream {
+    /// Polls each stage only after Core has retained the preceding response accounting.
+    pub(crate) fn from_stages(
+        stages: impl Stream<Item = Result<ResponseEvent>> + Send + 'static,
+        attempts: ResponseAttempts,
+    ) -> Self {
+        use futures::StreamExt;
+        let (tx_event, rx_event) = mpsc::channel(1);
+        let consumer_dropped = CancellationToken::new();
+        let dropped = consumer_dropped.clone();
+        let observation_processed = Arc::new(Notify::new());
+        let processed = Arc::clone(&observation_processed);
+        tokio::spawn(async move {
+            let mut stages = Box::pin(stages);
+            loop {
+                let event = tokio::select! {
+                    biased;
+                    _ = dropped.cancelled() => break,
+                    event = stages.next() => event,
+                };
+                let Some(event) = event else { break };
+                let accounting = matches!(
+                    &event,
+                    Ok(ResponseEvent::ResponseObserved(_)
+                        | ResponseEvent::IntermediateCompleted { .. })
+                );
+                let failed = event.is_err();
+                if tx_event.send(event).await.is_err() {
+                    break;
+                }
+                if accounting {
+                    tokio::select! {
+                        biased;
+                        _ = dropped.cancelled() => break,
+                        _ = processed.notified() => {}
+                    }
+                }
+                if failed {
+                    break;
+                }
+            }
+        });
+        Self {
+            observation_processed,
+            observation_pending: false,
+            request_observation: None,
+            attempts,
+            rx_event,
+            interrupt: None,
+            consumer_dropped,
+        }
+    }
+}
