+//! Bounded adaptation of a Responses request to Decisions questions.
+//!
+//! This module never sends requests or executes tools. Unsupported routes remain
+//! selectable, and only route selection can request a generative handoff.
+use serde_json::{Map, Value, json};
+use std::collections::HashMap;
+use std::collections::HashSet;
+
+#[derive(Debug, thiserror::Error, PartialEq)]
+pub enum DecisionError {
+    #[error("unsupported Decisions input")]
+    UnsupportedInput,
+    #[error("invalid Decisions request configuration")]
+    InvalidRequest,
+    #[error("invalid Decisions answer")]
+    InvalidAnswer,
+    #[error("Decisions refused a question")]
+    Refusal,
+    #[error("invalid Decisions plan state")]
+    InvalidState,
+}
+
+#[derive(Debug, PartialEq)]
+pub enum DecisionAction {
+    Questions(Vec<Value>),
+    Output(Value),
+    Handoff(String),
+}
+
+#[derive(Debug)]
+pub struct DecisionPlan {
+    input: Vec<Value>,
+    routes: Vec<Route>,
+    threshold: Option<f64>,
+    state: State,
+}
+
+#[derive(Debug)]
+struct Route {
+    name: Option<String>,
+    namespace: Option<String>,
+    description: String,
+    schema: Option<Node>,
+}
+
+#[derive(Debug)]
+enum State {
+    New,
+    Routing(Vec<Value>),
+    Filling { route: usize, questions: Vec<Value> },
+    Done,
+}
+
+#[derive(Debug)]
+enum Node {
+    Constant(Value),
+    Object(Vec<(String, Node)>),
+    Field { question: Value, kind: FieldKind },
+}
+
+#[derive(Debug)]
+enum FieldKind {
+    Boolean,
+    Probability,
+    Choice(Vec<Value>),
+    Score { minimum: f64, width: usize },
+}
+
+impl DecisionPlan {
+    pub fn new(request: &Value, min_route_probability: Option<f64>) -> Result<Self, DecisionError> {
+        if min_route_probability.is_some_and(|v| !unit(v)) {
+            return Err(DecisionError::InvalidRequest);
+        }
+        let input = normalize_input(request)?;
+        let choice = request.get("tool_choice").unwrap_or(&Value::Null);
+        let mode = choice.as_str().unwrap_or("auto");
+        if (!choice.is_null() && !choice.is_string() && !choice.is_object())
+            || !matches!(mode, "auto" | "none" | "required")
+        {
+            return Err(DecisionError::InvalidRequest);
+        }
+        let forced = if choice.is_object() {
+            if choice["type"] != "function"
+                || choice["name"].as_str().is_none_or(str::is_empty)
+                || choice
+                    .get("namespace")
+                    .is_some_and(|v| !v.is_null() && v.as_str().is_none_or(str::is_empty))
+            {
+                return Err(DecisionError::InvalidRequest);
+            }
+            Some((&choice["name"], choice.get("namespace")))
+        } else {
+            None
+        };
+        let mut routes = Vec::new();
+        if mode != "required" && forced.is_none() {
+            let format = &request["text"]["format"];
+            let schema = if format["type"] == "json_schema" {
+                compile(&format["schema"])
+            } else {
+                None
+            };
+            routes.push(Route {
+                name: None,
+                namespace: None,
+                description: "Return the final answer to the user".into(),
+                schema,
+            });
+        }
+        if mode != "none" {
+            let tools = match request.get("tools") {
+                None => &[][..],
+                Some(v) => v
+                    .as_array()
+                    .ok_or(DecisionError::InvalidRequest)?
+                    .as_slice(),
+            };
+            for tool in tools {
+                if tool["type"] == "namespace" {
+                    let namespace = tool["name"].as_str().ok_or(DecisionError::InvalidRequest)?;
+                    let members = tool["tools"]
+                        .as_array()
+                        .ok_or(DecisionError::InvalidRequest)?;
+                    for member in members {
+                        add_tool(
+                            &mut routes,
+                            member,
+                            Some(namespace),
+                            tool["description"].as_str().unwrap_or(""),
+                            forced,
+                        )?;
+                    }
+                } else {
+                    add_tool(&mut routes, tool, None, "", forced)?;
+                }
+            }
+        }
+        if routes.is_empty() || routes.len() > 255 {
+            return Err(DecisionError::InvalidRequest);
+        }
+        let mut names = HashSet::new();
+        for route in &routes {
+            if !names.insert((route.namespace.clone(), route.name.clone())) {
+                return Err(DecisionError::InvalidRequest);
+            }
+        }
+        Ok(Self {
+            input,
+            routes,
+            threshold: min_route_probability,
+            state: State::New,
+        })
+    }
+
+    pub fn input(&self) -> &[Value] {
+        &self.input
+    }
+
+    pub fn next(&mut self) -> Result<DecisionAction, DecisionError> {
+        if !matches!(self.state, State::New) {
+            return Err(DecisionError::InvalidState);
+        }
+        if self.routes.iter().all(|r| r.schema.is_none()) {
+            self.state = State::Done;
+            return Ok(DecisionAction::Handoff(
+                "No route has a supported bounded schema".into(),
+            ));
+        }
+        if self.routes.len() == 1 {
+            return self.select(0);
+        }
+        let choices: Vec<Value> = self
+            .routes
+            .iter()
+            .enumerate()
+            .map(|(i, r)| json!({"value": format!("route_{i}"), "description": r.description}))
+            .collect();
+        let questions = vec![json!({"type":"choice", "name":"route", "instructions":
+            "Choose the next action. Select a function only when it is needed; otherwise return the final answer.",
+            "choices":choices})];
+        self.state = State::Routing(questions.clone());
+        Ok(DecisionAction::Questions(questions))
+    }
+
+    pub fn accept(&mut self, answers: &[Value]) -> Result<DecisionAction, DecisionError> {
+        // Consume the pending stage even when validation fails. An answer failure
+        // must never become a fallback or allow replay of partial field results.
+        let state = std::mem::replace(&mut self.state, State::Done);
+        match state {
+            State::Routing(questions) => {
+                validate_answers(&questions, answers)?;
+                let selected = answers[0]["choice"]
+                    .as_str()
+                    .ok_or(DecisionError::InvalidAnswer)?;
+                let index = (0..self.routes.len())
+                    .find(|i| selected == format!("route_{i}"))
+                    .ok_or(DecisionError::InvalidAnswer)?;
+                let probability = answers[0]["probabilities"]
+                    .as_array()
+                    .ok_or(DecisionError::InvalidAnswer)?
+                    .iter()
+                    .find(|p| p["value"] == selected)
+                    .and_then(|p| p["probability"].as_f64())
+                    .ok_or(DecisionError::InvalidAnswer)?;
+                if self
+                    .threshold
+                    .is_some_and(|threshold| probability < threshold)
+                {
+                    return Ok(DecisionAction::Handoff(
+                        "Selected route probability is below the configured threshold".into(),
+                    ));
+                }
+                self.select(index)
+            }
+            State::Filling { route, questions } => {
+                validate_answers(&questions, answers)?;
+                let schema = self.routes[route]
+                    .schema
+                    .as_ref()
+                    .ok_or(DecisionError::InvalidState)?;
+                let value = schema.fill(&mut answers.iter())?;
+                Ok(DecisionAction::Output(self.output(route, value)))
+            }
+            _ => Err(DecisionError::InvalidState),
+        }
+    }
+
+    fn select(&mut self, route: usize) -> Result<DecisionAction, DecisionError> {
+        let Some(schema) = self.routes[route].schema.as_ref() else {
+            self.state = State::Done;
+            return Ok(DecisionAction::Handoff(
+                "Selected route has an unsupported schema".into(),
+            ));
+        };
+        let mut questions = Vec::new();
+        schema.questions(&mut questions);
+        if questions.is_empty() {
+            let value = schema.fill(&mut [].iter())?;
+            self.state = State::Done;
+            return Ok(DecisionAction::Output(self.output(route, value)));
+        }
+        self.state = State::Filling {
+            route,
+            questions: questions.clone(),
+        };
+        Ok(DecisionAction::Questions(questions))
+    }
+
+    fn output(&self, route: usize, value: Value) -> Value {
+        let route = &self.routes[route];
+        if let Some(name) = &route.name {
+            let mut output = json!({"type":"function_call", "name":name,
+                "arguments":value.to_string(), "call_id":format!("call_{}", uuid::Uuid::new_v4().simple())});
+            if let Some(namespace) = &route.namespace {
+                output["namespace"] = json!(namespace);
+            }
+            output
+        } else {
+            json!({"type":"message", "role":"assistant", "content":[{"type":"output_text", "text":value.to_string()}]})
+        }
+    }
+}
+
+fn add_tool(
+    routes: &mut Vec<Route>,
+    tool: &Value,
+    namespace: Option<&str>,
+    namespace_description: &str,
+    forced: Option<(&Value, Option<&Value>)>,
+) -> Result<(), DecisionError> {
+    // Only function declarations are admitted. Other native tools require the
+    // ordinary model transport and cannot be fabricated into function calls.
+    if tool["type"] != "function" {
+        return Err(DecisionError::InvalidRequest);
+    }
+    let name = tool["name"].as_str().ok_or(DecisionError::InvalidRequest)?;
+    if let Some((forced_name, forced_namespace)) = forced {
+        if forced_name != name || forced_namespace.and_then(Value::as_str) != namespace {
+            return Ok(());
+        }
+    }
+    let mut description = format!(
+        "Call {}{}: {}",
+        namespace.map(|n| format!("{n}.")).unwrap_or_default(),
+        name,
+        tool["description"].as_str().unwrap_or("")
+    );
+    if let Some(namespace) = namespace.filter(|_| !namespace_description.trim().is_empty()) {
+        description.push_str(&format!("\nNamespace {namespace}: {namespace_description}"));
+    }
+    let mut schema = compile(&tool["parameters"]);
+    if let Some(schema) = &mut schema {
+        // Field inference is a separate request, without the routing choices.
+        schema.prepend_context(&description);
+    }
+    routes.push(Route {
+        name: Some(name.into()),
+        namespace: namespace.map(str::to_owned),
+        description,
+        schema,
+    });
+    Ok(())
+}
+
+impl Node {
+    fn prepend_context(&mut self, context: &str) {
+        match self {
+            Self::Constant(_) => {}
+            Self::Object(fields) => {
+                for (_, node) in fields {
+                    node.prepend_context(context);
+                }
+            }
+            Self::Field { question, .. } => {
+                let instructions = question["instructions"].as_str().unwrap_or("");
+                question["instructions"] = json!(format!("{context}\n{instructions}"));
+            }
+        }
+    }
+
+    fn questions(&self, out: &mut Vec<Value>) {
+        match self {
+            Self::Constant(_) => {}
+            Self::Object(fields) => {
+                for (_, node) in fields {
+                    node.questions(out);
+                }
+            }
+            Self::Field { question, .. } => out.push(question.clone()),
+        }
+    }
+
+    fn fill<'a>(
+        &self,
+        answers: &mut impl Iterator<Item = &'a Value>,
+    ) -> Result<Value, DecisionError> {
+        match self {
+            Self::Constant(value) => Ok(value.clone()),
+            Self::Object(fields) => {
+                let mut value = Map::new();
+                for (name, node) in fields {
+                    value.insert(name.clone(), node.fill(answers)?);
+                }
+                Ok(Value::Object(value))
+            }
+            Self::Field { kind, .. } => {
+                let answer = answers.next().ok_or(DecisionError::InvalidAnswer)?;
+                match kind {
+                    FieldKind::Boolean => Ok(json!(
+                        answer["probability"]
+                            .as_f64()
+                            .ok_or(DecisionError::InvalidAnswer)?
+                            >= 0.5
+                    )),
+                    FieldKind::Probability => Ok(answer["probability"].clone()),
+                    FieldKind::Choice(values) => {
+                        let index = (0..values.len())
+                            .find(|i| answer["choice"] == format!("value_{i}"))
+                            .ok_or(DecisionError::InvalidAnswer)?;
+                        Ok(values[index].clone())
+                    }
+                    FieldKind::Score { minimum, width } => {
+                        let score = answer["score"]
+                            .as_f64()
+                            .filter(|v| v.is_finite() && *v >= 0.0 && *v <= *width as f64)
+                            .ok_or(DecisionError::InvalidAnswer)?;
+                        Ok(json!(score + minimum))
+                    }
+                }
+            }
+        }
+    }
+}
+
+fn compile(schema: &Value) -> Option<Node> {
+    // Bound traversal before resolving references or finite unions. This also
+    // covers nested union branches, which do not create output containers.
+    fn bounded(value: &Value, depth: usize, remaining: &mut usize) -> bool {
+        if depth > 32 || *remaining == 0 {
+            return false;
+        }
+        *remaining -= 1;
+        match value {
+            Value::Array(values) => values.iter().all(|v| bounded(v, depth + 1, remaining)),
+            Value::Object(values) => values.values().all(|v| bounded(v, depth + 1, remaining)),
+            _ => true,
+        }
+    }
+    if !bounded(schema, 0, &mut 10000) {
+        return None;
+    }
+    let mut count = 0;
+    compile_node(
+        schema,
+        schema,
+        "$",
+        &mut Vec::new(),
+        &mut count,
+        &mut 10000,
+        0,
+    )
+    .ok()
+}
+
+fn compile_node(
+    schema: &Value,
+    root: &Value,
+    path: &str,
+    refs: &mut Vec<String>,
+    count: &mut usize,
+    remaining_nodes: &mut usize,
+    depth: usize,
+) -> Result<Node, ()> {
+    if depth > 32 || *remaining_nodes == 0 {
+        return Err(());
+    }
+    *remaining_nodes -= 1;
+    let object = schema.as_object().ok_or(())?;
+    // Reject constraints we cannot enforce, rather than silently weakening the
+    // schema. Annotation keywords do not alter the set of valid output values.
+    const KEYS: &[&str] = &[
+        "$ref",
+        "$defs",
+        "definitions",
+        "$schema",
+        "title",
+        "description",
+        "default",
+        "examples",
+        "type",
+        "properties",
+        "required",
+        "additionalProperties",
+        "enum",
+        "const",
+        "minimum",
+        "maximum",
+        "anyOf",
+        "oneOf",
+    ];
+    if object.keys().any(|key| !KEYS.contains(&key.as_str())) {
+        return Err(());
+    }
+    if let Some(reference) = schema.get("$ref") {
+        let reference = reference.as_str().ok_or(())?;
+        if !reference.starts_with("#/")
+            || refs.iter().any(|r| r == reference)
+            || object.keys().any(|k| {
+                !matches!(
+                    k.as_str(),
+                    "$ref" | "$defs" | "definitions" | "$schema" | "title" | "description"
+                )
+            })
+        {
+            return Err(());
+        }
+        let target = root.pointer(&reference[1..]).ok_or(())?;
+        refs.push(reference.into());
+        let result = compile_node(target, root, path, refs, count, remaining_nodes, depth + 1);
+        refs.pop();
+        let mut node = result?;
+        let annotations = schema_annotations(schema);
+        if !annotations.is_empty() {
+            node.prepend_context(&format!("Field {path} at this reference. {annotations}"));
+        }
+        return Ok(node);
+    }
+    if let Some(values) = finite_values(schema) {
+        if values.is_empty() || values.len() > 255 {
+            return Err(());
+        }
+        let mut unique = Vec::new();
+        for value in values {
+            if !scalar_matches(schema, &value) || unique.contains(&value) {
+                return Err(());
+            }
+            unique.push(value);
+        }
+        if unique.len() == 1 {
+            return Ok(Node::Constant(unique.remove(0)));
+        }
+        return field(count, path, schema, FieldKind::Choice(unique));
+    }
+    if schema.get("enum").is_some()
+        || schema.get("const").is_some()
+        || schema.get("anyOf").is_some()
+        || schema.get("oneOf").is_some()
+    {
+        return Err(());
+    }
+    match schema["type"].as_str() {
+        Some("object") => {
+            if schema["additionalProperties"] != false {
+                return Err(());
+            }
+            let empty_properties = Map::new();
+            let properties = match schema.get("properties") {
+                Some(value) => value.as_object().ok_or(())?,
+                None => &empty_properties,
+            };
+            let required = match schema.get("required") {
+                Some(value) => value.as_array().ok_or(())?.as_slice(),
+                None => &[],
+            };
+            if required.len() != properties.len()
+                || required
+                    .iter()
+                    .any(|v| v.as_str().is_none_or(|k| !properties.contains_key(k)))
+                || required.iter().collect::<HashSet<_>>().len() != required.len()
+            {
+                return Err(());
+            }
+            if schema.get("minimum").is_some() || schema.get("maximum").is_some() {
+                return Err(());
+            }
+            let mut fields = Vec::new();
+            for (name, property) in properties {
+                fields.push((
+                    name.clone(),
+                    compile_node(
+                        property,
+                        root,
+                        &format!("{path}/{}", name.replace('~', "~0").replace('/', "~1")),
+                        refs,
+                        count,
+                        remaining_nodes,
+                        depth + 1,
+                    )?,
+                ));
+            }
+            let mut node = Node::Object(fields);
+            let annotations = schema_annotations(schema);
+            if !annotations.is_empty() {
+                node.prepend_context(&format!("Field {path}. {annotations}"));
+            }
+            Ok(node)
+        }
+        Some("boolean") => field(count, path, schema, FieldKind::Boolean),
+        Some("number") | Some("integer") => {
+            let min = schema["minimum"]
+                .as_f64()
+                .filter(|v| v.is_finite())
+                .ok_or(())?;
+            let max = schema["maximum"]
+                .as_f64()
+                .filter(|v| v.is_finite())
+                .ok_or(())?;
+            if schema["type"] == "number" && min == 0.0 && max == 1.0 {
+                field(count, path, schema, FieldKind::Probability)
+            } else if min.fract() == 0.0
+                && max.fract() == 0.0
+                && max > min
+                && (max - min) <= 254.0
+                && min.abs() <= 9_007_199_254_740_991.0
+                && max.abs() <= 9_007_199_254_740_991.0
+            {
+                let width = (max - min) as usize;
+                if schema["type"] == "number" && width <= 9 {
+                    field(
+                        count,
+                        path,
+                        schema,
+                        FieldKind::Score {
+                            minimum: min,
+                            width,
+                        },
+                    )
+                } else if schema["type"] == "integer" {
+                    field(
+                        count,
+                        path,
+                        schema,
+                        FieldKind::Choice(
+                            (0..=width).map(|i| json!(min as i64 + i as i64)).collect(),
+                        ),
+                    )
+                } else {
+                    Err(())
+                }
+            } else {
+                Err(())
+            }
+        }
+        _ => Err(()),
+    }
+}
+
+fn finite_values(schema: &Value) -> Option<Vec<Value>> {
+    if let Some(value) = schema.get("const") {
+        return Some(vec![value.clone()]);
+    }
+    if let Some(values) = schema.get("enum") {
+        return values.as_array().cloned();
+    }
+    if schema["type"].as_str() == Some("null") {
+        return Some(vec![Value::Null]);
+    }
+    if let Some(types) = schema["type"].as_array() {
+        let mut values = Vec::new();
+        for kind in types {
+            match kind.as_str()? {
+                "null" => values.push(Value::Null),
+                "boolean" => {
+                    values.push(json!(true));
+                    values.push(json!(false));
+                }
+                _ => return None,
+            }
+        }
+        return Some(values);
+    }
+    if let Some(branches) = schema
+        .get("anyOf")
+        .or_else(|| schema.get("oneOf"))
+        .and_then(Value::as_array)
+    {
+        let mut values = Vec::new();
+        for branch in branches {
+            let branch_values = if branch["type"] == "boolean" {
+                vec![json!(true), json!(false)]
+            } else {
+                finite_values(branch)?
+            };
+            // Union branches must be finite scalar schemas, with no hidden constraints.
+            for value in branch_values {
+                if !scalar_matches(branch, &value) {
+                    return None;
+                }
+                values.push(value);
+            }
+        }
+        return Some(values);
+    }
+    None
+}
+
+fn scalar_matches(schema: &Value, value: &Value) -> bool {
+    if value.is_array() || value.is_object() {
+        return false;
+    }
+    let Some(object) = schema.as_object() else {
+        return false;
+    };
+    if object.keys().any(|k| {
+        !matches!(
+            k.as_str(),
+            "type"
+                | "const"
+                | "enum"
+                | "minimum"
+                | "maximum"
+                | "title"
+                | "description"
+                | "default"
+                | "examples"
+                | "anyOf"
+                | "oneOf"
+                | "$defs"
+                | "definitions"
+                | "$schema"
+        )
+    }) {
+        return false;
+    }
+    let matches_type = |kind: &str| match kind {
+        "null" => value.is_null(),
+        "boolean" => value.is_boolean(),
+        "string" => value.is_string(),
+        "number" => value.is_number(),
+        "integer" => value.as_f64().is_some_and(|v| v.fract() == 0.0),
+        _ => false,
+    };
+    if let Some(kind) = schema.get("type") {
+        if let Some(kind) = kind.as_str() {
+            if !matches_type(kind) {
+                return false;
+            }
+        } else if let Some(types) = kind.as_array() {
+            if !types.iter().any(|t| t.as_str().is_some_and(matches_type)) {
+                return false;
+            }
+        } else {
+            return false;
+        }
+    }
+    if schema.get("const").is_some_and(|v| v != value) {
+        return false;
+    }
+    if schema
+        .get("enum")
+        .is_some_and(|v| v.as_array().is_none_or(|values| !values.contains(value)))
+    {
+        return false;
+    }
+    for (key, lower) in [("minimum", true), ("maximum", false)] {
+        if let Some(bound) = schema.get(key) {
+            let Some(bound) = bound.as_f64() else {
+                return false;
+            };
+            if let Some(number) = value.as_f64() {
+                if !bound.is_finite() || (lower && number < bound) || (!lower && number > bound) {
+                    return false;
+                }
+            }
+        }
+    }
+    for keyword in ["anyOf", "oneOf"] {
+        if let Some(branches) = schema.get(keyword) {
+            let Some(branches) = branches.as_array() else {
+                return false;
+            };
+            let matches = branches
+                .iter()
+                .filter(|branch| scalar_matches(branch, value))
+                .count();
+            if matches == 0 || (keyword == "oneOf" && matches != 1) {
+                return false;
+            }
+        }
+    }
+    true
+}
+
+fn schema_annotations(schema: &Value) -> String {
+    let mut annotations = Vec::new();
+    for key in ["title", "description"] {
+        if let Some(value) = schema[key]
+            .as_str()
+            .filter(|value| !value.trim().is_empty())
+        {
+            annotations.push(format!("{key}: {value}"));
+        }
+    }
+    for key in ["default", "examples"] {
+        if let Some(value) = schema.get(key) {
+            annotations.push(format!("{key}: {value}"));
+        }
+    }
+    annotations.join("\n")
+}
+
+fn choice_description(schema: &Value, value: &Value) -> String {
+    fn append_branches(schema: &Value, value: &Value, description: &mut String) {
+        for keyword in ["anyOf", "oneOf"] {
+            if let Some(branches) = schema[keyword].as_array() {
+                for branch in branches
+                    .iter()
+                    .filter(|branch| scalar_matches(branch, value))
+                {
+                    let annotations = schema_annotations(branch);
+                    if !annotations.is_empty() {
+                        description.push('\n');
+                        description.push_str(&annotations);
+                    }
+                    append_branches(branch, value, description);
+                }
+            }
+        }
+    }
+    let mut description = value.to_string();
+    append_branches(schema, value, &mut description);
+    description
+}
+
+fn field(count: &mut usize, path: &str, schema: &Value, kind: FieldKind) -> Result<Node, ()> {
+    *count += 1;
+    if *count > 400 {
+        return Err(());
+    }
+    let context = format!("Field {path}. {}", schema_annotations(schema));
+    let mut question = json!({"name":format!("field_{}", *count), "instructions":context});
+    match &kind {
+        FieldKind::Boolean => {
+            question["type"] = json!("predicate");
+            question["instructions"] = json!(format!(
+                "Determine whether this boolean field is true. {context}"
+            ));
+        }
+        FieldKind::Probability => {
+            question["type"] = json!("predicate");
+            question["instructions"] = json!(format!(
+                "Estimate the probability represented by this field. {context}"
+            ));
+        }
+        FieldKind::Choice(values) => {
+            question["type"] = json!("choice");
+            question["choices"] = json!(
+                values
+                    .iter()
+                    .enumerate()
+                    .map(
+                        |(i, v)| json!({"value":format!("value_{i}"), "description":choice_description(schema, v)})
+                    )
+                    .collect::<Vec<_>>()
+            );
+        }
+        FieldKind::Score { minimum, width } => {
+            question["type"] = json!("score");
+            question["levels"] = json!(
+                (0..=*width)
+                    .map(|i| json!({"label":format!("{}", *minimum + i as f64)}))
+                    .collect::<Vec<_>>()
+            );
+        }
+    }
+    Ok(Node::Field { question, kind })
+}
+
+fn unit(value: f64) -> bool {
+    value.is_finite() && (0.0..=1.0).contains(&value)
+}
+
+fn validate_answers(questions: &[Value], answers: &[Value]) -> Result<(), DecisionError> {
+    if questions.len() != answers.len() {
+        return Err(DecisionError::InvalidAnswer);
+    }
+    for (question, answer) in questions.iter().zip(answers) {
+        if answer["name"] != question["name"] {
+            return Err(DecisionError::InvalidAnswer);
+        }
+        if answer["type"] == "refusal" {
+            return Err(DecisionError::Refusal);
+        }
+        if answer["type"] != question["type"] {
+            return Err(DecisionError::InvalidAnswer);
+        }
+        if answer["type"] == "predicate" {
+            if !answer["probability"].as_f64().is_some_and(unit) {
+                return Err(DecisionError::InvalidAnswer);
+            }
+            continue;
+        }
+        if !answer["confidence"].as_f64().is_some_and(unit) {
+            return Err(DecisionError::InvalidAnswer);
+        }
+        let entries = answer["probabilities"]
+            .as_array()
+            .ok_or(DecisionError::InvalidAnswer)?;
+        let expected: Vec<Value> = if question["type"] == "choice" {
+            question["choices"]
+                .as_array()
+                .ok_or(DecisionError::InvalidState)?
+                .iter()
+                .map(|c| c["value"].clone())
+                .collect()
+        } else {
+            (0..question["levels"]
+                .as_array()
+                .ok_or(DecisionError::InvalidState)?
+                .len())
+                .map(|i| json!(i))
+                .collect()
+        };
+        if entries.len() != expected.len() {
+            return Err(DecisionError::InvalidAnswer);
+        }
+        let mut seen = Vec::new();
+        let mut total = 0.0;
+        for entry in entries {
+            let value = &entry["value"];
+            if !expected.contains(value) || seen.contains(value) {
+                return Err(DecisionError::InvalidAnswer);
+            }
+            seen.push(value.clone());
+            total += entry["probability"]
+                .as_f64()
+                .filter(|v| unit(*v))
+                .ok_or(DecisionError::InvalidAnswer)?;
+            if question["type"] == "score" {
+                let index = value.as_u64().ok_or(DecisionError::InvalidAnswer)? as usize;
+                if entry["label"] != question["levels"][index]["label"] {
+                    return Err(DecisionError::InvalidAnswer);
+                }
+            }
+        }
+        if (total - 1.0).abs() > 1e-5 {
+            return Err(DecisionError::InvalidAnswer);
+        }
+        if question["type"] == "choice" {
+            if !expected.contains(&answer["choice"]) {
+                return Err(DecisionError::InvalidAnswer);
+            }
+        } else if !answer["score"]
+            .as_f64()
+            .is_some_and(|v| v.is_finite() && v >= 0.0 && v <= (expected.len() - 1) as f64)
+        {
+            return Err(DecisionError::InvalidAnswer);
+        }
+    }
+    Ok(())
+}
+
+fn normalize_input(request: &Value) -> Result<Vec<Value>, DecisionError> {
+    let mut out = Vec::new();
+    if let Some(instructions) = request.get("instructions").filter(|v| !v.is_null()) {
+        let text = instructions
+            .as_str()
+            .ok_or(DecisionError::UnsupportedInput)?;
+        out.push(json!({"type":"message", "role":"developer", "content":text}));
+    }
+    let input = request
+        .get("input")
+        .ok_or(DecisionError::UnsupportedInput)?;
+    if let Some(text) = input.as_str() {
+        out.push(json!({"type":"message", "role":"user", "content":text}));
+        return Ok(out);
+    }
+    let items = input.as_array().ok_or(DecisionError::UnsupportedInput)?;
+    let mut calls = HashMap::new();
+    let mut outputs = HashSet::new();
+    for item in items {
+        let kind = item["type"].as_str().unwrap_or("message");
+        match kind {
+            "reasoning" => continue,
+            "message" => {
+                let role = item["role"]
+                    .as_str()
+                    .filter(|r| matches!(*r, "user" | "developer" | "system" | "assistant"))
+                    .ok_or(DecisionError::UnsupportedInput)?;
+                let content = normalize_content(&item["content"], role)?;
+                let mut message = json!({"type":"message", "role":role, "content":content});
+                if let Some(phase) = item.get("phase").filter(|v| !v.is_null()) {
+                    if role != "assistant"
+                        || !matches!(phase.as_str(), Some("commentary" | "final_answer"))
+                    {
+                        return Err(DecisionError::UnsupportedInput);
+                    }
+                    message["phase"] = phase.clone();
+                }
+                out.push(message);
+            }
+            "function_call" | "custom_tool_call" => {
+                let call_id = nonempty(item, "call_id")?;
+                if calls.insert(call_id.to_owned(), kind.to_owned()).is_some() {
+                    return Err(DecisionError::UnsupportedInput);
+                }
+                let name = nonempty(item, "name")?;
+                let key = if kind == "function_call" {
+                    "arguments"
+                } else {
+                    "input"
+                };
+                let payload = item[key].as_str().ok_or(DecisionError::UnsupportedInput)?;
+                let mut call = json!({"type":kind, "name":name, "call_id":call_id, key:payload});
+                if let Some(namespace) = item.get("namespace").filter(|v| !v.is_null()) {
+                    if namespace.as_str().is_none_or(str::is_empty) {
+                        return Err(DecisionError::UnsupportedInput);
+                    }
+                    call["namespace"] = namespace.clone();
+                }
+                out.push(call);
+            }
+            "function_call_output" | "custom_tool_call_output" => {
+                let call_id = nonempty(item, "call_id")?;
+                let expected_call = if kind == "function_call_output" {
+                    "function_call"
+                } else {
+                    "custom_tool_call"
+                };
+                if calls.get(call_id).map(String::as_str) != Some(expected_call)
+                    || !outputs.insert(call_id.to_owned())
+                {
+                    return Err(DecisionError::UnsupportedInput);
+                }
+                let output = normalize_content(&item["output"], "tool")?;
+                out.push(json!({"type":kind, "call_id":call_id, "output":output}));
+            }
+            _ => return Err(DecisionError::UnsupportedInput),
+        }
+    }
+    Ok(out)
+}
+
+fn nonempty<'a>(value: &'a Value, key: &str) -> Result<&'a str, DecisionError> {
+    value[key]
+        .as_str()
+        .filter(|v| !v.is_empty())
+        .ok_or(DecisionError::UnsupportedInput)
+}
+
+fn normalize_content(content: &Value, role: &str) -> Result<Value, DecisionError> {
+    if content.is_string() {
+        return Ok(content.clone());
+    }
+    let parts = content.as_array().ok_or(DecisionError::UnsupportedInput)?;
+    let mut out = Vec::new();
+    for part in parts {
+        let kind = part["type"]
+            .as_str()
+            .ok_or(DecisionError::UnsupportedInput)?;
+        let normalized = match kind {
+            "input_text" | "output_text" if role == "assistant" || kind == "input_text" => {
+                let text = part["text"]
+                    .as_str()
+                    .ok_or(DecisionError::UnsupportedInput)?;
+                json!({"type": if role == "assistant" { "output_text" } else { "input_text" }, "text":text})
+            }
+            "refusal" if role == "assistant" => {
+                json!({"type":"refusal", "refusal":part["refusal"].as_str().ok_or(DecisionError::UnsupportedInput)?})
+            }
+            "input_image" if matches!(role, "user" | "tool") => {
+                let url = part["image_url"]
+                    .as_str()
+                    .filter(|u| {
+                        u.starts_with("data:")
+                            || u.starts_with("https://")
+                            || u.starts_with("http://")
+                    })
+                    .ok_or(DecisionError::UnsupportedInput)?;
+                let mut image = json!({"type":"input_image", "image_url":url});
+                if let Some(detail) = part.get("detail").filter(|v| !v.is_null()) {
+                    if !matches!(detail.as_str(), Some("auto" | "low" | "high" | "original")) {
+                        return Err(DecisionError::UnsupportedInput);
+                    }
+                    image["detail"] = detail.clone();
+                }
+                out.push(image);
+                continue;
+            }
+            _ => return Err(DecisionError::UnsupportedInput),
+        };
+        out.push(normalized);
+    }
+    Ok(Value::Array(out))
+}
