+        req["tools"] = json!([{"type":"function","name":"act","parameters":object(json!({}))}]);
+        let mut plan = DecisionPlan::new(&req, Some(0.7)).unwrap();
+        let q = questions(plan.next().unwrap());
+        assert!(matches!(
+            plan.accept(&[choice(&q[0], 0, 0.6, 1.0)]).unwrap(),
+            DecisionAction::Handoff(_)
+        ));
+        let mut plan = DecisionPlan::new(&req, Some(0.7)).unwrap();
+        let q = questions(plan.next().unwrap());
+        assert!(matches!(
+            plan.accept(&[choice(&q[0], 0, 0.8, 0.0)]).unwrap(),
+            DecisionAction::Questions(_)
+        ));
+    }
+
+    #[test]
+    fn unfillable_route_remains_selectable_but_all_unfillable_skips_questions() {
+        let mut req = request(json!({"type":"string"}));
+        let mut plan = DecisionPlan::new(&req, None).unwrap();
+        assert!(matches!(plan.next().unwrap(), DecisionAction::Handoff(_)));
+        req["tools"] = json!([{"type":"function","name":"act","parameters":object(json!({}))}]);
+        let mut plan = DecisionPlan::new(&req, None).unwrap();
+        let q = questions(plan.next().unwrap());
+        assert_eq!(q[0]["choices"].as_array().unwrap().len(), 2);
+        assert!(matches!(
+            plan.accept(&[choice(&q[0], 0, 1.0, 1.0)]).unwrap(),
+            DecisionAction::Handoff(_)
+        ));
+    }
+
+    #[test]
+    fn fill_errors_are_typed_terminal_and_never_handoff() {
+        let req = request(object(json!({"ok":{"type":"boolean"}})));
+        for variant in 0..5 {
+            let mut plan = DecisionPlan::new(&req, None).unwrap();
+            let q = questions(plan.next().unwrap());
+            let answers = match variant {
+                0 => vec![],
+                1 => vec![json!({"type":"predicate","name":"spoofed","probability":0.5})],
+                2 => vec![json!({"type":"predicate","name":q[0]["name"],"probability":1.5})],
+                3 => vec![json!({"type":"choice","name":q[0]["name"],"choice":"true"})],
+                _ => vec![json!({"type":"refusal","name":q[0]["name"]})],
+            };
+            assert_eq!(
+                plan.accept(&answers),
+                Err(if variant == 4 {
+                    DecisionError::Refusal
+                } else {
+                    DecisionError::InvalidAnswer
+                })
+            );
+            assert_eq!(plan.next(), Err(DecisionError::InvalidState));
+        }
+    }
+
+    #[test]
+    fn choice_answers_require_exact_members_unique_distribution_and_valid_confidence() {
+        let req = request(json!({"enum":[false,"false",3]}));
+        for variant in 0..5 {
+            let mut plan = DecisionPlan::new(&req, None).unwrap();
+            let q = questions(plan.next().unwrap());
+            let mut answer = choice(&q[0], 0, 0.8, 0.9);
+            match variant {
+                0 => answer["probabilities"][1] = answer["probabilities"][0].clone(),
+                1 => answer["choice"] = json!(false),
+                2 => answer["confidence"] = json!(-0.1),
+                3 => answer["probabilities"][0]["probability"] = json!(2),
+                _ => {
+                    answer["probabilities"].as_array_mut().unwrap().pop();
+                }
+            }
+            assert_eq!(plan.accept(&[answer]), Err(DecisionError::InvalidAnswer));
+        }
+    }
+
+    #[test]
+    fn references_resolve_locally_and_cycles_are_unfillable() {
+        let mut schema = object(
+            json!({"ok":{"$ref":"#/$defs/flag", "description":"Property specific meaning"}}),
+        );
+        schema["$defs"] = json!({"flag":{"type":"boolean"}});
+        let mut plan = DecisionPlan::new(&request(schema.clone()), None).unwrap();
+        let q = questions(plan.next().unwrap());
+        assert_eq!(q.len(), 1);
+        assert!(
+            q[0]["instructions"]
+                .as_str()
+                .unwrap()
+                .contains("Property specific meaning")
+        );
+        schema["$defs"]["flag"] = json!({"$ref":"#/$defs/flag"});
+        let mut plan = DecisionPlan::new(&request(schema), None).unwrap();
+        assert!(matches!(plan.next().unwrap(), DecisionAction::Handoff(_)));
+    }
+
+    #[test]
+    fn nullable_finite_unions_work_and_unsupported_constraints_do_not_get_ignored() {
+        let mut plan = DecisionPlan::new(
+            &request(json!({"anyOf":[{"enum":[1,2]},{"type":"null"}]})),
+            None,
+        )
+        .unwrap();
+        let q = questions(plan.next().unwrap());
+        assert_eq!(
+            output_value(plan.accept(&[choice(&q[0], 2, 1.0, 1.0)]).unwrap()),
+            Value::Null
+        );
+        for schema in [
+            json!({"type":"string","enum":["a","b"],"pattern":"a"}),
+            json!({"type":"array","items":{"enum":["a","b"]}}),
+            json!({"type":"number"}),
+            json!({"type":"object","additionalProperties":true}),
+            json!({"anyOf":[object(json!({})),{"type":"null"}]}),
+        ] {
+            let mut plan = DecisionPlan::new(&request(schema), None).unwrap();
+            assert!(matches!(plan.next().unwrap(), DecisionAction::Handoff(_)));
+        }
+    }
+
+    #[test]
+    fn tool_choice_none_and_required_control_admitted_routes() {
+        let mut empty = DecisionPlan::new(
+            &request(json!({"type":"object","additionalProperties":false})),
+            None,
+        )
+        .unwrap();
+        assert_eq!(output_value(empty.next().unwrap()), json!({}));
+        let mut req = request(object(json!({"answer":{"const":true}})));
+        req["tools"] = json!([{"type":"function","name":"act","parameters":object(json!({}))}]);
+        req["tool_choice"] = json!("none");
+        let mut plan = DecisionPlan::new(&req, None).unwrap();
+        assert_eq!(output_value(plan.next().unwrap()), json!({"answer":true}));
+        req["tool_choice"] = json!("required");
+        let mut plan = DecisionPlan::new(&req, None).unwrap();
+        let DecisionAction::Output(item) = plan.next().unwrap() else {
+            panic!("expected tool")
+        };
+        assert_eq!(item["name"], "act");
+    }
+
+    #[test]
+    fn input_preserves_roles_order_images_and_call_linkage_without_reasoning() {
+        let mut req = request(json!({"const":true}));
+        req["instructions"] = json!("Application policy");
+        req["input"] = json!([
+            {"role":"developer","content":[{"type":"input_text","text":"Developer policy"}]},
+            {"role":"user","content":[{"type":"input_text","text":"User evidence"},{"type":"input_image","image_url":"https://example.test/image.png"}]},
+            {"type":"reasoning","encrypted_content":"opaque"},
+            {"type":"function_call","call_id":"call_1","namespace":"support","name":"lookup","arguments":"{}"},
+            {"type":"function_call_output","call_id":"call_1","output":"Evidence"},
+            {"role":"assistant","content":[{"type":"output_text","text":"Prior answer"}]}
+        ]);
+        let plan = DecisionPlan::new(&req, None).unwrap();
+        assert_eq!(plan.input().len(), 6);
+        assert_eq!(plan.input()[0]["role"], "developer");
+        assert_eq!(plan.input()[1]["role"], "developer");
+        assert_eq!(plan.input()[2]["role"], "user");
+        assert_eq!(plan.input()[3]["arguments"], "{}");
+        assert_eq!(plan.input()[3]["namespace"], "support");
+        assert_eq!(plan.input()[4]["call_id"], "call_1");
+        req["input"][4]["call_id"] = json!("unknown");
+        assert_eq!(
+            DecisionPlan::new(&req, None).unwrap_err(),
+            DecisionError::UnsupportedInput
+        );
+    }
+
+    #[test]
+    fn unsupported_input_content_fails_before_questions() {
+        let mut req = request(json!({"const":true}));
+        req["input"] =
+            json!([{"role":"user","content":[{"type":"input_file","file_id":"file_1"}]}]);
+        assert_eq!(
+            DecisionPlan::new(&req, None).unwrap_err(),
+            DecisionError::UnsupportedInput
+        );
+    }
+    #[test]
+    fn invalid_score_labels_and_values_fail_without_fallback() {
+        let req = request(json!({"type":"number","minimum":2,"maximum":3}));
+        for variant in 0..3 {
+            let mut plan = DecisionPlan::new(&req, None).unwrap();
+            let q = questions(plan.next().unwrap());
+            let mut answer = json!({"type":"score","name":q[0]["name"], "score":0.5,"confidence":0.8,
+                "probabilities":[{"value":0,"label":"2","probability":0.5},{"value":1,"label":"3","probability":0.5}]});
+            match variant {
+                0 => answer["probabilities"][0]["label"] = json!("spoofed"),
+                1 => answer["score"] = json!(1.5),
+                _ => answer["probabilities"][0]["value"] = json!(2),
+            }
+            assert_eq!(plan.accept(&[answer]), Err(DecisionError::InvalidAnswer));
+        }
+    }
+
+    #[test]
+    fn ref_expansion_and_question_counts_are_bounded_before_any_request() {
+        let properties: Map<String, Value> = (0..401)
+            .map(|i| (format!("flag_{i}"), json!({"type":"boolean"})))
+            .collect();
+        let mut plan =
+            DecisionPlan::new(&request(object(Value::Object(properties))), None).unwrap();
+        assert!(matches!(plan.next().unwrap(), DecisionAction::Handoff(_)));
+        let mut defs = Map::new();
+        defs.insert("leaf".into(), json!({"const":true}));
+        for i in 0..15 {
+            let target = if i == 0 {
+                "leaf".to_owned()
+            } else {
+                format!("branch_{}", i - 1)
+            };
+            defs.insert(format!("branch_{i}"), object(json!({"left":{"$ref":format!("#/$defs/{target}")},"right":{"$ref":format!("#/$defs/{target}")}})));
+        }
+        let schema = json!({"$ref":"#/$defs/branch_14","$defs":defs});
+        let mut plan = DecisionPlan::new(&request(schema), None).unwrap();
+        assert!(matches!(plan.next().unwrap(), DecisionAction::Handoff(_)));
+    }
+
+    #[test]
+    fn call_outputs_must_match_the_call_kind_and_ids() {
+        let mut req = request(json!({"const":true}));
+        req["input"] = json!([
+            {"type":"function_call","call_id":"call_1","name":"lookup","arguments":"{}"},
+            {"type":"custom_tool_call_output","call_id":"call_1","output":"Evidence"}
+        ]);
