+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn token_details_are_subsets_and_missing_usage_stays_unknown() {
+        let body = json!({"model":"decision-resolved", "answers":[], "usage": {"input_tokens":10,"output_tokens":3,"total_tokens":13,"input_tokens_details":{"cached_tokens":4,"cache_write_tokens":2},"output_tokens_details":{"reasoning_tokens":1}}});
+        let parsed = completion(&body, "decision-test").unwrap();
+        let usage = parsed.usage.unwrap();
+        assert_eq!(usage.total_tokens, 13);
+        assert_eq!(usage.cached_input_tokens, 4);
+        assert_eq!(usage.cache_write_input_tokens, 2);
+        assert_eq!(usage.reasoning_output_tokens, 1);
+        assert_eq!(
+            parsed.metadata.metadata.unwrap()["decisions"]["model"],
+            "decision-resolved"
+        );
+        assert_eq!(parsed.model, "decision-resolved");
+        let unknown = completion(&json!({}), "decision-test").unwrap();
+        assert!(unknown.usage.is_none());
+        assert_eq!(unknown.model, "decision-test");
+        assert!(unknown.metadata.metadata.unwrap()["decisions"]["model"].is_null());
+    }
+
+    #[test]
+    fn responses_without_body_ids_receive_distinct_local_identities() {
+        let body = json!({
+            "model": "decision-snapshot",
+            "answers": [],
+            "usage": {"input_tokens": 7, "output_tokens": 3, "total_tokens": 10}
+        });
+        let first = completion(&body, "decision-alias").unwrap();
+        let second = completion(&body, "decision-alias").unwrap();
+        assert!(!first.id.is_empty());
+        assert_ne!(first.id, second.id);
+        assert_eq!(
+            first.observation.response_id.as_deref(),
+            Some(first.id.as_str())
+        );
+        assert_eq!(
+            second.observation.response_id.as_deref(),
+            Some(second.id.as_str())
+        );
+        assert_eq!(first.model, "decision-snapshot");
+        assert_eq!(
+            first.metadata.metadata.unwrap()["decisions"]["model"],
+            "decision-snapshot"
+        );
+    }
+
+    #[test]
+    fn rejects_a_total_that_would_undercount_the_physical_response() {
+        let body = json!({"model":"decision-test", "usage":{"input_tokens":10,"output_tokens":3,"total_tokens":10}});
+        assert!(completion(&body, "decision-test").is_err());
+    }
+
+    #[test]
+    fn rejects_invalid_counter_without_exposing_response_contents() {
+        let body = json!({"model":"decision-test", "usage":{"input_tokens":-1,"output_tokens":0,"total_tokens":0},"secret":"do not echo"});
+        let error = completion(&body, "decision-test")
+            .err()
+            .unwrap()
+            .to_string();
+        assert!(!error.contains("do not echo"));
+    }
+}
