+#[tokio::test]
+async fn decisions_output_does_not_invent_model_reroute_events() -> anyhow::Result<()> {
+    for constant in [false, true] {
+        let server = MockServer::start().await;
+        Mock::given(method("POST"))
+            .and(path("/decisions"))
+            .respond_with(
+                ResponseTemplate::new(200)
+                    .insert_header("x-request-id", "req_decision_output")
+                    .set_body_json(json!({
+                        "model": "decision-resolved-snapshot",
+                        "answers": [{"type": "predicate", "name": "field_1", "probability": 1}],
+                        "usage": {"input_tokens": 7, "output_tokens": 3, "total_tokens": 10}
+                    })),
+            )
+            .expect(if constant { 0 } else { 1 })
+            .mount(&server)
+            .await;
+        let mut info = create_oss_provider_with_base_url(&server.uri(), WireApi::Responses);
+        info.decision_model = Some(codex_model_provider_info::DecisionModelOptions {
+            model: "decision-alias".into(),
+            fallback_model: Some("gpt-test".into()),
+            min_route_probability: None,
+        });
+        info.request_max_retries = Some(0);
+        let mut client = test_model_client(SessionSource::Cli);
+        Arc::get_mut(&mut client.state).unwrap().provider = create_model_provider(info, None);
+        let field = if constant {
+            json!({"type": "boolean", "const": true})
+        } else {
+            json!({"type": "boolean"})
+        };
+        let prompt = Prompt {
+            output_schema: Some(json!({
+                "type": "object", "properties": {"approved": field},
+                "required": ["approved"], "additionalProperties": false
+            })),
+            ..Prompt::default()
+        };
+        let metadata = test_responses_metadata_for_client(
+            &client,
+            None,
+            format!("{}:0", client.state.thread_id),
+            None,
+            TestCodexResponsesRequestKind::Turn,
+        );
+        let mut session = client.new_session();
+        let mut stream = session
+            .stream(
+                &prompt,
+                &test_model_info(),
+                &test_session_telemetry(),
+                None,
+                codex_protocol::config_types::ReasoningSummary::None,
+                None,
+                &metadata,
+                &InferenceTraceContext::disabled(),
+            )
+            .await?;
+        let mut events = Vec::new();
+        while let Some(event) = stream.next().await {
+            events.push(event?);
+        }
+        assert!(
+            events
+                .iter()
+                .all(|event| !matches!(event, ResponseEvent::ServerModel(_))),
+            "a Decisions model is not evidence of a generative model reroute"
+        );
+        let mut completed = 0;
+        let mut observed = 0;
+        let mut output = 0;
+        let mut response_id = None;
+        for event in events {
+            match event {
+                ResponseEvent::IntermediateCompleted {
+                    model,
+                    response_id: id,
+                    usage_metadata,
+                    ..
+                } => {
+                    observed += 1;
+                    assert_eq!(model, "decision-resolved-snapshot");
+                    assert_eq!(
+                        usage_metadata.unwrap().metadata.unwrap()["decisions"]["model"],
+                        "decision-resolved-snapshot"
+                    );
+                    assert_ne!(id, "req_decision_output");
+                    response_id = Some(id);
+                }
+                ResponseEvent::OutputItemDone(item) => {
+                    let item = serde_json::to_value(item)?;
+                    let text = item["content"][0]["text"].as_str().expect("output text");
+                    assert_eq!(
+                        serde_json::from_str::<serde_json::Value>(text)?,
+                        json!({"approved": true})
+                    );
+                    output += 1;
+                }
+                ResponseEvent::Completed {
+                    response_id: id, ..
+                } => {
+                    assert!(!id.is_empty());
+                    if let Some(observed_id) = &response_id {
+                        assert_eq!(&id, observed_id);
+                    }
+                    completed += 1;
+                }
+                _ => {}
+            }
+        }
+        assert_eq!(observed, if constant { 0 } else { 1 });
+        assert_eq!(output, 1);
+        assert_eq!(completed, 1);
+        server.verify().await;
+    }
+    Ok(())
+}
