+
+#[tokio::test]
+async fn decisions_force_standard_responses_preserves_bundled_model_metadata() {
+    let codex_home = tempdir().expect("temp dir");
+    let manager = openai_manager_for_tests(
+        codex_home.path().to_path_buf(),
+        TestModelsEndpoint::new(Vec::new()),
+    );
+    let responses_config = ModelsManagerConfig::default();
+    let decisions_config = ModelsManagerConfig {
+        force_standard_responses: true,
+        ..Default::default()
+    };
+    for slug in ["gpt-6-luna", "gpt-6-sol", "unknown-decisions-model"] {
+        let original = manager.get_model_info(slug, &responses_config).await;
+        if slug == "gpt-6-luna" {
+            assert!(original.use_responses_lite);
+            assert!(!original.used_fallback_model_metadata);
+        }
+        let mut expected = original.clone();
+        expected.use_responses_lite = false;
+        let decisions = manager.get_model_info(slug, &decisions_config).await;
+        assert_eq!(decisions, expected);
+        // The override changes the resolved copy, not the catalog or future Responses steps.
+        assert_eq!(
+            manager.get_model_info(slug, &responses_config).await,
+            original
+        );
+    }
+}
