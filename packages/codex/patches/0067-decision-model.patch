+use crate::auth::SharedAuthProvider;
+use crate::endpoint::session::EndpointSession;
+use crate::error::ApiError;
+use crate::provider::Provider;
+use codex_client::HttpTransport;
+use codex_client::RequestTelemetry;
+use http::HeaderMap;
+use http::Method;
+use serde_json::Value;
+use std::sync::Arc;
+
+/// A nonstreaming Decisions response with its provider request identity.
+pub struct DecisionResponse {
+    pub body: Value,
+    pub request_id: Option<String>,
+}
+
+/// Uses the same provider authentication, retry policy, and transport as Responses.
+pub struct DecisionsClient<T: HttpTransport> {
+    session: EndpointSession<T>,
+}
+
+impl<T: HttpTransport> DecisionsClient<T> {
+    pub fn new(transport: T, provider: Provider, auth: SharedAuthProvider) -> Self {
+        Self {
+            session: EndpointSession::new(transport, provider, auth),
+        }
+    }
+
+    pub fn with_telemetry(mut self, telemetry: Option<Arc<dyn RequestTelemetry>>) -> Self {
+        self.session = self.session.with_request_telemetry(telemetry);
+        self
+    }
+
+    pub async fn create(
+        &self,
+        body: Value,
+        headers: HeaderMap,
+    ) -> Result<DecisionResponse, ApiError> {
+        let response = self
+            .session
+            .execute(Method::POST, "/decisions", headers, Some(body))
+            .await?;
+        let request_id = response
+            .headers
+            .get("x-request-id")
+            .and_then(|value| value.to_str().ok())
+            .map(str::to_owned);
+        let body = serde_json::from_slice(&response.body)
+            .map_err(|_| ApiError::Stream("Decisions returned invalid JSON".into()))?;
+        Ok(DecisionResponse { body, request_id })
+    }
+}
