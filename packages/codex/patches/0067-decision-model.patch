+    fn choice(question: &Value, selected: usize, probability: f64, confidence: f64) -> Value {
+        let choices = question["choices"].as_array().unwrap();
+        let remaining = (1.0 - probability) / (choices.len() - 1) as f64;
+        json!({"type":"choice", "name":question["name"], "choice":choices[selected]["value"],
+            "confidence":confidence,"probabilities":choices.iter().enumerate().map(|(i,c)|
+                json!({"value":c["value"],"probability":if i==selected {probability} else {remaining}})).collect::<Vec<_>>()})
