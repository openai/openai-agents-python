+/// Live native authorization for one factory-selected destination.
+/// Implementations never deserialize this authority from tool output or checkpoints.
+pub trait LiveAgentHandoffAdmission: Send + Sync {
+    fn consume(
+        &self,
+        thread_id: &str,
+        source: &AgentProfileReceipt,
+        turn_id: &str,
+        call_id: &str,
+        tool: &codex_tools::ToolName,
+        target: &str,
+    ) -> bool;
+}
+
+/// Only a factory-capable producing profile attaches this native object.
+#[derive(Clone)]
+pub struct AgentProfileLiveHandoffAdmission {
+    pub admission: std::sync::Arc<dyn LiveAgentHandoffAdmission>,
+    /// Original captured choices for factory-capable names, never expanded by live publication.
+    pub captured_targets: std::collections::HashMap<codex_tools::ToolName, Vec<String>>,
+}
+
 /// Clean application text captured with the accepted profile publication.
 /// A missing attachment preserves legacy inheritance; `text: None` clears it.
 #[derive(Clone, Debug)]
