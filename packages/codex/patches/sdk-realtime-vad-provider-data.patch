+    #[test]
+    fn vad_provider_data_uses_existing_sparse_settings_owner() {
+        for mode in ["server_vad", "semantic_vad"] {
+            let settings: RealtimeV2SessionSettings = serde_json::from_value(json!({
+                "turn_detection": {"type": mode, "provider_data": {
+                    "vendor_tuning": {"enabled": false, "delay_ms": 0}
+                }}
+            }))
+            .unwrap();
+            let mut session = Map::new();
+            apply(&settings, &mut session).unwrap();
+            assert_eq!(
+                session["audio"]["input"]["turn_detection"],
+                json!({
+                    "type": mode, "vendor_tuning": {"enabled": false, "delay_ms": 0}
+                })
+            );
+            let retained = session.clone();
+            apply(&RealtimeV2SessionSettings::default(), &mut session).unwrap();
+            assert_eq!(session, retained);
+            for reset in [json!({}), Value::Null] {
+                let update = serde_json::from_value(json!({"turn_detection": {
+                    "type": mode, "provider_data": reset
+                }}))
+                .unwrap();
+                apply(&update, &mut session).unwrap();
+                assert_eq!(
+                    session["audio"]["input"]["turn_detection"],
+                    json!({"type":mode})
+                );
+            }
+            let disabled = serde_json::from_value(json!({"turn_detection":null})).unwrap();
+            apply(&disabled, &mut session).unwrap();
+            assert_eq!(session["audio"]["input"]["turn_detection"], Value::Null);
+        }
+    }
