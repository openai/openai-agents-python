+            }}))
+            .unwrap();
+            let mut session = json!({"model":"original"}).as_object().unwrap().clone();
+            let original = session.clone();
+            assert!(apply(&settings, &mut session).is_err());
+            assert_eq!(session, original);
+        }
+    }
