+
+#[test]
+fn user_appendix_replaces_only_its_current_snapshot() {
+    let directory = tempfile::tempdir().expect("instruction source directory");
+    let source = AbsolutePathBuf::try_from(directory.path().join("AGENTS.md"))
+        .expect("absolute instruction source");
+    let user = Instructions {
+        text: "original user".to_owned(),
+        source: Some(source),
+    };
+    let thread = Instructions {
+        text: "original thread".to_owned(),
+        source: None,
+    };
+    let first = LoadedAgentsMd::default()
+        .with_instructions(
+            Some(user.clone()),
+            Some(thread.clone()),
+            Some("guide A".to_owned()),
+        )
+        .expect("first instruction snapshot");
+    let sources = first.sources().collect::<Vec<_>>();
+    let receipts = first.sdk_file_receipts(|text| text.to_owned());
+    let second = first
+        .with_instructions(
+            Some(user.clone()),
+            Some(thread.clone()),
+            Some("guide B".to_owned()),
+        )
+        .expect("replacement instruction snapshot");
+    assert_eq!(second.text(), "original user\n\nguide B\n\noriginal thread");
+    assert_eq!(second.sources().collect::<Vec<_>>(), sources);
+    assert_eq!(second.sdk_file_receipts(|text| text.to_owned()), receipts);
+    let cleared = second
+        .with_instructions(Some(user), Some(thread), None)
+        .expect("original sources remain");
+    assert_eq!(cleared.text(), "original user\n\noriginal thread");
+    assert!(
+        LoadedAgentsMd::default()
+            .with_instructions(None, None, Some(" \t".to_owned()))
+            .is_none()
+    );
+}
