+    /// Capture accounting authority for the named running turn. The SDK binding
+    /// must separately prove that the caller owns an admitted callback.
+    pub async fn capture_auxiliary_response(
+        &self,
+        expected_turn_id: &str,
+    ) -> Option<crate::AuxiliaryResponse> {
+        let active = self.session.active_turn.lock().await;
+        let active = active.as_ref()?;
+        let task = active.task.as_ref()?;
+        if task.turn_context.sub_id != expected_turn_id || task.cancellation_token.is_cancelled() {
+            return None;
+        }
+        Some(crate::AuxiliaryResponse {
+            session: self.session.clone(),
+            turn: task.turn_context.clone(),
+            turn_state: active.turn_state.clone(),
+            completion_id: uuid::Uuid::now_v7().to_string(),
+        })
+    }
