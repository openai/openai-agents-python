@@ -0,0 +1,90 @@
+//! Accounting for a completed provider call made by an admitted SDK callback.
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use crate::state::TurnState;
+use codex_protocol::ResponseUsageMetadata;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::ResponseObservation;
+use codex_protocol::protocol::TokenUsage;
+use std::sync::Arc;
+use tokio::sync::Mutex;
+
+/// An exact-turn completion receipt. Bindings must check callback authority before
+/// capture, join commit during cancellation, and commit before releasing that owner.
+/// This handle is deliberately neither cloneable nor reusable after a failed commit.
+pub struct AuxiliaryResponse {
+    pub(crate) session: Arc<Session>,
+    pub(crate) turn: Arc<TurnContext>,
+    pub(crate) turn_state: Arc<Mutex<TurnState>>,
+    pub(crate) completion_id: String,
+}
+
+impl AuxiliaryResponse {
+    /// Local identity used to acknowledge host consumption of the completion event.
+    pub fn completion_id(&self) -> &str {
+        &self.completion_id
+    }
+
+    /// Commit known terminal facts once, even when the captured turn is cancelling.
+    /// The caller must join this future; dropping it can leave a partial commit.
+    /// Provider identity belongs in the observation, not this local completion ID.
+    pub async fn commit(
+        self,
+        observation: ResponseObservation,
+        usage: Option<TokenUsage>,
+        usage_metadata: Option<ResponseUsageMetadata>,
+        model: Option<String>,
+    ) -> CodexResult<()> {
+        self.session
+            .record_auxiliary_response(
+                &self,
+                observation,
+                valid_usage(usage),
+                usage_metadata,
+                model.as_deref(),
+            )
+            .await
+    }
+}
+
+fn valid_usage(usage: Option<TokenUsage>) -> Option<TokenUsage> {
+    usage.filter(|usage| {
+        [
+            usage.input_tokens,
+            usage.cached_input_tokens,
+            usage.cache_write_input_tokens,
+            usage.output_tokens,
+            usage.reasoning_output_tokens,
+            usage.total_tokens,
+        ]
+        .into_iter()
+        .all(|count| count >= 0)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn missing_and_negative_usage_remain_unknown() {
+        assert!(valid_usage(None).is_none());
+        for index in 0..6 {
+            let mut usage = TokenUsage::default();
+            let counters = [
+                &mut usage.input_tokens,
+                &mut usage.cached_input_tokens,
+                &mut usage.cache_write_input_tokens,
+                &mut usage.output_tokens,
+                &mut usage.reasoning_output_tokens,
+                &mut usage.total_tokens,
+            ];
+            *counters.into_iter().nth(index).unwrap() = -1;
+            assert!(valid_usage(Some(usage)).is_none());
+        }
+        assert_eq!(
+            valid_usage(Some(TokenUsage::default())),
+            Some(TokenUsage::default())
+        );
+    }
+}
