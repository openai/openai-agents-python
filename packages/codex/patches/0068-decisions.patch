@@ -5085,6 +5085,70 @@ impl Session {
             .await;
     }
 
+    pub(crate) async fn record_auxiliary_response(
+        &self,
+        completion: &crate::AuxiliaryResponse,
+        observation: codex_protocol::protocol::ResponseObservation,
+        usage: Option<TokenUsage>,
+        usage_metadata: Option<ResponseUsageMetadata>,
+        model: Option<&str>,
+    ) -> CodexResult<()> {
+        let turn_context = completion.turn.as_ref();
+        let turn_state = &completion.turn_state;
+        let completion_id = completion.completion_id.as_str();
+        let observation_result = self
+            .record_response_observation(turn_context, observation)
+            .await;
+        // A retention error must not discard already known completed spending.
+        let mut budget_result = Ok(());
+        if let Some(usage) = usage.as_ref() {
+            let info = {
+                let mut state = self.state.lock().await;
+                let mut info = state.token_info().unwrap_or(TokenUsageInfo {
+                    total_token_usage: TokenUsage::default(),
+                    last_token_usage: TokenUsage::default(),
+                    model_context_window: None,
+                });
+                info.total_token_usage.add_assign(usage);
+                state.set_token_info(Some(info.clone()));
+                info
+            };
+            if let Some(model) = model {
+                turn_state.lock().await.token_usage_by_model.record(
+                    model,
+                    turn_context
+                        .initial_settings
+                        .telemetry(&turn_context.session_telemetry),
+                    usage,
+                );
+            }
+            budget_result = self.record_rollout_budget_usage(usage).await;
+            for contributor in self.services.extensions.token_usage_contributors() {
+                contributor
+                    .on_token_usage(
+                        &self.services.session_extension_data,
+                        &self.services.thread_extension_data,
+                        turn_context.extension_data.as_ref(),
+                        &info,
+                    )
+                    .await;
+            }
+        }
+        self.send_token_count_event(turn_context).await;
+        // Publish the completion marker only after its usage snapshot. The host
+        // joins native commit and consumes this marker before releasing the callback.
+        self.record_observed_response_completed(
+            turn_context,
+            completion_id,
+            observation_result.as_ref().ok().cloned().flatten(),
+            usage.as_ref(),
+            usage_metadata.as_ref(),
+        )
+        .await;
+        observation_result?;
+        budget_result
+    }
+
     pub(crate) async fn record_token_usage_info(
         &self,
         turn_context: &TurnContext,
diff --git a/codex-rs/core/src/session/tests.rs b/codex-rs/core/src/session/tests.rs
index a7e22212a197501eaf0f27c20e25524bfd935613..1370c37c5e3723142487e6d292fc17afa5d79c66 100644
--- a/codex-rs/core/src/session/tests.rs
+++ b/codex-rs/core/src/session/tests.rs
@@ -13896,3 +13896,99 @@ async fn interrupting_regular_error_publication_uses_the_abort_owner() {
 
 #[path = "terminal_tool_tests.rs"]
 mod terminal_tool_tests;
+
+#[tokio::test]
+async fn auxiliary_completion_keeps_captured_turn_and_context_measurement() {
+    for usage in [
+        Some(TokenUsage {
+            total_tokens: 7,
+            ..Default::default()
+        }),
+        None,
+        Some(TokenUsage {
+            total_tokens: -1,
+            ..Default::default()
+        }),
+    ] {
+        let (session, turn, rx) = make_session_and_context_with_rx().await;
+        let original = TokenUsageInfo {
+            total_token_usage: TokenUsage {
+                total_tokens: 99,
+                ..Default::default()
+            },
+            last_token_usage: TokenUsage {
+                input_tokens: 91,
+                total_tokens: 99,
+                ..Default::default()
+            },
+            model_context_window: Some(123_456),
+        };
+        session
+            .state
+            .lock()
+            .await
+            .set_token_info(Some(original.clone()));
+        let expected_usage = usage
+            .as_ref()
+            .filter(|usage| usage.total_tokens >= 0)
+            .cloned();
+        let completion = crate::AuxiliaryResponse {
+            session: session.clone(),
+            turn: turn.clone(),
+            turn_state: Arc::new(tokio::sync::Mutex::new(crate::state::TurnState::default())),
+            completion_id: "local-auxiliary-completion".to_string(),
+        };
+        // A captured response remains accountable after the active owner retires.
+        *session.active_turn.lock().await = None;
+        completion
+            .commit(
+                codex_protocol::protocol::ResponseObservation {
+                    response_id: None,
+                    upstream_request_id: Some("provider-request".to_string()),
+                    status: codex_protocol::protocol::ResponseObservationStatus::Completed,
+                    incomplete_reason: None,
+                    usage: None,
+                },
+                usage,
+                None,
+                Some("auxiliary-model".to_string()),
+            )
+            .await
+            .unwrap();
+        let info = session.token_usage_info().await.unwrap();
+        assert_eq!(info.last_token_usage, original.last_token_usage);
+        assert_eq!(info.model_context_window, original.model_context_window);
+        assert_eq!(
+            info.total_token_usage.total_tokens,
+            if expected_usage.is_some() { 106 } else { 99 }
+        );
+        let mut event_order = Vec::new();
+        while let Ok(event) = rx.try_recv() {
+            assert_eq!(event.id, turn.sub_id);
+            match event.msg {
+                EventMsg::TokenCount(event) => {
+                    event_order.push("token_count");
+                    assert_eq!(event.info.as_ref(), Some(&info));
+                }
+                EventMsg::RawResponseCompleted(event) => {
+                    event_order.push("raw_response_completed");
+                    assert_eq!(event.response_id, "local-auxiliary-completion");
+                    assert_eq!(event.token_usage, expected_usage);
+                }
+                _ => {}
+            }
+        }
+        assert_eq!(event_order, ["token_count", "raw_response_completed"]);
+        let record = session.state.lock().await.latest_token_usage_record.clone();
+        if let Some(usage) = expected_usage {
+            let record = record.expect("completed usage receipt");
+            assert_eq!(record.turn_id, turn.sub_id);
+            assert_eq!(record.response_id, "local-auxiliary-completion");
+            assert_eq!(record.usage, usage);
+            assert_eq!(record.turn_token_usage.total_tokens, 7);
+            assert_eq!(record.thread_token_usage.total_tokens, 7);
+        } else {
+            assert!(record.is_none());
+        }
+    }
+}
