+use codex_utils_path_uri::PathUri;
+use std::io;
+use std::path::Path;
+use tokio_util::sync::CancellationToken;
+
+use crate::WalkOptions;
+use crate::no_follow;
+use crate::walk::sync_walk;
+
+pub(crate) fn options() -> WalkOptions {
+    WalkOptions {
+        no_follow: true,
+        max_depth: 64,
+        max_directories: 1000,
+        max_entries: 10_000,
+        follow_directory_symlinks: false,
+        prune_hidden_directories: false,
+    }
+}
+
+fn invalid_filename(index: usize) -> std::ffi::OsString {
+    let name = format!("invalid-{index}-");
+    #[cfg(unix)]
+    {
+        use std::os::unix::ffi::OsStringExt;
+        let mut bytes = name.into_bytes();
+        bytes.push(0xff);
+        std::ffi::OsString::from_vec(bytes)
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::ffi::OsStringExt;
+        let units: Vec<u16> = name.encode_utf16().chain([0xd800]).collect();
+        std::ffi::OsString::from_wide(&units)
+    }
+}
+
+fn create_invalid_filename_fixture(base: &Path) -> io::Result<bool> {
+    let mut file = match std::fs::File::create(base.join(invalid_filename(0))) {
+        Ok(file) => file,
+        #[cfg(unix)]
+        Err(error) if error.raw_os_error() == Some(libc::EILSEQ) => {
+            eprintln!("not applicable: filesystem rejects invalid filename bytes ({error})");
+            return Ok(false);
+        }
+        Err(error) => return Err(error),
+    };
+    std::io::Write::write_all(&mut file, b"unrepresentable")?;
+    Ok(true)
+}
+
+#[test]
+fn invalid_filename_preserves_valid_siblings_and_descendants() -> io::Result<()> {
+    let temp = tempfile::tempdir()?;
+    let base = temp.path().canonicalize()?;
+    std::fs::write(base.join("good.txt"), "needle")?;
+    if !create_invalid_filename_fixture(&base)? {
+        return Ok(());
+    }
+    std::fs::create_dir(base.join("nested"))?;
+    std::fs::write(base.join("nested/match.txt"), "needle")?;
+    let root = PathUri::from_host_native_path(&base)?;
+    let result = sync_walk(&root, options(), &CancellationToken::new())?;
+    assert_eq!(result.entries.len(), 3);
+    for name in ["good.txt", "nested", "nested/match.txt"] {
+        let expected = root.join(name).unwrap();
+        assert!(result.entries.iter().any(|entry| entry.path == expected));
+    }
+    assert_eq!(result.errors.len(), 1);
+    assert_eq!(result.errors[0].path, root);
+    assert!(
+        !result.truncated,
+        "the error is not an entry-limit truncation"
+    );
+    Ok(())
+}
+
+#[test]
+fn invalid_filenames_consume_the_entry_budget() -> io::Result<()> {
+    let temp = tempfile::tempdir()?;
+    let base = temp.path().canonicalize()?;
+    if !create_invalid_filename_fixture(&base)? {
+        return Ok(());
+    }
+    for index in 1..8 {
+        std::fs::write(base.join(invalid_filename(index)), "unrepresentable")?;
+    }
+    let root = PathUri::from_host_native_path(&base)?;
+    let mut limits = options();
+    limits.max_entries = 3;
+    let result = sync_walk(&root, limits, &CancellationToken::new())?;
+    assert!(result.entries.is_empty());
+    assert_eq!(result.errors.len(), 3);
+    assert!(result.errors.iter().all(|error| error.path == root));
+    assert!(result.truncated);
+    let entries = no_follow::read_directory_bounded(&base, 4, &CancellationToken::new())?;
+    assert_eq!(entries.len(), 4, "including only the bounded extra probe");
+    Ok(())
+}
+
+#[test]
+fn invalid_filename_cancellation_and_setup_failures_stay_outer() -> io::Result<()> {
+    let temp = tempfile::tempdir()?;
+    let base = temp.path().canonicalize()?;
+    // These assertions also apply when the filesystem rejects invalid filenames.
+    let _ = create_invalid_filename_fixture(&base)?;
+    let cancelled = CancellationToken::new();
+    cancelled.cancel();
+    let error = no_follow::read_directory_bounded(&base, 4, &cancelled).unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::Interrupted);
+    assert!(
+        no_follow::read_directory_bounded(&base.join("missing"), 4, &CancellationToken::new(),)
+            .is_err()
+    );
+    Ok(())
+}
