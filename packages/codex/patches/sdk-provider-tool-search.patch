+#[derive(Clone, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ClientToolSearchSelection {
+    pub tool_refs: Vec<ToolName>,
+    #[serde(default)]
+    pub catalog_generation: Option<String>,
+}
+
+impl ClientToolSearchSelection {
+    pub fn from_response(
+        response: &codex_protocol::dynamic_tools::DynamicToolResponse,
+    ) -> Result<Self, crate::FunctionCallError> {
+        use codex_protocol::dynamic_tools::DynamicToolCallOutputContentItem;
+        if !response.success {
+            return Err(crate::FunctionCallError::RespondToModel(
+                "Client tool search failed".into(),
+            ));
+        }
+        let [DynamicToolCallOutputContentItem::InputText { text }] =
+            response.content_items.as_slice()
+        else {
+            return Err(crate::FunctionCallError::RespondToModel(
+                "Client tool search requires a JSON selection".into(),
+            ));
+        };
+        serde_json::from_str(text).map_err(|_| {
+            crate::FunctionCallError::RespondToModel("Invalid client tool search selection".into())
+        })
+    }
+
+    pub fn resolve(
+        &self,
+        captured_catalog: &[ClientToolSearchEntry],
+        admitted_new_catalog: &[ClientToolSearchEntry],
+    ) -> Result<crate::ToolSearchOutput, crate::FunctionCallError> {
+        let mut catalog = std::collections::HashMap::new();
+        for entry in captured_catalog.iter().chain(admitted_new_catalog) {
+            let key = entry.name.clone().with_default_namespace();
+            if catalog.insert(key, entry).is_some() {
+                return Err(crate::FunctionCallError::RespondToModel(
+                    "Client tool search cannot replace a captured tool".into(),
+                ));
+            }
+        }
+        let mut seen = std::collections::HashSet::new();
+        let mut tools = Vec::new();
+        for name in &self.tool_refs {
+            let key = name.clone().with_default_namespace();
+            if !seen.insert(key.clone()) {
+                continue;
+            }
+            let entry = catalog.get(&key).ok_or_else(|| {
+                crate::FunctionCallError::RespondToModel(
+                    "Client tool search selected a tool outside its captured catalog".into(),
+                )
+            })?;
+            tools.push(entry.info.entry.to_loadable_spec());
+        }
+        Ok(crate::ToolSearchOutput {
+            tools: crate::coalesce_loadable_tool_specs(tools),
+        })
+    }
+}
+
+impl ClientToolSearchCall {
+    pub fn load_default(
+        &self,
+        paths: &[String],
+    ) -> Result<Vec<ToolName>, crate::FunctionCallError> {
+        use std::collections::{BTreeMap, HashSet};
+        let mut plain = BTreeMap::new();
+        let mut namespaces: BTreeMap<String, Vec<&ClientToolSearchEntry>> = BTreeMap::new();
+        let mut qualified = BTreeMap::new();
+        for entry in self.catalog.iter().filter(|entry| entry.deferred) {
+            if entry.name.is_default_namespace() {
+                plain.insert(entry.name.name.clone(), entry);
+            } else if let Some(namespace) = &entry.name.namespace {
+                namespaces.entry(namespace.clone()).or_default().push(entry);
+                qualified.insert(format!("{namespace}.{}", entry.name.name), entry);
+            }
+        }
+        for path in paths {
+            if usize::from(plain.contains_key(path))
+                + usize::from(namespaces.contains_key(path))
+                + usize::from(qualified.contains_key(path))
+                > 1
+            {
+                return Err(crate::FunctionCallError::RespondToModel(
+                    "Ambiguous deferred tool search path".into(),
+                ));
+            }
+        }
+        let requested_namespaces: HashSet<_> = paths
+            .iter()
+            .filter(|path| namespaces.contains_key(*path))
+            .collect();
+        let mut seen = HashSet::new();
+        let mut selected = Vec::new();
+        for path in paths {
+            let entries = if let Some(entry) = plain.get(path) {
+                vec![*entry]
+            } else if let Some(entries) = namespaces.get(path) {
+                entries.clone()
+            } else if let Some(entry) = qualified.get(path) {
+                if entry
+                    .name
+                    .namespace
+                    .as_ref()
+                    .is_some_and(|namespace| requested_namespaces.contains(namespace))
+                {
+                    continue;
+                }
+                vec![*entry]
+            } else {
+                Vec::new()
+            };
+            for entry in entries {
+                if seen.insert(entry.name.clone().with_default_namespace()) {
+                    selected.push(entry.name.clone());
+                }
+            }
+        }
+        Ok(selected)
+    }
+}
