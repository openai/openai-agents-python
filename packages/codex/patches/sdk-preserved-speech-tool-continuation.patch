+#[tokio::test]
+async fn media_preservation_keeps_published_continuation_until_tool_retirement() {
+    let sdk = super::SdkRealtimeState::new("media-published".into());
+    register_media_interrupt_test_call(&sdk, "owned", "a", true, Some("root"), None).await;
+    sdk.preserve_admitted_tools(Some("a"), &[]).await;
+    sdk.pending.lock().await.remove("owned");
+    sdk.seen
+        .lock()
+        .await
+        .get_mut("owned")
+        .unwrap()
+        .output_published = true;
+    sdk.retire_tool_work(false, Some("a"), true).await;
+    assert!(sdk.seen.lock().await["owned"].preserve_on_response_cancel);
+    assert!(
+        !sdk.function_calls.lock().await["owned"]
+            .cancel
+            .is_cancelled()
+    );
+    sdk.retire_tool_work(false, Some("a"), false).await;
+    assert!(!sdk.seen.lock().await["owned"].preserve_on_response_cancel);
+    assert!(
+        sdk.function_calls.lock().await["owned"]
+            .cancel
+            .is_cancelled()
+    );
+}
