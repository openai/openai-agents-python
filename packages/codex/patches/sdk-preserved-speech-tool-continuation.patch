+#[tokio::test]
+async fn deferred_native_continuation_keeps_original_call_ownership() {
+    let (connection, _, server) = sdk_wire_connection().await;
+    let writer = connection.writer();
+    let sdk = super::SdkRealtimeState::new("deferred-owner".into());
+    assert!(sdk.register_for_response("owned", Some("a")).await.unwrap());
+    let original = sdk.seen.lock().await["owned"].ownership_id.clone();
+    sdk.seen.lock().await.shift_remove("owned");
+    sdk.pending.lock().await.remove("owned");
+    assert!(sdk.register_for_response("owned", Some("a")).await.unwrap());
+    {
+        let mut seen = sdk.seen.lock().await;
+        let replacement = seen.get_mut("owned").unwrap();
+        assert_ne!(replacement.ownership_id, original);
+        replacement.output_published = true;
+        replacement.preserve_on_response_cancel = true;
+    }
+    let mut responses = super::RealtimeResponseCreateQueue::default();
+    responses.active_default_response = true;
+    super::request_sdk_native_response(
+        &sdk,
+        &writer,
+        &mut responses,
+        super::NativeResponseRequest {
+            response_id: "a".into(),
+            call_id: "owned".into(),
+            accepted: None,
+            ownership_id: Some(original.clone()),
+            origin: None,
+        },
+        None,
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        responses
+            .pending_native_create
+            .as_ref()
+            .unwrap()
+            .ownership_id
+            .as_ref(),
+        Some(&original)
+    );
+    responses
+        .mark_finished(&writer, "retired owner", Some(&sdk))
+        .await
+        .unwrap();
+    assert!(!responses.active_default_response);
+    assert!(responses.pending_native_create.is_none());
+    server.abort();
+}
