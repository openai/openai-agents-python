+impl Event {
+    /// Project a live SDK event, including observations excluded from stored protocols.
+    pub fn sdk_json(&self) -> serde_json::Result<serde_json::Value> {
+        if let EventMsg::SdkRawProviderEvent(event) = &self.msg {
+            return Ok(serde_json::json!({
+                "id": &self.id,
+                "msg": {
+                    "type": "sdk_raw_provider_event",
+                    "source": "responses",
+                    "transport": event.transport,
+                    "payload": &event.payload,
+                },
+            }));
+        }
+        serde_json::to_value(self)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ResponsesEventTransport {
+    Sse,
+    Websocket,
+    Json,
+}
+
+#[derive(Clone)]
+pub struct SdkRawProviderEvent {
+    pub transport: ResponsesEventTransport,
+    pub payload: serde_json::Value,
+}
+
+impl std::fmt::Debug for SdkRawProviderEvent {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SdkRawProviderEvent")
+            .field("transport", &self.transport)
+            .finish_non_exhaustive()
+    }
+}
