+const MAX_MCP_PROMPT_CATALOG_BYTES: usize = 8 * 1024 * 1024;
+
+// Count serialized page arrays without retaining a second copy of the catalog.
+// Array punctuation makes this a conservative bound on the final combined array.
+struct PromptCatalogBudget(usize);
+
+impl std::io::Write for PromptCatalogBudget {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        if bytes.len() > self.0 {
+            return Err(std::io::Error::other("prompt catalog byte limit exceeded"));
+        }
+        self.0 -= bytes.len();
+        Ok(bytes.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
