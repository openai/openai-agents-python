+async fn real_ingress_during_policy_review(list: bool) {
+    tokio::time::timeout(std::time::Duration::from_secs(10), async move {
+        let router = ElicitationRequestRouter::default();
+        let entered = Arc::new(tokio::sync::Notify::new());
+        let release = Arc::new(tokio::sync::Semaphore::new(0));
+        let completed = Arc::new(tokio::sync::Semaphore::new(0));
+        let manager = ElicitationRequestManager::new(
+            batch_authority().config,
+            Some(Arc::new(HoldIngressPolicy {
+                entered: entered.clone(),
+                release: release.clone(),
+            })),
+            None,
+            router.clone(),
+        );
+        let (events, received) = async_channel::unbounded();
+        let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let client = Arc::new(
+            codex_rmcp_client::RmcpClient::new_in_process_client(Arc::new(IngressPeer {
+                list,
+                calls: calls.clone(),
+            }))
+            .await
+            .unwrap(),
+        );
+        client
+            .initialize_with_url_notifications(
+                rmcp::model::InitializeRequestParams::new(
+                    rmcp::model::ClientCapabilities::default(),
+                    rmcp::model::Implementation::new("ingress-test", "1"),
+                ),
+                Some(std::time::Duration::from_secs(5)),
+                Arc::new(move |instance| {
+                    manager.make_sender_with_connection(
+                        "one".into(),
+                        Some(events.clone()),
+                        &ClientMcpExtensions::default(),
+                        Some(instance),
+                    )
+                }),
+                Some(Arc::new({
+                    let router = router.clone();
+                    let completed = completed.clone();
+                    move |instance, event| {
+                        if matches!(&event, UrlNotification::Complete(_)) {
+                            completed.add_permits(1);
+                        }
+                        router.url_notification("one", instance, event);
+                    }
+                })),
+            )
+            .await
+            .unwrap();
+        let task = tokio::spawn({
+            let client = client.clone();
+            async move {
+                client
+                    .call_tool("synthetic".into(), None, None, None)
+                    .await
+                    .unwrap()
+            }
+        });
+        entered.notified().await;
+        let count = if list { 2 } else { 1 };
+        completed.acquire_many_owned(count).await.unwrap().forget();
+        assert!(
+            received.try_recv().is_err(),
+            "Policy must precede public consent"
+        );
+        assert!(router.urls.lock().unwrap().is_empty());
+        assert!(router.requests.lock().unwrap().is_empty());
+        release.add_permits(count as usize);
+        let mut tokens = Vec::new();
+        for _ in 0..count {
+            tokens.push(event_token(received.recv().await.unwrap()));
+        }
+        assert!(!task.is_finished(), "A completion is not consent");
+        for token in tokens {
+            router
+                .resolve(
+                    "one".into(),
+                    RequestId::String(token.into()),
+                    ElicitationResponse {
+                        action: ElicitationAction::Accept,
+                        content: None,
+                        meta: None,
+                    },
+                )
+                .await
+                .unwrap();
+        }
+        for _ in 0..count {
+            assert!(matches!(
+                received.recv().await.unwrap().msg,
+                EventMsg::ElicitationStatus {
+                    completed: true,
+                    ..
+                }
+            ));
+        }
+        let result = task.await.unwrap();
+        assert_eq!(result.is_error, list.then_some(true));
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        assert!(router.requests.lock().unwrap().is_empty());
+        client.shutdown().await;
+    })
+    .await
+    .expect("Ingress completion must survive policy delay");
+}
+#[tokio::test]
+async fn direct_wire_completion_before_policy_returns_survives_until_consent() {
+    real_ingress_during_policy_review(false).await;
+}
+#[tokio::test]
+async fn required_list_wire_completion_before_policy_returns_survives_until_all_consents() {
+    real_ingress_during_policy_review(true).await;
+}
+
+#[tokio::test]
+async fn accepted_owned_url_after_source_revoke_uses_only_its_original_admission() {
+    for complete in [true, false] {
+        let router = ElicitationRequestRouter::default();
+        router.connection_opened("one", 1);
+        router.owned_mode.store(true, Ordering::Release);
+        let identity: Arc<dyn std::any::Any + Send + Sync> = Arc::new(());
+        let cancellation = tokio_util::sync::CancellationToken::new();
+        let admission = codex_rmcp_client::ElicitationOwner::for_cancellable_admission(
+            "turn".into(),
+            identity.clone(),
+            &cancellation,
+        );
+        *router.admission_owner.lock().unwrap() = Some(admission);
+        let source = codex_rmcp_client::ElicitationOwner::for_admission("turn".into(), identity);
+        let worker = router.clone();
+        let original_source = source.clone();
+        let (events, received) = async_channel::unbounded();
+        let task = tokio::spawn(async move {
+            codex_rmcp_client::scope_owner(
+                Some(original_source),
+                worker.request_user_interaction_with_url(
+                    Some(events),
+                    &batch_authority(),
+                    "one".into(),
+                    ElicitationRequest::Url {
+                        meta: None,
+                        message: "Consent".into(),
+                        url: "https://example.invalid".into(),
+                        elicitation_id: "A".into(),
+                    },
+                    Some(1),
+                ),
+            )
+            .await
+        });
+        let id = RequestId::String(event_token(received.recv().await.unwrap()).into());
+        let receipt = router.owned_url_receipt("one", &id, "turn").unwrap();
+        assert!(router.resolve_owned(
+            "one",
+            &id,
+            "turn",
+            ElicitationResponse {
+                action: ElicitationAction::Accept,
+                content: None,
+                meta: None
+            }
+        ));
+        assert_eq!(
+            task.await.unwrap().unwrap().action,
+            ElicitationAction::Accept
+        );
+        source.revoke();
+        assert!(router.owned_url_pending("one", &id, "turn"));
+        assert_eq!(*receipt.borrow(), None);
+        if complete {
+            router.url_notification("one", 1, UrlNotification::Complete("A".into()));
+        } else {
+            cancellation.cancel();
+        }
+        let event = tokio::time::timeout(std::time::Duration::from_secs(1), received.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(
+            matches!(event.msg,EventMsg::ElicitationStatus { completed,.. } if completed==complete)
+        );
+        assert_eq!(*receipt.borrow(), Some(complete));
+        assert!(!router.owned_url_pending("one", &id, "turn"));
+        cancellation.cancel();
+        router.url_notification("one", 1, UrlNotification::Complete("A".into()));
+        assert_eq!(
+            *receipt.borrow(),
+            Some(complete),
+            "The first terminal receipt stays immutable"
+        );
+    }
+}
