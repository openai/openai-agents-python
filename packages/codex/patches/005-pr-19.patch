+impl ClientConnection {
+    fn new(service: RunningService<RoleClient, ElicitationClientService>, owned: bool) -> Self {
+        if !owned {
+            return Self::Shared(service);
+        }
+        let peer = service.peer().clone();
+        let handler = service.service().clone();
+        let cancellation = service.cancellation_token();
+        let retirement = handler.clone();
+        let task = tokio::spawn(async move {
+            let result = service
+                .waiting()
+                .await
+                .map(|_| ())
+                .map_err(|error| error.to_string());
+            retirement.retire_url_transport();
+            result
+        });
+        Self::Owned {
+            peer,
+            handler,
+            cancellation: std::sync::Mutex::new(Some(cancellation)),
+            completion: async move { task.await.map_err(|error| error.to_string())? }
+                .boxed()
+                .shared(),
+        }
+    }
+}
+
+impl ClientService {
+    pub(crate) fn peer(&self) -> &rmcp::service::Peer<RoleClient> {
+        match &self.connection {
+            ClientConnection::Shared(service) => service.peer(),
+            ClientConnection::Owned { peer, .. } => peer,
+        }
+    }
+    pub(crate) fn service(&self) -> &ElicitationClientService {
+        match &self.connection {
+            ClientConnection::Shared(service) => service.service(),
+            ClientConnection::Owned { handler, .. } => handler,
+        }
+    }
+    pub(crate) fn is_closed(&self) -> bool {
+        match &self.connection {
+            ClientConnection::Shared(service) => {
+                service.is_closed() || service.peer().is_transport_closed()
+            }
+            ClientConnection::Owned {
+                peer, cancellation, ..
+            } => {
+                cancellation
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                    .is_none()
+                    || peer.is_transport_closed()
+            }
+        }
+    }
+    async fn stop_owned(&self) -> Result<()> {
+        self.service().retire_url_transport();
+        if let ClientConnection::Owned {
+            cancellation,
+            completion,
+            ..
+        } = &self.connection
+        {
+            if let Some(token) = cancellation
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .take()
+            {
+                token.cancel();
+            }
+            completion.clone().await.map_err(anyhow::Error::msg)?;
+        }
+        Ok(())
+    }
