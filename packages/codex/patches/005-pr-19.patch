--- /dev/null
+++ b/codex-rs/core/src/owned_question.rs
@@ -0,0 +1,323 @@
+//! A pending prompt captured from its original native turn, never the active successor.
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use crate::state::TurnState;
+use codex_protocol::protocol::{Event, EventMsg, Op, ReviewDecision};
+use rmcp::model::RequestId;
+use std::sync::Arc;
+use tokio::sync::Mutex;
+
+#[derive(Clone)]
+enum QuestionKey {
+    Approval(String),
+    Elicitation(String, RequestId),
+}
+#[derive(Clone)]
+pub struct OwnedQuestion {
+    session: Arc<Session>,
+    turn: Arc<TurnContext>,
+    state: Arc<Mutex<TurnState>>,
+    key: QuestionKey,
+    identity: Option<Arc<String>>,
+    url_receipt: Option<tokio::sync::watch::Receiver<Option<bool>>>,
+}
+impl OwnedQuestion {
+    pub(crate) async fn capture(session: Arc<Session>, event: &Event) -> Option<Self> {
+        let (turn_id, key) = match &event.msg {
+            EventMsg::ExecApprovalRequest(request) => (
+                request.turn_id.as_str(),
+                QuestionKey::Approval(
+                    request
+                        .approval_id
+                        .clone()
+                        .unwrap_or_else(|| request.call_id.clone()),
+                ),
+            ),
+            EventMsg::ApplyPatchApprovalRequest(request) => (
+                request.turn_id.as_str(),
+                QuestionKey::Approval(request.call_id.clone()),
+            ),
+            EventMsg::ElicitationRequest(request) => {
+                let id = match &request.id {
+                    codex_protocol::mcp::RequestId::String(id) => {
+                        RequestId::String(id.clone().into())
+                    }
+                    codex_protocol::mcp::RequestId::Integer(id) => RequestId::Number(*id),
+                };
+                (
+                    request.turn_id.as_deref()?,
+                    QuestionKey::Elicitation(request.server_name.clone(), id),
+                )
+            }
+            _ => return None,
+        };
+        let active = session.active_turn.lock().await;
+        let active = active.as_ref()?;
+        let task = active.task.as_ref()?;
+        if task.turn_context.sub_id != turn_id || task.cancellation_token.is_cancelled() {
+            return None;
+        }
+        let mut grant = Self {
+            session: session.clone(),
+            turn: task.turn_context.clone(),
+            state: active.turn_state.clone(),
+            key,
+            identity: None,
+            url_receipt: None,
+        };
+        let state = grant.state.lock().await;
+        let identity = match &grant.key {
+            QuestionKey::Approval(id) => state.approval_identity(id),
+            QuestionKey::Elicitation(server, id) => state.elicitation_identity(server, id),
+        };
+        drop(state);
+        if let Some(identity) = &identity {
+            if event.id != format!("sdk-question:{}", identity.as_str()) {
+                return None;
+            }
+        } else if let QuestionKey::Elicitation(server, id) = &grant.key {
+            let original = grant
+                .session
+                .services
+                .mcp_runtime
+                .owned_elicitation_admission(server, id)?
+                .downcast::<TurnContext>()
+                .ok()?;
+            if !Arc::ptr_eq(&original, &grant.turn) {
+                return None;
+            }
+        } else {
+            return None;
+        }
+        if let QuestionKey::Elicitation(server, id) = &grant.key {
+            grant.url_receipt = grant
+                .session
+                .services
+                .mcp_runtime
+                .owned_url_completion_receipt(server, id, &grant.turn.sub_id);
+        }
+        grant.identity = identity;
+        let state = grant.state.lock().await;
+        let pending = grant.pending_in(&state);
+        drop(state);
+        pending.then_some(grant)
+    }
+    fn pending_in(&self, state: &TurnState) -> bool {
+        let current = match &self.key {
+            QuestionKey::Approval(id) => state.approval_identity(id),
+            QuestionKey::Elicitation(server, id) => state.elicitation_identity(server, id),
+        };
+        if let Some(expected) = &self.identity {
+            return current.is_some_and(|current| Arc::ptr_eq(&current, expected));
+        }
+        match &self.key {
+            QuestionKey::Approval(_) => false,
+            QuestionKey::Elicitation(server, id) => self
+                .session
+                .services
+                .mcp_runtime
+                .owned_elicitation_pending(server, id, &self.turn.sub_id),
+        }
+    }
+    pub async fn is_pending(&self) -> bool {
+        let active = self.session.active_turn.lock().await;
+        let Some(active) = active.as_ref() else {
+            return false;
+        };
+        if !active.task.as_ref().is_some_and(|task| {
+            Arc::ptr_eq(&task.turn_context, &self.turn) && !task.cancellation_token.is_cancelled()
+        }) || !Arc::ptr_eq(&active.turn_state, &self.state)
+        {
+            return false;
+        }
+        let state = self.state.lock().await;
+        self.pending_in(&state)
+    }
+    /// Reads the immutable outcome produced by this original URL's native owner.
+    /// None means live and incomplete; a terminal receipt survives transport cleanup.
+    pub async fn url_completion_status(&self) -> Option<bool> {
+        let Some(receipt) = &self.url_receipt else {
+            return Some(false);
+        };
+        let terminal = *receipt.borrow();
+        if terminal.is_some() {
+            return terminal;
+        }
+        let active = self.session.active_turn.lock().await;
+        let live = active.as_ref().is_some_and(|active| {
+            Arc::ptr_eq(&active.turn_state, &self.state)
+                && active.task.as_ref().is_some_and(|task| {
+                    Arc::ptr_eq(&task.turn_context, &self.turn)
+                        && !task.cancellation_token.is_cancelled()
+                })
+        });
+        let pending = live
+            && match &self.key {
+                QuestionKey::Elicitation(server, id) => self
+                    .session
+                    .services
+                    .mcp_runtime
+                    .owned_url_completion_pending(server, id, &self.turn.sub_id),
+                _ => false,
+            };
+        // Completion can linearize before admission cleanup while its event is queued.
+        // Re-read the captured receipt after the active-turn/pending checks.
+        let terminal = *receipt.borrow();
+        terminal.or(if pending { None } else { Some(false) })
+    }
+    pub async fn is_url_pending(&self) -> bool {
+        self.url_completion_status().await.is_none()
+    }
+    /// A retained grant can only cancel its own still-live URL; never submit a positive reply.
+    pub async fn cancel_url_completion(&self) -> bool {
+        if self.url_receipt.is_none() {
+            return false;
+        }
+        let active = self.session.active_turn.lock().await;
+        let Some(active) = active.as_ref() else {
+            return false;
+        };
+        if !Arc::ptr_eq(&active.turn_state, &self.state)
+            || !active.task.as_ref().is_some_and(|task| {
+                Arc::ptr_eq(&task.turn_context, &self.turn)
+                    && !task.cancellation_token.is_cancelled()
+            })
+        {
+            return false;
+        }
+        match &self.key {
+            QuestionKey::Elicitation(server, id) => self
+                .session
+                .services
+                .mcp_runtime
+                .cancel_owned_url_completion(server, id, &self.turn.sub_id),
+            _ => false,
+        }
+    }
+    pub async fn respond(&self, operation: Op) -> bool {
+        // Hold the same admission lock through responder removal and send. No queued
+        // operation may resolve against a different active turn after this check.
+        let active = self.session.active_turn.lock().await;
+        let Some(active) = active.as_ref() else {
+            return false;
+        };
+        if !active.task.as_ref().is_some_and(|task| {
+            Arc::ptr_eq(&task.turn_context, &self.turn) && !task.cancellation_token.is_cancelled()
+        }) || !Arc::ptr_eq(&active.turn_state, &self.state)
+        {
+            return false;
+        }
+        let mut state = self.state.lock().await;
+        if !self.pending_in(&state) {
+            return false;
+        }
+        match (&self.key, operation) {
+            (
+                QuestionKey::Approval(expected),
+                Op::ExecApproval { id, decision, .. } | Op::PatchApproval { id, decision },
+            ) if expected == &id => {
+                // Persistent decisions and abort are outside the SDK grant.
+                if !matches!(
+                    decision,
+                    ReviewDecision::Approved | ReviewDecision::Denied { .. }
+                ) {
+                    return false;
+                }
+                state
+                    .remove_pending_approval(&id)
+                    .is_some_and(|sender| sender.send(decision).is_ok())
+            }
+            (
+                QuestionKey::Elicitation(server, expected),
+                Op::ResolveElicitation {
+                    server_name,
+                    request_id,
+                    decision,
+                    content,
+                    meta,
+                },
+            ) if server == &server_name => {
+                let id = match request_id {
+                    codex_protocol::mcp::RequestId::String(id) => RequestId::String(id.into()),
+                    codex_protocol::mcp::RequestId::Integer(id) => RequestId::Number(id),
+                };
+                if expected != &id {
+                    return false;
+                }
+                let action = match decision {
+                    codex_protocol::approvals::ElicitationAction::Accept => {
+                        codex_rmcp_client::ElicitationAction::Accept
+                    }
+                    codex_protocol::approvals::ElicitationAction::Decline => {
+                        codex_rmcp_client::ElicitationAction::Decline
+                    }
+                    codex_protocol::approvals::ElicitationAction::Cancel => {
+                        codex_rmcp_client::ElicitationAction::Cancel
+                    }
+                };
+                let response = codex_rmcp_client::ElicitationResponse {
+                    action,
+                    content,
+                    meta,
+                };
+                if let Some(sender) = state.remove_pending_elicitation(server, &id) {
+                    sender.send(response).is_ok()
+                } else {
+                    self.session.services.mcp_runtime.resolve_owned_elicitation(
+                        server,
+                        &id,
+                        &self.turn.sub_id,
+                        response,
+                    )
+                }
+            }
+            _ => false,
+        }
+    }
+}
+
+/// SDK-only prompt identity. Ordinary clients keep their original event IDs.
+pub(crate) async fn event_identity(
+    session: &Session,
+    turn: &TurnContext,
+    msg: &EventMsg,
+) -> Option<String> {
+    if !matches!(
+        msg,
+        EventMsg::ExecApprovalRequest(_)
+            | EventMsg::ApplyPatchApprovalRequest(_)
+            | EventMsg::ElicitationRequest(_)
+    ) || !turn.session_source.is_non_root_agent()
+        || !session
+            .services
+            .client_mcp_extensions
+            .contains("openai/sdk-child-prompts")
+    {
+        return None;
+    }
+    let active = session.active_turn.lock().await;
+    let active = active.as_ref()?;
+    if !active
+        .task
+        .as_ref()
+        .is_some_and(|task| std::ptr::eq(task.turn_context.as_ref(), turn))
+    {
+        return None;
+    }
+    let state = active.turn_state.lock().await;
+    let identity = match msg {
+        EventMsg::ExecApprovalRequest(request) => {
+            state.approval_identity(request.approval_id.as_deref().unwrap_or(&request.call_id))
+        }
+        EventMsg::ApplyPatchApprovalRequest(request) => state.approval_identity(&request.call_id),
+        EventMsg::ElicitationRequest(request) => {
+            let id = match &request.id {
+                codex_protocol::mcp::RequestId::String(id) => RequestId::String(id.clone().into()),
+                codex_protocol::mcp::RequestId::Integer(id) => RequestId::Number(*id),
+            };
+            state.elicitation_identity(&request.server_name, &id)
+        }
+        _ => None,
+    }?;
+    Some(format!("sdk-question:{}", identity.as_str()))
+}
diff --git a/codex-rs/core/src/session/connector_auth.rs b/codex-rs/core/src/session/connector_auth.rs
new file mode 100644
index 0000000000000000000000000000000000000000..da3b5073c9147306f1af7a21bf904bd6b950695d
--- /dev/null
+++ b/codex-rs/core/src/session/connector_auth.rs
@@ -0,0 +1,568 @@
+//! Complete one exact personal connector flow under the original tool lifetime.
+//! Provider URLs and MCP messages never authorize credentialed backend requests.
+use std::time::Duration;
+
+use codex_config::{McpServerAuth, McpServerTransportConfig};
+use codex_http_client::{ClientRouteClass, RouteAwareClientPool};
+use codex_login::CodexAuth;
+use codex_mcp::{CODEX_APPS_MCP_SERVER_NAME, CodexAppsAuthElicitationPlan, PreparedMcpCall};
+use codex_protocol::approvals::ElicitationRequest;
+use codex_rmcp_client::ElicitationAction;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use url::Url;
+
+use super::session::Session;
+use super::turn_context::TurnContext;
+use crate::config::Config;
+
+const CALLBACK: &str = "https://chatgpt.com/connector_platform_oauth_redirect";
+const TOTAL_WAIT: Duration = Duration::from_secs(120);
+const REQUEST_WAIT: Duration = Duration::from_secs(10);
+
+// A retained state cannot be replayed into a replacement local request.
+#[derive(Default)]
+struct IssuedStates(std::sync::Mutex<std::collections::HashSet<String>>);
+
+// These values are private operation state, with no Debug, event, or durable representation.
+#[derive(PartialEq, Eq)]
+struct Identity {
+    account: String,
+    user: String,
+}
+impl Identity {
+    fn capture(auth: &CodexAuth) -> Option<Self> {
+        if !matches!(
+            auth,
+            CodexAuth::Chatgpt(_) | CodexAuth::ChatgptAuthTokens(_)
+        ) {
+            return None;
+        }
+        Some(Self {
+            account: auth.get_account_id().filter(|s| valid_id(s))?,
+            user: auth.get_chatgpt_user_id().filter(|s| valid_id(s))?,
+        })
+    }
+}
+#[derive(Deserialize)]
+struct Initiated {
+    oauth_state_id: String,
+    redirect_url: String,
+}
+#[derive(Deserialize)]
+struct State {
+    status: Status,
+    connector_id: String,
+    link: Option<Link>,
+}
+#[derive(Clone, Copy, Deserialize)]
+#[serde(rename_all = "SCREAMING_SNAKE_CASE")]
+enum Status {
+    Pending,
+    Complete,
+    Error,
+}
+#[derive(Deserialize)]
+struct Link {
+    id: String,
+    connector_id: String,
+    auth_status: LinkStatus,
+    scopes: Option<Vec<String>>,
+}
+#[derive(Clone, Copy, Deserialize)]
+#[serde(rename_all = "SCREAMING_SNAKE_CASE")]
+enum LinkStatus {
+    Active,
+    ReauthRequired,
+}
+
+fn valid_id(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 1024
+        && value.trim() == value
+        && !value.chars().any(char::is_control)
+}
+
+/// Match the actual native registration, not its alias or claimed error metadata.
+fn eligible(config: &Config, call: &PreparedMcpCall) -> bool {
+    if !call.is_host_owned_apps() || call.server_name() != CODEX_APPS_MCP_SERVER_NAME {
+        return false;
+    }
+    let Some(registration) = call.config().mcp_server_catalog.server(call.server_name()) else {
+        return false;
+    };
+    let current = registration.config();
+    if !current.is_local_environment() || !matches!(current.auth, McpServerAuth::ChatGpt) {
+        return false;
+    }
+    let McpServerTransportConfig::StreamableHttp {
+        url,
+        bearer_token_env_var: None,
+        http_headers,
+        env_http_headers: None,
+        http_headers_helper: None,
+    } = &current.transport
+    else {
+        return false;
+    };
+    let originator = http_headers
+        .as_ref()
+        .and_then(|h| h.get("originator"))
+        .map(String::as_str);
+    let expected = codex_mcp::codex_apps_mcp_server_config(
+        &config.chatgpt_base_url,
+        call.config().apps_mcp_product_sku.as_deref(),
+        originator,
+    );
+    let McpServerTransportConfig::StreamableHttp {
+        url: expected_url,
+        bearer_token_env_var: None,
+        http_headers: expected_headers,
+        env_http_headers: None,
+        http_headers_helper: None,
+    } = expected.transport
+    else {
+        return false;
+    };
+    let (Ok(actual), Ok(expected)) = (Url::parse(url), Url::parse(&expected_url)) else {
+        return false;
+    };
+    actual.origin() == expected.origin()
+        && actual.path() == expected.path()
+        && actual.username().is_empty()
+        && actual.password().is_none()
+        && actual.query().is_none()
+        && actual.fragment().is_none()
+        && *http_headers == expected_headers
+}
+
+/// Recognize the configured gateway or direct server base, never the MCP endpoint.
+fn backend_base(value: &str) -> Option<Url> {
+    let mut base = Url::parse(value).ok()?;
+    let loopback = match base.host()? {
+        url::Host::Domain(name) => name == "localhost",
+        url::Host::Ipv4(ip) => ip.is_loopback(),
+        url::Host::Ipv6(ip) => ip.is_loopback(),
+    };
+    if !(base.scheme() == "https" || (base.scheme() == "http" && loopback))
+        || !base.username().is_empty()
+        || base.password().is_some()
+        || base.query().is_some()
+        || base.fragment().is_some()
+    {
+        return None;
+    }
+    let path = match base.path().trim_end_matches('/') {
+        "" if matches!(base.host_str(), Some("chatgpt.com" | "chat.openai.com")) => "/backend-api/",
+        "" | "/api" | "/api/codex" => "/api/",
+        "/backend-api" => "/backend-api/",
+        _ => return None,
+    };
+    base.set_path(path);
+    Some(base)
+}
+
+impl State {
+    fn proves(&self, plan: &CodexAppsAuthElicitationPlan) -> bool {
+        let failure = &plan.auth_failure;
+        let Some(link) = &self.link else {
+            return false;
+        };
+        matches!(self.status, Status::Complete)
+            && self.connector_id == failure.connector_id
+            && link.connector_id == failure.connector_id
+            && valid_id(&link.id)
+            && !link.id.starts_with("synthetic_link::")
+            && matches!(link.auth_status, LinkStatus::Active)
+            && (failure.auth_reason.as_deref() == Some("missing_link")
+                || failure.link_id.as_deref() == Some(link.id.as_str()))
+            && failure.requested_scopes.as_ref().is_none_or(|required| {
+                required.iter().all(|scope| {
+                    link.scopes
+                        .as_ref()
+                        .is_some_and(|actual| actual.contains(scope))
+                })
+            })
+    }
+}
+
+impl Session {
+    pub(crate) fn has_personal_apps_registration(&self) -> bool {
+        self.services
+            .thread_extension_data
+            .get::<codex_mcp::ApplicationApps>()
+            .is_some_and(|app| app.personal_auth().is_some())
+    }
+
+    pub(crate) fn connector_auth_manager(
+        &self,
+    ) -> Option<std::sync::Arc<codex_login::AuthManager>> {
+        self.services
+            .thread_extension_data
+            .get::<codex_mcp::ApplicationApps>()?
+            .personal_auth()
+    }
+
+    async fn connector_identity_is_current(
+        &self,
+        expected: &Identity,
+        call: &PreparedMcpCall,
+        transport: u64,
+    ) -> bool {
+        let Some(manager) = self.connector_auth_manager() else {
+            return false;
+        };
+        self.services
+            .thread_extension_data
+            .get::<codex_mcp::ApplicationApps>()
+            .is_some_and(|current| {
+                call.config()
+                    .application_apps
+                    .as_ref()
+                    .is_some_and(|captured| std::sync::Arc::ptr_eq(&current, captured))
+            })
+            && self
+                .services
+                .mcp_runtime
+                .prepared_call_is_current(call, transport)
+            && self.services.mcp_runtime.url_source_is_live()
+            && manager
+                .auth()
+                .await
+                .as_ref()
+                .and_then(Identity::capture)
+                .as_ref()
+                == Some(expected)
+            && self
+                .services
+                .mcp_runtime
+                .prepared_call_is_current(call, transport)
+            && self.services.mcp_runtime.url_source_is_live()
+    }
+
+    async fn connector_request<T: serde::de::DeserializeOwned>(
+        &self,
+        client: &RouteAwareClientPool,
+        identity: &Identity,
+        call: &PreparedMcpCall,
+        transport: u64,
+        url: Url,
+        body: Option<&Value>,
+    ) -> Option<T> {
+        if !self
+            .connector_identity_is_current(identity, call, transport)
+            .await
+        {
+            return None;
+        }
+        let auth = self.connector_auth_manager()?.auth().await?;
+        if Identity::capture(&auth).as_ref() != Some(identity) {
+            return None;
+        }
+        let mut request = if let Some(body) = body {
+            client.post(url).json(body)
+        } else {
+            client.get(url)
+        };
+        request = request
+            .headers(codex_login::default_client::default_headers())
+            .headers(codex_model_provider::auth_provider_from_auth(&auth).to_auth_headers())
+            .header("OAI-Product-Sku", "codex")
+            .timeout(REQUEST_WAIT);
+        if !self
+            .connector_identity_is_current(identity, call, transport)
+            .await
+        {
+            return None;
+        }
+        // Never retain request errors, response bodies, URLs, or an OAuth state in errors/logs.
+        let response = request.send().await.ok()?;
+        if !response.status().is_success() {
+            return None;
+        }
+        let value = response.json().await.ok()?;
+        self.connector_identity_is_current(identity, call, transport)
+            .await
+            .then_some(value)
+    }
+
+    pub(crate) async fn complete_connector_auth(
+        &self,
+        turn: &TurnContext,
+        call: &PreparedMcpCall,
+        plan: &CodexAppsAuthElicitationPlan,
+    ) -> bool {
+        let completed =
+            tokio::time::timeout(TOTAL_WAIT, self.connector_auth_flow(turn, call, plan)).await;
+        matches!(completed, Ok(Some(())))
+    }
+
+    async fn connector_auth_flow(
+        &self,
+        turn: &TurnContext,
+        call: &PreparedMcpCall,
+        plan: &CodexAppsAuthElicitationPlan,
+    ) -> Option<()> {
+        let application = self
+            .services
+            .thread_extension_data
+            .get::<codex_mcp::ApplicationApps>()?;
+        if application.personal_auth().is_none()
+            || !application.admits(call.config())
+            || !eligible(&turn.config, call)
+        {
+            return None;
+        }
+        let transport = call.transport_instance()?;
+        let failure = &plan.auth_failure;
+        if !valid_id(&failure.connector_id) {
+            return None;
+        }
+        let mut body = json!({"callback_url": CALLBACK, "post_auth_url": failure.install_url});
+        let suffix = match failure.auth_reason.as_deref() {
+            Some("missing_link") => {
+                body["connector_id"] = json!(failure.connector_id);
+                body["name"] = json!(failure.connector_name);
+                "aip/connectors/links/oauth"
+            }
+            Some("reauthentication_required" | "oauth_upgrade_required") => {
+                let link = failure
+                    .link_id
+                    .as_deref()
+                    .filter(|id| valid_id(id) && !id.starts_with("synthetic_link::"))?;
+                body["link_id"] = json!(link);
+                "aip/connectors/links/oauth/reauth"
+            }
+            _ => return None,
+        };
+        let landing = Url::parse(&failure.install_url).ok()?;
+        if landing.origin() != Url::parse("https://chatgpt.com").ok()?.origin()
+            || !landing.path().starts_with("/apps/")
+            || !landing.username().is_empty()
+            || landing.password().is_some()
+            || landing.query().is_some()
+            || landing.fragment().is_some()
+        {
+            return None;
+        }
+        if let Some(scopes) = &failure.requested_scopes {
+            body["requested_scopes"] = json!(scopes);
+        }
+        let base = backend_base(&turn.config.chatgpt_base_url)?;
+        let auth = self.connector_auth_manager()?.auth().await?;
+        let identity = Identity::capture(&auth)?;
+        let policy = turn
+            .config
+            .application_network_policy
+            .clone()
+            .for_current_account();
+        let client = RouteAwareClientPool::with_chatgpt_cloudflare_cookies_without_redirects_or_request_logging(turn.config.http_client_factory().with_network_policy(policy), ClientRouteClass::Api);
+        let initiated: Initiated = self
+            .connector_request(
+                &client,
+                &identity,
+                call,
+                transport,
+                base.join(suffix).ok()?,
+                Some(&body),
+            )
+            .await?;
+        if !valid_id(&initiated.oauth_state_id) {
+            return None;
+        }
+        {
+            let states = self
+                .services
+                .thread_extension_data
+                .get_or_init(IssuedStates::default);
+            let mut states = states.0.lock().ok()?;
+            if states.len() >= 1024 || !states.insert(initiated.oauth_state_id.clone()) {
+                return None;
+            }
+        }
+        let redirect = Url::parse(&initiated.redirect_url).ok()?;
+        if redirect.scheme() != "https"
+            || redirect.host_str().is_none()
+            || !redirect.username().is_empty()
+            || redirect.password().is_some()
+        {
+            return None;
+        }
+        let mut poll = base.join("aip/connectors/links/oauth/state/").ok()?;
+        poll.path_segments_mut()
+            .ok()?
+            .push(&initiated.oauth_state_id);
+        if !self
+            .connector_identity_is_current(&identity, call, transport)
+            .await
+        {
+            return None;
+        }
+        let request = ElicitationRequest::Url {
+            meta: Some(plan.elicitation.meta.clone()),
+            message: plan.elicitation.message.clone(),
+            url: initiated.redirect_url,
+            elicitation_id: String::new(),
+        };
+        let _active = self.services.elicitations.register();
+        let mut pending = self
+            .services
+            .mcp_runtime
+            .register_connector_auth_elicitation(
+                call,
+                transport,
+                self.tx_event.clone(),
+                turn.sub_id.clone(),
+                request,
+            )
+            .ok()?;
+        let consent = pending.take_response()?;
+        let retired = pending.take_retirement()?;
+        let event = pending.take_event()?;
+        self.send_event(turn, event).await;
+        let operation = async {
+            if consent.await.ok()?.action != ElicitationAction::Accept {
+                return None;
+            }
+            loop {
+                if !pending.is_live() {
+                    return None;
+                }
+                let state: State = self
+                    .connector_request(&client, &identity, call, transport, poll.clone(), None)
+                    .await?;
+                if state.connector_id != failure.connector_id {
+                    return None;
+                }
+                match state.status {
+                    Status::Pending => tokio::time::sleep(Duration::from_millis(250)).await,
+                    Status::Error => return None,
+                    Status::Complete => {
+                        if !state.proves(plan)
+                            || !self
+                                .connector_identity_is_current(&identity, call, transport)
+                                .await
+                        {
+                            return None;
+                        }
+                        return pending.complete().then_some(());
+                    }
+                }
+            }
+        };
+        let invalidated = async {
+            loop {
+                tokio::time::sleep(Duration::from_millis(100)).await;
+                if !self
+                    .connector_identity_is_current(&identity, call, transport)
+                    .await
+                {
+                    return;
+                }
+            }
+        };
+        tokio::select! { result = operation => result, _ = retired => None, _ = invalidated => None }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn plan(reason: &str) -> CodexAppsAuthElicitationPlan {
+        let failure = codex_mcp::CodexAppsConnectorAuthFailure {
+            connector_id: "calendar".into(),
+            connector_name: "Calendar".into(),
+            install_url: "https://chatgpt.com/apps/calendar/calendar".into(),
+            auth_reason: Some(reason.into()),
+            link_id: Some("legacy-implicit-real-link".into()),
+            requested_scopes: Some(vec!["calendar.write".into()]),
+            error_code: None,
+            error_http_status_code: Some(401),
+            error_action: None,
+        };
+        CodexAppsAuthElicitationPlan {
+            elicitation: codex_mcp::build_auth_elicitation("call", &failure),
+            auth_failure: failure,
+        }
+    }
+    fn complete() -> Value {
+        json!({"status":"COMPLETE", "connector_id":"calendar", "link":{"id":"legacy-implicit-real-link", "connector_id":"calendar", "auth_status":"ACTIVE", "scopes":["calendar.read","calendar.write"]}})
+    }
+    #[test]
+    fn complete_requires_the_exact_connector_link_and_actual_scopes() {
+        let expected = plan("oauth_upgrade_required");
+        assert!(
+            serde_json::from_value::<State>(complete())
+                .unwrap()
+                .proves(&expected)
+        );
+        for (field, value) in [
+            ("/status", json!("PENDING")),
+            ("/status", json!("ERROR")),
+            ("/connector_id", json!("other")),
+            ("/link", Value::Null),
+            ("/link/id", json!("another-link")),
+            ("/link/id", json!("synthetic_link::calendar")),
+            ("/link/connector_id", json!("other")),
+            ("/link/auth_status", json!("REAUTH_REQUIRED")),
+            ("/link/scopes", json!(["calendar.read"])),
+            ("/link/scopes", Value::Null),
+        ] {
+            let mut response = complete();
+            *response.pointer_mut(field).unwrap() = value;
+            assert!(
+                !serde_json::from_value::<State>(response)
+                    .unwrap()
+                    .proves(&expected)
+            );
+        }
+        let mut new = plan("missing_link");
+        new.auth_failure.link_id = None;
+        assert!(
+            serde_json::from_value::<State>(complete())
+                .unwrap()
+                .proves(&new)
+        );
+        let mut auth_only = plan("reauthentication_required");
+        auth_only.auth_failure.requested_scopes = None;
+        let mut response = complete();
+        response["link"]["scopes"] = Value::Null;
+        assert!(
+            serde_json::from_value::<State>(response)
+                .unwrap()
+                .proves(&auth_only)
+        );
+        let mut malformed = complete();
+        malformed["status"] = json!("unknown");
+        assert!(serde_json::from_value::<State>(malformed).is_err());
+    }
+    #[test]
+    fn backend_paths_are_explicit_and_state_is_one_encoded_segment() {
+        assert_eq!(
+            backend_base("https://chatgpt.com").unwrap().path(),
+            "/backend-api/"
+        );
+        assert_eq!(
+            backend_base("https://chatgpt.com/backend-api")
+                .unwrap()
+                .path(),
+            "/backend-api/"
+        );
+        assert_eq!(
+            backend_base("http://127.0.0.1:1234/api/codex")
+                .unwrap()
+                .path(),
+            "/api/"
+        );
+        assert!(backend_base("https://chatgpt.com/backend-api/ps/mcp").is_none());
+        assert!(backend_base("https://chatgpt.com/unknown").is_none());
+        assert!(backend_base("http://remote.invalid/api").is_none());
+        assert!(backend_base("https://user:secret@chatgpt.com/backend-api").is_none());
+        let mut url = backend_base("https://chatgpt.com")
+            .unwrap()
+            .join("aip/connectors/links/oauth/state/")
+            .unwrap();
+        url.path_segments_mut().unwrap().push("opaque/state?value");
+        assert!(url.path().ends_with("opaque%2Fstate%3Fvalue"));
+    }
+}
