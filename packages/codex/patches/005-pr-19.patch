+        {
+            return Ok(Some(ElicitationResponse {
+                action: ElicitationAction::Decline,
+                content: None,
+                meta: None,
+            }));
+        }
+        if !ids.insert(elicitation_id) {
+            return Ok(Some(ElicitationResponse {
+                action: ElicitationAction::Cancel,
+                content: None,
+                meta: None,
+            }));
+        }
+    }
+    if let Some(reviewer) = &authority.reviewer {
+        for member in members {
+            if let Some(mut response) = reviewer
+                .review(ElicitationReviewRequest {
+                    server_name: server.to_owned(),
+                    request_id: id.clone(),
+                    elicitation: Elicitation::Mcp(member.clone()),
+                })
+                .await?
+            {
+                if response.action != ElicitationAction::Accept {
+                    response.content = None;
+                    return Ok(Some(response));
+                }
+            }
+        }
+    }
+    Ok(None)
+}
