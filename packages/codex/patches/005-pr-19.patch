+    /// Call under the owning session's MCP refresh gate before replacing this admission.
+    pub async fn retire_owned_stdio(&self) -> anyhow::Result<()> {
+        if !self.owned_stdio_mode.load(Ordering::Acquire) {
+            return Ok(());
+        }
+        let owner = self
+            .stdio_owner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone();
+        if let Some(owner) = &owner {
