+// Only admission-owned stdio moves the existing RMCP join owner out of request handles.
+// The join task owns RunningService; this wrapper owns its peer and the join receipt.
+// A canceled request cannot retain RunningService or make cleanup depend on itself.
+pub(crate) struct ClientService {
+    connection: ClientConnection,
+    recovery_needed: AtomicBool,
+    shutdown_started: CancellationToken,
+}
+
+enum ClientConnection {
+    Shared(RunningService<RoleClient, ElicitationClientService>),
+    Owned {
+        peer: rmcp::service::Peer<RoleClient>,
+        handler: ElicitationClientService,
+        cancellation: std::sync::Mutex<Option<rmcp::service::RunningServiceCancellationToken>>,
+        completion: futures::future::Shared<BoxFuture<'static, Result<(), String>>>,
+    },
+}
+impl ClientService {
+    fn new(
+        service: RunningService<RoleClient, ElicitationClientService>,
+        owned: bool,
+        shutdown_started: CancellationToken,
+    ) -> Self {
+        Self {
+            connection: ClientConnection::new(service, owned),
+            recovery_needed: AtomicBool::new(false),
+            shutdown_started,
+        }
+    }
+
+    pub(crate) fn check_shutdown(&self) -> std::result::Result<(), ClientOperationError> {
+        check_shutdown(&self.shutdown_started)
+    }
+
+    fn needs_recovery(&self) -> bool {
+        self.recovery_needed.load(Ordering::Acquire) || self.is_closed()
+    }
+}
