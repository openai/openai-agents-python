+    fn drop(&mut self) {
+        self.service().retire_url_transport();
+        if let ClientConnection::Owned { cancellation, .. } = &self.connection {
+            if let Some(token) = cancellation
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .take()
