+/// Preserve the ordinary request's configured policy for every URL member.
+/// Approval may permit a request, but cannot substitute for browser consent.
+async fn review_url_members(
+    authority: &ElicitationAuthority,
+    server: &str,
+    id: &RequestId,
+    members: &[rmcp::model::ElicitRequestParams],
+) -> Result<Option<ElicitationResponse>> {
+    if members.is_empty() || members.len() > 1024 {
+        return Ok(Some(ElicitationResponse {
+            action: ElicitationAction::Cancel,
+            content: None,
+            meta: None,
+        }));
+    }
+    let mut ids = HashSet::new();
+    for member in members {
+        let rmcp::model::ElicitRequestParams::UrlElicitationParams {
+            meta,
+            elicitation_id,
+            ..
+        } = member
+        else {
+            return Ok(Some(ElicitationResponse {
+                action: ElicitationAction::Cancel,
+                content: None,
+                meta: None,
+            }));
+        };
+        let meta = meta.as_ref().map(|meta| &meta.0.0);
+        if url_strict_review_rejected(meta) {
+            return Ok(Some(strict_auto_review_decline()));
+        }
+        if meta
