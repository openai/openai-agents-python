+#[cfg(test)]
+mod prompt_budget_tests {
+    use super::PromptCatalogBudget;
+
+    #[test]
+    fn counts_all_serialized_prompt_fields_and_accepts_the_exact_limit() -> anyhow::Result<()> {
+        let page: Vec<rmcp::model::Prompt> = serde_json::from_value(serde_json::json!([{
+            "name": "review",
+            "description": "quoted \"text\" and 日本語",
+            "arguments": [{"name": "topic", "description": "nested\ntext"}],
+            "icons": [{"src": "https://example.invalid/icon.svg"}],
+            "_meta": {"nested": {"value": "λ\\escaped"}}
+        }]))?;
+        let size = serde_json::to_vec(&page)?.len();
+        let mut exact = PromptCatalogBudget(size);
+        serde_json::to_writer(&mut exact, &page)?;
+        assert_eq!(exact.0, 0);
+        let mut short = PromptCatalogBudget(size - 1);
+        let error = serde_json::to_writer(&mut short, &page)
+            .expect_err("one byte over the budget must fail");
+        assert!(
+            error
+                .to_string()
+                .contains("prompt catalog byte limit exceeded")
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn retains_one_budget_across_individually_small_pages() -> anyhow::Result<()> {
+        let first = serde_json::json!([{"name": "first", "_meta": {"data": "metadata"}}]);
+        let second = serde_json::json!([{"name": "second", "description": "more data"}]);
+        let total = serde_json::to_vec(&first)?.len() + serde_json::to_vec(&second)?.len();
+        let mut exact = PromptCatalogBudget(total);
+        serde_json::to_writer(&mut exact, &first)?;
+        serde_json::to_writer(&mut exact, &second)?;
+        assert_eq!(exact.0, 0);
+        let mut short = PromptCatalogBudget(total - 1);
+        serde_json::to_writer(&mut short, &first)?;
+        assert!(serde_json::to_writer(&mut short, &second).is_err());
+        Ok(())
+    }
+}
