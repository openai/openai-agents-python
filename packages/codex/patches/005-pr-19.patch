 }
 
 impl Session {
+    fn has_owned_child_stdio(&self, turn: &TurnContext) -> bool {
+        turn.session_source.is_non_root_agent()
+            && self
+                .services
+                .client_mcp_extensions
+                .contains("openai/sdk-child-prompts")
+    }
+
+    pub(crate) async fn begin_owned_child_stdio(
+        self: &Arc<Self>,
+        turn: &Arc<TurnContext>,
+        cancellation: &tokio_util::sync::CancellationToken,
+    ) -> CodexResult<()> {
+        if !self.has_owned_child_stdio(turn) {
+            return Ok(());
+        }
+        let _refresh = self
+            .mcp_refresh
+            .acquire()
+            .await
+            .map_err(|_| CodexErr::InvalidRequest("MCP refresh gate closed".to_owned()))?;
+        self.services
+            .mcp_runtime
+            .retire_owned_stdio()
+            .await
+            .map_err(|error| {
+                CodexErr::InvalidRequest(format!(
+                    "Could not retire preceding child stdio admission: {error}"
+                ))
+            })?;
+        self.services.mcp_runtime.set_stdio_admission(
+            codex_rmcp_client::ElicitationOwner::for_cancellable_admission(
+                turn.sub_id.clone(),
+                turn.clone(),
+                cancellation,
+            ),
+        );
+        self.mark_mcp_runtime_dirty();
+        self.refresh_mcp_if_dirty_locked().await;
