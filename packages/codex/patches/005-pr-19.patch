+//! Trusted call ownership carried through local RMCP extensions, never peer metadata.
+use rmcp::model::{ClientRequest, GetExtensions, JsonRpcMessage, RequestId};
+use rmcp::service::{InboundStreamOrigin, RoleClient, RxJsonRpcMessage, TxJsonRpcMessage};
+use rmcp::transport::{IntoTransport, Transport};
+use std::collections::HashMap;
+use std::future::Future;
+use std::sync::{Arc, Mutex};
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone)]
+pub struct ElicitationOwner {
+    pub turn_id: String,
+    pub admission: Arc<dyn std::any::Any + Send + Sync>,
+    revoked: CancellationToken,
+}
+impl ElicitationOwner {
+    pub fn for_admission(turn_id: String, admission: Arc<dyn std::any::Any + Send + Sync>) -> Self {
+        Self {
+            turn_id,
+            admission,
+            revoked: CancellationToken::new(),
+        }
+    }
+    pub fn for_cancellable_admission(
+        turn_id: String,
+        admission: Arc<dyn std::any::Any + Send + Sync>,
+        cancellation: &CancellationToken,
+    ) -> Self {
+        Self {
+            turn_id,
+            admission,
+            revoked: cancellation.child_token(),
+        }
+    }
+    pub fn revoke(&self) {
+        self.revoked.cancel();
+    }
+    pub fn same_admission(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.admission, &other.admission)
+    }
+    pub fn is_live(&self) -> bool {
+        !self.revoked.is_cancelled()
+    }
+    pub async fn cancelled(&self) {
+        self.revoked.cancelled().await;
+    }
+}
+tokio::task_local! { static OWNER: Option<ElicitationOwner>; }
+/// Captures revocation as well as identity, so awaiting code cannot fall back to an unowned route.
+pub fn elicitation_owner_snapshot() -> Option<ElicitationOwner> {
+    OWNER.try_with(Clone::clone).ok().flatten()
+}
+pub fn current_elicitation_owner() -> Option<ElicitationOwner> {
+    elicitation_owner_snapshot().filter(ElicitationOwner::is_live)
+}
+pub async fn with_elicitation_owner<T>(
+    turn_id: String,
+    admission: Option<Arc<dyn std::any::Any + Send + Sync>>,
+    future: impl Future<Output = T>,
+) -> T {
+    let Some(admission) = admission else {
+        return OWNER.scope(None, future).await;
+    };
+    struct Revoke(CancellationToken);
+    impl Drop for Revoke {
+        fn drop(&mut self) {
+            self.0.cancel();
+        }
+    }
+    let owner = ElicitationOwner {
+        turn_id,
+        admission,
+        revoked: CancellationToken::new(),
+    };
+    let _revoke = Revoke(owner.revoked.clone());
+    OWNER.scope(Some(owner), future).await
+}
+pub async fn scope_owner<T>(owner: Option<ElicitationOwner>, future: impl Future<Output = T>) -> T {
+    OWNER.scope(owner, future).await
+}
+pub(crate) fn owned_tool_request(params: rmcp::model::CallToolRequestParams) -> ClientRequest {
+    let mut request = rmcp::model::CallToolRequest::new(params);
+    if let Some(owner) = current_elicitation_owner() {
+        request.extensions.insert(owner);
+    }
+    if let Some(call) = crate::url_ingress::current_call() {
+        request.extensions.insert(call.clone());
+        // Root direct requests retain their existing transport/request lifetime.
+        // Only owned calls opt into response-stream context; presence is unfiltered.
+        if let Some(call) = crate::url_ingress::current_owned_call() {
+            let mut response_context = rmcp::model::Extensions::new();
+            response_context.insert(call);
+            request
+                .extensions
+                .insert(rmcp::service::ResponseStreamContext(response_context));
+        }
+    }
+    ClientRequest::CallToolRequest(request)
+}
+#[derive(Clone, Default)]
+pub(crate) struct RequestOwners(
+    Arc<Mutex<HashMap<RequestId, RequestOwner>>>,
+    pub(crate) crate::url_ingress::UrlIngress,
+);
+struct RequestOwner {
+    owner: Option<ElicitationOwner>,
+    call: Option<std::sync::Weak<crate::url_ingress::Call>>,
+    owned: bool,
+}
+impl RequestOwner {
+    fn is_live(&self) -> bool {
+        self.owner.as_ref().is_some_and(ElicitationOwner::is_live)
+            || self
+                .call
+                .as_ref()
+                .is_some_and(|call| call.upgrade().is_some_and(|call| call.is_live()))
+    }
+}
+impl From<ElicitationOwner> for RequestOwner {
+    fn from(owner: ElicitationOwner) -> Self {
+        Self {
+            owner: Some(owner),
+            call: None,
+            owned: true,
+        }
+    }
+}
+impl RequestOwners {
+    pub(crate) fn get(&self, origin: Option<&InboundStreamOrigin>) -> Option<ElicitationOwner> {
+        let Some(InboundStreamOrigin::OutboundRequest(id)) = origin else {
+            return None;
+        };
+        self.0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .get(id)
+            .and_then(|record| record.owner.clone())
+            .filter(ElicitationOwner::is_live)
+    }
+}
+pub(crate) fn capture_request_owners<T, E, A>(
+    transport: T,
+    owners: RequestOwners,
+) -> impl Transport<RoleClient, Error = E> + 'static
+where
+    T: IntoTransport<RoleClient, E, A>,
+    E: std::error::Error + Send + Sync + 'static,
+{
+    OwnedTransport {
+        inner: transport.into_transport(),
+        owners,
+    }
+}
+struct OwnedTransport<T> {
+    inner: T,
+    owners: RequestOwners,
+}
+impl<T: Transport<RoleClient> + 'static> Transport<RoleClient> for OwnedTransport<T> {
+    type Error = T::Error;
+    fn send(
+        &mut self,
+        message: TxJsonRpcMessage<RoleClient>,
+    ) -> impl Future<Output = Result<(), Self::Error>> + Send + 'static {
+        let id = if let JsonRpcMessage::Request(envelope) = &message {
+            let owner = envelope
+                .request
+                .extensions()
+                .get::<ElicitationOwner>()
+                .cloned();
+            let call = envelope
+                .request
+                .extensions()
+                .get::<std::sync::Weak<crate::url_ingress::Call>>()
+                .cloned();
+            let owned = envelope
+                .request
+                .extensions()
+                .get::<rmcp::service::ResponseStreamContext>()
+                .is_some_and(|context| {
+                    context
+                        .0
+                        .get::<std::sync::Weak<crate::url_ingress::Call>>()
+                        .is_some()
+                });
+            let mut owners = self
+                .owners
+                .0
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            // A silent peer must not retain expired calls between sends/timeouts.
+            owners.retain(|_, record| record.is_live());
+            if owner.is_some() || call.is_some() {
+                owners.insert(envelope.id.clone(), RequestOwner { owner, call, owned });
+                Some(envelope.id.clone())
+            } else {
+                None
+            }
+        } else {
+            None
+        };
+        let owners = self.owners.clone();
+        let send = self.inner.send(message);
+        async move {
+            let result = send.await;
+            if result.is_err() {
+                if let Some(id) = id {
+                    owners
+                        .0
+                        .lock()
+                        .unwrap_or_else(std::sync::PoisonError::into_inner)
+                        .remove(&id);
+                }
+            }
+            result
+        }
+    }
+    async fn close(&mut self) -> Result<(), Self::Error> {
+        self.owners.1.close();
+        self.owners
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clear();
+        self.inner.close().await
+    }
+
+    async fn receive(&mut self) -> Option<RxJsonRpcMessage<RoleClient>> {
+        let mut message = self.inner.receive().await;
+        match &mut message {
+            Some(JsonRpcMessage::Request(envelope)) => {
+                let call = envelope
+                    .request
+                    .extensions()
+                    .get::<rmcp::service::ResponseStreamContext>()
+                    .and_then(|context| {
+                        context.0.get::<std::sync::Weak<crate::url_ingress::Call>>()
+                    })
+                    .cloned()
+                    .or_else(
+                        || match envelope.request.extensions().get::<InboundStreamOrigin>() {
+                            Some(InboundStreamOrigin::OutboundRequest(id)) => self
+                                .owners
+                                .0
+                                .lock()
+                                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                                .get(id)
+                                .filter(|record| record.owned)
+                                .and_then(|record| record.call.clone()),
+                            _ => None,
+                        },
+                    );
+                // Preserve a known expired source as a terminal marker, including forms.
+                // Absence remains the ordinary unowned route; a dead marker never does.
+                if call
+                    .as_ref()
+                    .is_some_and(|call| call.upgrade().is_none_or(|call| !call.is_live()))
+                {
+                    envelope
+                        .request
+                        .extensions_mut()
+                        .insert(crate::url_ingress::IngressContext(Err(())));
+                }
+                if let Some(owner) = call
+                    .as_ref()
+                    .and_then(|call| call.upgrade())
+                    .and_then(|call| call.owner())
+                {
+                    envelope.request.extensions_mut().insert(owner);
+                }
+                self.owners
+                    .1
+                    .request(&envelope.id, &mut envelope.request, call)
+            }
+            Some(JsonRpcMessage::Notification(envelope)) => {
+                self.owners.1.notification(&envelope.notification)
+            }
+            _ => {}
+        }
+        let mut owners = self
+            .owners
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        match &message {
+            Some(JsonRpcMessage::Response(response)) => {
+                owners.remove(&response.id);
+            }
+            Some(JsonRpcMessage::Error(error)) => {
+                if let Some(id) = &error.id {
+                    let record = owners.remove(id);
+                    self.owners
+                        .1
+                        .error(&error.error, record.and_then(|record| record.call));
+                }
+            }
+            None => {
+                owners.clear();
+                self.owners.1.close();
+            }
+            _ => {}
+        }
+        owners.retain(|_, record| record.is_live());
+        message
+    }
+}
