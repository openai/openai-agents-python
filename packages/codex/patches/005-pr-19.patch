 impl McpConnectionSet {
+    pub async fn list_prompts(&self, server: &str) -> Result<Vec<rmcp::model::Prompt>> {
+        let (managed, timeout) = self.client_by_name(server).await?;
+        let client = &managed.client;
+        let mut budget = PromptCatalogBudget(MAX_MCP_PROMPT_CATALOG_BYTES);
+        collect_paginated_with_page_check(
+            "prompts/list",
+            timeout,
+            MAX_MCP_CATALOG_ITEMS,
+            |params| async move {
+                let response = client.list_prompts(params, timeout).await?;
+                Ok((response.prompts, response.next_cursor))
+            },
+            |page| {
+                serde_json::to_writer(&mut budget, page).with_context(|| {
+                    format!(
+                        "prompts/list exceeded the catalog byte limit of {MAX_MCP_PROMPT_CATALOG_BYTES} bytes"
+                    )
+                })
+            },
+        )
+        .await
+        .with_context(|| format!("prompts/list failed for `{server}`"))
+    }
