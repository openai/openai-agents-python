 }
+
+#[test]
+fn empty_catalog_preserves_query_diagnostics_from_the_scoring_path() {
+    // One blank document forces ordinary scoring without introducing a match.
+    // Compare all output fields, then pin the public diagnostics independently.
+    let blank = [document(17, "", "")];
+    let saturated = (0x4e00..0x4e00 + 200)
+        .map(|value| char::from_u32(value).unwrap())
+        .collect::<String>();
+    let cases = [
+        ("empty", String::new(), 0, false),
+        ("stop words", "please use the a i !".to_string(), 0, false),
+        ("short ASCII", "create a presentation".to_string(), 2, false),
+        (
+            "Unicode lowercase expansion and deduplication",
+            "İSTANBUL istanbul ÉCOLE école 演示文稿".to_string(),
+            4,
+            false,
+        ),
+        ("short byte bound", "z".repeat(128), 1, false),
+        ("above short byte bound", "z".repeat(129), 1, false),
+        (
+            "expanded byte bound",
+            format!("{}ab", "İ".repeat(42)),
+            1,
+            false,
+        ),
+        ("above expanded byte bound", "İ".repeat(43), 1, false),
+        (
+            "byte cutoff inside a Unicode character",
+            format!("{}界界", "é".repeat(2047)),
+            1,
+            true,
+        ),
+        (
+            "too many distinct terms",
+            (0..65)
+                .map(|index| format!("word{index}"))
+                .collect::<Vec<_>>()
+                .join(" "),
+            64,
+            true,
+        ),
+        (
+            "long repetitive query without gram saturation",
+            "z".repeat(200),
+            1,
+            false,
+        ),
+        (
+            "unique Unicode grams saturate the budget",
+            saturated,
+            1,
+            true,
+        ),
+    ];
+
+    for (name, query, term_count, truncated) in cases {
+        for limit in [0, 1, 50] {
+            let empty = CharacterNgramSkillSelector.select(&query, &[], limit);
+            let ordinary = CharacterNgramSkillSelector.select(&query, &blank, limit);
+            assert_eq!(ordinary, empty, "{name}, limit {limit}");
+            assert_eq!(
+                CheapSkillSelection {
+                    candidate_ids: vec![],
+                    query_term_count: term_count,
+                    query_truncated: truncated,
+                    candidate_set_truncated: false,
+                },
+                empty,
+                "{name}, limit {limit}",
+            );
+        }
+    }
+}
+
+#[test]
+fn nonempty_catalog_still_selects_short_repetitive_and_saturated_queries() {
+    let saturated = (0x4e00..0x4e00 + 200)
+        .map(|value| char::from_u32(value).unwrap())
+        .collect::<String>();
+    let cases = [
+        (
+            "CREATE PRESENTATIONS".to_string(),
+            "presentations".to_string(),
+            2,
+            false,
+        ),
+        ("z".repeat(200), "zzzzz".to_string(), 1, false),
+        (saturated.clone(), saturated, 1, true),
+    ];
+    for (query, name, term_count, truncated) in cases {
+        let documents = [document(17, &name, ""), document(23, "", "")];
+        assert_eq!(
+            CheapSkillSelection {
+                candidate_ids: vec![17],
+                query_term_count: term_count,
+                query_truncated: truncated,
+                candidate_set_truncated: false,
+            },
+            CharacterNgramSkillSelector.select(&query, &documents, 1),
+        );
+    }
+}
