+#[test]
+fn empty_character_catalog_preserves_shadow_status() {
+    for (query, expected_status) in [
+        ("", "no_query_terms"),
+        ("please use the a i !", "no_query_terms"),
+        ("create a presentation", "no_matches"),
+        ("İSTANBUL ÉCOLE 演示文稿", "no_matches"),
+    ] {
+        let selection = CharacterNgramSkillSelector.select(query, &[], 50);
+        assert!(selection.candidate_ids.is_empty());
+        assert_eq!(expected_status, selection_status(&selection, 0));
+    }
+    let documents = [SkillSelectionDocument {
+        id: 17,
+        name: "presentations",
+        short_description: None,
+        description: "Create visual decks.",
+        dependencies: None,
+    }];
+    let selection = CharacterNgramSkillSelector.select("create a presentation", &documents, 50);
+    assert_eq!(vec![17], selection.candidate_ids);
+    assert_eq!(
+        "selected",
+        selection_status(&selection, selection.candidate_ids.len())
+    );
+}
