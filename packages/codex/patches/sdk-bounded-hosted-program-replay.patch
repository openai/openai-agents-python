+#[cfg(test)]
+mod hosted_program_admission_tests {
+    use super::*;
+
+    fn prompt(input: Vec<ResponseItem>) -> Prompt {
+        let mut prompt = Prompt::default();
+        prompt.input = input.into();
+        prompt.request_controls.hosted_prompt = Some(Some(Default::default()));
+        prompt
+            .request_controls
+            .hosted_prompt
+            .as_mut()
+            .unwrap()
+            .as_mut()
+            .unwrap()
+            .omit_tools = true;
+        prompt
+    }
+    fn program(call_id: &str) -> ResponseItem {
+        serde_json::from_value(
+            serde_json::json!({"type":"program","call_id":call_id,"code":"pass"}),
+        )
+        .unwrap()
+    }
+    fn output(call_id: &str) -> ResponseItem {
+        serde_json::from_value(serde_json::json!({"type":"program_output","call_id":call_id,"result":"done","status":"completed"})).unwrap()
+    }
+
+    #[test]
+    fn retained_program_index_keeps_latest_state_and_current_response_ownership() {
+        let prompt = prompt(vec![program("closed"), output("closed"), program("open")]);
+        let mut calls = HashMap::new();
+        let mut retained = None;
+        assert!(
+            admit_hosted_program_item(&prompt, &mut calls, &mut retained, &output("closed"))
+                .is_err()
+        );
+        assert!(
+            admit_hosted_program_item(&prompt, &mut calls, &mut retained, &output("open")).is_ok()
+        );
+        assert!(
+            admit_hosted_program_item(&prompt, &mut calls, &mut retained, &output("open")).is_err()
+        );
+        let mut calls = HashMap::new();
+        let mut retained = None;
+        assert!(
+            admit_hosted_program_item(&prompt, &mut calls, &mut retained, &program("closed"))
+                .is_ok()
+        );
+        assert!(
+            admit_hosted_program_item(&prompt, &mut calls, &mut retained, &output("closed"))
+                .is_ok()
+        );
+    }
+
+    #[test]
+    fn many_retained_programs_share_one_index_without_a_lifetime_call_limit() {
+        let input = (0..4096)
+            .map(|index| program(&format!("retained-{index}")))
+            .collect::<Vec<_>>();
+        let prompt = prompt(input);
+        let before = serde_json::to_value(&*prompt.input).unwrap();
+        let mut calls = HashMap::new();
+        let mut retained = None;
+        for index in 0..MAX_HOSTED_PROGRAM_CALL_IDS_PER_RESPONSE {
+            admit_hosted_program_item(
+                &prompt,
+                &mut calls,
+                &mut retained,
+                &output(&format!("retained-{index}")),
+            )
+            .unwrap();
+        }
+        assert_eq!(retained.as_ref().unwrap().len(), 4096);
+        assert_eq!(calls.len(), MAX_HOSTED_PROGRAM_CALL_IDS_PER_RESPONSE);
+        assert!(
+            admit_hosted_program_item(&prompt, &mut calls, &mut retained, &output("retained-256"))
+                .is_err()
+        );
+        assert_eq!(serde_json::to_value(&*prompt.input).unwrap(), before);
+    }
+
+    #[test]
+    fn response_program_limit_rejects_another_call_before_growing_the_ledger() {
+        let prompt = prompt(vec![]);
+        let mut calls = HashMap::new();
+        let mut retained = None;
+        for index in 0..MAX_HOSTED_PROGRAM_CALL_IDS_PER_RESPONSE {
+            admit_hosted_program_item(
+                &prompt,
+                &mut calls,
+                &mut retained,
+                &program(&format!("current-{index}")),
+            )
+            .unwrap();
+        }
+        assert!(
+            admit_hosted_program_item(&prompt, &mut calls, &mut retained, &program("too-many"))
+                .is_err()
+        );
+        assert_eq!(calls.len(), MAX_HOSTED_PROGRAM_CALL_IDS_PER_RESPONSE);
+        assert!(
+            admit_hosted_program_item(&prompt, &mut calls, &mut retained, &output("current-0"))
+                .is_ok()
+        );
+        assert!(retained.is_none());
+    }
 }

