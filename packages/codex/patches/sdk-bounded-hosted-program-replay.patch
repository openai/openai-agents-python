+// The existing analytics capture bounds distinct per-response tool IDs at 256.
+// Bound provider program admission independently at the same capacity.
+const MAX_HOSTED_PROGRAM_CALL_IDS_PER_RESPONSE: usize = 256;
+
+fn retained_hosted_program_calls(prompt: &Prompt) -> HashMap<String, bool> {
+    let mut retained = HashMap::new();
+    for item in prompt.input.iter() {
+        match item {
+            ResponseItem::Program { call_id, .. } => {
+                retained.insert(call_id.clone(), false);
+            }
+            ResponseItem::ProgramOutput {
+                call_id, status, ..
+            } => {
+                retained.insert(
+                    call_id.clone(),
+                    matches!(
+                        status,
+                        codex_protocol::models::ProgramOutputStatus::Completed
+                    ),
+                );
+            }
+            _ => {}
+        }
+    }
+    retained
+}
