+#[test]
+fn bound_interceptor_forwards_provider_window_attestation() {
+    struct Passive(bool);
+    impl ModelResponseInterceptor for Passive {
+        fn preserves_provider_message_window(&self) -> bool {
+            self.0
+        }
+        fn intercept(self: Box<Self>, stream: ModelResponseStream) -> ModelResponseStream {
+            stream
+        }
+    }
+    struct Unknown;
+    impl ModelResponseInterceptor for Unknown {
+        fn intercept(self: Box<Self>, stream: ModelResponseStream) -> ModelResponseStream {
+            stream
+        }
+    }
+    for expected in [false, true] {
+        let wrapped = BoundInterceptor {
+            inner: Box::new(Passive(expected)),
+            admission: None,
+        };
+        assert_eq!(wrapped.preserves_provider_message_window(), expected);
+    }
+    let unknown = BoundInterceptor {
+        inner: Box::new(Unknown),
+        admission: None,
+    };
+    assert!(!unknown.preserves_provider_message_window());
+}
