+impl NativeProviderResponse {
+    pub(crate) fn matches_provider(
+        &self,
+        client: &ModelClient,
+        provider: &SharedModelProvider,
+    ) -> bool {
+        // Session and ModelClient construct separate provider wrappers from the
+        // same native definition. Bind the definition and credential owner,
+        // while retaining the exact issuing client and auth generation.
+        let same_auth_manager = match (provider.auth_manager(), client.auth_manager()) {
+            (None, None) => true,
+            (Some(left), Some(right)) => Arc::ptr_eq(&left, &right),
+            _ => false,
+        };
+        std::sync::Weak::ptr_eq(&self.owner, &Arc::downgrade(&client.state))
+            && provider.info() == client.state.provider.info()
+            && same_auth_manager
+            && self.auth_owner_generation == client.auth_owner_generation()
+    }
+}
