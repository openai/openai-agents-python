+    /// Consume the existing collector after Core durably accepts the exact window.
+    /// The resulting receipt retains neither input nor provider output.
+    pub(crate) fn take_acknowledged_response(
+        &mut self,
+        prompt: &Prompt,
+        current: &[ResponseItem],
+    ) -> Option<NativeProviderResponse> {
+        let (model, owner, mut response) = self.pending_http_response.take()?;
+        let response = response.try_recv().ok()?;
+        if response.response_id.trim().is_empty()
+            || response.items_added.iter().any(|item| {
+                !matches!(
+                    item,
+                    ResponseItem::Message { .. } | ResponseItem::Reasoning { .. }
+                )
+            })
+        {
+            return None;
+        }
+        let expected = prompt.input.iter().chain(&response.items_added);
+        if expected.clone().count() != current.len()
+            || !expected.zip(current).all(|(expected, current)| {
+                let mut expected = expected.clone();
+                let mut current = current.clone();
+                let is_openai = self.client.state.provider.info().is_openai();
+                filter_provider_response_metadata(std::slice::from_mut(&mut expected), is_openai);
+                filter_provider_response_metadata(std::slice::from_mut(&mut current), is_openai);
+                self.client
+                    .prepare_response_items_for_request(std::slice::from_mut(&mut expected));
+                self.client
+                    .prepare_response_items_for_request(std::slice::from_mut(&mut current));
+                expected == current
+            })
+        {
+            return None;
+        }
+        Some(NativeProviderResponse {
+            anchor: codex_extension_api::ProviderResponseAnchor {
+                response_id: response.response_id,
+                model,
+            },
+            owner: Arc::downgrade(&self.client.state),
+            auth_owner_generation: owner,
+        })
+    }
