+#[test]
+fn provider_window_uses_existing_wire_metadata_projection() {
+    let original: ResponseItem = serde_json::from_value(serde_json::json!({
+        "type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "exact"}]
+    })).unwrap();
+    let mut persisted = original.clone();
+    persisted.set_turn_id_if_missing("native-turn");
+    let mut openai = persisted.clone();
+    filter_provider_response_metadata(std::slice::from_mut(&mut openai), true);
+    assert_ne!(original, openai);
+    filter_provider_response_metadata(std::slice::from_mut(&mut persisted), false);
+    assert_eq!(original, persisted);
+    let mut changed: ResponseItem = serde_json::from_value(serde_json::json!({
+        "type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "different"}]
+    })).unwrap();
+    filter_provider_response_metadata(std::slice::from_mut(&mut changed), false);
+    assert_ne!(original, changed);
+}
+
+// The SDK's final native schema restoration can rewrite these historical
+// declarations after typed request construction. They require a later exact
+// final-wire receipt and must not inherit the message-only attestation.
+fn provider_window_input_supported(items: &[ResponseItem]) -> bool {
+    !items.iter().any(|item| {
+        matches!(
+            item,
+            ResponseItem::AdditionalTools { .. } | ResponseItem::ToolSearchOutput { .. }
+        )
+    })
+}
+
+#[test]
+fn provider_window_rejects_schema_bearing_history() {
+    assert!(provider_window_input_supported(&[]));
+    for value in [
+        serde_json::json!({"type": "additional_tools", "role": "developer", "tools": []}),
+        serde_json::json!({"type": "tool_search_output", "status": "completed", "execution": "server", "tools": []}),
+    ] {
+        let item: ResponseItem = serde_json::from_value(value).unwrap();
+        assert!(!provider_window_input_supported(&[item]));
+    }
+    let message: ResponseItem = serde_json::from_value(serde_json::json!({
+        "type": "message", "role": "user", "content": [{"type": "input_text", "text": "current"}]
+    }))
+    .unwrap();
+    assert!(provider_window_input_supported(&[message]));
+}
