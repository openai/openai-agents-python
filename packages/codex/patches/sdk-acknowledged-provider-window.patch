+#[test]
+fn live_window_receipts_expire_on_append_and_replacement() {
+    let mut history = ContextManager::new();
+    let initial = history.window_receipt();
+    let snapshot = history.clone();
+    assert!(history.matches_window_receipt(&initial));
+    history.record_items([&user_msg("new input")], TruncationPolicy::Tokens(10_000));
+    assert!(!history.matches_window_receipt(&initial));
+    assert!(snapshot.matches_window_receipt(&initial));
+    let appended = history.window_receipt();
+    history.replace(vec![user_msg("replacement")]);
+    assert!(!history.matches_window_receipt(&appended));
+    assert!(!ContextManager::new().matches_window_receipt(&initial));
+}
