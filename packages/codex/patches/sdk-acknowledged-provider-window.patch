+// Shared with native request construction: only metadata already omitted from
+// this provider's actual wire request may be ignored by lineage comparison.
+fn filter_provider_response_metadata(input: &mut [ResponseItem], is_openai: bool) {
+    if !is_openai {
+        for item in input {
+            item.clear_internal_chat_message_metadata_passthrough();
+            if let ResponseItem::FunctionCall {
+                encrypted_function_args,
+                ..
+            } = item
+            {
+                *encrypted_function_args = None;
+            }
+        }
+    }
+}
