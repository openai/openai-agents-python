+#[tokio::test(flavor = "current_thread")]
+async fn discarded_ready_facts_allow_sibling_stop_and_join_the_mapper() {
+    const LIMIT: usize = 4096;
+    let count = Arc::new(AtomicUsize::new(0));
+    let entered = Arc::new(tokio::sync::Notify::new());
+    let seen = count.clone();
+    let first = entered.clone();
+    let events = futures::stream::iter(0..LIMIT).map(move |_| {
+        seen.fetch_add(1, Ordering::SeqCst);
+        first.notify_one();
+        Ok(empty_probability_event(false))
+    });
+    let (mut stream, _) = super::map_response_events(
+        None,
+        events,
+        test_session_telemetry(),
+        InferenceTraceAttempt::disabled(),
+        test_model_provider(),
+        false,
+        /*discard_empty_probability_facts*/ true,
+    );
+    let mapper = stream.mapper_task.take().unwrap();
+    let stop = tokio::spawn(async move {
+        entered.notified().await;
+        drop(stream);
+    });
+    stop.await.unwrap();
+    mapper.await.unwrap();
+    assert!(
+        count.load(Ordering::SeqCst) < LIMIT,
+        "discarded facts exhausted the finite source before the sibling could stop it"
+    );
+}
