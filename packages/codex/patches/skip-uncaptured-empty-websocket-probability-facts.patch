+#[tokio::test]
+async fn uncaptured_nonempty_and_malformed_probability_facts_remain_ordered() {
+    use codex_protocol::response_facts::ResponseFact;
+    let ResponseEvent::ResponseFact(mut expected) = empty_probability_event(false) else {
+        unreachable!();
+    };
+    if let ResponseFact::TextProbabilities { tokens, .. } = &mut expected.fact {
+        tokens.push(
+            serde_json::from_value(json!({
+                "token":"exact", "bytes":[101,120,97,99,116], "logprob":-1,
+                "top_logprobs":[],
+            }))
+            .unwrap(),
+        );
+    }
+    let (mut stream, _) = super::map_response_events(
+        None,
+        futures::stream::iter([
+            Ok(ResponseEvent::ResponseFact(expected.clone())),
+            Ok(ResponseEvent::ResponseFact(
+                ResponseFact::MalformedProbabilities.into(),
+            )),
+            Ok(probability_test_completion()),
+        ]),
+        test_session_telemetry(),
+        InferenceTraceAttempt::disabled(),
+        test_model_provider(),
+        false,
+        /*discard_empty_probability_facts*/ true,
+    );
+    let mapper = stream.mapper_task.take().unwrap();
+    let Some(Ok(ResponseEvent::ResponseFact(actual))) = stream.next().await else {
+        panic!("nonempty fact disappeared");
+    };
+    assert_eq!(actual, expected);
+    assert!(matches!(stream.next().await,
+        Some(Ok(ResponseEvent::ResponseFact(received)))
+            if received.fact == ResponseFact::MalformedProbabilities));
+    assert!(matches!(
+        stream.next().await,
+        Some(Ok(ResponseEvent::Completed { .. }))
+    ));
+    assert!(stream.next().await.is_none());
+    mapper.await.unwrap();
+}
