+#[tokio::test]
+async fn empty_probability_filter_follows_interceptors_and_preserves_raw_frames() {
+    use codex_protocol::protocol::{
+        ResponsesEventTransport, SdkRawProviderEvent, SdkRawProviderSource,
+    };
+    struct Recorder(Arc<Mutex<Vec<&'static str>>>);
+    impl codex_extension_api::ModelResponseInterceptor for Recorder {
+        fn intercept(
+            self: Box<Self>,
+            stream: codex_extension_api::ModelResponseStream,
+        ) -> codex_extension_api::ModelResponseStream {
+            Box::pin(stream.inspect(move |event| {
+                self.0.lock().unwrap().push(match event {
+                    Ok(ResponseEvent::RawProvider(_)) => "raw",
+                    Ok(ResponseEvent::ResponseFact(_)) => "fact",
+                    Ok(ResponseEvent::OutputTextDelta(_)) => "text",
+                    Ok(ResponseEvent::Completed { .. }) => "complete",
+                    _ => "other",
+                })
+            }))
+        }
+    }
+    let payload = json!({"type":"response.output_text.delta", "delta":"line\n\"é", "logprobs":[]});
+    let (sender, rx_event) = tokio::sync::mpsc::channel(4);
+    for event in [
+        ResponseEvent::RawProvider(SdkRawProviderEvent {
+            source: SdkRawProviderSource::Responses,
+            transport: ResponsesEventTransport::Websocket,
+            payload: payload.clone(),
+        }),
+        empty_probability_event(false),
+        ResponseEvent::OutputTextDelta("line\n\"é".into()),
+        probability_test_completion(),
+    ] {
+        sender.try_send(Ok(event)).unwrap();
+    }
+    drop(sender);
+    let seen = Arc::new(Mutex::new(vec![]));
+    let (mut stream, _) = super::map_response_stream(
+        codex_api::ResponseStream {
+            producer_task: None,
+            producer_stop: None,
+            rx_event,
+            upstream_request_id: None,
+            interrupt: None,
+        },
+        test_session_telemetry(),
+        InferenceTraceAttempt::disabled(),
+        test_model_provider(),
+        vec![Box::new(Recorder(Arc::clone(&seen)))],
+        false,
+        false,
+    );
+    let mapper = stream.mapper_task.take().unwrap();
+    let Some(Ok(ResponseEvent::RawProvider(raw))) = stream.next().await else {
+        panic!("raw frame disappeared");
+    };
+    assert_eq!(raw.payload, payload);
+    assert!(matches!(stream.next().await,
+        Some(Ok(ResponseEvent::OutputTextDelta(delta))) if delta == "line\n\"é"));
+    assert!(matches!(
+        stream.next().await,
+        Some(Ok(ResponseEvent::Completed { .. }))
+    ));
+    assert!(stream.next().await.is_none());
+    mapper.await.unwrap();
+    assert_eq!(
+        *seen.lock().unwrap(),
+        vec!["raw", "fact", "text", "complete"]
+    );
+}
