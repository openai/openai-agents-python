+
+fn empty_probability_event(snapshot: bool) -> ResponseEvent {
+    ResponseEvent::ResponseFact(
+        codex_protocol::response_facts::ResponseFact::TextProbabilities {
+            item_id: Some("original-item".into()),
+            output_index: Some(2),
+            content_index: Some(3),
+            snapshot,
+            delta: (!snapshot).then(|| "line\n\"é".into()),
+            tokens: vec![],
+            capture_complete: true,
+        }
+        .into(),
+    )
+}
+
+fn probability_test_completion() -> ResponseEvent {
+    ResponseEvent::Completed {
+        response_id: "probability-test-response".into(),
+        token_usage: None,
+        usage_metadata: None,
+        end_turn: None,
+    }
+}
+
+#[tokio::test]
+async fn uncaptured_empty_probability_facts_skip_the_retention_fence() {
+    for setting in [None, Some(None)] {
+        for snapshot in [false, true] {
+            let mut prompt = Prompt::default();
+            prompt.request_controls.top_logprobs = setting;
+            let (mut stream, _) = super::map_response_events(
+                None,
+                futures::stream::iter([
+                    Ok(empty_probability_event(snapshot)),
+                    Ok(ResponseEvent::OutputTextDelta("exact text".into())),
+                    Ok(probability_test_completion()),
+                ]),
+                test_session_telemetry(),
+                InferenceTraceAttempt::disabled(),
+                test_model_provider(),
+                false,
+                !prompt.request_controls.top_logprobs.flatten().is_some(),
+            );
+            let mapper = stream.mapper_task.take().unwrap();
+            assert!(matches!(stream.next().await,
+                Some(Ok(ResponseEvent::OutputTextDelta(delta))) if delta == "exact text"));
+            assert!(!stream.observation_pending);
+            assert!(matches!(
+                stream.next().await,
+                Some(Ok(ResponseEvent::Completed { .. }))
+            ));
+            assert!(stream.next().await.is_none());
+            mapper.await.unwrap();
+        }
+    }
+}
