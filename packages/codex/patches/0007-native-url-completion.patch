+async fn real_ingress_during_policy_review(list: bool) {
+    tokio::time::timeout(std::time::Duration::from_secs(10), async move {
+        let router = ElicitationRequestRouter::default();
+        let entered = Arc::new(tokio::sync::Notify::new());
+        let release = Arc::new(tokio::sync::Semaphore::new(0));
+        let completed = Arc::new(tokio::sync::Semaphore::new(0));
+        let manager = ElicitationRequestManager::new(
+            batch_authority().config,
+            Some(Arc::new(HoldIngressPolicy {
+                entered: entered.clone(),
+                release: release.clone(),
+            })),
+            None,
+            router.clone(),
+        );
+        let (events, received) = async_channel::unbounded();
+        let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let client = Arc::new(
+            codex_rmcp_client::RmcpClient::new_in_process_client(Arc::new(IngressPeer {
+                list,
+                calls: calls.clone(),
+            }))
+            .await
+            .unwrap(),
+        );
+        client
+            .initialize_with_url_notifications(
+                rmcp::model::InitializeRequestParams::new(
+                    rmcp::model::ClientCapabilities::default(),
+                    rmcp::model::Implementation::new("ingress-test", "1"),
+                ),
+                Some(std::time::Duration::from_secs(5)),
+                Arc::new(move |instance| {
+                    manager.make_sender_with_connection(
+                        "one".into(),
+                        Some(events.clone()),
+                        &ClientMcpExtensions::default(),
+                        Some(instance),
+                    )
+                }),
+                Some(Arc::new({
+                    let router = router.clone();
+                    let completed = completed.clone();
+                    move |instance, event| {
+                        if matches!(&event, UrlNotification::Complete(_)) {
+                            completed.add_permits(1);
+                        }
+                        router.url_notification("one", instance, event);
+                    }
+                })),
+            )
+            .await
+            .unwrap();
+        let task = tokio::spawn({
+            let client = client.clone();
+            async move {
+                client
+                    .call_tool("synthetic".into(), None, None, None)
+                    .await
+                    .unwrap()
+            }
+        });
+        entered.notified().await;
+        let count = if list { 2 } else { 1 };
+        completed.acquire_many_owned(count).await.unwrap().forget();
+        assert!(
+            received.try_recv().is_err(),
+            "Policy must precede public consent"
+        );
+        assert!(router.urls.lock().unwrap().is_empty());
+        assert!(router.requests.lock().unwrap().is_empty());
+        release.add_permits(count as usize);
+        let mut tokens = Vec::new();
+        for _ in 0..count {
+            tokens.push(event_token(received.recv().await.unwrap()));
+        }
+        assert!(!task.is_finished(), "A completion is not consent");
+        for token in tokens {
+            router
+                .resolve(
+                    "one".into(),
+                    RequestId::String(token.into()),
+                    ElicitationResponse {
+                        action: ElicitationAction::Accept,
+                        content: None,
+                        meta: None,
+                    },
+                )
+                .await
+                .unwrap();
+        }
+        for _ in 0..count {
+            assert!(matches!(
+                received.recv().await.unwrap().msg,
+                EventMsg::ElicitationStatus {
+                    completed: true,
+                    ..
+                }
+            ));
+        }
+        let result = task.await.unwrap();
+        assert_eq!(result.is_error, list.then_some(true));
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        assert!(router.requests.lock().unwrap().is_empty());
+        client.shutdown().await;
+    })
+    .await
+    .expect("Ingress completion must survive policy delay");
+}
