+    router.connection_opened("codex_apps", 1);
+    let declined = issue(&router, "one", 1, "A", "first");
+    let _reply = consent(&router, "one", "first");
+    router
+        .resolve(
+            "one".into(),
+            RequestId::String("first".into()),
+            ElicitationResponse {
+                action: ElicitationAction::Decline,
+                content: None,
+                meta: None,
+            },
+        )
+        .await
+        .unwrap();
+    router.url_notification("one", 1, UrlNotification::Complete("A".into()));
+    assert!(matches!(
+        declined.recv().await.unwrap().msg,
+        EventMsg::ElicitationStatus {
+            completed: false,
+            ..
+        }
+    ));
+    assert!(declined.try_recv().is_err());
+    let closed = issue(&router, "one", 2, "B", "second");
+    router.url_notification("one", 2, UrlNotification::Closed);
+    assert!(matches!(
+        closed.recv().await.unwrap().msg,
+        EventMsg::ElicitationStatus {
+            completed: false,
+            ..
+        }
+    ));
+    router.url_notification("one", 2, UrlNotification::Complete("B".into()));
+    assert!(closed.try_recv().is_err());
+}
