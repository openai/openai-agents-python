+        let mut unowned = request(12, "root");
+        let JsonRpcMessage::Request(envelope) = &mut unowned else {
+            panic!("Request")
+        };
+        envelope
+            .request
+            .extensions_mut()
+            .insert(InboundStreamOrigin::OutboundRequest(RequestId::Number(777)));
+        wire.inner.0.push_back(unowned);
+        let root = wire.receive().await.unwrap();
+        assert!(receipt(&root).is_live());
+    }
