+struct HoldIngressPolicy {
+    entered: Arc<tokio::sync::Notify>,
+    release: Arc<tokio::sync::Semaphore>,
+}
+impl ElicitationReviewer for HoldIngressPolicy {
+    fn review(
+        &self,
+        _: ElicitationReviewRequest,
+    ) -> BoxFuture<'static, Result<Option<ElicitationResponse>>> {
+        let entered = self.entered.clone();
+        let release = self.release.clone();
+        Box::pin(async move {
+            entered.notify_one();
+            release.acquire_owned().await.unwrap().forget();
+            Ok(None)
+        })
+    }
+}
+struct IngressPeer {
+    list: bool,
+    calls: Arc<std::sync::atomic::AtomicUsize>,
+}
+impl codex_rmcp_client::InProcessTransportFactory for IngressPeer {
+    fn open(&self) -> BoxFuture<'static, std::io::Result<tokio::io::DuplexStream>> {
+        use tokio::io::{AsyncBufReadExt, AsyncWriteExt};
+        let list = self.list;
+        let calls = self.calls.clone();
+        Box::pin(async move {
+            let (client, server) = tokio::io::duplex(16384);
+            tokio::spawn(async move {
+                let (reader, mut writer) = tokio::io::split(server);
+                let mut lines = tokio::io::BufReader::new(reader).lines();
+                let mut original = None;
+                while let Some(line) = lines.next_line().await.unwrap() {
+                    let message: Value = serde_json::from_str(&line).unwrap();
+                    let frames = match message["method"].as_str() {
+                        Some("initialize") => vec![
+                            json!({"jsonrpc":"2.0","id":message["id"],"result":{"protocolVersion":message["params"]["protocolVersion"],"capabilities":{"tools":{}},"serverInfo":{"name":"ingress-test","version":"1"}}}),
+                        ],
+                        Some("tools/call") => {
+                            assert_eq!(
+                                calls.fetch_add(1, Ordering::SeqCst),
+                                0,
+                                "No automatic replay"
+                            );
+                            original = Some(message["id"].clone());
+                            if list {
+                                vec![
+                                    json!({"jsonrpc":"2.0","id":message["id"],"error":{"code":-32042,"message":"Synthetic","data":{"elicitations":[url("A"),url("B")]}}}),
+                                    json!({"jsonrpc":"2.0","method":"notifications/elicitation/complete","params":{"elicitationId":"B"}}),
+                                    json!({"jsonrpc":"2.0","method":"notifications/elicitation/complete","params":{"elicitationId":"A"}}),
+                                ]
+                            } else {
+                                vec![
+                                    json!({"jsonrpc":"2.0","id":873,"method":"elicitation/create","params":url("A")}),
+                                    json!({"jsonrpc":"2.0","method":"notifications/elicitation/complete","params":{"elicitationId":"A"}}),
+                                ]
+                            }
+                        }
+                        _ if !list && message["id"] == 873 && message.get("result").is_some() => {
+                            assert_eq!(message["result"]["action"], "accept");
+                            vec![
+                                json!({"jsonrpc":"2.0","id":original.take().unwrap(),"result":{"content":[{"type":"text","text":"synthetic accepted"}]}}),
+                            ]
+                        }
+                        _ => vec![],
+                    };
+                    // One real wire write; RMCP independently schedules each handler.
+                    let wire = frames
+                        .into_iter()
+                        .map(|frame| frame.to_string() + "\n")
+                        .collect::<String>();
+                    writer.write_all(wire.as_bytes()).await.unwrap();
+                }
+            });
+            Ok(client)
+        })
+    }
+}
