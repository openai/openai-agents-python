diff --git a/codex-rs/codex-mcp/src/application_apps.rs b/codex-rs/codex-mcp/src/application_apps.rs
new file mode 100644
index 0000000..8a1c711
--- /dev/null
+++ b/codex-rs/codex-mcp/src/application_apps.rs
@@ -0,0 +1,106 @@
+//! Two explicit application capabilities; neither is inferred from a server name.
+use crate::{CODEX_APPS_MCP_SERVER_NAME, McpConfig, McpServerSource};
+use codex_config::McpServerConfig;
+use codex_login::AuthManager;
+use std::sync::Arc;
+
+pub const APPLICATION_APPS_CONTRIBUTOR_ID: &str = "agents_hosted_verification";
+
+#[derive(Clone)]
+pub struct ApplicationApps {
+    registration: McpServerConfig,
+    personal_auth: Option<Arc<AuthManager>>,
+}
+impl std::fmt::Debug for ApplicationApps {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ApplicationApps")
+            .field("personal", &self.personal_auth.is_some())
+            .finish_non_exhaustive()
+    }
+}
+impl ApplicationApps {
+    pub fn verification(registration: McpServerConfig) -> Self {
+        Self {
+            registration,
+            personal_auth: None,
+        }
+    }
+    pub fn chatgpt(registration: McpServerConfig, manager: Arc<AuthManager>) -> Self {
+        Self {
+            registration,
+            personal_auth: Some(manager),
+        }
+    }
+    pub fn registration(&self) -> &McpServerConfig {
+        &self.registration
+    }
+    pub fn personal_auth(&self) -> Option<Arc<AuthManager>> {
+        self.personal_auth.clone()
+    }
+    pub fn admits(&self, config: &McpConfig) -> bool {
+        config.mcp_server_catalog.server(CODEX_APPS_MCP_SERVER_NAME).is_some_and(|server| {
+            matches!(server.source(), McpServerSource::Extension { id, host_owned_apps: true } if id == APPLICATION_APPS_CONTRIBUTOR_ID)
+            && server.config().is_local_environment()
+            && server.config().transport == self.registration.transport
+            && server.config().auth == self.registration.auth
+            && server.config().environment_id == self.registration.environment_id
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::mcp::{codex_apps_mcp_server_config, host_owned_codex_apps_enabled};
+    use crate::{McpServerRegistration, ResolvedMcpCatalog};
+    use codex_config::McpServerAuth;
+    use codex_login::CodexAuth;
+    fn registered(config: &mut McpConfig, id: &str, server: McpServerConfig) {
+        let mut catalog = ResolvedMcpCatalog::builder();
+        catalog.register(McpServerRegistration::from_hosted_apps(id, 0, server));
+        config.mcp_server_catalog = catalog.build();
+    }
+    #[test]
+    fn proof_capability_requires_the_exact_typed_declaration_and_source() {
+        let mut config = crate::mcp::tests::test_mcp_config(Default::default());
+        config.apps_enabled = false;
+        let mut server = codex_apps_mcp_server_config("https://chatgpt.com", None, None);
+        server.auth = McpServerAuth::OAuth;
+        registered(&mut config, APPLICATION_APPS_CONTRIBUTOR_ID, server.clone());
+        let key = CodexAuth::from_api_key("model-key");
+        assert!(!host_owned_codex_apps_enabled(&config, Some(&key)));
+        config.application_apps = Some(Arc::new(ApplicationApps::verification(server.clone())));
+        assert!(host_owned_codex_apps_enabled(&config, Some(&key)));
+        assert!(
+            config
+                .application_apps
+                .as_ref()
+                .unwrap()
+                .personal_auth()
+                .is_none()
+        );
+        registered(&mut config, "unrelated-extension", server);
+        assert!(!host_owned_codex_apps_enabled(&config, Some(&key)));
+    }
+    #[test]
+    fn personal_capability_uses_a_separate_principal_and_exact_registration() {
+        let mut config = crate::mcp::tests::test_mcp_config(Default::default());
+        config.apps_enabled = false;
+        let server = codex_apps_mcp_server_config("https://chatgpt.com", None, None);
+        registered(&mut config, APPLICATION_APPS_CONTRIBUTOR_ID, server.clone());
+        let manager =
+            AuthManager::from_auth_for_testing(CodexAuth::create_dummy_chatgpt_auth_for_testing());
+        config.application_apps = Some(Arc::new(ApplicationApps::chatgpt(server.clone(), manager)));
+        assert!(host_owned_codex_apps_enabled(
+            &config,
+            Some(&CodexAuth::from_api_key("model-key"))
+        ));
+        let mut replacement = server;
+        replacement.auth = McpServerAuth::OAuth;
+        registered(&mut config, APPLICATION_APPS_CONTRIBUTOR_ID, replacement);
+        assert!(!host_owned_codex_apps_enabled(
+            &config,
+            Some(&CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        ));
+    }
+}
