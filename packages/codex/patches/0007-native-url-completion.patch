index 0000000000000000000000000000000000000000..3151a7034a2b2672dbafc0d22539f3a8b2129d1b
--- /dev/null
+++ b/codex-rs/rmcp-client/src/url_ingress.rs
@@ -0,0 +1,346 @@
+//! Private progress receipts for URL envelopes observed on one concrete transport.
+//! No unsolicited completion is retained and a receipt never supplies consent.
+use std::collections::HashSet;
+use std::future::Future;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, Weak};
+
+use rmcp::model::{
+    ElicitRequestParams, GetExtensions, RequestId, ServerNotification, ServerRequest,
+};
+use serde::Deserialize;
+use tokio_util::sync::CancellationToken;
+
+const MAX_URL_IDS: usize = 1024;
+
+/// Opaque local progress shared with the native host. It cannot supply consent,
+/// serialize onto the wire, or create a receipt outside this transport's ingress.
+#[derive(Clone)]
+pub struct UrlCompletionReceipt(Arc<Receipt>);
+struct Receipt {
+    connection: u64,
+    request: Option<RequestId>,
+    ids: Vec<String>,
+    completed: Mutex<HashSet<String>>,
+    retired: AtomicBool,
+    adopted: AtomicBool,
+    transport: CancellationToken,
+    call: Option<Weak<Call>>,
+}
+impl UrlCompletionReceipt {
+    pub fn is_live(&self) -> bool {
+        !self.0.retired.load(Ordering::Acquire)
+            && !self.0.transport.is_cancelled()
+            && (self.0.adopted.load(Ordering::Acquire)
+                || self
+                    .0
+                    .call
+                    .as_ref()
+                    .is_none_or(|call| call.upgrade().is_some_and(|call| call.is_live())))
+    }
+    pub fn matches_request(&self, id: &RequestId) -> bool {
+        self.0.request.as_ref().is_none_or(|request| request == id)
+    }
+    pub fn matches(&self, connection: u64, ids: &[&str]) -> bool {
+        self.is_live()
+            && self.0.connection == connection
+            && self
+                .0
+                .ids
+                .iter()
+                .map(String::as_str)
+                .eq(ids.iter().copied())
+    }
+    pub fn completed(&self, id: &str) -> bool {
+        self.is_live()
+            && self
+                .0
+                .completed
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .contains(id)
+    }
+    /// Transfers progress lifetime after Core validates policy, source, and reservation.
+    pub fn adopt(&self) -> bool {
+        // Core checked the exact source and captured any applicable admission.
+        // A successful source check is the transfer point; expired sources cannot
+        // revive by setting this flag. Core retains owner/admission revocation.
+        if !self.is_live() {
+            return false;
+        }
+        self.0.adopted.store(true, Ordering::Release);
+        self.is_live()
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct IngressContext(pub(crate) Result<UrlCompletionReceipt, ()>);
+pub(crate) struct ReceiptLease(pub(crate) UrlCompletionReceipt);
+impl Drop for ReceiptLease {
+    fn drop(&mut self) {
+        if !self.0.0.adopted.load(Ordering::Acquire) {
+            self.0.0.retired.store(true, Ordering::Release);
+        }
+    }
+}
+tokio::task_local! { static RECEIPT: Option<UrlCompletionReceipt>; }
+pub fn current_url_completion_receipt() -> Option<UrlCompletionReceipt> {
+    RECEIPT.try_with(Clone::clone).ok().flatten()
+}
+pub(crate) async fn scope_receipt<T>(
+    receipt: Option<UrlCompletionReceipt>,
+    future: impl Future<Output = T>,
+) -> T {
+    RECEIPT.scope(receipt, future).await
+}
+
+/// The call future owns revocation even for ordinary root/unowned tools/call.
+/// Transport records retain only a Weak pointer, so a late error cannot revive a caller.
+pub(crate) struct UrlCall(pub(crate) Arc<Call>);
+pub(crate) struct Call {
+    live: CancellationToken,
+    owner: Option<crate::elicitation_owner::ElicitationOwner>,
+    receipt: Mutex<Option<IngressContext>>,
+}
+impl Default for UrlCall {
+    fn default() -> Self {
+        Self(Arc::new(Call {
+            live: CancellationToken::new(),
+            owner: crate::elicitation_owner::elicitation_owner_snapshot(),
+            receipt: Mutex::new(None),
+        }))
+    }
+}
+
+impl Call {
+    pub(crate) fn owner(&self) -> Option<crate::elicitation_owner::ElicitationOwner> {
+        self.owner.clone().filter(|_| self.is_live())
+    }
+    pub(crate) fn is_live(&self) -> bool {
+        !self.live.is_cancelled() && self.owner.as_ref().is_none_or(|owner| owner.is_live())
+    }
+}
+impl Drop for UrlCall {
+    fn drop(&mut self) {
+        self.0.live.cancel();
+    }
+}
+tokio::task_local! { static CALL: Arc<Call>; }
+impl UrlCall {
+    pub(crate) async fn scope<T>(&self, future: impl Future<Output = T>) -> T {
+        CALL.scope(self.0.clone(), future).await
+    }
+    pub(crate) fn receipt(&self) -> Option<IngressContext> {
+        self.0
+            .receipt
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone()
+    }
+}
+pub(crate) fn current_call() -> Option<Weak<Call>> {
+    CALL.try_with(Arc::downgrade).ok()
+}
+pub(crate) fn current_owned_call() -> Option<Weak<Call>> {
+    // Preserve owned identity even if its revocation happened before request creation.
+    CALL.try_with(|call| call.owner.as_ref().map(|_| Arc::downgrade(call)))
+        .ok()
+        .flatten()
+}
+
+#[derive(Default)]
+struct State {
+    connection: Option<u64>,
+    seen: HashSet<String>,
+    active: Vec<Weak<Receipt>>,
+}
+#[derive(Clone, Default)]
+pub(crate) struct UrlIngress {
+    state: Arc<Mutex<State>>,
+    closed: CancellationToken,
+}
+impl UrlIngress {
+    pub(crate) fn bind(&self, instance: u64) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        assert!(state.connection.is_none());
+        state.connection = Some(instance);
+    }
+    pub(crate) fn close(&self) {
+        self.closed.cancel();
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.active.clear();
+        state.seen.clear();
+    }
+    fn register(
+        &self,
+        request: Option<RequestId>,
+        ids: Vec<String>,
+        call: Option<Weak<Call>>,
+    ) -> Result<UrlCompletionReceipt, ()> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let connection = state.connection.ok_or(())?;
+        // Validate/collision-check the entire list before consuming a single new ID.
+        if self.closed.is_cancelled()
+            || ids.is_empty()
+            || ids.len() > MAX_URL_IDS
+            || ids.iter().collect::<HashSet<_>>().len() != ids.len()
+            || ids.iter().any(|id| state.seen.contains(id))
+            || state.seen.len() + ids.len() > MAX_URL_IDS
+        {
+            return Err(());
+        }
+        // A structurally valid observed envelope consumes its replay names even
+        // when its original owned call expired before the handler was scheduled.
+        state.seen.extend(ids.iter().cloned());
+        if call
+            .as_ref()
+            .is_some_and(|call| call.upgrade().is_none_or(|call| !call.is_live()))
+        {
+            return Err(());
+        }
+        state.active.retain(|item| {
+            item.upgrade()
+                .is_some_and(|receipt| UrlCompletionReceipt(receipt).is_live())
+        });
+        let receipt = UrlCompletionReceipt(Arc::new(Receipt {
+            connection,
+            request,
+            ids,
+            completed: Mutex::new(HashSet::new()),
+            retired: AtomicBool::new(false),
+            adopted: AtomicBool::new(false),
+            transport: self.closed.clone(),
+            call,
+        }));
+        // Valid observed IDs are unique for this transport, including after policy denial.
+        // These bounded replay markers are not public tokens or Core reservations.
+        state.active.push(Arc::downgrade(&receipt.0));
+        Ok(receipt)
+    }
+    pub(crate) fn request(
+        &self,
+        id: &RequestId,
+        request: &mut ServerRequest,
+        call: Option<Weak<Call>>,
+    ) {
+        // Generic RMCP callbacks without an opted-in URL lifecycle keep their route.
+        if self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .connection
+            .is_none()
+        {
+            return;
+        }
+        let member = match request {
+            ServerRequest::ElicitRequest(value) => Some(value.params.clone()),
+            ServerRequest::CustomRequest(value) if value.method == "elicitation/create" => value
+                .params
+                .clone()
+                .and_then(|params| serde_json::from_value(params).ok()),
+            _ => None,
+        };
+        if let Some(ElicitRequestParams::UrlElicitationParams { elicitation_id, .. }) = member {
+            let receipt = self.register(Some(id.clone()), vec![elicitation_id], call);
+            request.extensions_mut().insert(IngressContext(receipt));
+        }
+    }
+    pub(crate) fn error(&self, error: &rmcp::ErrorData, call: Option<Weak<Call>>) {
+        if error.code.0 != -32042 {
+            return;
+        }
+        let Some(call) = call
+            .and_then(|call| call.upgrade())
+            .filter(|call| call.is_live())
+        else {
+            return;
+        };
+        #[derive(Deserialize)]
+        struct Required {
+            elicitations: Vec<ElicitRequestParams>,
+        }
+        let ids = error
+            .data
+            .clone()
+            .and_then(|data| serde_json::from_value::<Required>(data).ok())
+            .and_then(|required| {
+                required
+                    .elicitations
+                    .into_iter()
+                    .map(|request| match request {
+                        ElicitRequestParams::UrlElicitationParams { elicitation_id, .. } => {
+                            Some(elicitation_id)
+                        }
+                        _ => None,
+                    })
+                    .collect::<Option<Vec<_>>>()
+            });
+        let mut slot = call
+            .receipt
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        // One failed operation cannot replace its already captured envelope/list.
+        let receipt = if slot.is_some() {
+            Err(())
+        } else {
+            ids.ok_or(())
+                .and_then(|ids| self.register(None, ids, Some(Arc::downgrade(&call))))
+        };
+        *slot = Some(IngressContext(receipt));
+    }
+    pub(crate) fn notification(&self, notification: &ServerNotification) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.active.retain(|item| {
+            item.upgrade()
+                .is_some_and(|receipt| UrlCompletionReceipt(receipt).is_live())
+        });
+        match notification {
+            ServerNotification::CustomNotification(value)
+                if value.method == "notifications/elicitation/complete" =>
+            {
+                let Some(id) = value
+                    .params
+                    .as_ref()
+                    .and_then(|params| params.get("elicitationId"))
+                    .and_then(serde_json::Value::as_str)
+                else {
+                    return;
+                };
+                for receipt in state.active.iter().filter_map(Weak::upgrade) {
+                    if receipt.ids.iter().any(|member| member == id) {
+                        receipt
+                            .completed
+                            .lock()
+                            .unwrap_or_else(std::sync::PoisonError::into_inner)
+                            .insert(id.to_owned());
+                    }
+                }
+            }
+            ServerNotification::CancelledNotification(value) => {
+                for receipt in state.active.iter().filter_map(Weak::upgrade) {
+                    if receipt
+                        .request
+                        .as_ref()
+                        .is_some_and(|id| Some(id) == value.params.request_id.as_ref())
+                    {
+                        receipt.retired.store(true, Ordering::Release);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+}
