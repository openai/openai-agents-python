+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn plan(reason: &str) -> CodexAppsAuthElicitationPlan {
+        let failure = codex_mcp::CodexAppsConnectorAuthFailure {
+            connector_id: "calendar".into(),
+            connector_name: "Calendar".into(),
+            install_url: "https://chatgpt.com/apps/calendar/calendar".into(),
+            auth_reason: Some(reason.into()),
+            link_id: Some("legacy-implicit-real-link".into()),
+            requested_scopes: Some(vec!["calendar.write".into()]),
+            error_code: None,
+            error_http_status_code: Some(401),
+            error_action: None,
+        };
+        CodexAppsAuthElicitationPlan {
+            elicitation: codex_mcp::build_auth_elicitation("call", &failure),
+            auth_failure: failure,
+        }
+    }
+    fn complete() -> Value {
+        json!({"status":"COMPLETE", "connector_id":"calendar", "link":{"id":"legacy-implicit-real-link", "connector_id":"calendar", "auth_status":"ACTIVE", "scopes":["calendar.read","calendar.write"]}})
+    }
+    #[test]
+    fn complete_requires_the_exact_connector_link_and_actual_scopes() {
+        let expected = plan("oauth_upgrade_required");
+        assert!(
+            serde_json::from_value::<State>(complete())
+                .unwrap()
+                .proves(&expected)
+        );
+        for (field, value) in [
+            ("/status", json!("PENDING")),
+            ("/status", json!("ERROR")),
+            ("/connector_id", json!("other")),
+            ("/link", Value::Null),
+            ("/link/id", json!("another-link")),
+            ("/link/id", json!("synthetic_link::calendar")),
+            ("/link/connector_id", json!("other")),
+            ("/link/auth_status", json!("REAUTH_REQUIRED")),
+            ("/link/scopes", json!(["calendar.read"])),
+            ("/link/scopes", Value::Null),
+        ] {
+            let mut response = complete();
+            *response.pointer_mut(field).unwrap() = value;
+            assert!(
+                !serde_json::from_value::<State>(response)
+                    .unwrap()
+                    .proves(&expected)
+            );
+        }
+        let mut new = plan("missing_link");
+        new.auth_failure.link_id = None;
+        assert!(
+            serde_json::from_value::<State>(complete())
+                .unwrap()
+                .proves(&new)
+        );
+        let mut auth_only = plan("reauthentication_required");
+        auth_only.auth_failure.requested_scopes = None;
+        let mut response = complete();
+        response["link"]["scopes"] = Value::Null;
+        assert!(
+            serde_json::from_value::<State>(response)
+                .unwrap()
+                .proves(&auth_only)
+        );
+        let mut malformed = complete();
+        malformed["status"] = json!("unknown");
+        assert!(serde_json::from_value::<State>(malformed).is_err());
+    }
+    #[test]
+    fn backend_paths_are_explicit_and_state_is_one_encoded_segment() {
+        assert_eq!(
+            backend_base("https://chatgpt.com").unwrap().path(),
+            "/backend-api/"
+        );
+        assert_eq!(
+            backend_base("https://chatgpt.com/backend-api")
+                .unwrap()
+                .path(),
+            "/backend-api/"
+        );
+        assert_eq!(
+            backend_base("http://127.0.0.1:1234/api/codex")
+                .unwrap()
+                .path(),
+            "/api/"
+        );
+        assert!(backend_base("https://chatgpt.com/backend-api/ps/mcp").is_none());
+        assert!(backend_base("https://chatgpt.com/unknown").is_none());
+        assert!(backend_base("http://remote.invalid/api").is_none());
+        assert!(backend_base("https://user:secret@chatgpt.com/backend-api").is_none());
+        let mut url = backend_base("https://chatgpt.com")
+            .unwrap()
+            .join("aip/connectors/links/oauth/state/")
+            .unwrap();
+        url.path_segments_mut().unwrap().push("opaque/state?value");
+        assert!(url.path().ends_with("opaque%2Fstate%3Fvalue"));
+    }
+}
