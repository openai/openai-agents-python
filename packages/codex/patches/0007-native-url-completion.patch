+            .receipt()
+            .unwrap()
+            .0
+            .unwrap_or_else(|_| panic!("Receipt"));
+        owner.revoke();
+        wire.receive().await.unwrap();
+        assert!(!receipt.is_live());
+        let mut other = transport(vec![request(1, "B")]);
+        let frame = other.receive().await.unwrap();
+        let receipt = self::receipt(&frame);
+        other.close().await.unwrap();
+        assert!(!receipt.is_live());
+    }
+    async fn captured_owned_url_receipt() -> (
+        OwnedTransport<Wire>,
+        crate::url_ingress::UrlCall,
+        ElicitationOwner,
+        UrlCompletionReceipt,
+    ) {
+        let owner = ElicitationOwner::for_admission("original".into(), Arc::new(()));
+        let call = scope_owner(Some(owner.clone()), async {
+            crate::url_ingress::UrlCall::default()
+        })
+        .await;
+        let mut direct = request(9, "A");
+        let JsonRpcMessage::Request(envelope) = &mut direct else {
+            panic!("Request")
+        };
+        envelope
+            .request
+            .extensions_mut()
+            .insert(InboundStreamOrigin::OutboundRequest(RequestId::Number(8)));
+        let mut wire = transport(vec![direct, completion("A")]);
+        call.scope(send_call(&mut wire, 8)).await;
+        let frame = wire.receive().await.unwrap();
+        let receipt = self::receipt(&frame);
+        (wire, call, owner, receipt)
+    }
+    #[tokio::test]
+    async fn adoption_cannot_revive_a_receipt_whose_original_source_already_expired() {
+        for revoke_owner in [false, true] {
+            let (mut wire, call, owner, receipt) = captured_owned_url_receipt().await;
+            if revoke_owner {
+                owner.revoke();
+            } else {
+                drop(call);
+            }
+            assert!(!receipt.is_live());
+            assert!(!receipt.adopt());
+            wire.receive().await.unwrap();
+            assert!(!receipt.is_live() && !receipt.completed("A"));
+            assert!(
+                !receipt.adopt(),
+                "A failed adoption must not turn into a grant"
+            );
+        }
+    }
+    #[tokio::test]
+    async fn adopted_progress_outlives_inner_call_but_transport_revocation_remains_terminal() {
+        let (mut wire, call, source, receipt) = captured_owned_url_receipt().await;
+        assert!(
+            receipt.adopt(),
+            "Core validates its live admission before transfer"
+        );
+        drop(call);
+        source.revoke(); // The RPC source ends; Core's captured admission is separate.
+        assert!(receipt.is_live());
+        wire.receive().await.unwrap();
+        assert!(receipt.completed("A"));
+        wire.close().await.unwrap();
+        assert!(!receipt.is_live() && !receipt.completed("A"));
+        assert!(
+            !receipt.adopt(),
+            "Adoption cannot revive a closed transport"
+        );
+    }
+}
