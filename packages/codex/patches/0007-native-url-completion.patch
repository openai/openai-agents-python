+#[tokio::test]
+async fn batch_registers_every_id_before_first_publication_and_accepts_early_completion() {
+    let router = ElicitationRequestRouter::default();
+    router.connection_opened("one", 1);
+    router.connection_opened("one", 2);
+    router.connection_opened("codex_apps", 1);
+    let worker = router.clone();
+    let (events, received) = async_channel::unbounded();
+    let task = tokio::spawn(async move {
+        worker
+            .request_url_batch(
+                Some(events),
+                &batch_authority(),
+                "one".into(),
+                Some(1),
+                vec![url("A"), url("B")],
+            )
+            .await
+    });
+    let first = event_token(received.recv().await.unwrap());
+    assert_eq!(router.urls.lock().unwrap().len(), 2);
+    router.url_notification("one", 1, UrlNotification::Complete("B".into()));
+    let second = event_token(received.recv().await.unwrap());
+    router
+        .resolve(
+            "one".into(),
+            RequestId::String(first.into()),
+            ElicitationResponse {
+                action: ElicitationAction::Accept,
+                content: None,
+                meta: None,
+            },
+        )
+        .await
+        .unwrap();
+    assert!(!task.is_finished());
+    router
+        .resolve(
+            "one".into(),
+            RequestId::String(second.into()),
+            ElicitationResponse {
+                action: ElicitationAction::Accept,
+                content: None,
+                meta: None,
+            },
+        )
+        .await
+        .unwrap();
+    router.url_notification("one", 1, UrlNotification::Complete("A".into()));
+    assert_eq!(
+        task.await.unwrap().unwrap().action,
+        ElicitationAction::Accept
+    );
+    assert!(router.requests.lock().unwrap().is_empty());
+}
