+        *router.admission_owner.lock().unwrap() = Some(admission);
+        let source = codex_rmcp_client::ElicitationOwner::for_admission("turn".into(), identity);
+        let worker = router.clone();
+        let original_source = source.clone();
+        let (events, received) = async_channel::unbounded();
+        let task = tokio::spawn(async move {
+            codex_rmcp_client::scope_owner(
+                Some(original_source),
+                worker.request_user_interaction_with_url(
+                    Some(events),
+                    &batch_authority(),
+                    "one".into(),
+                    ElicitationRequest::Url {
+                        meta: None,
+                        message: "Consent".into(),
+                        url: "https://example.invalid".into(),
+                        elicitation_id: "A".into(),
+                    },
+                    Some(1),
+                ),
+            )
+            .await
+        });
+        let id = RequestId::String(event_token(received.recv().await.unwrap()).into());
+        let receipt = router.owned_url_receipt("one", &id, "turn").unwrap();
+        assert!(router.resolve_owned(
+            "one",
+            &id,
+            "turn",
+            ElicitationResponse {
+                action: ElicitationAction::Accept,
+                content: None,
+                meta: None
+            }
+        ));
+        assert_eq!(
+            task.await.unwrap().unwrap().action,
+            ElicitationAction::Accept
+        );
+        source.revoke();
+        assert!(router.owned_url_pending("one", &id, "turn"));
+        assert_eq!(*receipt.borrow(), None);
+        if complete {
+            router.url_notification("one", 1, UrlNotification::Complete("A".into()));
+        } else {
+            cancellation.cancel();
+        }
+        let event = tokio::time::timeout(std::time::Duration::from_secs(1), received.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(
+            matches!(event.msg,EventMsg::ElicitationStatus { completed,.. } if completed==complete)
+        );
+        assert_eq!(*receipt.borrow(), Some(complete));
+        assert!(!router.owned_url_pending("one", &id, "turn"));
+        cancellation.cancel();
+        router.url_notification("one", 1, UrlNotification::Complete("A".into()));
+        assert_eq!(
+            *receipt.borrow(),
+            Some(complete),
+            "The first terminal receipt stays immutable"
+        );
+    }
+}
