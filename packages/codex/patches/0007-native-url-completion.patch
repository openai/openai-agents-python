+                req.extensions()
+                    .get::<rmcp::service::ResponseStreamContext>()
+                    .cloned()
+                    .unwrap()
+            })
+            .await;
+        let form = || {
+            let mut frame = frame(
+                serde_json::json!({"jsonrpc":"2.0","id":9,"method":"elicitation/create","params":{"mode":"form","message":"Synthetic","requestedSchema":{"type":"object","properties":{}}}}),
+            );
+            let JsonRpcMessage::Request(request) = &mut frame else {
+                panic!("Request")
+            };
+            request.request.extensions_mut().insert(context.clone());
+            frame
+        };
+        wire.inner.0.push_back(form());
+        let JsonRpcMessage::Request(live) = wire.receive().await.unwrap() else {
+            panic!("Request")
+        };
+        assert!(
+            live.request
+                .extensions()
+                .get::<ElicitationOwner>()
+                .unwrap()
+                .same_admission(&owner)
+        );
+        assert!(live.request.extensions().get::<IngressContext>().is_none());
+        owner.revoke();
+        wire.inner.0.push_back(form());
+        let JsonRpcMessage::Request(expired) = wire.receive().await.unwrap() else {
+            panic!("Request")
+        };
+        assert!(
+            expired
+                .request
+                .extensions()
+                .get::<IngressContext>()
+                .unwrap()
+                .0
+                .is_err()
+        );
