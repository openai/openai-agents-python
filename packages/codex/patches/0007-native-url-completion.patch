+++ b/codex-rs/codex-mcp/src/url_completion_tests.rs
@@ -0,0 +1,1168 @@
+//! Native owner checks independent of Python scheduling or peer JSON request IDs.
+use super::*;
+use codex_rmcp_client::UrlNotification;
+use serde_json::json;
+
+fn issue(
+    router: &ElicitationRequestRouter,
+    server: &str,
+    connection: u64,
+    id: &str,
+    token: &str,
+) -> async_channel::Receiver<Event> {
+    let (events, receiver) = async_channel::unbounded();
+    router.urls.lock().unwrap().insert(
+        (server.into(), UrlSource::Peer(connection), id.into()),
+        UrlPending {
+            token: token.into(),
+            events,
+            accepted: false,
+            observed_complete: false,
+            ingress: None,
+            retired: false,
+            completion: None,
+            batch: None,
+            owner: None,
+            receipt: tokio::sync::watch::channel(None).0,
+        },
+    );
+    receiver
+}
+
+fn consent(
+    router: &ElicitationRequestRouter,
+    server: &str,
+    token: &str,
+) -> oneshot::Receiver<ElicitationResponse> {
+    let (tx, rx) = oneshot::channel();
+    router.requests.lock().unwrap().insert(
+        (server.into(), RequestId::String(token.into())),
+        PendingResponse {
+            sender: tx,
+            owner: None,
+        },
+    );
+    rx
+}
+
+#[tokio::test]
+async fn completion_requires_same_server_transport_id_and_accepted_consent() {
+    let router = ElicitationRequestRouter::default();
+    router.connection_opened("one", 1);
+    router.connection_opened("one", 2);
+    router.connection_opened("codex_apps", 1);
+    let events = issue(&router, "one", 1, "A", "token");
+    let reply = consent(&router, "one", "token");
+    router.url_notification("two", 1, UrlNotification::Complete("A".into()));
+    router.url_notification("one", 2, UrlNotification::Complete("A".into()));
+    router.url_notification("one", 1, UrlNotification::Complete("B".into()));
+    assert!(events.try_recv().is_err());
+    router.url_notification("one", 1, UrlNotification::Complete("A".into()));
+    assert!(
+        events.try_recv().is_err(),
+        "completion alone is not consent"
+    );
+    router
+        .resolve(
+            "one".into(),
+            RequestId::String("token".into()),
+            ElicitationResponse {
+                action: ElicitationAction::Accept,
+                content: None,
+                meta: None,
+            },
+        )
+        .await
+        .unwrap();
+    assert_eq!(reply.await.unwrap().action, ElicitationAction::Accept);
+    assert!(matches!(
+        events.recv().await.unwrap().msg,
+        EventMsg::ElicitationStatus {
+            completed: true,
+            ..
+        }
+    ));
+    router.url_notification("one", 1, UrlNotification::Complete("A".into()));
+    assert!(
+        events.try_recv().is_err(),
+        "duplicate completion cannot publish twice"
+    );
+    assert!(
+        router
+            .urls
+            .lock()
+            .unwrap()
+            .contains_key(&("one".into(), UrlSource::Peer(1), "A".into())),
+        "retain replay evidence"
+    );
+}
+
+#[tokio::test]
+async fn decline_and_connection_retirement_do_not_complete() {
+    let router = ElicitationRequestRouter::default();
