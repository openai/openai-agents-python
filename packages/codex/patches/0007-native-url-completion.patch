diff --git a/codex-rs/codex-mcp/src/connector_auth_elicitation.rs b/codex-rs/codex-mcp/src/connector_auth_elicitation.rs
new file mode 100644
index 0000000..1e57939
--- /dev/null
+++ b/codex-rs/codex-mcp/src/connector_auth_elicitation.rs
@@ -0,0 +1,166 @@
+//! Core owns connector completion; a peer notification can never complete it.
+use super::*;
+
+pub struct ConnectorAuthElicitation {
+    router: ElicitationRequestRouter,
+    key: (String, UrlSource, String),
+    token: String,
+    response: Option<oneshot::Receiver<ElicitationResponse>>,
+    retirement: Option<oneshot::Receiver<bool>>,
+    event: Option<EventMsg>,
+}
+
+impl ConnectorAuthElicitation {
+    pub fn take_event(&mut self) -> Option<EventMsg> {
+        self.event.take()
+    }
+    pub fn take_response(&mut self) -> Option<oneshot::Receiver<ElicitationResponse>> {
+        self.response.take()
+    }
+    pub fn take_retirement(&mut self) -> Option<oneshot::Receiver<bool>> {
+        self.retirement.take()
+    }
+    pub fn is_live(&self) -> bool {
+        self.router.urls.lock().ok().is_some_and(|urls| {
+            urls.get(&self.key)
+                .is_some_and(|p| !p.retired && p.owner.as_ref().is_none_or(|owner| owner.is_live()))
+        })
+    }
+    /// Call only after the captured backend flow has supplied authoritative proof.
+    pub fn complete(&self) -> bool {
+        let UrlSource::ConnectorAuth { transport, .. } = self.key.1 else {
+            return false;
+        };
+        if !self.router.connection_live(&self.key.0, transport) {
+            return false;
+        }
+        let Ok(mut urls) = self.router.urls.lock() else {
+            return false;
+        };
+        let Some(pending) = urls.get_mut(&self.key) else {
+            return false;
+        };
+        if pending.retired
+            || !pending.accepted
+            || pending.owner.as_ref().is_some_and(|owner| !owner.is_live())
+        {
+            return false;
+        }
+        pending.retired = true;
+        pending.emit(&self.key.0, true);
+        true
+    }
+}
+
+impl Drop for ConnectorAuthElicitation {
+    fn drop(&mut self) {
+        if let Ok(mut urls) = self.router.urls.lock() {
+            if let Some(mut pending) = urls.remove(&self.key) {
+                if !pending.retired {
+                    pending.emit(&self.key.0, false);
+                }
+            }
+        }
+        if let Ok(mut requests) = self.router.requests.lock() {
+            requests.remove(&(
+                self.key.0.clone(),
+                RequestId::String(self.token.clone().into()),
+            ));
+        }
+    }
+}
+
+impl ElicitationRequestRouter {
+    pub(crate) fn register_connector_auth(
+        &self,
+        events: Sender<Event>,
+        turn_id: String,
+        mut request: ElicitationRequest,
+        transport: u64,
+    ) -> Result<ConnectorAuthElicitation> {
+        if self.auto_deny() {
+            return Err(anyhow!("Connector authentication requires interaction"));
+        }
+        let owner = self.capture_url_owner()?;
+        if owner
+            .as_ref()
+            .is_some_and(|owner| owner.turn_id != turn_id || !owner.is_live())
+        {
+            return Err(anyhow!("Connector admission expired"));
+        }
+        let unique = NEXT_ELICITATION_REQUEST_ID.fetch_add(1, Ordering::Relaxed);
+        let token = format!("codex-mcp-connector-auth-{unique}");
+        let ElicitationRequest::Url { elicitation_id, .. } = &mut request else {
+            return Err(anyhow!("Connector authentication requires a URL request"));
+        };
+        *elicitation_id = token.clone();
+        let server = crate::CODEX_APPS_MCP_SERVER_NAME.to_owned();
+        let key = (
+            server.clone(),
+            UrlSource::ConnectorAuth {
+                request: unique,
+                transport,
+            },
+            token.clone(),
+        );
+        let (response_tx, response_rx) = oneshot::channel();
+        let (retirement_tx, retirement_rx) = oneshot::channel();
+        {
+            let mut urls = self
+                .urls
+                .lock()
+                .map_err(|_| anyhow!("URL state unavailable"))?;
+            if !self.connection_live(&server, transport) {
+                return Err(anyhow!("Connector transport expired"));
+            }
+            let mut requests = self
+                .requests
+                .lock()
+                .map_err(|_| anyhow!("Interaction state unavailable"))?;
+            urls.insert(
+                key.clone(),
+                UrlPending {
+                    token: token.clone(),
+                    events,
+                    accepted: false,
+                    observed_complete: false,
+                    ingress: None,
+                    retired: false,
+                    completion: Some(retirement_tx),
+                    batch: None,
+                    owner: owner.clone(),
+                    receipt: tokio::sync::watch::channel(None).0,
+                },
+            );
+            requests.insert(
+                (server.clone(), RequestId::String(token.clone().into())),
+                PendingResponse {
+                    sender: response_tx,
+                    owner: owner.clone(),
+                },
+            );
+        }
+        if let Some(owner) = &owner {
+            if let Some(receipt) = self.owned_url_receipt(
+                &server,
+                &RequestId::String(token.clone().into()),
+                &owner.turn_id,
+            ) {
+                self.watch_url_owner(server.clone(), token.clone(), Some(owner.clone()), receipt);
+            }
+        }
+        Ok(ConnectorAuthElicitation {
+            router: self.clone(),
+            key,
+            token: token.clone(),
+            response: Some(response_rx),
+            retirement: Some(retirement_rx),
+            event: Some(EventMsg::ElicitationRequest(ElicitationRequestEvent {
+                turn_id: Some(turn_id),
+                server_name: server,
+                id: ProtocolRequestId::String(token),
+                request,
+            })),
+        })
+    }
+}
