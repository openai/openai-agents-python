+fn batch_authority() -> ElicitationAuthority {
+    ElicitationAuthority {
+        config: crate::mcp::tests::test_elicitation_config(
+            "one",
+            AskForApproval::OnRequest,
+            codex_protocol::models::PermissionProfile::Disabled,
+        ),
+        reviewer: None,
+        lifecycle: None,
+    }
+}
+
+fn url(id: &str) -> rmcp::model::ElicitRequestParams {
+    serde_json::from_value(serde_json::json!({"mode":"url", "url":"https://example.invalid/never-open", "elicitationId":id, "message":"Synthetic URL"})).unwrap()
+}
+
+fn event_token(event: Event) -> String {
+    let EventMsg::ElicitationRequest(request) = event.msg else {
+        panic!("Expected request");
+    };
+    let ProtocolRequestId::String(token) = request.id else {
+        panic!("Expected opaque token");
+    };
+    token
+}
