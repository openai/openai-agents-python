+#[derive(Debug)]
+pub(crate) struct RoutedSpanProcessor<P> {
+    pub(crate) inner: P,
+    pub(crate) default_enabled: bool,
+}
+impl<P: RouteSink> SpanProcessor for RoutedSpanProcessor<P> {
+    fn on_start(&self, span: &mut Span, cx: &Context) {
+        if crate::sdk_trace::policy_for_context(cx).is_some_and(|p| p.disabled) {
+            return;
+        }
+        self.inner.on_start(span, cx);
+        let mut s = lock();
+        if !s.processors.is_empty() {
+            if let Some(data) = span.exported_data() {
+                event(&mut s, &data, "start");
+            }
+        }
+    }
+    fn on_end(&self, span: SpanData) {
+        let policy = crate::sdk_trace::policy_for_span(&span.span_context);
+        if policy.as_ref().is_some_and(|p| p.disabled) {
+            return;
+        }
+        let mut s = lock();
+        event(&mut s, &span, "end");
+        if s.replaced || !self.default_enabled {
+            return;
+        }
+        let sequence = s.sequence;
+        if !self
+            .inner
+            .enqueue(span, policy.and_then(|p| p.credential.clone()), sequence)
+        {
+            dropped(&mut s, sequence);
+        }
+    }
+
+    fn force_flush(&self) -> OTelSdkResult {
+        self.inner.force_flush()
+    }
+    fn shutdown_with_timeout(&self, timeout: Duration) -> OTelSdkResult {
+        self.inner.shutdown_with_timeout(timeout)
+    }
+    fn set_resource(&mut self, resource: &opentelemetry_sdk::Resource) {
+        self.inner.set_resource(resource);
+    }
+}
