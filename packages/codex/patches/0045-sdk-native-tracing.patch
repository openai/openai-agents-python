+    #[test]
+    fn tap_preserves_all_user_metadata_and_prefixed_key_boundaries() {
+        let mut data = sample_span();
+        data.attributes = vec![
+            opentelemetry::KeyValue::new("sdk.span.kind", "workflow"),
+            opentelemetry::KeyValue::new("sdk.group_id", "group"),
+        ];
+        for index in 0..62 {
+            data.attributes.push(opentelemetry::KeyValue::new(
+                format!("sdk.metadata.key_{index}"),
+                "value",
+            ));
+        }
+        let first = format!("sdk.metadata.{}a", "x".repeat(255));
+        let second = format!("sdk.metadata.{}b", "x".repeat(255));
+        data.attributes
+            .push(opentelemetry::KeyValue::new(first.clone(), "first"));
+        data.attributes
+            .push(opentelemetry::KeyValue::new(second.clone(), "second"));
+        data.dropped_attributes_count = 3;
+        let mut routes = Routes {
+            processors: vec!["recording".into()],
+            ..Default::default()
+        };
+        event(&mut routes, &data, "end");
+        let snapshot = &routes.queue.front().unwrap().1;
+        let attributes = snapshot["attributes"].as_object().unwrap();
+        assert_eq!(attributes.len(), 66);
+        assert_eq!(attributes[&first], "first");
+        assert_eq!(attributes[&second], "second");
+        assert_eq!(snapshot["dropped_attributes_count"], 3);
