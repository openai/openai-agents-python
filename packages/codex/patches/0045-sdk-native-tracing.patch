+//! Bounded SDK lifecycle delivery and private exporter credentials.
+use opentelemetry::Context;
+use opentelemetry::trace::Span as _;
+use opentelemetry_sdk::error::OTelSdkResult;
+use opentelemetry_sdk::trace::{Span, SpanData, SpanProcessor};
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::{Value, json};
+use std::collections::{BTreeMap, BTreeSet, HashMap, VecDeque};
+use std::sync::{Arc, Mutex, OnceLock};
+use std::time::{Duration, Instant, UNIX_EPOCH};
+
+const MAX_EVENTS: usize = 2048;
+const MAX_BYTES: usize = 4 * 1024 * 1024;
+
+pub struct TraceCredentials {
+    headers: HashMap<String, String>,
+}
+impl std::fmt::Debug for TraceCredentials {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("TraceCredentials([redacted])")
+    }
+}
+impl TraceCredentials {
+    pub(crate) fn overlay(&self, defaults: &HashMap<String, String>) -> HashMap<String, String> {
+        let mut headers: HashMap<_, _> = defaults
+            .iter()
+            .map(|(k, v)| (k.to_ascii_lowercase(), v.clone()))
+            .collect();
+        headers.extend(self.headers.clone());
+        headers
+    }
+}
+#[derive(Default)]
+struct Routes {
+    processors: Vec<String>,
+    replaced: bool,
+    default_available: bool,
+    sequence: u64,
+    acknowledged: u64,
+    delivered: u64,
+    queue: VecDeque<(u64, Value, usize)>,
+    pending: BTreeSet<u64>,
+    bytes: usize,
+    dropped: u64,
+    failed: u64,
+    flush_snapshot: Option<(u64, u64, u64)>,
+    batch: Option<std::sync::Weak<BatchShared>>,
+    credentials: HashMap<String, Arc<TraceCredentials>>,
+    next_credential: u64,
+}
+fn state() -> &'static Mutex<Routes> {
+    static STATE: OnceLock<Mutex<Routes>> = OnceLock::new();
+    STATE.get_or_init(Default::default)
+}
+fn lock() -> std::sync::MutexGuard<'static, Routes> {
+    state().lock().unwrap_or_else(|e| e.into_inner())
+}
+
+pub fn register_trace_credentials(input: &str) -> Result<String, String> {
+    if input.len() > 65536 {
+        return Err("trace credential headers exceed limit".into());
+    }
+    let raw: HashMap<String, String> =
+        serde_json::from_str(input).map_err(|_| "invalid trace credential headers")?;
+    if raw.len() > 64 {
+        return Err("too many trace credential headers".into());
+    }
+    let mut headers = HashMap::new();
+    for (key, value) in raw {
+        let name = http::header::HeaderName::from_bytes(key.as_bytes())
+            .map_err(|_| "invalid trace credential header name")?;
+        let lower = name.as_str().to_owned();
+        if !lower.bytes().all(|b| {
+            b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-' || b == b'_' || b == b'.'
+        }) || lower.ends_with("-bin")
+            || value.bytes().any(|c| !(32..=126).contains(&c))
+            || http::header::HeaderValue::from_str(&value).is_err()
+        {
+            return Err("invalid trace credential header value".into());
+        }
+        if headers.insert(lower, value).is_some() {
+            return Err("duplicate trace credential header".into());
+        }
+    }
+    let mut s = lock();
+    if s.credentials.len() >= 1024 {
+        return Err("trace credential registry is full".into());
+    }
+    s.next_credential += 1;
+    let key = format!("credential_{}", s.next_credential);
+    s.credentials
+        .insert(key.clone(), Arc::new(TraceCredentials { headers }));
+    Ok(key)
+}
+pub(crate) fn configure_default(available: bool) {
+    lock().default_available = available;
+}
+pub fn credential(reference: &str) -> Result<Arc<TraceCredentials>, String> {
+    let s = lock();
+    if !s.default_available || s.replaced {
+        return Err(
+            "trace credential overrides require an active built-in OTLP trace route".into(),
+        );
+    }
+    s.credentials
+        .get(reference)
+        .cloned()
+        .ok_or_else(|| "unknown trace credential reference".into())
+}
+
+pub fn release_trace_credentials(reference: &str) -> Result<(), String> {
+    lock().credentials.remove(reference);
+    Ok(())
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RouteOptions {
+    processor_ids: Vec<String>,
+    #[serde(default)]
+    replace: bool,
+}
+pub fn set_trace_routes(input: &str) -> Result<u64, String> {
+    if input.len() > 16384 {
+        return Err("trace route configuration exceeds limit".into());
+    }
+    let options: RouteOptions =
+        serde_json::from_str(input).map_err(|_| "invalid trace route configuration")?;
+    if options.processor_ids.len() > 64
+        || options
+            .processor_ids
+            .iter()
+            .any(|id| id.is_empty() || id.len() > 256)
+    {
+        return Err("invalid trace processor IDs".into());
+    }
+    let mut s = lock();
+    let mut ids = if options.replace {
+        Vec::new()
+    } else {
+        s.processors.clone()
+    };
+    for id in options.processor_ids {
+        if !ids.contains(&id) {
+            ids.push(id);
+        }
+    }
+    if ids.len() > 64 {
+        return Err("too many trace processors".into());
+    }
+    s.processors = ids;
+    s.replaced |= options.replace;
+    Ok(s.sequence)
+}
+fn event(s: &mut Routes, span: &SpanData, lifecycle: &str) {
+    s.sequence += 1;
+    let sequence = s.sequence;
+    if s.processors.is_empty() {
+        return;
+    }
+    // Native fields are copied into an immutable, bounded JSON snapshot. Never copy policy.
+    let mut attrs = BTreeMap::new();
+    // User metadata has 64 fields; reserve the native SDK's full 128-attribute
+    // capacity for SDK kind/group fields and configured span attributes too.
+    // The private metadata namespace prefix does not consume the user's key limit.
+    for kv in span.attributes.iter().take(128) {
+        let key = truncate(kv.key.as_str(), 256 + "sdk.metadata.".len());
+        let val = match &kv.value {
+            opentelemetry::Value::Bool(v) => json!(v),
+            opentelemetry::Value::I64(v) => json!(v),
+            opentelemetry::Value::F64(v) => json!(v),
+            other => json!(truncate(&other.to_string(), 4096)),
+        };
+        attrs.insert(key, val);
+    }
+    let value = json!({"sequence":sequence,"processor_ids":s.processors,"lifecycle":lifecycle,"trace_id":span.span_context.trace_id().to_string(),"span_id":span.span_context.span_id().to_string(),"parent_span_id":if span.parent_span_id==opentelemetry::trace::SpanId::INVALID {None}else{Some(span.parent_span_id.to_string())},"name":truncate(&span.name,4096),"kind":format!("{:?}",span.span_kind).to_ascii_lowercase(),"start_time_unix_nanos":span.start_time.duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos().to_string(),"end_time_unix_nanos":if lifecycle=="end" {Some(span.end_time.duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos().to_string())}else{None},"attributes":attrs,"dropped_attributes_count":span.dropped_attributes_count,"outcome":match span.status { opentelemetry::trace::Status::Error{..}=>"error",opentelemetry::trace::Status::Ok=>"ok",_=>"unset" }});
+    let bytes = serde_json::to_vec(&value).map_or(MAX_BYTES + 1, |v| v.len());
+    if bytes > 65536 || s.pending.len() >= MAX_EVENTS || s.bytes + bytes > MAX_BYTES {
+        dropped(s, sequence);
+        return;
+    }
+    s.bytes += bytes;
+    s.pending.insert(sequence);
+    s.queue.push_back((sequence, value, bytes));
+}
+fn truncate(s: &str, max: usize) -> String {
+    let mut end = s.len().min(max);
+    while !s.is_char_boundary(end) {
+        end -= 1;
+    }
+    s[..end].to_owned()
+}
+pub fn drain_trace_events(max_count: usize) -> Result<String, String> {
+    let mut s = lock();
+    let mut events = Vec::new();
+    let cutoff = s
+        .flush_snapshot
+        .map(|(barrier, _, _)| barrier)
+        .filter(|barrier| s.pending.range(..=*barrier).next().is_some());
+    for _ in 0..max_count.min(512) {
+        if s.queue
+            .front()
+            .is_some_and(|(seq, _, _)| cutoff.is_some_and(|cutoff| *seq > cutoff))
+        {
+            break;
+        }
+        let Some((seq, value, bytes)) = s.queue.pop_front() else {
+            break;
+        };
+        s.bytes -= bytes;
+        s.delivered = seq;
+        events.push(value);
+    }
+    let through = cutoff.unwrap_or(s.sequence);
+    if s.queue.front().is_none_or(|(seq, _, _)| *seq > through) {
+        s.delivered = s.delivered.max(through);
+    }
+    serde_json::to_string(&json!({"events":events,"dropped_records":s.dropped,"failed_deliveries":s.failed,"through_sequence":s.delivered})).map_err(|_| "trace event serialization failed".into())
+}
+pub fn ack_trace_events(sequence: u64, failed: u64) -> Result<(), String> {
+    let mut s = lock();
+    if sequence > s.delivered || sequence < s.acknowledged {
+        return Err("invalid trace event acknowledgment".into());
+    }
+    if sequence > s.acknowledged {
+        s.failed = s.failed.saturating_add(failed);
+        if let Some((barrier, _, captured_failed)) = &mut s.flush_snapshot {
+            if sequence <= *barrier {
+                *captured_failed = captured_failed.saturating_add(failed);
+            }
+        }
+        s.acknowledged = sequence;
+        s.pending.retain(|pending| *pending > sequence);
+    }
+    Ok(())
+}
+pub(crate) fn current_barrier() -> u64 {
+    lock().sequence
+}
+pub(crate) fn capture_barrier() -> u64 {
+    let mut s = lock();
+    let barrier = s.sequence;
+    s.flush_snapshot = Some((barrier, s.dropped, s.failed));
+    if let Some(batch) = s.batch.as_ref().and_then(std::sync::Weak::upgrade) {
+        let mut state = batch.state.lock().unwrap_or_else(|e| e.into_inner());
+        let target = state.admitted;
+        state.captured_flush_target = Some(target);
+        state.flush = state.flush.max(target);
+        batch.changed.notify_all();
+    }
+    barrier
+}
+pub(crate) async fn wait_for_barrier(barrier: u64, deadline: Instant) -> bool {
+    loop {
+        {
+            let s = lock();
+            if s.pending.range(..=barrier).next().is_none() {
+                return true;
+            }
+        }
+        if Instant::now() >= deadline {
+            return false;
+        }
+        tokio::time::sleep(Duration::from_millis(2)).await;
+    }
+}
+#[derive(Debug, Serialize)]
+pub struct FlushResult {
+    pub status: &'static str,
+    pub dropped_records: u64,
+    pub failed_deliveries: u64,
+    pub barrier: u64,
+}
+pub(crate) fn result(barrier: u64, status: &'static str) -> FlushResult {
+    let s = lock();
+    let (dropped_records, failed_deliveries) = s
+        .flush_snapshot
+        .filter(|(b, _, _)| *b == barrier)
+        .map(|(_, d, f)| (d, f))
+        .unwrap_or((s.dropped, s.failed));
+    FlushResult {
+        status: if status == "success" && (dropped_records > 0 || failed_deliveries > 0) {
+            "partial"
+        } else {
+            status
+        },
+        dropped_records,
+        failed_deliveries,
+        barrier,
+    }
+}
+fn dropped(s: &mut Routes, sequence: u64) {
+    s.dropped += 1;
+    if let Some((barrier, captured_dropped, _)) = &mut s.flush_snapshot {
+        if sequence <= *barrier {
+            *captured_dropped += 1;
+        }
+    }
+}
+fn export_failures(sequences: &[u64]) {
+    let mut s = lock();
+    s.failed += sequences.len() as u64;
+    if let Some((barrier, _, captured_failed)) = &mut s.flush_snapshot {
+        *captured_failed += sequences.iter().filter(|seq| **seq <= *barrier).count() as u64;
+    }
+}
+
+/// Seal the current owned queue before waiting for the provider or flush owner.
+/// Later terminal calls may shorten the deadline, but cannot extend it.
+pub(crate) struct BatchShutdown(std::sync::Weak<BatchShared>);
+impl BatchShutdown {
+    pub(crate) fn begin(&self, deadline: Instant) {
+        if let Some(batch) = self.0.upgrade() {
+            batch.begin_shutdown(deadline);
+        }
+    }
+}
+pub(crate) fn shutdown_owner() -> Option<BatchShutdown> {
+    lock().batch.clone().map(BatchShutdown)
+}
+pub fn begin_shutdown(deadline: Instant) {
+    let batch = {
+        let mut routes = lock();
+        routes.default_available = false;
+        routes.batch.as_ref().and_then(std::sync::Weak::upgrade)
+    };
+    if let Some(batch) = batch {
+        batch.begin_shutdown(deadline);
+    }
+}
+fn discard_envelopes(envelopes: Vec<TraceEnvelope>) {
+    let sequences: Vec<_> = envelopes
+        .iter()
+        .map(|envelope| envelope.record_sequence)
+        .collect();
+    drop(envelopes);
+    let mut routes = lock();
+    for sequence in sequences {
+        dropped(&mut routes, sequence);
+    }
+}
+async fn terminal_deadline(mut changed: tokio::sync::watch::Receiver<Option<Instant>>) {
+    loop {
+        let deadline = *changed.borrow_and_update();
+        match deadline {
+            Some(deadline) => {
+                if deadline <= Instant::now() {
+                    return;
+                }
+                tokio::select! {
+                    biased;
+                    _ = tokio::time::sleep_until(deadline.into()) => return,
+                    update = changed.changed() => { if update.is_err() { std::future::pending::<()>().await; } }
+                }
+            }
+            None => {
+                if changed.changed().await.is_err() {
+                    std::future::pending::<()>().await;
+                }
+            }
+        }
+    }
+}
+
+/// A span and its private credential share exactly one bounded queue lifetime.
+pub(crate) struct TraceEnvelope {
+    pub(crate) span: SpanData,
+    pub(crate) credential: Option<Arc<TraceCredentials>>,
+    sequence: u64,
+    pub(crate) record_sequence: u64,
+}
+/// A partition removes its records only after delivery succeeds. Cancellation
+/// therefore counts remaining records without reclassifying delivered partitions.
+pub(crate) struct BatchReceipt {
+    pending: Mutex<BTreeSet<u64>>,
+    terminal: tokio::sync::watch::Receiver<Option<Instant>>,
+}
+impl BatchReceipt {
+    fn new(sequences: &[u64], terminal: tokio::sync::watch::Receiver<Option<Instant>>) -> Self {
+        Self {
+            pending: Mutex::new(sequences.iter().copied().collect()),
+            terminal,
+        }
+    }
+    pub(crate) fn terminal_expired(&self) -> bool {
+        self.terminal
+            .borrow()
+            .is_some_and(|deadline| deadline <= Instant::now())
+    }
+    pub(crate) fn succeeded(&self, sequences: &[u64]) {
+        let mut pending = self.pending.lock().unwrap_or_else(|e| e.into_inner());
+        for sequence in sequences {
+            pending.remove(sequence);
+        }
+    }
+    fn remaining(&self) -> Vec<u64> {
+        self.pending
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .iter()
+            .copied()
+            .collect()
+    }
+}
+pub(crate) trait EnvelopeExporter: Send + 'static {
+    fn export(
+        &self,
+        batch: Vec<TraceEnvelope>,
+        receipt: &BatchReceipt,
+    ) -> impl std::future::Future<Output = Result<Vec<u64>, ()>> + Send;
+    fn shutdown(&mut self) -> OTelSdkResult {
+        Ok(())
+    }
+}
+pub(crate) trait RouteSink: SpanProcessor {
+    fn enqueue(
+        &self,
+        span: SpanData,
+        credential: Option<Arc<TraceCredentials>>,
+        record_sequence: u64,
+    ) -> bool;
+}
+#[derive(Clone, Debug)]
+pub(crate) struct BatchSettings {
+    queue: usize,
+    batch: usize,
+    delay: Duration,
+    timeout: Duration,
+    concurrency: usize,
+}
+impl BatchSettings {
+    pub(crate) fn from_env(concurrent: bool) -> Result<Self, String> {
+        fn number(name: &str, default: usize) -> usize {
+            std::env::var(name)
+                .ok()
+                .and_then(|v| v.parse().ok())
+                .unwrap_or(default)
+        }
+        let queue = number("OTEL_BSP_MAX_QUEUE_SIZE", 2048);
+        let batch = number("OTEL_BSP_MAX_EXPORT_BATCH_SIZE", 512).min(queue);
+        let concurrency = if concurrent {
+            number("OTEL_BSP_MAX_CONCURRENT_EXPORTS", 1)
+        } else {
+            1
+        };
+        if queue == 0 || batch == 0 || concurrency == 0 {
+            return Err("trace batch queue, batch and concurrency sizes must be positive".into());
+        }
+        Ok(Self {
+            concurrency,
+            queue,
+            batch,
+            delay: Duration::from_millis(number("OTEL_BSP_SCHEDULE_DELAY", 5000) as u64),
+            timeout: Duration::from_millis(number("OTEL_BSP_EXPORT_TIMEOUT", 30000) as u64),
+        })
+    }
+}
+#[derive(Default)]
+struct BatchState {
+    queue: VecDeque<TraceEnvelope>,
+    admitted: u64,
+    completed: u64,
+    flush: u64,
+    shutdown: bool,
+    stopped: bool,
+    workers: usize,
+    completed_ranges: BTreeMap<u64, u64>,
+    captured_flush_target: Option<u64>,
+}
+struct BatchShared {
+    state: Mutex<BatchState>,
+    changed: std::sync::Condvar,
+    settings: BatchSettings,
+    terminal: tokio::sync::watch::Sender<Option<Instant>>,
+}
+impl BatchShared {
+    fn begin_shutdown(&self, deadline: Instant) {
+        self.terminal.send_if_modified(|current| {
+            if current.is_none_or(|old| deadline < old) {
+                *current = Some(deadline);
+                true
+            } else {
+                false
+            }
+        });
+        let expired = self
+            .terminal
+            .borrow()
+            .is_some_and(|deadline| deadline <= Instant::now());
+        let discarded = {
+            let mut state = self.state.lock().unwrap_or_else(|error| error.into_inner());
+            state.shutdown = true;
+            let discarded = if expired {
+                state.queue.drain(..).collect()
+            } else {
+                Vec::new()
+            };
+            self.changed.notify_all();
+            discarded
+        };
+        // Producers lock routing before queue admission. Never invert that order.
+        discard_envelopes(discarded);
+    }
+}
+impl std::fmt::Debug for BatchShared {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("TraceBatchState([private])")
+    }
+}
+#[derive(Debug)]
+pub(crate) struct TraceBatchProcessor {
+    shared: Arc<BatchShared>,
+}
+impl TraceBatchProcessor {
+    pub(crate) fn new<F, E>(settings: BatchSettings, build: F) -> Result<Self, String>
+    where
+        F: Fn() -> Result<E, String> + Send + Sync + 'static,
+        E: EnvelopeExporter,
+    {
+        let (terminal, _) = tokio::sync::watch::channel(None);
+        let shared = Arc::new(BatchShared {
+            terminal,
+            state: Mutex::new(BatchState {
+                workers: settings.concurrency,
+                ..Default::default()
+            }),
+            changed: std::sync::Condvar::new(),
+            settings,
+        });
+        let build = Arc::new(build);
+        let (ready_tx, ready_rx) = std::sync::mpsc::sync_channel(1);
+        for _ in 0..shared.settings.concurrency {
+            let worker = shared.clone();
+            let build = build.clone();
+            let ready_tx = ready_tx.clone();
+            std::thread::Builder::new()
+                .name("codex-sdk-trace-export".into())
+                .spawn(move || {
+                    let _suppression = Context::enter_telemetry_suppressed_scope();
+                    let runtime = match tokio::runtime::Builder::new_current_thread()
+                        .enable_all()
+                        .build()
+                    {
+                        Ok(runtime) => runtime,
+                        Err(_) => {
+                            let _ = ready_tx
+                                .send(Err("trace worker runtime initialization failed".to_owned()));
+                            return;
+                        }
+                    };
+                    let exporter = {
+                        let _entered = runtime.enter();
+                        build()
+                    };
+                    let mut exporter = match exporter {
+                        Ok(exporter) => exporter,
+                        Err(error) => {
+                            let _ = ready_tx.send(Err(error));
+                            return;
+                        }
+                    };
+                    let _ = ready_tx.send(Ok(()));
+                    drop(ready_tx);
+                    let mut next = Instant::now() + worker.settings.delay;
+                    loop {
+                        let (batch, shutdown) = {
+                            let mut state = worker.state.lock().unwrap_or_else(|e| e.into_inner());
+                            while !state.shutdown
+                                && (state.queue.is_empty()
+                                    || (state.flush > state.completed
+                                        && state
+                                            .queue
+                                            .front()
+                                            .is_some_and(|e| e.sequence > state.flush))
+                                    || (state.flush <= state.completed
+                                        && state.queue.len() < worker.settings.batch
+                                        && Instant::now() < next))
+                            {
+                                if state.flush > state.completed
+                                    && state
+                                        .queue
+                                        .front()
+                                        .is_some_and(|e| e.sequence > state.flush)
+                                {
+                                    state = worker
+                                        .changed
+                                        .wait(state)
+                                        .unwrap_or_else(|e| e.into_inner());
+                                    continue;
+                                }
+                                if state.queue.is_empty() {
+                                    state = worker
+                                        .changed
+                                        .wait(state)
+                                        .unwrap_or_else(|e| e.into_inner());
+                                    continue;
+                                }
+                                let wait = next.saturating_duration_since(Instant::now());
+                                state = worker
+                                    .changed
+                                    .wait_timeout(state, wait)
+                                    .unwrap_or_else(|e| e.into_inner())
+                                    .0;
+                            }
+                            if worker.terminal.borrow().is_some_and(|deadline| deadline <= Instant::now()) {
+                                let discarded = state.queue.drain(..).collect();
+                                drop(state);
+                                discard_envelopes(discarded);
+                                break;
+                            }
+                            if state.shutdown && state.queue.is_empty() { break; }
+                            let mut count = state.queue.len().min(worker.settings.batch);
+                            if !state.shutdown && state.flush > state.completed {
+                                count = state
+                                    .queue
+                                    .iter()
+                                    .take(count)
+                                    .take_while(|e| e.sequence <= state.flush)
+                                    .count();
+                            }
+                            let batch: Vec<_> = state.queue.drain(..count).collect();
+                            (batch, state.shutdown)
+                        };
+                        if batch.is_empty() {
+                            next = Instant::now() + worker.settings.delay;
+                            continue;
+                        }
+                        let first = batch.first().map(|e| e.sequence).unwrap_or_default();
+                        let last = batch.last().map(|e| e.sequence).unwrap_or_default();
+                        let records: Vec<_> = batch.iter().map(|e| e.record_sequence).collect();
+                        let receipt = BatchReceipt::new(&records, worker.terminal.subscribe());
+                        let outcome =
+                            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                                runtime.block_on(async {
+                                    tokio::select! {
+                                        biased;
+                                        _ = terminal_deadline(worker.terminal.subscribe()) => Err(()),
+                                        result = tokio::time::timeout(worker.settings.timeout, exporter.export(batch, &receipt)) => result.map_err(|_| ()),
+                                    }
+                                })
+                            }));
+                        match outcome {
+                            Ok(Ok(Ok(failed))) => export_failures(&failed),
+                            _ => export_failures(&receipt.remaining()),
+                        }
+                        let mut state = worker.state.lock().unwrap_or_else(|e| e.into_inner());
+                        let (mut first, mut last) = (first, last);
+                        if let Some((&start, &end)) =
+                            state.completed_ranges.range(..first).next_back()
+                        {
+                            if end.saturating_add(1) == first {
+                                first = start;
+                                state.completed_ranges.remove(&start);
+                            }
+                        }
+                        if let Some((&start, &end)) = state.completed_ranges.range(first..).next() {
+                            if last.saturating_add(1) == start {
+                                last = end;
+                                state.completed_ranges.remove(&start);
+                            }
+                        }
+                        state.completed_ranges.insert(first, last);
+                        loop {
+                            let next = state.completed + 1;
+                            let Some(last) = state.completed_ranges.remove(&next) else {
+                                break;
+                            };
+                            state.completed = last;
+                        }
+                        worker.changed.notify_all();
+                        if shutdown
+                            || state.flush > state.completed
+                            || state.queue.len() >= worker.settings.batch
+                        {
+                            next = Instant::now();
+                        } else {
+                            next = Instant::now() + worker.settings.delay;
+                        }
+                    }
+                    let _ = exporter.shutdown();
+                    let mut state = worker.state.lock().unwrap_or_else(|e| e.into_inner());
+                    state.workers -= 1;
+                    state.stopped = state.workers == 0;
+                    worker.changed.notify_all();
+                })
+                .map_err(|_| {
+                    let mut state = shared.state.lock().unwrap_or_else(|e| e.into_inner());
+                    state.shutdown = true;
+                    shared.changed.notify_all();
+                    "trace export worker initialization failed".to_owned()
+                })?;
+        }
+        drop(ready_tx);
+        for _ in 0..shared.settings.concurrency {
+            let result = ready_rx
+                .recv()
+                .map_err(|_| "trace export worker stopped during initialization".to_owned())?;
+            if let Err(error) = result {
+                let mut state = shared.state.lock().unwrap_or_else(|e| e.into_inner());
+                state.shutdown = true;
+                shared.changed.notify_all();
+                return Err(error);
+            }
+        }
+        lock().batch = Some(Arc::downgrade(&shared));
+        Ok(Self { shared })
+    }
+    fn wait(&self, timeout: Duration, shutdown: bool) -> OTelSdkResult {
+        let deadline = Instant::now() + timeout;
+        if shutdown {
+            self.shared.begin_shutdown(deadline);
+        }
+        let mut state = self.shared.state.lock().unwrap_or_else(|e| e.into_inner());
+        let target = if shutdown {
+            state.admitted
+        } else {
+            state.captured_flush_target.take().unwrap_or(state.admitted)
+        };
+        state.flush = state.flush.max(target);
+        state.shutdown |= shutdown;
+        self.shared.changed.notify_all();
+        while !state.stopped && (state.completed < target || shutdown) {
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                return Err(opentelemetry_sdk::error::OTelSdkError::InternalFailure(
+                    "trace batch flush exceeded time budget".into(),
+                ));
+            }
+            state = self
+                .shared
+                .changed
+                .wait_timeout(state, remaining)
+                .unwrap_or_else(|e| e.into_inner())
+                .0;
+        }
+        if !shutdown && state.completed < target {
+            return Err(opentelemetry_sdk::error::OTelSdkError::InternalFailure(
+                "trace export stopped during flush".into(),
+            ));
+        }
+        Ok(())
+    }
+}
+impl RouteSink for TraceBatchProcessor {
+    fn enqueue(
+        &self,
+        span: SpanData,
+        credential: Option<Arc<TraceCredentials>>,
+        record_sequence: u64,
+    ) -> bool {
+        let mut state = self.shared.state.lock().unwrap_or_else(|e| e.into_inner());
+        if state.shutdown || state.queue.len() >= self.shared.settings.queue {
+            return false;
+        }
+        state.admitted += 1;
+        let sequence = state.admitted;
+        state.queue.push_back(TraceEnvelope {
+            span,
+            credential,
+            sequence,
+            record_sequence,
+        });
+        if state.queue.len() == 1 || state.queue.len() >= self.shared.settings.batch {
+            self.shared.changed.notify_one();
+        }
+        true
+    }
+}
+impl SpanProcessor for TraceBatchProcessor {
+    fn on_start(&self, _: &mut Span, _: &Context) {}
+    fn on_end(&self, span: SpanData) {
+        let sequence = current_barrier();
+        if !self.enqueue(span, None, sequence) {
+            dropped(&mut lock(), sequence);
+        }
+    }
+    fn force_flush(&self) -> OTelSdkResult {
+        self.wait(Duration::from_secs(30), false)
+    }
+    fn shutdown_with_timeout(&self, timeout: Duration) -> OTelSdkResult {
+        self.wait(timeout, true)
+    }
+}
