+/// Private SDK context stored on an existing native turn owner. Questions and
+/// admission receipts share the lease; reading events never captures ambient state.
+pub struct CapturedContext {
+    pub context: Option<Arc<ContextLease>>,
+}
+impl CapturedContext {
+    pub fn capture() -> Self {
+        Self {
+            context: ContextLease::capture().map(Arc::new),
+        }
+    }
+}
+
+/// A borrowed callback carrier remains valid only while this native lease lives.
+pub struct ContextLease {
+    token: String,
+}
+impl ContextLease {
+    pub fn capture() -> Option<Self> {
+        current_context_token().map(|token| Self { token })
+    }
+    pub fn token(&self) -> &str {
+        &self.token
+    }
+}
+impl Drop for ContextLease {
+    fn drop(&mut self) {
+        release_trace_context(&self.token);
+    }
+}
+pub fn trace_carrier(key: &str) -> Result<codex_protocol::protocol::W3cTraceContext, String> {
+    crate::trace_context::context_w3c_trace_context(&context(key)?)
+        .ok_or_else(|| "Native tracing context is invalid".into())
+}
+
+/// Resolve SDK-private ingress into Core's existing queued W3C context carrier.
+pub fn prepare_submission(value: &mut Value) -> Result<(), String> {
+    let Some(object) = value.as_object_mut() else {
+        return Ok(());
+    };
+    if let Some(token) = object.remove("tracing_context") {
+        if token.is_null() {
+            return Ok(());
+        }
+        let token = token.as_str().ok_or("Invalid tracing context token")?;
+        object.insert(
+            "trace".into(),
+            serde_json::to_value(trace_carrier(token)?)
+                .map_err(|_| "Native tracing carrier could not serialize")?,
+        );
+    }
+    Ok(())
+}
