+    #[test]
+    fn flush_capture_cannot_overtake_routed_span_admission() {
+        use std::sync::{Condvar, mpsc};
+        let _test = TEST_LOCK.lock().unwrap();
+        *lock() = Routes::default();
+        #[derive(Debug)]
+        struct Sink {
+            started: mpsc::Sender<()>,
+            release: Arc<(Mutex<bool>, Condvar)>,
+            admitted: Arc<std::sync::atomic::AtomicBool>,
+        }
+        impl SpanProcessor for Sink {
+            fn on_start(&self, _: &mut Span, _: &Context) {}
+            fn on_end(&self, _: SpanData) {}
+            fn force_flush(&self) -> OTelSdkResult {
+                Ok(())
+            }
+            fn shutdown_with_timeout(&self, _: Duration) -> OTelSdkResult {
+                Ok(())
+            }
+        }
+        impl RouteSink for Sink {
+            fn enqueue(&self, _: SpanData, _: Option<Arc<TraceCredentials>>, _: u64) -> bool {
+                self.started.send(()).unwrap();
+                drop(
+                    self.release
+                        .1
+                        .wait_while(self.release.0.lock().unwrap(), |v| !*v)
+                        .unwrap(),
+                );
+                self.admitted
+                    .store(true, std::sync::atomic::Ordering::Release);
+                true
+            }
+        }
+        let (started_tx, started_rx) = mpsc::channel();
+        let release = Arc::new((Mutex::new(false), Condvar::new()));
+        let admitted = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let provider = SdkTracerProvider::builder()
+            .with_span_processor(RoutedSpanProcessor {
+                inner: Sink {
+                    started: started_tx,
+                    release: release.clone(),
+                    admitted: admitted.clone(),
+                },
+                default_enabled: true,
+            })
+            .build();
+        let tracer = provider.tracer("race");
+        let ending = std::thread::spawn(move || {
+            let mut span = tracer.start("admission");
+            span.end();
+        });
+        started_rx.recv_timeout(Duration::from_secs(1)).unwrap();
+        let (tx, rx) = mpsc::channel();
+        let capture = std::thread::spawn(move || {
+            tx.send(capture_barrier()).unwrap();
+        });
+        assert!(rx.recv_timeout(Duration::from_millis(20)).is_err());
+        *release.0.lock().unwrap() = true;
+        release.1.notify_one();
+        assert!(rx.recv_timeout(Duration::from_secs(1)).unwrap() > 0);
+        assert!(admitted.load(std::sync::atomic::Ordering::Acquire));
+        ending.join().unwrap();
+        capture.join().unwrap();
+        provider.shutdown().unwrap();
+    }
