+#[derive(Debug)]
+pub struct ScopePolicy {
+    pub disabled: bool,
+    pub include_sensitive_data: bool,
+    pub credential: Option<Arc<crate::sdk_trace_routes::TraceCredentials>>,
+}
+
+#[derive(Clone, Debug)]
+pub struct ScopeSampler {
+    inner: Box<dyn ShouldSample>,
+}
+impl Default for ScopeSampler {
+    fn default() -> Self {
+        Self {
+            inner: opentelemetry_sdk::trace::Config::default().sampler,
+        }
+    }
+}
+impl ShouldSample for ScopeSampler {
+    fn should_sample(
+        &self,
+        parent: Option<&Context>,
+        trace_id: TraceId,
+        name: &str,
+        kind: &SpanKind,
+        attributes: &[KeyValue],
+        links: &[opentelemetry::trace::Link],
+    ) -> SamplingResult {
+        if parent
+            .and_then(policy_for_context)
+            .is_some_and(|p| p.disabled)
+        {
+            SamplingResult {
+                decision: SamplingDecision::Drop,
+                attributes: Vec::new(),
+                trace_state: Default::default(),
+            }
+        } else {
+            self.inner
+                .should_sample(parent, trace_id, name, kind, attributes, links)
+        }
+    }
+}
+
+type Identity = (TraceId, SpanId);
+fn policies() -> &'static Mutex<HashMap<Identity, Weak<ScopePolicy>>> {
+    static POLICIES: OnceLock<Mutex<HashMap<Identity, Weak<ScopePolicy>>>> = OnceLock::new();
+    POLICIES.get_or_init(Default::default)
+}
+pub fn policy_for_span(span: &SpanContext) -> Option<Arc<ScopePolicy>> {
+    policies()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .get(&(span.trace_id(), span.span_id()))
+        .and_then(Weak::upgrade)
+}
+pub fn policy_for_context(context: &Context) -> Option<Arc<ScopePolicy>> {
+    context
+        .get::<Arc<ScopePolicy>>()
+        .cloned()
+        .or_else(|| policy_for_span(context.span().span_context()))
+}
+pub fn restore_policy(context: Context) -> Context {
+    match policy_for_context(&context) {
+        Some(policy) => context.with_value(policy),
+        None => context,
+    }
+}
+pub fn scoped_capture_allowed() -> bool {
+    policy_for_context(&Context::current())
+        .is_none_or(|policy| !policy.disabled && policy.include_sensitive_data)
+}
+pub fn scoped_trace_enabled() -> bool {
+    policy_for_context(&Context::current()).is_none_or(|policy| !policy.disabled)
+}
+
+/// Retains policy through sampled-out spans too; processor callbacks alone cannot do that.
+pub struct ScopedSpan {
+    span: Option<global::BoxedSpan>,
+    span_context: SpanContext,
+    policy: Option<Arc<ScopePolicy>>,
+}
+pub fn wrap_span(span: global::BoxedSpan, parent: &Context) -> ScopedSpan {
+    let policy = policy_for_context(parent);
+    if let Some(policy) = &policy {
+        let context = span.span_context();
+        policies().lock().unwrap_or_else(|e| e.into_inner()).insert(
+            (context.trace_id(), context.span_id()),
+            Arc::downgrade(policy),
+        );
+    }
+    let span_context = span.span_context().clone();
+    ScopedSpan {
+        span: Some(span),
+        span_context,
+        policy,
+    }
+}
+impl Drop for ScopedSpan {
+    fn drop(&mut self) {
+        if let Some(span) = self.span.as_mut() {
+            span.end();
+        }
+        if self.policy.is_some() {
+            let context = &self.span_context;
+            policies()
+                .lock()
+                .unwrap_or_else(|e| e.into_inner())
+                .remove(&(context.trace_id(), context.span_id()));
+        }
+    }
+}
+impl opentelemetry::trace::Span for ScopedSpan {
+    fn add_event_with_timestamp<T: Into<Cow<'static, str>>>(
+        &mut self,
+        name: T,
+        time: SystemTime,
+        attributes: Vec<KeyValue>,
+    ) {
+        if let Some(span) = self.span.as_mut() {
+            span.add_event_with_timestamp(name, time, attributes);
+        }
+    }
+    fn span_context(&self) -> &SpanContext {
+        &self.span_context
+    }
+    fn is_recording(&self) -> bool {
+        self.span.as_ref().is_some_and(|span| span.is_recording())
+    }
+    fn set_attribute(&mut self, value: KeyValue) {
+        if let Some(span) = self.span.as_mut() {
+            span.set_attribute(value);
+        }
+    }
+    fn set_status(&mut self, value: Status) {
+        if let Some(span) = self.span.as_mut() {
+            span.set_status(value);
+        }
+    }
+    fn update_name<T: Into<Cow<'static, str>>>(&mut self, value: T) {
+        if let Some(span) = self.span.as_mut() {
+            span.update_name(value);
+        }
+    }
+    fn add_link(&mut self, value: SpanContext, attributes: Vec<KeyValue>) {
+        if let Some(span) = self.span.as_mut() {
+            span.add_link(value, attributes);
+        }
+    }
+    fn end_with_timestamp(&mut self, time: SystemTime) {
+        if let Some(span) = self.span.as_mut() {
+            span.end_with_timestamp(time);
+        }
+    }
+}
+static PIPELINE_ENABLED: AtomicBool = AtomicBool::new(true);
+pub fn configure_pipeline(enabled: bool) {
+    PIPELINE_ENABLED.store(enabled, Ordering::Release);
+}
+/// A disabled SDK signal does not consult or replace another application's provider.
+pub fn build_span(
+    service_name: &'static str,
+    builder: opentelemetry::trace::SpanBuilder,
+    parent: &Context,
+) -> ScopedSpan {
+    if PIPELINE_ENABLED.load(Ordering::Acquire) {
+        return wrap_span(
+            global::tracer(service_name).build_with_context(builder, parent),
+            parent,
+        );
+    }
+    let policy = policy_for_context(parent);
+    if policy.is_none() {
+        return ScopedSpan { span: None, span_context: SpanContext::NONE, policy: None };
+    }
+    use opentelemetry_sdk::trace::{IdGenerator, RandomIdGenerator};
+    let generator = RandomIdGenerator::default();
+    let inherited = parent.span().span_context().clone();
+    let trace_id = if inherited.is_valid() {
+        inherited.trace_id()
+    } else {
+        builder.trace_id.unwrap_or_else(|| generator.new_trace_id())
+    };
+    let span_context = SpanContext::new(
+        trace_id,
+        builder.span_id.unwrap_or_else(|| generator.new_span_id()),
+        opentelemetry::trace::TraceFlags::default(),
+        false,
+        inherited.trace_state().clone(),
+    );
+    if let Some(policy) = &policy {
+        policies()
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .insert((trace_id, span_context.span_id()), Arc::downgrade(policy));
+    }
+    ScopedSpan {
+        span: None,
+        span_context,
+        policy,
+    }
+}
+
+struct Handle {
+    context: Context,
+    parent_span_id: Option<String>,
+    ended: Mutex<bool>,
+}
+fn handles() -> &'static Mutex<HashMap<String, Arc<Handle>>> {
+    static HANDLES: OnceLock<Mutex<HashMap<String, Arc<Handle>>>> = OnceLock::new();
+    HANDLES.get_or_init(Default::default)
+}
+fn token(prefix: &str) -> String {
+    static NEXT: AtomicU64 = AtomicU64::new(1);
+    format!("{prefix}{}", NEXT.fetch_add(1, Ordering::Relaxed))
+}
+fn resolve(handle: &str) -> Result<Arc<Handle>, String> {
+    handles()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .get(handle)
+        .cloned()
+        .ok_or_else(|| "Unknown or released native tracing context".into())
+}
+#[derive(Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Options {
+    name: String,
+    #[serde(default)]
+    kind: String,
+    parent: Option<String>,
+    restrictions_parent: Option<String>,
+    #[serde(default)]
+    restrictions_parents: Vec<String>,
+    #[serde(default)]
+    detached: bool,
+    trace_id: Option<String>,
+    group_id: Option<String>,
+    metadata: Option<Value>,
+    disabled: Option<bool>,
+    include_sensitive_data: Option<bool>,
+    credential_ref: Option<String>,
+}
+#[derive(Serialize)]
+struct Readback {
+    handle: String,
+    trace_id: String,
+    span_id: String,
+    parent_span_id: Option<String>,
+    disabled: bool,
+    include_sensitive_data: bool,
+}
+fn readback(key: &str, handle: &Handle) -> Result<String, String> {
+    let span = handle.context.span();
+    let span = span.span_context();
+    let policy = policy_for_context(&handle.context).ok_or("Native tracing policy unavailable")?;
+    serde_json::to_string(&Readback {
+        handle: key.into(),
+        trace_id: span.trace_id().to_string(),
+        span_id: span.span_id().to_string(),
+        parent_span_id: handle.parent_span_id.clone(),
+        disabled: policy.disabled,
+        include_sensitive_data: policy.include_sensitive_data,
+    })
+    .map_err(|_| "Native tracing context could not serialize".into())
+}
+fn parse_trace_id(value: &str) -> Result<TraceId, String> {
+    let value = value.strip_prefix("trace_").unwrap_or(value);
+    if value.len() != 32 || !value.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err("trace_id must contain 32 nonzero hexadecimal digits".into());
+    }
+    let id = TraceId::from_hex(value).map_err(|_| "Invalid trace_id")?;
+    if id == TraceId::INVALID {
+        return Err("trace_id must be nonzero".into());
+    }
+    Ok(id)
+}
+fn bounded_value(value: &Value, depth: usize) -> Result<(), String> {
+    if depth > 8 {
+        return Err("Tracing metadata exceeds maximum depth of 8".into());
+    }
+    match value {
+        Value::String(s) if s.len() > 4096 => Err("Tracing string exceeds 4096 UTF-8 bytes".into()),
+        Value::Array(values) => {
+            if values.len() > 64 {
+                return Err("Tracing arrays may contain at most 64 entries".into());
+            }
+            for value in values {
+                bounded_value(value, depth + 1)?;
+            }
+            Ok(())
+        }
+        Value::Object(values) => {
+            if values.len() > 64 {
+                return Err("Tracing objects may contain at most 64 fields".into());
+            }
+            for (key, value) in values {
+                if key.len() > 256 {
+                    return Err("Tracing key exceeds 256 UTF-8 bytes".into());
+                }
+                bounded_value(value, depth + 1)?;
+            }
+            Ok(())
+        }
+        _ => Ok(()),
+    }
+}
+fn metadata_attribute_value(value: &Value) -> Result<String, String> {
+    let encoded = match value { Value::String(value) => value.clone(), _ => value.to_string() };
+    if encoded.len() > 4096 { return Err("Encoded tracing metadata value exceeds 4096 UTF-8 bytes".into()); }
+    Ok(encoded)
+}
+
+pub fn start_trace_span(encoded: &str) -> Result<String, String> {
+    if encoded.len() > 65536 {
+        return Err("Tracing options exceed 64 KiB".into());
+    }
+    let options: Options =
+        serde_json::from_str(encoded).map_err(|_| "Invalid native tracing span options")?;
+    if options.name.is_empty() || options.name.len() > 4096 {
+        return Err("Tracing span name must contain 1–4096 UTF-8 bytes".into());
+    }
+    if !["workflow", "custom", "callback", "validation", "operation"]
+        .contains(&options.kind.as_str())
+    {
+        return Err("Unsupported native tracing span kind".into());
+    }
+    let parent = options.parent.as_deref().map(resolve).transpose()?;
+    let restriction = options
+        .restrictions_parent
+        .as_deref()
+        .map(resolve)
+        .transpose()?;
+    let inherited = parent.as_ref().and_then(|h| policy_for_context(&h.context));
+    let ambient = restriction
+        .as_ref()
+        .and_then(|h| policy_for_context(&h.context));
+    let restrictions = options
+        .restrictions_parents
+        .iter()
+        .map(|key| {
+            resolve(key).and_then(|handle| {
+                policy_for_context(&handle.context)
+                    .ok_or_else(|| "Native tracing policy unavailable".into())
+            })
+        })
+        .collect::<Result<Vec<_>, String>>()?;
+    let mut policies = vec![inherited.as_ref(), ambient.as_ref()];
+    policies.extend(restrictions.iter().map(Some));
+    let disabled =
+        options.disabled.unwrap_or(false) || policies.iter().flatten().any(|p| p.disabled);
+    let capture = options
+        .include_sensitive_data
+        .unwrap_or_else(|| inherited.as_ref().is_some_and(|p| p.include_sensitive_data))
+        && policies.iter().flatten().all(|p| p.include_sensitive_data);
+    let credential = match options.credential_ref.as_deref() {
+        Some(key) => Some(crate::sdk_trace_routes::credential(key)?),
+        None => inherited.as_ref().and_then(|p| p.credential.clone()),
+    };
+    let policy = Arc::new(ScopePolicy {
+        disabled,
+        include_sensitive_data: capture,
+        credential,
+    });
+    let metadata = options.metadata.unwrap_or_else(|| json!({}));
+    bounded_value(&metadata, 0)?;
+    let metadata = metadata
+        .as_object()
+        .ok_or("Tracing metadata must be an object")?;
+    let mut attributes = Vec::new();
+    attributes.push(KeyValue::new("sdk.span.kind", options.kind));
+    if let Some(group) = options.group_id {
+        if group.len() > 4096 {
+            return Err("Tracing group_id exceeds 4096 UTF-8 bytes".into());
+        }
+        attributes.push(KeyValue::new("sdk.group_id", group));
+    }
+    for (key, value) in metadata {
+        attributes.push(KeyValue::new(
+            format!("sdk.metadata.{key}"),
+            metadata_attribute_value(value)?,
+        ));
+    }
+    let parent_context = if options.detached {
+        Context::new()
+    } else {
+        parent
+            .as_ref()
+            .map(|h| h.context.clone())
+            .unwrap_or_default()
+    };
+    let parent_span = parent_context.span().span_context().clone();
+    let trace_id = options
+        .trace_id
+        .as_deref()
+        .map(parse_trace_id)
+        .transpose()?;
+    if parent_span.is_valid() && trace_id.is_some_and(|id| id != parent_span.trace_id()) {
+        return Err("trace_id does not match the selected parent".into());
+    }
+    let context = parent_context.with_value(policy);
+    let mut builder = opentelemetry::trace::SpanBuilder::from_name(options.name)
+        .with_attributes(attributes);
+    builder.trace_id = trace_id;
+    let span = build_span("codex_agents_sdk", builder, &context);
+    let context = context.with_span(span);
+    let handle = Arc::new(Handle {
+        context,
+        parent_span_id: parent_span
+            .is_valid()
+            .then(|| parent_span.span_id().to_string()),
+        ended: Mutex::new(false),
+    });
+    let key = token("s");
+    let result = readback(&key, &handle)?;
+    handles()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .insert(key, handle);
+    Ok(result)
+}
+pub fn trace_span_context(key: &str) -> Result<String, String> {
+    readback(key, resolve(key)?.as_ref())
+}
+pub fn retain_trace_context(key: &str) -> Result<String, String> {
+    let handle = resolve(key)?;
+    let key = token("c");
+    handles()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .insert(key.clone(), handle);
+    Ok(key)
+}
+pub fn release_trace_context(key: &str) {
+    handles()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .remove(key);
+}
+pub fn release_trace_span(key: &str) {
+    release_trace_context(key);
+}
+pub fn end_trace_span(key: &str, encoded: &str) -> Result<(), String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Outcome {
+        status: String,
+        category: Option<String>,
+        data: Option<Value>,
+    }
+    if encoded.len() > 65536 {
+        return Err("Tracing outcome exceeds 64 KiB".into());
+    }
+    let outcome: Outcome =
+        serde_json::from_str(encoded).map_err(|_| "Invalid tracing span outcome")?;
+    if !["ok", "error", "cancelled"].contains(&outcome.status.as_str()) {
+        return Err("Invalid tracing outcome status".into());
+    }
+    if outcome.category.as_ref().is_some_and(|s| {
+        s.len() > 256 || !s.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
+    }) {
+        return Err("Tracing outcome category must be a bounded nonsecret label".into());
+    }
+    if let Some(data) = &outcome.data {
+        bounded_value(data, 0)?;
+        if data.to_string().len() > 4096 { return Err("Encoded tracing outcome data exceeds 4096 UTF-8 bytes".into()); }
+    }
+    let handle = resolve(key)?;
+    let mut ended = handle.ended.lock().unwrap_or_else(|e| e.into_inner());
+    if *ended {
+        return Ok(());
+    }
+    let span = handle.context.span();
+    span.set_status(if outcome.status == "ok" {
+        Status::Ok
+    } else {
+        Status::error(
+            outcome
+                .category
+                .clone()
+                .unwrap_or_else(|| outcome.status.clone()),
+        )
+    });
+    span.set_attribute(KeyValue::new("sdk.outcome", outcome.status));
+    if let Some(category) = outcome.category {
+        span.set_attribute(KeyValue::new("sdk.outcome.category", category));
+    }
+    if policy_for_context(&handle.context).is_some_and(|p| p.include_sensitive_data)
+        && let Some(data) = outcome.data
+    {
+        span.set_attribute(KeyValue::new("sdk.outcome.data", data.to_string()));
+    }
+    span.end();
+    *ended = true;
+    Ok(())
+}
+pub fn context(key: &str) -> Result<Context, String> {
+    Ok(resolve(key)?.context.clone())
+}
+pub fn current_context_token() -> Option<String> {
+    // Native lifecycle hooks may run in an instrumented tracing span without
+    // an attached OpenTelemetry Context. Prefer that exact span's carrier.
+    let context = crate::trace_context::current_span_w3c_trace_context()
+        .and_then(|trace| crate::trace_context::context_from_w3c_trace_context(&trace))
+        .filter(|context| policy_for_context(context).is_some())
+        .unwrap_or_else(|| restore_policy(Context::current()));
+    policy_for_context(&context)?;
+    let handle = Arc::new(Handle {
+        context,
+        parent_span_id: None,
+        ended: Mutex::new(true),
+    });
+    let key = token("c");
+    handles()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .insert(key.clone(), handle);
+    Some(key)
+}
