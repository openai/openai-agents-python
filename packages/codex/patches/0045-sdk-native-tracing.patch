+//! SDK-owned native spans and immutable, process-local tracing context leases.
+use std::borrow::Cow;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex, OnceLock, Weak};
+use std::time::SystemTime;
+
+pub use opentelemetry::trace::FutureExt;
+use opentelemetry::trace::{SamplingDecision, SamplingResult};
+use opentelemetry::trace::{
+    Span as _, SpanContext, SpanId, SpanKind, Status, TraceContextExt, TraceId, Tracer as _,
+};
+use opentelemetry::{Context, KeyValue, global};
+use opentelemetry_sdk::trace::ShouldSample;
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
