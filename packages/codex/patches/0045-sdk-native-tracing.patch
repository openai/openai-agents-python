+    #[test]
+    fn terminal_deadline_cancels_all_workers_discards_queue_and_releases_credentials() {
+        use std::sync::mpsc;
+        let _test = TEST_LOCK.lock().unwrap();
+        *lock() = Routes::default();
+        struct Exporter {
+            entered: mpsc::Sender<()>,
+        }
+        impl EnvelopeExporter for Exporter {
+            async fn export(
+                &self,
+                _batch: Vec<TraceEnvelope>,
+                _: &BatchReceipt,
+            ) -> Result<Vec<u64>, ()> {
+                self.entered.send(()).unwrap();
+                std::future::pending().await
+            }
+        }
+        let (entered_tx, entered_rx) = mpsc::channel();
+        let worker = Arc::new(
+            TraceBatchProcessor::new(
+                BatchSettings {
+                    queue: 4,
+                    batch: 1,
+                    delay: Duration::from_millis(5),
+                    timeout: Duration::from_secs(30),
+                    concurrency: 2,
+                },
+                move || {
+                    Ok(Exporter {
+                        entered: entered_tx.clone(),
+                    })
+                },
+            )
+            .unwrap(),
+        );
+        let span = sample_span();
+        let credential = Arc::new(TraceCredentials {
+            headers: HashMap::new(),
+        });
+        let retained = Arc::downgrade(&credential);
+        assert!(worker.enqueue(span.clone(), Some(credential.clone()), 1));
+        assert!(worker.enqueue(span.clone(), Some(credential.clone()), 2));
+        for _ in 0..2 {
+            entered_rx.recv_timeout(Duration::from_secs(1)).unwrap();
+        }
+        for sequence in 3..=6 {
+            assert!(worker.enqueue(span.clone(), Some(credential.clone()), sequence));
+        }
+        drop(credential);
+        let flushing = worker.clone();
+        let (flushed_tx, flushed_rx) = mpsc::channel();
+        std::thread::spawn(move || {
+            flushed_tx.send(flushing.force_flush()).unwrap();
+        });
+        let deadline = Instant::now() + Duration::from_millis(25);
+        begin_shutdown(deadline);
+        // The provider's later shutdown call must not reset the short budget.
+        worker
+            .shutdown_with_timeout(Duration::from_secs(1))
+            .unwrap();
+        assert!(Instant::now() < deadline + Duration::from_millis(200));
+        assert_eq!(*worker.shared.terminal.borrow(), Some(deadline));
+        assert!(
+            flushed_rx
+                .recv_timeout(Duration::from_secs(1))
+                .unwrap()
+                .is_err()
+        );
+        assert!(retained.upgrade().is_none());
+        assert!(worker.shared.state.lock().unwrap().queue.is_empty());
+        assert!(
+            entered_rx.try_recv().is_err(),
+            "shutdown must not start the queued exports"
+        );
+        assert_eq!(lock().failed, 2);
+        assert_eq!(lock().dropped, 4);
+        assert!(!worker.enqueue(span, None, 7));
+    }
+
+    #[test]
+    fn expired_terminal_deadline_discards_partial_batch_without_export() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        let _test = TEST_LOCK.lock().unwrap();
+        *lock() = Routes::default();
+        struct Exporter(Arc<AtomicUsize>);
+        impl EnvelopeExporter for Exporter {
+            async fn export(
+                &self,
+                _: Vec<TraceEnvelope>,
+                _: &BatchReceipt,
+            ) -> Result<Vec<u64>, ()> {
+                self.0.fetch_add(1, Ordering::Relaxed);
+                Ok(Vec::new())
+            }
+        }
+        let calls = Arc::new(AtomicUsize::new(0));
+        let recorded = calls.clone();
+        let worker = TraceBatchProcessor::new(
+            BatchSettings {
+                queue: 2,
+                batch: 2,
+                delay: Duration::from_secs(60),
+                timeout: Duration::from_secs(30),
+                concurrency: 1,
+            },
+            move || Ok(Exporter(recorded.clone())),
+        )
+        .unwrap();
+        let credential = Arc::new(TraceCredentials {
+            headers: HashMap::new(),
+        });
+        let retained = Arc::downgrade(&credential);
+        assert!(worker.enqueue(sample_span(), Some(credential), 1));
+        begin_shutdown(Instant::now());
+        worker
+            .shutdown_with_timeout(Duration::from_secs(1))
+            .unwrap();
+        assert_eq!(calls.load(Ordering::Relaxed), 0);
+        assert!(retained.upgrade().is_none());
+        assert_eq!(lock().dropped, 1);
+    }
+}
