+#[cfg(test)]
+mod lifecycle_tests {
+    use super::*;
+    use opentelemetry_sdk::trace::{InMemorySpanExporter, SdkTracerProvider};
+
+    #[test]
+    fn native_scopes_keep_context_after_end_and_release_registry_entries() {
+        // Providers are process-global. Isolate this behavioral test from unrelated suites.
+        const CHILD: &str = "CODEX_SDK_TRACE_LIFECYCLE_TEST_CHILD";
+        if std::env::var_os(CHILD).is_none() {
+            let status = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", "sdk_trace::lifecycle_tests::native_scopes_keep_context_after_end_and_release_registry_entries", "--nocapture"])
+                .env(CHILD,"1").status().unwrap();
+            assert!(status.success());
+            return;
+        }
+        let exporter = InMemorySpanExporter::default();
+        let provider = SdkTracerProvider::builder()
+            .with_sampler(ScopeSampler::default())
+            .with_simple_exporter(exporter.clone())
+            .build();
+        global::set_tracer_provider(provider.clone());
+        let root:Value=serde_json::from_str(&start_trace_span(r#"{"name":"workflow","kind":"workflow","trace_id":"trace_123456789012345678901234567890ab"}"#).unwrap()).unwrap();
+        let root_key = root["handle"].as_str().unwrap();
+        let lease = retain_trace_context(root_key).unwrap();
+        end_trace_span(root_key, r#"{"status":"ok"}"#).unwrap();
+        end_trace_span(root_key, r#"{"status":"error"}"#).unwrap();
+        release_trace_span(root_key);
+        let carrier = trace_carrier(&lease).unwrap();
+        let parent = crate::context_from_w3c_trace_context(&carrier).unwrap();
+        assert!(!policy_for_context(&parent).unwrap().include_sensitive_data);
+        let child = global::tracer("native-fixture").start_with_context("native-child", &parent);
+        let mut child = wrap_span(child, &parent);
+        child.end();
+        drop(child);
+        let snapshot = provider.force_flush();
+        assert!(snapshot.is_ok());
+        let spans = exporter.get_finished_spans().unwrap();
+        assert_eq!(spans.len(), 2);
+        let native = spans.iter().find(|s| s.name == "native-child").unwrap();
+        assert_eq!(
+            native.parent_span_id.to_string(),
+            root["span_id"].as_str().unwrap()
+        );
+        assert_eq!(
+            native.span_context.trace_id().to_string(),
+            root["trace_id"].as_str().unwrap()
+        );
+        release_trace_context(&lease);
+        drop(parent);
+        assert!(handles().lock().unwrap().is_empty());
+        assert!(policies().lock().unwrap().is_empty());
+        provider.shutdown().unwrap();
+    }
+}
