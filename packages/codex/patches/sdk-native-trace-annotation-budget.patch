+// Preserve the ordinary record allowance. Only validated compact SDK completion
+// data grants room above the original 32-KiB data budget, plus JSON escaping.
+// Replay uses the same check; arbitrary observation fields grant no extra room.
+fn completion_projection_bytes(value: Option<&Value>) -> usize {
+    let Some(value @ Value::String(data)) = value else {
+        return 0;
+    };
+    if data.len() > crate::sdk_trace::MAX_COMPLETION_DATA_BYTES {
+        return 0;
+    }
+    let Ok(decoded) = serde_json::from_str::<Value>(data) else {
+        return 0;
+    };
+    if crate::sdk_trace::validate_completion_data(&decoded).is_err()
+        || decoded.to_string() != data.as_str()
+    {
+        return 0;
+    }
+    data.len().saturating_sub(32 * 1024) + value.to_string().len() - data.len() - 2
+}
