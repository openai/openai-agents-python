+}
+
+async fn publish_passive_response_item(
+    sess: &Session,
+    step: &StepContext,
+    item: &ResponseItem,
+    finalized: Option<FinalizedTurnItem>,
+    started: bool,
+) {
+    let facts = finalized.as_ref().map(|item| item.facts.clone());
+    if let Some(finalized) = finalized {
+        if !started {
+            sess.emit_turn_item_started(&step.turn, &finalized.turn_item)
+                .await;
+        }
+        sess.emit_turn_item_completed(&step.turn, finalized.turn_item)
+            .await;
+    }
+    record_completed_response_item_with_finalized_facts(
+        sess, step, item, facts.as_ref(), /*metadata*/ None,
+    )
+    .await;
+}
+
+pub(crate) async fn publish_held_response_items(
+    sess: &Session,
+    step: &StepContext,
+    held: Vec<HeldResponseItem>,
+) -> Result<()> {
+    if held.is_empty() {
+        return Ok(());
+    }
+    for HeldResponseItem { item, mut finalized } in held {
+        // The stream already deferred mailbox input when it observed the message.
+        // Repeating the operation after a follow-up has admitted mail would move it again.
+        if let Some(finalized) = finalized.as_mut() {
+            finalized.facts.defers_mailbox_delivery_to_next_turn = false;
+        }
+        publish_passive_response_item(sess, step, &item, finalized, /*started*/ false).await;
+    }
+    sess.ensure_rollout_durable().await
+}
