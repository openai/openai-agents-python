+#[tokio::test]
+async fn borrowed_lookup_rechecks_api_key_discovery_policy() {
+    for explicit in [false, true] {
+        let endpoint = TestModelsEndpoint::without_refresh(vec![vec![remote_model(
+            "lookup-key-only",
+            "API key catalog",
+            0,
+        )]]);
+        let manager = OpenAiModelsManager::new_without_cache(
+            endpoint,
+            Some(AuthManager::from_auth_for_testing(CodexAuth::from_api_key(
+                "synthetic-key",
+            ))),
+        );
+        let manager = if explicit {
+            manager.with_provider_catalog()
+        } else {
+            manager
+        };
+        manager.set_api_key_model_discovery_enabled(true);
+        manager
+            .raw_model_catalog(RefreshStrategy::Online, DEFAULT_HTTP_CLIENT_FACTORY)
+            .await;
+        let config = ModelsManagerConfig::default();
+        assert_eq!(
+            manager
+                .get_model_info("lookup-key-only", &config)
+                .await
+                .display_name,
+            "API key catalog"
+        );
+        manager.set_api_key_model_discovery_enabled(false);
+        assert!(
+            manager
+                .get_model_info("lookup-key-only", &config)
+                .await
+                .used_fallback_model_metadata
+        );
+        manager.set_api_key_model_discovery_enabled(true);
+        assert_eq!(
+            manager
+                .get_model_info("lookup-key-only", &config)
+                .await
+                .display_name,
+            "API key catalog"
+        );
+    }
