+#[tokio::test]
+async fn borrowed_lookup_preserves_longest_prefix_ties_and_owned_results() {
+    let manager = static_manager_for_tests(ModelsResponse {
+        models: vec![
+            remote_model("lookup", "Broad", 0),
+            remote_model("lookup-long", "First longest", 0),
+            remote_model("lookup-long", "Later tie", 0),
+        ],
+    });
+    let config = ModelsManagerConfig::default();
+    for slug in ["lookup-long-extra", "provider/lookup-long-extra"] {
+        let selected = manager.get_model_info(slug, &config).await;
+        assert_eq!(selected.slug, slug);
+        assert_eq!(selected.display_name, "First longest");
+        assert!(!selected.used_fallback_model_metadata);
+    }
+    let overridden = manager
+        .get_model_info(
+            "lookup-long-extra",
+            &ModelsManagerConfig {
+                base_instructions: Some("One caller only".into()),
+                ..Default::default()
+            },
+        )
+        .await;
+    assert_eq!(
+        overridden
+            .model_messages
+            .as_ref()
+            .unwrap()
+            .instructions_template
+            .as_deref(),
+        Some("One caller only")
+    );
+    let mut caller_owned = manager.get_model_info("lookup-long-extra", &config).await;
+    caller_owned.display_name = "Caller mutation".into();
+    caller_owned
+        .model_messages
+        .get_or_insert_default()
+        .instructions_template = Some("Mutated".into());
+    let unchanged = manager.get_model_info("lookup-long-extra", &config).await;
+    assert_eq!(unchanged.display_name, "First longest");
+    assert_ne!(
+        unchanged
+            .model_messages
+            .as_ref()
+            .and_then(|m| m.instructions_template.as_deref()),
+        Some("Mutated")
+    );
+    assert_ne!(
+        unchanged
+            .model_messages
+            .as_ref()
+            .and_then(|m| m.instructions_template.as_deref()),
+        Some("One caller only")
+    );
+}
