+#[tokio::test]
+async fn borrowed_lookup_keeps_provider_catalog_exact_and_observes_refresh() {
+    for explicit in [false, true] {
+        let home = tempdir().unwrap();
+        let endpoint = TestModelsEndpoint::new(vec![
+            vec![remote_model("lookup-model", "First catalog", 0)],
+            vec![remote_model("lookup-model", "Refreshed catalog", 0)],
+        ]);
+        let manager = openai_manager_for_tests(home.path().into(), endpoint);
+        let manager = if explicit {
+            manager.with_provider_catalog()
+        } else {
+            manager
+        };
+        let config = ModelsManagerConfig::default();
+        manager
+            .raw_model_catalog(RefreshStrategy::Online, DEFAULT_HTTP_CLIENT_FACTORY)
+            .await;
+        assert_eq!(
+            manager
+                .get_model_info("lookup-model", &config)
+                .await
+                .display_name,
+            "First catalog"
+        );
+        for slug in ["lookup-model-extra", "provider/lookup-model"] {
+            let selected = manager.get_model_info(slug, &config).await;
+            assert_eq!(selected.slug, slug);
+            assert_eq!(selected.used_fallback_model_metadata, explicit);
+            if !explicit {
+                assert_eq!(selected.display_name, "First catalog");
+            }
+        }
+        manager
+            .raw_model_catalog(RefreshStrategy::Online, DEFAULT_HTTP_CLIENT_FACTORY)
+            .await;
+        assert_eq!(
+            manager
+                .get_model_info("lookup-model", &config)
+                .await
+                .display_name,
+            "Refreshed catalog"
+        );
+    }
+}
