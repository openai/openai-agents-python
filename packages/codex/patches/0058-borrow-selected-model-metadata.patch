+#[tokio::test]
+async fn borrowed_lookup_hides_catalogs_when_identity_no_longer_matches() {
+    for explicit in [false, true] {
+        let home = tempdir().unwrap();
+        let endpoint = TestModelsEndpoint::new(vec![vec![remote_model(
+            "lookup-private",
+            "Authorized catalog",
+            0,
+        )]]);
+        let manager = openai_manager_for_tests(home.path().into(), endpoint);
+        let manager = if explicit {
+            manager.with_provider_catalog()
+        } else {
+            manager
+        };
+        manager
+            .raw_model_catalog(RefreshStrategy::Online, DEFAULT_HTTP_CLIENT_FACTORY)
+            .await;
+        let config = ModelsManagerConfig::default();
+        assert_eq!(
+            manager
+                .get_model_info("lookup-private", &config)
+                .await
+                .display_name,
+            "Authorized catalog"
+        );
+        manager.remote_models.write().await.identity = Some("other-account".into());
+        let hidden = manager.get_model_info("lookup-private", &config).await;
+        assert!(hidden.used_fallback_model_metadata);
+        assert_ne!(hidden.display_name, "Authorized catalog");
+        let bundled = crate::bundled_models_response().unwrap().models.remove(0);
+        let fallback = manager.get_model_info(&bundled.slug, &config).await;
+        assert_eq!(fallback.used_fallback_model_metadata, explicit);
+        if !explicit {
+            assert_eq!(fallback.display_name, bundled.display_name);
+        }
+    }
+}
