+    #[tokio::test]
+    async fn live_thread_retains_canonical_metadata_failure_after_successful_history_flush() {
+        for path in ["direct", "memory"] {
+            let home = TempDir::new().expect("temp dir");
+            let config = test_config(home.path());
+            let runtime = codex_state::StateRuntime::init(
+                config.sqlite.clone(),
+                config.default_model_provider_id.clone(),
+            )
+            .await
+            .expect("state db");
+            let store = Arc::new(LocalThreadStore::new(config, Some(runtime.clone())));
+            let id = ThreadId::new();
+            let mut params = create_thread_params(id);
+            params.history_mode = ThreadHistoryMode::Paginated;
+            let live = LiveThread::create(store.clone(), params)
+                .await
+                .expect("live thread");
+            live.persist(PersistContext::Standard)
+                .await
+                .expect("initial persistence");
+            live.append_items(&[user_message_item("accepted user input")])
+                .await
+                .expect("accept input");
+            // Materialize history without consuming the LiveThread's pending metadata.
+            store
+                .persist_thread(id, PersistContext::Standard)
+                .await
+                .expect("persist history");
+            store.flush_thread(id).await.expect("flush history");
+            live.flush()
+                .await
+                .expect("commit staged metadata before fault");
+            runtime.close().await;
+            let result = match path {
+                "direct" => live
+                    .update_metadata(
+                        ThreadMetadataPatch {
+                            memory_mode: Some(ThreadMemoryMode::Enabled),
+                            ..Default::default()
+                        },
+                        false,
+                    )
+                    .await
+                    .map(|_| ()),
+                "memory" => {
+                    live.update_memory_mode(ThreadMemoryMode::Enabled, false)
+                        .await
+                }
+                _ => unreachable!(),
+            };
+            result.expect_err(&format!("canonical metadata update fails in {path}"));
+            store
+                .flush_thread(id)
+                .await
+                .expect("primary history flush still succeeds");
+            live.clone()
+                .flush()
+                .await
+                .expect_err("clone retains metadata failure");
+            live.append_items(&[user_message_item("must not run")])
+                .await
+                .expect_err("later append refused");
+            live.persist(PersistContext::Standard)
+                .await
+                .expect_err("later durable boundary refused");
+            live.shutdown()
+                .await
+                .expect_err("shutdown retains first failure");
+            assert!(
+                !store.live_recorders.lock().await.contains_key(&id),
+                "shutdown releases writer after {path}"
+            );
+        }
+    }
