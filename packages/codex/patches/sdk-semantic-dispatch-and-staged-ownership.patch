+/// This independently driven monitor retains the discoverable Pending owner
+/// through final status publication, even after every request waiter drops.
+fn monitor_terminal_write(
+    owner: Arc<Pending>,
+    registry: Arc<PendingWrites>,
+    batch: Arc<StagedInputBatch>,
+    physical: tokio::task::JoinHandle<Result<(), String>>,
+) -> WriteJoin {
+    let monitor = tokio::spawn(async move {
+        let result = match physical.await {
+            Ok(result) => result,
+            Err(error) => Err(format!("Staged terminal writer failed: {error}")),
+        };
+        batch.finish_terminal_write(result.is_ok());
+        if let Err(error) = &result {
+            registry
+                .failure
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .get_or_insert_with(|| error.clone());
+        }
+        // No Session/Turn mutation follows this publication. Weak discovery may
+        // stop finding the owner only after its exact batch status has settled.
+        drop(owner);
+        result
+    });
+    async move {
+        monitor
+            .await
+            .map_err(|error| format!("Staged terminal monitor failed: {error}"))?
+    }
+    .boxed()
+    .shared()
+}
