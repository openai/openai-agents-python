+#[tokio::test]
+async fn provider_compaction_replay_clears_only_the_surviving_older_baseline() {
+    let (session, turn_context) = make_session_and_context().await;
+    let mut old = turn_context.to_turn_context_item();
+    old.sdk_receipt = None;
+    let mut newer = old.clone();
+    newer.turn_id = Some("newer-provider-compaction-turn".to_owned());
+    let turn = |context: TurnContextItem| {
+        vec![
+            RolloutItem::EventMsg(EventMsg::TurnStarted(
+                codex_protocol::protocol::TurnStartedEvent {
+                    turn_id: context.turn_id.clone().unwrap(),
+                    root_turn_id: None,
+                    trace_id: None,
+                    started_at: None,
+                    model_context_window: Some(128_000),
+                    collaboration_mode_kind: ModeKind::Default,
+                },
+            )),
+            RolloutItem::TurnContext(context),
+            RolloutItem::EventMsg(EventMsg::UserMessage(
+                codex_protocol::protocol::UserMessageEvent {
+                    message: "real user boundary".to_owned(),
+                    ..Default::default()
+                },
+            )),
+        ]
+    };
+    let marker = |provider_compaction| {
+        RolloutItem::ResponseItem(ResponseItemEnvelope {
+            item: ResponseItem::Compaction {
+                id: None,
+                encrypted_content: "opaque provider window".to_owned(),
+                internal_chat_message_metadata_passthrough: None,
+            },
+            metadata: Some(codex_history::CodexHarnessMetadata {
+                provider_compaction,
+                ..Default::default()
+            }),
+        })
+    };
+    let mut cleared = turn(old.clone());
+    cleared.push(marker(true));
+    let mut legacy = turn(old.clone());
+    legacy.push(marker(false));
+    let mut newer_baseline = cleared.clone();
+    newer_baseline.extend(turn(newer.clone()));
+    let mut rolled_back = turn(old.clone());
+    rolled_back.extend(turn(newer.clone()));
+    rolled_back.push(marker(true));
+    rolled_back.push(RolloutItem::EventMsg(EventMsg::ThreadRolledBack(
+        ThreadRolledBackEvent { num_turns: 1 },
+    )));
+    for (items, expected) in [
+        (cleared, None),
+        (legacy, Some(old.clone())),
+        (newer_baseline, Some(newer)),
+        (rolled_back, Some(old)),
+    ] {
+        let reconstructed = session
+            .reconstruct_history_from_rollout(&turn_context, &items)
+            .await;
+        assert_eq!(reconstructed.reference_context_item, expected);
+    }
+}
