 impl ResponseItem {
+    /// Apply an exact user message's text-only sampling replacement while
+    /// retaining the native identity and other original fields.
+    pub fn with_user_text_projection(&self, content: Vec<ContentItem>) -> Option<Self> {
+        let Self::Message { role, content: original, .. } = self else {
+            return None;
+        };
+        if role != "user"
+            || content.len() != original.len()
+            || !original.iter().chain(&content).all(|part| matches!(part, ContentItem::InputText { .. }))
+        {
+            return None;
+        }
+        let mut projected = self.clone();
+        let Self::Message { content: target, .. } = &mut projected else {
+            unreachable!("cloning a message preserves the variant");
+        };
+        *target = content;
+        Some(projected)
+    }
+
+    /// Check a replacement previously bound to the native source occurrence.
+    pub fn matches_user_text_projection(&self, item: &Self) -> bool {
+        let Self::Message { content, .. } = item else {
+            return false;
+        };
+        self.with_user_text_projection(content.clone()).as_ref() == Some(item)
+    }
