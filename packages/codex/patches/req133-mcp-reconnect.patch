+#[derive(Default)]
+struct HttpScript {
+    negotiate_session: bool,
+    calls: StdMutex<Vec<(String, Option<String>)>>,
+    handshakes: StdMutex<Vec<Option<String>>>,
+    arrived: tokio::sync::Notify,
+    release_lost: tokio::sync::Notify,
+    release_stale: tokio::sync::Notify,
+    release_pending: tokio::sync::Notify,
+}
+
+async fn http_post(
+    axum::extract::State(script): axum::extract::State<Arc<HttpScript>>,
+    headers: HeaderMap,
+    axum::Json(request): axum::Json<Value>,
+) -> axum::response::Response {
+    use axum::response::IntoResponse;
+    use http::StatusCode;
+    use serde_json::json;
+
+    let session = headers
+        .get("mcp-session-id")
+        .map(|header| header.to_str().unwrap().to_owned());
+    let result = match request["method"].as_str() {
+        Some("initialize") => {
+            let generation = {
+                let mut handshakes = script.handshakes.lock().unwrap();
+                handshakes.push(session);
+                handshakes.len()
+            };
+            let mut response = axum::Json(json!({
+                "jsonrpc": "2.0",
+                "id": request["id"],
+                "result": {
+                    "protocolVersion": "2025-06-18",
+                    "capabilities": {"tools": {}},
+                    "serverInfo": {"name": "test", "version": "1"}
+                }
+            }))
+            .into_response();
+            if script.negotiate_session {
+                response.headers_mut().insert(
+                    "mcp-session-id",
+                    format!("generation-{generation}").parse().unwrap(),
+                );
+            }
+            return response;
+        }
+        Some("notifications/initialized" | "notifications/cancelled") => {
+            return StatusCode::ACCEPTED.into_response();
+        }
+        Some("tools/call") => {
+            let name = request["params"]["name"].as_str().unwrap();
+            script
+                .calls
+                .lock()
+                .unwrap()
+                .push((name.to_owned(), session));
+            script.arrived.notify_one();
+            match name {
+                "lost" | "stale" => {
+                    let release = if name == "lost" {
+                        &script.release_lost
+                    } else {
+                        &script.release_stale
+                    };
+                    release.notified().await;
+                    return ([("content-type", "text/event-stream")], "").into_response();
+                }
+                "pending" => script.release_pending.notified().await,
+                "next" => {}
+                _ => panic!("unexpected tool call {name}"),
+            }
+            json!({"content": [{"type": "text", "text": name}]})
+        }
+        _ => panic!("unexpected HTTP MCP request {request}"),
+    };
+    axum::Json(json!({"jsonrpc": "2.0", "id": request["id"], "result": result})).into_response()
+}
+
+#[tokio::test]
+async fn http_sse_close_recovers_without_replaying_or_interrupting_another_call() -> Result<()> {
+    for (configured_session_header, negotiate_session) in [
+        (None, true),
+        (Some("configured-header"), true),
+        (Some("configured-header"), false),
+    ] {
+        timeout(TEST_TIMEOUT, async {
+            let script = Arc::new(HttpScript {
+                negotiate_session,
+                ..HttpScript::default()
+            });
+            let listener = tokio::net::TcpListener::bind(("127.0.0.1", 0)).await?;
+            let url = format!("http://{}", listener.local_addr()?);
+            let router = axum::Router::new()
+                .route("/", axum::routing::post(http_post))
+                .with_state(Arc::clone(&script));
+            let server = tokio::spawn(async move { axum::serve(listener, router).await });
+            let client = Arc::new(
+                RmcpClient::new_streamable_http_client(
+                    "scripted",
+                    &url,
+                    Some("test-token".into()),
+                    configured_session_header
+                        .map(|id| HashMap::from([("MCP-Session-Id".into(), id.into())])),
+                    None,
+                    OAuthCredentialsStoreMode::File,
+                    AuthKeyringBackendKind::default(),
+                    codex_exec_server::Environment::default_for_tests().get_http_client(),
+                    None,
+                )
+                .await?,
+            );
+            initialize(&client).await?;
+            let start = |name: &'static str| {
+                let client = Arc::clone(&client);
+                tokio::spawn(async move { call(&client, name).await })
+            };
+            let lost = start("lost");
+            let stale = start("stale");
+            let pending = start("pending");
+            while script.calls.lock().unwrap().len() < 3 {
+                script.arrived.notified().await;
+            }
+            script.release_lost.notify_one();
+            assert_closed(lost.await?.unwrap_err());
+            assert_eq!(script.handshakes.lock().unwrap().len(), 2);
+
+            script.release_stale.notify_one();
+            script.release_pending.notify_one();
+            assert_closed(stale.await?.unwrap_err());
+            assert!(pending.await??.is_error != Some(true));
+            assert!(call(&client, "next").await?.is_error != Some(true));
+            let configured_header = configured_session_header.map(str::to_owned);
+            assert_eq!(
+                *script.handshakes.lock().unwrap(),
+                [configured_header.clone(), configured_header]
+            );
+            let mut calls = script.calls.lock().unwrap().clone();
+            calls.sort_unstable();
+            let session_id = |generation| {
+                if negotiate_session {
+                    Some(format!("generation-{generation}"))
+                } else {
+                    configured_session_header.map(str::to_owned)
+                }
+            };
+            assert_eq!(
+                calls,
+                [
+                    ("lost".into(), session_id(1)),
+                    ("next".into(), session_id(2)),
+                    ("pending".into(), session_id(1)),
+                    ("stale".into(), session_id(1)),
+                ]
+            );
+            client.shutdown().await;
+            server.abort();
+            anyhow::Ok(())
+        })
+        .await??;
+    }
+    Ok(())
+}
