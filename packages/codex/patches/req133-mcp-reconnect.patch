+//! Scripted RMCP peers count tool requests across transport generations.
+
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicUsize;
+
+use rmcp::RoleServer;
+use rmcp::model::ClientJsonRpcMessage;
+use rmcp::model::ServerInfo;
+use rmcp::model::ServerJsonRpcMessage;
+use rmcp::transport::IntoTransport;
+use rmcp::transport::Transport;
+use tokio::io::DuplexStream;
+use tokio::sync::mpsc;
+use tokio::time::timeout;
+
+use super::*;
+
+const TEST_TIMEOUT: Duration = Duration::from_secs(10);
+
+struct ScriptedFactory {
+    peers: mpsc::UnboundedSender<DuplexStream>,
+    opens: AtomicUsize,
+    fail_next: AtomicBool,
+}
+
+impl InProcessTransportFactory for ScriptedFactory {
+    fn open(&self) -> BoxFuture<'static, io::Result<DuplexStream>> {
+        self.opens.fetch_add(1, Ordering::Relaxed);
+        let fail = self.fail_next.swap(false, Ordering::Relaxed);
+        let peers = self.peers.clone();
+        async move {
+            if fail {
+                return Err(io::Error::other("scripted reconnect failure"));
+            }
+            let (client, server) = tokio::io::duplex(4096);
+            peers.send(server).map_err(io::Error::other)?;
+            Ok(client)
+        }
+        .boxed()
+    }
+}
+
+async fn accept(
+    peers: &mut mpsc::UnboundedReceiver<DuplexStream>,
+) -> Result<impl Transport<RoleServer, Error = io::Error> + use<>> {
+    let server = peers.recv().await.context("missing MCP connection")?;
+    let mut peer = IntoTransport::<RoleServer, _, _>::into_transport(server);
+    let Some(ClientJsonRpcMessage::Request(request)) = peer.receive().await else {
+        anyhow::bail!("expected initialize request");
+    };
+    let ClientRequest::InitializeRequest(_) = request.request else {
+        anyhow::bail!("expected initialize, got {:?}", request.request);
+    };
+    peer.send(ServerJsonRpcMessage::response(
+        ServerResult::InitializeResult(
+            ServerInfo::default().with_protocol_version(ProtocolVersion::V_2025_06_18),
+        ),
+        request.id,
+    ))
+    .await?;
+    assert!(matches!(
+        peer.receive().await,
+        Some(ClientJsonRpcMessage::Notification(notification))
+            if matches!(notification.notification, ClientNotification::InitializedNotification(_))
+    ));
+    Ok(peer)
+}
+
+async fn initialize(client: &RmcpClient) -> Result<ServerPeerInfo> {
+    client
+        .initialize(
+            InitializeRequestParams::default().with_protocol_version(ProtocolVersion::V_2025_06_18),
+            Some(TEST_TIMEOUT),
+            Box::new(|_, _| Box::pin(async { anyhow::bail!("unexpected elicitation") })),
+        )
+        .await
+}
+
+async fn scripted_client() -> Result<(
+    RmcpClient,
+    Arc<ScriptedFactory>,
+    mpsc::UnboundedReceiver<DuplexStream>,
+    impl Transport<RoleServer, Error = io::Error>,
+)> {
+    let (send, mut peers) = mpsc::unbounded_channel();
+    let factory = Arc::new(ScriptedFactory {
+        peers: send,
+        opens: AtomicUsize::new(0),
+        fail_next: AtomicBool::new(false),
+    });
+    let client = RmcpClient::new_in_process_client(factory.clone()).await?;
+    let (_, peer) = tokio::try_join!(initialize(&client), accept(&mut peers))?;
+    Ok((client, factory, peers, peer))
+}
+
+async fn next_call(peer: &mut impl Transport<RoleServer>) -> (RequestId, String) {
+    loop {
+        match peer.receive().await {
+            Some(ClientJsonRpcMessage::Request(request)) => {
+                let ClientRequest::CallToolRequest(call) = request.request else {
+                    panic!("expected tools/call, got {:?}", request.request);
+                };
+                return (request.id, call.params.name.to_string());
+            }
+            Some(ClientJsonRpcMessage::Notification(notification)) => assert!(matches!(
+                notification.notification,
+                ClientNotification::CancelledNotification(_)
+            )),
+            message => panic!("expected a call or cancellation, got {message:?}"),
+        }
+    }
+}
+
+async fn reply(
+    peer: &mut impl Transport<RoleServer, Error = io::Error>,
+    id: RequestId,
+) -> Result<()> {
+    peer.send(ServerJsonRpcMessage::response(
+        ServerResult::CallToolResult(CallToolResult::success(vec![])),
+        id,
+    ))
+    .await?;
+    Ok(())
+}
+
+async fn call(client: &RmcpClient, name: &str) -> Result<CallToolResult> {
+    client
+        .call_tool(name.into(), None, None, Some(TEST_TIMEOUT))
+        .await
+}
+
+fn assert_closed(error: anyhow::Error) {
+    assert!(
+        matches!(
+            error
+                .downcast_ref::<ClientOperationError>()
+                .and_then(ClientOperationError::service_error),
+            Some(ServiceError::TransportClosed)
+        ),
+        "{error:#}"
+    );
+}
+
+#[tokio::test]
+async fn shutdown_blocks_dispatch_from_a_retained_replacement() -> Result<()> {
+    timeout(TEST_TIMEOUT, async {
+        let (client, factory, mut peers, original) = scripted_client().await?;
+        let failed = client.service().await?;
+        drop(original);
+        let (replacement, mut peer) =
+            tokio::try_join!(client.reconnect(&failed, None), accept(&mut peers))?;
+        assert_eq!(factory.opens.load(Ordering::Relaxed), 2);
+
+        client.shutdown().await;
+        assert!(!replacement.is_closed(), "test must retain a live peer");
+        let mut dispatch = std::pin::pin!(RmcpClient::run_service_operation_with_transient_retries(
+            Arc::clone(&replacement),
+            "tools/call",
+            None,
+            &|service| async move { service.call_tool(CallToolRequestParams::new("late")).await },
+        ));
+        let mut effects = 0;
+        let result = tokio::select! {
+            result = &mut dispatch => result,
+            (id, name) = next_call(&mut peer) => {
+                assert_eq!(name, "late");
+                effects += 1;
+                reply(&mut peer, id).await?;
+                dispatch.await
+            }
+        };
+        assert_eq!(effects, 0, "shutdown allowed the retained peer to dispatch");
+        assert_eq!(result.unwrap_err().to_string(), "MCP client is shut down");
+        Ok(())
+    })
+    .await?
+}
+
+#[tokio::test]
+async fn shutdown_interrupts_a_pending_reconnect_handshake() -> Result<()> {
+    timeout(TEST_TIMEOUT, async {
+        let (client, _, mut peers, _original) = scripted_client().await?;
+        let failed = client.service().await?;
+        let mut reconnect = std::pin::pin!(client.reconnect(&failed, None));
+        let server = tokio::select! {
+            _ = &mut reconnect => panic!("reconnect finished before handshake"),
+            server = peers.recv() => server.context("missing replacement connection")?,
+        };
+        let mut peer = IntoTransport::<RoleServer, _, _>::into_transport(server);
+        tokio::select! {
+            _ = &mut reconnect => panic!("reconnect finished before handshake"),
+            message = peer.receive() => assert!(matches!(
+                message,
+                Some(ClientJsonRpcMessage::Request(request))
+                    if matches!(request.request, ClientRequest::InitializeRequest(_))
+            )),
+        }
+
+        client.shutdown().await;
+        let std::task::Poll::Ready(Err(error)) = futures::poll!(&mut reconnect) else {
+            panic!("shutdown did not interrupt the pending handshake");
+        };
+        assert_eq!(error.to_string(), "MCP client is shut down");
+        assert!(peer.receive().await.is_none());
+        Ok(())
+    })
+    .await?
+}
