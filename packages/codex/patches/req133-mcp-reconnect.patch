+fn is_http_connection_closed(error: &ExecServerError) -> bool {
+    match error {
+        ExecServerError::Closed | ExecServerError::Disconnected(_) => true,
+        // The local backend reports an incomplete response body as text.
+        // Its generic send error also covers timeouts and TLS failures.
+        ExecServerError::HttpRequest(message) => {
+            message.starts_with("error decoding response body")
+        }
+        ExecServerError::Protocol(message) => {
+            message.starts_with("http response stream `") && message.contains("` failed:")
+        }
+        _ => false,
+    }
