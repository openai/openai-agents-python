+            peers.send(server).map_err(io::Error::other)?;
+            Ok(client)
+        }
+        .boxed()
+    }
+}
+
+async fn accept(
+    peers: &mut mpsc::UnboundedReceiver<DuplexStream>,
+) -> Result<impl Transport<RoleServer, Error = io::Error> + use<>> {
+    let server = peers.recv().await.context("missing MCP connection")?;
+    let mut peer = IntoTransport::<RoleServer, _, _>::into_transport(server);
+    let Some(ClientJsonRpcMessage::Request(request)) = peer.receive().await else {
+        anyhow::bail!("expected initialize request");
+    };
+    let ClientRequest::InitializeRequest(_) = request.request else {
+        anyhow::bail!("expected initialize, got {:?}", request.request);
+    };
+    peer.send(ServerJsonRpcMessage::response(
+        ServerResult::InitializeResult(
+            ServerInfo::default().with_protocol_version(ProtocolVersion::V_2025_06_18),
+        ),
+        request.id,
+    ))
+    .await?;
+    assert!(matches!(
+        peer.receive().await,
+        Some(ClientJsonRpcMessage::Notification(notification))
+            if matches!(notification.notification, ClientNotification::InitializedNotification(_))
+    ));
+    Ok(peer)
+}
+
+async fn initialize(client: &RmcpClient) -> Result<ServerPeerInfo> {
+    client
+        .initialize(
+            InitializeRequestParams::default().with_protocol_version(ProtocolVersion::V_2025_06_18),
+            Some(TEST_TIMEOUT),
+            Box::new(|_, _| Box::pin(async { anyhow::bail!("unexpected elicitation") })),
+        )
+        .await
+}
+
+async fn scripted_client() -> Result<(
+    RmcpClient,
+    Arc<ScriptedFactory>,
+    mpsc::UnboundedReceiver<DuplexStream>,
+    impl Transport<RoleServer, Error = io::Error>,
+)> {
+    let (send, mut peers) = mpsc::unbounded_channel();
+    let factory = Arc::new(ScriptedFactory {
+        peers: send,
+        opens: AtomicUsize::new(0),
+        fail_next: AtomicBool::new(false),
+    });
+    let client = RmcpClient::new_in_process_client(factory.clone()).await?;
+    let (_, peer) = tokio::try_join!(initialize(&client), accept(&mut peers))?;
+    Ok((client, factory, peers, peer))
+}
+
+async fn next_call(peer: &mut impl Transport<RoleServer>) -> (RequestId, String) {
+    loop {
+        match peer.receive().await {
+            Some(ClientJsonRpcMessage::Request(request)) => {
+                let ClientRequest::CallToolRequest(call) = request.request else {
+                    panic!("expected tools/call, got {:?}", request.request);
+                };
+                return (request.id, call.params.name.to_string());
+            }
+            Some(ClientJsonRpcMessage::Notification(notification)) => assert!(matches!(
+                notification.notification,
+                ClientNotification::CancelledNotification(_)
+            )),
+            message => panic!("expected a call or cancellation, got {message:?}"),
+        }
+    }
+}
+
+async fn reply(
+    peer: &mut impl Transport<RoleServer, Error = io::Error>,
+    id: RequestId,
+) -> Result<()> {
+    peer.send(ServerJsonRpcMessage::response(
+        ServerResult::CallToolResult(CallToolResult::success(vec![])),
+        id,
+    ))
+    .await?;
+    Ok(())
+}
+
+async fn call(client: &RmcpClient, name: &str) -> Result<CallToolResult> {
+    client
+        .call_tool(name.into(), None, None, Some(TEST_TIMEOUT))
+        .await
+}
+
+fn assert_closed(error: anyhow::Error) {
+    assert!(
+        matches!(
+            error
+                .downcast_ref::<ClientOperationError>()
+                .and_then(ClientOperationError::service_error),
+            Some(ServiceError::TransportClosed)
+        ),
+        "{error:#}"
+    );
+}
