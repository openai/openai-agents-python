+#[derive(Default)]
+struct OwnedStdioShutdown {
+    started: CancellationToken,
+    completion: OnceLock<futures::future::Shared<BoxFuture<'static, Result<(), String>>>>,
+}
+
+async fn reap_owned_stdio(
+    service: Option<&ClientService>,
+    process: Option<&StdioServerProcessHandle>,
+) -> Result<()> {
+    let service_result = match service {
+        Some(service) => service.stop_owned().await,
+        None => Ok(()),
+    };
+    let process_result = match process {
+        Some(process) => process
+            .terminate_and_wait()
+            .await
+            .map_err(anyhow::Error::from),
+        None => Ok(()),
+    };
+    if service_result.is_err()
+        && let Err(error) = &process_result
+    {
+        warn!("failed to reap MCP stdio server process: {error}");
+    }
+    service_result.and(process_result)
+}
+
 enum ClientState {
     Connecting {
         transport: Option<PendingTransport>,
+        stdio_process: Option<StdioServerProcessHandle>,
     },
     Ready {
         service: Arc<ClientService>,
         oauth: Option<OAuthRuntime>,
+        stdio_process: Option<StdioServerProcessHandle>,
+        initialize_context: Arc<InitializeContext>,
+        recovery_needed: bool,
     },
     Closed,
 }
 
+impl ClientState {
+    fn stdio_process(&self) -> Option<&StdioServerProcessHandle> {
+        match self {
+            Self::Connecting { stdio_process, .. } | Self::Ready { stdio_process, .. } => {
+                stdio_process.as_ref()
+            }
+            Self::Closed => None,
+        }
+    }
+}
+
+impl PendingTransport {
+    fn stdio_process(&self) -> Option<StdioServerProcessHandle> {
+        match self {
+            Self::Stdio { transport } => Some(transport.process_handle()),
+            _ => None,
+        }
+    }
+}
