+#[tokio::test]
+async fn known_closed_call_times_out_in_the_reconnect_queue_without_dispatching() -> Result<()> {
+    timeout(TEST_TIMEOUT, async {
+        let (client, factory, mut peers, original) = scripted_client().await?;
+        drop(original);
+        while !client.is_closed().await {
+            tokio::task::yield_now().await;
+        }
+
+        let first = call(&client, "first");
+        tokio::pin!(first);
+        // Keep the first reconnect in its handshake while the second call queues.
+        assert!(futures::poll!(&mut first).is_pending());
+        assert_eq!(factory.opens.load(Ordering::Relaxed), 2);
+
+        let duration = Duration::from_millis(50);
+        let error = client
+            .call_tool("queued".into(), None, None, Some(duration))
+            .await
+            .unwrap_err();
+        assert!(matches!(
+            error.downcast_ref::<ClientOperationError>(),
+            Some(ClientOperationError::Timeout { label, duration: configured })
+                if label == "tools/call" && *configured == duration
+        ));
+
+        let peer_work = async {
+            let mut replacement = accept(&mut peers).await?;
+            let (id, name) = next_call(&mut replacement).await;
+            assert_eq!(name, "first");
+            reply(&mut replacement, id).await?;
+            anyhow::Ok(replacement)
+        };
+        let (_, mut replacement) = tokio::try_join!(&mut first, peer_work)?;
+        let next = async {
+            let (id, name) = next_call(&mut replacement).await;
+            assert_eq!(name, "next");
+            reply(&mut replacement, id).await
+        };
+        tokio::try_join!(call(&client, "next"), next)?;
+        assert_eq!(factory.opens.load(Ordering::Relaxed), 2);
+        Ok(())
+    })
+    .await?
+}
+
+#[tokio::test(start_paused = true)]
+async fn known_closed_call_uses_the_remaining_budget_after_admission() -> Result<()> {
+    timeout(TEST_TIMEOUT * 2, async {
+        let (client, factory, mut peers, original) = scripted_client().await?;
+        drop(original);
+        while !client.is_closed().await {
+            tokio::task::yield_now().await;
+        }
+
+        let started = time::Instant::now();
+        let request = call(&client, "slow");
+        tokio::pin!(request);
+        assert!(futures::poll!(&mut request).is_pending());
+        time::advance(Duration::from_secs(6)).await;
+
+        let peer_work = async {
+            let mut replacement = accept(&mut peers).await?;
+            let (_, name) = next_call(&mut replacement).await;
+            assert_eq!(name, "slow");
+            // Keep the connection open without replying to the call.
+            anyhow::Ok(replacement)
+        };
+        let (result, peer) = tokio::join!(&mut request, peer_work);
+        let _peer = peer?;
+        let error = result.unwrap_err();
+        assert!(matches!(
+            error.downcast_ref::<ClientOperationError>(),
+            Some(ClientOperationError::Timeout { label, duration })
+                if label == "tools/call" && *duration == TEST_TIMEOUT
+        ));
+        assert!((TEST_TIMEOUT..TEST_TIMEOUT + Duration::from_secs(1)).contains(&started.elapsed()));
+        assert_eq!(factory.opens.load(Ordering::Relaxed), 2);
+        Ok(())
+    })
+    .await?
+}
+
+#[tokio::test]
+async fn uncertain_close_preserves_error_when_repair_fails_and_next_call_recovers() -> Result<()> {
+    timeout(TEST_TIMEOUT, async {
+        let (client, factory, mut peers, mut original) = scripted_client().await?;
+        factory.fail_next.store(true, Ordering::Relaxed);
+        let lost = call(&client, "lost-response");
+        let close = async {
+            assert_eq!(next_call(&mut original).await.1, "lost-response");
+            drop(original);
+        };
+        let (result, ()) = tokio::join!(lost, close);
+        assert_closed(result.unwrap_err());
+        assert_eq!(factory.opens.load(Ordering::Relaxed), 2);
+
+        let peer_work = async {
+            let mut replacement = accept(&mut peers).await?;
+            let (id, name) = next_call(&mut replacement).await;
+            assert_eq!(name, "next");
+            reply(&mut replacement, id).await
+        };
+        tokio::try_join!(call(&client, "next"), peer_work)?;
+        assert_eq!(factory.opens.load(Ordering::Relaxed), 3);
+        Ok(())
+    })
+    .await?
+}
+
+#[tokio::test]
+async fn aborting_an_active_call_keeps_the_existing_connection() -> Result<()> {
+    timeout(TEST_TIMEOUT, async {
+        let (client, factory, _peers, mut peer) = scripted_client().await?;
+        let mut aborted = Box::pin(call(&client, "aborted"));
+        tokio::select! {
+            result = &mut aborted => panic!("aborted call completed: {result:?}"),
+            (_, name) = next_call(&mut peer) => assert_eq!(name, "aborted"),
+        }
+        drop(aborted);
+
+        let peer_work = async {
+            let (id, name) = next_call(&mut peer).await;
+            assert_eq!(name, "next");
+            reply(&mut peer, id).await
+        };
+        tokio::try_join!(call(&client, "next"), peer_work)?;
+        assert_eq!(factory.opens.load(Ordering::Relaxed), 1);
+        Ok(())
+    })
+    .await?
+}
