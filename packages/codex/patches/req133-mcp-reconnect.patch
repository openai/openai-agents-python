+        .respond_with(move |request: &Request| {
+            let body: Value = request.body_json().expect("valid JSON-RPC request");
+            match body["method"].as_str() {
+                Some("server/discover") => discover_response(&body),
+                Some("tools/call") => {
+                    let name = body["params"]["name"].as_str().expect("tool name");
+                    let state = body["params"]["requestState"].as_str();
+                    recorded_calls
+                        .lock()
+                        .expect("calls lock")
+                        .push((name.to_owned(), state.map(str::to_owned)));
+                    match (name, state) {
+                        ("state-only", None) => result_response(
+                            &body,
+                            json!({"resultType": "input_required", "requestState": OPAQUE_STATE}),
+                        ),
+                        ("state-only", Some(OPAQUE_STATE)) => {
+                            ResponseTemplate::new(200).set_body_raw("", "text/event-stream")
+                        }
+                        ("next", None) => {
+                            result_response(&body, json!({"resultType": "complete", "content": []}))
+                        }
