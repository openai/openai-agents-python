+#[derive(Default)]
+enum FirstListFailure {
+    #[default]
+    BodyError,
+    TransportClosed,
+}
+
+#[derive(Default)]
+struct HttpScript {
+    negotiate_session: bool,
+    first_list_failure: FirstListFailure,
+    calls: StdMutex<Vec<(String, Option<String>)>>,
+    lists: StdMutex<Vec<String>>,
+    handshakes: StdMutex<Vec<Option<String>>>,
+    arrived: tokio::sync::Notify,
+    release_lost: tokio::sync::Notify,
+    release_stale: tokio::sync::Notify,
+    release_pending: tokio::sync::Notify,
+}
+
+async fn http_post(
+    axum::extract::State(script): axum::extract::State<Arc<HttpScript>>,
+    headers: HeaderMap,
+    axum::Json(request): axum::Json<Value>,
+) -> axum::response::Response {
+    use axum::response::IntoResponse;
+    use http::StatusCode;
+    use serde_json::json;
+
+    let session = headers
+        .get("mcp-session-id")
+        .map(|header| header.to_str().unwrap().to_owned());
+    let result = match request["method"].as_str() {
+        Some("initialize") => {
+            let generation = {
+                let mut handshakes = script.handshakes.lock().unwrap();
+                handshakes.push(session);
+                handshakes.len()
+            };
+            let mut response = axum::Json(json!({
+                "jsonrpc": "2.0",
+                "id": request["id"],
+                "result": {
+                    "protocolVersion": "2025-06-18",
+                    "capabilities": {"tools": {}},
+                    "serverInfo": {"name": "test", "version": "1"}
+                }
+            }))
+            .into_response();
+            if script.negotiate_session {
+                response.headers_mut().insert(
+                    "mcp-session-id",
+                    format!("generation-{generation}").parse().unwrap(),
+                );
+            }
+            return response;
+        }
+        Some("notifications/initialized" | "notifications/cancelled") => {
+            return StatusCode::ACCEPTED.into_response();
+        }
+        Some("tools/list") => {
+            let first_list = {
+                let mut lists = script.lists.lock().unwrap();
+                lists.push(session.unwrap());
+                lists.len() == 1
+            };
+            if first_list {
+                if matches!(script.first_list_failure, FirstListFailure::TransportClosed) {
+                    return ([("content-type", "text/event-stream")], "").into_response();
+                }
+                // End a JSON response before the advertised length to produce an HTTP body error.
+                let body = axum::body::Body::from_stream(futures::stream::unfold((), |()| async {
+                    // Let Hyper flush the response headers before closing the stream.
+                    tokio::task::yield_now().await;
+                    None::<(io::Result<bytes::Bytes>, ())>
+                }));
+                return (
+                    [
+                        ("content-type", "application/json"),
+                        ("content-length", "100"),
+                    ],
+                    body,
+                )
+                    .into_response();
+            }
+            json!({"tools": []})
+        }
+        Some("tools/call") => {
+            let name = request["params"]["name"].as_str().unwrap();
+            script
+                .calls
+                .lock()
+                .unwrap()
+                .push((name.to_owned(), session));
+            script.arrived.notify_one();
+            match name {
+                "lost" | "stale" => {
+                    let release = if name == "lost" {
+                        &script.release_lost
+                    } else {
+                        &script.release_stale
+                    };
+                    release.notified().await;
+                    return ([("content-type", "text/event-stream")], "").into_response();
+                }
+                "pending" => script.release_pending.notified().await,
+                "next" => {}
+                _ => panic!("unexpected tool call {name}"),
+            }
+            json!({"content": [{"type": "text", "text": name}]})
+        }
+        _ => panic!("unexpected HTTP MCP request {request}"),
+    };
+    axum::Json(json!({"jsonrpc": "2.0", "id": request["id"], "result": result})).into_response()
+}
+
+async fn scripted_http_list_client(
+    first_list_failure: FirstListFailure,
+) -> Result<(
+    RmcpClient,
+    Arc<HttpScript>,
+    tokio::task::JoinHandle<io::Result<()>>,
+)> {
+    let script = Arc::new(HttpScript {
+        negotiate_session: true,
+        first_list_failure,
+        ..HttpScript::default()
+    });
+    let listener = tokio::net::TcpListener::bind(("127.0.0.1", 0)).await?;
+    let url = format!("http://{}", listener.local_addr()?);
+    let router = axum::Router::new()
+        .route("/", axum::routing::post(http_post))
+        .with_state(Arc::clone(&script));
+    let server = tokio::spawn(async move { axum::serve(listener, router).await });
+    let client = RmcpClient::new_streamable_http_client(
+        "scripted",
+        &url,
+        Some("test-token".into()),
+        None,
+        None,
+        OAuthCredentialsStoreMode::File,
+        AuthKeyringBackendKind::default(),
+        codex_exec_server::Environment::default_for_tests().get_http_client(),
+        None,
+    )
+    .await?;
+    initialize(&client).await?;
+    Ok((client, script, server))
+}
+
+#[tokio::test]
+async fn http_list_retries_body_error_on_the_same_generation() -> Result<()> {
+    timeout(TEST_TIMEOUT, async {
+        let (client, script, server) =
+            scripted_http_list_client(FirstListFailure::BodyError).await?;
+
+        assert!(client.list_tools(None, None).await?.tools.is_empty());
+        assert_eq!(
+            *script.lists.lock().unwrap(),
+            ["generation-1", "generation-1"]
+        );
+        assert_eq!(script.handshakes.lock().unwrap().len(), 1);
+        client.shutdown().await;
+        server.abort();
+        Ok(())
+    })
+    .await?
+}
+
+#[tokio::test]
+async fn http_list_transport_closed_repairs_for_the_next_list_without_replay() -> Result<()> {
+    timeout(TEST_TIMEOUT, async {
+        let (client, script, server) =
+            scripted_http_list_client(FirstListFailure::TransportClosed).await?;
+
+        assert_closed(client.list_tools(None, None).await.unwrap_err());
+        assert_eq!(*script.lists.lock().unwrap(), ["generation-1"]);
+        assert_eq!(script.handshakes.lock().unwrap().len(), 2);
+
+        assert!(client.list_tools(None, None).await?.tools.is_empty());
+        assert_eq!(
+            *script.lists.lock().unwrap(),
+            ["generation-1", "generation-2"]
+        );
+        assert_eq!(script.handshakes.lock().unwrap().len(), 2);
+        client.shutdown().await;
+        server.abort();
+        Ok(())
+    })
+    .await?
+}
