+
+#[tokio::test]
+async fn closed_tool_continuation_does_not_replay_initial_round() -> anyhow::Result<()> {
+    let server = MockServer::start().await;
+    let calls = Arc::new(Mutex::new(Vec::new()));
+    let recorded_calls = Arc::clone(&calls);
+
+    Mock::given(method("POST"))
+        .and(path("/mcp"))
+        .respond_with(move |request: &Request| {
+            let body: Value = request.body_json().expect("valid JSON-RPC request");
+            match body["method"].as_str() {
+                Some("server/discover") => discover_response(&body),
+                Some("tools/call") => {
+                    let name = body["params"]["name"].as_str().expect("tool name");
+                    let state = body["params"]["requestState"].as_str();
+                    recorded_calls
+                        .lock()
+                        .expect("calls lock")
+                        .push((name.to_owned(), state.map(str::to_owned)));
+                    match (name, state) {
+                        ("state-only", None) => result_response(
+                            &body,
+                            json!({"resultType": "input_required", "requestState": OPAQUE_STATE}),
+                        ),
+                        ("state-only", Some(OPAQUE_STATE)) => {
+                            ResponseTemplate::new(200).set_body_raw("", "text/event-stream")
+                        }
+                        ("next", None) => {
+                            result_response(&body, json!({"resultType": "complete", "content": []}))
+                        }
+                        _ => panic!("unexpected tool request {body}"),
+                    }
+                }
+                other => panic!("unexpected MRTR request: {other:?}"),
+            }
+        })
+        .expect(5)
+        .mount(&server)
+        .await;
+
+    let client = create_client(&server, Arc::new(Mutex::new(Vec::new()))).await?;
+    let error = client
+        .call_tool(
+            "state-only".into(),
+            None,
+            None,
+            Some(Duration::from_secs(5)),
+        )
+        .await
+        .expect_err("response stream ended before the final result");
+    assert!(
+        format!("{error:#}")
+            .to_lowercase()
+            .contains("transport closed"),
+        "{error:#}"
+    );
+    client
+        .call_tool("next".into(), None, None, Some(Duration::from_secs(5)))
+        .await?;
+    assert_eq!(
+        *calls.lock().expect("calls lock"),
+        [
+            ("state-only".to_owned(), None),
+            ("state-only".to_owned(), Some(OPAQUE_STATE.to_owned())),
+            ("next".to_owned(), None)
+        ]
+    );
+    client.shutdown().await;
+    Ok(())
+}
