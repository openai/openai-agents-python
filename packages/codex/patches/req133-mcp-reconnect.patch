+#[tokio::test]
+async fn owned_stdio_shutdown_joins_a_reconnect_after_its_request_is_dropped() -> Result<()> {
+    use std::ffi::OsString;
+
+    use tokio::sync::Notify;
+
+    use crate::LocalStdioServerLauncher;
+
+    // Hold the second launch after spawn_blocking returns but before its
+    // process handle reaches the RMCP client.
+    struct GatedLauncher {
+        local: LocalStdioServerLauncher,
+        launches: AtomicUsize,
+        launched_replacement: Arc<Notify>,
+        release_replacement: Arc<Notify>,
+    }
+
+    impl crate::stdio_server_launcher::TestStdioServerLauncher for GatedLauncher {}
+
+    impl StdioServerLauncher for GatedLauncher {
+        fn launch(
+            &self,
+            command: StdioServerCommand,
+        ) -> BoxFuture<'static, io::Result<StdioServerTransport>> {
+            let launch = self.local.launch(command);
+            let replacement = self.launches.fetch_add(1, Ordering::Relaxed) == 1;
+            let launched = Arc::clone(&self.launched_replacement);
+            let release = Arc::clone(&self.release_replacement);
+            async move {
+                let transport = launch.await?;
+                if replacement {
+                    launched.notify_one();
+                    release.notified().await;
+                }
+                Ok(transport)
+            }
+            .boxed()
+        }
+    }
+
+    const SERVER: &str = r#"
+import json, os, pathlib, signal, sys
+signal.alarm(20)
+pathlib.Path(f'{os.getpid()}.pid').touch()
+for line in sys.stdin:
+    request = json.loads(line)
+    method = request.get('method')
+    if method == 'initialize':
+        print(json.dumps({'jsonrpc':'2.0','id':request['id'],'result':{
+            'protocolVersion':'2025-06-18','capabilities':{'tools':{}},
+            'serverInfo':{'name':'owned-reconnect','version':'1'}}}), flush=True)
+    elif method == 'tools/call':
+        with open('calls.log', 'a') as log:
+            log.write(request['params']['name'] + '\n')
+        os.close(sys.stdout.fileno())
+"#;
+
+    timeout(TEST_TIMEOUT, async {
+        let work = tempfile::tempdir()?;
+        let launcher = Arc::new(GatedLauncher {
+            local: LocalStdioServerLauncher::new(work.path().to_path_buf()),
+            launches: AtomicUsize::new(0),
+            launched_replacement: Arc::new(Notify::new()),
+            release_replacement: Arc::new(Notify::new()),
+        });
+        let client = RmcpClient::new_stdio_client(
+            "python3".into(),
+            ["-u", "-c", SERVER].map(OsString::from).into(),
+            None,
+            &[],
+            None,
+            launcher.clone(),
+        )
+        .await?
+        .with_owned_stdio_lifetime(true);
+        initialize(&client).await?;
+        let mut request = Box::pin(call(&client, "lost"));
+        tokio::select! {
+            result = &mut request => panic!("call completed before reconnect: {result:?}"),
+            () = launcher.launched_replacement.notified() => {}
+        }
+        drop(request);
+
+        let pids = loop {
+            let pids = std::fs::read_dir(work.path())?
+                .filter_map(|entry| {
+                    entry
+                        .ok()?
+                        .path()
+                        .file_stem()?
+                        .to_str()?
+                        .parse::<i32>()
+                        .ok()
+                })
+                .collect::<Vec<_>>();
+            if pids.len() == 2 {
+                break pids;
+            }
+            time::sleep(Duration::from_millis(10)).await;
+        };
+        let mut shutdown = Box::pin(client.shutdown_owned_stdio());
+        assert!(futures::poll!(&mut shutdown).is_pending());
+        drop(shutdown);
+        launcher.release_replacement.notify_one();
+        client.shutdown_owned_stdio().await?;
+
+        assert_eq!(
+            std::fs::read_to_string(work.path().join("calls.log"))?,
+            "lost\n"
+        );
+        for pid in pids {
+            assert!(
+                !std::process::Command::new("kill")
+                    .args(["-0", &pid.to_string()])
+                    .output()?
+                    .status
+                    .success(),
+                "owned MCP child {pid} was not reaped"
+            );
+        }
+        Ok(())
+    })
+    .await?
+}
