+async fn sdk_wire_connection() -> (
+    codex_api::RealtimeWebsocketConnection,
+    tokio::sync::mpsc::UnboundedReceiver<serde_json::Value>,
+    tokio::task::JoinHandle<()>,
+) {
+    use futures::StreamExt;
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let (tx, rx) = tokio::sync::mpsc::unbounded_channel();
+    let server = tokio::spawn(async move {
+        let (socket, _) = listener.accept().await.unwrap();
+        let mut websocket = tokio_tungstenite::accept_async(socket).await.unwrap();
+        while let Some(Ok(message)) = websocket.next().await {
+            if let tokio_tungstenite::tungstenite::Message::Text(text) = message {
+                tx.send(serde_json::from_str(&text).unwrap()).unwrap();
+            }
+        }
+    });
+    let provider = codex_api::Provider {
+        name: "SDK Realtime test".into(),
+        base_url: format!("http://{address}/v1"),
+        query_params: None,
+        headers: http::HeaderMap::new(),
+        retry: codex_api::RetryConfig {
+            max_attempts: 0,
+            base_delay: std::time::Duration::from_millis(1),
+            retry_429: false,
+            retry_5xx: false,
+            retry_transport: false,
+        },
+        stream_idle_timeout: std::time::Duration::from_secs(2),
+    };
+    let client = codex_api::RealtimeWebsocketClient::new(
+        provider,
+        codex_http_client::HttpClientFactory::new(
+            codex_http_client::OutboundProxyPolicy::ReqwestDefault,
+        ),
+    );
+    let connection = client
+        .connect(
+            codex_api::RealtimeSessionConfig {
+                instructions: String::new(),
+                initial_items: vec![],
+                delegation_ack_filler: None,
+                model: Some("test-model".into()),
+                session_id: None,
+                event_parser: RealtimeEventParser::RealtimeV2,
+                session_mode: codex_api::RealtimeSessionMode::Conversational,
+                output_modality: codex_protocol::protocol::RealtimeOutputModality::Audio,
+                voice: codex_protocol::protocol::RealtimeVoice::Marin,
+            },
+            http::HeaderMap::new(),
+            http::HeaderMap::new(),
+        )
+        .await
+        .unwrap();
+    (connection, rx, server)
+}
