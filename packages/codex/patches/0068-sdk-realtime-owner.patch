+#[tokio::test]
+async fn sdk_v2_writes_only_exact_accepted_result_and_deduplicates_cancel() {
+    use super::SdkRealtimeCommand;
+    let (connection, mut wire, server) = sdk_wire_connection().await;
+    // Initial session update is unrelated to delegated text acceptance.
+    assert_eq!(wire.recv().await.unwrap()["type"], "session.update");
+    let (manager, sdk) = sdk_manager("voice-1");
+    sdk.register("call-1").await.unwrap();
+    manager
+        .sdk_enqueue(
+            "voice-1",
+            SdkRealtimeCommand::Complete {
+                handoff_id: "call-1".into(),
+                text: "accepted repaired result".into(),
+            },
+        )
+        .await
+        .unwrap();
+    let mut responses = super::RealtimeResponseCreateQueue::default();
+    let handoff = manager
+        .state
+        .lock()
+        .await
+        .conversation
+        .as_ref()
+        .unwrap()
+        .handoff
+        .clone();
+    super::handle_sdk_realtime_command(
+        sdk.commands_rx.recv().await,
+        &connection.writer(),
+        &handoff,
+        &mut responses,
+    )
+    .await
+    .unwrap();
+    let output = wire.recv().await.unwrap();
+    assert_eq!(output["type"], "conversation.item.create");
+    assert_eq!(output["item"]["call_id"], "call-1");
+    assert_eq!(output["item"]["output"], "accepted repaired result");
+    assert_eq!(wire.recv().await.unwrap()["type"], "response.create");
+    // A user text item must schedule its own provider response through the queue.
+    responses.active_default_response = false;
+    super::handle_sdk_realtime_command(
+        Ok(SdkRealtimeCommand::Text(ConversationTextParams {
+            text: "next turn".into(),
+            role: ConversationTextRole::User,
+        })),
+        &connection.writer(),
+        &handoff,
+        &mut responses,
+    )
+    .await
+    .unwrap();
+    let text = wire.recv().await.unwrap();
+    assert_eq!(text["type"], "conversation.item.create");
+    assert_eq!(text["item"]["content"][0]["text"], "next turn");
+    assert_eq!(wire.recv().await.unwrap()["type"], "response.create");
+    // A finished frontend response can still have delegated native work running.
+    responses.sdk_response_id = None;
+    sdk.register("pending-after-done").await.unwrap();
+    super::handle_sdk_realtime_command(
+        Ok(SdkRealtimeCommand::Interrupt {
+            response_id: Some("stale".into()),
+        }),
+        &connection.writer(),
+        &handoff,
+        &mut responses,
+    )
+    .await
+    .unwrap();
+    assert!(sdk.pending.lock().await.contains_key("pending-after-done"));
+    super::handle_sdk_realtime_command(
+        Ok(SdkRealtimeCommand::Interrupt { response_id: None }),
+        &connection.writer(),
+        &handoff,
+        &mut responses,
+    )
+    .await
+    .unwrap();
+    assert!(sdk.pending.lock().await.is_empty());
+    responses.sdk_response_id = Some("new-response".into());
+    for response in ["old-response", "new-response", "new-response"] {
+        super::handle_sdk_realtime_command(
+            Ok(SdkRealtimeCommand::Interrupt {
+                response_id: Some(response.into()),
+            }),
+            &connection.writer(),
+            &handoff,
+            &mut responses,
+        )
+        .await
+        .unwrap();
+    }
+    let cancel = wire.recv().await.unwrap();
+    assert_eq!(cancel["type"], "response.cancel");
+    assert_eq!(cancel["response_id"], "new-response");
+    assert!(
+        tokio::time::timeout(std::time::Duration::from_millis(50), wire.recv())
+            .await
+            .is_err()
+    );
+    manager.shutdown_sdk("voice-1").await.unwrap();
+    connection.close().await.unwrap();
+    server.abort();
+}
