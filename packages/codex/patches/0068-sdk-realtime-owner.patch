+#[tokio::test]
+async fn sdk_close_joins_socket_pump_for_concurrent_callers() {
+    let (connection, mut wire, server) = sdk_wire_connection().await;
+    wire.recv().await.unwrap();
+    let writer = connection.writer();
+    let other = writer.clone();
+    tokio::join!(writer.abort_and_join(), other.abort_and_join());
+    assert!(writer.send_payload("{}".into()).await.is_err());
+    // The peer observes socket teardown before joined close has completed.
+    tokio::time::timeout(std::time::Duration::from_secs(1), server)
+        .await
+        .unwrap()
+        .unwrap();
+    writer.abort_and_join().await;
+}
