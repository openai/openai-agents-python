+        let bytes = message.as_ref().map_or(0, |message| message.len());
+        let permit = budget
+            .map(|budget| {
+                let bytes = u32::try_from(bytes).map_err(|_| ())?;
+                budget.try_acquire_many_owned(bytes).map_err(|_| ())
+            })
+            .transpose()?;
+        Ok(Self {
+            message,
+            _permit: permit,
+        })
+    }
+
