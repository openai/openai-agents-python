+    pub fn restrict_to(self, allowed: ToolExposures) -> Self {
+        match (
+            self.is_direct() && allowed.contains(ToolExposures::DIRECT),
+            self.is_deferred() && allowed.contains(ToolExposures::DEFERRED),
+            self.is_available_in_code_mode() && allowed.contains(ToolExposures::CODE_MODE),
