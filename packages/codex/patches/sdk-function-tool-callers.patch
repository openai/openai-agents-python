+#[cfg(test)]
+mod caller_policy_tests {
+    use super::{ToolExposure, ToolExposures};
+
+    #[test]
+    fn caller_masks_never_add_removed_surfaces() {
+        let exposures = [
+            ToolExposure::Direct,
+            ToolExposure::Deferred,
+            ToolExposure::DirectModelOnly,
+            ToolExposure::DeferredModelOnly,
+            ToolExposure::CodeModeOnly,
+            ToolExposure::Hidden,
+        ];
+        for exposure in exposures {
+            for bits in 0..=ToolExposures::ALL.bits() {
+                let mask = ToolExposures::from_bits_retain(bits);
+                let narrowed = exposure.restrict_to(mask);
+                assert!(
+                    !narrowed.is_direct()
+                        || exposure.is_direct() && mask.contains(ToolExposures::DIRECT)
+                );
+                assert!(
+                    !narrowed.is_deferred()
+                        || exposure.is_deferred() && mask.contains(ToolExposures::DEFERRED)
+                );
+                assert!(
+                    !narrowed.is_available_in_code_mode()
+                        || exposure.is_available_in_code_mode()
+                            && mask.contains(ToolExposures::CODE_MODE)
+                );
+            }
+        }
+        assert_eq!(
+            ToolExposure::Deferred.restrict_to(ToolExposures::CODE_MODE),
+            ToolExposure::CodeModeOnly
+        );
+        assert_eq!(
+            ToolExposure::Deferred.restrict_to(ToolExposures::DIRECT | ToolExposures::DEFERRED),
+            ToolExposure::DeferredModelOnly
+        );
+    }
+}
