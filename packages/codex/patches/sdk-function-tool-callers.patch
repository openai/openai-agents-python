+            (true, false, false) => Self::DirectModelOnly,
+            (true, false, true) => Self::Direct,
+            (false, true, false) => Self::DeferredModelOnly,
+            (false, true, true) => Self::Deferred,
+            (true, true, _) => unreachable!("direct and deferred exposure are exclusive"),
+        }
+    }
