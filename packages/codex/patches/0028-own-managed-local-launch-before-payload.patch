+#[cfg(target_os = "linux")]
+#[tokio::test]
+async fn interrupt_joins_owned_start_and_fences_late_acknowledgement() {
+    use std::io::Read;
+    use std::os::unix::net::UnixStream;
+
+    async fn managed_launch() -> (Arc<UnifiedExecProcess>, UnixStream) {
+        let (host, child) = UnixStream::pair().expect("create sandbox control socket");
+        child.set_nonblocking(true).expect("set nonblocking");
+        let spawned = codex_utils_pty::spawn_pipe_process_no_stdin(
+            "/bin/true",
+            &[],
+            std::path::Path::new("/"),
+            &HashMap::new(),
+            &None,
+            &[],
+        )
+        .await
+        .expect("spawn wrapper");
+        let process = Arc::new(UnifiedExecProcess::from_spawned_with_output_policy(
+            spawned,
+            codex_sandboxing::SandboxType::LinuxSeccomp,
+            Box::new(crate::unified_exec::NoopSpawnLifecycle),
+            /*controlled*/ false,
+            Some(host),
+        ));
+        (process, child)
+    }
+
+    let manager = UnifiedExecProcessManager::default();
+    let turn = Arc::new(codex_extension_api::ExtensionData::new("interrupted"));
+    let other = Arc::new(codex_extension_api::ExtensionData::new("other"));
+    let (owned_id, owned_generation) = manager
+        .allocate_process_id(&turn)
+        .await
+        .expect("reserve process id");
+    let (late_id, late_generation) = manager
+        .allocate_process_id(&turn)
+        .await
+        .expect("reserve process id");
+    let (other_id, other_generation) = manager
+        .allocate_process_id(&other)
+        .await
+        .expect("reserve process id");
+    let (owned, mut owned_socket) = managed_launch().await;
+    let (late, mut late_socket) = managed_launch().await;
+    let (unrelated, mut unrelated_socket) = managed_launch().await;
+    {
+        let mut store = manager.process_store.lock().await;
+        store
+            .start_managed_process(owned_id, &owned_generation, &turn, &owned)
+            .expect("start owned");
+        store
+            .start_managed_process(other_id, &other_generation, &other, &unrelated)
+            .expect("start unrelated");
+    }
+    let mut start = [0];
+    owned_socket.read_exact(&mut start).expect("owned START");
+    assert_eq!(start, [1]);
+    unrelated_socket
+        .read_exact(&mut start)
+        .expect("unrelated START");
+    assert_eq!(start, [1]);
+
+    assert!(manager.join_unreturned_local_commands(&turn).await);
+    assert!(manager.allocate_process_id(&turn).await.is_none());
+    assert_eq!(owned_socket.read(&mut start).expect("owned EOF"), 0);
+    let mut store = manager.process_store.lock().await;
+    assert!(!store.starting_processes.contains_key(&owned_id));
+    assert!(!store.reserved_process_ids.contains_key(&owned_id));
+    assert!(!store.reserved_process_ids.contains_key(&late_id));
+    assert!(store.owns_reservation(other_id, &other_generation));
+    assert!(
+        store
+            .start_managed_process(late_id, &late_generation, &turn, &late)
+            .is_err()
+    );
+    drop(store);
+    assert_eq!(
+        late_socket
+            .read(&mut start)
+            .expect_err("late payload remains gated")
+            .kind(),
+        std::io::ErrorKind::WouldBlock
+    );
+    assert_eq!(
+        unrelated_socket
+            .read(&mut start)
+            .expect_err("unrelated launch stays live")
+            .kind(),
+        std::io::ErrorKind::WouldBlock
+    );
+
+    manager
+        .release_initial_process_id(other_id, &other_generation)
+        .await;
+    assert_eq!(
+        unrelated_socket
+            .read(&mut start)
+            .expect("abandoned startup EOF"),
+        0
+    );
+
+    let mut store = manager.process_store.lock().await;
+    let replacement_generation = Arc::new(());
+    store.reserved_process_ids.insert(
+        owned_id,
+        ProcessIdReservation {
+            generation: Arc::clone(&replacement_generation),
+            turn: Arc::downgrade(&other),
+        },
+    );
+    store
+        .start_managed_process(owned_id, &replacement_generation, &other, &late)
+        .expect("replace retired owner");
+    assert!(!store.remove_starting_process(owned_id, &owned));
+    drop(store);
+    late_socket
+        .read_exact(&mut start)
+        .expect("replacement START");
+    assert_eq!(start, [1]);
+    manager
+        .release_initial_process_id(owned_id, &owned_generation)
+        .await;
+    assert_eq!(
+        late_socket
+            .read(&mut start)
+            .expect_err("old reservation leaves replacement live")
+            .kind(),
+        std::io::ErrorKind::WouldBlock,
+    );
+    manager
+        .release_initial_process_id(owned_id, &replacement_generation)
+        .await;
+    assert_eq!(late_socket.read(&mut start).expect("replacement EOF"), 0);
+    let store = manager.process_store.lock().await;
+    assert!(!store.starting_processes.contains_key(&owned_id));
+    assert!(!store.reserved_process_ids.contains_key(&owned_id));
+}
