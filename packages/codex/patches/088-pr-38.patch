+// Source history retains its audit facts. Only its derived presentation archives
+// completed approval pairs, matching the SDK portable-import replay policy.
+fn handoff_source_values(
+    approved: &std::collections::HashSet<String>,
+    selected: &[&ResponseItem],
+) -> CodexResult<Vec<serde_json::Value>> {
+    selected
+        .iter()
+        .filter(|item| match item {
+            ResponseItem::Message { role, .. } => role == "user" || role == "assistant",
+            ResponseItem::McpApprovalRequest { id: Some(id), .. } => {
+                !approved.contains(id.as_str())
+            }
+            ResponseItem::McpApprovalResponse {
+                approval_request_id,
+                ..
+            } => !approved.contains(approval_request_id.as_str()),
+            _ => true,
+        })
+        .map(|item| serde_json::to_value(item).map_err(|error| invalid(error.to_string())))
+        .collect()
+}
+
+fn retains_publication(items: &[ResponseItemEnvelope], publication: &ResponseItem) -> bool {
+    let Some(id) = publication.id() else {
+        return false;
+    };
+    let mut matching = items.iter().filter(|item| item.item.id() == Some(id));
+    matching
+        .next()
+        .is_some_and(|item| item.item == *publication)
+        && matching.next().is_none()
+}
