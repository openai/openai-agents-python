+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn interrupting_regular_error_publication_uses_the_abort_owner() {
+    use crate::session::turn::ReportedTurnError;
+    use tokio::sync::Notify;
+
+    struct ErrorGate {
+        entered: Arc<Notify>,
+        release: Arc<Notify>,
+    }
+    impl codex_extension_api::TurnLifecycleContributor for ErrorGate {
+        fn on_turn_error<'a>(
+            &'a self,
+            _input: codex_extension_api::TurnErrorInput<'a>,
+        ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+            Box::pin(async move {
+                self.entered.notify_one();
+                self.release.notified().await;
+            })
+        }
+    }
+    struct Dropped(Arc<Notify>);
+    impl Drop for Dropped {
+        fn drop(&mut self) {
+            self.0.notify_one();
+        }
+    }
+    struct ObservedRegularTask(Arc<Notify>);
+    impl SessionTask for ObservedRegularTask {
+        fn kind(&self) -> TaskKind {
+            TaskKind::Regular
+        }
+        fn span_name(&self) -> &'static str {
+            "test.regular_error_publication"
+        }
+        async fn run(
+            self: Arc<Self>,
+            session: Arc<Session>,
+            turn: Arc<TurnContext>,
+            input: Vec<TurnInput>,
+            cancellation: CancellationToken,
+        ) -> SessionTaskResult {
+            let _dropped = Dropped(Arc::clone(&self.0));
+            Arc::new(crate::tasks::RegularTask::new())
+                .run(session, turn, input, cancellation)
+                .await
+        }
+    }
+
+    tokio::time::timeout(Duration::from_secs(30), async {
+        for hold_delivery in [false, true] {
+            let (server, _) = start_streaming_sse_server(vec![vec![StreamingSseChunk {
+                gate: None,
+                body: responses::sse_failed(
+                    "bounded-error-response",
+                    "server_error",
+                    "bounded fixture failure",
+                ),
+            }]])
+            .await;
+            let mut provider = built_in_model_providers(None)["openai"].clone();
+            provider.base_url = Some(format!("{}/v1", server.uri()));
+            provider.supports_websockets = false;
+            provider.request_max_retries = Some(0);
+            provider.stream_max_retries = Some(0);
+            let uri = server.uri().to_string();
+            let (mut session, turn, _) = make_session_and_context_with_auth_and_config_and_rx(
+                CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+                Vec::new(),
+                move |config| {
+                    config.model = Some("gpt-5.2".to_string());
+                    config.model_provider = provider;
+                    config.chatgpt_base_url = uri;
+                    let _ = config.features.disable(Feature::TokenBudget);
+                    let _ = config.features.disable(Feature::EnableRequestCompression);
+                },
+            )
+            .await;
+            let entered = Arc::new(Notify::new());
+            let release = Arc::new(Notify::new());
+            let dropped = Arc::new(Notify::new());
+            let mut builder = codex_extension_api::ExtensionRegistryBuilder::<Config>::new();
+            builder.turn_lifecycle_contributor(Arc::new(ErrorGate {
+                entered: Arc::clone(&entered),
+                release: Arc::clone(&release),
+            }));
+            // A bounded event channel lets the test hold Error delivery without
+            // replacing send_event or constructing a publication marker itself.
+            let (tx, events) = async_channel::bounded(1);
+            let inner = Arc::get_mut(&mut session).expect("unshared test session");
+            inner.services.extensions = Arc::new(builder.build());
+            inner.tx_event = tx;
+            session
+                .spawn_task(
+                    Arc::clone(&turn),
+                    vec![TurnInput::UserInput {
+                        metadata: Default::default(),
+                        content: vec![UserInput::Text {
+                            text: "fail one real sampling request".to_string(),
+                            text_elements: Vec::new(),
+                        }],
+                        client_id: None,
+                    }],
+                    ObservedRegularTask(Arc::clone(&dropped)),
+                )
+                .await;
+            let mut observed = Vec::new();
+            loop {
+                tokio::select! {
+                    _ = entered.notified() => break,
+                    event = events.recv() => observed.push(event.expect("turn event").msg),
+                }
+            }
+            while let Ok(event) = events.try_recv() {
+                observed.push(event.msg);
+            }
+            if hold_delivery {
+                session
+                    .tx_event
+                    .try_send(Event {
+                        id: turn.sub_id.clone(),
+                        msg: EventMsg::Warning(WarningEvent {
+                            message: "test delivery gate".to_string(),
+                        }),
+                    })
+                    .expect("fill the single event slot while lifecycle is held");
+                release.notify_one();
+                // send_event sets status before its awaited publication path.
+                // The full channel prevents that Error from reaching its receiver.
+                while turn.terminal_error.lock().await.is_none() {
+                    tokio::task::yield_now().await;
+                }
+            }
+            assert!(turn.extension_data.get::<ReportedTurnError>().is_none());
+            let abort = tokio::spawn({
+                let session = Arc::clone(&session);
+                async move {
+                    session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+                }
+            });
+            // Wait for the actual RegularTask future to drop before opening
+            // delivery; it must not publish a late Error when capacity returns.
+            dropped.notified().await;
+            assert!(turn.extension_data.get::<ReportedTurnError>().is_none());
+            loop {
+                let event = events.recv().await.expect("abort owner event");
+                let terminal = matches!(event.msg, EventMsg::TurnAborted(_));
+                observed.push(event.msg);
+                if terminal {
+                    break;
+                }
+            }
+            abort.await.expect("joined abort owner");
+            while let Ok(event) = events.try_recv() {
+                observed.push(event.msg);
+            }
+            assert_eq!(
+                observed
+                    .iter()
+                    .filter(|event| matches!(event, EventMsg::Error(_)))
+                    .count(),
+                0
+            );
+            assert_eq!(
+                observed
+                    .iter()
+                    .filter(|event| matches!(event, EventMsg::TurnComplete(_)))
+                    .count(),
+                0
+            );
+            assert_eq!(
+                observed
+                    .iter()
+                    .filter(|event| matches!(event, EventMsg::TurnAborted(_)))
+                    .count(),
+                1
+            );
+            assert_eq!(server.requests().await.len(), 1);
+            assert!(session.active_turn.lock().await.is_none());
+            server.shutdown().await;
+        }
+    })
+    .await
+    .expect("bounded real publication cancellation must settle");
+}
