+/// Exercise finalization's observable event/lifecycle ownership separately from
+/// the binding's strict real observation-append failure tests.
+#[tokio::test]
+async fn finalization_preserves_only_a_completed_regular_error_publication() {
+    use crate::session::turn::ReportedTurnError;
+    use codex_protocol::protocol::EventMsg;
+
+    struct Recorder {
+        errors: Arc<std::sync::Mutex<usize>>,
+        idle: Arc<std::sync::Mutex<Vec<codex_extension_api::ThreadIdleCause>>>,
+    }
+    impl codex_extension_api::TurnLifecycleContributor for Recorder {
+        fn on_turn_error<'a>(
+            &'a self,
+            _input: codex_extension_api::TurnErrorInput<'a>,
+        ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+            Box::pin(async move {
+                *self.errors.lock().unwrap() += 1;
+            })
+        }
+    }
+    impl codex_extension_api::ThreadLifecycleContributor<crate::config::Config> for Recorder {
+        fn on_thread_idle<'a>(
+            &'a self,
+            input: codex_extension_api::ThreadIdleInput<'a>,
+        ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+            Box::pin(async move {
+                self.idle.lock().unwrap().push(input.cause);
+            })
+        }
+    }
+
+    tokio::time::timeout(std::time::Duration::from_secs(15), async {
+        // (prior error event, completed owner publication): a status marker alone
+        // must not suppress the first required finalization lifecycle callback.
+        // A marker without a terminal payload must not suppress one either.
+        for (prior_event, marker) in [(false, false), (true, false), (true, true), (false, true)] {
+            let reported = prior_event && marker;
+            let (mut session, turn, receiver) = make_session_and_context_with_rx().await;
+            let errors = Arc::new(std::sync::Mutex::new(0));
+            let idle = Arc::new(std::sync::Mutex::new(Vec::new()));
+            let recorder = Arc::new(Recorder {
+                errors: Arc::clone(&errors),
+                idle: Arc::clone(&idle),
+            });
+            let mut builder =
+                codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+            builder.turn_lifecycle_contributor(recorder.clone());
+            builder.thread_lifecycle_contributor(recorder);
+            Arc::get_mut(&mut session).unwrap().services.extensions = Arc::new(builder.build());
+            session
+                .spawn_task(Arc::clone(&turn), Vec::new(), PendingTask)
+                .await;
+            let primary = CodexErr::InvalidRequest("primary failure".to_string());
+            let primary_event = primary.to_error_event(None);
+            if reported {
+                session
+                    .emit_turn_error_lifecycle(
+                        &turn,
+                        primary.to_codex_protocol_error(),
+                        primary.details(),
+                    )
+                    .await;
+                session.track_turn_codex_error(&turn, &primary);
+            }
+            if prior_event {
+                session
+                    .send_event(&turn, EventMsg::Error(primary_event.clone()))
+                    .await;
+            }
+            if marker {
+                turn.extension_data.insert(ReportedTurnError);
+            }
+            let final_error = CodexErr::Fatal("finalization failure".to_string());
+            let final_event = final_error.to_error_event(None);
+            session
+                .on_task_finished(Arc::clone(&turn), Err(final_error))
+                .await;
+            let mut events = Vec::new();
+            while let Ok(event) = receiver.try_recv() {
+                events.push(event.msg);
+            }
+            let observed = events
+                .iter()
+                .filter_map(|event| match event {
+                    EventMsg::Error(error) => Some(error.message.as_str()),
+                    _ => None,
+                })
+                .collect::<Vec<_>>();
+            let expected = if reported {
+                vec![primary_event.message.as_str()]
+            } else if prior_event {
+                vec![primary_event.message.as_str(), final_event.message.as_str()]
+            } else {
+                vec![final_event.message.as_str()]
+            };
+            assert_eq!(observed, expected);
+            let terminals = events
+                .iter()
+                .filter_map(|event| match event {
+                    EventMsg::TurnComplete(event) => Some(event),
+                    _ => None,
+                })
+                .collect::<Vec<_>>();
+            assert_eq!(terminals.len(), 1);
+            let expected_terminal = if reported {
+                &primary_event.message
+            } else {
+                &final_event.message
+            };
+            assert_eq!(
+                &terminals[0].error.as_ref().unwrap().message,
+                expected_terminal
+            );
+            assert_eq!(*errors.lock().unwrap(), 1);
+            assert_eq!(
+                *idle.lock().unwrap(),
+                vec![codex_extension_api::ThreadIdleCause::Failed]
+            );
+
+            if reported {
+                // A genuinely new turn in the same session must publish its own
+                // failure, even though the previous context stays alive here.
+                let next = session
+                    .new_turn_with_default_settings(
+                        "following-turn".to_string(),
+                        Default::default(),
+                    )
+                    .await;
+                session
+                    .spawn_task(Arc::clone(&next), Vec::new(), PendingTask)
+                    .await;
+                let next_error = CodexErr::Fatal("new turn failure".to_string());
+                let next_message = next_error.to_error_event(None).message;
+                session.on_task_finished(next, Err(next_error)).await;
+                let mut next_errors = Vec::new();
+                let mut next_terminals = 0;
+                while let Ok(event) = receiver.try_recv() {
+                    match event.msg {
+                        EventMsg::Error(error) => next_errors.push(error.message),
+                        EventMsg::TurnComplete(event) => {
+                            next_terminals += 1;
+                            assert_eq!(event.error.unwrap().message, next_message);
+                        }
+                        _ => {}
+                    }
+                }
+                assert_eq!(next_errors, vec![next_message]);
+                assert_eq!(next_terminals, 1);
+                assert_eq!(*errors.lock().unwrap(), 2);
+            }
+        }
+    })
+    .await
+    .expect("finalization ownership checks must finish");
+}
