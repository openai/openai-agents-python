+    #[test]
+    fn raw_edits_keep_model_only_rows_without_admitting_them_as_originals() {
+        let row = |id: &str, role: &str| {
+            ResponseItemEnvelope::new(
+                serde_json::from_value(json!({
+                    "type":"message", "id":id, "role":role,
+                    "content":[{"type":"input_text", "text":id}]
+                }))
+                .unwrap(),
+            )
+        };
+        let configuration = row("config", "developer");
+        let user = row("user", "user");
+        let assistant = row("assistant", "assistant");
+        let model_only = |row: &ResponseItemEnvelope| row == &configuration;
+        let mut history = SdkOriginalHistory::default();
+        for item in [&user, &assistant] {
+            history.append(SdkOriginalItem::from_native(item.clone()));
+        }
+        let current = vec![configuration.clone(), user.clone(), assistant];
+        let pop = history.prepare_pop_preserving(&current, false, model_only).unwrap().unwrap();
+        assert_eq!(pop.projection, vec![configuration.clone(), user]);
+        assert!(!pop.rebuilt_context);
+        let final_pop = pop.originals.prepare_pop_preserving(&pop.projection, false, model_only)
+            .unwrap().unwrap();
+        assert_eq!(final_pop.projection, vec![configuration]);
+        assert!(!final_pop.rebuilt_context);
+    }
+
+    #[test]
+    fn filtered_publications_keep_the_cold_pop_window_proof() {
+        let envelope = |id: &str, role: &str| {
+            ResponseItemEnvelope::new(
+                serde_json::from_value(json!({
+                    "type":"message", "id":id, "role":role,
+                    "content":[{"type":"input_text", "text":id}]
+                }))
+                .unwrap(),
+            )
+        };
+        let summary = envelope("summary", "user");
+        let before_config = envelope("before-configuration", "developer");
+        let after_config = envelope("after-configuration", "developer");
+        let late_user = envelope("late-user", "user");
+        let answer = envelope("late-answer", "assistant");
+        let replay = |records: &[crate::RolloutItem]| {
+            SdkOriginalHistory::replay_with_original_filter(
+                records,
+                |row| Some(row.clone()),
+                |row| !matches!(&row.item, ResponseItem::Message { role, .. } if role == "developer"),
+                |items, _| items.to_vec(),
+            )
+        };
+        for legacy in [false, true] {
+            let mut checkpoint: crate::RolloutItem = serde_json::from_value(json!({
+                "type":"compacted", "payload":{"message":"summary"}
+            }))
+            .unwrap();
+            let crate::RolloutItem::Compacted(payload) = &mut checkpoint else {
+                panic!("checkpoint")
+            };
+            if !legacy {
+                payload.sdk_originals =
+                    Some(SdkOriginalHistoryCheckpoint::Preserve { preserve: true });
+            }
+            payload.replacement_history = Some(vec![summary.clone(), before_config.clone()]);
+            let mut records = vec![
+                crate::RolloutItem::ResponseItem(envelope("covered-user", "user")),
+                checkpoint.clone(),
+                crate::RolloutItem::ResponseItem(after_config.clone()),
+                crate::RolloutItem::ResponseItem(late_user.clone()),
+                crate::RolloutItem::ResponseItem(answer.clone()),
+            ];
+            let history = replay(&records);
+            assert_eq!(history.items.len(), 3);
+            assert!(
+                history
+                    .items
+                    .iter()
+                    .all(|row| { !row.original.contains("configuration") })
+            );
+            let current = vec![
+                summary.clone(),
+                before_config.clone(),
+                after_config.clone(),
+                late_user.clone(),
+                answer.clone(),
+            ];
+            let first = history.prepare_pop(&current, false).unwrap().unwrap();
+            let crate::RolloutItem::Compacted(payload) = &mut checkpoint else {
+                panic!("checkpoint")
+            };
+            payload.sdk_originals = Some(first.originals.into());
+            payload.replacement_history = Some(first.projection.clone());
+            records.push(checkpoint.clone());
+            let cold = replay(
+                &serde_json::from_slice::<Vec<crate::RolloutItem>>(
+                    &serde_json::to_vec(&records).unwrap(),
+                )
+                .unwrap(),
+            );
+            assert_eq!(cold.post_checkpoint_start, Some(1));
+            let second = cold.prepare_pop(&first.projection, false).unwrap().unwrap();
+            assert!(!second.rebuilt_context);
+            assert_eq!(
+                second.projection,
+                vec![summary.clone(), before_config.clone(), after_config.clone()]
+            );
+            records.push(crate::RolloutItem::EventMsg(
+                codex_protocol::protocol::EventMsg::ThreadRolledBack(
+                    codex_protocol::protocol::ThreadRolledBackEvent { num_turns: 0 },
+                ),
+            ));
+            let rolled_back = replay(&records);
+            assert_eq!(rolled_back.post_checkpoint_start, None);
+            assert!(rolled_back.prepare_pop(&first.projection, false).is_err());
+        }
+    }
