+    fn equal_payloads_and_repeated_acknowledgment_keep_exact_positions() {
+        let row = item("same");
+        let batch = StagedInputBatch::selected_after_terminal("turn".into(), vec![row.clone(), row.clone()]);
+        let shared = batch.clone();
+        assert!(batch.pending_occurrences_for("other").is_empty());
+        batch.acknowledge_occurrences(&[1, 1]).unwrap();
+        shared.acknowledge_occurrences(&[1]).unwrap();
+        assert_eq!(batch.pending_occurrences_for("turn"), vec![(0, row)]);
+        assert!(batch.is_pending());
+        batch.acknowledge_occurrences(&[0]).unwrap();
+        assert!(!shared.is_pending());
+    }
