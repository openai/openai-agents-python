+
+type WriteJoin = Shared<BoxFuture<'static, Result<(), String>>>;
+
+/// Native request identity. Only Sources can mint one; request collection can
+/// retain a clone without identifying a request by provider-supplied text.
+#[derive(Clone, Debug)]
+pub(crate) struct SourcesOwner(Arc<()>);
+
+impl SourcesOwner {
+    pub(crate) fn matches(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.0, &other.0)
+    }
+}
+
+/// Core installs this exact request view before the client starts collecting
+/// the response. It must not reuse the slot for another in-flight request.
+pub(crate) struct SampledSources(pub(crate) Arc<Sources>);
+
+/// One turn owns one original batch and one prepared identity for each row.
+#[derive(Default)]
+struct PendingWrites {
+    owners: Mutex<Vec<Weak<Pending>>>,
+    failure: Mutex<Option<String>>,
+}
+
+struct Pending {
+    session: Weak<Session>,
+    turn: Weak<TurnContext>,
+    batch: Arc<StagedInputBatch>,
+    prepared: OnceCell<Arc<Vec<ResponseItemEnvelope>>>,
+    settlement: AsyncMutex<()>,
+    write: Mutex<Option<WriteJoin>>,
+}
+
+/// One sampled request owns a frozen projection and its eventual terminal write.
+/// Equal message text does not identify an occurrence.
+pub(crate) struct Sources {
+    owner: SourcesOwner,
+    pending: Arc<Pending>,
+    model_info: Arc<ModelInfo>,
+    input: Vec<ResponseItem>,
+    base_len: usize,
+    entries: Vec<(usize, usize)>,
+    selected: OnceLock<Vec<usize>>,
+    origins: OnceLock<Vec<Option<usize>>>,
+    outputs: Mutex<Vec<ResponseItemEnvelope>>,
+    facts: Mutex<Vec<crate::stream_events_utils::DeferredResponseFacts>>,
+    error: Mutex<Option<String>>,
+    write: Mutex<Option<WriteJoin>>,
+    accepted: Arc<AtomicBool>,
+}
+
+impl Sources {
+    pub(crate) fn owner(&self) -> SourcesOwner {
+        self.owner.clone()
+    }
+
+    /// Compose against native origins after every contributor has run. Callers
+    /// validate each immediate source map with staged_input_sources::compose.
+    pub(crate) fn select(&self, origins: &[Option<usize>]) -> Result<(), String> {
+        if let Some(existing) = self.origins.get() {
+            return if existing == origins {
+                Ok(())
+            } else {
+                Err("The current request has changed its frozen source map".into())
+            };
+        }
+        let mut seen = HashSet::new();
+        for index in origins.iter().flatten().copied() {
+            let Some(item) = self.input.get(index) else {
+                return Err("Staged source is outside its sampled request".into());
+            };
+            let protected = self.entries.iter().any(|(source, _)| *source == index)
+                || matches!(item, ResponseItem::Message { role, .. } if role == "user");
+            if protected && !seen.insert(index) {
+                return Err("One original user occurrence was sampled twice".into());
+            }
+        }
+        let selected = self
+            .entries
+            .iter()
+            .filter(|(source, _)| origins.contains(&Some(*source)))
+            .map(|(_, ordinal)| *ordinal)
+            .collect::<Vec<_>>();
+        if let Some(existing) = self.selected.get() {
+            return if *existing == selected {
+                Ok(())
+            } else {
+                Err("A sampled staged projection cannot change".into())
+            };
+        }
+        self.origins
+            .set(origins.to_vec())
+            .map_err(|_| "The current request source map changed concurrently".to_string())?;
+        match self.selected.set(selected) {
+            Ok(()) => Ok(()),
+            Err(selected) if self.selected.get() == Some(&selected) => Ok(()),
+            Err(_) => Err("A sampled staged projection changed concurrently".into()),
+        }
+    }
+
+    /// Build the prospective cursor window without accepting it. Only selected
+    /// rows enter this window, in original occurrence order.
+    pub(crate) fn prospective_input(
+        &self,
+        origins: &[Option<usize>],
+    ) -> Result<(Vec<ResponseItem>, Vec<Option<usize>>), String> {
+        let selected = self
+            .selected
+            .get()
+            .ok_or("Staged sources have not been selected")?;
+        let mut canonical = self.input[..self.base_len].to_vec();
+        let mut rebased = (0..self.input.len())
+            .map(|index| (index < self.base_len).then_some(index))
+            .collect::<Vec<_>>();
+        for (source, ordinal) in &self.entries {
+            if selected.contains(ordinal) {
+                rebased[*source] = Some(canonical.len());
+                canonical.push(self.input[*source].clone());
+            }
+        }
+        let wire_origins = origins
+            .iter()
+            .map(|origin| match origin {
+                None => Ok(None),
+                Some(index) => rebased
+                    .get(*index)
+                    .copied()
+                    .flatten()
+                    .map(Some)
+                    .ok_or_else(|| "Wire source was not selected".to_string()),
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        Ok((canonical, wire_origins))
+    }
+
+    pub(crate) fn base_input(&self) -> &[ResponseItem] {
+        &self.input[..self.base_len]
+    }
+
+    pub(crate) fn staged_origins(&self) -> HashSet<usize> {
+        self.entries.iter().map(|(source, _)| *source).collect()
+    }
+
+    pub(crate) fn current_projection(
+        &self,
+    ) -> Result<(Vec<ResponseItem>, Vec<Option<usize>>), String> {
+        self.prospective_input(
+            self.origins
+                .get()
+                .ok_or("The current request has no frozen source map")?,
+        )
+    }
+
+    pub(crate) async fn accept_queued(
+        &self,
+        terminal: ProviderHistoryTerminal,
+    ) -> Result<(), String> {
+        if let Some(error) = self
+            .error
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone()
+        {
+            return Err(error);
+        }
+        let outputs = std::mem::take(
+            &mut *self
+                .outputs
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner),
+        );
+        self.accept_terminal(terminal, outputs).await
+    }
+
+    pub(crate) fn terminal_accepted(&self) -> bool {
+        self.accepted.load(Ordering::Acquire)
+    }
+
+    /// Completed model rows have already notified raw-item observers. The caller
+    /// supplies their exact prepared envelopes; this write does not mint IDs.
+    /// A current native terminal receipt is required before any history mutation.
+    pub(crate) async fn accept_terminal(
+        &self,
+        terminal: ProviderHistoryTerminal,
+        outputs: Vec<ResponseItemEnvelope>,
+    ) -> Result<(), String> {
+        if !terminal.belongs_to(&self.owner) {
+            return Err("Provider terminal belongs to another sampled projection".into());
+        }
+        let _settlement = self.pending.settlement.lock().await;
+        if self
+            .write
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .is_some()
+        {
+            return Err("This sampled request already owns a terminal write".into());
+        }
+        let previous = self
+            .pending
+            .write
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone();
+        if let Some(previous) = previous {
+            previous.await?;
+        }
+        let selected = self
+            .selected
+            .get()
+            .ok_or("Staged sources have not been selected")?
+            .clone();
+        let session = self
+            .pending
+            .session
+            .upgrade()
+            .ok_or("Staged source session has closed")?;
+        let turn = self
+            .pending
+            .turn
+            .upgrade()
+            .ok_or("Staged source turn has closed")?;
+        let remaining = self
+            .pending
+            .batch
+            .pending_occurrences_for(&turn.sub_id)
+            .into_iter()
+            .map(|(ordinal, _)| ordinal)
+            .collect::<HashSet<_>>();
+        if selected.iter().any(|ordinal| !remaining.contains(ordinal)) {
+            return Err("Another request has already accepted a selected occurrence".into());
+        }
+        let prepared = self
+            .pending
+            .prepared
+            .get()
+            .ok_or("Staged rows have not been prepared")?;
+        let mut items = selected
+            .iter()
+            .map(|ordinal| prepared[*ordinal].clone())
+            .collect::<Vec<_>>();
+        let accepted_inputs = items
+            .iter()
+            .map(|envelope| envelope.item.clone())
+            .collect::<Vec<_>>();
+        items.extend(outputs);
+        let batch = Arc::clone(&self.pending.batch);
+        let model_info = Arc::clone(&self.model_info);
+        let accepted = Arc::clone(&self.accepted);
+        let facts = std::mem::take(
+            &mut *self
+                .facts
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner),
+        );
+        // The runtime owns this write after spawn. Dropping a request future
+        // cannot orphan accepted effects or make capture race the cursor write.
+        self.pending.batch.begin_terminal_write()?;
+        let completion_batch = Arc::clone(&self.pending.batch);
+        let registry = session.services.thread_extension_data.get_or_init(PendingWrites::default);
+        let task = tokio::spawn(async move {
+            session
+                .record_prepared_conversation_items_with_observations(
+                    &turn,
+                    &model_info,
+                    items,
+                    Vec::new(),
+                    None,
+                    false,
+                )
+                .await;
+            session
+                .ensure_rollout_durable()
+                .await
+                .map_err(|error| error.to_string())?;
+            terminal.accept().await.map_err(|error| error.to_string())?;
+            batch.acknowledge_occurrences(&selected)?;
+            accepted.store(true, Ordering::Release);
+            session
+                .send_raw_response_items(&turn, &accepted_inputs)
+                .await;
+            for fact in facts {
+                fact.publish(&session, &turn).await;
+            }
+            session
+                .ensure_rollout_durable()
+                .await
+                .map_err(|error| error.to_string())
+        });
+        let write = async move {
+            let result = match task.await {
+                Ok(result) => result,
+                Err(error) => Err(format!("Staged terminal writer failed: {error}")),
+            };
+            completion_batch.finish_terminal_write(result.is_ok());
+            if let Err(error) = &result {
+                registry.failure.lock().unwrap_or_else(std::sync::PoisonError::into_inner)
+                    .get_or_insert_with(|| error.clone());
+            }
+            result
+        }
+        .boxed()
+        .shared();
+        *self
+            .write
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = Some(write.clone());
+        *self
+            .pending
+            .write
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = Some(write.clone());
+        write.await
+    }
+}
+
+/// Append detached prepared copies to the sampled prompt. Neither history nor
+/// the acknowledgment mask changes here.
+pub(crate) async fn append(
+    session: &Arc<Session>,
+    step: &StepContext,
+    batch: &Arc<StagedInputBatch>,
+    input: &mut Vec<ResponseItem>,
+) -> Result<Arc<Sources>, String> {
+    if !batch.projects_occurrences() {
+        return Err("The staged batch has no terminal occurrence owner".into());
+    }
+    let pending = step.turn.extension_data.get_or_init(|| Pending {
+        session: Arc::downgrade(session),
+        turn: Arc::downgrade(&step.turn),
+        batch: Arc::clone(batch),
+        prepared: OnceCell::new(),
+        settlement: AsyncMutex::new(()),
+        write: Mutex::new(None),
+    });
+    if !Arc::ptr_eq(&pending.batch, batch) {
+        return Err("The turn already owns another staged batch".into());
+    }
+    let registry = session
+        .services
+        .thread_extension_data
+        .get_or_init(PendingWrites::default);
+    {
+        let mut owners = registry
+            .owners
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        owners.retain(|owner| owner.strong_count() > 0);
+        let weak = Arc::downgrade(&pending);
+        if !owners.iter().any(|owner| Weak::ptr_eq(owner, &weak)) {
+            owners.push(weak);
+        }
+    }
+    let _settlement = pending.settlement.lock().await;
+    let previous = pending
+        .write
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone();
+    if let Some(previous) = previous {
+        previous.await?;
+    }
+    let prepared = pending
+        .prepared
+        .get_or_try_init(|| async {
+            let originals = batch
+                .items_for(&step.turn.sub_id)
+                .ok_or("The staged batch does not belong to this pending turn")?;
+            // This first owner does not perform image/file preparation before a
+            // provider accepts the request. Broader media routes retain their gates.
+            if originals.iter().any(|item| {
+                !matches!(
+                    item, ResponseItem::Message { role, content, .. }
+                    if role == "user" && content.iter().all(|part|
+                        matches!(part, ContentItem::InputText { .. }))
+                )
+            }) {
+                return Err(
+                    "Terminal staged admission currently requires text user rows".to_string(),
+                );
+            }
+            let annotated = originals
+                .iter()
+                .cloned()
+                .map(|item| session.annotate_client_response_item(item))
+                .collect();
+            let (prepared, images) = session
+                .prepare_annotated_conversation_items_for_history(
+                    &step.turn,
+                    &step.settings.model_info,
+                    annotated,
+                )
+                .await;
+            if prepared.len() != originals.len() || !images.is_empty() {
+                return Err("Staged preparation changed native occurrence boundaries".into());
+            }
+            Ok(Arc::new(prepared))
+        })
+        .await?;
+    let base_len = input.len();
+    let mut entries = Vec::new();
+    for (ordinal, _) in batch.pending_occurrences_for(&step.turn.sub_id) {
+        entries.push((input.len(), ordinal));
+        input.push(prepared[ordinal].item.clone());
+    }
+    Ok(Arc::new(Sources {
+        owner: SourcesOwner(Arc::new(())),
+        pending: Arc::clone(&pending),
+        model_info: Arc::clone(&step.settings.model_info),
+        input: input.clone(),
+        base_len,
+        entries,
+        selected: OnceLock::new(),
+        origins: OnceLock::new(),
+        outputs: Mutex::new(Vec::new()),
+        facts: Mutex::new(Vec::new()),
+        error: Mutex::new(None),
+        write: Mutex::new(None),
+        accepted: Arc::new(AtomicBool::new(false)),
+    }))
+}
+
+/// Capture, cancellation and subsequent sampling must join this owner before
+/// they export a pending mask or inspect canonical provider history.
+pub(crate) async fn join(turn: &TurnContext) -> Result<(), String> {
+    let Some(pending) = turn.extension_data.get::<Pending>() else {
+        return Ok(());
+    };
+    let _settlement = pending.settlement.lock().await;
+    let write = pending
+        .write
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone();
+    match write {
+        Some(write) => write.await,
+        None => Ok(()),
+    }
+}
+
+/// This queue owns only model-generated canonical rows; tool results continue
+/// through their existing ordered acceptance owner after the completion gate.
+pub(crate) async fn queue_output(
+    session: &Session,
+    step: &StepContext,
+    envelope: ResponseItemEnvelope,
+    facts: Option<crate::stream_events_utils::DeferredResponseFacts>,
+) -> bool {
+    let Some(source) = step.extension_data.get::<SampledSources>() else {
+        return false;
+    };
+    let allowed = match &envelope.item {
+        ResponseItem::Message { role, content, .. } => {
+            role == "assistant"
+                && content
+                    .iter()
+                    .all(|part| matches!(part, ContentItem::OutputText { .. }))
+        }
+        ResponseItem::Reasoning { .. } | ResponseItem::FunctionCall { .. } => true,
+        ResponseItem::FunctionCallOutput { output, .. } => {
+            matches!(&output.body, FunctionCallOutputBody::Text(_))
+        }
+        _ => false,
+    };
+    if !allowed {
+        *source
+            .0
+            .error
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) =
+            Some("Selected staged input cannot admit this model output kind".into());
+        return true;
+    }
+    let (prepared, images) = session
+        .prepare_annotated_conversation_items_for_history(
+            &step.turn,
+            &step.settings.model_info,
+            vec![envelope],
+        )
+        .await;
+    if !images.is_empty() {
+        *source
+            .0
+            .error
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) =
+            Some("Selected staged output cannot perform image preparation".into());
+        return true;
+    }
+    let raw = prepared
+        .iter()
+        .map(|item| item.item.clone())
+        .collect::<Vec<_>>();
+    source
+        .0
+        .outputs
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .extend(prepared);
+    if let Some(facts) = facts {
+        source
+            .0
+            .facts
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .push(facts);
+    }
+    session.send_raw_response_items(&step.turn, &raw).await;
+    true
+}
+
+pub(crate) async fn join_thread(session: &Session) -> Result<(), String> {
+    let Some(registry) = session
+        .services
+        .thread_extension_data
+        .get::<PendingWrites>()
+    else {
+        return Ok(());
+    };
+    let owners = registry
+        .owners
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .iter()
+        .filter_map(Weak::upgrade)
+        .collect::<Vec<_>>();
+    let mut failure = registry.failure.lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner).clone();
+    for pending in owners {
+        let _settlement = pending.settlement.lock().await;
+        let write = pending
+            .write
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone();
+        if let Some(write) = write
+            && let Err(error) = write.await
+        {
+            failure.get_or_insert(error);
+        }
+    }
+    match failure {
+        Some(error) => Err(error),
+        None => Ok(()),
+    }
+}
