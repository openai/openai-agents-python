+#[test]
+fn raw_standard_approval_metadata_retains_guardian_rejection() {
+    for kind in ["mcp_tool_call", "malformed"] {
+        let mut request = form_request(None);
+        request.elicitation = Elicitation::RawMcpForm {
+            meta: Some(json!({
+                "codex_request_type": "approval_request", "codex_approval_kind": kind,
+                "tool_name": "search", "tool_params": {},
+            })),
+            message: "Synthetic raw approval".to_owned(),
+            requested_schema: json!({"type":"object", "properties":{}, "allOf":[{"required":["answer"]}]}),
+        };
+        assert!(matches!(
+            guardian_elicitation_review_request(&request, None),
+            GuardianElicitationReview::Decline(_)
+        ));
+    }
+    let mut request = form_request(None);
+    request.elicitation = Elicitation::RawMcpForm {
+        meta: None,
+        message: "Synthetic ordinary form".to_owned(),
+        requested_schema: json!({"type":"object", "properties":{}}),
+    };
+    assert!(matches!(
+        guardian_elicitation_review_request(&request, None),
+        GuardianElicitationReview::NotRequested
+    ));
+}
