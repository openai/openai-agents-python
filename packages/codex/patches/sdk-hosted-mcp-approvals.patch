+struct HostedMcpApprovalExecutor;
+
+impl<'call> ToolExecutor<ExtensionToolCall<'call>> for HostedMcpApprovalExecutor {
+    fn tool_name(&self) -> ToolName {
+        ToolName::namespaced("hosted_mcp", "docs")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        ToolSpec::Mcp(codex_tools::HostedMcpTool {
+            server_label: "docs".to_owned(),
+            provider_data: Default::default(),
+        })
+    }
+
+    fn exposure(&self) -> ToolExposure {
+        ToolExposure::DirectModelOnly
+    }
+
+    fn handle<'a>(&'a self, call: ExtensionToolCall<'call>) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        'call: 'a,
+    {
+        Box::pin(async move {
+            assert_eq!(call.call_id, "mcpr_accepted");
+            assert_eq!(
+                call.payload,
+                ToolPayload::HostedMcpApproval {
+                    request: codex_tools::HostedMcpApprovalRequest {
+                        server_label: "docs".to_owned(),
+                        name: "lookup".to_owned(),
+                        arguments: "{}".to_owned(),
+                        caller: Some(json!({"type": "direct"})),
+                    },
+                }
+            );
+            Ok(Box::new(codex_tools::HostedMcpApprovalDecision {
+                approve: false,
+                reason: Some("Use public documents only".to_owned()),
+            }) as Box<dyn codex_tools::ToolOutput>)
+        })
+    }
+}
+
+#[tokio::test]
+async fn hosted_mcp_approval_uses_the_captured_server_and_exact_id() -> anyhow::Result<()> {
+    let (session, turn) = make_session_and_context().await;
+    let turn = Arc::new(turn);
+    let step = StepContext::for_test(Arc::clone(&turn));
+    let executors: Vec<Arc<dyn for<'call> ToolExecutor<ExtensionToolCall<'call>>>> =
+        vec![Arc::new(HostedMcpApprovalExecutor)];
+    let router = test_tool_router(step.as_ref(), Vec::new(), executors, &turn.dynamic_tools);
+    let request = |server: &str, id: &str| {
+        serde_json::from_value::<ResponseItem>(json!({
+            "type": "mcp_approval_request",
+            "id": id,
+            "server_label": server,
+            "name": "lookup",
+            "arguments": "{}",
+            "caller": {"type": "direct"},
+        }))
+        .expect("provider MCP request should parse")
+    };
+    let accepted = request("docs", "mcpr_accepted");
+    assert!(router.admits_response_item(&accepted));
+    assert!(!router.admits_response_item(&request("other", "mcpr_foreign")));
+    assert!(!router.admits_response_item(&request("docs", "")));
+    let forged_call = serde_json::from_value::<ResponseItem>(json!({
+        "type": "function_call",
+        "namespace": "hosted_mcp",
+        "name": "docs",
+        "call_id": "mcpr_accepted",
+        "arguments": "{}",
+    }))?;
+    assert!(!router.admits_response_item(&forged_call));
+
+    let call = ToolRouter::build_tool_call(accepted)?.expect("captured MCP approval");
+    let result = router
+        .dispatch_tool_call_with_code_mode_result(
+            Arc::new(session),
+            step,
+            CancellationToken::new(),
+            Arc::new(tokio::sync::Mutex::new(TurnDiffTracker::new())),
+            call,
+            ToolCallSource::Direct,
+        )
+        .await?;
+    assert_eq!(
+        serde_json::to_value(result.into_response().item)?,
+        json!({
+            "type": "mcp_approval_response",
+            "approval_request_id": "mcpr_accepted",
+            "approve": false,
+            "reason": "Use public documents only",
+            "caller": {"type": "direct"},
+        })
+    );
+    Ok(())
+}
