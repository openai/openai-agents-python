+}
+
+impl std::fmt::Debug for HostedMcpTool {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("HostedMcpTool")
+            .field("server_label", &self.server_label)
+            .field("provider_field_count", &self.provider_data.len())
+            .finish()
+    }
+}
+
+/// The provider's approval input. Core carries its original request ID separately.
+#[derive(Clone, PartialEq, Serialize, Deserialize)]
+pub struct HostedMcpApprovalRequest {
+    pub server_label: String,
+    pub name: String,
+    pub arguments: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub caller: Option<serde_json::Value>,
+}
+
+impl std::fmt::Debug for HostedMcpApprovalRequest {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("HostedMcpApprovalRequest")
+            .field("server_label", &self.server_label)
+            .field("name", &self.name)
+            .finish_non_exhaustive()
+    }
+}
+
+/// The application's decision for an admitted approval request.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct HostedMcpApprovalDecision {
+    pub approve: bool,
+    pub reason: Option<String>,
+}
+
+impl crate::ToolOutput for HostedMcpApprovalDecision {
+    fn log_output(&self) -> String {
+        if self.approve {
+            "Hosted MCP call approved".to_owned()
+        } else {
+            "Hosted MCP call declined".to_owned()
+        }
+    }
+
+    fn success_for_logging(&self) -> bool {
+        true
+    }
+
+    fn to_response_item(
+        &self,
+        call_id: &str,
+        payload: &crate::ToolPayload,
+    ) -> codex_protocol::models::ResponseInputItem {
+        let caller = match payload {
+            crate::ToolPayload::HostedMcpApproval { request } => request.caller.clone(),
+            _ => None,
+        };
+        codex_protocol::models::ResponseInputItem::McpApprovalResponse {
+            approval_request_id: call_id.to_owned(),
+            approve: self.approve,
+            reason: self.reason.clone(),
+            caller,
         }
     }
 }
