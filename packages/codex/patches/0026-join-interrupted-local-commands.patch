+                    entry.environment_id == codex_exec_server::LOCAL_ENVIRONMENT_ID
+                        && !entry.initial_exec_command_returned.load(Ordering::Acquire)
+                        && entry
+                            .output_policy_store
+                            .as_ref()
+                            .is_some_and(|owner| Arc::ptr_eq(owner, turn))
+                })
+                .map(|entry| Arc::clone(&entry.process))
+                .collect::<Vec<_>>()
+        };
+        // Send every stop request before waiting for an exit.
+        futures::future::join_all(processes.iter().map(|process| process.terminate_and_join()))
+            .await
+            .into_iter()
+            .all(|exited| exited)
+    }
