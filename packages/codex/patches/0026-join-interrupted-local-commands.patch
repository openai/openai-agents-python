+    async fn join_interrupted_local_commands(
+        &self,
+        task: AbortOnDropHandle<()>,
+        turn: &TurnContext,
+    ) {
+        // A cancelled initial call can still be returning its process from spawn.
+        // Stop the task before reading the process store so it cannot add entries
+        // after this cleanup. Previously returned terminal handles remain live.
+        task.abort();
+        let task_joined = match tokio::time::timeout(Duration::from_secs(5), task).await {
+            Ok(Ok(())) => true,
+            Ok(Err(error)) => error.is_cancelled(),
+            Err(_) => false,
+        };
+        let commands_joined = self
+            .services
+            .unified_exec_manager
+            .join_unreturned_local_commands(&turn.extension_data)
+            .await;
+        if !task_joined || !commands_joined {
+            let failure = ManagedLocalExecCancelFailure(turn.sub_id.clone());
+            turn.extension_data.insert(failure.clone());
+            self.services.thread_extension_data.insert(failure);
+        }
+    }
