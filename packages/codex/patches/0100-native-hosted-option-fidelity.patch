+
+#[cfg(test)]
+mod option_fidelity_tests {
+    use super::*;
+
+    #[test]
+    fn hosted_provider_fields_survive_without_sdk_include_controls() {
+        for value in [
+            serde_json::json!({"type":"file_search", "vector_store_ids":["vs_test"], "future_option":{"nested":[true, null]}}),
+            serde_json::json!({"type":"code_interpreter", "container":"cntr_test", "future_option":{"nested":[true, null]}}),
+            serde_json::json!({"type":"image_generation", "future_option":{"nested":[true, null]}}),
+        ] {
+            let spec: HostedToolSpec = serde_json::from_value(value.clone()).unwrap();
+            assert_eq!(serde_json::to_value(spec).unwrap(), value);
+        }
+    }
+
+    #[test]
+    fn code_output_inclusion_defaults_true_and_is_not_a_provider_field() {
+        for include in [None, Some(false), Some(true)] {
+            let mut value = serde_json::json!({"container":"cntr_test"});
+            if let Some(include) = include {
+                value["include_outputs"] = include.into();
+            }
+            let config: CodeInterpreterTool = serde_json::from_value(value).unwrap();
+            assert_eq!(config.include_outputs, include.unwrap_or(true));
+            assert_eq!(
+                serde_json::to_value(config).unwrap(),
+                serde_json::json!({"container":"cntr_test"})
+            );
+        }
+    }
+}
