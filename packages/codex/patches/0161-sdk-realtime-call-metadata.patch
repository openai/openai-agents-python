+fn realtime_tool_call_metadata(
+    history: &[ResponseItemEnvelope],
+    invocation_call_id: &str,
+) -> Option<serde_json::Value> {
+    // Stop at the exact latest call even when it has no native annotation.
+    // An older or unrelated restored row cannot donate a correlation.
+    history.iter().rev().find(|envelope| {
+        matches!(&envelope.item, codex_protocol::models::ResponseItem::FunctionCall { call_id, .. }
+            if call_id == invocation_call_id)
+    }).and_then(|envelope| envelope.metadata.as_ref())
+      .and_then(|metadata| metadata.realtime_tool_call.clone())
+}
