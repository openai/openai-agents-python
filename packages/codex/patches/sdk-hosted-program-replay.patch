 // Provider actions have no local accepted-call deduplication owner. Unknown
 // output has lost its raw type, so its replay safety cannot be established.
+fn admit_hosted_program_item(
+    prompt: &Prompt,
+    calls: &mut HashMap<String, bool>,
+    item: &ResponseItem,
+) -> CodexResult<()> {
+    if !prompt.tools.iter().any(|tool| {
+        matches!(tool, codex_tools::ToolSpec::ProviderOnly(tool)
+            if tool.tool_type() == "programmatic_tool_calling")
+    }) {
+        return Err(CodexErr::InvalidRequest(
+            "Provider returned a program without an offered programmatic tool".into(),
+        ));
+    }
+    match item {
+        ResponseItem::Program { call_id, .. } => {
+            if call_id.is_empty() || calls.insert(call_id.clone(), false).is_some() {
+                return Err(CodexErr::InvalidRequest("Invalid provider program call ID".into()));
+            }
+        }
+        ResponseItem::ProgramOutput { call_id, status, .. } => {
+            let prior = calls.entry(call_id.clone()).or_insert_with(|| {
+                // A different response can finish a program admitted in the retained input.
+                prompt.input.iter().rev().find_map(|item| match item {
+                    ResponseItem::ProgramOutput { call_id: existing, status, .. }
+                        if existing == call_id => Some(matches!(
+                            status, codex_protocol::models::ProgramOutputStatus::Completed
+                        )),
+                    ResponseItem::Program { call_id: existing, .. } if existing == call_id => {
+                        Some(false)
+                    }
+                    _ => None,
+                }).unwrap_or(true)
+            });
+            if *prior {
+                return Err(CodexErr::InvalidRequest(
+                    "Provider program output has no unfinished program with this call ID".into(),
+                ));
+            }
+            *prior = matches!(status, codex_protocol::models::ProgramOutputStatus::Completed);
+        }
+        _ => unreachable!("program admission only handles program items"),
+    }
+    Ok(())
+}
