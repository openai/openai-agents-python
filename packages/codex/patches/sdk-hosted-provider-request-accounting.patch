+    fn account_provider_request(
+        &self,
+        operation: ProviderRequestAccounting,
+    ) -> Result<Option<String>, String> {
+        self.with_measurement(|state, measurement| {
+            let usage = &mut state.snapshot.usage;
+            match operation {
+                ProviderRequestAccounting::Manage => {
+                    if measurement.provider_managed
+                        || measurement.usage.is_some()
+                        || measurement.failure.is_some()
+                    {
+                        return Err("Native model usage already has an owner".into());
+                    }
+                    // The sampler admitted a logical attempt. Only the transport
+                    // can tell whether it opens a new physical provider request.
+                    usage.requests -= 1;
+                    usage.requests_without_token_usage -= 1;
+                    measurement.provider_managed = true;
+                    Ok(None)
+                }
+                ProviderRequestAccounting::Create if measurement.provider_managed => {
+                    let requests = usage
+                        .requests
+                        .checked_add(1)
+                        .ok_or("Native provider request counter overflow")?;
+                    let missing = usage
+                        .requests_without_token_usage
+                        .checked_add(1)
+                        .ok_or("Native provider missing-usage counter overflow")?;
+                    let lineage = uuid::Uuid::new_v4().to_string();
+                    // A replacement abandons the preceding incomplete physical
+                    // request. Its counted request remains missing usage.
+                    state.open_provider_request = Some(lineage.clone());
+                    usage.requests = requests;
+                    usage.requests_without_token_usage = missing;
+                    Ok(Some(lineage))
+                }
+                ProviderRequestAccounting::Terminal {
+                    lineage,
+                    usage: measured,
+                } if measurement.provider_managed => {
+                    if state.open_provider_request.as_deref() != Some(lineage.as_str()) {
+                        return Err("Native provider request owner mismatch".into());
+                    }
+                    if let Some(measured) = measured {
+                        validate_usage(&measured)?;
+                        usage.token_usage = add_usage(&usage.token_usage, &measured)?;
+                        usage.requests_without_token_usage -= 1;
+                    }
+                    state.open_provider_request = None;
+                    Ok(None)
+                }
+                _ => Err("Native model attempt has no managed provider transport".into()),
+            }
+        })
+    }
 }

