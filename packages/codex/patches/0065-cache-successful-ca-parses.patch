+#[test]
+fn warm_parse_success_does_not_hide_malformed_crls_trusted_der_or_current_read_errors() {
+    let temp = tempfile::TempDir::new().unwrap();
+    let path = temp.path().join("current.pem");
+    let cache = Mutex::new(ReqwestCaCache::default());
+    fs::write(&path, FIRST_CA).unwrap();
+    let first = bundle(&path).load_reqwest_certificates(&cache).unwrap();
+    let current = ConfiguredCaBundle {
+        source_env: CODEX_CA_CERT_ENV,
+        path: path.clone(),
+    };
+    for malformed in [
+        format!("{FIRST_CA}\n-----BEGIN X509 CRL-----\n!!!\n-----END X509 CRL-----\n"),
+        "-----BEGIN TRUSTED CERTIFICATE-----\nAA==\n-----END TRUSTED CERTIFICATE-----\n"
+            .to_string(),
+    ] {
+        fs::write(&path, malformed).unwrap();
+        for _ in 0..2 {
+            match current
+                .load_reqwest_certificates(&cache)
+                .err()
+                .expect("current CA input must fail")
+            {
+                BuildCustomCaTransportError::InvalidCaFile {
+                    source_env,
+                    path: actual,
+                    ..
+                } => {
+                    assert_eq!(source_env, CODEX_CA_CERT_ENV);
+                    assert_eq!(actual, path);
+                }
+                error => panic!("unexpected parse failure: {error}"),
+            }
+        }
+        assert_eq!(cache.lock().unwrap().entries.len(), 1);
+    }
+    fs::remove_file(&path).unwrap();
+    fs::create_dir(&path).unwrap();
+    match current
+        .load_reqwest_certificates(&cache)
+        .err()
+        .expect("current CA input must fail")
+    {
+        BuildCustomCaTransportError::ReadCaFile {
+            source_env,
+            path: actual,
+            ..
+        } => {
+            assert_eq!(source_env, CODEX_CA_CERT_ENV);
+            assert_eq!(actual, path);
+        }
+        error => panic!("current path read failure must not use cached trust: {error}"),
+    }
+    fs::remove_dir(&path).unwrap();
+    fs::write(&path, FIRST_CA).unwrap();
+    assert!(Arc::ptr_eq(
+        &first,
+        &current.load_reqwest_certificates(&cache).unwrap()
+    ));
+}
