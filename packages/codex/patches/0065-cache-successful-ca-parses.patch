+#[test]
+fn exact_digest_hits_replay_parser_diagnostics_with_current_source_outside_the_lock() {
+    use tracing_subscriber::Layer;
+    use tracing_subscriber::layer::SubscriberExt;
+
+    const CHILD: &str = "CODEX_HTTP_CLIENT_CA_PARSE_DIAGNOSTICS_TEST";
+    if std::env::var_os(CHILD).is_none() {
+        // Follow existing logging tests: isolate subscriber/callsite state.
+        let module = module_path!().split_once("::").unwrap().1;
+        let name = format!(
+            "{module}::exact_digest_hits_replay_parser_diagnostics_with_current_source_outside_the_lock"
+        );
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", &name, "--nocapture"])
+            .env(CHILD, "1")
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "{}\n{}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        );
+        return;
+    }
+
+    struct LogWriter {
+        logs: Arc<Mutex<Vec<u8>>>,
+        cache: Arc<Mutex<ReqwestCaCache>>,
+    }
+    impl Write for LogWriter {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            assert!(
+                self.cache.try_lock().is_ok(),
+                "tracing must not hold the CA cache lock"
+            );
+            self.logs.lock().unwrap().extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+
+    let cache = Arc::new(Mutex::new(ReqwestCaCache::default()));
+    let logs = Arc::new(Mutex::new(Vec::new()));
+    let writer_logs = Arc::clone(&logs);
+    let writer_cache = Arc::clone(&cache);
+    let subscriber = tracing_subscriber::registry().with(
+        tracing_subscriber::fmt::layer()
+            .without_time()
+            .with_target(false)
+            .with_ansi(false)
+            .with_writer(move || LogWriter {
+                logs: Arc::clone(&writer_logs),
+                cache: Arc::clone(&writer_cache),
+            })
+            .with_filter(
+                tracing_subscriber::filter::Targets::new()
+                    .with_target("codex_http_client::custom_ca", tracing::Level::INFO),
+            ),
+    );
+    let _guard = tracing::subscriber::set_default(subscriber);
+    let temp = tempfile::TempDir::new().unwrap();
+    let first_path = temp.path().join("original.pem");
+    let current_path = temp.path().join("selected.pem");
+    let trusted = include_str!("../tests/fixtures/test-ca-trusted.pem");
+    // The parser classifies this well-formed PEM CRL before ignoring its body.
+    let crl = "-----BEGIN X509 CRL-----\nMAA=\n-----END X509 CRL-----\n";
+    let ignored_key = "-----BEGIN PRIVATE KEY-----\nAQID\n-----END PRIVATE KEY-----\n";
+    let contents = format!("{trusted}\n{crl}{crl}{ignored_key}");
+    fs::write(&first_path, &contents).unwrap();
+    fs::write(&current_path, &contents).unwrap();
+    let (cold, cold_digest, cold_admissible) = bundle(&first_path)
+        .load_reqwest_certificates_and_digest(&cache)
+        .unwrap();
+    assert_eq!(cold.len(), 1);
+    let cold_logs = String::from_utf8(std::mem::take(&mut *logs.lock().unwrap())).unwrap();
+    let current = ConfiguredCaBundle {
+        source_env: CODEX_CA_CERT_ENV,
+        path: current_path.clone(),
+    };
+    let (warm, warm_digest, warm_admissible) = current
+        .load_reqwest_certificates_and_digest(&cache)
+        .unwrap();
+    let warm_logs = String::from_utf8(std::mem::take(&mut *logs.lock().unwrap())).unwrap();
+    assert!(Arc::ptr_eq(&cold, &warm));
+    assert_eq!(cold_digest, warm_digest);
+    assert!(cold_admissible && warm_admissible);
+    for (captured, path, env) in [
+        (&cold_logs, &first_path, SSL_CERT_FILE_ENV),
+        (&warm_logs, &current_path, CODEX_CA_CERT_ENV),
+    ] {
+        let lines = captured.lines().collect::<Vec<_>>();
+        assert_eq!(
+            lines.len(),
+            3,
+            "one normalization, one CRL and one count event: {captured}"
+        );
+        for (line, message) in lines.iter().zip([
+            "normalizing OpenSSL TRUSTED CERTIFICATE labels in custom CA bundle",
+            "ignoring X509 CRL entries found in custom CA bundle",
+            "loaded certificates from custom CA bundle",
+        ]) {
+            assert!(line.contains(message));
+            assert!(line.contains(env));
+            assert!(line.contains(path.to_str().unwrap()));
+        }
+        assert!(lines[2].contains("certificate_count=1"));
+        assert!(!captured.contains("PRIVATE KEY"));
+        assert!(!captured.contains("AQID"));
+    }
+    assert!(!warm_logs.contains(first_path.to_str().unwrap()));
+}
