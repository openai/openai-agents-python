+
+async fn record_tool_completion_feedback(
+    sess: &Session,
+    step: &StepContext,
+    feedback: Option<String>,
+) -> CodexResult<()> {
+    release_held_tool_results(sess, step, false).await;
+    if let Some(feedback) = feedback {
+        let item = build_hook_prompt_message(&[
+            codex_protocol::items::HookPromptFragment::from_single_hook(
+                feedback,
+                uuid::Uuid::new_v4().to_string(),
+            ),
+        ])
+        .ok_or_else(|| CodexErr::InvalidRequest("Completion feedback must not be empty".into()))?;
+        sess.record_response_item_and_emit_turn_item(&step.turn, &step.settings.model_info, item)
+            .await;
+    }
+    Ok(())
+}
+
+async fn propose_tool_batch_completion(
+    sess: &Session,
+    step: &StepContext,
+    tools: &SettledDirectTools,
+    cancellation: &CancellationToken,
+) -> CodexResult<Option<codex_protocol::protocol::ToolTurnCompletion>> {
+    let contributors = sess.services.extensions.turn_lifecycle_contributors();
+    let enabled = contributors
+        .iter()
+        .filter(|contributor| {
+            contributor.tool_batch_completion_enabled(
+                &sess.services.thread_extension_data,
+                &step.extension_data,
+            )
+        })
+        .collect::<Vec<_>>();
+    if enabled.is_empty()
+        || tools.outcomes.len() != tools.calls.len()
+        || tools.outcomes.iter().any(Option::is_none)
+    {
+        return Ok(None);
+    }
+
+    let handoff_tools = step.settings.agent_profile.as_ref().and_then(|profile| {
+        profile
+            .profile
+            .data
+            .get::<codex_extension_api::AgentProfileHandoffTools>()
+    });
+    let mut results = Vec::new();
+    let mut call_ids = Vec::new();
+    for ((call, output), succeeded) in tools.calls.iter().zip(&tools.outputs).zip(&tools.outcomes) {
+        let ResponseItem::FunctionCall {
+            call_id,
+            name,
+            namespace,
+            ..
+        } = call
+        else {
+            continue;
+        };
+        let Some(succeeded) = succeeded else {
+            return Ok(None);
+        };
+        let tool = codex_tools::ToolName {
+            name: name.clone(),
+            namespace: namespace.clone(),
+        }
+        .with_default_namespace();
+        if handoff_tools
+            .as_ref()
+            .is_some_and(|handoffs| handoffs.targets.contains_key(&tool))
+        {
+            if *succeeded {
+                return Ok(None);
+            }
+            continue;
+        }
+        call_ids.push(call_id.clone());
+        results.push(codex_extension_api::ToolBatchCompletionResult {
+            call,
+            output,
+            succeeded: *succeeded,
+        });
+    }
+    let Some(codex_extension_api::ToolBatchCompletionResult {
+        call:
+            ResponseItem::FunctionCall {
+                call_id,
+                name,
+                namespace,
+                ..
+            },
+        ..
+    }) = results.first()
+    else {
+        return Ok(None);
+    };
+    for contributor in enabled {
+        let decision = contributor
+            .propose_tool_batch_completion(codex_extension_api::ToolBatchCompletionInput {
+                turn_id: &step.turn.sub_id,
+                model: &step.settings.model_info.slug,
+                continuation_count: 0,
+                results: &results,
+                thread_store: &sess.services.thread_extension_data,
+                turn_store: step.turn.extension_data.as_ref(),
+                step_store: &step.extension_data,
+            })
+            .or_cancel(cancellation)
+            .await?
+            .map_err(CodexErr::InvalidRequest)?;
+        if cancellation.is_cancelled() {
+            return Err(CodexErr::TurnAborted);
+        }
+        match decision {
+            None => continue,
+            Some(codex_extension_api::ToolCompletionDecision::Continue { feedback }) => {
+                record_tool_completion_feedback(sess, step, feedback).await?;
+                return Ok(None);
+            }
+            Some(codex_extension_api::ToolCompletionDecision::Accept { final_output }) => {
+                return Ok(Some(codex_protocol::protocol::ToolTurnCompletion {
+                    call_id: call_id.clone(),
+                    name: name.clone(),
+                    namespace: namespace.clone(),
+                    final_output,
+                    batch_call_ids: Some(call_ids),
+                }));
+            }
+        }
+    }
     Ok(None)
 }
 
