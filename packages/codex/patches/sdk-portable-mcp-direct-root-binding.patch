+    /// Current accepted root MCP connections and catalog, without changing declarations.
+    /// Agent profiles keep their separate committed source and cannot use this path.
+    pub async fn accepted_root_mcp_binding(
+        &self,
+        server_name: &str,
+    ) -> CodexResult<Option<Arc<codex_mcp::McpBinding>>> {
+        if self.session.agent_profile_receipt().await?.is_some() {
+            return Ok(None);
+        }
+        let binding = self
+            .session
+            .services
+            .mcp_runtime
+            .try_current_binding_with_requirements(
+                &[server_name.to_owned()],
+                &std::collections::HashSet::new(),
+            )
+            .await
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+        if self.session.agent_profile_receipt().await?.is_some() {
+            return Ok(None);
+        }
+        Ok(binding)
+    }
