 impl OwnedQuestion {
+    /// Original in-memory MCP binding and SDK attachments from this native call.
+    /// Peer requests and serialized checkpoint fields cannot create this source.
+    pub async fn mcp_approval_source(
+        &self,
+    ) -> anyhow::Result<
+        Option<(
+            Arc<codex_mcp::McpBinding>,
+            codex_extension_api::ExtensionData,
+        )>,
+    > {
+        if self.identity.is_none() {
+            return Ok(None);
+        }
+        let QuestionKey::Elicitation(server, RequestId::String(request_id)) = &self.key else {
+            return Ok(None);
+        };
+        let prefix = format!(
+            "{}_",
+            crate::mcp_tool_call::MCP_TOOL_APPROVAL_QUESTION_ID_PREFIX
+        );
+        let Some(call_id) = request_id.as_ref().strip_prefix(&prefix) else {
+            return Ok(None);
+        };
+        let Some(context) = self.session.mcp_tool_approval_metadata(server, call_id) else {
+            return Ok(None);
+        };
+        if !self.is_pending().await {
+            return Ok(None);
+        }
+        Ok(context.checkpoint_source.clone())
+    }
