+async fn register_media_interrupt_test_call(
+    sdk: &super::SdkRealtimeState,
+    id: &str,
+    response: &str,
+    claimed: bool,
+    root: Option<&str>,
+    batch: Option<Arc<super::RealtimeFunctionBatch>>,
+) {
+    assert!(sdk.register_for_response(id, Some(response)).await.unwrap());
+    sdk.function_calls.lock().await.insert(
+        id.into(),
+        super::SdkFunctionCall {
+            preparation: None,
+            configuration: batch.as_ref().map(|batch| batch.configuration.clone()),
+            batch,
+            request: codex_protocol::protocol::RealtimeFunctionCallRequested {
+                source_profile: None,
+                namespace: None,
+                call_id: id.into(),
+                item_id: format!("item-{id}"),
+                name: "lookup".into(),
+                arguments: "{}".into(),
+                response_id: Some(response.into()),
+            },
+            claimed,
+            native_turn_id: root.map(str::to_owned),
+            cancel: tokio_util::sync::CancellationToken::new(),
+            completed: tokio_util::sync::CancellationToken::new(),
+        },
+    );
+}
+
+#[tokio::test]
+async fn media_interrupt_protects_only_admitted_unresolved_calls_in_its_response() {
+    let sdk = super::SdkRealtimeState::new("media-admission".into());
+    register_media_interrupt_test_call(&sdk, "admitted", "a", true, Some("root"), None).await;
+    register_media_interrupt_test_call(&sdk, "unclaimed", "a", false, None, None).await;
+    register_media_interrupt_test_call(&sdk, "unrooted", "a", true, None, None).await;
+    register_media_interrupt_test_call(&sdk, "other", "b", true, Some("root"), None).await;
+    register_media_interrupt_test_call(&sdk, "settled", "a", true, Some("root"), None).await;
+    sdk.pending.lock().await.remove("settled");
+    assert!(
+        sdk.register_for_response("handoff", Some("a"))
+            .await
+            .unwrap()
+    );
+    let ownership = sdk.seen.lock().await["handoff"].ownership_id.clone();
+    let mut admitted = sdk
+        .preserve_admitted_tools(
+            Some("a"),
+            &[("handoff".into(), Some("a".into()), ownership)],
+        )
+        .await;
+    admitted.sort();
+    assert_eq!(
+        admitted
+            .iter()
+            .map(|(id, _, previous)| (id.as_str(), *previous))
+            .collect::<Vec<_>>(),
+        vec![("admitted", false), ("handoff", false)]
+    );
+    let mut retained: Vec<_> = sdk
+        .media_independent_calls(Some("a"))
+        .await
+        .into_iter()
+        .collect();
+    retained.sort();
+    assert_eq!(retained, vec!["admitted", "handoff"]);
+    assert!(sdk.media_independent_calls(Some("b")).await.is_empty());
+    assert!(
+        !sdk.pending.lock().await["admitted"],
+        "unresolved false is not absence of admission"
+    );
+}
+
+#[tokio::test]
+async fn media_interrupt_rejection_rolls_back_only_new_protection() {
+    let sdk = super::SdkRealtimeState::new("media-rollback".into());
+    register_media_interrupt_test_call(&sdk, "prior", "a", true, Some("root"), None).await;
+    sdk.preserve_admitted_tools(Some("a"), &[]).await;
+    register_media_interrupt_test_call(&sdk, "new", "a", true, Some("root"), None).await;
+    let attempted = sdk.preserve_admitted_tools(Some("a"), &[]).await;
+    sdk.restore_media_preservation(&attempted).await;
+    assert_eq!(
+        sdk.media_independent_calls(None).await,
+        std::collections::HashSet::from(["prior".to_owned()])
+    );
+    sdk.retire_tool_work(false, None, false).await;
+    assert!(
+        sdk.function_calls.lock().await["prior"]
+            .cancel
+            .is_cancelled()
+    );
+    assert!(sdk.function_calls.lock().await["new"].cancel.is_cancelled());
+    assert!(sdk.media_independent_calls(None).await.is_empty());
+}
+
+#[tokio::test]
+async fn media_interrupt_preserves_shared_batch_without_protecting_other_calls() {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    let (connection, _, server) = sdk_wire_connection().await;
+    let sdk = super::SdkRealtimeState::new("media-shared".into());
+    let batch = Arc::new(super::RealtimeFunctionBatch {
+        completed: std::sync::OnceLock::new(),
+        root_dispatch: std::sync::OnceLock::new(),
+        response_id: "a".into(),
+        call_ids: vec!["protected".into(), "unclaimed".into()],
+        configuration: connection
+            .writer()
+            .configuration()
+            .unwrap()
+            .accepted()
+            .unwrap(),
+        handoff_pending: AtomicBool::new(false),
+        handoff_accepted: AtomicBool::new(false),
+        pending_create: AtomicBool::new(true),
+        user_create: std::sync::Mutex::new(None),
+        automatic_retired: AtomicBool::new(false),
+        committed_target: std::sync::Mutex::new(None),
+        update_reserved: AtomicBool::new(false),
+        continued: AtomicBool::new(false),
+    });
+    register_media_interrupt_test_call(
+        &sdk,
+        "protected",
+        "a",
+        true,
+        Some("shared"),
+        Some(batch.clone()),
+    )
+    .await;
+    register_media_interrupt_test_call(&sdk, "unclaimed", "a", false, None, Some(batch.clone()))
+        .await;
+    register_media_interrupt_test_call(&sdk, "other", "b", true, Some("shared"), None).await;
+    sdk.preserve_admitted_tools(Some("a"), &[]).await;
+    let retired = sdk.retire_tool_work(false, None, true).await;
+    assert!(
+        sdk.eligible_retired_roots(&retired.roots, false)
+            .await
+            .is_empty(),
+        "a shared root must retain its admitted protected call"
+    );
+    let calls = sdk.function_calls.lock().await;
+    assert!(!calls["protected"].cancel.is_cancelled());
+    assert!(calls["unclaimed"].cancel.is_cancelled());
+    assert!(calls["other"].cancel.is_cancelled());
+    assert!(
+        retired.batches.is_empty(),
+        "sibling cleanup must not join the retained batch"
+    );
+    assert!(!batch.automatic_retired.load(Ordering::Acquire));
+    assert!(batch.pending_create.load(Ordering::Acquire));
+    drop(calls);
+    sdk.retire_tool_work(true, None, true).await;
+    assert!(!sdk.active.load(Ordering::Acquire));
+    assert!(
+        sdk.function_calls.lock().await["protected"]
+            .cancel
+            .is_cancelled()
+    );
+    assert!(batch.automatic_retired.load(Ordering::Acquire));
+    server.abort();
+}
+
+#[tokio::test]
+async fn media_interrupt_does_not_admit_unowned_or_reused_legacy_handoffs() {
+    for source in [None, Some("a")] {
+        let sdk = super::SdkRealtimeState::new("media-owner-lag".into());
+        assert!(sdk.register_for_response("unread", source).await.unwrap());
+        assert!(sdk.preserve_admitted_tools(None, &[]).await.is_empty());
+        assert!(sdk.register_for_response("owned", source).await.unwrap());
+        let original_owner = sdk.seen.lock().await["owned"].ownership_id.clone();
+        let captured = [(
+            "owned".to_owned(),
+            source.map(str::to_owned),
+            original_owner.clone(),
+        )];
+        let original_grant = sdk.preserve_admitted_tools(None, &captured).await;
+        assert_eq!(
+            original_grant,
+            vec![("owned".to_owned(), original_owner.clone(), false)]
+        );
+        sdk.seen.lock().await.shift_remove("owned");
+        sdk.pending.lock().await.remove("owned");
+        assert!(sdk.register_for_response("owned", source).await.unwrap());
+        let replacement_owner = sdk.seen.lock().await["owned"].ownership_id.clone();
+        assert_ne!(original_owner, replacement_owner);
+        assert!(
+            sdk.preserve_admitted_tools(None, &captured)
+                .await
+                .is_empty()
+        );
+        let replacement = [(
+            "owned".to_owned(),
+            source.map(str::to_owned),
+            replacement_owner,
+        )];
+        let replacement_grant = sdk.preserve_admitted_tools(None, &replacement).await;
+        assert_eq!(replacement_grant.len(), 1);
+        sdk.restore_media_preservation(&original_grant).await;
+        assert!(sdk.seen.lock().await["owned"].preserve_on_response_cancel);
+        sdk.restore_media_preservation(&replacement_grant).await;
+        assert!(!sdk.seen.lock().await["owned"].preserve_on_response_cancel);
+    }
+}
