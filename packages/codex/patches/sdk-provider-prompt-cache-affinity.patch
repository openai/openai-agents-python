+#[test]
+fn sdk_cache_affinity_keeps_body_and_routing_key_separate_from_thread_identity() {
+    let client = test_model_client(SessionSource::Cli);
+    let mut metadata = test_responses_metadata_for_client(
+        &client, Some("turn-cache"), "window-cache".to_string(), None,
+        TestCodexResponsesRequestKind::Turn,
+    );
+    let original = metadata.session_id.clone();
+    let key = "agents-sdk:group:0123456789abcdef0123456789abcdef";
+    metadata.sdk_prompt_cache_key = Some(key.into());
+    assert_eq!(client.prompt_cache_key(&metadata), key);
+    assert_eq!(client.responses_session_id(&metadata), key);
+    assert_eq!(metadata.session_id, original);
+    assert!(!metadata.turn_metadata_json().unwrap().contains(key));
+    metadata.sdk_prompt_cache_key = None;
+    assert_eq!(client.prompt_cache_key(&metadata), original);
+}
