+struct BoundInterceptor {
+    inner: Box<dyn ModelResponseInterceptor>,
+    admission: Option<Arc<dyn ModelToolAdmission>>,
+}
+impl ModelResponseInterceptor for BoundInterceptor {
+    fn admit_request(&self) -> Result<(), String> {
+        self.inner.admit_request()
+    }
+    fn intercept(self: Box<Self>, stream: ModelResponseStream) -> ModelResponseStream {
+        self.inner
+            .intercept_with_tool_admission(stream, self.admission)
+    }
+}
