+impl ModelToolAdmission for StepToolAdmission {
+    fn thread_id(&self) -> &str {
+        &self.thread_id
+    }
+    fn turn_store(&self) -> &ExtensionData {
+        &self.turn_store
+    }
+    fn admits(&self, item: &ResponseItem) -> bool {
+        self.router.admits_response_item(item)
+    }
+}
+pub(crate) fn tool_admission(
+    thread_id: String,
+    turn_store: Arc<ExtensionData>,
+    router: Arc<ToolRouter>,
+) -> Arc<dyn ModelToolAdmission> {
+    Arc::new(StepToolAdmission {
+        thread_id,
+        turn_store,
+        router,
+    })
+}
+
+pub(crate) fn admit_request(
+    interceptors: &[Box<dyn ModelResponseInterceptor>],
+) -> Result<(), String> {
+    for interceptor in interceptors {
+        interceptor.admit_request()?;
+    }
+    Ok(())
+}
