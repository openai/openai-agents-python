 pub trait ModelResponseInterceptor: Send + Sync {
+    /// Admit this captured request immediately before provider transport starts.
+    /// Hosts may revoke its original owner without affecting a later request.
+    fn admit_request(&self) -> Result<(), String> {
+        Ok(())
+    }
+
+    /// Bind immutable routing evidence before wrapping this request's stream.
+    /// Existing interceptors keep their behavior; configured policies can reject missing evidence.
+    fn intercept_with_tool_admission(
+        self: Box<Self>,
