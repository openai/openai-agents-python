+/// Detached processor observation; no live span or credential authority.
+#[derive(Deserialize, Serialize)]
+struct DispatchedTraceEvent {
+    lifecycle: String,
+    trace_id: String,
+    span_id: String,
+    parent_span_id: Option<String>,
+    name: String,
+    kind: String,
+    start_time_unix_nanos: String,
+    end_time_unix_nanos: Option<String>,
+    attributes: serde_json::Map<String, Value>,
+    outcome: String,
+    dropped_attributes_count: u32,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    credential_required: Option<bool>,
+    #[serde(skip_serializing)]
+    root_descriptor: Option<Value>,
+}
