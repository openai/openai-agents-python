+/// Delivery through the existing bounded processor queue and acknowledgement.
+pub async fn dispatch_trace_event(encoded: &str) -> Result<(), String> {
+    if encoded.len() > MAX_BYTES {
+        return Err("Trace event exceeds its record limit".into());
+    }
+    let mut observation: DispatchedTraceEvent =
+        serde_json::from_str(encoded).map_err(|_| "Invalid trace event snapshot")?;
+    if !matches!(observation.lifecycle.as_str(), "start" | "end") {
+        return Err("Invalid trace event lifecycle".into());
+    }
+    let descriptor = observation.root_descriptor.take();
+    let mut value =
+        serde_json::to_value(observation).map_err(|_| "Invalid trace event snapshot")?;
+    let acknowledged = {
+        let mut s = lock();
+        if s.credentials_closed {
+            return Err("Telemetry has been shutting down".into());
+        }
+        s.sequence += 1;
+        let sequence = s.sequence;
+        if s.processors.is_empty() {
+            return Ok(());
+        }
+        value["sequence"] = json!(sequence);
+        value["processor_ids"] = json!(s.processors);
+        // Observation IDs never resolve a native scope or credential lease.
+        if !enqueue_event(&mut s, sequence, value, descriptor, None) {
+            return Err("Trace event exceeds processor queue capacity".into());
+        }
+        let (sender, acknowledged) = tokio::sync::oneshot::channel();
+        s.dispatch_waiters.insert(sequence, sender);
+        acknowledged
+    };
+    acknowledged
+        .await
+        .map_err(|_| "Telemetry has been shutting down before trace delivery".into())
 }
