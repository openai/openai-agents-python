+// Preserve the existing FunctionCall constructor while checking ownership on every wire route.
+type DirectFunctionCallFields = (
+    Option<ResponseItemId>,
+    String,
+    Option<String>,
+    String,
+    Option<Vec<String>>,
+    Option<bool>,
+    Option<String>,
+    String,
+    Option<InternalChatMessageMetadataPassthrough>,
+);
+
+fn deserialize_direct_function_call<'de, D>(
+    deserializer: D,
+) -> Result<DirectFunctionCallFields, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    #[derive(Deserialize)]
+    struct WireCall {
+        id: Option<ResponseItemId>,
+        name: String,
+        namespace: Option<String>,
+        arguments: String,
+        encrypted_function_args: Option<Vec<String>>,
+        #[serde(rename = "async")]
+        asynchronous: Option<bool>,
+        status: Option<String>,
+        call_id: String,
+        internal_chat_message_metadata_passthrough: Option<InternalChatMessageMetadataPassthrough>,
+        caller: Option<serde_json::Value>,
+    }
+
+    let call = WireCall::deserialize(deserializer)?;
+    if call.caller.as_ref().is_some_and(|caller| {
+        caller.get("type").and_then(serde_json::Value::as_str) != Some("direct")
+    }) {
+        return Err(serde::de::Error::custom(
+            "Only direct function callers are supported by the native runtime",
+        ));
+    }
+    Ok((
+        call.id,
+        call.name,
+        call.namespace,
+        call.arguments,
+        call.encrypted_function_args,
+        call.asynchronous,
+        call.status,
+        call.call_id,
+        call.internal_chat_message_metadata_passthrough,
+    ))
+}
