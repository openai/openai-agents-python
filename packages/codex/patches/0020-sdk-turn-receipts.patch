 }
+
+/// Policy for the executor selected for an SDK sampling request.
+pub fn sdk_executor_policy_receipt(
+    selection: &TurnEnvironmentSelection,
+    remote: bool,
+) -> Option<serde_json::Value> {
+    let EnvironmentConfigState::Ready(config) = &selection.config else {
+        return None;
+    };
+    let profile = config.permission_profile.permission_profile();
+    let fs = profile.file_system_sandbox_policy();
+    let writable_roots = fs
+        .entries
+        .iter()
+        .filter_map(|entry| match &entry.path {
+            FileSystemPath::Path { path } if entry.access.can_write() => Some(path),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    let network_policy = config.network_policy.as_ref().map(|policy| {
+        serde_json::json!({
+            "requires_proxy": policy.requires_proxy,
+            "domains": policy.domains,
+            "allow_all_unix_sockets": policy.dangerously_allow_all_unix_sockets,
+            "allow_local_binding": policy.allow_local_binding,
+        })
+    });
+    let permission_profile = serde_json::to_value(profile).ok()?;
+    Some(serde_json::json!({
+        "environment_id": selection.environment_id,
+        "transport": if remote { "remote" } else { "local" },
+        "cwd": selection.cwd,
+        "writable_roots": writable_roots,
+        "permission_profile": permission_profile,
+        "network_sandbox": profile.network_sandbox_policy(),
+        "network_policy": network_policy,
+    }))
+}
