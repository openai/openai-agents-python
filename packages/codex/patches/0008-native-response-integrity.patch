+    #[test]
+    fn supported_output_and_unknown_events_keep_existing_parser_behavior() {
+        for kind in ["response.output_item.added", "response.output_item.done"] {
+            for text in ["ordinary text", "", " \n\t "] {
+                let event = serde_json::from_value(json!({
+                    "type": kind,
+                    "item": {"type": "message", "role": "assistant", "content": [
+                        {"type": "output_text", "text": text}
+                    ]}
+                }))
+                .unwrap();
+                assert!(process_responses_event(event).unwrap().is_some());
+            }
+            let tool = serde_json::from_value(json!({
+                "type": kind,
+                "item": {"type": "function_call", "call_id": "call", "name": "lookup", "arguments": "{}"}
+            })).unwrap();
+            assert!(process_responses_event(tool).unwrap().is_some());
+        }
+        let unknown = serde_json::from_value(json!({
+            "type": "response.future_event", "item": {"private": "ignored"}
+        }))
+        .unwrap();
+        assert!(process_responses_event(unknown).unwrap().is_none());
+    }
