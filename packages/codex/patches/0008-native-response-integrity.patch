+    #[test]
+    fn undecodable_output_items_fail_without_exposing_payload() {
+        for kind in ["response.output_item.added", "response.output_item.done"] {
+            let text: ResponsesStreamEvent = serde_json::from_value(json!({
+                "type": "response.output_item.done",
+                "item": {"type": "message", "role": "assistant", "content": [
+                    {"type": "output_text", "text": "earlier commentary"}
+                ]}
+            }))
+            .unwrap();
+            assert_matches!(
+                process_responses_event(text),
+                Ok(Some(ResponseEvent::OutputItemDone(_)))
+            );
+            let invalid: ResponsesStreamEvent = serde_json::from_value(json!({
+                "type": kind,
+                "item": {"type": "message", "id": "private-item-id", "role": "assistant", "content": [
+                    {"type": "refusal", "refusal": "private-refusal-payload"}
+                ]}
+            })).unwrap();
+            let error = process_responses_event(invalid)
