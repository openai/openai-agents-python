+#[test]
+fn guardian_renders_original_native_computer_actions() -> Result<()> {
+    let original = json!({"type":"computer_call","call_id":"computer-1","actions":[{"type":"click","x":1,"y":2,"button":"left"}],"pending_safety_checks":[{"id":"s1","message":"confirm"}]});
+    let rendered = GuardianAction {
+        tool_name: ToolName::plain("computer"),
+        payload: ToolPayload::Computer {
+            arguments: original.to_string(),
+        },
+    }
+    .render(4096)?;
+    let mut expected = original;
+    expected["tool"] = json!("computer");
+    assert_eq!(serde_json::from_str::<Value>(&rendered)?, expected);
+    Ok(())
+}
