+#[cfg(test)]
+mod profile_model_settings_tests {
+    use super::AgentProfileModelSettings;
+
+    #[test]
+    fn old_profile_model_shape_preserves_fingerprint_and_new_values_roundtrip() {
+        let old = serde_json::json!({
+            "model": "profile-model", "reasoning_effort": null,
+            "reasoning_summary": null, "service_tier": null,
+            "tool_choice": null, "personality": null
+        });
+        let mut settings: AgentProfileModelSettings = serde_json::from_value(old.clone()).unwrap();
+        assert_eq!(serde_json::to_value(&settings).unwrap(), old);
+        settings.invocation_timeout_ms = Some(1234);
+        settings.request_controls.max_output_tokens = Some(Some(17));
+        settings.request_controls.named_tool_choice = Some(None);
+        let encoded = serde_json::to_value(&settings).unwrap();
+        assert_eq!(encoded["invocation_timeout_ms"], 1234);
+        assert_eq!(encoded["request_controls"]["max_output_tokens"], 17);
+        assert!(
+            encoded["request_controls"]
+                .as_object()
+                .unwrap()
+                .contains_key("named_tool_choice")
+        );
+        assert_eq!(
+            serde_json::from_value::<AgentProfileModelSettings>(encoded).unwrap(),
+            settings
+        );
+    }
+}
