+fn append_profile_workspace_guidance(
+    prompt: &mut Prompt,
+    guidance: &codex_extension_api::AgentProfileWorkspaceGuidance,
+    supports_websockets: bool,
+) -> Result<(), String> {
+    if prompt.canonical_history_input.is_some()
+        || prompt.request_controls.store == Some(Some(true))
+        || supports_websockets
+        || prompt
+            .request_controls
+            .request_transport
+            .as_ref()
+            .and_then(Option::as_ref)
+            .and_then(|transport| transport.mode.flatten())
+            == Some(codex_protocol::model_request_transport::RequestTransportMode::Websocket)
+    {
+        return Err("Scoped workspace guidance requires stateless Responses HTTP without provider history or store=true".into());
+    }
+    let Some(text) = guidance.0.as_ref() else {
+        return Ok(());
+    };
+    if text.len() > 40_000 {
+        return Err("Scoped workspace guidance exceeds 40000 UTF-8 bytes".into());
+    }
+    use crate::context::ContextualUserFragment;
+    let fragment = crate::context::UserInstructions {
+        directory: None,
+        text: text.clone(),
+    };
+    prompt.input.push(fragment.render_fragment().into());
+    Ok(())
+}
