+#[cfg(test)]
+mod workspace_sampling_tests {
+    use super::*;
+
+    #[test]
+    fn workspace_uses_user_resource_metadata_and_keeps_existing_policy() {
+        let policy: ResponseItem = serde_json::from_value(serde_json::json!({
+            "type":"message", "role":"developer", "content":[{"type":"input_text","text":"unchanged policy"}]
+        })).unwrap();
+        let mut prompt = Prompt::default();
+        prompt.input.push(policy.clone());
+        append_profile_workspace_guidance(
+            &mut prompt,
+            &codex_extension_api::AgentProfileWorkspaceGuidance(Some("current resource".into())),
+            false,
+        )
+        .unwrap();
+        assert_eq!(prompt.input[0], policy);
+        assert!(
+            matches!(&prompt.input[1], ResponseItem::Message {role, internal_chat_message_metadata_passthrough: Some(metadata), ..}
+            if role == "user" && metadata.content_item_kinds.as_ref().is_some_and(|kinds| kinds.len() == 1 && serde_json::to_string(metadata).unwrap().contains("agents_md.instructions")))
+        );
+        let mut cleared = Prompt::default();
+        append_profile_workspace_guidance(
+            &mut cleared,
+            &codex_extension_api::AgentProfileWorkspaceGuidance(None),
+            false,
+        )
+        .unwrap();
+        assert!(cleared.input.is_empty());
+    }
+
+    #[test]
+    fn workspace_refuses_server_storage_or_websocket_before_injection() {
+        for websocket in [false, true] {
+            let mut prompt = Prompt::default();
+            if !websocket {
+                prompt.request_controls.store = Some(Some(true));
+            }
+            assert!(
+                append_profile_workspace_guidance(
+                    &mut prompt,
+                    &codex_extension_api::AgentProfileWorkspaceGuidance(Some(
+                        "private resource".into()
+                    )),
+                    websocket
+                )
+                .is_err()
+            );
+            assert!(prompt.input.is_empty());
+        }
+    }
+}
