+/// One native fresh admission claims an existing caller-owned pending mask.
+pub struct FreshStagedInput {
+    thread_id: String,
+    batch: StagedInputBatch,
+    current_turn: Arc<std::sync::Mutex<String>>,
+    claimed: AtomicBool,
+}
+impl FreshStagedInput {
+    pub fn new(thread_id: String, batch: StagedInputBatch,
+        current_turn: Arc<std::sync::Mutex<String>>) -> Result<Self, String> {
+        if !batch.projects_occurrences() { return Err("Fresh staged input requires selected occurrence ownership".into()); }
+        Ok(Self { thread_id, batch, current_turn, claimed: AtomicBool::new(false) })
+    }
+    /// Core claims only after its atomic fresh-root admission, before sampling.
+    pub fn claim(&self, thread_id: &str, turn_id: &str) -> Option<StagedInputBatch> {
+        if self.thread_id != thread_id || self.claimed.compare_exchange(false, true,
+            Ordering::AcqRel, Ordering::Acquire).is_err() { return None; }
+        *self.current_turn.lock().unwrap_or_else(std::sync::PoisonError::into_inner) = turn_id.to_owned();
+        Some(StagedInputBatch { turn_id: turn_id.to_owned(), ..self.batch.clone() })
+    }
+}
+
 /// Core publishes this view only after the next sampling agent has been selected.
 pub struct SelectedStagedInput(pub Arc<StagedInputBatch>);
 
