@@ -0,0 +1,275 @@
+use codex_utils_absolute_path::AbsolutePathBuf;
+#[cfg(target_os = "linux")]
+use std::collections::HashSet;
+#[cfg(target_os = "linux")]
+use std::fs;
+use std::io;
+#[cfg(target_os = "linux")]
+use std::os::unix::ffi::OsStringExt;
+#[cfg(target_os = "linux")]
+use std::os::unix::fs::MetadataExt;
+use std::path::Path;
+#[cfg(target_os = "linux")]
+use std::path::PathBuf;
+
+/// Canonical local write grants and the Linux mount entries they expose.
+pub struct LocalWriteRoots<'a> {
+    roots: &'a [AbsolutePathBuf],
+    #[cfg(target_os = "linux")]
+    mounts: WritableMounts,
+}
+
+impl<'a> LocalWriteRoots<'a> {
+    pub fn new(roots: &'a [AbsolutePathBuf]) -> io::Result<Self> {
+        #[cfg(target_os = "linux")]
+        let mounts = if roots.is_empty() {
+            WritableMounts::default()
+        } else {
+            WritableMounts::new(roots, &fs::read("/proc/self/mountinfo")?)?
+        };
+        Ok(Self {
+            roots,
+            #[cfg(target_os = "linux")]
+            mounts,
+        })
+    }
+
+    /// Includes a bind alias of this entry, or a mounted alias beneath a grant.
+    pub fn contains_entry(&self, path: &Path) -> io::Result<bool> {
+        if self
+            .roots
+            .iter()
+            .any(|root| path.starts_with(root.as_path()))
+        {
+            return Ok(true);
+        }
+        #[cfg(target_os = "linux")]
+        if !self.mounts.identities.is_empty()
+            && let Some(identity) = entry_identity(path)?
+        {
+            return Ok(self.mounts.identities.contains(&identity));
+        }
+        Ok(false)
+    }
+
+    /// Also includes mounts of existing children of the protected directory.
+    pub fn has_root_at_or_below(&self, path: &Path) -> io::Result<bool> {
+        if self
+            .roots
+            .iter()
+            .any(|root| root.as_path().starts_with(path))
+        {
+            return Ok(true);
+        }
+        #[cfg(target_os = "linux")]
+        return self.mounts.contains_descendant(path);
+        #[cfg(not(target_os = "linux"))]
+        Ok(false)
+    }
+}
+
+#[cfg(target_os = "linux")]
+type EntryIdentity = (u64, u64);
+
+#[cfg(target_os = "linux")]
+struct Mount {
+    destination: PathBuf,
+    // Pseudo filesystems can have a non-path root, such as nsfs "mnt:[inode]".
+    backing: Option<PathBuf>,
+}
+
+#[cfg(target_os = "linux")]
+impl Mount {
+    fn backing_path(&self, path: &Path) -> Option<PathBuf> {
+        let relative = path.strip_prefix(&self.destination).ok()?;
+        Some(self.backing.as_ref()?.join(relative))
+    }
+}
+
+#[cfg(target_os = "linux")]
+#[derive(Default)]
+struct WritableMounts {
+    mounts: Vec<Mount>,
+    identities: HashSet<EntryIdentity>,
+    backing_entries: HashSet<(PathBuf, EntryIdentity)>,
+}
+
+#[cfg(target_os = "linux")]
+impl WritableMounts {
+    fn new(roots: &[AbsolutePathBuf], mountinfo: &[u8]) -> io::Result<Self> {
+        let mut grants = Self::default();
+        for line in mountinfo
+            .split(|&byte| byte == b'\n')
+            .filter(|line| !line.is_empty())
+        {
+            let mut fields = line.split(|&byte| byte == b' ').skip(3);
+            let (Some(backing), Some(destination)) = (fields.next(), fields.next()) else {
+                return Err(io::Error::other("invalid mountinfo entry"));
+            };
+            grants.mounts.push(Mount {
+                destination: decode_mountinfo_path(destination)?,
+                backing: backing
+                    .starts_with(b"/")
+                    .then(|| decode_mountinfo_path(backing))
+                    .transpose()?,
+            });
+        }
+        for root in roots {
+            let identity = entry_identity(root.as_path())?.ok_or_else(|| {
+                io::Error::new(io::ErrorKind::NotFound, "local writable root disappeared")
+            })?;
+            grants.insert(root.as_path(), identity);
+        }
+        for index in 0..grants.mounts.len() {
+            let destination = &grants.mounts[index].destination;
+            if roots
+                .iter()
+                .any(|root| destination.starts_with(root.as_path()))
+                && let Some(identity) = entry_identity(destination)?
+            {
+                // Use the visible entry because mountinfo can also describe covered mounts.
+                grants.insert(&destination.clone(), identity);
+            }
+        }
+        Ok(grants)
+    }
+
+    fn insert(&mut self, path: &Path, identity: EntryIdentity) {
+        self.identities.insert(identity);
+        self.backing_entries.extend(
+            self.mounts
+                .iter()
+                .filter_map(|mount| Some((mount.backing_path(path)?, identity))),
+        );
+    }
+
+    fn contains_descendant(&self, path: &Path) -> io::Result<bool> {
+        for mount in &self.mounts {
+            let (directory, backing) = if let Some(backing) = mount.backing_path(path) {
+                (path, backing)
+            } else if mount.destination.starts_with(path)
+                && let Some(backing) = &mount.backing
+            {
+                (mount.destination.as_path(), backing.clone())
+            } else {
+                continue;
+            };
+            for (entry, identity) in &self.backing_entries {
+                // Mount roots propose a location. Stat the candidate to establish actual
+                // identity, including when a different mount covers the proposed path.
+                let Ok(relative) = entry.strip_prefix(&backing) else {
+                    continue;
+                };
+                // Adding a slash to a file mount's own path makes it unstatable.
+                let child = (!relative.as_os_str().is_empty()).then(|| directory.join(relative));
+                if entry_identity(child.as_deref().unwrap_or(directory))? == Some(*identity) {
+                    return Ok(true);
+                }
+            }
+        }
+        Ok(false)
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn entry_identity(path: &Path) -> io::Result<Option<EntryIdentity>> {
+    match fs::symlink_metadata(path) {
+        Ok(metadata) => Ok(Some((metadata.dev(), metadata.ino()))),
+        Err(error)
+            if matches!(
+                error.kind(),
+                io::ErrorKind::NotFound | io::ErrorKind::NotADirectory
+            ) =>
+        {
+            Ok(None)
+        }
+        Err(error) => Err(error),
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub fn decode_mountinfo_path(encoded: &[u8]) -> io::Result<PathBuf> {
+    let mut decoded = Vec::new();
+    let mut bytes = encoded.iter().copied();
+    while let Some(byte) = bytes.next() {
+        decoded.push(if byte == b'\\' {
+            let digits: Vec<_> = bytes.by_ref().take(3).collect();
+            match digits.as_slice() {
+                b"040" => b' ',
+                b"011" => b'\t',
+                b"012" => b'\n',
+                b"134" => b'\\',
+                _ => return Err(io::Error::other("invalid mountinfo path escape")),
+            }
+        } else {
+            byte
+        });
+    }
+    let path = PathBuf::from(std::ffi::OsString::from_vec(decoded));
+    if !path.is_absolute() {
+        return Err(io::Error::other("mountinfo path is not absolute"));
+    }
+    Ok(path)
+}
+
+#[cfg(all(test, target_os = "linux"))]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nested_mount_exposes_the_helper_identity() -> io::Result<()> {
+        let temp = tempfile::tempdir()?;
+        let workspace = temp.path().join("work space");
+        fs::create_dir(&workspace)?;
+        let protected = temp.path().join("protected");
+        fs::create_dir(&protected)?;
+        let helper = protected.join("helper");
+        fs::write(&helper, "synthetic helper")?;
+        let alias = workspace.join("mount");
+        // A hard link supplies the same file identity without a privileged mount.
+        fs::hard_link(&helper, &alias)?;
+        let sibling = temp.path().join("sibling");
+        fs::write(&sibling, "other file")?;
+        let mountinfo = format!(
+            "3 1 0:1 / / rw - ext4 /dev/fixture rw\n7 3 0:1 {} {} rw - ext4 /dev/fixture rw\n",
+            helper.display(),
+            alias.to_str().unwrap().replace(' ', "\\040")
+        );
+        let roots = [AbsolutePathBuf::from_absolute_path(&workspace)?];
+        let grants = LocalWriteRoots {
+            roots: &roots,
+            mounts: WritableMounts::new(&roots, mountinfo.as_bytes())?,
+        };
+        assert!(grants.contains_entry(&helper)?);
+        assert!(grants.has_root_at_or_below(&protected)?);
+        assert!(!grants.has_root_at_or_below(&sibling)?);
+        assert!(!grants.contains_entry(&sibling)?);
+        assert!(!grants.contains_entry(&temp.path().join("missing"))?);
+        Ok(())
+    }
+
+    #[test]
+    fn aliases_of_the_same_file_include_a_mount_inside_the_protected_directory() -> io::Result<()> {
+        let temp = tempfile::tempdir()?;
+        let workspace = temp.path().join("workspace");
+        let protected = temp.path().join("protected");
+        fs::create_dir(&workspace)?;
+        fs::create_dir(&protected)?;
+        let backing = temp.path().join("backing");
+        fs::write(&backing, "synthetic protected state")?;
+        let protected_file = protected.join("state");
+        let writable_file = workspace.join("alias");
+        fs::hard_link(&backing, &protected_file)?;
+        fs::hard_link(&backing, &writable_file)?;
+        let mountinfo = format!(
+            "3 1 0:1 / / rw - ext4 /dev/fixture rw\n7 3 0:1 {0} {1} rw - ext4 /dev/fixture rw\n8 3 0:1 {0} {2} rw - ext4 /dev/fixture rw\n",
+            backing.display(),
+            protected_file.display(),
+            writable_file.display(),
+        );
+        let roots = [AbsolutePathBuf::from_absolute_path(&workspace)?];
+        let grants = WritableMounts::new(&roots, mountinfo.as_bytes())?;
+        assert!(grants.contains_descendant(&protected)?);
+        Ok(())
+    }
+}
