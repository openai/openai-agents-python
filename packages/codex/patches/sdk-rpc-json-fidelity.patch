+// Inspect syntax before generic Value decoding so literal maps stay distinct
+// from serde_json's synthetic arbitrary-precision number representation.
+fn bounded_raw_value(
+    raw: &RawValue,
+    remaining: &mut usize,
+    depth: usize,
+) -> serde_json::Result<Value> {
+    let Some(next) = remaining.checked_sub(1) else {
+        return Err(de::Error::custom(format!(
+            "JSON-RPC message exceeds the limit of {MAX_JSONRPC_VALUE_NODES} JSON values"
+        )));
+    };
+    *remaining = next;
+    let kind = raw.get().trim_start().as_bytes().first();
+    if matches!(kind, Some(b'{' | b'[')) && depth >= 127 {
+        return Err(de::Error::custom("recursion limit exceeded"));
+    }
+    let visitor = BoundedValueVisitor { remaining, depth };
+    match kind {
+        Some(b'{') => serde_json::Deserializer::from_str(raw.get()).deserialize_map(visitor),
+        Some(b'[') => serde_json::Deserializer::from_str(raw.get()).deserialize_seq(visitor),
+        _ => serde_json::from_str(raw.get()),
+    }
+}
