 pub struct OpeningContext(Context);
 
+/// An operation-scoped host decision for actual managed MCP catalog requests.
+pub trait McpDiscoverySpanPolicy: Send + Sync {
+    fn admit<'a>(
+        &'a self,
+        parent: &'a ContextLease,
+        server: &'a str,
+    ) -> std::pin::Pin<
+        Box<dyn std::future::Future<Output = Result<McpDiscoverySpanAdmission, String>> + Send + 'a>,
+    >;
+}
+
+pub enum McpDiscoverySpanAdmission {
+    Suppress,
+    Record(Option<String>),
+}
+
+struct OpeningMcpDiscoveryPolicy(Arc<dyn McpDiscoverySpanPolicy>);
+
+pub async fn start_sdk_mcp_discovery_span(server: &str) -> Result<Option<ProviderResponseSpan>, String> {
+    let current = current_submission_context();
+    let Some(policy) = policy_for_context(&current) else {
+        return Ok(None);
+    };
+    if policy.disabled || policy.restriction_only {
+        return Ok(None);
+    }
+    let host = current
+        .get::<OpeningMcpDiscoveryPolicy>()
+        .map(|owner| Arc::clone(&owner.0));
+    let Some(token) = context_token_for(current) else {
+        return Ok(None);
+    };
+    let parent = ContextLease { token };
+    let span_id = if policy.named_tool_policy {
+        let Some(host) = host else {
+            return Ok(None);
+        };
+        match host.admit(&parent, server).await? {
+            McpDiscoverySpanAdmission::Suppress => return Ok(None),
+            McpDiscoverySpanAdmission::Record(span_id) => span_id,
+        }
+    } else {
+        None
+    };
+    let span = start_sdk_semantic_span(&parent, span_id, server.to_owned(), "mcp_tools");
+    if policy.named_tool_policy {
+        span.map(Some)
+    } else {
+        // An observer-only span cannot make MCP discovery fail.
+        Ok(span.ok())
+    }
+}
