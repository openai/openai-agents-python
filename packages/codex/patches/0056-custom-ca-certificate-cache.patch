+    ) -> Result<Arc<[reqwest::Certificate]>, BuildCustomCaTransportError> {
+        // Always read first, including after a hit. Rotation, deletion and access
+        // errors retain their current file/env context; errors are never cached.
+        let result = (|| {
+            let pem_data = self.read_pem_data()?;
+            // Keep PEM normalization and its tracing events outside the lock.
+            // Cache only the expensive reqwest/native-TLS certificate wrappers.
+            let certificates = self.parse_certificate_bytes(&pem_data)?;
+            info!(
+                source_env = self.source_env,
+                ca_path = %self.path.display(),
+                certificate_count = certificates.len(),
+                "loaded certificates from custom CA bundle"
+            );
+            let der_bytes = certificates
+                .iter()
+                .map(|certificate| certificate.len())
+                .sum();
+            let parse =
+                || -> Result<(Arc<[reqwest::Certificate]>, usize), BuildCustomCaTransportError> {
+                    let certificates = certificates
+                        .iter()
+                        .enumerate()
+                        .map(|(idx, cert)| {
+                            reqwest::Certificate::from_der(cert.as_ref()).map_err(|source| {
+                                BuildCustomCaTransportError::RegisterCertificate {
+                                    source_env: self.source_env,
+                                    path: self.path.clone(),
+                                    certificate_index: idx + 1,
+                                    source,
+                                }
+                            })
+                        })
+                        .collect::<Result<Vec<_>, _>>()?;
+                    Ok((Arc::from(certificates), der_bytes))
+                };
+            // Avoid monopolizing the cache for unusually large input. The same
+            // parsing/errors still apply, but none of this input is retained.
+            if pem_data.len() > CA_CACHE_MAX_BYTES
+                || certificates.len() > CA_CACHE_MAX_CERTIFICATES
+                || der_bytes > CA_CACHE_MAX_BYTES
+            {
+                return parse().map(|(certificates, _)| certificates);
+            }
+            let digest = Sha256::digest(&pem_data).into();
+            // Coalesce concurrent wrapper construction. No file I/O, tracing,
+            // await or client construction occurs under this lock. A poisoned cache can
+            // recover: entries change only after a successful parse completes.
+            cache
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .load(digest, parse)
+        })();
+        match &result {
+            Ok(_) => {}
+            Err(BuildCustomCaTransportError::RegisterCertificate {
+                certificate_index,
+                source,
+                ..
+            }) => warn!(
+                source_env = self.source_env,
+                ca_path = %self.path.display(),
+                certificate_index,
+                error = %source,
+                "failed to register CA certificate"
+            ),
+            Err(error) => warn!(
+                source_env = self.source_env,
+                ca_path = %self.path.display(),
+                error = %error,
+                "failed to load custom CA bundle"
+            ),
+        }
