+//! Positive parse caching must not cache file authority, errors or TLS clients.
+use super::*;
+use pretty_assertions::assert_eq;
+use std::io::Read;
+use std::io::Write;
+use std::net::TcpListener;
+use std::sync::Barrier;
+use std::time::Duration;
+
+const FIRST_CA: &str = include_str!("../tests/fixtures/test-ca.pem");
+const SECOND_CA: &str = include_str!("../tests/fixtures/test-intermediate.pem");
+
+fn bundle(path: &Path) -> ConfiguredCaBundle {
+    ConfiguredCaBundle {
+        source_env: SSL_CERT_FILE_ENV,
+        path: path.to_owned(),
+    }
+}
+
+#[test]
+fn identical_public_certificates_are_reused_across_files_and_rotation_is_fresh() {
+    let temp = tempfile::TempDir::new().unwrap();
+    let first_path = temp.path().join("first.pem");
+    let second_path = temp.path().join("second.pem");
+    fs::write(&first_path, FIRST_CA).unwrap();
+    fs::write(&second_path, FIRST_CA).unwrap();
+    let cache = Mutex::new(ReqwestCaCache::default());
+    let first = bundle(&first_path)
+        .load_reqwest_certificates(&cache)
+        .unwrap();
+    let same = bundle(&second_path)
+        .load_reqwest_certificates(&cache)
+        .unwrap();
+    assert!(Arc::ptr_eq(&first, &same));
+    fs::write(&first_path, SECOND_CA).unwrap();
+    let rotated = bundle(&first_path)
+        .load_reqwest_certificates(&cache)
+        .unwrap();
+    assert!(!Arc::ptr_eq(&first, &rotated));
+    assert_eq!(rotated.len(), 1);
+    fs::write(&first_path, FIRST_CA).unwrap();
+    assert!(Arc::ptr_eq(
+        &first,
+        &bundle(&first_path)
+            .load_reqwest_certificates(&cache)
+            .unwrap()
+    ));
+}
+
+#[test]
+fn invalid_der_empty_and_missing_files_never_use_a_warm_hit_or_cache_errors() {
+    let temp = tempfile::TempDir::new().unwrap();
+    let path = temp.path().join("current.pem");
+    let cache = Mutex::new(ReqwestCaCache::default());
+    fs::write(&path, FIRST_CA).unwrap();
+    bundle(&path).load_reqwest_certificates(&cache).unwrap();
+    for contents in [
+        "",
+        "-----BEGIN CERTIFICATE-----\nAAAA\n-----END CERTIFICATE-----\n",
+    ] {
+        fs::write(&path, contents).unwrap();
+        for _ in 0..2 {
+            let error = bundle(&path)
+                .load_reqwest_certificates(&cache)
+                .err()
+                .unwrap();
+            match error {
+                BuildCustomCaTransportError::InvalidCaFile {
+                    path: actual,
+                    source_env,
+                    ..
+                }
+                | BuildCustomCaTransportError::RegisterCertificate {
+                    path: actual,
+                    source_env,
+                    ..
+                } => {
+                    assert_eq!(actual, path);
+                    assert_eq!(source_env, SSL_CERT_FILE_ENV);
+                }
+                error => panic!("unexpected error: {error}"),
+            }
+        }
+        assert_eq!(cache.lock().unwrap().entries.len(), 1);
+    }
+    fs::remove_file(&path).unwrap();
+    assert!(matches!(
+        bundle(&path).load_reqwest_certificates(&cache),
+        Err(BuildCustomCaTransportError::ReadCaFile { source, .. })
+            if source.kind() == io::ErrorKind::NotFound
+    ));
+    fs::write(&path, SECOND_CA).unwrap();
+    assert_eq!(
+        bundle(&path)
+            .load_reqwest_certificates(&cache)
+            .unwrap()
+            .len(),
+        1
+    );
+}
+
+#[test]
+fn simultaneous_loads_share_the_success_and_poison_recovery_retains_valid_entries() {
+    let temp = tempfile::TempDir::new().unwrap();
+    let path = temp.path().join("current.pem");
+    fs::write(&path, FIRST_CA).unwrap();
+    let cache = Arc::new(Mutex::new(ReqwestCaCache::default()));
+    let barrier = Arc::new(Barrier::new(8));
+    let threads = (0..8)
+        .map(|_| {
+            let cache = cache.clone();
+            let barrier = barrier.clone();
+            let path = path.clone();
+            std::thread::spawn(move || {
+                barrier.wait();
+                bundle(&path).load_reqwest_certificates(&cache).unwrap()
+            })
+        })
+        .collect::<Vec<_>>();
+    let values = threads
+        .into_iter()
+        .map(|thread| thread.join().unwrap())
+        .collect::<Vec<_>>();
+    assert!(values.iter().all(|value| Arc::ptr_eq(value, &values[0])));
+    let poisoned = cache.clone();
+    assert!(
+        std::thread::spawn(move || {
+            let _guard = poisoned.lock().unwrap();
+            panic!("synthetic cache poison");
+        })
+        .join()
+        .is_err()
+    );
+    assert!(Arc::ptr_eq(
+        &values[0],
+        &bundle(&path).load_reqwest_certificates(&cache).unwrap()
+    ));
+}
+
+#[test]
+fn cache_evicts_old_entries_and_does_not_retain_oversized_inputs() {
+    let temp = tempfile::TempDir::new().unwrap();
+    let path = temp.path().join("current.pem");
+    let cache = Mutex::new(ReqwestCaCache::default());
+    fs::write(&path, FIRST_CA).unwrap();
+    let first = bundle(&path).load_reqwest_certificates(&cache).unwrap();
+    for index in 0..CA_CACHE_MAX_ENTRIES {
+        fs::write(&path, format!("# distinct content {index}\n{FIRST_CA}")).unwrap();
+        bundle(&path).load_reqwest_certificates(&cache).unwrap();
+    }
+    assert_eq!(cache.lock().unwrap().entries.len(), CA_CACHE_MAX_ENTRIES);
+    fs::write(&path, FIRST_CA).unwrap();
+    assert!(!Arc::ptr_eq(
+        &first,
+        &bundle(&path).load_reqwest_certificates(&cache).unwrap()
+    ));
+    let large = format!(
+        "# {}\n{FIRST_CA}",
+        "padding".repeat(CA_CACHE_MAX_BYTES / 7 + 1)
+    );
+    fs::write(&path, large).unwrap();
+    let uncached = bundle(&path).load_reqwest_certificates(&cache).unwrap();
+    assert!(!Arc::ptr_eq(
+        &uncached,
+        &bundle(&path).load_reqwest_certificates(&cache).unwrap()
+    ));
+    assert_eq!(cache.lock().unwrap().entries.len(), CA_CACHE_MAX_ENTRIES);
+}
+
+#[test]
+fn retained_certificate_count_and_der_bytes_are_bounded() {
+    let certificate = reqwest::Certificate::from_pem(FIRST_CA.as_bytes()).unwrap();
+    let mut cache = ReqwestCaCache::default();
+    for index in 0..8 {
+        cache
+            .load([index; 32], || {
+                Ok((
+                    Arc::from(vec![certificate.clone(); 256]),
+                    CA_CACHE_MAX_BYTES / 4,
+                ))
+            })
+            .unwrap();
+        assert!(cache.entries.len() <= CA_CACHE_MAX_ENTRIES);
+        assert!(
+            cache
+                .entries
+                .iter()
+                .map(|entry| entry.certificates.len())
+                .sum::<usize>()
+                <= CA_CACHE_MAX_CERTIFICATES
+        );
+        assert!(
+            cache
+                .entries
+                .iter()
+                .map(|entry| entry.der_bytes)
+                .sum::<usize>()
+                <= CA_CACHE_MAX_BYTES
+        );
+    }
+    let prior = cache.entries.len();
+    cache
+        .load([99; 32], || {
+            Ok((
+                Arc::from(vec![certificate.clone(); CA_CACHE_MAX_CERTIFICATES + 1]),
+                1,
+            ))
+        })
+        .unwrap();
+    cache
+        .load([100; 32], || {
+            Ok((Arc::from(vec![certificate]), CA_CACHE_MAX_BYTES + 1))
+        })
+        .unwrap();
+    assert_eq!(cache.entries.len(), prior);
+}
+
+#[tokio::test]
+async fn warm_certificates_preserve_tls_verification_and_rotation_removes_old_trust() {
+    use rcgen::BasicConstraints;
+    use rcgen::CertificateParams;
+    use rcgen::CertifiedIssuer;
+    use rcgen::IsCa;
+    use rcgen::KeyPair;
+    ensure_rustls_crypto_provider();
+    let root = || {
+        let mut params = CertificateParams::default();
+        params.is_ca = IsCa::Ca(BasicConstraints::Unconstrained);
+        CertifiedIssuer::self_signed(params, KeyPair::generate().unwrap()).unwrap()
+    };
+    let first_root = root();
+    let second_root = root();
+    let server = |issuer: &CertifiedIssuer<'_, KeyPair>| {
+        let key = KeyPair::generate().unwrap();
+        let leaf = CertificateParams::new(vec!["localhost".to_string()])
+            .unwrap()
+            .signed_by(&key, issuer)
+            .unwrap();
+        Arc::new(
+            rustls::ServerConfig::builder()
+                .with_no_client_auth()
+                .with_single_cert(vec![leaf.der().clone()], key.into())
+                .unwrap(),
+        )
+    };
+    let first_server = server(&first_root);
+    let second_server = server(&second_root);
+    let temp = tempfile::TempDir::new().unwrap();
+    let path = temp.path().join("current.pem");
+    let cache = Mutex::new(ReqwestCaCache::default());
+    fs::write(&path, first_root.pem()).unwrap();
+    let cold = bundle(&path).load_reqwest_certificates(&cache).unwrap();
+    let warm = bundle(&path).load_reqwest_certificates(&cache).unwrap();
+    assert!(Arc::ptr_eq(&cold, &warm));
+    assert!(request(&cold, first_server.clone()).await);
+    assert!(request(&warm, first_server.clone()).await);
+    assert!(!request(&warm, second_server.clone()).await);
+    fs::write(&path, second_root.pem()).unwrap();
+    let rotated = bundle(&path).load_reqwest_certificates(&cache).unwrap();
+    assert!(!request(&rotated, first_server).await);
+    assert!(request(&rotated, second_server).await);
+}
+
+async fn request(certificates: &[reqwest::Certificate], config: Arc<rustls::ServerConfig>) -> bool {
+    let mut builder = reqwest::Client::builder()
+        .use_rustls_tls()
+        .tls_built_in_root_certs(false)
+        .no_proxy()
+        .timeout(Duration::from_secs(5));
+    for certificate in certificates {
+        builder = builder.add_root_certificate(certificate.clone());
+    }
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    listener.set_nonblocking(true).unwrap();
+    let address = listener.local_addr().unwrap();
+    let client = builder.resolve("localhost", address).build().unwrap();
+    let server = std::thread::spawn(move || {
+        let deadline = std::time::Instant::now() + Duration::from_secs(5);
+        let (socket, _) = loop {
+            match listener.accept() {
+                Ok(connection) => break connection,
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => {
+                    assert!(
+                        std::time::Instant::now() < deadline,
+                        "TLS client did not connect"
+                    );
+                    std::thread::sleep(Duration::from_millis(10));
+                }
+                Err(error) => panic!("TLS listener failed: {error}"),
+            }
+        };
+        socket.set_nonblocking(false).unwrap();
+        socket
+            .set_read_timeout(Some(Duration::from_secs(5)))
+            .unwrap();
+        socket
+            .set_write_timeout(Some(Duration::from_secs(5)))
+            .unwrap();
+        let mut stream =
+            rustls::StreamOwned::new(rustls::ServerConnection::new(config).unwrap(), socket);
+        let mut input = [0; 4096];
+        if stream.read(&mut input).is_ok() {
+            let _ = stream
+                .write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok");
+            let _ = stream.flush();
+        }
+    });
+    let success = match client
+        .get(format!("https://localhost:{}/", address.port()))
+        .send()
+        .await
+    {
+        Ok(response) => {
+            response.status() == reqwest::StatusCode::OK && response.text().await.unwrap() == "ok"
+        }
+        Err(error) => {
+            assert!(error.is_connect());
+            false
+        }
+    };
+    server.join().unwrap();
+    success
+}
