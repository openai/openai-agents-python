+//! Embedded data can be shared; returned catalog/config ownership cannot.
+use super::*;
+use codex_protocol::openai_models::ModelsResponse;
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+use std::sync::Barrier;
+
+const EMBEDDED: &str = include_str!("../models.json");
+
+#[test]
+fn cached_catalog_matches_fresh_json_and_returns_independent_owned_models() {
+    let expected: ModelsResponse = serde_json::from_str(EMBEDDED).unwrap();
+    let mut first = bundled_models_response().unwrap();
+    assert_eq!(first, expected);
+    assert!(!first.models.is_empty());
+    first.models[0].slug = "caller-owned-model".to_string();
+    first.models[0]
+        .model_messages
+        .get_or_insert_default()
+        .instructions_template = Some("caller-owned instructions".to_string());
+    first.models.pop();
+    assert_eq!(bundled_models_response().unwrap(), expected);
+}
+
+#[test]
+fn concurrent_calls_preserve_catalogs_and_owned_return_values() {
+    let barrier = Arc::new(Barrier::new(8));
+    let workers = (0..8)
+        .map(|_| {
+            let barrier = barrier.clone();
+            std::thread::spawn(move || {
+                barrier.wait();
+                bundled_models_response().unwrap()
+            })
+        })
+        .collect::<Vec<_>>();
+    let mut results = workers
+        .into_iter()
+        .map(|worker| worker.join().unwrap())
+        .collect::<Vec<_>>();
+    let expected: ModelsResponse = serde_json::from_str(EMBEDDED).unwrap();
+    assert!(results.iter().all(|result| result == &expected));
+    results[0].models.clear();
+    assert!(results[1..].iter().all(|result| result == &expected));
+    assert_eq!(bundled_models_response().unwrap(), expected);
+}
+
+#[test]
+fn per_lookup_model_settings_do_not_modify_the_embedded_seed() {
+    let original = bundled_models_response().unwrap();
+    let selected = original.models.first().unwrap().clone();
+    let overrides = ModelsManagerConfig {
+        base_instructions: Some("current session instructions".to_string()),
+        ..ModelsManagerConfig::default()
+    };
+    let changed = model_info::with_config_overrides(selected, &overrides);
+    assert_eq!(
+        changed
+            .model_messages
+            .unwrap()
+            .instructions_template
+            .as_deref(),
+        Some("current session instructions")
+    );
+    assert_eq!(bundled_models_response().unwrap(), original);
+}
