+            .as_deref(),
+        Some(saved_revision.as_str())
+    );
+    assert!(
+        store
+            .read_thread(ReadThreadParams {
+                thread_id: source,
+                include_archived: true,
+                include_history: false
+            })
+            .await
+            .is_err()
+    );
+    assert!(
+        ThreadStore::read_thread_by_rollout_path(
+            &store,
+            ReadThreadByRolloutPathParams {
+                rollout_path: source_path.clone(),
+                include_archived: true,
+                include_history: false,
+            }
+        )
+        .await
+        .is_err()
+    );
+    assert!(
+        store
+            .resume_thread(ResumeThreadParams {
+                thread_id: source,
+                rollout_path: Some(source_path),
+                history: None,
+                history_revision: None,
+                include_archived: true,
+                metadata: metadata(),
+            })
+            .await
+            .is_err()
+    );
+    assert!(store.create_thread(create(&store, source)).await.is_err());
+    let page = store
+        .list_threads_including_empty_preview(listing(false))
+        .await
+        .unwrap();
+    assert_eq!(
+        page.items
+            .iter()
+            .map(|thread| thread.thread_id)
+            .collect::<Vec<_>>(),
+        vec![child]
+    );
+    assert!(
+        store
+            .list_threads_including_empty_preview(listing(true))
+            .await
+            .unwrap()
+            .items
+            .is_empty()
+    );
+    let cold = store
+        .load_original_history(LoadThreadHistoryParams {
+            thread_id: child,
+            include_archived: true,
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        serde_json::to_value(&cold.items).unwrap(),
+        serde_json::to_value(&original.items).unwrap()
+    );
+    let resumed = store
+        .resume_thread(ResumeThreadParams {
+            thread_id: child,
+            rollout_path: Some(child_path),
+            history: Some(saved_child.clone()),
+            history_revision: Some(saved_revision),
+            include_archived: true,
+            metadata: metadata(),
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        serde_json::to_value(&*resumed).unwrap(),
+        serde_json::to_value(&*saved_child).unwrap()
+    );
+    store.shutdown_thread(child).await.unwrap();
+}
+
+#[tokio::test]
+async fn supplied_history_cannot_resume_another_owners_retired_rollout() {
+    let home = TempDir::new().unwrap();
+    let config = test_config(home.path());
+    let db = codex_state::StateRuntime::init(
+        config.sqlite.clone(),
+        config.default_model_provider_id.clone(),
+    )
+    .await
+    .unwrap();
+    let store = LocalThreadStore::new(config, Some(db));
+    let source = ThreadId::new();
+    store.create_thread(create(&store, source)).await.unwrap();
+    store
+        .persist_thread(source, PersistContext::Standard)
+        .await
+        .unwrap();
+    let source_path = store.live_rollout_path(source).await.unwrap();
+    store.shutdown_thread(source).await.unwrap();
+    store.retire_thread_owner(source).await.unwrap();
+    let bytes = tokio::fs::read(&source_path).await.unwrap();
+    let error = store
+        .resume_thread(ResumeThreadParams {
+            thread_id: ThreadId::new(),
+            rollout_path: Some(source_path.clone()),
+            history: Some(Arc::new(Vec::new())),
+            history_revision: None,
+            include_archived: true,
+            metadata: metadata(),
+        })
+        .await
+        .unwrap_err();
+    assert!(matches!(
+        error,
+        crate::ThreadStoreError::InvalidRequest { .. }
+    ));
+    assert_eq!(tokio::fs::read(&source_path).await.unwrap(), bytes);
+}
