index 00000000..ba5a0d45
--- /dev/null
+++ b/codex-rs/thread-store/src/local/retired_owner.rs
@@ -0,0 +1,50 @@
+//! Logical owner retirement; immutable shared rollout IDs remain readable by descendants.
+
+use codex_protocol::ThreadId;
+
+use super::LocalThreadStore;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+
+impl LocalThreadStore {
+    /// Retires only the public owner. This does not promise physical erasure of shared data.
+    pub async fn retire_thread_owner(&self, thread_id: ThreadId) -> ThreadStoreResult<()> {
+        let _lifecycle = self.live_writer_locks.lock_lifecycle(thread_id).await;
+        let _writer = self.live_writer_locks.lock(thread_id).await;
+        self.ensure_live_recorder_absent(thread_id).await?;
+        let _writer_lock = self.acquire_writer_lock(thread_id)?;
+        let state = self.state_db().await.ok_or(ThreadStoreError::Unsupported {
+            operation: "retire_thread_owner",
+        })?;
+        if !state
+            .retire_thread_owner(thread_id)
+            .await
+            .map_err(|error| ThreadStoreError::Internal {
+                message: format!("failed to retire stored thread owner: {error}"),
+            })?
+        {
+            return Err(ThreadStoreError::ThreadNotFound { thread_id });
+        }
+        Ok(())
+    }
+
+    pub(super) async fn check_thread_not_retired(
+        &self,
+        thread_id: ThreadId,
+    ) -> ThreadStoreResult<()> {
+        if let Some(state) = self.state_db().await
+            && state.is_thread_retired(thread_id).await.map_err(|error| {
+                ThreadStoreError::Internal {
+                    message: format!("failed to read stored thread retirement: {error}"),
+                }
+            })?
+        {
+            return Err(ThreadStoreError::ThreadNotFound { thread_id });
+        }
+        Ok(())
+    }
+}
+
