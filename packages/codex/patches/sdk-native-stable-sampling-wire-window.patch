+/// Reuse the exact accepted wire view when new canonical input has moved its
+/// request-only suffix. The old canonical receipt still validates independently
+/// in prepare(). No caller-provided map or new persisted receipt enters here.
+fn stable_sampling_wire_indices(
+    window: &ProviderHistoryWindowReceipt,
+    canonical: &ProviderHistoryWindowReceipt,
+    projection: &codex_api::ProviderHistoryInputProjection,
+    wire: &[ResponseItem],
+) -> Result<Option<Vec<usize>>> {
+    // Omitted canonical occurrences and MCP output rewrites retain their existing
+    // dedicated admission paths. This fallback proves a complete ordered view.
+    if window.canonical_tail_sha256.is_some()
+        || projection.sampling_canonical_indices.len() != projection.sampling_item_sha256.len()
+        || projection.prefix_len + projection.wire_input_indices.len() != wire.len()
+    {
+        return Ok(None);
+    }
+    let unsent = unsent_hash_indices(canonical, &projection.item_sha256)?
+        .into_iter().collect::<std::collections::HashSet<_>>();
+    let acknowledged = (0..projection.item_sha256.len())
+        .filter(|index| !unsent.contains(index)).collect::<Vec<_>>();
+    let mut next_acknowledged = 0;
+    let mut prior_wire = wire[..projection.prefix_len].iter().collect::<Vec<_>>();
+    let mut selected = (0..projection.prefix_len).collect::<Vec<_>>();
+    for (offset, source) in projection.wire_input_indices.iter().enumerate() {
+        let position = projection.prefix_len + offset;
+        let item = &wire[position];
+        match projection.sampling_canonical_indices.get(*source).copied().flatten() {
+            Some(origin) if !unsent.contains(&origin) => {
+                if acknowledged.get(next_acknowledged) != Some(&origin) {
+                    return Ok(None);
+                }
+                next_acknowledged += 1;
+                if origin < canonical.input_len {
+                    prior_wire.push(item);
+                } else if projection.sampling_item_sha256[*source]
+                    != projection.item_sha256[origin]
+                {
+                    // The last acknowledged response output cannot acquire a
+                    // different wire body through this stable input fallback.
+                    return Ok(None);
+                }
+            }
+            Some(origin) if origin < projection.item_sha256.len() => {
+                selected.push(position);
+            }
+            Some(_) => return Ok(None),
+            None => {
+                prior_wire.push(item);
+                selected.push(position);
+            }
+        }
+    }
+    if next_acknowledged != acknowledged.len()
+        || prior_wire.len() != window.input_len
+        || input_digest(prior_wire)? != window.input_sha256
+    {
+        return Ok(None);
+    }
+    Ok(Some(selected))
+}
