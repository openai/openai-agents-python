+    CodeInterpreter {},
+    ImageGeneration {},
+    Computer {},
+    ComputerUsePreview {},
+    Shell {},
+    ApplyPatch {},
+    ToolSearch {},
+    Mcp {
+        server_label: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        name: Option<String>,
+    },
