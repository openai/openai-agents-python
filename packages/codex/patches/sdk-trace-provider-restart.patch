+static GENERATION: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct TraceGeneration(u64);
+
+impl Default for TraceGeneration {
+    fn default() -> Self {
+        Self(GENERATION.load(Ordering::Acquire))
+    }
+}
+
+impl TraceGeneration {
+    pub(crate) fn is_current(self) -> bool {
+        self == Self::default()
+    }
+}
+
+/// Open a new delivery generation after the host has retired the previous provider.
+pub(crate) fn restart_host_trace_delivery() -> Result<(), String> {
+    let mut routes = lock();
+    if !routes.credentials_closed || !routes.pending.is_empty() || !routes.queue.is_empty() {
+        return Err("Telemetry restart requires retired trace delivery".into());
+    }
+    *routes = Routes {
+        sequence: routes.sequence,
+        acknowledged: routes.sequence,
+        delivered: routes.sequence,
+        next_credential: routes.next_credential,
+        ..Routes::default()
+    };
+    GENERATION.fetch_add(1, Ordering::AcqRel);
+    Ok(())
+}
