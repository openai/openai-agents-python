+        ImagePreparationMode::UnifiedBudget,
+    ] {
+        let (image_url, _) = png_data_url(64, 32);
+        let mut items = vec![ResponseItem::Message {
+            id: None,
+            role: "user".into(),
+            content: vec![ContentItem::InputImage {
+                image: ImageReference::Inline { image_url },
+                detail: Some(ImageDetail::Low),
+            }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }];
+        prepare_response_items(
+            "inline",
+            &mut items,
+            mode,
+            reference_policy_for_model(
+                ProviderImageReferencePolicy::QualifiedStandardResponses,
+                false,
+                mode == ImagePreparationMode::UnifiedBudget,
+            ),
+            ImageResizeNoticeMode::Disabled,
+            &InlineAttachmentStore,
+        )
+        .await;
+        let ResponseItem::Message { content, .. } = &items[0] else {
+            panic!("message")
+        };
+        if mode == ImagePreparationMode::DetailBased {
+            assert_eq!(
+                content[0],
+                ContentItem::InputText {
+                    text: UNSUPPORTED_LOW_DETAIL_PLACEHOLDER.into()
+                }
+            );
+        } else {
+            assert!(matches!(
+                &content[0],
+                ContentItem::InputImage {
+                    detail: Some(ImageDetail::Original),
+                    ..
+                }
+            ));
+        }
+    }
+}
