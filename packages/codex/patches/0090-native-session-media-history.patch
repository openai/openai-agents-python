@@ -0,0 +1,330 @@
+//! Exercise Core's recovery lifecycle and request boundary. SDK grant tests
+//! remain a separate bridge gate; this fixture supplies a narrow test policy.
+use codex_core::RecoverTurnRequest;
+use codex_extension_api::{
+    ExtensionData, ExtensionFuture, ExtensionRegistryBuilder, RecoveredToolCompletionCandidates,
+    ToolCompletionDecision, ToolCompletionInput, ToolContributor, TurnLifecycleContributor,
+    TurnStartInput,
+};
+use codex_history::RolloutItem;
+use codex_protocol::{
+    config_types::AutoCompactTokenLimitScope,
+    models::ResponseItem,
+    protocol::{
+        EventMsg, Op, ResponseObservation, ResponseObservationRecord, ResponseObservationStatus,
+        TurnStartedEvent,
+    },
+};
+use codex_thread_store::{AppendThreadItemsParams, InMemoryThreadStore};
+use codex_tools::{ToolCall, ToolExecutor};
+use core_test_support::{
+    responses::{
+        ev_assistant_message, ev_completed, mount_sse_once, mount_sse_sequence, sse,
+        start_mock_server,
+    },
+    test_codex::test_codex,
+    wait_for_event,
+};
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, AtomicUsize, Ordering},
+};
+use test_case::test_case;
+
+const TURN: &str = "recovered-manual";
+const LARGE: &str = "RECOVERY_BODY_THAT_COMPACTION_MUST_REPLACE ";
+struct MainCatalog(usize);
+struct HistoryCatalog;
+#[derive(Clone, Copy)]
+enum RecoveryCase {
+    Accept,
+    SingleFresh,
+    AllFresh,
+    Continue,
+    FailedSibling,
+    UnknownSibling,
+    NoFreshReceipt,
+}
+struct RecoveryPolicy {
+    case: RecoveryCase,
+    consumed: AtomicBool,
+    captures: AtomicUsize,
+    history_captures: AtomicUsize,
+    starts: AtomicUsize,
+    proposals: AtomicUsize,
+}
+impl TurnLifecycleContributor for RecoveryPolicy {
+    fn on_turn_start<'a>(&'a self, input: TurnStartInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            self.starts.fetch_add(1, Ordering::SeqCst);
+            if input.turn_id != TURN || self.consumed.swap(true, Ordering::SeqCst) {
+                return;
+            }
+            let mut outcomes = vec![("prefix".into(), true), ("fresh".into(), true)];
+            match self.case {
+                RecoveryCase::FailedSibling => outcomes[0].1 = false,
+                RecoveryCase::UnknownSibling => {
+                    outcomes.remove(0);
+                }
+                RecoveryCase::SingleFresh => {
+                    outcomes.remove(0);
+                }
+                _ => {}
+            }
+            input.turn_store.insert(RecoveredToolCompletionCandidates {
+                turn_id: TURN.into(),
+                response_observation_id: "retained-batch".into(),
+                call_ids: if matches!(self.case, RecoveryCase::SingleFresh) {
+                    vec!["fresh".into()]
+                } else {
+                    vec!["prefix".into(), "fresh".into()]
+                },
+                outcomes,
+            });
+        })
+    }
+    fn propose_tool_completion<'a>(
+        &'a self,
+        input: ToolCompletionInput<'a>,
+    ) -> ExtensionFuture<'a, Result<Option<ToolCompletionDecision>, String>> {
+        Box::pin(async move {
+            let ResponseItem::FunctionCall { call_id, .. } = input.call else {
+                return Ok(None);
+            };
+            if (call_id != "fresh" && !matches!(self.case, RecoveryCase::AllFresh))
+                || matches!(self.case, RecoveryCase::NoFreshReceipt)
+            {
+                return Ok(None);
+            }
+            assert_eq!(input.step_store.get::<MainCatalog>().unwrap().0, 1);
+            self.proposals.fetch_add(1, Ordering::SeqCst);
+            if matches!(self.case, RecoveryCase::Continue) {
+                Ok(Some(ToolCompletionDecision::Continue {
+                    feedback: Some("Continue with the retained results.".into()),
+                }))
+            } else {
+                Ok(Some(ToolCompletionDecision::Accept {
+                    final_output: serde_json::json!({"answer":42}),
+                }))
+            }
+        })
+    }
+}
+impl ToolContributor for RecoveryPolicy {
+    fn tools(
+        &self,
+        _: &ExtensionData,
+        _: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        Vec::new()
+    }
+    fn tools_for_step(
+        &self,
+        _: &ExtensionData,
+        _: &ExtensionData,
+        step: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        if step.level_id() != TURN {
+            // History injection owns its initial context before recovery starts.
+            step.get_or_init(|| {
+                self.history_captures.fetch_add(1, Ordering::SeqCst);
+                HistoryCatalog
+            });
+            return Vec::new();
+        }
+        step.get_or_init(|| MainCatalog(self.captures.fetch_add(1, Ordering::SeqCst) + 1));
+        Vec::new()
+    }
+}
+
+#[test_case(RecoveryCase::Accept; "accept_before_any_compaction_request")]
+#[test_case(RecoveryCase::SingleFresh; "single_fresh_reply_finishes_before_compaction")]
+#[test_case(RecoveryCase::AllFresh; "all_fresh_replies_choose_first_in_model_order")]
+#[test_case(RecoveryCase::Continue; "continue_compacts_with_one_main_catalog")]
+#[test_case(RecoveryCase::FailedSibling; "known_failed_sibling_continues")]
+#[test_case(RecoveryCase::UnknownSibling; "unknown_historical_sibling_continues")]
+#[test_case(RecoveryCase::NoFreshReceipt; "saved_success_alone_cannot_finish")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn tool_terminal_recovery_request_boundary(case: RecoveryCase) -> anyhow::Result<()> {
+    let server = start_mock_server().await;
+    let requests = if matches!(
+        case,
+        RecoveryCase::Accept | RecoveryCase::SingleFresh | RecoveryCase::AllFresh
+    ) {
+        // Observe unexpected requests without requiring requests from an accepting turn.
+        mount_sse_once(&server, sse(vec![ev_completed("unexpected-request")])).await
+    } else {
+        mount_sse_sequence(
+            &server,
+            vec![
+                sse(vec![
+                    ev_assistant_message("summary", "COMPACTED_RECOVERY_STATE"),
+                    ev_completed("compact"),
+                ]),
+                sse(vec![
+                    ev_assistant_message("answer", "continued"),
+                    ev_completed("answer"),
+                ]),
+            ],
+        )
+        .await
+    };
+    let policy = Arc::new(RecoveryPolicy {
+        case,
+        consumed: AtomicBool::new(false),
+        captures: AtomicUsize::new(0),
+        history_captures: AtomicUsize::new(0),
+        starts: AtomicUsize::new(0),
+        proposals: AtomicUsize::new(0),
+    });
+    let mut extensions = ExtensionRegistryBuilder::new();
+    extensions.turn_lifecycle_contributor(policy.clone());
+    extensions.tool_contributor(policy.clone());
+    let test = test_codex()
+        .with_extensions(Arc::new(extensions.build()))
+        .with_thread_store(Arc::new(InMemoryThreadStore::default()))
+        .with_config(|config| {
+            // Match the existing local-compaction fixtures; the request log
+            // then observes both compaction and generation at /responses.
+            config.model_provider.name = "OpenAI (recovery test)".into();
+            config.model_provider.supports_websockets = false;
+            config.compact_prompt = Some("Summarize retained context.".into());
+            config.model_auto_compact_token_limit = Some(100);
+            config.model_auto_compact_token_limit_scope = AutoCompactTokenLimitScope::Total;
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    let thread = test.session_configured.thread_id;
+    test.thread_store
+        .append_items(AppendThreadItemsParams {
+            thread_id: thread,
+            items: vec![RolloutItem::EventMsg(EventMsg::TurnStarted(
+                TurnStartedEvent {
+                    turn_id: TURN.into(),
+                    root_turn_id: None,
+                    trace_id: None,
+                    started_at: None,
+                    model_context_window: None,
+                    collaboration_mode_kind: Default::default(),
+                },
+            ))],
+        })
+        .await?;
+    let call = |id: &str| -> ResponseItem {
+        serde_json::from_value(serde_json::json!({
+            "type":"function_call","call_id":id,"name":"answer","arguments":"{}",
+        }))
+        .unwrap()
+    };
+    test.codex
+        .inject_response_items(if matches!(case, RecoveryCase::SingleFresh) {
+            vec![call("fresh")]
+        } else {
+            vec![call("prefix"), call("fresh")]
+        })
+        .await?;
+    test.thread_store
+        .append_items(AppendThreadItemsParams {
+            thread_id: thread,
+            items: vec![RolloutItem::ResponseObservationRecord(
+                ResponseObservationRecord {
+                    id: "retained-batch".into(),
+                    thread_id: thread,
+                    turn_id: TURN.into(),
+                    observation: ResponseObservation {
+                        response_id: Some("provider-batch".into()),
+                        status: ResponseObservationStatus::Completed,
+                        incomplete_reason: None,
+                        usage: None,
+                    },
+                },
+            )],
+        })
+        .await?;
+    let output = |id: &str, text: String| -> ResponseItem {
+        serde_json::from_value(serde_json::json!({
+            "type":"function_call_output","call_id":id,"output":text,
+        }))
+        .unwrap()
+    };
+    // The prefix was already written when the manual reply arrived. The
+    // exact observation resolver must not drop it after the recovered start.
+    test.codex
+        .inject_response_items(if matches!(case, RecoveryCase::SingleFresh) {
+            vec![output("fresh", LARGE.repeat(500))]
+        } else {
+            vec![
+                output("prefix", LARGE.repeat(500)),
+                output("fresh", "accepted".into()),
+            ]
+        })
+        .await?;
+    assert_eq!(policy.history_captures.load(Ordering::SeqCst), 1);
+    assert_eq!(policy.captures.load(Ordering::SeqCst), 0);
+    assert!(
+        codex_utils_output_truncation::approx_token_count(&LARGE.repeat(500))
+            > usize::try_from(test.config.model_auto_compact_token_limit.unwrap()).unwrap(),
+        "retained plaintext body must exceed the configured total-context pressure limit"
+    );
+    let submission = test
+        .codex
+        .recover_turn_if_idle(RecoverTurnRequest {
+            turn_id: TURN.into(),
+            thread_settings: Default::default(),
+            trace: None,
+            cyber_access_program: None,
+            final_output_json_schema: None,
+        })
+        .await?;
+    assert!(matches!(
+        submission,
+        codex_protocol::turn_input::StartIfIdleSubmission::Started { .. }
+    ));
+    let event = tokio::time::timeout(std::time::Duration::from_secs(20), async {
+        loop {
+            let event = test.codex.next_event().await?;
+            match event.msg {
+                EventMsg::TurnComplete(done) => break Ok::<_, anyhow::Error>(done),
+                EventMsg::Error(error) => anyhow::bail!("recovery failed: {}", error.message),
+                _ => {}
+            }
+        }
+    })
+    .await??;
+    assert_eq!(policy.starts.load(Ordering::SeqCst), 1);
+    assert_eq!(policy.history_captures.load(Ordering::SeqCst), 1);
+    assert_eq!(
+        policy.captures.load(Ordering::SeqCst),
+        1,
+        "main catalog captured again during compaction"
+    );
+    if matches!(
+        case,
+        RecoveryCase::Accept | RecoveryCase::SingleFresh | RecoveryCase::AllFresh
+    ) {
+        let completion = event.tool_completion.unwrap();
+        assert_eq!(completion.final_output, serde_json::json!({"answer":42}));
+        assert_eq!(
+            completion.call_id,
+            if matches!(case, RecoveryCase::AllFresh) {
+                "prefix"
+            } else {
+                "fresh"
+            }
+        );
+        assert!(requests.requests().is_empty());
+    } else {
+        assert!(event.tool_completion.is_none());
+        let sent = requests.requests();
+        assert_eq!(sent.len(), 2, "expected compaction followed by generation");
+        let second = serde_json::to_string(&sent[1].body_json())?;
+        assert!(second.contains("COMPACTED_RECOVERY_STATE"));
+        assert!(!second.contains(LARGE));
+    }
+    test.codex.submit(Op::Shutdown).await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::ShutdownComplete)
+    })
+    .await;
+    Ok(())
+}
