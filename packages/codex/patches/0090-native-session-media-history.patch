+        content.push(json!({"type":"inputImage", "fileId":"file-image", "detail":detail}));
+    }
+    content.push(json!({"type":"inputImage", "imageUrl":"https://example.invalid/default.png"}));
+    let response: DynamicToolResponse =
+        serde_json::from_value(json!({"contentItems":content, "success":true}))?;
+    test.codex
+        .submit(Op::DynamicToolResponse {
+            id: call.call_id,
+            response,
+        })
+        .await?;
