+#[test_case(true; "full_history_user_images")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn provider_image_references_native_child_fresh_fork_and_restore(full_history: bool) {
+    let server = start_mock_server().await;
+    let f = fixture(
+        &server,
+        Some(ProviderImageReferencePolicy::QualifiedStandardResponses),
+    )
+    .await;
+    // A mutable marker cannot revoke the host policy captured at parent opening.
+    f.root
+        .thread
+        .session
+        .services
+        .thread_extension_data
+        .insert(ProviderImageReferencePolicy::PrepareInline);
+    if full_history {
+        let turn = f.root.thread.session.new_default_turn().await;
+        let mut items = vec![
+            serde_json::from_value(json!({
+                "type":"message", "role":"user", "content":[
+                    {"type":"input_text", "text":"caption"},
+                    {"type":"input_image", "image_url":IMAGE_URL, "detail":"low"},
+                    {"type":"input_image", "file_id":"file-child", "detail":"low"}
+                ]
+            }))
+            .expect("retained parent user images"),
+        ];
+        items.push(serde_json::from_value(json!({
+            "type":"function_call", "call_id":"spawn-image-child", "name":"spawn_agent", "arguments":"{}"
+        })).expect("parent spawn call"));
+        f.root
+            .thread
+            .session
+            .record_conversation_items(&turn, turn.model_info(), &items)
+            .await;
+    }
+    let root_id = f.root.thread_id.to_string();
+    let child_response = mount_sse_once_match(
+        &server,
+        move |r: &wiremock::Request| {
+            r.headers.get("thread-id").and_then(|v| v.to_str().ok()) != Some(root_id.as_str())
+        },
+        if full_history {
+            sse_completed("fork-images")
+        } else {
+            sse(vec![
+                ev_response_created("image-call"),
+                ev_function_call(CALL, "images", "{}"),
+                ev_completed("image-call"),
+            ])
+        },
+    )
+    .await;
+    let control = f
+        .root
+        .thread
+        .session
+        .services
+        .local_agent_runtime
+        .control(f.root.thread.session.session_id());
+    let spawned = control
+        .spawn_agent_with_metadata(
+            f.config.clone(),
+            vec![UserInput::Text {
+                text: "use images".into(),
+                text_elements: vec![],
+            }],
+            child_source(f.root.thread_id),
+            SpawnAgentOptions {
+                parent_thread_id: Some(f.root.thread_id),
+                fork_mode: full_history.then_some(SpawnAgentForkMode::FullHistory),
+                fork_parent_spawn_call_id: full_history.then(|| "spawn-image-child".into()),
+                ..Default::default()
+            },
+        )
+        .await
+        .expect("native child");
+    let child = f
+        .manager
+        .get_thread(spawned.thread_id)
+        .await
+        .expect("child");
+    let output = if full_history {
+        complete_turn(&child).await;
+        reference_content(&child_response.single_request(), true)
+    } else {
+        let call = wait_for_child_event(&child, |event| match event {
+            EventMsg::DynamicToolCallRequest(request) => Some(request.clone()),
+            _ => None,
+        })
+        .await;
+        let response = mount_sse_once_match(
+            &server,
+            header("thread-id", child.session.thread_id.to_string()),
+            sse_completed("child-images-used"),
+        )
+        .await;
+        child.submit(Op::DynamicToolResponse { id:call.call_id, response:serde_json::from_value::<DynamicToolResponse>(json!({"contentItems":[{"type":"inputText","text":"caption"},{"type":"inputImage","imageUrl":IMAGE_URL,"detail":"low"},{"type":"inputImage","fileId":"file-child","detail":"low"}],"success":true})).expect("tool response") }).await.expect("images");
+        complete_turn(&child).await;
+        response.single_request().function_call_output(CALL)["output"].clone()
+    };
+    assert_reference_output(&output, true);
+    for model in [LITE, STANDARD, UNIFIED, STANDARD] {
+        child
+            .submit(Op::ThreadSettings {
+                thread_settings: ThreadSettingsOverrides {
+                    model: Some(model.into()),
+                    ..Default::default()
+                },
+                reply: None,
+            })
+            .await
+            .expect("model switch");
+        assert_reference_output(
+            &request_existing_images(&server, &child, full_history).await,
+            model == STANDARD,
