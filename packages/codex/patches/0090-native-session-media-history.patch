+#[test_case::test_case(0; "late_invalid_input_fails_success")]
+#[test_case::test_case(1; "late_invalid_input_preserves_primary_error")]
+#[test_case::test_case(2; "late_invalid_input_preserves_cancellation")]
+#[tokio::test]
+async fn inline_low_late_pending_input_preserves_primary_outcome(scenario: u8) {
+    let (session, turn, events) =
+        crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+            codex_login::CodexAuth::from_api_key("synthetic-test-key"),
+            Vec::new(),
+            |config| {
+                config
+                    .features
+                    .disable(Feature::UnifiedImageBudget)
+                    .expect("detail based");
+            },
+        )
+        .await;
+    let mut raw = Arc::try_unwrap(session).ok().expect("unshared fixture");
+    raw.provider_image_reference_policy =
+        codex_extension_api::ProviderImageReferencePolicy::QualifiedStandardResponses;
+    let session = Arc::new(raw);
+    let release = Arc::new(tokio::sync::Notify::new());
+    session
+        .spawn_task(
+            Arc::clone(&turn),
+            Vec::new(),
+            crate::session::tests::HeldStepTask {
+                kind: crate::state::TaskKind::Regular,
+                finish: Arc::clone(&release),
+            },
+        )
+        .await;
+    while events.try_recv().is_ok() {}
+    let before: Vec<_> = session.clone_history().await.raw_items().cloned().collect();
+    let state = Arc::clone(
+        &session
+            .active_turn
+            .lock()
+            .await
+            .as_ref()
+            .unwrap()
+            .turn_state,
+    );
+    session
+        .input_queue
+        .extend_pending_input_for_turn_state(
+            &state,
+            vec![TurnInput::UserInput {
+                content: vec![
+                    UserInput::Text {
+                        text: "late input must not partially commit".into(),
+                        text_elements: Vec::new(),
+                    },
+                    UserInput::Image {
+                        image: codex_protocol::models::ImageReference::Inline {
+                            image_url: "data:image/png;base64,AA==".into(),
+                        },
+                        detail: Some(codex_protocol::models::ImageDetail::Low),
+                    },
+                ],
+                client_id: None,
+                metadata: Default::default(),
+            }],
+        )
+        .await;
+    let result = match scenario {
+        0 => Ok(Some("previous successful model projection".into())),
+        1 => Err(CodexErr::Fatal("original primary error".into())),
+        _ => Err(CodexErr::TurnAborted),
+    };
+    session.on_task_finished(Arc::clone(&turn), result).await;
+    release.notify_one();
+    let mut errors = Vec::new();
+    let mut completion = None;
+    let mut interrupted = 0;
+    while let Ok(event) = events.try_recv() {
+        match event.msg {
+            EventMsg::Error(error) => errors.push(error),
+            EventMsg::TurnComplete(done) => completion = Some(done),
+            EventMsg::TurnAborted(abort) => {
+                assert_eq!(
+                    abort.reason,
+                    codex_protocol::protocol::TurnAbortReason::Interrupted
+                );
+                interrupted += 1;
+            }
+            _ => {}
+        }
+    }
+    if scenario == 2 {
+        assert!(errors.is_empty());
+        assert!(completion.is_none());
+        assert_eq!(interrupted, 1);
+    } else {
+        assert_eq!(errors.len(), 1);
+        let expected = if scenario == 0 {
+            "detail 'low'"
+        } else {
+            "original primary error"
+        };
+        assert!(errors[0].message.contains(expected));
+        let completion = completion.expect("terminal outcome");
+        assert!(completion.last_agent_message.is_none());
+        assert!(completion.tool_completion.is_none());
+        assert!(
+            completion
+                .error
+                .is_some_and(|error| error.message.contains(expected))
+        );
+    }
+    let after: Vec<_> = session.clone_history().await.raw_items().cloned().collect();
+    assert_eq!(
+        serde_json::to_value(before).unwrap(),
+        serde_json::to_value(after).unwrap()
+    );
+    assert!(session.active_turn.lock().await.is_none());
+}
