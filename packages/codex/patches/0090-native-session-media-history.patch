+/// Preserve the authoritative tool value and source in the existing parent result envelope.
+pub(crate) fn format_inter_agent_tool_completion_message(
+    task_name: AgentPath,
+    sender: AgentPath,
+    completion: &codex_protocol::protocol::ToolTurnCompletion,
+) -> String {
+    let payload = serde_json::json!({
+        "origin": "tool", "call_id": completion.call_id,
+        "name": completion.name, "namespace": completion.namespace,
+        "final_output": completion.final_output,
+    })
+    .to_string();
+    InterAgentCompletionMessage::new(task_name, sender, payload).render()
+}
