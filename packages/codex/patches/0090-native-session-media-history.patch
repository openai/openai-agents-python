+        assert!(!shared_pump.is_finished());
+        shared_stop.cancel();
+        shared_pump.await.unwrap();
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn earlier_user_cancellation_does_not_become_local_deadline() {
+        let cancel = CancellationToken::new();
+        let deadline = Arc::new(ModelInvocationDeadline::new(Some(10), cancel.clone(), None));
+        let (entered_tx, entered_rx) = oneshot::channel();
+        let (release, held) = oneshot::channel();
+        let run = {
+            let deadline = deadline.clone();
+            tokio::spawn(async move {
+                deadline
+                    .run(async {
+                        entered_tx.send(()).unwrap();
+                        held.await.unwrap()
+                    })
+                    .await;
+            })
+        };
+        entered_rx.await.unwrap();
+        cancel.cancel();
+        tokio::task::yield_now().await;
+        tokio::time::advance(std::time::Duration::from_secs(1)).await;
+        assert!(!deadline.expired());
+        assert!(!run.is_finished());
+        release.send(()).unwrap();
+        run.await.unwrap();
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn expiry_denies_queued_admission_without_sealing_a_sibling() {
+        let selected = Arc::new(TurnSamplingStop::default());
+        let sibling = TurnSamplingStop::default();
+        let entered = AtomicUsize::new(0);
+        assert!(
+            selected
+                .with_model_deadline_admission(|| entered.fetch_add(1, Ordering::AcqRel))
+                .is_some()
+        );
+        let cancel = CancellationToken::new();
+        let deadline =
+            ModelInvocationDeadline::new(Some(1), cancel.clone(), Some(selected.clone()));
+        deadline.run(async { cancel.cancelled().await }).await;
+        assert!(
+            selected
+                .with_model_deadline_admission(|| entered.fetch_add(1, Ordering::AcqRel))
+                .is_none()
+        );
+        assert!(
+            sibling
+                .with_model_deadline_admission(|| entered.fetch_add(1, Ordering::AcqRel))
+                .is_some()
+        );
+        assert_eq!(entered.load(Ordering::Acquire), 2);
+        assert!(!sibling.requested());
+    }
+
+    #[tokio::test]
+    async fn aborting_the_sampler_does_not_drop_the_stored_producer_join() {
+        let owner = Arc::new(ModelInvocationDeadline::new(
+            Some(10),
+            CancellationToken::new(),
+            None,
+        ));
+        let (release, held) = oneshot::channel();
+        let (joining, joined_rx) = oneshot::channel();
+        let producer = tokio::spawn(async move {
+            held.await.unwrap();
+        });
+        owner.attach_tasks([Some(producer), None]);
+        let sampler = {
+            let owner = owner.clone();
+            tokio::spawn(async move {
+                joining.send(()).unwrap();
+                owner.retire_tasks().await
+            })
+        };
+        joined_rx.await.unwrap();
+        tokio::task::yield_now().await;
+        sampler.abort();
+        assert!(sampler.await.unwrap_err().is_cancelled());
+        // This is the existing outer-abort order: sampler joins, then request tasks.
+        let (retiring, retired_rx) = oneshot::channel();
+        let retirement = {
+            let owner = owner.clone();
+            tokio::spawn(async move {
+                retiring.send(()).unwrap();
+                owner.retire_tasks().await
+            })
+        };
+        retired_rx.await.unwrap();
+        assert!(!retirement.is_finished());
+        release.send(()).unwrap();
+        assert!(retirement.await.unwrap().is_empty());
+        // Completed handles were removed atomically with bookkeeping; no repoll.
+        assert!(owner.retire_tasks().await.is_empty());
+    }
+
+    #[tokio::test]
+    async fn producer_failure_stays_recorded_across_repeated_retirement() {
+        let owner = ModelInvocationDeadline::new(Some(10), CancellationToken::new(), None);
+        owner.attach_tasks([
+            Some(tokio::spawn(async { panic!("owned producer failed") })),
+            None,
+        ]);
+        let first = owner.retire_tasks().await;
+        assert_eq!(first.len(), 1);
+        assert_eq!(owner.retire_tasks().await, first);
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn admission_reserves_absolute_expiry_without_polling_the_watchdog() {
+        let stop = Arc::new(TurnSamplingStop::default());
+        let cancel = CancellationToken::new();
+        let owner = ModelInvocationDeadline::new(Some(10), cancel.clone(), Some(stop.clone()));
+        let captured = stop.capture_model_deadline().unwrap();
+        // No run()/watchdog future exists, so advance cannot poll it implicitly.
+        tokio::time::advance(std::time::Duration::from_millis(11)).await;
+        assert!(!owner.expired());
+        let entered = AtomicUsize::new(0);
+        assert!(
+            captured
+                .admit(|| entered.fetch_add(1, Ordering::AcqRel))
+                .is_none()
+        );
+        assert_eq!(entered.load(Ordering::Acquire), 0);
+        assert!(owner.expired());
+        assert!(cancel.is_cancelled());
+        assert!(!owner.accept_terminal());
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn terminal_disarms_the_captured_state_before_a_later_invocation_replaces_the_slot() {
+        let stop = Arc::new(TurnSamplingStop::default());
+        let first =
+            ModelInvocationDeadline::new(Some(10), CancellationToken::new(), Some(stop.clone()));
+        let old = stop.capture_model_deadline().unwrap();
+        assert!(first.accept_terminal());
+        let second =
+            ModelInvocationDeadline::new(Some(1), CancellationToken::new(), Some(stop.clone()));
+        let current = stop.capture_model_deadline().unwrap();
+        assert!(!Arc::ptr_eq(&old, &current));
+        tokio::time::advance(std::time::Duration::from_millis(11)).await;
+        assert!(old.admit(|| ()).is_some());
+        assert!(current.admit(|| ()).is_none());
+        assert!(!first.expired());
+        assert!(second.expired());
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn earlier_user_cancel_stays_cancelled_even_when_watchdog_never_polls() {
+        let stop = Arc::new(TurnSamplingStop::default());
+        let cancel = CancellationToken::new();
+        let owner = ModelInvocationDeadline::new(Some(10), cancel.clone(), Some(stop.clone()));
+        let captured = stop.capture_model_deadline().unwrap();
+        cancel.cancel();
+        tokio::time::advance(std::time::Duration::from_millis(11)).await;
+        assert!(captured.admit(|| ()).is_none());
+        assert!(!owner.expired());
+        assert!(!owner.accept_terminal());
+    }
+
+    #[test]
+    fn foreign_thread_checks_the_same_absolute_clock_without_a_runtime_watchdog() {
+        let state = Arc::new(codex_extension_api::ModelInvocationDeadlineState::new(
+            Instant::now() - std::time::Duration::from_millis(1),
+            CancellationToken::new(),
+        ));
+        let other = state.clone();
+        assert!(
+            std::thread::spawn(move || other.admit(|| ()))
+                .join()
+                .unwrap()
+                .is_none()
+        );
+        assert!(state.expired());
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn deferred_initial_preparation_does_not_spend_the_clock() {
+        let owner = Arc::new(ModelInvocationDeadline::new_deferred(
+            Some(10),
+            CancellationToken::new(),
+            None,
+        ));
+        let (start_tx, start_rx) = oneshot::channel();
+        let (ready_tx, ready_rx) = oneshot::channel();
+        let task = {
+            let owner = owner.clone();
+            tokio::spawn(async move {
+                owner
+                    .run(async {
+                        start_rx.await.unwrap();
+                        owner.start();
+                        ready_tx.send(()).unwrap();
+                        owner.cancellation_token().cancelled().await;
+                    })
+                    .await;
+            })
+        };
+        tokio::task::yield_now().await;
+        tokio::time::advance(std::time::Duration::from_secs(100)).await;
+        assert!(owner.state.get().is_none());
+        assert!(!task.is_finished());
+        start_tx.send(()).unwrap();
+        ready_rx.await.unwrap();
+        tokio::time::advance(std::time::Duration::from_millis(9)).await;
+        assert!(!owner.expired());
+        tokio::time::advance(std::time::Duration::from_millis(1)).await;
+        task.await.unwrap();
+        assert!(owner.expired());
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn retry_start_does_not_reset_the_absolute_clock() {
+        let owner = Arc::new(ModelInvocationDeadline::new_deferred(
+            Some(10),
+            CancellationToken::new(),
+            None,
+        ));
+        owner.start();
+        let first = owner.state.get().unwrap().expires_at();
+        tokio::time::advance(std::time::Duration::from_millis(9)).await;
+        owner.start();
+        assert_eq!(owner.state.get().unwrap().expires_at(), first);
+        owner
+            .run(async { owner.cancellation_token().cancelled().await })
+            .await;
+        assert!(owner.expired());
+    }
+
+    #[tokio::test]
+    async fn retry_registration_reuses_the_drained_task_owner_without_detaching() {
+        let owner = ModelInvocationDeadline::new(None, CancellationToken::new(), None);
+        let retired = Arc::new(AtomicUsize::new(0));
+        for _ in 0..2 {
+            let count = retired.clone();
+            owner.attach_tasks([
+                Some(tokio::spawn(async move {
+                    count.fetch_add(1, Ordering::AcqRel);
+                })),
+                None,
+            ]);
+            assert!(owner.retire_tasks().await.is_empty());
+        }
+        assert_eq!(retired.load(Ordering::Acquire), 2);
+        assert!(owner.tasks.get().unwrap().lock().await.handles.is_empty());
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn final_failure_disarms_before_its_cleanup_settles() {
+        let owner = Arc::new(ModelInvocationDeadline::new(
+            Some(10),
+            CancellationToken::new(),
+            None,
+        ));
+        let (entered_tx, entered_rx) = oneshot::channel();
+        let (cleanup_tx, cleanup_rx) = oneshot::channel();
+        let task = {
+            let owner = owner.clone();
+            tokio::spawn(async move {
+                owner
+                    .run(async {
+                        owner.accept_outcome();
+                        entered_tx.send(()).unwrap();
+                        cleanup_rx.await.unwrap();
+                    })
+                    .await;
+            })
+        };
+        entered_rx.await.unwrap();
+        tokio::time::advance(std::time::Duration::from_secs(100)).await;
+        assert!(!owner.expired());
+        assert!(!task.is_finished());
+        cleanup_tx.send(()).unwrap();
+        task.await.unwrap();
+    }
+}
