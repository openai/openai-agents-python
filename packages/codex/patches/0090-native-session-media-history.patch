+struct TerminalPolicy {
+    seen: std::sync::Mutex<Vec<String>>,
+    selected: &'static str,
+    invalid: bool,
+}
+impl codex_extension_api::TurnLifecycleContributor for TerminalPolicy {
+    fn propose_tool_completion<'a>(
+        &'a self,
+        input: codex_extension_api::ToolCompletionInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<
+        'a,
+        Result<Option<codex_extension_api::ToolCompletionDecision>, String>,
+    > {
+        Box::pin(async move {
+            let ResponseItem::FunctionCall { call_id, .. } = input.call else {
+                unreachable!()
+            };
+            self.seen.lock().unwrap().push(call_id.clone());
+            if call_id != self.selected {
+                return Ok(None);
+            }
+            if self.invalid {
+                return Err("output schema rejected the authoritative result".into());
+            }
+            Ok(Some(codex_extension_api::ToolCompletionDecision::Accept {
+                final_output: serde_json::json!({"from":call_id}),
+            }))
+        })
+    }
+}
+fn settled_test_calls() -> SettledDirectTools {
+    SettledDirectTools {
+        calls: ["first", "second", "third"]
+            .iter()
+            .map(|id| {
+                serde_json::from_value(serde_json::json!({
+                    "type":"function_call", "call_id":id, "name":"answer", "arguments":"{}",
+                }))
+                .unwrap()
+            })
+            .collect(),
+        outputs: ["first", "second", "third"]
+            .iter()
+            .map(|id| {
+                serde_json::from_value(serde_json::json!({
+                    "type":"function_call_output", "call_id":id, "output":"authoritative answer",
+                }))
+                .unwrap()
+            })
+            .collect(),
+        all_succeeded: true,
+    }
+}
+
+#[tokio::test]
+async fn terminal_policy_selects_the_first_eligible_call_in_model_order() {
+    let (mut session, turn) = crate::session::tests::make_session_and_context().await;
+    let policy = Arc::new(TerminalPolicy {
+        seen: Default::default(),
+        selected: "second",
+        invalid: false,
+    });
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.turn_lifecycle_contributor(policy.clone());
+    session.services.extensions = Arc::new(extensions.build());
+    let step = StepContext::for_test(Arc::new(turn));
+    let result = propose_tool_completion(
+        &session,
+        &step,
+        &settled_test_calls(),
+        &CancellationToken::new(),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(result.call_id, "second");
+    assert_eq!(result.final_output, serde_json::json!({"from":"second"}));
+    assert_eq!(*policy.seen.lock().unwrap(), vec!["first", "second"]);
+}
