+/// Live authority created only by Core after validation and exact-turn reservation.
+/// Serialized terminal payloads and host initializers cannot construct this type.
+pub(crate) struct ValidatedToolCompletion(pub(crate) codex_protocol::protocol::ToolTurnCompletion);
+
+/// Original direct-call order and accepted outputs from this sample only.
+#[derive(Debug, Default)]
+struct SettledDirectTools {
+    calls: Vec<ResponseItem>,
+    outputs: Vec<ResponseItem>,
+    all_succeeded: bool,
+}
+
+/// Resolve one retained sampled batch across same-ID recovery starts. Outcome
+/// data preserves sibling facts; only the later live policy can authorize a finish.
+fn recovered_tools_from_history(
+    candidates: &codex_extension_api::RecoveredToolCompletionCandidates,
+    thread_id: codex_protocol::ThreadId,
+    turn_id: &str,
+    history: &[RolloutItem],
+) -> CodexResult<SettledDirectTools> {
+    let invalid = || CodexErr::InvalidRequest("Invalid recovered tool completion batch".into());
+    if candidates.turn_id != turn_id || candidates.call_ids.is_empty() {
+        return Err(invalid());
+    }
+    let anchors = history
+        .iter()
+        .enumerate()
+        .filter_map(|(index, item)| match item {
+            RolloutItem::ResponseObservationRecord(record)
+                if record.id == candidates.response_observation_id =>
+            {
+                Some((index, record))
+            }
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    let [(anchor, record)] = anchors.as_slice() else {
+        return Err(invalid());
+    };
+    if record.thread_id != thread_id
+        || record.turn_id != turn_id
+        || record.observation.status
+            != codex_protocol::protocol::ResponseObservationStatus::Completed
+    {
+        return Err(invalid());
+    }
+    // A recovery appends a new TurnStarted after this observation. The batch
+    // starts at its preceding provider terminal or original turn start, never
+    // at the latest same-ID recovery start.
+    let original_start = history[..*anchor]
+        .iter()
+        .rposition(|item| matches!(item, RolloutItem::EventMsg(EventMsg::TurnStarted(_))))
+        .ok_or_else(invalid)?;
+    if !matches!(&history[original_start], RolloutItem::EventMsg(EventMsg::TurnStarted(start))
+        if start.turn_id == turn_id)
+        || history[*anchor + 1..].iter().any(|item| {
+            matches!(item, RolloutItem::ResponseObservationRecord(record)
+                if record.thread_id == thread_id && record.turn_id == turn_id)
+        })
+    {
+        return Err(invalid());
+    }
+    let start = history[original_start + 1..*anchor]
+        .iter()
+        .rposition(|item| matches!(item, RolloutItem::ResponseObservationRecord(_)))
+        .map_or(original_start + 1, |index| original_start + index + 2);
+    let call_id = |item: &ResponseItem| match item {
+        ResponseItem::FunctionCall { call_id, .. }
+        | ResponseItem::CustomToolCall { call_id, .. } => Some(call_id.clone()),
+        ResponseItem::ToolSearchCall { call_id, .. } => call_id.clone(),
+        _ => None,
+    };
+    let calls = history[start..*anchor]
+        .iter()
+        .filter_map(|item| {
+            let RolloutItem::ResponseItem(item) = item else {
+                return None;
+            };
+            call_id(&item.item).map(|_| item.item.clone())
+        })
+        .collect::<Vec<_>>();
+    let ids = calls
+        .iter()
+        .map(|call| call_id(call).expect("collected call identity"))
+        .collect::<Vec<_>>();
+    let unique = ids.iter().cloned().collect::<HashSet<_>>();
+    if ids != candidates.call_ids || unique.len() != ids.len() || ids.iter().any(String::is_empty) {
+        return Err(invalid());
+    }
+    let mut outcomes = std::collections::HashMap::<String, bool>::new();
+    for (id, succeeded) in &candidates.outcomes {
+        if !unique.contains(id) || outcomes.insert(id.clone(), *succeeded).is_some() {
+            return Err(invalid());
+        }
+    }
+    let mut outputs = std::collections::HashMap::<String, ResponseItem>::new();
+    for (index, item) in history.iter().enumerate().skip(start) {
+        let RolloutItem::ResponseItem(item) = item else {
+            continue;
+        };
+        let id = match &item.item {
+            ResponseItem::FunctionCallOutput { call_id, .. }
+            | ResponseItem::ToolSearchOutput { call_id, .. } => call_id.as_ref(),
+            ResponseItem::CustomToolCallOutput { call_id, .. } => Some(call_id),
+            _ => None,
+        };
+        if let Some(id) = id.filter(|id| unique.contains(*id)) {
+            if index <= *anchor || outputs.insert(id.clone(), item.item.clone()).is_some() {
+                return Err(invalid());
+            }
+        }
+    }
+    let mut ordered_outputs = Vec::with_capacity(calls.len());
+    let mut all_succeeded = true;
+    for (call, id) in calls.iter().zip(&ids) {
+        let output = outputs.remove(id).ok_or_else(invalid)?;
+        let retained_success = match (call, &output) {
+            (
+                ResponseItem::FunctionCall { .. },
+                ResponseItem::FunctionCallOutput { output, .. },
+            )
+            | (
+                ResponseItem::CustomToolCall { .. },
+                ResponseItem::CustomToolCallOutput { output, .. },
+            ) => output.success,
+            (ResponseItem::ToolSearchCall { .. }, ResponseItem::ToolSearchOutput { .. }) => None,
+            _ => return Err(invalid()),
+        };
+        let known_success = outcomes.get(id).copied();
+        if retained_success
+            .zip(known_success)
+            .is_some_and(|(live, saved)| live != saved)
+        {
+            return Err(invalid());
+        }
+        // Never promote inferred legacy-text success or a body-only receipt.
+        // The seed must explicitly retain each known final outcome.
+        all_succeeded &= known_success == Some(true);
+        ordered_outputs.push(output);
+    }
+    Ok(SettledDirectTools {
+        calls,
+        outputs: ordered_outputs,
+        all_succeeded,
+    })
+}
