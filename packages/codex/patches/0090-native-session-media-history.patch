+#[test]
+fn tool_terminal_recovery_resolves_written_prefix_across_same_id_start() {
+    let (thread, candidates, history) = recovered_batch_fixture();
+    let tools = recovered_tools_from_history(&candidates, thread, "recovered", &history).unwrap();
+    assert!(tools.all_succeeded);
+    assert_eq!(tools.calls.len(), 3);
+    for (index, output) in tools.outputs.iter().enumerate() {
+        assert!(
+            matches!(output, ResponseItem::FunctionCallOutput { call_id: Some(id), .. }
+            if id == &candidates.call_ids[index])
+        );
+    }
