+            Some("input_text") => &["type", "text"],
+            Some("input_image") => &["type", "image_url", "file_id", "detail"],
+            Some("input_file") => &["type", "file_id", "file_data", "file_url", "filename"],
+            Some("input_audio") => &["type", "audio_url"],
+            _ => return Err(serde::de::Error::custom("unknown content item type")),
+        };
+        if object.keys().any(|key| !allowed.contains(&key.as_str())) {
+            return Err(serde::de::Error::custom("unknown content item field"));
+        }
+        serde_json::from_value::<FunctionCallOutputContentItem>(value)
+            .map(Into::into)
+            .map_err(serde::de::Error::custom)
+    }
