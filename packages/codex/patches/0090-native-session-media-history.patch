+    #[tokio::test(start_paused = true)]
+    async fn request_producer_retires_while_a_healthy_shared_pump_remains_alive() {
+        let deadline = ModelInvocationDeadline::new(Some(1), CancellationToken::new(), None);
+        let stream_stop = CancellationToken::new();
+        let (producer_stop, stopped) = oneshot::channel();
+        let (release, held) = oneshot::channel();
+        let producer = tokio::spawn(async move {
+            stopped.await.unwrap();
+            held.await.unwrap();
+        });
+        let shared_stop = CancellationToken::new();
+        let shared_pump = {
+            let shared_stop = shared_stop.clone();
+            tokio::spawn(async move { shared_stop.cancelled().await })
+        };
+        deadline.attach_stream_stop(stream_stop.clone(), Some(producer_stop));
+        deadline.run(async { stream_stop.cancelled().await }).await;
+        assert!(deadline.expired());
+        assert!(!producer.is_finished());
+        assert!(!shared_pump.is_finished());
+        // Signalling was not joining: the invocation owner explicitly joins its producer.
+        release.send(()).unwrap();
+        producer.await.unwrap();
+        assert!(!shared_pump.is_finished());
+        shared_stop.cancel();
+        shared_pump.await.unwrap();
