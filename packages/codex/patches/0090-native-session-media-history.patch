+    ] {
+        let api: UserInput = serde_json::from_value(wire.clone()).unwrap();
+        let core = api.into_core();
+        let restored = UserInput::from(core);
+        assert_eq!(serde_json::to_value(restored).unwrap(), wire);
+    }
+}
