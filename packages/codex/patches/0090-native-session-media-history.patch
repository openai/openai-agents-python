@@ -105,6 +105,49 @@ pub(crate) struct PendingMailboxCommunication {
 }
 
 impl InputQueue {
+    /// Linearize validated terminal selection against input acceptance. Locks are
+    /// released before any persistence I/O. The live task remains the finishing owner.
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "terminal reservation and input acceptance must remain atomic"
+    )]
+    pub(crate) async fn reserve_tool_completion(
+        &self,
+        active_turn: &Mutex<Option<ActiveTurn>>,
+        turn_id: &str,
+        cancellation: &CancellationToken,
+    ) -> bool {
+        let mut active = active_turn.lock().await;
+        let Some(turn) = active.as_mut() else {
+            return false;
+        };
+        let Some(task) = turn.task.as_ref() else {
+            return false;
+        };
+        if task.turn_context.sub_id != turn_id
+            || task.cancellation_token.is_cancelled()
+            || cancellation.is_cancelled()
+            || turn.tool_completion_reserved.is_some()
+        {
+            return false;
+        }
+        let mut mailbox = self.mailbox_pending_mails.lock().await;
+        self.read_mailbox(&mut mailbox);
+        let state = turn.turn_state.lock().await;
+        if !state.pending_input.is_empty()
+            || state.has_pending_waiters()
+            || (state.accepts_mailbox_delivery_for_current_turn() && !mailbox.is_empty())
+        {
+            return false;
+        }
+        // Stop tokens can change independently while the queue/state locks are awaited.
+        if task.cancellation_token.is_cancelled() || cancellation.is_cancelled() {
+            return false;
+        }
+        turn.tool_completion_reserved = Some(Arc::clone(&task.done));
