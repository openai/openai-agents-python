+    #[tokio::test(start_paused = true)]
+    async fn expiry_keeps_owned_persistence_alive_until_it_settles() {
+        let stop = Arc::new(TurnSamplingStop::default());
+        let cancel = CancellationToken::new();
+        let deadline = Arc::new(ModelInvocationDeadline::new(
+            Some(10),
+            cancel.clone(),
+            Some(stop.clone()),
+        ));
+        let entered = Arc::new(AtomicUsize::new(0));
+        let (release, held) = oneshot::channel();
+        let run = {
+            let deadline = deadline.clone();
+            let entered = entered.clone();
+            tokio::spawn(async move {
+                deadline
+                    .run(async {
+                        entered.store(1, Ordering::Release);
+                        held.await.unwrap();
+                        entered.store(2, Ordering::Release);
+                    })
+                    .await;
+            })
+        };
+        while entered.load(Ordering::Acquire) == 0 {
+            tokio::task::yield_now().await;
+        }
+        tokio::time::advance(std::time::Duration::from_millis(11)).await;
+        tokio::task::yield_now().await;
+        assert!(deadline.expired());
+        assert!(stop.model_deadline_expired());
+        assert!(cancel.is_cancelled());
+        assert!(!run.is_finished());
+        release.send(()).unwrap();
+        run.await.unwrap();
+        assert_eq!(entered.load(Ordering::Acquire), 2);
+    }
