+    /// Retain once in the existing rollout; stream the same typed record without
+    /// persisting a second EventMsg copy. This never adds a conversation item.
+    pub(crate) async fn record_response_fact(
+        &self,
+        turn_context: &TurnContext,
+        request_id: Option<&str>,
+        response_id: Option<&str>,
+        received: codex_protocol::response_facts::ReceivedResponseFact,
+        capture_probabilities: bool,
+        budget: &mut codex_protocol::response_facts::ResponseFactBudget,
+    ) -> CodexResult<()> {
+        use codex_protocol::response_facts::{ResponseFact, ResponseFactRecord};
+        let codex_protocol::response_facts::ReceivedResponseFact {
+            upstream_request_id,
+            fact,
+        } = received;
+        if !capture_probabilities
+            && matches!(
+                &fact,
+                ResponseFact::TextProbabilities { .. } | ResponseFact::MalformedProbabilities
+            )
+        {
+            return Ok(());
+        }
+        let malformed = matches!(&fact, ResponseFact::MalformedProbabilities);
+        let malformed_error = || {
+            CodexErr::Fatal("Provider returned malformed probability facts".into())
+                .with_response_integrity_reason(
+                    codex_protocol::error::ResponseIntegrityReason::MalformedProbabilityFacts,
+                )
+        };
+        if budget.is_exhausted() {
+            return if malformed {
+                Err(malformed_error())
+            } else {
+                Ok(())
+            };
+        }
+        let mut record = ResponseFactRecord {
+            id: Uuid::now_v7().to_string(),
+            thread_id: self.thread_id,
+            turn_id: turn_context.sub_id.clone(),
+            request_id: request_id.map(str::to_owned),
+            response_id: response_id.map(str::to_owned),
+            received: codex_protocol::response_facts::ReceivedResponseFact {
+                upstream_request_id,
+                fact,
+            },
+        };
+        // A truncation marker keeps native correlation only. Never copy a large
+        // provider response/request/item identifier into that reserved marker.
+        let marker = ResponseFactRecord {
+            id: record.id.clone(),
+            thread_id: record.thread_id,
+            turn_id: record.turn_id.clone(),
+            request_id: record.request_id.clone(),
+            response_id: None,
+            received: codex_protocol::response_facts::ReceivedResponseFact {
+                upstream_request_id: None,
+                fact: ResponseFact::CaptureTruncated,
+            },
+        };
+        // Reuse the real storage serialization, charging an upper bound for its
+        // timestamp and ordinal. The writer uses a fixed UTC millisecond format;
+        // 64 ASCII characters exceed its supported time range. Charge the newline.
+        let marker_line = codex_history::RolloutLine {
+            timestamp: "9".repeat(64),
+            ordinal: Some(u64::MAX),
+            item: RolloutItem::ResponseFactRecord(marker.clone()),
+        };
+        let encode_error = |_| CodexErr::Fatal("Could not encode received response facts".into());
+        let marker_payload_bytes = serde_json::to_vec(&marker).map_err(encode_error)?.len();
+        let marker_bytes = serde_json::to_vec(&marker_line)
+            .map_err(encode_error)?
+            .len()
+            + 1;
+        if marker_bytes > codex_protocol::response_facts::RESPONSE_FACT_BYTES {
+            return Err(CodexErr::Fatal(
+                "Native fact identity exceeds the retention budget".into(),
+            ));
+        }
+        let storage_overhead = marker_bytes - marker_payload_bytes;
+        let record_bytes =
+            serde_json::to_vec(&record).map_err(encode_error)?.len() + storage_overhead;
+        let fact_bytes = serde_json::to_vec(&record.received.fact)
+            .map_err(encode_error)?
+            .len();
+        let fact = std::mem::replace(&mut record.received.fact, ResponseFact::CaptureTruncated);
+        let Some(fact) = budget.capture_retained(fact, record_bytes - fact_bytes, marker_bytes)
+        else {
+            return if malformed {
+                Err(malformed_error())
+            } else {
+                Ok(())
+            };
+        };
+        if matches!(fact, ResponseFact::CaptureTruncated) {
+            record = marker;
+        } else {
+            record.received.fact = fact;
+        }
+        if self.live_thread().is_some()
+            && !self
+                .persist_rollout_items(&[RolloutItem::ResponseFactRecord(record.clone())])
+                .await
+        {
+            return Err(CodexErr::Fatal(
+                "Could not retain received response facts".into(),
+            ));
+        }
+        self.send_event_raw_with_persistence(
+            Event {
+                id: turn_context.sub_id.clone(),
+                msg: EventMsg::ResponseFact(record),
+            },
+            false,
+        )
+        .await;
+        if malformed {
+            return Err(
+                CodexErr::Fatal("Provider returned malformed probability facts".into())
+                    .with_response_integrity_reason(
+                        codex_protocol::error::ResponseIntegrityReason::MalformedProbabilityFacts,
+                    ),
+            );
+        }
+        Ok(())
+    }
