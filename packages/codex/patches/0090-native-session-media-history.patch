+#[tokio::test]
+async fn self_cancelled_owned_fatal_settles_without_an_external_abort_and_preserves_primary() {
+    for prior_primary in [false, true] {
+        let (session, turn, events, records) = owned_spawn_session().await;
+        let task = owned_task(prior_primary);
+        session
+            .spawn_task(Arc::clone(&turn), Vec::new(), task.clone())
+            .await;
+        task.started.cancelled().await;
+        let first = retirement_delegate(&session, Arc::clone(&turn), "self-fatal");
+        let later = retirement_delegate(&session, Arc::clone(&turn), "admitted-late");
+        let backend = Arc::new(StartupBackend::new(false));
+        assert!(
+            session
+                .services
+                .code_mode_service
+                .session
+                .set(backend.clone())
+                .is_ok()
+        );
+        let release_late = CancellationToken::new();
+        let late_done = CancellationToken::new();
+        let admitted_release = release_late.clone();
+        let admitted_done = late_done.clone();
+        let broker = Arc::clone(&session.services.code_mode_service.dispatch_broker);
+        let receipt = Arc::clone(&later.receipt);
+        let admitted_backend = backend.clone();
+        later.receipt.tasks.spawn(async move {
+            admitted_release.cancelled().await;
+            assert!(!broker.fail_owned_dispatch(
+                &receipt,
+                "late callback failure".into(),
+                admitted_backend
+            ));
+            admitted_done.cancel();
+        });
+        assert!(
+            session
+                .services
+                .code_mode_service
+                .dispatch_broker
+                .fail_owned_dispatch(
+                    &first.receipt,
+                    "unsupported returned file".into(),
+                    backend.clone()
+                )
+        );
+        session.cancel_code_mode_owner(&turn).await;
+        task.return_after_cancel.cancel();
+        owner_gate_is_held(&session).await;
+        release_late.cancel();
+        late_done.cancelled().await;
+        backend.terminate_release.cancel();
+        let mut errors = Vec::new();
+        let complete = tokio::time::timeout(std::time::Duration::from_secs(10), async {
+            loop {
+                match events.recv().await.unwrap().msg {
+                    codex_protocol::protocol::EventMsg::Error(error) => errors.push(error),
+                    codex_protocol::protocol::EventMsg::TurnComplete(event) => break event,
+                    codex_protocol::protocol::EventMsg::TurnAborted(_) => {
+                        panic!("owned fatal lost its failure classification")
+                    }
+                    _ => {}
+                }
+            }
+        })
+        .await
+        .unwrap();
+        let expected = if prior_primary {
+            "original model failure"
+        } else {
+            "unsupported returned file"
+        };
+        let expected = crate::error::CodexErr::Fatal(expected.into())
+            .to_error_event(None)
+            .message;
+        assert_eq!(errors.len(), 1);
+        assert_eq!(errors[0].message, expected);
+        assert_eq!(complete.error.as_ref().unwrap().message, expected);
+        assert!(complete.tool_completion.is_none());
+        assert_eq!(records.lock().unwrap().as_slice(), &[turn.sub_id.clone()]);
+        assert!(
+            !session
+                .services
+                .code_mode_service
+                .dispatch_broker
+                .has_unconsumed_fatal()
+        );
+        tokio::time::timeout(std::time::Duration::from_secs(10), async {
+            while session.active_turn.lock().await.is_some() {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+    }
+}
