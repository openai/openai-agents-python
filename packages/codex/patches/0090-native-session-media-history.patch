+        );
+        assert_eq!(
+            output[2 + index * 2],
+            json!({"type":"input_image", "file_id":"file-image", "detail":detail})
+        );
+    }
+    assert_eq!(output[9]["detail"], "high");
+    // These new turns select a different current model without calling the image
+    // tool again. Only the request projection may omit a retained URL.
+    for model in [MODEL_B, MODEL_A, MODEL_C, MODEL_A] {
+        let switched = mount_sse_once(&server, sse_completed("image-model-switch")).await;
+        test.codex
+            .submit(Op::ThreadSettings {
+                thread_settings: ThreadSettingsOverrides {
+                    model: Some(model.into()),
+                    ..Default::default()
+                },
+                reply: None,
+            })
+            .await?;
+        test.codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "inspect retained images without calling the tool".into(),
+                text_elements: Vec::new(),
+            }]))
+            .await?;
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        })
+        .await;
+        let request = switched.single_request();
+        let current = request.function_call_output("call-images")["output"].clone();
+        assert_eq!(request.body_json()["model"], model);
+        if model == MODEL_B {
+            assert_eq!(current[1]["type"], "input_text");
+            assert_eq!(
+                current[1]["text"],
+                "image content omitted because remote image URLs are not supported"
+            );
+            assert_eq!(current[2]["file_id"], "file-image");
+        } else if model == MODEL_C {
+            let text_only = serde_json::to_string(&current)?;
+            assert!(!text_only.contains("https://example.invalid/"));
+            assert!(!text_only.contains("file-image"));
+            assert!(text_only.contains("caption"));
+        } else {
+            assert_eq!(current, output);
+        }
+    }
+    test.codex.shutdown_and_wait().await?;
+    let rollout_path = test.codex.rollout_path().expect("saved image history");
+    let saved = tokio::fs::read(&rollout_path).await?;
+    assert!(!String::from_utf8_lossy(&saved).contains("QualifiedStandardResponses"));
+    for opt_in in [true, false] {
+        let mut current = StartThreadOptions::new(test.config.clone());
+        if opt_in {
+            current
+                .thread_extension_init
+                .insert(ProviderImageReferencePolicy::QualifiedStandardResponses);
+        }
+        let forked = test
+            .thread_manager
+            .fork_legacy_thread(ForkSnapshot::Interrupted, current, rollout_path.clone())
+            .await?
+            .thread;
+        let replay = mount_sse_once(&server, sse_completed("images-replayed")).await;
+        forked
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "review images".into(),
+                text_elements: Vec::new(),
+            }]))
+            .await?;
+        wait_for_event(&forked, |event| matches!(event, EventMsg::TurnComplete(_))).await;
+        let replayed =
+            replay.single_request().function_call_output("call-images")["output"].clone();
+        if opt_in {
+            assert_eq!(replayed, output);
+        } else {
+            assert_eq!(replayed[1]["type"], "input_text");
+            assert_eq!(
+                replayed[1]["text"],
+                "image content omitted because remote image URLs are not supported"
+            );
+            assert_eq!(replayed[2], output[2]);
+        }
+        forked.shutdown_and_wait().await?;
+        assert_eq!(tokio::fs::read(&rollout_path).await?, saved);
+    }
+    Ok(())
+}
