+#[test]
+fn file_user_input_core_round_trip_preserves_each_source() {
+    for wire in [
+        serde_json::json!({"type": "file", "file_id": "file-round-trip"}),
+        serde_json::json!({"type": "file", "file_data": "data:text/plain;base64,YQ==", "filename": "note.txt"}),
