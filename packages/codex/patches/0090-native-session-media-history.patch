+#[test_case(false; "typed_file_forwarding")]
+#[test_case(true; "unsupported_file_format")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn code_mode_file_primitive_reaches_actual_provider_request(
+    invalid_format: bool,
+) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    let mut builder = test_codex().with_config(|config| {
+        config
+            .features
+            .enable(Feature::CodeMode)
+            .expect("code mode");
+        config
+            .permissions
+            .set_permission_profile(PermissionProfile::Disabled)
+            .expect("permissions");
+    });
+    let mut test = builder.build(&server).await?;
+    let mut options = StartThreadOptions::new(test.config.clone());
+    options.dynamic_tools = vec![DynamicToolSpec::Function(DynamicToolFunctionSpec {
+        name: "reference".into(),
+        description: "Return one typed file".into(),
+        input_schema: serde_json::json!({"type":"object"}),
+        defer_loading: false,
+    })];
+    options
+        .thread_extension_init
+        .insert(codex_extension_api::ProviderImageReferencePolicy::QualifiedStandardResponses);
+    let started = test.thread_manager.start_thread(options).await?;
+    test.codex = started.thread;
+    test.session_configured = started.session_configured;
+    let source = if invalid_format {
+        "const [{type, ...source}] = await tools.reference({}); file({...source, file_url: 'https://example.invalid/second-source'});"
+    } else {
+        "const [{type, ...source}] = await tools.reference({}); if (type !== 'input_file') throw new Error('unexpected part'); file(source);"
+    };
+    let mock = responses::mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("file-exec-response"),
+                ev_custom_tool_call("file-exec", "exec", source),
+                ev_completed("file-exec-response"),
+            ]),
+            sse(vec![
+                ev_assistant_message("file-done", "done"),
+                ev_completed("file-final"),
+            ]),
+        ],
+    )
+    .await;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Forward the typed file with file().".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    let request = wait_for_event_match(&test.codex, |event| match event {
+        EventMsg::DynamicToolCallRequest(request) => Some(request.clone()),
+        _ => None,
+    })
+    .await;
+    test.codex
+        .submit(Op::DynamicToolResponse {
+            id: request.call_id,
+            response: DynamicToolResponse {
+                success: true,
+                content_items: vec![DynamicToolCallOutputContentItem::InputFile {
+                    file: codex_protocol::input_file::InputFile::from_file_id(
+                        "file-provider-reference".into(),
+                        Some("report.pdf".into()),
+                    )
+                    .expect("valid synthetic file"),
+                }],
+            },
+        })
+        .await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let requests = mock.requests();
+    assert_eq!(requests.len(), 2);
+    let output = requests[1].custom_tool_call_output("file-exec");
+    let parts = custom_tool_output_items(&requests[1], "file-exec");
+    if invalid_format {
+        assert!(!parts.iter().any(|part| part["type"] == "input_file"));
+        assert!(output.to_string().contains("file expects exactly one"));
+    } else {
+        assert!(parts.contains(&serde_json::json!({"type":"input_file", "file_id":"file-provider-reference", "filename":"report.pdf"})));
+    }
+    Ok(())
+}
