new file mode 100644
index 0000000000000000000000000000000000000000..4e794f69225f404134b285cbe9a6c22e95e992a6
--- /dev/null
+++ b/codex-rs/core/src/session/model_invocation_deadline.rs
@@ -0,0 +1,679 @@
+//! One local invocation clock; never drop the invocation future on expiry.
+use codex_extension_api::TurnSamplingStop;
+use std::future::Future;
+use std::sync::Arc;
+use std::sync::Mutex;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+pub(crate) fn selected_timeout_ms(
+    timeout: Option<u32>,
+    source: &codex_protocol::protocol::SessionSource,
+) -> Option<u32> {
+    use codex_protocol::protocol::{SessionSource, SubAgentSource};
+    if source.is_internal()
+        || matches!(
+            source,
+            SessionSource::SubAgent(SubAgentSource::Review | SubAgentSource::Compact)
+        )
+        || crate::guardian::is_basic_session_source(source)
+    {
+        None
+    } else {
+        timeout
+    }
+}
+
+struct RequestTasks {
+    handles: Vec<tokio::task::JoinHandle<()>>,
+    errors: Vec<String>,
+}
+
+pub(crate) struct ModelInvocationDeadline {
+    tasks: std::sync::OnceLock<tokio::sync::Mutex<RequestTasks>>,
+    state: std::sync::OnceLock<Arc<codex_extension_api::ModelInvocationDeadlineState>>,
+    timeout_ms: Option<u32>,
+    turn_stop: Option<Arc<TurnSamplingStop>>,
+    started: CancellationToken,
+    accepted: CancellationToken,
+    request_cancel: CancellationToken,
+    stream_stop: Mutex<Option<CancellationToken>>,
+    producer_stop: Mutex<Option<tokio::sync::oneshot::Sender<()>>>,
+}
+
+impl ModelInvocationDeadline {
+    pub(crate) fn new(
+        timeout_ms: Option<u32>,
+        request_cancel: CancellationToken,
+        turn_stop: Option<Arc<TurnSamplingStop>>,
+    ) -> Self {
+        let owner = Self::new_deferred(timeout_ms, request_cancel, turn_stop);
+        owner.start();
+        owner
+    }
+
+    pub(crate) fn new_deferred(
+        timeout_ms: Option<u32>,
+        request_cancel: CancellationToken,
+        turn_stop: Option<Arc<TurnSamplingStop>>,
+    ) -> Self {
+        Self {
+            tasks: std::sync::OnceLock::new(),
+            state: std::sync::OnceLock::new(),
+            timeout_ms,
+            turn_stop,
+            started: CancellationToken::new(),
+            accepted: CancellationToken::new(),
+            request_cancel,
+            stream_stop: Mutex::new(None),
+            producer_stop: Mutex::new(None),
+        }
+    }
+
+    /// The first factory starts the only clock. Retry preparation uses this same state.
+    pub(crate) fn start(&self) {
+        if let Some(ms) = self.timeout_ms {
+            self.state.get_or_init(|| {
+                let state = Arc::new(codex_extension_api::ModelInvocationDeadlineState::new(
+                    Instant::now() + std::time::Duration::from_millis(u64::from(ms)),
+                    self.request_cancel.clone(),
+                ));
+                if let Some(stop) = &self.turn_stop {
+                    stop.install_model_deadline(state.clone());
+                }
+                state
+            });
+            self.started.cancel();
+        }
+    }
+
+    pub(crate) fn cancellation_token(&self) -> CancellationToken {
+        self.request_cancel.clone()
+    }
+
+    pub(crate) fn attach_tasks(&self, tasks: [Option<tokio::task::JoinHandle<()>>; 2]) {
+        let tasks_owner = self.tasks.get_or_init(|| {
+            tokio::sync::Mutex::new(RequestTasks {
+                handles: Vec::new(),
+                errors: Vec::new(),
+            })
+        });
+        // A retry starts only after the previous attempt's retire_tasks completed.
+        // Outer abort joins the sampler before taking this lock. Register without
+        // an await so cancellation cannot detach freshly returned handles.
+        let mut owned = tasks_owner
+            .try_lock()
+            .expect("request retirement overlaps registration");
+        assert!(
+            owned.handles.is_empty(),
+            "prior attempt request tasks are still live"
+        );
+        owned.handles.extend(tasks.into_iter().flatten());
+    }
+
+    /// Retire only this request. A cached connection pump belongs to its pool.
+    pub(crate) fn stop_owned_streams(&self) {
+        if let Some(stop) = self
+            .stream_stop
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .as_ref()
+        {
+            stop.cancel();
+        }
+        if let Some(producer) = self
+            .producer_stop
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take()
+        {
+            let _ = producer.send(());
+        }
+    }
+
+    pub(crate) fn cancel_for_retirement(&self) {
+        self.request_cancel.cancel();
+        self.stop_owned_streams();
+    }
+
+    /// Cancellation drops a borrow, never the stored JoinHandle. The outer abort
+    /// owner joins the sampler first, then can resume these exact joins.
+    pub(crate) async fn retire_tasks(&self) -> Vec<String> {
+        self.stop_owned_streams();
+        let Some(tasks) = self.tasks.get() else {
+            return Vec::new();
+        };
+        let mut tasks = tasks.lock().await;
+        while let Some(task) = tasks.handles.last_mut() {
+            let result = task.await;
+            // Record the completed result before removing its handle. No await
+            // separates these steps, so cancellation cannot detach the handle.
+            if let Err(error) = result {
+                if !error.is_cancelled() {
+                    tasks
+                        .errors
+                        .push(format!("request task retirement failed: {error}"));
+                }
+            }
+            tasks.handles.pop();
+        }
+        tasks.errors.clone()
+    }
+
+    pub(crate) fn abort_error(
+        &self,
+        primary: Option<codex_protocol::protocol::ErrorEvent>,
+        errors: Vec<String>,
+    ) -> Option<codex_protocol::protocol::ErrorEvent> {
+        if self.expired() {
+            let mut causes = errors;
+            if let Some(primary) = primary {
+                causes.push(primary.message);
+            }
+            let suffix = if causes.is_empty() {
+                String::new()
+            } else {
+                format!("; {}", causes.join("; "))
+            };
+            return Some(
+                codex_protocol::error::CodexErr::ModelInvocationDeadlineExceeded(suffix)
+                    .to_error_event(None),
+            );
+        }
+        if errors.is_empty() {
+            return primary;
+        }
+        let details = format!("model request retirement failed: {}", errors.join("; "));
+        match primary {
+            Some(mut primary) => {
+                primary.message.push_str(&format!("; {details}"));
+                Some(primary)
+            }
+            None => Some(codex_protocol::error::CodexErr::Fatal(details).to_error_event(None)),
+        }
+    }
+
+    pub(crate) fn expired(&self) -> bool {
+        self.state.get().is_some_and(|state| state.expired())
+    }
+
+    pub(crate) fn attach_stream_stop(
+        &self,
+        stop: CancellationToken,
+        producer: Option<tokio::sync::oneshot::Sender<()>>,
+    ) {
+        if let Some(producer) = producer {
+            if self.expired() {
+                let _ = producer.send(());
+            } else {
+                *self
+                    .producer_stop
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner) = Some(producer);
+            }
+        }
+        let mut current = self
+            .stream_stop
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if self.expired() {
+            stop.cancel();
+        }
+        *current = Some(stop);
+    }
+
+    fn expire(&self) {
+        if let Some(state) = self.state.get() {
+            state.expire_if_due();
+        }
+        if !self.expired() {
+            return;
+        }
+        self.request_cancel.cancel();
+        self.stop_owned_streams();
+    }
+
+    pub(crate) fn accept_terminal(&self) -> bool {
+        match self.state.get() {
+            Some(state) => state.accept_outcome(),
+            None => {
+                self.accepted.cancel();
+                true
+            }
+        }
+    }
+
+    pub(crate) fn accept_outcome(&self) {
+        if let Some(state) = self.state.get() {
+            state.accept_outcome();
+        }
+        self.accepted.cancel();
+    }
+
+    /// Poll timer and invocation together, retaining the invocation's awaits.
+    /// Acceptance here precedes mapper/tool/durability cleanup in the caller.
+    pub(crate) async fn run<F: Future>(&self, invocation: F) -> F::Output {
+        let watchdog = async {
+            tokio::select! {
+                biased;
+                _ = self.accepted.cancelled() => return,
+                _ = self.started.cancelled() => {},
+            }
+            if let Some(state) = self.state.get() {
+                let settled = state.settled();
+                tokio::select! {
+                    biased;
+                    _ = settled.cancelled() => {},
+                    _ = tokio::time::sleep_until(state.expires_at()) => { state.expire_if_due(); },
+                    _ = self.request_cancel.cancelled() => state.cancel(),
+                }
+                if state.expired() {
+                    self.expire();
+                }
+            }
+        };
+        let invoke = async {
+            let outcome = invocation.await;
+            self.accept_outcome();
+            outcome
+        };
+        let (_, outcome) = tokio::join!(biased; watchdog, invoke);
+        outcome
+    }
+}
