new file mode 100644
index 0000000000000000000000000000000000000000..93a84639ce2c64762d2a35d47111a67f79be69e6
--- /dev/null
+++ b/codex-rs/protocol/src/input_file.rs
@@ -0,0 +1,379 @@
+//! Provider-owned file references shared by user input and tool output.
+//! Validation performs no host file access, network access, upload, or content estimation.
+
+use base64::Engine;
+use base64::engine::general_purpose::{STANDARD, STANDARD_NO_PAD};
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+use serde::de::Error as _;
+use serde_json::Value;
+use std::collections::HashMap;
+use ts_rs::TS;
+
+#[derive(Clone, PartialEq, Eq, Serialize, JsonSchema, TS)]
+pub struct InputFile {
+    #[serde(flatten)]
+    source: InputFileSource,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    filename: Option<String>,
+}
+
+#[derive(Clone, PartialEq, Eq, Serialize, TS)]
+#[serde(untagged)]
+#[ts(untagged)]
+pub enum InputFileSource {
+    Id { file_id: String },
+    Data { file_data: String },
+    Url { file_url: String },
+}
+
+impl JsonSchema for InputFileSource {
+    fn schema_name() -> String {
+        "InputFileSource".into()
+    }
+    fn json_schema(_: &mut schemars::r#gen::SchemaGenerator) -> schemars::schema::Schema {
+        use schemars::schema::{
+            InstanceType, ObjectValidation, Schema, SchemaObject, SubschemaValidation,
+        };
+        let keys = ["file_id", "file_data", "file_url"];
+        let choices = keys
+            .iter()
+            .map(|key| {
+                let mut object = ObjectValidation::default();
+                object.required.insert((*key).into());
+                object.properties.insert(
+                    (*key).into(),
+                    SchemaObject {
+                        instance_type: Some(InstanceType::String.into()),
+                        string: Some(Box::new(schemars::schema::StringValidation {
+                            min_length: Some(1),
+                            ..Default::default()
+                        })),
+                        ..Default::default()
+                    }
+                    .into(),
+                );
+                for other in keys.iter().filter(|other| *other != key) {
+                    object
+                        .properties
+                        .insert((*other).into(), Schema::Bool(false));
+                }
+                SchemaObject {
+                    instance_type: Some(InstanceType::Object.into()),
+                    object: Some(Box::new(object)),
+                    ..Default::default()
+                }
+                .into()
+            })
+            .collect();
+        SchemaObject {
+            subschemas: Some(Box::new(SubschemaValidation {
+                one_of: Some(choices),
+                ..Default::default()
+            })),
+            ..Default::default()
+        }
+        .into()
+    }
+}
+
+impl std::fmt::Debug for InputFile {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        // File bytes and URL queries must not enter ordinary diagnostic previews.
+        f.debug_struct("InputFile")
+            .field("source", &self.source_kind())
+            .finish_non_exhaustive()
+    }
+}
+
+impl InputFile {
+    pub fn from_file_id(file_id: String, filename: Option<String>) -> Result<Self, String> {
+        Self::new(InputFileSource::Id { file_id }, filename)
+    }
+    pub fn from_file_data(file_data: String, filename: Option<String>) -> Result<Self, String> {
+        Self::new(InputFileSource::Data { file_data }, filename)
+    }
+    pub fn from_file_url(file_url: String, filename: Option<String>) -> Result<Self, String> {
+        Self::new(InputFileSource::Url { file_url }, filename)
+    }
+    fn new(source: InputFileSource, filename: Option<String>) -> Result<Self, String> {
+        let value = match &source {
+            InputFileSource::Id { file_id } => file_id,
+            InputFileSource::Data { file_data } => {
+                let payload = if file_data
+                    .get(..5)
+                    .is_some_and(|prefix| prefix.eq_ignore_ascii_case("data:"))
+                {
+                    let (metadata, payload) = file_data[5..]
+                        .split_once(',')
+                        .ok_or("file_data must contain base64 data")?;
+                    if !metadata.to_ascii_lowercase().ends_with(";base64") {
+                        return Err("file_data must contain base64 data".into());
+                    }
+                    payload
+                } else {
+                    file_data.as_str()
+                };
+                // Validate inline bytes locally, without retaining a decoded cache or estimating document tokens.
+                if payload.is_empty()
+                    || STANDARD
+                        .decode(payload)
+                        .or_else(|_| STANDARD_NO_PAD.decode(payload))
+                        .is_err()
+                {
+                    return Err("file_data must contain base64 data".into());
+                }
+                file_data
+            }
+            InputFileSource::Url { file_url } => {
+                let parsed = gix_url::parse(file_url.as_bytes().into())
+                    .map_err(|_| "file_url must be an absolute HTTPS URL".to_owned())?;
+                if parsed.scheme != gix_url::Scheme::Https
+                    || parsed.host.as_deref().is_none_or(str::is_empty)
+                {
+                    return Err("file_url must be an absolute HTTPS URL".into());
+                }
+                file_url
+            }
+        };
+        if value.trim().is_empty() {
+            return Err("file source must be nonempty".into());
+        }
+        Ok(Self { source, filename })
+    }
+    /// Validate against actual current metadata captured by the live owner, never a saved claim.
+    pub fn validate_for_model(
+        &self,
+        profile: crate::provider_reference_profile::ProviderImageReferencePolicy,
+        model: &crate::openai_models::ModelInfo,
+    ) -> Result<(), String> {
+        if profile != crate::provider_reference_profile::ProviderImageReferencePolicy::QualifiedStandardResponses || model.use_responses_lite {
+            return Err("file input requires the current qualified standard Responses route".into());
+        }
+        if self
+            .inline_mime_type()
+            .is_some_and(|mime| mime.eq_ignore_ascii_case("application/pdf"))
+            && !model
+                .input_modalities
+                .contains(&crate::openai_models::InputModality::Image)
+        {
+            return Err("PDF input requires a model declaring image input support".into());
+        }
+        Ok(())
+    }
+    pub fn into_parts(self) -> (InputFileSource, Option<String>) {
+        (self.source, self.filename)
+    }
+    pub fn source(&self) -> &InputFileSource {
+        &self.source
+    }
+    pub fn filename(&self) -> Option<&str> {
+        self.filename.as_deref()
+    }
+    pub fn source_kind(&self) -> &'static str {
+        match self.source {
+            InputFileSource::Id { .. } => "file_id",
+            InputFileSource::Data { .. } => "file_data",
+            InputFileSource::Url { .. } => "file_url",
+        }
+    }
+    /// A caller-declared inline MIME type, not a claim about opaque IDs or URLs.
+    pub fn inline_mime_type(&self) -> Option<&str> {
+        let InputFileSource::Data { file_data } = &self.source else {
+            return None;
+        };
+        if !file_data
+            .get(..5)
+            .is_some_and(|prefix| prefix.eq_ignore_ascii_case("data:"))
+        {
+            return None;
+        }
+        file_data[5..]
+            .split_once(',')?
+            .0
+            .split(';')
+            .next()
+            .filter(|mime| !mime.is_empty())
+    }
+}
+
+impl<'de> Deserialize<'de> for InputFile {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let mut fields = HashMap::<String, Value>::deserialize(deserializer)?;
+        let filename = fields
+            .remove("filename")
+            .filter(|value| !value.is_null())
+            .map(serde_json::from_value)
+            .transpose()
+            .map_err(D::Error::custom)?;
+        let id = fields.remove("file_id");
+        let data = fields.remove("file_data");
+        let url = fields.remove("file_url");
+        let source = match (id, data, url) {
+            (Some(Value::String(file_id)), None, None) => InputFileSource::Id { file_id },
+            (None, Some(Value::String(file_data)), None) => InputFileSource::Data { file_data },
+            (None, None, Some(Value::String(file_url))) => InputFileSource::Url { file_url },
+            _ => {
+                return Err(D::Error::custom(
+                    "file must contain exactly one file_id, file_data, or file_url",
+                ));
+            }
+        };
+        Self::new(source, filename).map_err(D::Error::custom)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn file_sources_round_trip_without_fetch_or_rewrite() {
+        for value in [
+            json!({"file_id":"file-opaque"}),
+            json!({"file_data":"data:application/pdf;base64,JVBERi0=","filename":"report.pdf"}),
+            json!({"file_data":"JVBERi0="}),
+            json!({"file_url":"https://example.invalid/report.pdf?secret=keep#page=1"}),
+        ] {
+            let file: InputFile = serde_json::from_value(value.clone()).unwrap();
+            assert_eq!(serde_json::to_value(&file).unwrap(), value);
+            let debug = format!("{file:?}");
+            assert!(!debug.contains("JVBERi0"));
+            assert!(!debug.contains("secret"));
+        }
+    }
+
+    #[test]
+    fn file_sources_reject_ambiguous_empty_and_non_https_inputs() {
+        for value in [
+            json!({}),
+            json!({"file_id":""}),
+            json!({"file_id":" "}),
+            json!({"file_data":123}),
+            json!({"file_data":"not base64!"}),
+            json!({"file_data":"data:application/pdf;base64,"}),
+            json!({"file_data":"data:text/plain,unencoded"}),
+            json!({"file_id":"file-a","file_data":null}),
+            json!({"file_data":"AA==","file_url":"https://example.invalid/a"}),
+            json!({"file_url":"http://example.invalid/a"}),
+            json!({"file_url":"file:///private/a"}),
+            json!({"file_url":"relative.pdf"}),
+            json!({"file_id":"a","filename":123}),
+        ] {
+            assert!(
+                serde_json::from_value::<InputFile>(value.clone()).is_err(),
+                "{value}"
+            );
+        }
+    }
+
+    #[test]
+    fn inline_filename_remains_optional_and_opaque_types_remain_unknown() {
+        let inline =
+            InputFile::from_file_data("data:application/pdf;base64,AA==".into(), None).unwrap();
+        assert_eq!(inline.filename(), None);
+        assert_eq!(inline.inline_mime_type(), Some("application/pdf"));
+        let remote =
+            InputFile::from_file_url("https://example.invalid/file.pdf".into(), None).unwrap();
+        assert_eq!(remote.inline_mime_type(), None);
+        assert_eq!(
+            InputFile::from_file_id("opaque".into(), None)
+                .unwrap()
+                .inline_mime_type(),
+            None
+        );
+    }
+    fn actual_test_model() -> crate::openai_models::ModelInfo {
+        let model: crate::openai_models::ModelInfo = serde_json::from_value(serde_json::json!({
+            "slug": "test-model",
+            "display_name": "Test Model",
+            "description": null,
+            "supported_reasoning_levels": [],
+            "shell_type": "unified_exec",
+            "visibility": "list",
+            "supported_in_api": true,
+            "priority": 1,
+            "upgrade": null,
+            "model_messages": null,
+            "default_reasoning_summary": "auto",
+            "support_verbosity": false,
+            "default_verbosity": null,
+            "apply_patch_tool_type": null,
+            "truncation_policy": {
+                "mode": "bytes",
+                "limit": 10000
+            },
+            "supports_image_detail_original": false,
+            "context_window": null,
+            "auto_compact_token_limit": null,
+            "effective_context_window_percent": 95,
+            "experimental_supported_tools": []
+        }))
+        .expect("deserialize model info");
+        model
+    }
+
+    #[test]
+    fn admission_uses_current_route_and_actual_model_without_inventing_file_type() {
+        use crate::provider_reference_profile::ProviderImageReferencePolicy::{
+            PrepareInline, QualifiedStandardResponses,
+        };
+        let opaque = InputFile::from_file_id("file-opaque".into(), None).unwrap();
+        let pdf =
+            InputFile::from_file_data("data:application/pdf;base64,JVBERi0=".into(), None).unwrap();
+        let mut model = actual_test_model();
+        assert!(opaque.validate_for_model(PrepareInline, &model).is_err());
+        assert!(
+            opaque
+                .validate_for_model(QualifiedStandardResponses, &model)
+                .is_ok()
+        );
+        model.use_responses_lite = true;
+        assert!(
+            opaque
+                .validate_for_model(QualifiedStandardResponses, &model)
+                .is_err()
+        );
+        model.use_responses_lite = false;
+        model.input_modalities = vec![crate::openai_models::InputModality::Text];
+        assert!(
+            pdf.validate_for_model(QualifiedStandardResponses, &model)
+                .is_err()
+        );
+        // An ID/URL does not reveal its type. Let the service validate the opaque resource.
+        assert!(
+            opaque
+                .validate_for_model(QualifiedStandardResponses, &model)
+                .is_ok()
+        );
+        model
+            .input_modalities
+            .push(crate::openai_models::InputModality::Image);
+        assert!(
+            pdf.validate_for_model(QualifiedStandardResponses, &model)
+                .is_ok()
+        );
+    }
+
+    #[test]
+    fn user_and_tool_files_have_one_canonical_wire_descriptor() {
+        use crate::models::{ContentItem, FunctionCallOutputContentItem};
+        let file =
+            InputFile::from_file_url("https://example.invalid/report?token=opaque".into(), None)
+                .unwrap();
+        let user = ContentItem::InputFile { file: file.clone() };
+        let tool = FunctionCallOutputContentItem::InputFile { file: file.clone() };
+        let expected =
+            json!({"type":"input_file","file_url":"https://example.invalid/report?token=opaque"});
+        assert_eq!(serde_json::to_value(user).unwrap(), expected);
+        assert_eq!(serde_json::to_value(tool).unwrap(), expected);
+        let dynamic = crate::dynamic_tools::DynamicToolCallOutputContentItem::InputFile { file };
+        assert_eq!(
+            serde_json::to_value(dynamic).unwrap(),
+            json!({"type":"inputFile","file_url":"https://example.invalid/report?token=opaque"})
+        );
+    }
+}
