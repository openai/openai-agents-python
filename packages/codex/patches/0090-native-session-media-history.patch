+async fn try_complete_tool_turn(
+    sess: &Arc<Session>,
+    step_context: &Arc<StepContext>,
+    tools: &SettledDirectTools,
+    cancellation_token: &CancellationToken,
+    stop_hook_active: &mut bool,
+) -> CodexResult<bool> {
+    if let Some(completion) =
+        propose_tool_completion(sess, step_context, tools, cancellation_token).await?
+    {
+        let stop = run_turn_stop_hooks(sess, step_context, *stop_hook_active, None).await;
+        if stop.should_stop {
+            return Err(CodexErr::TurnAborted);
+        }
+        if stop.should_block {
+            if let Some(message) = build_hook_prompt_message(&stop.continuation_fragments) {
+                sess.record_response_item_and_emit_turn_item(
+                    &step_context.turn,
+                    &step_context.settings.model_info,
+                    message,
+                )
+                .await;
+                *stop_hook_active = true;
+            }
+        } else if sess
+            .input_queue
+            .reserve_tool_completion(
+                &sess.active_turn,
+                &step_context.turn.sub_id,
+                cancellation_token,
+            )
+            .await
+        {
+            step_context
+                .turn
+                .extension_data
+                .insert(ValidatedToolCompletion(completion));
+            return Ok(true);
+        }
+    }
+
+    Ok(false)
+}
