+#[tokio::test]
+async fn tool_terminal_recovery_deferred_failure_does_not_record_input_twice() {
+    let (session, turn, events) =
+        crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+            CodexAuth::from_api_key("synthetic-recovery-test"),
+            Vec::new(),
+            |config| {
+                config.model_auto_compact_token_limit = Some(1);
+                config.model_auto_compact_token_limit_scope =
+                    AutoCompactTokenLimitScope::BodyAfterPrefix;
+            },
+        )
+        .await;
+    let mut session = Arc::try_unwrap(session)
+        .ok()
+        .expect("unshared test session");
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.model_request_contributor(Arc::new(RejectDeferredCompaction));
+    session.services.extensions = Arc::new(extensions.build());
+    let session = Arc::new(session);
+    let step = StepContext::for_test(turn.clone());
+    // History counts local input only after a model-generated item.
+    session
+        .record_conversation_items(
+            &turn,
+            &step.settings.model_info,
+            &[assistant_output_text("Recovered model batch prefix")],
+        )
+        .await;
+    // This direct helper fixture skips startup, which normally seeds the prefix.
+    let prefix_tokens = session.get_total_token_usage().await;
+    session
+        .set_auto_compact_window_estimated_prefill_for_scope(&turn, prefix_tokens)
+        .await;
+    // Include the effective fallback buffer rather than assuming it is zero.
+    let pressure_tokens = turn
+        .config
+        .model_auto_compact_token_limit
+        .unwrap()
+        .saturating_add(
+            turn.config
+                .token_budget
+                .as_ref()
+                .map_or(0, crate::config::TokenBudgetConfig::fallback_buffer_tokens),
+        );
+    let text =
+        "ACCEPTED_RECOVERY_INPUT ".repeat(usize::try_from(pressure_tokens).unwrap().max(200));
+    let item = serde_json::from_value(serde_json::json!({
+        "type":"message","role":"user","content":[{"type":"input_text","text":text}],
+    }))
+    .unwrap();
+    let input = vec![TurnInput::ResponseItem(
+        codex_history::ResponseItemEnvelope::new(item),
+    )];
+    assert!(
+        !run_hooks_and_record_inputs(
+            &session,
+            &turn,
+            &step.settings.model_info,
+            &input,
+            PersistContext::TurnStart
+        )
+        .await
+    );
+    assert!(
+        crate::session::context_window::context_window_token_status(&session, &turn)
+            .await
+            .token_limit_reached,
+        "fixture must enter deferred compaction before checking failure reporting"
+    );
+    let mut client = session.services.model_client.new_session();
+    assert!(
+        !pre_sampling_compaction_or_report(
+            &session,
+            &turn,
+            &mut client,
+            &input,
+            &CancellationToken::new(),
+            Some(step),
+            true,
+        )
+        .await
+        .unwrap()
+    );
+    let mut error_events = 0;
+    while let Ok(event) = events.try_recv() {
+        if matches!(event.msg, EventMsg::Error(_)) {
+            error_events += 1;
+        }
+    }
+    assert_eq!(error_events, 1);
+    let history = session.clone_history().await;
+    assert_eq!(history.raw_items().filter(|item| matches!(item,
+        ResponseItem::Message { content, .. } if content.iter().any(|part|
+            matches!(part, ContentItem::InputText { text } if text.contains("ACCEPTED_RECOVERY_INPUT"))))).count(), 1);
+}
