diff --git a/codex-rs/ext/extension-api/src/contributors.rs b/codex-rs/ext/extension-api/src/contributors.rs
index a2f6201b78186775e214011053f58d1ddba0bb0f..02d04b073e80ff0606ef15097b761bb3d4e68a22 100644
--- a/codex-rs/ext/extension-api/src/contributors.rs
+++ b/codex-rs/ext/extension-api/src/contributors.rs
@@ -58,6 +58,9 @@ pub use tool_lifecycle::ToolTimingBoundary;
 pub use tool_lifecycle::ToolTimingInput;
 pub use turn_input::TurnInputContext;
 pub use turn_input::TurnInputEnvironment;
+pub use turn_lifecycle::RecoveredToolCompletionCandidates;
+pub use turn_lifecycle::ToolCompletionDecision;
+pub use turn_lifecycle::ToolCompletionInput;
 pub use turn_lifecycle::TurnAbortInput;
 pub use turn_lifecycle::TurnCompletionInput;
 pub use turn_lifecycle::TurnErrorInput;
@@ -205,6 +208,17 @@ pub trait ThreadLifecycleContributor<C: Sync>: Send + Sync {
 /// extension-private turn state. The host exposes stable identifiers and
 /// extension stores instead of core runtime objects.
 pub trait TurnLifecycleContributor: Send + Sync {
+    /// Propose completion from one accepted direct function result. Disabled by
+    /// default. Core invokes this only after every sibling has settled successfully,
+    /// in model call order, and stops at the first eligible result. Errors fail the
+    /// turn; Continue keeps the ordinary sampling loop without replaying a tool.
+    fn propose_tool_completion<'a>(
+        &'a self,
+        _input: ToolCompletionInput<'a>,
+    ) -> ExtensionFuture<'a, Result<Option<ToolCompletionDecision>, String>> {
+        Box::pin(std::future::ready(Ok(None)))
+    }
+
