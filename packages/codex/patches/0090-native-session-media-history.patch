+        .expect("restored child");
+    assert_reference_output(
+        &request_existing_images(&server, &restored, full_history).await,
+        true,
+    );
+    let shutdown = f
+        .manager
+        .shutdown_all_threads_bounded(std::time::Duration::from_secs(10))
+        .await;
+    assert!(shutdown.timed_out.is_empty());
+}
