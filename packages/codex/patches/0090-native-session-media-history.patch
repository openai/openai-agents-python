+impl Session {
+    /// Cancel the exact issuing task; its existing finalizer owns cleanup and reporting.
+    pub(crate) async fn cancel_code_mode_owner(
+        self: &Arc<Self>,
+        owner: &Arc<crate::session::turn_context::TurnContext>,
+    ) {
+        let active = self.active_turn.lock().await;
+        if let Some(task) = active.as_ref().and_then(|turn| turn.task.as_ref())
+            && Arc::ptr_eq(&task.turn_context, owner)
+        {
+            owner
+                .extension_data
+                .get_or_init(codex_extension_api::TurnSamplingStop::default)
+                .request();
+            task.cancellation_token.cancel();
+        }
+    }
+}
