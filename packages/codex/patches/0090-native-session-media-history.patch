+struct OwnerErrorRecorder(Arc<Mutex<Vec<String>>>);
+impl codex_extension_api::TurnLifecycleContributor for OwnerErrorRecorder {
+    fn on_turn_error<'a>(
+        &'a self,
+        input: codex_extension_api::TurnErrorInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            self.0.lock().unwrap().push(input.turn_id.to_owned());
+        })
+    }
+}
+#[derive(Clone)]
+struct OwnedCancellationTask {
+    started: CancellationToken,
+    observed_cancel: CancellationToken,
+    return_after_cancel: CancellationToken,
+    publish_primary: bool,
+}
+impl crate::tasks::SessionTask for OwnedCancellationTask {
+    fn kind(&self) -> crate::state::TaskKind {
+        crate::state::TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "test.owned_callback_failure"
+    }
+    async fn run(
+        self: Arc<Self>,
+        session: Arc<crate::session::session::Session>,
+        turn: Arc<crate::session::turn_context::TurnContext>,
+        _input: Vec<crate::session::TurnInput>,
+        cancellation: CancellationToken,
+    ) -> crate::tasks::SessionTaskResult {
+        if self.publish_primary {
+            let original = crate::error::CodexErr::Fatal("original model failure".into());
+            session
+                .emit_turn_error_lifecycle(
+                    turn.as_ref(),
+                    original.to_codex_protocol_error(),
+                    original.details(),
+                )
+                .await;
+            session
+                .send_event(
+                    turn.as_ref(),
+                    codex_protocol::protocol::EventMsg::Error(original.to_error_event(None)),
+                )
+                .await;
+        }
+        self.started.cancel();
+        cancellation.cancelled().await;
+        self.observed_cancel.cancel();
+        self.return_after_cancel.cancelled().await;
+        Err(crate::error::CodexErr::TurnAborted)
+    }
+}
+async fn owned_spawn_session() -> (
+    Arc<crate::session::session::Session>,
+    Arc<crate::session::turn_context::TurnContext>,
+    async_channel::Receiver<codex_protocol::protocol::Event>,
+    Arc<Mutex<Vec<String>>>,
+) {
+    let (mut session, turn, events) =
+        crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+            codex_login::CodexAuth::from_api_key("Test API Key"),
+            Vec::new(),
+            |config| {
+                config
+                    .features
+                    .enable(crate::features::Feature::CodeModeInterrupt)
+                    .unwrap();
+            },
+        )
+        .await;
+    let records = Arc::new(Mutex::new(Vec::new()));
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.turn_lifecycle_contributor(Arc::new(OwnerErrorRecorder(Arc::clone(&records))));
+    Arc::get_mut(&mut session)
+        .expect("unshared fixture")
+        .services
+        .extensions = Arc::new(builder.build());
+    (session, turn, events, records)
+}
+fn owned_task(publish_primary: bool) -> OwnedCancellationTask {
+    OwnedCancellationTask {
+        started: CancellationToken::new(),
+        observed_cancel: CancellationToken::new(),
+        return_after_cancel: CancellationToken::new(),
+        publish_primary,
+    }
+}
+async fn owner_gate_is_held(session: &Arc<crate::session::session::Session>) {
+    tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        loop {
+            if let Some(gate) = session
+                .services
+                .thread_extension_data
+                .get::<crate::tasks::TaskFinalization>()
+                && gate.0.try_lock().is_err()
+            {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+}
