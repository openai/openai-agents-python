+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn file_sources_round_trip_without_fetch_or_rewrite() {
+        for value in [
+            json!({"file_id":"file-opaque"}),
+            json!({"file_data":"data:application/pdf;base64,JVBERi0=","filename":"report.pdf"}),
+            json!({"file_data":"JVBERi0="}),
+            json!({"file_url":"https://example.invalid/report.pdf?secret=keep#page=1"}),
+        ] {
+            let file: InputFile = serde_json::from_value(value.clone()).unwrap();
+            assert_eq!(serde_json::to_value(&file).unwrap(), value);
+            let debug = format!("{file:?}");
+            assert!(!debug.contains("JVBERi0"));
+            assert!(!debug.contains("secret"));
+        }
+    }
+
+    #[test]
+    fn file_sources_reject_ambiguous_empty_and_non_https_inputs() {
+        for value in [
+            json!({}),
+            json!({"file_id":""}),
+            json!({"file_id":" "}),
+            json!({"file_data":123}),
+            json!({"file_data":"not base64!"}),
+            json!({"file_data":"data:application/pdf;base64,"}),
+            json!({"file_data":"data:text/plain,unencoded"}),
+            json!({"file_id":"file-a","file_data":null}),
+            json!({"file_data":"AA==","file_url":"https://example.invalid/a"}),
+            json!({"file_url":"http://example.invalid/a"}),
+            json!({"file_url":"file:///private/a"}),
+            json!({"file_url":"relative.pdf"}),
+            json!({"file_id":"a","filename":123}),
+        ] {
+            assert!(
+                serde_json::from_value::<InputFile>(value.clone()).is_err(),
+                "{value}"
+            );
+        }
+    }
+
+    #[test]
+    fn inline_filename_remains_optional_and_opaque_types_remain_unknown() {
+        let inline =
+            InputFile::from_file_data("data:application/pdf;base64,AA==".into(), None).unwrap();
+        assert_eq!(inline.filename(), None);
+        assert_eq!(inline.inline_mime_type(), Some("application/pdf"));
+        let remote =
+            InputFile::from_file_url("https://example.invalid/file.pdf".into(), None).unwrap();
+        assert_eq!(remote.inline_mime_type(), None);
+        assert_eq!(
+            InputFile::from_file_id("opaque".into(), None)
+                .unwrap()
+                .inline_mime_type(),
+            None
+        );
+    }
+    fn actual_test_model() -> crate::openai_models::ModelInfo {
+        let model: crate::openai_models::ModelInfo = serde_json::from_value(serde_json::json!({
+            "slug": "test-model",
+            "display_name": "Test Model",
+            "description": null,
+            "supported_reasoning_levels": [],
+            "shell_type": "unified_exec",
+            "visibility": "list",
+            "supported_in_api": true,
+            "priority": 1,
+            "upgrade": null,
+            "model_messages": null,
+            "default_reasoning_summary": "auto",
+            "support_verbosity": false,
+            "default_verbosity": null,
+            "apply_patch_tool_type": null,
+            "truncation_policy": {
+                "mode": "bytes",
+                "limit": 10000
+            },
+            "supports_image_detail_original": false,
+            "context_window": null,
+            "auto_compact_token_limit": null,
+            "effective_context_window_percent": 95,
+            "experimental_supported_tools": []
+        }))
+        .expect("deserialize model info");
+        model
+    }
+
+    #[test]
+    fn admission_uses_current_route_and_actual_model_without_inventing_file_type() {
+        use crate::provider_reference_profile::ProviderImageReferencePolicy::{
+            PrepareInline, QualifiedStandardResponses,
+        };
+        let opaque = InputFile::from_file_id("file-opaque".into(), None).unwrap();
+        let pdf =
+            InputFile::from_file_data("data:application/pdf;base64,JVBERi0=".into(), None).unwrap();
+        let mut model = actual_test_model();
+        assert!(opaque.validate_for_model(PrepareInline, &model).is_err());
+        assert!(
+            opaque
+                .validate_for_model(QualifiedStandardResponses, &model)
+                .is_ok()
+        );
+        model.use_responses_lite = true;
+        assert!(
+            opaque
+                .validate_for_model(QualifiedStandardResponses, &model)
+                .is_err()
+        );
+        model.use_responses_lite = false;
+        model.input_modalities = vec![crate::openai_models::InputModality::Text];
+        assert!(
+            pdf.validate_for_model(QualifiedStandardResponses, &model)
+                .is_err()
+        );
+        // An ID/URL does not reveal its type. Let the service validate the opaque resource.
+        assert!(
+            opaque
+                .validate_for_model(QualifiedStandardResponses, &model)
+                .is_ok()
+        );
+        model
+            .input_modalities
+            .push(crate::openai_models::InputModality::Image);
+        assert!(
+            pdf.validate_for_model(QualifiedStandardResponses, &model)
+                .is_ok()
+        );
+    }
+
+    #[test]
+    fn user_and_tool_files_have_one_canonical_wire_descriptor() {
+        use crate::models::{ContentItem, FunctionCallOutputContentItem};
+        let file =
+            InputFile::from_file_url("https://example.invalid/report?token=opaque".into(), None)
+                .unwrap();
+        let user = ContentItem::InputFile { file: file.clone() };
+        let tool = FunctionCallOutputContentItem::InputFile { file: file.clone() };
+        let expected =
+            json!({"type":"input_file","file_url":"https://example.invalid/report?token=opaque"});
+        assert_eq!(serde_json::to_value(user).unwrap(), expected);
+        assert_eq!(serde_json::to_value(tool).unwrap(), expected);
+        let dynamic = crate::dynamic_tools::DynamicToolCallOutputContentItem::InputFile { file };
+        assert_eq!(
+            serde_json::to_value(dynamic).unwrap(),
+            json!({"type":"inputFile","file_url":"https://example.invalid/report?token=opaque"})
+        );
+    }
+}
