+/// Ask captured host policy about settled direct calls in original model order.
+async fn propose_tool_completion(
+    sess: &Session,
+    step: &StepContext,
+    tools: &SettledDirectTools,
+    cancellation: &CancellationToken,
+) -> CodexResult<Option<codex_protocol::protocol::ToolTurnCompletion>> {
+    if !tools.all_succeeded || tools.calls.is_empty() {
+        return Ok(None);
+    }
+    if tools.calls.len() != tools.outputs.len() {
+        return Err(CodexErr::Fatal(
+            "Settled tool receipt count mismatch".into(),
+        ));
+    }
+    for (call, output) in tools.calls.iter().zip(&tools.outputs) {
+        let ResponseItem::FunctionCall {
+            call_id,
+            name,
+            namespace,
+            ..
+        } = call
+        else {
+            continue;
+        };
+        if !matches!(output, ResponseItem::FunctionCallOutput { call_id: Some(output_id), .. } if output_id == call_id)
+        {
+            return Err(CodexErr::Fatal(
+                "Settled tool receipt identity mismatch".into(),
+            ));
+        }
+        for contributor in sess.services.extensions.turn_lifecycle_contributors() {
+            let decision = contributor
+                .propose_tool_completion(codex_extension_api::ToolCompletionInput {
+                    turn_id: &step.turn.sub_id,
+                    model: &step.settings.model_info.slug,
+                    call,
+                    output,
+                    thread_store: &sess.services.thread_extension_data,
+                    turn_store: step.turn.extension_data.as_ref(),
+                    step_store: &step.extension_data,
+                })
+                .or_cancel(cancellation)
+                .await?
+                .map_err(CodexErr::InvalidRequest)?;
+            if cancellation.is_cancelled() {
+                return Err(CodexErr::TurnAborted);
+            }
+            match decision {
+                None => continue,
+                Some(codex_extension_api::ToolCompletionDecision::Continue { feedback }) => {
+                    if let Some(feedback) = feedback {
+                        let item = build_hook_prompt_message(&[
+                            codex_protocol::items::HookPromptFragment::from_single_hook(
+                                feedback,
+                                uuid::Uuid::new_v4().to_string(),
+                            ),
+                        ])
+                        .ok_or_else(|| {
+                            CodexErr::InvalidRequest("Completion feedback must not be empty".into())
+                        })?;
+                        sess.record_response_item_and_emit_turn_item(
+                            &step.turn,
+                            &step.settings.model_info,
+                            item,
+                        )
+                        .await;
+                    }
+                    return Ok(None);
+                }
+                Some(codex_extension_api::ToolCompletionDecision::Accept { final_output }) => {
+                    return Ok(Some(codex_protocol::protocol::ToolTurnCompletion {
+                        call_id: call_id.clone(),
+                        name: name.clone(),
+                        namespace: namespace.clone(),
+                        final_output,
+                    }));
+                }
+            }
+        }
+    }
+    Ok(None)
+}
