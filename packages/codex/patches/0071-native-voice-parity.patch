+    .await
+    .unwrap();
+    tokio::time::timeout(std::time::Duration::from_secs(5), async {
+        while policy.admissions.load(std::sync::atomic::Ordering::Acquire) < 2 {
+            policy.entered.notified().await;
+        }
+    })
+    .await
+    .unwrap();
+    while let Ok(event) = events.try_recv() {
+        assert!(!matches!(event.msg, EventMsg::DynamicToolCallRequest(_)));
+    }
+    assert!(http.received_requests().await.unwrap().is_empty());
+    policy.decision.notify_waiters();
+    // Dynamic tools retain their native serialization policy; the second waits for the first result.
+    for index in 0..2 {
+        let call = tokio::time::timeout(std::time::Duration::from_secs(5), async {
+            loop {
+                if let EventMsg::DynamicToolCallRequest(call) = events.recv().await.unwrap().msg {
+                    break call;
+                }
+            }
+        })
+        .await
