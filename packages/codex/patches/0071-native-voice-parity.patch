+        self.live_thread_for_persistence("record provider item deletion")?
+            .append_items(&[RolloutItem::RealtimeItem(item.clone())])
+            .await?;
+        self.flush_rollout().await?;
+        for payload in [
+            RealtimeEvent::HistoryItemStarted(item.clone()),
+            RealtimeEvent::HistoryItemCompleted(item),
+        ] {
+            self.deliver_event_raw(Event {
+                id: submission_id.to_owned(),
+                msg: EventMsg::RealtimeConversationRealtime(RealtimeConversationRealtimeEvent {
+                    payload,
+                }),
+            })
+            .await;
+        }
+        Ok(())
+    }
