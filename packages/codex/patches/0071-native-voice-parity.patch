+/// Source declarations only. Each child creates its own clients and grants.
+#[derive(Clone)]
+pub(crate) struct InheritedMcpCatalog {
+    catalog: codex_mcp::ResolvedMcpCatalog,
+    selected_plugins: SelectedPluginSnapshot,
+    plugins_available: bool,
+    owner: Option<codex_protocol::ThreadId>,
+}
+
+impl InheritedMcpCatalog {
+    pub(crate) fn capture(
+        source: &crate::AgentSpawnSource,
+        child: &mut Config,
+    ) -> codex_protocol::error::Result<Option<Self>> {
+        let step = &source.step;
+        if !crate::realtime_conversation::uses_retained_mcp_binding(step)
+            && step.extension_data.get::<Self>().is_none()
+        {
+            return Ok(None);
+        }
+        let catalog = step.mcp.config().mcp_server_catalog.clone();
+        let servers = catalog
+            .configured_servers()
+            .into_iter()
+            .filter(|(name, _)| {
+                catalog
+                    .server(name)
+                    .is_some_and(|server| matches!(server.source(), McpServerSource::Config))
+            })
+            .collect();
+        child.mcp_servers.set(servers).map_err(|error| {
+            codex_protocol::error::CodexErr::InvalidRequest(format!(
+                "Captured child MCP configuration is not admitted: {error}"
+            ))
+        })?;
+        let selected_plugins = step
+            .extension_data
+            .get::<SelectedPluginSnapshot>()
+            .ok_or_else(|| {
+                codex_protocol::error::CodexErr::InvalidRequest(
+                    "Captured child MCP source has no plugin selection".into(),
+                )
+            })?
+            .as_ref()
+            .clone();
+        Ok(Some(Self {
+            catalog,
+            selected_plugins,
+            plugins_available: step.mcp.plugins_available(),
+            owner: None,
+        }))
+    }
+
+    pub(crate) fn validate_restore(
+        history: &codex_history::InitialHistory,
+        source: Option<&Self>,
+    ) -> anyhow::Result<()> {
+        if let codex_history::InitialHistory::Resumed(resumed) = history
+            && let Some(codex_history::RolloutItem::SessionMeta(meta)) = resumed.history.first()
+            && meta.meta.id == resumed.conversation_id
+            && meta.meta.sdk_mcp_source_required
+        {
+            anyhow::ensure!(
+                source.is_some_and(|source| source.belongs_to(resumed.conversation_id)),
+                "Restored child requires its exact live captured MCP declaration source"
+            );
+        }
+        if let codex_history::InitialHistory::Forked(items) = history
+            && let Some(codex_history::RolloutItem::SessionMeta(meta)) = items.first()
+            && meta.meta.sdk_mcp_source_required
+        {
+            anyhow::ensure!(
+                source.is_some(),
+                "Forked child requires a live captured MCP declaration source"
+            );
+        }
+        Ok(())
+    }
+
+    pub(crate) fn for_owner(&self, owner: codex_protocol::ThreadId) -> Self {
+        let mut source = self.clone();
+        source.owner = Some(owner);
+        source
+    }
+
+    pub(crate) fn belongs_to(&self, owner: codex_protocol::ThreadId) -> bool {
+        self.owner == Some(owner)
+    }
+
+    fn selected_plugins(&self, config: &Config, disabled: &[String]) -> SelectedPluginSnapshot {
+        let mut selected = self.selected_plugins.clone();
+        let suppressed: Vec<_> = selected
+            .plugins
+            .iter()
+            .filter(|plugin| {
+                !config.features.enabled(Feature::Plugins) || disabled.contains(&plugin.plugin_id)
+            })
+            .filter_map(|plugin| plugin.selected_root_id.clone())
+            .collect();
+        selected.disabled_plugin_roots.extend(suppressed);
+        selected.disabled_plugin_roots.sort();
+        selected.disabled_plugin_roots.dedup();
+        selected.plugins.retain(|plugin| {
+            config.features.enabled(Feature::Plugins) && !disabled.contains(&plugin.plugin_id)
+        });
+        selected
+    }
+
+    fn project(&self, config: &Config, disabled: &[String]) -> codex_mcp::ResolvedMcpCatalog {
+        let plugins = config.features.enabled(Feature::Plugins);
+        let servers = self
+            .catalog
+            .configured_servers()
+            .into_iter()
+            .filter(|(name, _)| {
+                let registration = self
+                    .catalog
+                    .server(name)
+                    .expect("registered captured server");
+                match registration.source() {
+                    McpServerSource::Plugin(plugin) | McpServerSource::SelectedPlugin(plugin) => {
+                        plugins && !disabled.iter().any(|id| id == plugin.plugin_id())
+                    }
+                    _ => true,
+                }
+            })
+            .collect();
+        self.catalog.with_materialized_servers(servers)
+    }
+}
