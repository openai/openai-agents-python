+// Match build_mcp_runtime_input: MCP also owns a local fallback when the
+// Session selects no local workspace environment.
+fn realtime_mcp_environment_cwds(
+    environments: &[TurnEnvironmentSelection],
+    fallback_cwd: &AbsolutePathBuf,
+) -> HashMap<String, PathUri> {
+    let mut cwds = environments
+        .iter()
+        .map(|environment| (environment.environment_id.clone(), environment.cwd.clone()))
+        .collect::<HashMap<_, _>>();
+    let cwd = environments
+        .first()
+        .and_then(|environment| environment.cwd.to_abs_path().ok())
+        .unwrap_or_else(|| fallback_cwd.clone());
+    cwds.entry(codex_config::DEFAULT_MCP_SERVER_ENVIRONMENT_ID.to_string())
+        .or_insert_with(|| PathUri::from_abs_path(&cwd));
+    cwds
+}
