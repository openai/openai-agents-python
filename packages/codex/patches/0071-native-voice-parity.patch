+async fn publish_sdk_wire_result(
+    session: &Arc<crate::session::session::Session>,
+    sdk: &Arc<super::SdkRealtimeState>,
+    connection: &codex_api::RealtimeWebsocketConnection,
+    handoff: &super::RealtimeHandoffState,
+    events: &async_channel::Sender<codex_api::RealtimeEvent>,
+    responses: &mut super::RealtimeResponseCreateQueue,
+    call_id: &str,
+) {
+    session
+        .conversation
+        .sdk_enqueue(
+            "tools-generation",
+            super::SdkRealtimeCommand::FunctionResult {
+                call_id: call_id.into(),
+                text: format!("accepted {call_id}"),
+                succeeded: true,
+                start_response: true,
+                cancellation: None,
+            },
+        )
+        .await
+        .unwrap();
+    super::handle_sdk_realtime_command(
+        sdk.commands_rx.recv().await,
+        &connection.writer(),
+        handoff,
+        responses,
+        events,
+    )
+    .await
+    .unwrap();
+}
