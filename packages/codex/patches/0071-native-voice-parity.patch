+        tokio::task::yield_now().await;
+        assert!(!queued.is_finished());
+        store.release.notify_one();
+        assert!(matches!(
+            updating.await.unwrap().unwrap_err().details(),
+            codex_protocol::error::CodexErrorDetails::Fatal(_)
+        ));
+        assert!(matches!(queued.await.unwrap(), Err(error)
+            if matches!(error.details(), codex_protocol::error::CodexErrorDetails::TurnAborted)));
+        assert!(!queued_task.await.unwrap());
+        assert!(!ran.load(Ordering::Acquire));
+        assert!(replies_stopped.is_cancelled());
+        assert!(matches!(
+            session.agent_profile_receipt().await,
+            Err(error) if matches!(error.details(), codex_protocol::error::CodexErrorDetails::TurnAborted)
+        ));
+    }
+}
