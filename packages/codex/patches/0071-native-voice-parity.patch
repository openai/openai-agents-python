+    #[tokio::test]
+    async fn scoped_batch_cancel_at_persistence_gate_keeps_root_and_profile() {
+        let (mut session, context) = make_session_and_context().await;
+        attach_thread_persistence(&mut session).await;
+        let receipt = session
+            .activate_agent_profile(None, profile(&context, "a", "scoped-source"))
+            .await
+            .unwrap();
+        let target = profile(&context, "b", "scoped-target");
+        let session = Arc::new(session);
+        let root = session.new_default_turn().await;
+        let entered = Arc::new(Notify::new());
+        assert!(
+            session
+                .start_task(
+                    Arc::clone(&root),
+                    Vec::new(),
+                    HoldProfileRoot(entered.clone())
+                )
+                .await
+        );
+        tokio::time::timeout(std::time::Duration::from_secs(15), entered.notified())
+            .await
+            .unwrap();
+        let (done, root_cancel) = {
+            let active = session.active_turn.lock().await;
+            let task = active.as_ref().unwrap().task.as_ref().unwrap();
+            assert!(Arc::ptr_eq(&task.turn_context, &root));
+            (task.done.clone(), task.cancellation_token.clone())
+        };
+        let batch_cancel = root_cancel.child_token();
+        let gate = super::super::thread_settings::acquire_persistence_lock(&session).await;
+        let activation = session.commit_agent_profile(
+            Some(TaskFence {
+                context: root.clone(),
+                done,
+                cancellation: batch_cancel.clone(),
+            }),
+            root.clone(),
+            root.next_step_settings.load_full(),
+            Some(receipt.clone()),
+            target,
+        );
+        tokio::pin!(activation);
+        // All source authority remains valid; only this batch ends while the
+        // existing publication gate prevents its candidate from being committed.
+        assert!(futures::poll!(&mut activation).is_pending());
+        batch_cancel.cancel();
+        drop(gate);
+        let error = activation.await.unwrap_err();
+        assert!(matches!(
+            error.details(),
+            codex_protocol::error::CodexErrorDetails::TurnAborted
+        ));
+        assert!(!root_cancel.is_cancelled());
+        {
+            let active = session.active_turn.lock().await;
+            let task = active.as_ref().unwrap().task.as_ref().unwrap();
+            assert!(Arc::ptr_eq(&task.turn_context, &root));
+            assert!(!task.cancellation_token.is_cancelled());
+        }
+        assert_eq!(
+            session.agent_profile_receipt().await.unwrap(),
+            Some(receipt.clone())
+        );
+        let saved = session
+            .live_thread()
+            .unwrap()
+            .load_history(true)
+            .await
+            .unwrap();
+        let (_, persisted) = persisted_profile(&saved.items).unwrap().unwrap();
+        assert_eq!(persisted.profile_id, receipt.profile_id);
+        assert_eq!(persisted.epoch, receipt.epoch);
+        session
+            .abort_all_tasks(codex_protocol::protocol::TurnAbortReason::Interrupted)
+            .await;
+    }
