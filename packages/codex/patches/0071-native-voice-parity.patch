+    fn eight_tiny_final_frames_charge_derived_identity_to_shared_queue_bytes() {
+        use super::super::readiness::SessionReadiness;
+        let contract = serde_json::json!({"tools":[{"type":"mcp","server_label":"docs","server_url":"https://example.test"}]});
+        let (observer, _) = SessionReadiness::channel(Some(contract.clone()), true);
+        let observer = observer.unwrap();
+        let mut accepted = contract;
+        accepted["id"] = serde_json::json!("session");
+        observer.observe_frame(
+            &serde_json::json!({"type":"session.updated","session":accepted}).to_string(),
+            true,
+        );
+        assert!(observer.configuration().accepted().is_ok());
+        assert!(!observer.mismatched());
+        let response = "r".repeat(SDK_WIRE_BYTES_CAPACITY / 6);
+        observer.observe_frame(
+            &serde_json::json!({"type":"response.created","response":{"id":response}}).to_string(),
+            true,
+        );
+        let budget = Arc::new(tokio::sync::Semaphore::new(SDK_WIRE_BYTES_CAPACITY));
+        for index in 0..8 {
+            let text=serde_json::json!({"type":"response.output_item.added","response_id":response,"item":{"type":"mcp_approval_request","id":format!("approval-{index}"),"server_label":"docs","name":"search","arguments":""}}).to_string();
+            observer.observe_frame(&text, true);
+            drop(
+                QueuedWireMessage::new(Ok(Message::Text(text.into())), Some(Arc::clone(&budget)))
+                    .unwrap(),
+            );
+        }
+        let mut queued = Vec::new();
+        let mut rejected = false;
+        for index in 0..8 {
+            let text=serde_json::json!({"type":"conversation.item.done","item":{"type":"mcp_approval_request","id":format!("approval-{index}"),"server_label":"docs","name":"search","arguments":"{}"}}).to_string();
+            assert!(text.len() < 512);
+            let observation = observer.observe_frame(&text, true);
+            assert_eq!(
+                observation.hosted_mcp_events.len(),
+                1,
+                "issued native approval before byte admission"
+            );
+            let mut entry =
+                QueuedWireMessage::new(Ok(Message::Text(text.into())), Some(Arc::clone(&budget)))
+                    .unwrap();
+            if entry
+                .charge_hosted_events(observation.hosted_mcp_events, Some(Arc::clone(&budget)))
+                .is_ok()
+            {
+                queued.push(entry);
+            } else {
+                rejected = true;
+            }
+        }
+        assert!(rejected);
+        assert!(!queued.is_empty());
+        // The existing parsed-event queue retains the same permit after raw dequeue.
+        let mut pending = Vec::new();
+        for entry in queued {
+            let permit = entry._permit.map(Arc::new);
+            pending.extend(
+                entry
+                    .hosted_mcp_events
+                    .into_iter()
+                    .map(|event| (event, permit.clone())),
+            );
+        }
+        assert!(budget.available_permits() < SDK_WIRE_BYTES_CAPACITY);
+        pending.clear();
+        assert_eq!(budget.available_permits(), SDK_WIRE_BYTES_CAPACITY);
+    }
