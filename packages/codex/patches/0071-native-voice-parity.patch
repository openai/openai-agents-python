+//! One prepared owner per existing SDK generation. Slow work never occupies the operation reader.
+use super::*;
+use codex_protocol::protocol::{RealtimeConversationApiKey, RealtimeConversationPrepareResult};
+use tracing::Instrument;
+
+type StartReply = tokio::sync::oneshot::Sender<CodexResult<RealtimeConversationStartResult>>;
+
+pub(super) struct SdkToolPreparation {
+    pub(super) completion: SdkRetirement,
+}
+impl std::fmt::Debug for SdkToolPreparation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("SdkToolPreparation")
+    }
+}
+
+pub(super) struct SdkPreparedInput {
+    draft: tool_task::RealtimeSourceDraft,
+    params: ConversationStartParams,
+    settings: Option<RealtimeV2SessionSettings>,
+    function_tools: Option<Vec<codex_protocol::realtime_settings::RealtimeFunctionTool>>,
+    expected_selection_id: Option<String>,
+    hosted_mcp_auto_response: bool,
+    provider: ModelProviderInfo,
+    adapter: Option<Arc<dyn codex_api::RealtimeAdapter>>,
+}
+
+pub(super) struct SdkStartPreparation {
+    pub(super) stop: CancellationToken,
+    input: std::sync::Mutex<Option<SdkPreparedInput>>,
+    worker: std::sync::OnceLock<SdkRetirement>,
+    update_worker: std::sync::Mutex<Option<SdkRetirement>>,
+    reply: std::sync::Mutex<Option<StartReply>>,
+    failure: std::sync::Mutex<Option<CodexErr>>,
+    pub(super) client: std::sync::Mutex<Option<Arc<RealtimeWebsocketClient>>>,
+    pub(super) writer: std::sync::Mutex<Option<RealtimeWebsocketWriter>>,
+    pub(super) adapter_cleanup: std::sync::Mutex<Option<codex_api::RealtimeAdapterCleanup>>,
+    pub(super) call: std::sync::Mutex<Option<Arc<RealtimeCallLease>>>,
+}
+
+impl SdkStartPreparation {
+    fn new() -> Self {
+        Self {
+            stop: CancellationToken::new(),
+            input: Default::default(),
+            worker: Default::default(),
+            update_worker: Default::default(),
+            reply: Default::default(),
+            failure: Default::default(),
+            client: Default::default(),
+            writer: Default::default(),
+            adapter_cleanup: Default::default(),
+            call: Default::default(),
+        }
+    }
+    pub(super) fn retire(&self) {
+        self.stop.cancel();
+        self.input.lock().unwrap().take();
+    }
+    pub(super) async fn join_worker(&self) -> Result<(), String> {
+        if let Some(worker) = self.worker.get() {
+            worker.clone().await?;
+        }
+        let update = self.update_worker.lock().unwrap().clone();
+        if let Some(update) = update {
+            update.await?;
+        }
+        Ok(())
+    }
+    pub(super) fn retry_failed_transport_cleanup(&self) {
+        if let Some(cleanup) = self.adapter_cleanup.lock().unwrap().as_ref() {
+            cleanup.retry_failed_close();
+        }
+    }
+    pub(super) async fn close_transport(&self) -> Result<(), String> {
+        let client = self.client.lock().unwrap().take();
+        if let Some(client) = client {
+            if let Some(writer) = client.take_startup_writer() {
+                if let Some(cleanup) = writer.adapter_cleanup() {
+                    *self.adapter_cleanup.lock().unwrap() = Some(cleanup);
+                }
+                writer.abort_and_join().await;
+            }
+            if let Some(cleanup) = client.adapter_cleanup() {
+                *self.adapter_cleanup.lock().unwrap() = Some(cleanup);
+            }
+        }
+        let writer = self.writer.lock().unwrap().take();
+        if let Some(writer) = writer {
+            if let Some(cleanup) = writer.adapter_cleanup() {
+                *self.adapter_cleanup.lock().unwrap() = Some(cleanup);
+            }
+            writer.abort_and_join().await;
+        }
+        let cleanup = self.adapter_cleanup.lock().unwrap().clone();
+        if let Some(cleanup) = cleanup {
+            cleanup
+                .close()
+                .await
+                .map_err(|_| "Realtime adapter close failed".to_string())?;
+            self.adapter_cleanup.lock().unwrap().take();
+        }
+        Ok(())
+    }
+    pub(super) fn finish_failure(&self, cleanup_failed: bool) {
+        let reply = self.reply.lock().unwrap().take();
+        if let Some(reply) = reply {
+            let error = self
+                .failure
+                .lock()
+                .unwrap()
+                .take()
+                .unwrap_or(CodexErr::TurnAborted);
+            // The independently retained cleanup receipt carries secondary failure.
+            // Keep the original provider/configuration error and its classification.
+            let _ = cleanup_failed;
+            let _ = reply.send(Err(error));
+        }
+    }
+}
+
+impl RealtimeConversationManager {
+    async fn reserve_sdk_start(&self, generation: &str) -> CodexResult<Arc<SdkStartPreparation>> {
+        let mut state = self.state.lock().await;
+        state.ensure_start_available(true)?;
+        if state
+            .sdk_cleanup
+            .as_ref()
+            .is_some_and(|cleanup| cleanup.generation == generation)
+        {
+            return Err(CodexErr::InvalidRequest(
+                "SDK Realtime generation is retired".into(),
+            ));
+        }
+        let preparation = Arc::new(SdkStartPreparation::new());
+        state.sdk_cleanup = Some(SdkCleanup {
+            generation: generation.into(),
+            call: None,
+            preparation: Some(Arc::clone(&preparation)),
+            retirement: None,
+        });
+        Ok(preparation)
+    }
+    pub(super) async fn preparation(&self, generation: &str) -> Option<Arc<SdkStartPreparation>> {
+        self.state
+            .lock()
+            .await
+            .sdk_cleanup
+            .as_ref()
+            .filter(|cleanup| cleanup.generation == generation)
+            .and_then(|cleanup| cleanup.preparation.clone())
+    }
+}
+
+pub(crate) async fn handle_prepare_sdk(
+    sess: &Arc<Session>,
+    generation: String,
+    params: ConversationStartParams,
+    settings: Option<RealtimeV2SessionSettings>,
+    function_tools: Option<Vec<codex_protocol::realtime_settings::RealtimeFunctionTool>>,
+    expected_selection_id: Option<String>,
+    hosted_mcp_auto_response: bool,
+    init: Option<codex_extension_api::ExtensionDataInit>,
+) -> CodexResult<RealtimeConversationPrepareResult> {
+    if generation.is_empty() {
+        return Err(CodexErr::InvalidRequest(
+            "SDK Realtime generation must not be empty".into(),
+        ));
+    }
+    let preparation = sess.conversation.reserve_sdk_start(&generation).await?;
+    let result = async {
+        let adapter = init
+            .as_ref()
+            .and_then(|init| init.get::<Arc<dyn codex_api::RealtimeAdapter>>())
+            .map(|adapter| Arc::clone(adapter.as_ref()));
+        if adapter.is_some()
+            && (!matches!(
+                params.transport.as_ref(),
+                None | Some(ConversationStartTransport::Websocket)
+            ) || params.version != Some(RealtimeWsVersion::V2))
+        {
+            return Err(CodexErr::InvalidRequest(
+                "Custom Realtime adapters require an SDK RealtimeV2 WebSocket connection".into(),
+            ));
+        }
+        let draft = tool_task::capture_realtime_source_draft(sess).await?;
+        draft.validate_selection_identity(
+            function_tools.as_deref(),
+            expected_selection_id.as_deref(),
+        )?;
+        let mut provider = draft.inputs.provider().info().clone();
+        if let Some(projection) = sess
+            .services
+            .thread_extension_data
+            .get::<RealtimeConfigProjection>()
+        {
+            let mut config = draft.inputs.config().as_ref().clone();
+            config.model_provider = provider;
+            provider = (projection.project)(&config).model_provider;
+        }
+        if preparation.stop.is_cancelled() {
+            return Err(CodexErr::TurnAborted);
+        }
+        *preparation.input.lock().unwrap() = Some(SdkPreparedInput {
+            draft,
+            params,
+            settings,
+            function_tools,
+            expected_selection_id,
+            hosted_mcp_auto_response,
+            provider,
+            adapter,
+        });
+        Ok(RealtimeConversationPrepareResult {
+            generation: generation.clone(),
+        })
+    }
+    .await;
+    if result.is_err() {
+        let _ = sess.conversation.shutdown_sdk(&generation).await;
+    }
+    result
+}
+
+pub(crate) async fn handle_activate_sdk(
+    sess: &Arc<Session>,
+    generation: String,
+    api_key: Option<RealtimeConversationApiKey>,
+    reply: StartReply,
+) {
+    let mut reply = Some(reply);
+    let result = async {
+        let api_key = api_key
+            .map(|key| {
+                let key = key.into_inner();
+                if key.trim().is_empty() || HeaderValue::from_str(&format!("Bearer {key}")).is_err()
+                {
+                    return Err(CodexErr::InvalidRequest(
+                        "Realtime API key is not a valid HTTP credential".into(),
+                    ));
+                }
+                Ok(key)
+            })
+            .transpose()?;
+        let mut state = sess.conversation.state.lock().await;
+        let cleanup = state
+            .sdk_cleanup
+            .as_mut()
+            .filter(|cleanup| cleanup.generation == generation && cleanup.retirement.is_none())
+            .ok_or_else(|| {
+                CodexErr::InvalidRequest("SDK Realtime prepared generation is stale".into())
+            })?;
+        let preparation = cleanup.preparation.clone().ok_or_else(|| {
+            CodexErr::InvalidRequest("SDK Realtime generation was not prepared".into())
+        })?;
+        if preparation.stop.is_cancelled() || preparation.worker.get().is_some() {
+            return Err(CodexErr::InvalidRequest(
+                "SDK Realtime prepared generation was already consumed".into(),
+            ));
+        }
+        let input = preparation.input.lock().unwrap().take().ok_or_else(|| {
+            CodexErr::InvalidRequest("SDK Realtime source preparation has not completed".into())
+        })?;
+        *preparation.reply.lock().unwrap() = reply.take();
+        let worker_preparation = Arc::clone(&preparation);
+        let session = Arc::clone(sess);
+        let worker_generation = generation.clone();
+        let task = tokio::spawn(
+            async move {
+                let result = run_prepared_start(
+                    &session,
+                    &worker_generation,
+                    &worker_preparation,
+                    input,
+                    api_key,
+                );
+                let result = std::panic::AssertUnwindSafe(result)
+                    .catch_unwind()
+                    .await
+                    .unwrap_or_else(|_| {
+                        Err(CodexErr::Fatal("Realtime startup worker failed".into()))
+                    });
+                match result {
+                    Ok(result) if !worker_preparation.stop.is_cancelled() => {
+                        if let Some(reply) = worker_preparation.reply.lock().unwrap().take() {
+                            let _ = reply.send(Ok(result));
+                        }
+                    }
+                    result => {
+                        *worker_preparation.failure.lock().unwrap() =
+                            Some(result.err().unwrap_or(CodexErr::TurnAborted));
+                        // Retirement joins this worker. Begin it here; never await our own receipt.
+                        let _ = session
+                            .conversation
+                            .begin_shutdown_sdk(&worker_generation)
+                            .await;
+                    }
+                }
+            }
+            .instrument(tracing::Span::current()),
+        );
+        let worker = async move {
+            task.await
+                .map_err(|_| "Realtime startup worker failed".to_string())
+        }
+        .boxed()
+        .shared();
+        assert!(preparation.worker.set(worker).is_ok());
+        Ok(())
+    }
+    .await;
+    if let Err(error) = result {
+        if let Some(reply) = reply {
+            let _ = reply.send(Err(error));
+        }
+        // Keep an unconsumed preparation available for explicit close/retry. A duplicate
+        // activation must never cancel an already active connection.
+    }
+}
+
+async fn run_prepared_start(
+    sess: &Arc<Session>,
+    generation: &str,
+    preparation: &Arc<SdkStartPreparation>,
+    input: SdkPreparedInput,
+    api_key: Option<String>,
+) -> CodexResult<RealtimeConversationStartResult> {
+    let SdkPreparedInput {
+        draft,
+        mut params,
+        settings,
+        function_tools,
+        expected_selection_id,
+        hosted_mcp_auto_response,
+        provider,
+        adapter,
+    } = input;
+    params.client_managed_handoffs = true;
+    params.backend_reasoning_status = false;
+    let config = Arc::clone(draft.inputs.config());
+    let inherited_call_instructions = if params.prompt.is_none() {
+        let prompt = draft.application_instructions();
+        if matches!(
+            &params.transport,
+            Some(ConversationStartTransport::ExistingCall { .. })
+        ) {
+            // Inherited instructions describe the expected accepted call; they are
+            // not caller-supplied configuration options for an existing call.
+            Some(prepare_realtime_backend_prompt(
+                Some(prompt),
+                config.experimental_realtime_ws_backend_prompt.clone(),
+            ))
+        } else {
+            params.prompt = Some(prompt);
+            None
+        }
+    } else {
+        None
+    };
+    let stage = async {
+        // Credentials are validated/resolved before any native MCP preparation.
+        let mut prepared = prepare_realtime_start_with_source(
+            sess,
+            params,
+            true,
+            Some((config, provider)),
+            api_key,
+        )
+        .await?;
+        if let Some(instructions) = inherited_call_instructions {
+            prepared.session_config.instructions = instructions;
+        }
+        let source = tool_task::finish_realtime_native_source(sess, draft).await?;
+        prepared.session_config.v2 = settings;
+        prepared.hosted_mcp_auto_response = hosted_mcp_auto_response;
+        prepared.session_config.function_tools = tool_task::select_source_tools(
+            &source,
+            function_tools,
+            expected_selection_id.as_deref(),
+        )?;
+        codex_api::session_update_session_json(prepared.session_config.clone())
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+        Ok::<_, CodexErr>((prepared, source))
+    };
+    let (prepared, source) = tokio::select! {biased;_=preparation.stop.cancelled()=>return Err(CodexErr::TurnAborted),result=stage=>result?};
+    handle_start_inner_with_adapter(
+        sess,
+        generation,
+        prepared,
+        Some(generation.to_owned()),
+        Some(source),
+        adapter,
+    )
+    .await
+}
+
+pub(crate) async fn dispatch_start_sdk(
+    sess: &Arc<Session>,
+    generation: String,
+    params: ConversationStartParams,
+    settings: Option<RealtimeV2SessionSettings>,
+    function_tools: Option<Vec<codex_protocol::realtime_settings::RealtimeFunctionTool>>,
+    expected_selection_id: Option<String>,
+    hosted_mcp_auto_response: bool,
+    reply: StartReply,
+) {
+    match handle_prepare_sdk(
+        sess,
+        generation.clone(),
+        params,
+        settings,
+        function_tools,
+        expected_selection_id,
+        hosted_mcp_auto_response,
+        None,
+    )
+    .await
+    {
+        Ok(_) => handle_activate_sdk(sess, generation, None, reply).await,
+        Err(error) => {
+            let _ = reply.send(Err(error));
+        }
+    }
+}
+
+/// Register preparation in the existing provider-call record before returning to the reader.
+async fn dispatch_tools(
+    sess: &Arc<Session>,
+    expected_root_turn_id: Option<String>,
+    generation: String,
+    response_id: Option<String>,
+    call_ids: Vec<String>,
+    submission_id: String,
+    settings: crate::WithTurnExtensionData<codex_protocol::protocol::ThreadSettingsOverrides>,
+    reply: tokio::sync::oneshot::Sender<
+        CodexResult<codex_protocol::turn_input::TurnInputSubmission>,
+    >,
+) {
+    let state = sess.conversation.state.lock().await;
+    let Some(sdk) = state
+        .conversation
+        .as_ref()
+        .and_then(|state| state.handoff.sdk.as_ref())
+        .filter(|sdk| sdk.generation == generation && sdk.active.load(Ordering::Acquire))
+    else {
+        let _ = reply.send(Err(CodexErr::TurnAborted));
+        return;
+    };
+    let mut calls = sdk.function_calls.lock().await;
+    let valid = !call_ids.is_empty()
+        && call_ids.iter().all(|id| {
+            calls.get(id).is_some_and(|call| {
+                !call.claimed
+                    && call
+                        .preparation
+                        .as_ref()
+                        .is_none_or(|job| job.completion.clone().now_or_never().is_some())
+            })
+        });
+    if !valid {
+        let _ = reply.send(Err(CodexErr::InvalidRequest(
+            "Realtime function is unknown or already preparing".into(),
+        )));
+        return;
+    }
+    let session = Arc::clone(sess);
+    let first = call_ids[0].clone();
+    let records = call_ids.clone();
+    let task = tokio::spawn(
+        async move {
+            let result = match response_id {
+                Some(response_id) => {
+                    handle_tools_sdk_with_root(
+                        &session,
+                        expected_root_turn_id,
+                        generation,
+                        response_id,
+                        call_ids,
+                        submission_id,
+                        settings,
+                    )
+                    .await
+                }
+                None => handle_tool_sdk(&session, generation, first, submission_id, settings).await,
+            };
+            let _ = reply.send(result);
+        }
+        .instrument(tracing::Span::current()),
+    );
+    let job = async move {
+        task.await
+            .map_err(|_| "Realtime tool preparation failed".to_string())
+    }
+    .boxed()
+    .shared();
+    let job = Arc::new(SdkToolPreparation { completion: job });
+    for id in records {
+        calls.get_mut(&id).expect("validated call").preparation = Some(Arc::clone(&job));
+    }
+}
+
+pub(crate) async fn dispatch_tool_sdk(
+    sess: &Arc<Session>,
+    generation: String,
+    call_id: String,
+    submission_id: String,
+    settings: crate::WithTurnExtensionData<codex_protocol::protocol::ThreadSettingsOverrides>,
+    reply: tokio::sync::oneshot::Sender<
+        CodexResult<codex_protocol::turn_input::TurnInputSubmission>,
+    >,
+) {
+    dispatch_tools(
+        sess,
+        None,
+        generation,
+        None,
+        vec![call_id],
+        submission_id,
+        settings,
+        reply,
+    )
+    .await;
+}
+pub(crate) async fn dispatch_tools_sdk(
+    sess: &Arc<Session>,
+    expected_root_turn_id: Option<String>,
+    generation: String,
+    response_id: String,
+    call_ids: Vec<String>,
+    submission_id: String,
+    settings: crate::WithTurnExtensionData<codex_protocol::protocol::ThreadSettingsOverrides>,
+    reply: tokio::sync::oneshot::Sender<
+        CodexResult<codex_protocol::turn_input::TurnInputSubmission>,
+    >,
+) {
+    dispatch_tools(
+        sess,
+        expected_root_turn_id,
+        generation,
+        Some(response_id),
+        call_ids,
+        submission_id,
+        settings,
+        reply,
+    )
+    .await;
+}
