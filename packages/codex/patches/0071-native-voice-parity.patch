+        let budget = Arc::new(tokio::sync::Semaphore::new(SDK_WIRE_BYTES_CAPACITY));
+        let make = || {
+            QueuedWireMessage::new(
+                Ok(Message::Text(text.clone().into())),
+                Some(Arc::clone(&budget)),
+            )
+        };
+        let first = make().unwrap();
+        let second = make().unwrap();
+        assert!(make().is_err());
+        drop(first);
+        let replacement = make().unwrap();
+        drop((second, replacement));
+        assert_eq!(budget.available_permits(), SDK_WIRE_BYTES_CAPACITY);
+    }
