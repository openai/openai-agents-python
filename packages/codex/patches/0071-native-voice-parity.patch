+pub(crate) async fn attach_realtime_tool_if_owned(
+    session: &Arc<Session>,
+    expected_root: &str,
+    task: crate::realtime_conversation::RealtimeToolTask,
+) -> CodexResult<TurnInputSubmission> {
+    let active = session.active_turn.lock().await;
+    if session.services.local_agent_runtime.shutdown.is_cancelled() {
+        return Ok(TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::Superseded,
+        });
+    }
+    let Some(running) = active
+        .as_ref()
+        .and_then(|turn| turn.task.as_ref())
+        .filter(|running| {
+            running.turn_context.sub_id == expected_root
+                && !running.cancellation_token.is_cancelled()
+        })
+    else {
+        return Ok(TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::Superseded,
+        });
+    };
+    let Some(dispatch) = running.task.realtime_tools() else {
+        return Ok(TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::Superseded,
+        });
+    };
+    if !dispatch.accepts_generation(&task) {
+        return Ok(TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::Superseded,
+        });
+    }
+    if !dispatch.try_attach(task) {
+        return Ok(TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::NotIdle,
+        });
+    }
+    Ok(TurnInputSubmission::Steered {
+        turn_id: expected_root.to_owned(),
+    })
+}
