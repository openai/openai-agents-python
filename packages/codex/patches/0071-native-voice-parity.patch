+//! Connection-owned accepted configuration and its single pending revision.
+use crate::ApiError;
+use codex_protocol::agent_profile::AgentProfileReceipt;
+use codex_protocol::protocol::{RealtimeAudioFrame, RealtimeOutputGuard};
+use codex_protocol::realtime_settings::RealtimeAudioFormat;
+use codex_protocol::realtime_settings::RealtimeSessionUpdate;
+use serde_json::Value;
+use std::collections::VecDeque;
+use std::sync::Arc;
+use std::sync::Mutex;
+use tokio::sync::watch;
+
+#[derive(Clone, Debug)]
+pub(super) enum ReadyState {
+    Pending,
+    Ready,
+    Mismatch,
+    ProviderError,
+    Rejected,
+    Unsupported,
+    Closed,
+}
+
+/// One immutable native source; provider JSON cannot construct this attachment.
+pub trait RealtimeNativeSource: Send + Sync {
+    fn profile_receipt(&self) -> Option<&AgentProfileReceipt>;
+    fn as_any(&self) -> &dyn std::any::Any;
+}
+
+pub struct RealtimeAcceptedConfiguration {
+    pub(super) hosted_owned: bool,
+    pub native_source: Option<Arc<dyn RealtimeNativeSource>>,
+    pub input_format: Option<RealtimeAudioFormat>,
+    pub output_format: Option<RealtimeAudioFormat>,
+    contract: Value,
+}
+
+impl RealtimeAcceptedConfiguration {
+    pub fn interrupts_on_speech_started(&self) -> bool {
+        match self.contract.pointer("/audio/input/turn_detection") {
+            Some(Value::Null) => false,
+            Some(detection) => {
+                detection.get("interrupt_response").and_then(Value::as_bool) != Some(false)
+            }
+            None => true,
+        }
+    }
+
+    pub(super) fn hosted_declaration(&self, label: &str) -> Option<&Value> {
+        self.contract
+            .get("tools")?
+            .as_array()?
+            .iter()
+            .find(|tool| tool["type"] == "mcp" && tool["server_label"].as_str() == Some(label))
+    }
+    pub fn hosted_mcp_authority_ready(&self) -> bool {
+        self.hosted_owned
+    }
+
+    pub fn hosted_mcp_tools(
+        &self,
+    ) -> Vec<codex_protocol::realtime_settings::RealtimeHostedMcpTool> {
+        self.contract
+            .get("tools")
+            .and_then(Value::as_array)
+            .into_iter()
+            .flatten()
+            .filter(|tool| tool["type"].as_str() == Some("mcp"))
+            .filter_map(|tool| {
+                let mut tool = tool.clone();
+                tool.as_object_mut()?.remove("type");
+                serde_json::from_value(tool).ok()
+            })
+            .collect()
+    }
+    pub fn function_tools(&self) -> Vec<codex_protocol::realtime_settings::RealtimeFunctionTool> {
+        self.contract
+            .get("tools")
+            .and_then(Value::as_array)
+            .into_iter()
+            .flatten()
+            .filter_map(|tool| {
+                let name = tool.get("name")?.as_str()?;
+                if matches!(name, "background_agent" | "remain_silent") {
+                    return None;
+                }
+                Some(codex_protocol::realtime_settings::RealtimeFunctionTool {
+                    name: name.to_owned(),
+                    description: tool
+                        .get("description")
+                        .and_then(Value::as_str)
+                        .map(str::to_owned),
+                    parameters: tool.get("parameters")?.clone(),
+                    strict: tool.get("strict").and_then(Value::as_bool),
+                })
+            })
+            .collect()
+    }
+    pub fn profile_receipt(&self) -> Option<&AgentProfileReceipt> {
+        self.native_source
+            .as_ref()
+            .and_then(|source| source.profile_receipt())
+    }
+}
+
+impl std::fmt::Debug for RealtimeAcceptedConfiguration {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("RealtimeAcceptedConfiguration")
+            .field("input_format", &self.input_format)
+            .field("output_format", &self.output_format)
+            .finish_non_exhaustive()
+    }
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum PendingPhase {
+    InitialUpdate,
+    InitialAttach,
+    Reserved,
+    Armed,
+}
+#[derive(Clone)]
+enum ReceiptState {
+    Pending,
+    Accepted(Arc<RealtimeAcceptedConfiguration>),
+    Failed(ReadyState),
+}
+struct PendingConfiguration {
+    hosted_owned: bool,
+    native_source: Option<Arc<dyn RealtimeNativeSource>>,
+    id: Option<String>,
+    contract: Value,
+    phase: PendingPhase,
+    completion: Option<watch::Sender<ReceiptState>>,
+}
+
+/// Retains the outcome of this exact revision independently of later updates.
+#[derive(Clone)]
+pub struct RealtimeConfigurationReceipt {
+    result: watch::Receiver<ReceiptState>,
+}
+impl RealtimeConfigurationReceipt {
+    pub async fn wait(mut self) -> Result<Arc<RealtimeAcceptedConfiguration>, ApiError> {
+        loop {
+            match self.result.borrow_and_update().clone() {
+                ReceiptState::Pending => {}
+                ReceiptState::Accepted(snapshot) => return Ok(snapshot),
+                ReceiptState::Failed(state) => {
+                    return Err(invalid(match state {
+                        ReadyState::Rejected => {
+                            "Provider rejected this Realtime configuration revision"
+                        }
+                        ReadyState::Closed => "Realtime configuration revision was retired",
+                        _ => "Realtime configuration revision was not accepted",
+                    }));
+                }
+            }
+            self.result
+                .changed()
+                .await
+                .map_err(|_| invalid("Realtime configuration revision was retired"))?;
+        }
+    }
+}
+pub(super) struct ActiveResponse {
+    pub(super) id: Arc<str>,
+    pub(super) configuration: Arc<RealtimeAcceptedConfiguration>,
+    // Runtime-only lineage: automatic replies inherit, explicit user work replaces.
+    request_owner: Arc<()>,
+    pub(super) output_guard: RealtimeOutputGuard,
+}
+
+pub(super) struct FrameObservation {
+    pub hosted_mcp_events: Vec<codex_protocol::protocol::RealtimeEvent>,
+    pub configuration: Option<Arc<RealtimeAcceptedConfiguration>>,
+    pub output_guard: RealtimeOutputGuard,
+}
+impl Default for FrameObservation {
+    fn default() -> Self {
+        Self {
+            hosted_mcp_events: Vec::new(),
+            configuration: None,
+            output_guard: RealtimeOutputGuard::default(),
+        }
+    }
+}
+impl FrameObservation {
+    fn response(response: &ActiveResponse) -> Self {
+        Self {
+            hosted_mcp_events: Vec::new(),
+            configuration: Some(Arc::clone(&response.configuration)),
+            output_guard: response.output_guard.clone(),
+        }
+    }
+    fn suppressed() -> Self {
+        let observation = Self::default();
+        observation.output_guard.retire();
+        observation
+    }
+}
+struct ReceivedAudio {
+    response_id: Arc<str>,
+    item_id: String,
+    content_index: u32,
+    output_index: u32,
+    samples: u64,
+    truncated: bool,
+    configuration: Arc<RealtimeAcceptedConfiguration>,
+}
+
+#[derive(Debug)]
+pub struct RealtimeInterruptResult {
+    pub cancelled_response_id: Option<String>,
+    pub retired_response_ids: Vec<String>,
+    pub feedback_accepted: bool,
+    pub active_response_id: Option<String>,
+}
+
+pub(super) struct InterruptActions {
+    pub payloads: Vec<Value>,
+    pub result: RealtimeInterruptResult,
+}
+
+struct AudioInputSource {
+    prior_owner: Arc<()>,
+    owner: Arc<()>,
+}
+
+struct ConfigurationState {
+    hosted_mcp: super::hosted_mcp::HostedMcpState,
+    accepted: Option<Arc<RealtimeAcceptedConfiguration>>,
+    pending: Option<PendingConfiguration>,
+    active_response: Option<Arc<ActiveResponse>>,
+    response_contexts: VecDeque<Arc<ActiveResponse>>,
+    output_owner: RealtimeOutputGuard,
+    pending_create_guard: Option<RealtimeOutputGuard>,
+    request_owner: Arc<()>,
+    pending_create_owner: Option<Arc<()>>,
+    latest_response_id: Option<Arc<str>>,
+    cancelled_response_id: Option<Arc<str>>,
+    feedback_response_id: Option<Arc<str>>,
+    response_create_pending: bool,
+    received_audio: VecDeque<ReceivedAudio>,
+    audio_input_sources: VecDeque<(String, AudioInputSource)>,
+    failure: Option<ReadyState>,
+}
+struct ConfigurationInner {
+    state: Mutex<ConfigurationState>,
+    signal: watch::Sender<ReadyState>,
+}
+
+/// A reference to the connection's authoritative configuration owner.
+#[derive(Clone)]
+pub struct RealtimeConfiguration {
+    inner: Arc<ConfigurationInner>,
+}
+impl std::fmt::Debug for RealtimeConfiguration {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("RealtimeConfiguration { .. }")
+    }
+}
+
+/// One reserved update. Dropping before the pump arms it releases admission.
+pub struct RealtimeConfigurationReservation {
+    configuration: RealtimeConfiguration,
+    id: String,
+    payload: Value,
+    receipt: RealtimeConfigurationReceipt,
+}
+impl std::fmt::Debug for RealtimeConfigurationReservation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("RealtimeConfigurationReservation { .. }")
+    }
+}
+impl Drop for RealtimeConfigurationReservation {
+    fn drop(&mut self) {
+        let mut state = self.configuration.inner.state.lock().unwrap();
+        if state.pending.as_ref().is_some_and(|pending| {
+            pending.id.as_deref() == Some(&self.id) && pending.phase == PendingPhase::Reserved
+        }) {
+            if let Some(completion) = state.pending.take().and_then(|pending| pending.completion) {
+                completion.send_replace(ReceiptState::Failed(ReadyState::Closed));
+            }
+            self.configuration
+                .inner
+                .signal
+                .send_replace(ReadyState::Ready);
+        }
+    }
+}
+
+fn invalid(message: &str) -> ApiError {
+    ApiError::InvalidRequest {
+        message: message.into(),
+    }
+}
+
+impl RealtimeConfiguration {
+    fn settled(state: &ConfigurationState) -> Result<Arc<RealtimeAcceptedConfiguration>, ApiError> {
+        if state.failure.is_some() {
+            return Err(invalid("Realtime configuration is retired"));
+        }
+        if state.pending.is_some() {
+            return Err(invalid("Realtime configuration acceptance is pending"));
+        }
+        state
+            .accepted
+            .clone()
+            .ok_or_else(|| invalid("Realtime configuration has not been accepted"))
+    }
+
+    pub fn response_output_guard(&self, response_id: &str) -> Option<RealtimeOutputGuard> {
+        self.inner
+            .state
+            .lock()
+            .unwrap()
+            .response_contexts
+            .iter()
+            .find(|response| response.id.as_ref() == response_id)
+            .map(|response| response.output_guard.clone())
+    }
+
+    pub fn accepted(&self) -> Result<Arc<RealtimeAcceptedConfiguration>, ApiError> {
+        Self::settled(&self.inner.state.lock().unwrap())
+    }
+
+    pub fn reserve_update(
+        &self,
+        update: &RealtimeSessionUpdate,
+    ) -> Result<RealtimeConfigurationReservation, ApiError> {
+        self.reserve_revision(update, None)
+    }
+
+    pub fn reserve_update_with_source(
+        &self,
+        update: &RealtimeSessionUpdate,
+        source: Arc<dyn RealtimeNativeSource>,
+    ) -> Result<RealtimeConfigurationReservation, ApiError> {
+        self.reserve_revision(update, Some(source))
+    }
+
+    fn reserve_revision(
+        &self,
+        update: &RealtimeSessionUpdate,
+        source: Option<Arc<dyn RealtimeNativeSource>>,
+    ) -> Result<RealtimeConfigurationReservation, ApiError> {
+        let mut payload = super::settings::realtime_v2_session_update_json(update)
+            .map_err(|error| invalid(&error.to_string()))?;
+        let mut state = self.inner.state.lock().unwrap();
+        let accepted = Self::settled(&state)?;
+        if update.function_tools.is_some() || update.settings.hosted_mcp_tools.is_some() {
+            let functions = update
+                .function_tools
+                .clone()
+                .unwrap_or_else(|| accepted.function_tools());
+            let hosted = update
+                .settings
+                .hosted_mcp_tools
+                .clone()
+                .unwrap_or_else(|| accepted.hosted_mcp_tools());
+            payload["session"]["tools"] = super::settings::tools_json(&functions, &hosted)
+                .map_err(|error| invalid(&error.to_string()))?;
+        }
+        let mut contract = accepted.contract.clone();
+        apply_contract_update(&mut contract, &payload["session"]);
+        super::settings::validate_tool_choice(&contract)
+            .map_err(|error| invalid(&error.to_string()))?;
+        let id = uuid::Uuid::now_v7().to_string();
+        payload["event_id"] = Value::String(id.clone());
+        let (completion, result) = watch::channel(ReceiptState::Pending);
+        state.pending = Some(PendingConfiguration {
+            hosted_owned: accepted.hosted_owned || update.settings.hosted_mcp_tools.is_some(),
+            native_source: source.or_else(|| accepted.native_source.clone()),
+            id: Some(id.clone()),
+            contract,
+            phase: PendingPhase::Reserved,
+            completion: Some(completion),
+        });
+        self.inner.signal.send_replace(ReadyState::Pending);
+        Ok(RealtimeConfigurationReservation {
+            configuration: self.clone(),
+            id,
+            payload,
+            receipt: RealtimeConfigurationReceipt { result },
+        })
+    }
+
+    /// Validate caller media before queue admission. No codec conversion is implied.
+    pub fn validate_audio(&self, frame: &RealtimeAudioFrame) -> Result<(), ApiError> {
+        use base64::Engine;
+        let accepted = {
+            let state = self.inner.state.lock().unwrap();
+            if state.failure.is_some() {
+                return Err(invalid("Realtime configuration is retired"));
+            }
+            // Pending instructions/tools cannot promote new execution authority,
+            // but they do not invalidate media already accepted by this socket.
+            if let Some(pending) = &state.pending {
+                let media_unchanged = state.accepted.as_ref().is_some_and(|accepted| {
+                    ["model", "audio", "output_modalities"]
+                        .into_iter()
+                        .all(|field| accepted.contract.get(field) == pending.contract.get(field))
+                });
+                if !media_unchanged {
+                    return Err(invalid("Realtime configuration acceptance is pending"));
+                }
+            }
+            state
+                .accepted
+                .clone()
+                .ok_or_else(|| invalid("Realtime configuration has not been accepted"))?
+        };
+        let format = frame.format.unwrap_or(RealtimeAudioFormat::Pcm24k);
+        if accepted.input_format != Some(format)
+            || frame.sample_rate != format.sample_rate()
+            || frame.num_channels != 1
+        {
+            return Err(invalid(
+                "Audio frame does not match the accepted input format",
+            ));
+        }
+        let bytes = base64::engine::general_purpose::STANDARD
+            .decode(&frame.data)
+            .map_err(|_| invalid("Audio frame must contain valid base64"))?;
+        if format == RealtimeAudioFormat::Pcm24k && bytes.len() % 2 != 0 {
+            return Err(invalid("PCM audio requires complete two-byte samples"));
+        }
+        Ok(())
+    }
+
+    pub(super) fn same_connection(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.inner, &other.inner)
+    }
+    pub(super) fn retire(&self) {
+        let mut state = self.inner.state.lock().unwrap();
+        if state.failure.is_none() {
+            state.failure = Some(ReadyState::Closed);
+        }
+        if let Some(completion) = state.pending.take().and_then(|pending| pending.completion) {
+            completion.send_replace(ReceiptState::Failed(state.failure.clone().unwrap()));
+        }
+        state.output_owner.retire_owner();
+        state.active_response = None;
+        state.response_contexts.clear();
+        state.hosted_mcp = Default::default();
+        state.received_audio.clear();
+        state.audio_input_sources.clear();
+        self.inner
+            .signal
+            .send_replace(state.failure.clone().unwrap());
+    }
+}
+
+impl RealtimeConfiguration {
+    fn validate_playback_in(
+        state: &ConfigurationState,
+        position: &codex_protocol::protocol::RealtimePlaybackPosition,
+    ) -> Result<(), ApiError> {
+        if state.failure.is_some() {
+            return Err(invalid("Realtime configuration is retired"));
+        }
+        let record = state
+            .received_audio
+            .iter()
+            .find(|record| {
+                record.response_id.as_ref() == position.response_id
+                    && record.item_id == position.item_id
+                    && record.content_index == position.content_index
+            })
+            .ok_or_else(|| {
+                invalid("Playback item is unknown or outside the retained media window")
+            })?;
+        let rate = record
+            .configuration
+            .output_format
+            .ok_or_else(|| invalid("Playback format is unknown"))?
+            .sample_rate();
+        if u128::from(position.audio_end_ms) * u128::from(rate) > u128::from(record.samples) * 1000
+        {
+            return Err(invalid("Played position exceeds received audio duration"));
+        }
+        Ok(())
+    }
+
+    pub fn validate_playback(
+        &self,
+        position: &codex_protocol::protocol::RealtimePlaybackPosition,
+    ) -> Result<(), ApiError> {
+        Self::validate_playback_in(&self.inner.state.lock().unwrap(), position)
+    }
+
+    pub(super) fn response_create_for(&self, response_id: &str) -> bool {
+        let mut state = self.inner.state.lock().unwrap();
+        let request_owner = state
+            .response_contexts
+            .iter()
+            .find(|response| response.id.as_ref() == response_id)
+            .map(|response| Arc::clone(&response.request_owner));
+        if state.failure.is_none()
+            && request_owner
+                .as_ref()
+                .is_some_and(|owner| Arc::ptr_eq(owner, &state.request_owner))
+            && state.latest_response_id.as_deref() == Some(response_id)
+            && state.active_response.is_none()
+            && !state.response_create_pending
+        {
+            state.response_create_pending = true;
+            state.pending_create_owner = request_owner;
+            state.pending_create_guard = Some(state.output_owner.new_response());
+            true
+        } else {
+            false
+        }
+    }
+
+    pub fn response_tools_pending(&self, response_id: &str) -> bool {
+        self.inner
+            .state
+            .lock()
+            .unwrap()
+            .hosted_mcp
+            .pending_for(response_id)
+    }
+    pub fn response_has_hosted_mcp(&self, response_id: &str) -> bool {
+        self.inner
+            .state
+            .lock()
+            .unwrap()
+            .hosted_mcp
+            .has_hosted(response_id)
+    }
+    pub fn tool_response_id(&self, call_id: &str) -> Option<String> {
+        self.inner
+            .state
+            .lock()
+            .unwrap()
+            .hosted_mcp
+            .tool_response_id(call_id)
+    }
+    pub fn hosted_mcp_pending(&self, response_id: &str) -> bool {
+        self.response_tools_pending(response_id)
+    }
+    pub(super) fn function_output_sent(&self, call_id: &str) {
+        self.inner
+            .state
+            .lock()
+            .unwrap()
