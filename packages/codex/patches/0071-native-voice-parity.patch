+// Validate only after tool domains have been merged and source-admitted.
+// Choosing a function cannot add a declaration or change its native owner.
+pub(super) fn validate_tool_choice(session: &Value) -> serde_json::Result<()> {
+    let Some(choice) = session
+        .get("tool_choice")
+        .filter(|choice| choice.is_object())
+    else {
+        return Ok(());
+    };
+    let name = choice.get("name").and_then(Value::as_str);
+    let admitted = session
+        .get("tools")
+        .and_then(Value::as_array)
+        .is_some_and(|tools| {
+            tools.iter().any(|tool| {
+                tool.get("type").and_then(Value::as_str) == Some("function")
+                    && tool.get("name").and_then(Value::as_str) == name
+                    && name.is_some()
+            })
+        });
+    if !admitted {
+        return Err(serde::ser::Error::custom(
+            "Realtime tool choice is outside the advertised function subset",
+        ));
+    }
+    Ok(())
+}
+
+pub(super) fn function_tools_json(functions: &[RealtimeFunctionTool]) -> serde_json::Result<Value> {
+    if functions.len() > 128 || serde_json::to_vec(functions)?.len() > 1024 * 1024 {
+        return Err(serde::ser::Error::custom(
+            "SDK Realtime function subset exceeds capacity",
