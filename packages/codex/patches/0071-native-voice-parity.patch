+#[derive(Debug)]
+struct RealtimeToolContext(&'static str);
+
+struct RealtimeToolPolicy {
+    declaration: codex_tools::ResponsesApiTool,
+    connection: std::sync::Mutex<
+        Option<(
+            codex_api::RealtimeWebsocketConnection,
+            tokio::sync::mpsc::UnboundedReceiver<serde_json::Value>,
+            tokio::task::JoinHandle<()>,
+        )>,
+    >,
+    owner: Arc<RealtimeToolContext>,
+    entered: tokio::sync::Notify,
+    admissions: std::sync::atomic::AtomicUsize,
+    decision: tokio::sync::Notify,
+    reject: bool,
+    retarget: bool,
+    pause_finish: std::sync::atomic::AtomicBool,
+    pause_cancel: std::sync::atomic::AtomicBool,
+    cancel_entered: tokio::sync::Notify,
+    cancel_release: tokio::sync::Notify,
+    finish_entered: tokio::sync::Notify,
+    finish_release: tokio::sync::Notify,
+}
+
+impl std::fmt::Debug for RealtimeToolPolicy {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("RealtimeToolPolicy").finish_non_exhaustive()
+    }
+}
+
+impl codex_extension_api::ToolContributor for RealtimeToolPolicy {
+    fn tools(
+        &self,
+        _: &codex_extension_api::ExtensionData,
+        _: &codex_extension_api::ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> codex_tools::ToolExecutor<codex_tools::ToolCall<'call>>>> {
+        Vec::new()
+    }
+    fn capture_realtime_tools(
+        &self,
+        input: codex_extension_api::RealtimeToolCaptureInput<'_>,
+    ) -> Result<Option<codex_extension_api::RealtimeToolDeclarations>, String> {
+        Ok(Some(codex_extension_api::RealtimeToolDeclarations {
+            selection_id: codex_extension_api::realtime_tool_selection_id(
+                input.thread_store.level_id(),
+                1,
+                input.profile.map(|profile| &profile.receipt),
+            ),
+            tools: vec![codex_extension_api::RealtimeToolDeclaration {
+                native_name: codex_tools::ToolName::plain(self.declaration.name.clone()),
+                spec: codex_extension_api::PreparedToolPresentation {
+                    namespace: None,
+                    name: self.declaration.name.clone(),
+                    kind: "function".into(),
+                    strict: self.declaration.strict,
+                    defer_loading: None,
+                    description: self.declaration.description.clone(),
+                    parameters: serde_json::to_value(&self.declaration.parameters).unwrap(),
+                },
+            }],
+            application_instructions: None,
+            execution_data: Default::default(),
+        }))
+    }
+}
+
+impl codex_extension_api::ToolLifecycleContributor for RealtimeToolPolicy {
+    fn on_tool_finish<'a>(
+        &'a self,
+        _input: codex_extension_api::ToolFinishInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            if self
+                .pause_finish
+                .swap(false, std::sync::atomic::Ordering::AcqRel)
+            {
+                self.finish_entered.notify_one();
+                self.finish_release.notified().await;
+            }
+        })
+    }
+}
+
+impl codex_extension_api::ModelRequestContributor for RealtimeToolPolicy {
+    fn request(
+        &self,
+        _: codex_extension_api::ModelRequestInput<'_>,
+    ) -> Option<Box<dyn codex_extension_api::ModelResponseInterceptor>> {
+        panic!("tools-only work must not issue a model request");
+    }
+
+    fn admit_tools_only_call(
+        &self,
+        input: codex_extension_api::ToolsOnlyCallInput,
+    ) -> futures::future::BoxFuture<'_, Result<codex_protocol::models::ResponseItem, String>> {
+        Box::pin(async move {
+            let owner = input
+                .admission
+                .turn_store()
+                .get::<Arc<RealtimeToolContext>>()
+                .expect("captured tool context");
+            assert!(Arc::ptr_eq(owner.as_ref(), &self.owner));
+            assert_eq!(owner.0, "original owner");
+            assert!(input.admission.admits(&input.item));
+            assert!(!input.model.is_empty());
+            self.admissions
+                .fetch_add(1, std::sync::atomic::Ordering::AcqRel);
+            self.entered.notify_one();
+            tokio::select! {
+                biased;
+                _ = input.cancellation.cancelled() => {
+                    self.cancel_entered.notify_one();
+                    if self.pause_cancel.load(std::sync::atomic::Ordering::Acquire) {
+                        self.cancel_release.notified().await;
+                    }
+                    return Err("cancelled policy callback joined".into());
+                }
+                _ = self.decision.notified() => {}
+            }
+            if self.reject {
+                return Err("approval rejected".into());
+            }
+            let mut item = input.item;
+            if let codex_protocol::models::ResponseItem::FunctionCall {
+                arguments,
+                name,
+                id,
+                ..
+            } = &mut item
+            {
+                *arguments = r#"{"x":2}"#.into();
+                *id = None;
+                if self.retarget {
+                    *name = "unadvertised".into();
+                }
+            }
+            Ok(item)
+        })
+    }
+}
