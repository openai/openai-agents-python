+async fn sdk_delegation_receipt_wire(retire_before_ack: bool) {
+    use super::{SdkProfileUpdate, SdkRealtimeCommand, SdkUpdateReply};
+    use codex_protocol::realtime_settings::{RealtimeSessionUpdate, RealtimeToolProfileUpdate};
+    let (session, _, _events, policy, _http, _) = realtime_tool_fixture(false, false).await;
+    let (old, _old_wire, old_server) = policy.connection.lock().unwrap().take().unwrap();
+    old.close().await.unwrap();
+    old_server.await.unwrap();
+    let source_a = super::tool_task::capture_realtime_native_source(&session)
+        .await
+        .unwrap();
+    let source_b = super::tool_task::capture_realtime_native_source(&session)
+        .await
+        .unwrap();
+    assert!(!Arc::ptr_eq(&source_a, &source_b));
+    let (connection, mut wire, server, control) =
+        sdk_wire_connection_controlled(Some(source_a), Vec::new(), "delegation-source-response")
+            .await;
+    wire.recv().await.unwrap();
+    let writer = connection.writer();
+    writer.send_response_create().await.unwrap();
+    assert_eq!(wire.recv().await.unwrap()["type"], "response.create");
+    while !matches!(
+        connection.next_event().await.unwrap(),
+        Some(codex_api::RealtimeEvent::ResponseCreated(_))
+    ) {}
+    let provider_call = serde_json::json!({"type":"function_call","id":"delegated-item","call_id":"delegated-result","name":"background_agent","arguments":"{\"prompt\":\"native task\"}","status":"completed"});
+    control.send(SdkWireControl::Event(serde_json::json!({"type":"response.output_item.done","response_id":"delegation-source-response","output_index":0,"item":provider_call}))).unwrap();
+    control.send(SdkWireControl::Event(serde_json::json!({"type":"response.done","response":{"id":"delegation-source-response","status":"completed","output":[provider_call]}}))).unwrap();
+    while !matches!(
+        connection.next_event().await.unwrap(),
+        Some(codex_api::RealtimeEvent::ResponseDone(_))
+    ) {}
+    let handoff = session
+        .conversation
+        .state
+        .lock()
+        .await
+        .conversation
+        .as_ref()
+        .unwrap()
+        .handoff
+        .clone();
+    let sdk = handoff.sdk.as_ref().unwrap();
+    *sdk.configuration.lock().unwrap() = writer.configuration();
+    sdk.register_for_response("delegated-result", Some("delegation-source-response"))
+        .await
+        .unwrap();
+    let (ack, observed) = tokio::sync::oneshot::channel();
+    control
+        .send(SdkWireControl::AutoAcknowledge(false, ack))
+        .unwrap();
+    observed.await.unwrap();
+    let (reply, completed) = tokio::sync::oneshot::channel();
+    session
+        .conversation
+        .sdk_enqueue(
+            "tools-generation",
+            SdkRealtimeCommand::OwnedUpdate {
+                update: RealtimeSessionUpdate::default(),
+                profile: Some(SdkProfileUpdate {
+                    request: RealtimeToolProfileUpdate {
+                        response_id: None,
+                        delegation_id: Some("delegated-result".into()),
+                        target: None,
+                        function_tools: None,
+                        expected_selection_id: None,
+                    },
+                    source: Arc::clone(&source_b),
+                }),
+                reply: SdkUpdateReply(Some(reply)),
+            },
+        )
+        .await
+        .unwrap();
+    let command = sdk.commands_rx.recv().await;
+    let task_writer = writer.clone();
+    let task_handoff = handoff.clone();
+    let update = tokio::spawn(async move {
+        let (tx, _rx) = bounded(64);
+        let mut responses = super::RealtimeResponseCreateQueue::default();
+        super::handle_sdk_realtime_command(
+            command,
+            &task_writer,
+            &task_handoff,
+            &mut responses,
+            &tx,
+        )
+        .await
+        .unwrap();
+        responses
+    });
+    assert_eq!(
+        tokio::time::timeout(std::time::Duration::from_secs(2), wire.recv())
+            .await
+            .unwrap()
+            .unwrap()["type"],
+        "session.update"
+    );
+    assert!(!update.is_finished());
+    assert!(
+        sdk.seen.lock().await["delegated-result"]
+            .accepted_configuration
+            .is_none()
+    );
+    assert!(wire.try_recv().is_err());
+    if retire_before_ack {
+        // Keep this already-dispatched handler future alive deliberately: even an ACK
+        // arriving at its last poll after real manager retirement cannot restore admission.
+        let (retirement, _) = session
+            .conversation
+            .begin_shutdown_sdk("tools-generation")
+            .await
+            .unwrap()
+            .unwrap();
+        tokio::time::timeout(
+            std::time::Duration::from_secs(2),
+            session.conversation.join_sdk_retirement(retirement),
+        )
+        .await
+        .unwrap()
+        .unwrap();
+    }
+    let (ack, observed) = tokio::sync::oneshot::channel();
+    control
+        .send(SdkWireControl::ResponseId("delegation-followup", ack))
+        .unwrap();
+    observed.await.unwrap();
+    control.send(SdkWireControl::Acknowledge).unwrap();
+    let mut responses = tokio::time::timeout(std::time::Duration::from_secs(2), update)
+        .await
+        .unwrap()
+        .unwrap();
+    completed.await.unwrap().unwrap();
+    if retire_before_ack {
+        assert!(!sdk.active.load(std::sync::atomic::Ordering::Acquire));
+        assert!(
+            sdk.seen.lock().await["delegated-result"]
+                .accepted_configuration
+                .is_none()
+        );
+        assert!(
+            session
+                .conversation
+                .sdk_enqueue(
+                    "tools-generation",
+                    SdkRealtimeCommand::Complete {
+                        handoff_id: "delegated-result".into(),
+                        text: "Retired native final text".into(),
+                    }
+                )
+                .await
+                .is_err()
+        );
+        assert!(wire.try_recv().is_err());
+        connection.close().await.unwrap();
+        server.await.unwrap();
+        return;
+    }
+    let receipt = sdk.seen.lock().await["delegated-result"]
+        .accepted_configuration
+        .clone()
+        .unwrap();
+    assert!(Arc::ptr_eq(
+        receipt.native_source.as_ref().unwrap(),
+        &source_b
+    ));
+    assert!(wire.try_recv().is_err());
+    session
+        .conversation
+        .sdk_enqueue(
+            "tools-generation",
+            SdkRealtimeCommand::Complete {
+                handoff_id: "delegated-result".into(),
+                text: "Accepted native final text".into(),
+            },
+        )
+        .await
+        .unwrap();
+    let (tx, _rx) = bounded(64);
+    super::handle_sdk_realtime_command(
+        sdk.commands_rx.recv().await,
+        &writer,
+        &handoff,
+        &mut responses,
+        &tx,
+    )
+    .await
+    .unwrap();
+    let output = wire.recv().await.unwrap();
+    assert_eq!(output["item"]["call_id"], "delegated-result");
+    assert_eq!(output["item"]["output"], "Accepted native final text");
+    assert_eq!(wire.recv().await.unwrap()["type"], "response.create");
+    assert!(!sdk.pending.lock().await.contains_key("delegated-result"));
+    assert!(
+        sdk.seen.lock().await["delegated-result"]
+            .accepted_configuration
+            .is_none()
+    );
+    connection.close().await.unwrap();
+    server.await.unwrap();
+}
