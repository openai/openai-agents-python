+                biased;
+                _ = stop_token.cancelled() => return Err(RealtimeInputTaskExit::Terminal),
+                result = handle_user_audio_input(Ok(frame), writer) => {
+                    result.map_err(classify_realtime_input_error)?;
+                }
+            }
+        }
+    }
+    let handling =
+        handle_sdk_realtime_command(command, writer, handoff_state, responses, events_tx);
+    tokio::pin!(handling);
+    loop {
+        tokio::select! {
+            biased;
+            _ = stop_token.cancelled() => return Err(RealtimeInputTaskExit::Terminal),
+            result = &mut handling => return result.map_err(classify_realtime_input_error),
+            frame = audio_rx.recv() => {
