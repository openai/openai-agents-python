+                    biased;
+                    _ = stop_token.cancelled() => return Err(RealtimeInputTaskExit::Terminal),
+                    result = handle_user_audio_input(frame, writer) => {
+                        result.map_err(classify_realtime_input_error)?;
+                    }
+                }
+            }
+        }
