+        return Ok(());
+    }
+    let hold = sdk
+        .function_calls
+        .lock()
+        .await
+        .values()
+        .filter_map(|call| call.batch.as_ref())
+        .find(|batch| {
+            ((batch.handoff_pending.load(Ordering::Acquire)
+                && !batch.automatic_retired.load(Ordering::Acquire))
+                || (batch.handoff_accepted.load(Ordering::Acquire)
+                    && batch.committed_target.lock().unwrap().is_some()))
+                && !batch.continued.load(Ordering::Acquire)
+        })
+        .cloned();
+    if let Some(batch) = hold {
+        if automatic {
+            batch.pending_create.store(true, Ordering::Release);
+        } else {
+            batch.user_create.store(true, Ordering::Release);
+        }
+        return Ok(());
+    }
+    if !automatic {
+        responses.pending_native_create = None;
+    }
+    let result = responses.request_create(writer, reason).await;
+    if !automatic && responses.pending_create {
