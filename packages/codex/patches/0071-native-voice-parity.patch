+#[tokio::test]
+async fn sdk_scoped_batch_interrupt_joins_its_policy_while_later_batch_executes() {
+    tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        use std::sync::atomic::{AtomicBool, Ordering};
+        use codex_protocol::protocol::EventMsg;
+        use codex_protocol::turn_input::TurnInputSubmission;
+        let (session, sdk, events, policy, http, _) = realtime_tool_fixture(false, false).await;
+        policy.pause_cancel.store(true, Ordering::Release);
+        register_realtime_tool(&sdk).await;
+        let configuration = sdk.configuration.lock().unwrap().as_ref().unwrap().accepted().unwrap();
+        // This Core admission fixture uses real captured/accepted native declarations;
+        // wire parsing and provider membership are covered by the wire-ledger tests.
+        let make_batch = |response: &str, id: &str| Arc::new(super::RealtimeFunctionBatch {
+            response_id: response.into(), call_ids: vec![id.into()],
+            configuration: configuration.clone(), completed: std::sync::OnceLock::new(), root_dispatch: std::sync::OnceLock::new(),
+            handoff_pending: AtomicBool::new(false), handoff_accepted: AtomicBool::new(false),
+            pending_create: AtomicBool::new(false), user_create: AtomicBool::new(false),
+            automatic_retired: AtomicBool::new(false), committed_target: Default::default(),
+            update_reserved: AtomicBool::new(false), continued: AtomicBool::new(false),
+        });
+        let batch_a = make_batch("provider-response", "provider-call");
+        let batch_b = make_batch("later-response", "later-call");
+        {
+            let mut calls = sdk.function_calls.lock().await;
+            let a = calls.get_mut("provider-call").unwrap();
+            a.batch = Some(batch_a.clone());
+            let mut request = a.request.clone();
+            request.call_id = "later-call".into();
+            request.item_id = "later-item".into();
+            request.response_id = Some("later-response".into());
+            calls.insert(request.call_id.clone(), super::SdkFunctionCall {
+                request, configuration: Some(configuration.clone()), batch: Some(batch_b),
+                preparation: None, claimed: false, native_turn_id: None,
+                cancel: tokio_util::sync::CancellationToken::new(),
+            completed: tokio_util::sync::CancellationToken::new(),
+            });
+        }
+        assert!(sdk.register("later-call").await.unwrap());
+        let mut init = codex_extension_api::ExtensionDataInit::new();
+        init.insert(Arc::clone(&policy.owner));
+        let started = super::handle_tools_sdk_with_root(&session, None, "tools-generation".into(),
+            "provider-response".into(), vec!["provider-call".into()], "shared-voice-root".into(),
+            crate::WithTurnExtensionData::new(codex_protocol::protocol::ThreadSettingsOverrides::default(), init)).await.unwrap();
+        assert!(matches!(started, TurnInputSubmission::Started { .. }));
+        policy.entered.notified().await;
+        assert!(batch_a.completed.get().is_some(), "running initial batch must expose its join receipt");
+        let attached = super::handle_tools_sdk_with_root(&session, Some("shared-voice-root".into()),
+            "tools-generation".into(), "later-response".into(), vec!["later-call".into()],
+            "later-submission".into(), codex_protocol::protocol::ThreadSettingsOverrides::default().into()).await.unwrap();
+        assert_eq!(attached, TurnInputSubmission::Steered { turn_id: "shared-voice-root".into() });
+        policy.entered.notified().await;
+        let cancel = super::cancel_sdk_tool_work(&session, "tools-generation", false, Some("provider-response"));
+        tokio::pin!(cancel);
+        tokio::select! {
+            _ = &mut cancel => panic!("scoped interrupt lost initial batch join receipt"),
+            _ = policy.cancel_entered.notified() => {}
+        }
+        assert!(tokio::time::timeout(std::time::Duration::from_millis(200), &mut cancel).await.is_err());
+        // A remains in physical cancellation cleanup. B keeps the same root admission
+        // and can execute independently, without a second turn lifecycle/root.
+        policy.decision.notify_one();
+        let call = loop {
+            if let EventMsg::DynamicToolCallRequest(call) = events.recv().await.unwrap().msg { break call; }
+        };
+        assert_eq!(call.turn_id, "shared-voice-root");
+        session.notify_dynamic_tool_response(&call.call_id,
+            codex_protocol::dynamic_tools::DynamicToolResponse {
+                content_items: vec![codex_protocol::dynamic_tools::DynamicToolCallOutputContentItem::InputText { text: "later batch accepted".into() }], success: true,
+            }).await;
+        loop {
+            if let super::SdkRealtimeCommand::FunctionResult { call_id, succeeded, .. } = sdk.commands_rx.recv().await.unwrap() {
+                if call_id == "later-call" { assert!(succeeded); break; }
+            }
+        }
+        policy.cancel_release.notify_one();
+        cancel.await;
+        assert!(batch_a.completed.get().unwrap().is_cancelled());
+        loop {
+            if let EventMsg::TurnComplete(done) = events.recv().await.unwrap().msg {
+                assert_eq!(done.turn_id, "shared-voice-root");
+                assert!(done.error.is_none());
+                break;
+            }
+        }
+        assert_eq!(policy.admissions.load(Ordering::Acquire), 2);
+        assert!(http.received_requests().await.unwrap().is_empty());
+        super::handle_close_sdk(&session, "tools-generation".into()).await.unwrap();
+    }).await.expect("cross-response batch cancellation exceeded 10s");
+}
