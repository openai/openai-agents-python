+    async fn readiness_connection(
+        expected: Value,
+        wait_for_update: bool,
+    ) -> (
+        RealtimeWebsocketConnection,
+        mpsc::Sender<Value>,
+        tokio::task::JoinHandle<()>,
+    ) {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("ws://{}/", listener.local_addr().unwrap());
+        let (send, mut receive) = mpsc::channel::<Value>(16);
+        let server = tokio::spawn(async move {
+            let (socket, _) = listener.accept().await.unwrap();
+            let mut websocket = accept_async(socket).await.unwrap();
+            while let Some(value) = receive.recv().await {
+                websocket
+                    .send(Message::Text(value.to_string().into()))
+                    .await
+                    .unwrap();
+            }
+        });
+        let factory = HttpClientFactory::new(ReqwestDefault);
+        let connector = WebSocketConnector::new(&factory).unwrap();
+        let (socket, _) = connector
+            .connect(url.into_client_request().unwrap(), websocket_config())
+            .await
+            .unwrap();
+        let (stream, messages) = WsStream::new_with_readiness(
+            socket,
+            true,
+            Some(expected),
+            wait_for_update,
+            None,
+            false,
+        );
+        (
+            RealtimeWebsocketConnection::new(
+                stream,
+                messages,
+                RealtimeEventParser::RealtimeV2,
+                RealtimeTranscriptState::default(),
+            ),
+            send,
+            server,
+        )
+    }
