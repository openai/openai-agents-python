+async fn prepared_profile_shutdown_fences_and_joins_starting_clients(
+    cancel: bool,
+) -> anyhow::Result<()> {
+    tokio::time::timeout(Duration::from_secs(30), async {
+        let home = tempfile::tempdir()?;
+        let log = home.path().join("starting");
+        std::fs::create_dir(&log)?;
+        let context = McpRuntimeContext::new(
+            Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+            home.path().to_path_buf(),
+        );
+        let (tx, _) = async_channel::unbounded();
+        let runtime = Arc::new(McpRuntime::empty(true));
+        runtime.enable_full_access_form_input();
+        runtime.begin_owned_prompt_startup();
+        assert!(runtime.finish_owned_prompt_startup());
+        runtime.set_stdio_admission(codex_rmcp_client::ElicitationOwner::for_admission(
+            "starting-profile".into(),
+            Arc::new(()),
+        ));
+        let request = input(home.path(), &log, "blocked", tx, &context);
+        let preparing = Arc::clone(&runtime);
+        let task = tokio::spawn(async move { preparing.prepare_profile_binding(request).await });
+        loop {
+            let mut started = false;
+            for entry in std::fs::read_dir(&log)? {
+                started |= std::fs::read_to_string(entry?.path())?.lines().any(|line| {
+                    serde_json::from_str::<serde_json::Value>(line)
+                        .is_ok_and(|event| event["event"] == "start")
+                });
+            }
+            if started {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(5)).await;
+        }
+        if cancel {
+            task.abort();
+        }
+        runtime.shutdown().await;
+        let result = task.await;
+        if cancel {
+            assert!(matches!(result, Err(error) if error.is_cancelled()));
+        } else {
+            assert!(result?.is_err());
+        }
+        assert!(assert_prepared_processes_reaped(&log)?.is_empty());
+        let (tx, _) = async_channel::unbounded();
+        assert!(
+            runtime
+                .prepare_profile_binding(input(home.path(), &log, "late", tx, &context))
+                .await
+                .is_err()
+        );
+        assert_eq!(std::fs::read_dir(&log)?.count(), 1);
+        anyhow::Ok(())
+    })
+    .await?
+}
