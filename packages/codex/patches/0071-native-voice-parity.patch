diff --git a/codex-rs/core/src/realtime_conversation/item_deletion.rs b/codex-rs/core/src/realtime_conversation/item_deletion.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9b650125b925d6ad3c29e2546c97abe4bf3a6216
--- /dev/null
+++ b/codex-rs/core/src/realtime_conversation/item_deletion.rs
@@ -0,0 +1,567 @@
+//! Provider identity receipts for the current generation, without message contents.
+use super::*;
+use std::collections::{HashMap, VecDeque};
+const ITEM_LIMIT: usize = 4096;
+const ID_BYTES: usize = 512;
+#[derive(Debug, Clone)]
+pub(super) struct DeleteReply(
+    std::sync::Arc<std::sync::Mutex<Option<tokio::sync::oneshot::Sender<CodexResult<()>>>>>,
+);
+impl DeleteReply {
+    pub(super) fn new(reply: tokio::sync::oneshot::Sender<CodexResult<()>>) -> Self {
+        Self(std::sync::Arc::new(std::sync::Mutex::new(Some(reply))))
+    }
+    pub(super) fn finish(&mut self, result: CodexResult<()>) {
+        if let Some(reply) = self.0.lock().unwrap().take() {
+            let _ = reply.send(result);
+        }
+    }
+}
+impl Drop for DeleteReply {
+    fn drop(&mut self) {
+        if std::sync::Arc::strong_count(&self.0) == 1 {
+            self.finish(Err(CodexErr::TurnAborted));
+        }
+    }
+}
+#[derive(Debug, Clone)]
+struct Item {
+    kind: String,
+    role: Option<String>,
+    call_id: Option<String>,
+    approval_request_id: Option<String>,
+    done: bool,
+    effect_done: bool,
+}
+#[derive(Debug)]
+struct Pending {
+    item_id: String,
+    acknowledged: bool,
+    deadline: tokio::time::Instant,
+    reply: DeleteReply,
+}
+#[derive(Debug, Default)]
+pub(super) struct State {
+    items: HashMap<String, Item>,
+    order: VecDeque<String>,
+    recent_deleted: VecDeque<String>,
+    recent_noop_completions: VecDeque<String>,
+    pending: Option<Pending>,
+}
+impl State {
+    fn valid_id(id: &str) -> bool {
+        !id.is_empty() && id.len() <= ID_BYTES
+    }
+    fn upsert(&mut self, id: &str, item: Item) -> anyhow::Result<()> {
+        anyhow::ensure!(Self::valid_id(id), "Invalid provider conversation item ID");
+        if self.recent_deleted.iter().any(|known| known == id) {
+            return Ok(());
+        }
+        let mut item = item;
+        item.effect_done |= item
+            .call_id
+            .as_ref()
+            .is_some_and(|call_id| self.recent_noop_completions.contains(call_id));
+        if item.kind == "function_call_output" {
+            if let Some(call_id) = &item.call_id {
+                self.recent_noop_completions.retain(|id| id != call_id);
+            }
+        }
+        item.effect_done |= item.call_id.as_ref().is_some_and(|call_id| {
+            self.items
+                .values()
+                .any(|known| known.call_id.as_ref() == Some(call_id) && known.effect_done)
+        });
+        if let Some(old) = self.items.get_mut(id) {
+            anyhow::ensure!(
+                old.kind == item.kind
+                    && old.call_id == item.call_id
+                    && old.role == item.role
+                    && old.approval_request_id == item.approval_request_id,
+                "Provider conversation item identity changed"
+            );
+            old.done |= item.done;
+            old.effect_done |= item.effect_done;
+        } else {
+            if self.items.len() == ITEM_LIMIT {
+                let candidate = self
+                    .order
+                    .iter()
+                    .find(|id| {
+                        self.items.get(*id).is_some_and(|item| {
+                            item.done
+                                && (item.kind == "message" || item.effect_done)
+                                && self
+                                    .pending
+                                    .as_ref()
+                                    .is_none_or(|pending| &pending.item_id != *id)
+                                && !self.items.values().any(|other| {
+                                    other.approval_request_id.as_ref() == Some(*id)
+                                        && !other.effect_done
+                                })
+                        })
+                    })
+                    .cloned();
+                let oldest = candidate.context("Provider conversation has too many live items")?;
+                self.items.remove(&oldest);
+                self.order.retain(|id| id != &oldest);
+            }
+            self.order.push_back(id.to_owned());
+            self.items.insert(id.to_owned(), item);
+        }
+        Ok(())
+    }
+    pub(super) fn observe(
+        &mut self,
+        event: &RealtimeEvent,
+    ) -> anyhow::Result<Option<codex_protocol::protocol::RealtimeConversationItemObservation>> {
+        let mut observed = None;
+        match event {
+            RealtimeEvent::ConversationItemAdded(value) => {
+                let id = value["id"].as_str().context("Provider item has no ID")?;
+                let kind = value["type"]
+                    .as_str()
+                    .context("Provider item has no type")?;
+                anyhow::ensure!(kind.len() <= 64, "Invalid provider item type");
+                let bounded = |key: &str| -> anyhow::Result<Option<String>> {
+                    value
+                        .get(key)
+                        .and_then(serde_json::Value::as_str)
+                        .map(|v| {
+                            anyhow::ensure!(Self::valid_id(v), "Invalid provider item identity");
+                            Ok(v.to_owned())
+                        })
+                        .transpose()
+                };
+                self.upsert(
+                    id,
+                    Item {
+                        kind: kind.to_owned(),
+                        role: bounded("role")?,
+                        call_id: bounded("call_id")?,
+                        approval_request_id: bounded("approval_request_id")?,
+                        done: value["status"].as_str() == Some("completed"),
+                        effect_done: kind == "mcp_approval_response"
+                            && value["status"].as_str() == Some("completed"),
+                    },
+                )?;
+                if kind == "mcp_approval_response" && value["status"].as_str() == Some("completed")
+                {
+                    if let Some(parent) = value["approval_request_id"]
+                        .as_str()
+                        .and_then(|id| self.items.get_mut(id))
+                    {
+                        parent.done = true;
+                        parent.effect_done = true;
+                    }
+                }
+                observed = Some((id.to_owned(), "added"));
+            }
+            RealtimeEvent::ConversationItemDone { item_id } => {
+                let approval = if let Some(item) = self.items.get_mut(item_id) {
+                    item.done = true;
+                    if item.kind == "mcp_approval_response" {
+                        item.effect_done = true;
+                        item.approval_request_id.clone()
+                    } else {
+                        None
+                    }
+                } else {
+                    None
+                };
+                if let Some(parent) = approval.and_then(|id| self.items.get_mut(&id)) {
+                    parent.done = true;
+                    parent.effect_done = true;
+                }
+                observed = Some((item_id.clone(), "done"));
+            }
+            RealtimeEvent::FunctionCallRequested(call) => {
+                self.upsert(
+                    &call.item_id,
+                    Item {
+                        kind: "function_call".into(),
+                        role: None,
+                        call_id: Some(call.call_id.clone()),
+                        approval_request_id: None,
+                        done: true,
+                        effect_done: false,
+                    },
+                )?;
+                observed = Some((call.item_id.clone(), "done"));
+            }
+            RealtimeEvent::FunctionCallFinished { call_id, .. } => self.settle_call(call_id),
+            RealtimeEvent::HandoffRequested(call) => {
+                self.upsert(
+                    &call.item_id,
+                    Item {
+                        kind: "function_call".into(),
+                        role: None,
+                        call_id: Some(call.handoff_id.clone()),
+                        approval_request_id: None,
+                        done: true,
+                        effect_done: false,
+                    },
+                )?;
+                observed = Some((call.item_id.clone(), "done"));
+            }
+            RealtimeEvent::NoopRequested(call) => {
+                // This reserved path has no SDK seen/pending call record. Keep
+                // bounded completion provenance until its output item is observed.
+                if self.recent_noop_completions.len() == ITEM_LIMIT {
+                    self.recent_noop_completions.pop_front();
+                }
+                self.recent_noop_completions.push_back(call.call_id.clone());
+                // The actor has already written this reserved tool's output.
+                self.upsert(
+                    &call.item_id,
+                    Item {
+                        kind: "function_call".into(),
+                        role: None,
+                        call_id: Some(call.call_id.clone()),
+                        approval_request_id: None,
+                        done: true,
+                        effect_done: true,
+                    },
+                )?;
+                observed = Some((call.item_id.clone(), "done"));
+            }
+            RealtimeEvent::HostedMcpCallCompleted(call) => {
+                if let Some(item) = self.items.get_mut(&call.item_id) {
+                    item.done = true;
+                    item.effect_done = true;
+                }
+                observed = Some((call.item_id.clone(), "done"));
+            }
+            RealtimeEvent::HostedMcpToolsListed(list) => {
+                if let Some(item) = self.items.get_mut(&list.item_id) {
+                    item.done = true;
+                    item.effect_done = true;
+                }
+                observed = Some((list.item_id.clone(), "done"));
+            }
+            _ => {}
+        }
+        Ok(observed.and_then(|(id, status)| {
+            self.items.get(&id).map(|item| {
+                codex_protocol::protocol::RealtimeConversationItemObservation {
+                    item_id: id,
+                    kind: item.kind.clone(),
+                    status: status.to_owned(),
+                    role: item.role.clone(),
+                    call_id: item.call_id.clone(),
+                }
+            })
+        }))
+    }
+    pub(super) fn settle_call(&mut self, call_id: &str) {
+        for item in self
+            .items
+            .values_mut()
+            .filter(|item| item.call_id.as_deref() == Some(call_id))
+        {
+            item.effect_done = true;
+        }
+    }
+    pub(super) fn validate(&self, id: &str) -> CodexResult<()> {
+        let item = self
+            .items
+            .get(id)
+            .ok_or_else(|| CodexErr::InvalidRequest("Unknown provider conversation item".into()))?;
+        if !Self::valid_id(id) || self.pending.is_some() {
+            return Err(CodexErr::InvalidRequest(
+                "Invalid item or another deletion is pending".into(),
+            ));
+        }
+        let supported = match item.kind.as_str() {
+            "message" => item.done && matches!(item.role.as_deref(), Some("user" | "assistant")),
+            "function_call" | "function_call_output" => item.done && item.effect_done,
+            "mcp_call" | "mcp_tool_call" | "mcp_list_tools" => item.done && item.effect_done,
+            "mcp_approval_response" => item.done && item.approval_request_id.is_some(),
+            "mcp_approval_request" => self.items.values().any(|other| {
+                other.kind == "mcp_approval_response"
+                    && other.done
+                    && other.approval_request_id.as_deref() == Some(id)
+            }),
+            _ => false,
+        };
+        let live_dependency = self
+            .items
+            .values()
+            .any(|other| other.approval_request_id.as_deref() == Some(id) && !other.effect_done);
+        if !supported || live_dependency {
+            return Err(CodexErr::InvalidRequest(
+                "Provider item has unresolved work or an unsupported kind".into(),
+            ));
+        }
+        Ok(())
+    }
+    pub(super) fn begin(&mut self, id: String, mut reply: DeleteReply) -> bool {
+        if let Err(error) = self.validate(&id) {
+            reply.finish(Err(error));
+            return false;
+        }
+        self.pending = Some(Pending {
+            item_id: id,
+            acknowledged: false,
+            deadline: tokio::time::Instant::now() + Duration::from_secs(10),
+            reply,
+        });
+        true
+    }
+    pub(super) fn acknowledge(&mut self, id: &str) -> bool {
+        let Some(pending) = self
+            .pending
+            .as_mut()
+            .filter(|pending| pending.item_id == id && !pending.acknowledged)
+        else {
+            return false;
+        };
+        pending.acknowledged = true;
+        true
+    }
+    pub(super) fn finish(&mut self, id: &str, result: CodexResult<()>) {
+        if self.pending.as_ref().is_none_or(|p| p.item_id != id) {
+            return;
+        }
+        if let Some(mut pending) = self.pending.take() {
+            if result.is_ok() {
+                self.items.remove(id);
+                self.order.retain(|known| known != id);
+                if self.recent_deleted.len() == 128 {
+                    self.recent_deleted.pop_front();
+                }
+                self.recent_deleted.push_back(id.to_owned());
+            }
+            pending.reply.finish(result);
+        }
+    }
+    pub(super) fn deadline(&self) -> Option<tokio::time::Instant> {
+        self.pending.as_ref().map(|pending| pending.deadline)
+    }
+    pub(super) fn retire(&mut self) {
+        self.pending.take();
+        self.items.clear();
+        self.order.clear();
+        self.recent_deleted.clear();
+        self.recent_noop_completions.clear();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn message(state: &mut State, id: &str, role: &str) {
+        state
+            .observe(&RealtimeEvent::ConversationItemAdded(serde_json::json!({
+                "id": id, "type": "message", "role": role, "status": "completed"
+            })))
+            .unwrap();
+    }
+    fn reply() -> (DeleteReply, tokio::sync::oneshot::Receiver<CodexResult<()>>) {
+        let (tx, rx) = tokio::sync::oneshot::channel();
+        (DeleteReply::new(tx), rx)
+    }
+    #[tokio::test]
+    async fn delete_requires_exact_ack_and_persistence_completion() {
+        let mut state = State::default();
+        message(&mut state, "one", "user");
+        let (reply, mut receiver) = reply();
+        assert!(state.begin("one".into(), reply));
+        assert!(receiver.try_recv().is_err());
+        assert!(!state.acknowledge("other"));
+        assert!(state.acknowledge("one"));
+        assert!(!state.acknowledge("one"));
+        assert!(receiver.try_recv().is_err());
+        state.finish("one", Ok(()));
+        assert!(receiver.await.unwrap().is_ok());
+        assert!(state.validate("one").is_err());
+        assert!(state.items.is_empty());
+    }
+    #[tokio::test]
+    async fn retirement_releases_pending_delete_without_success() {
+        let mut state = State::default();
+        message(&mut state, "one", "assistant");
+        let (reply, receiver) = reply();
+        assert!(state.begin("one".into(), reply));
+        state.retire();
+        assert!(receiver.await.unwrap().is_err());
+        assert!(!state.acknowledge("one"));
+    }
+    #[tokio::test]
+    async fn cancelled_host_waiter_does_not_cancel_remote_receipt_owner() {
+        let mut state = State::default();
+        message(&mut state, "one", "user");
+        let (reply, receiver) = reply();
+        assert!(state.begin("one".into(), reply));
+        drop(receiver);
+        assert!(state.acknowledge("one"));
+        state.finish("one", Ok(()));
+        assert!(state.items.is_empty());
+    }
+    #[test]
+    fn unknown_unfinished_and_instruction_items_are_not_admitted() {
+        let mut state = State::default();
+        assert!(state.validate("absent").is_err());
+        message(&mut state, "instructions", "developer");
+        assert!(state.validate("instructions").is_err());
+        state
+            .observe(&RealtimeEvent::ConversationItemAdded(serde_json::json!({
+                "id": "streaming", "type": "message", "role": "assistant", "status": "in_progress"
+            })))
+            .unwrap();
+        assert!(state.validate("streaming").is_err());
+    }
+    #[test]
+    fn tool_output_requires_actual_native_completion() {
+        let mut state = State::default();
+        for (id, kind) in [
+            ("call", "function_call"),
+            ("result", "function_call_output"),
+        ] {
+            state
+                .observe(&RealtimeEvent::ConversationItemAdded(serde_json::json!({
+                    "id": id, "type": kind, "call_id": "native-call", "status": "completed"
+                })))
+                .unwrap();
+        }
+        assert!(state.validate("result").is_err());
+        state.settle_call("native-call");
+        assert!(state.validate("result").is_ok());
+        assert!(state.validate("call").is_ok());
+    }
+    #[test]
+    fn completed_metadata_evicts_without_a_lifetime_connection_cap() {
+        let mut state = State::default();
+        for n in 0..ITEM_LIMIT + 8 {
+            message(&mut state, &format!("item-{n}"), "user");
+        }
+        assert_eq!(state.items.len(), ITEM_LIMIT);
+        assert!(state.validate("item-0").is_err());
+        assert!(state.validate(&format!("item-{}", ITEM_LIMIT + 7)).is_ok());
+    }
+    #[tokio::test]
+    async fn repeated_successful_pruning_releases_live_capacity() {
+        let mut state = State::default();
+        for n in 0..ITEM_LIMIT + 8 {
+            let id = format!("item-{n}");
+            message(&mut state, &id, "user");
+            let (reply, receiver) = reply();
+            assert!(state.begin(id.clone(), reply));
+            assert!(state.acknowledge(&id));
+            state.finish(&id, Ok(()));
+            assert!(receiver.await.unwrap().is_ok());
+        }
+        assert!(state.items.is_empty());
+        assert_eq!(state.recent_deleted.len(), 128);
+    }
+}
