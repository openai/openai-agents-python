+        let home = tempfile::tempdir()?;
+        let log = home.path().join("profiles");
+        std::fs::create_dir(&log)?;
+        let context = McpRuntimeContext::new(
+            Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+            home.path().to_path_buf(),
+        );
+        let (tx, rx) = async_channel::unbounded();
+        let runtime = McpRuntime::empty(true);
+        runtime.enable_full_access_form_input();
+        runtime.begin_owned_prompt_startup();
+        assert!(runtime.finish_owned_prompt_startup());
+        runtime.set_stdio_admission(codex_rmcp_client::ElicitationOwner::for_admission(
+            "profiles".into(),
+            Arc::new(()),
+        ));
+        let a = runtime
+            .prepare_profile_binding(input(home.path(), &log, "a", tx.clone(), &context))
+            .await?;
+        let b = runtime
+            .prepare_profile_binding(input(home.path(), &log, "b", tx, &context))
+            .await?;
+        assert!(runtime.current_binding().await.is_none());
+        let a_call = a.prepare_call("docs", "search").unwrap();
+        let a_task = tokio::spawn(async move { a_call.call(None, None, None).await });
+        question(&rx).await;
+        let b_call = b.prepare_call("docs", "search").unwrap();
+        let b_task = tokio::spawn(async move { b_call.call(None, None, None).await });
+        question(&rx).await;
+        runtime.shutdown().await;
+        let _ = a_task.await;
+        let _ = b_task.await;
+        assert_eq!(assert_prepared_processes_reaped(&log)?, vec!["a", "b"]);
+        anyhow::Ok(())
+    })
+    .await?
+}
