+    #[test]
+    fn named_choice_is_preserved_and_source_change_cannot_remove_it_without_explicit_reset() {
+        let source_a: Arc<dyn RealtimeNativeSource> = Arc::new(TestSource(AgentProfileReceipt {
+            profile_id: "a".into(),
+            epoch: 0,
+        }));
+        let source_b: Arc<dyn RealtimeNativeSource> = Arc::new(TestSource(AgentProfileReceipt {
+            profile_id: "b".into(),
+            epoch: 1,
+        }));
+        let expected = json!({"tool_choice":{"type":"function","name":"weather"}, "tools":[{"type":"function","name":"weather","parameters":{"type":"object"}}]});
+        let (observer, _) = SessionReadiness::channel_with_source(
+            Some(expected.clone()),
+            true,
+            Some(source_a.clone()),
+        );
+        let observer = observer.unwrap();
+        acknowledge(&observer, expected);
+        let configuration = observer.configuration();
+        let before = configuration.accepted().unwrap();
+        for source in [None, Some(source_b.clone())] {
+            let update: RealtimeSessionUpdate =
+                serde_json::from_value(json!({"function_tools":[]})).unwrap();
+            let rejected = match source {
+                Some(source) => configuration.reserve_update_with_source(&update, source),
+                None => configuration.reserve_update(&update),
+            };
+            assert!(rejected.is_err());
+            assert!(Arc::ptr_eq(&before, &configuration.accepted().unwrap()));
+        }
+        let reservation = configuration
+            .reserve_update(&RealtimeSessionUpdate::default())
+            .unwrap();
+        assert!(reservation.payload["session"].get("tool_choice").is_none());
+        let contract = configuration
+            .inner
+            .state
+            .lock()
+            .unwrap()
+            .pending
+            .as_ref()
+            .unwrap()
+            .contract
+            .clone();
+        assert_eq!(
+            contract["tool_choice"],
+            json!({"type":"function","name":"weather"})
+        );
+        reservation.arm().unwrap();
+        acknowledge(&observer, contract);
+        let reset: RealtimeSessionUpdate =
+            serde_json::from_value(json!({"function_tools":[],"tool_choice":"auto"})).unwrap();
+        let reservation = configuration
+            .reserve_update_with_source(&reset, source_b.clone())
+            .unwrap();
+        let contract = configuration
+            .inner
+            .state
+            .lock()
+            .unwrap()
+            .pending
+            .as_ref()
+            .unwrap()
+            .contract
+            .clone();
+        reservation.arm().unwrap();
+        acknowledge(&observer, contract);
+        let accepted = configuration.accepted().unwrap();
+        assert_eq!(accepted.contract["tool_choice"], "auto");
+        assert!(Arc::ptr_eq(
+            accepted.native_source.as_ref().unwrap(),
+            &source_b
+        ));
+        assert!(accepted.function_tools().is_empty());
+    }
+}
