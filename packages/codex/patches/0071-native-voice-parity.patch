+                super::readiness::ReadyState::Ready => return Ok(()),
+                super::readiness::ReadyState::Mismatch => {
+                    return Err(ApiError::InvalidRequest {
+                        message: "Accepted Realtime session did not match the requested settings"
+                            .into(),
