+async fn sdk_function_duplicates_never_bind_to_latest_response() {
+    use codex_protocol::protocol::{
+        RealtimeEvent, RealtimeFunctionCallRequested, RealtimeResponseCreated, RealtimeResponseDone,
+    };
+    let (connection, mut wire, server) = sdk_wire_connection().await;
+    wire.recv().await.unwrap();
+    let definition = codex_protocol::realtime_settings::RealtimeFunctionTool {
+        name: "function".into(),
