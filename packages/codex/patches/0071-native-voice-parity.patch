+/// Runtime-only playback lifetime, independent of serialized history and config reuse.
+#[derive(Clone)]
+pub struct RealtimeOutputGuard {
+    response_alive: std::sync::Arc<std::sync::atomic::AtomicBool>,
+    owner_alive: std::sync::Arc<std::sync::atomic::AtomicBool>,
+}
+impl Default for RealtimeOutputGuard {
+    fn default() -> Self {
+        Self {
+            response_alive: std::sync::Arc::new(std::sync::atomic::AtomicBool::new(true)),
+            owner_alive: std::sync::Arc::new(std::sync::atomic::AtomicBool::new(true)),
+        }
+    }
+}
+impl std::fmt::Debug for RealtimeOutputGuard {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("RealtimeOutputGuard")
+            .field("retired", &self.is_retired())
+            .finish()
+    }
+}
+// Runtime publication state is not part of an event's semantic value.
+impl PartialEq for RealtimeOutputGuard {
+    fn eq(&self, _: &Self) -> bool {
+        true
+    }
+}
+impl Eq for RealtimeOutputGuard {}
+impl RealtimeOutputGuard {
+    pub fn new_response(&self) -> Self {
+        Self {
+            response_alive: std::sync::Arc::new(std::sync::atomic::AtomicBool::new(true)),
+            owner_alive: self.owner_alive.clone(),
+        }
+    }
+    pub fn retire(&self) {
+        self.response_alive
+            .store(false, std::sync::atomic::Ordering::Release);
+    }
+    pub fn retire_owner(&self) {
+        self.owner_alive
+            .store(false, std::sync::atomic::Ordering::Release);
+    }
+    pub fn is_retired(&self) -> bool {
+        !self
+            .response_alive
+            .load(std::sync::atomic::Ordering::Acquire)
+            || !self.owner_alive.load(std::sync::atomic::Ordering::Acquire)
+    }
+}
