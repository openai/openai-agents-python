+    /// Capture readiness requirements against these exact connections and configuration.
+    /// This never consults the runtime's subsequently published Agent or server catalog.
+    pub async fn recapture_with_requirements(
+        &self,
+        required_servers: &[String],
+        required_plugins: &HashSet<String>,
+    ) -> Result<Self> {
+        for server in required_servers {
+            anyhow::ensure!(
+                self.connections.contains_server(server),
+                "Required MCP server {server} is absent from the captured Agent binding"
+            );
+        }
+        self.connections.validate_required_servers().await?;
+        let captured = self
+            .connections
+            .capture_binding_with_metadata(
+                Arc::clone(&self.config),
+                self.plugins_available,
+                required_servers,
+                required_plugins,
+            )
+            .await;
+        let statuses = self.connections.connection_statuses().await;
+        for (server, status) in statuses {
+            let required = required_servers.contains(&server)
+                || (self.connections.is_selected_plugin_mcp_server(&server)
+                    && self
+                        .connections
+                        .plugin_id_for_mcp_server_name(&server)
+                        .is_some_and(|plugin| required_plugins.contains(plugin)));
+            if required {
+                anyhow::ensure!(
+                    matches!(
+                        status,
+                        codex_protocol::mcp::McpServerConnectionStatus::Connected
+                    ),
+                    "Required MCP server {server} did not become ready in the captured Agent binding: {status:?}"
+                );
+            }
+        }
+        Ok(captured)
+    }
+
+    /// Wait on this captured server rather than the runtime's current Agent.
+    pub async fn wait_for_server_startup(&self, server: &str) -> bool {
+        self.connections.wait_for_server_startup(server).await
+    }
