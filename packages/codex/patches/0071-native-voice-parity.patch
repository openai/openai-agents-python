+async fn retained_cached_call_waits_on_its_source_and_rejects_schema_drift() {
+    for changed_schema in [false, true] {
+        let runtime_context = McpRuntimeContext::new(
+            Arc::new(environment_manager_without_environments()),
+            std::env::temp_dir(),
+        );
+        let server_config: McpServerConfig =
+            serde_json::from_value(serde_json::json!({"command":"pending-source-mcp"})).unwrap();
+        let cache_context = McpToolCatalogCache::default()
+            .context(
+                "pending",
+                &server_config,
+                &runtime_context,
+                None,
+                (
+                    &ElicitationCapability::default(),
+                    &ClientMcpExtensions::default(),
+                ),
+                None,
+            )
+            .unwrap();
+        let mut advertised = create_test_tool("pending", "echo");
+        advertised.tool.annotations = Some(rmcp::model::ToolAnnotations::new().read_only(true));
+        cache_context.publish_if_newest(cache_context.begin_fetch(), &[advertised]);
+        let mut ready_tool = create_test_tool("pending", "echo");
+        ready_tool.tool.annotations = Some(rmcp::model::ToolAnnotations::new().read_only(false));
+        if changed_schema {
+            ready_tool.tool.input_schema = Arc::new(serde_json::from_value(serde_json::json!({
+                "type":"object","properties":{"changed":{"type":"string"}},"required":["changed"]
+            })).unwrap());
+        }
+        let ready_client = create_test_managed_client(vec![ready_tool]).await;
+        let source_transport = ready_client.client.transport_instance();
+        let (mut client, started, release) = create_gated_async_managed_client(ready_client);
+        client.tool_catalog_cache_context = Some(cache_context);
+        let mut manager = McpConnectionSet::new_uninitialized(
+            &Constrained::allow_any(AskForApproval::OnRequest),
+            &Constrained::allow_any(PermissionProfile::default()),
+            true,
+        );
+        manager.insert_test_client("pending", client);
+        let manager = Arc::new(manager);
+        let captured = Arc::new(capture_binding(&manager).await);
+        assert!(
+            captured
+                .tools()
+                .iter()
+                .any(|tool| tool.server_name == "pending" && tool.tool.name == "echo")
+        );
+        let advertised = captured
+            .tools()
+            .iter()
+            .find(|tool| tool.server_name == "pending" && tool.tool.name == "echo")
+            .unwrap();
+        assert_eq!(
+            advertised
+                .tool
+                .annotations
+                .as_ref()
+                .and_then(|annotations| annotations.read_only_hint),
+            None,
+            "unresolved cached metadata cannot promise read-only parallel safety"
+        );
+        assert!(
+            !advertised.supports_parallel_tool_calls,
+            "this fixture has no explicit server parallel opt-in"
+        );
+        assert!(captured.prepare_call("pending", "echo").is_none());
+        assert!(
+            captured
+                .prepare_call_when_ready("pending", "not_advertised")
+                .await
+                .is_none()
+        );
+        let retained = Arc::clone(&captured);
+        let mut prepare =
+            tokio::spawn(async move { retained.prepare_call_when_ready("pending", "echo").await });
+        started.await.expect("exact source startup began");
+        assert!(
+            tokio::time::timeout(Duration::from_millis(10), &mut prepare)
+                .await
+                .is_err()
+        );
+        release.send(()).expect("release captured source startup");
+        let call = prepare.await.unwrap();
+        if changed_schema {
+            assert!(
+                call.is_none(),
+                "cached schema changes cannot inherit old admission"
+            );
+        } else {
+            let call = call.expect("same captured tool becomes callable");
+            assert_eq!(call.transport_instance(), source_transport);
+            assert_eq!(
