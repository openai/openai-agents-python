+async fn prepared_close_with_provider_credential(missing_env: bool) {
+    use futures::StreamExt;
+    let (session, _, _events, policy, http, _) = realtime_tool_fixture(false, false).await;
+    super::handle_close_sdk(&session, "tools-generation".into())
+        .await
+        .unwrap();
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let (entered_tx, entered_rx) = tokio::sync::oneshot::channel();
+    let (closed_tx, closed_rx) = tokio::sync::oneshot::channel();
+    let server = tokio::spawn(async move {
+        let (socket, _) = listener.accept().await.unwrap();
+        let mut websocket = tokio_tungstenite::accept_hdr_async(
+            socket,
+            |request: &tokio_tungstenite::tungstenite::handshake::server::Request, response| {
+                assert_eq!(
+                    request.headers()[http::header::AUTHORIZATION],
+                    "Bearer private-voice-key"
+                );
+                Ok(response)
+            },
+        )
+        .await
+        .unwrap();
+        let initial = websocket.next().await.unwrap().unwrap();
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(initial.to_text().unwrap()).unwrap()["type"],
+            "session.update"
+        );
+        let _ = entered_tx.send(());
+        // Deliberately withhold session.updated. Close must cancel its native waiter.
+        while let Some(Ok(_)) = websocket.next().await {}
+        let _ = closed_tx.send(());
+    });
+    session
+        .services
+        .thread_extension_data
+        .insert(super::RealtimeConfigProjection::new(Arc::new(
+            move |config| {
+                let mut config = config.clone();
+                config.model_provider.base_url = Some(format!("http://{address}/v1"));
+                config.model_provider.env_key =
+                    missing_env.then(|| "CODEX_VOICE_TEST_MISSING_CREDENTIAL_7CCB690F".to_owned());
+                config.model_provider.experimental_bearer_token =
+                    (!missing_env).then(|| "configured-provider-key".to_owned().into());
+                config
+            },
+        )));
+    let prepared = super::handle_prepare_sdk(
+        &session,
+        "prepared-wire".into(),
+        prepared_voice_params(),
+        Some(Default::default()),
+        None,
+        None,
+        true,
+        None,
+    )
+    .await
+    .unwrap();
+    assert_eq!(prepared.generation, "prepared-wire");
+    let (reply, admission) = tokio::sync::oneshot::channel();
+    super::handle_activate_sdk(
+        &session,
+        "prepared-wire".into(),
+        Some(codex_protocol::protocol::RealtimeConversationApiKey::new(
+            "private-voice-key".into(),
+        )),
+        reply,
+    )
+    .await;
+    tokio::time::timeout(std::time::Duration::from_secs(3), entered_rx)
+        .await
+        .unwrap()
+        .unwrap();
+    tokio::time::timeout(
+        std::time::Duration::from_secs(2),
+        super::handle_close_sdk(&session, "prepared-wire".into()),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert!(admission.await.unwrap().is_err());
+    tokio::time::timeout(std::time::Duration::from_secs(2), closed_rx)
+        .await
+        .unwrap()
+        .unwrap();
+    server.await.unwrap();
+    assert_eq!(
+        policy.admissions.load(std::sync::atomic::Ordering::Acquire),
+        0
+    );
+    assert!(http.received_requests().await.unwrap().is_empty());
+}
