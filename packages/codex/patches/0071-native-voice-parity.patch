+#[cfg(test)]
+mod custom_adapter_io_tests {
+    use super::super::adapter_io::{RealtimeAdapterConnection, RealtimeAdapterError};
+    use super::*;
+    use futures::future::BoxFuture;
+    use std::sync::atomic::AtomicUsize;
+    use tokio::sync::Notify;
+    use tokio::sync::Semaphore;
+    use tokio_util::sync::CancellationToken;
+
+    struct Controlled {
+        frames: Mutex<mpsc::Receiver<String>>,
+        received: AtomicUsize,
+        read: Notify,
+        sending: Notify,
+        release: Semaphore,
+        fail_send: AtomicBool,
+        fail_close: AtomicBool,
+        closed: AtomicUsize,
+    }
+
+    impl RealtimeAdapterConnection for Controlled {
+        fn send(&self, _: String) -> BoxFuture<'_, Result<(), RealtimeAdapterError>> {
+            Box::pin(async move {
+                self.sending.notify_one();
+                self.release.acquire().await.unwrap().forget();
+                if self.fail_send.load(Ordering::Acquire) {
+                    Err(RealtimeAdapterError)
+                } else {
+                    Ok(())
+                }
+            })
+        }
+        fn receive(&self) -> BoxFuture<'_, Result<Option<String>, RealtimeAdapterError>> {
+            Box::pin(async move {
+                let frame = self.frames.lock().await.recv().await;
+                if frame.is_some() {
+                    self.received.fetch_add(1, Ordering::AcqRel);
+                    self.read.notify_one();
+                }
+                Ok(frame)
+            })
+        }
+        fn close(&self) -> BoxFuture<'_, Result<(), RealtimeAdapterError>> {
+            Box::pin(async move {
+                self.closed.fetch_add(1, Ordering::AcqRel);
+                if self.fail_close.swap(false, Ordering::AcqRel) {
+                    Err(RealtimeAdapterError)
+                } else {
+                    Ok(())
+                }
+            })
+        }
+    }
+
+    fn controlled_connection() -> (Arc<Controlled>, mpsc::Sender<String>) {
+        let (tx, frames) = mpsc::channel(4);
+        let controlled = Arc::new(Controlled {
+            frames: Mutex::new(frames),
+            received: AtomicUsize::new(0),
+            read: Notify::new(),
+            sending: Notify::new(),
+            release: Semaphore::new(0),
+            fail_send: AtomicBool::new(false),
+            fail_close: AtomicBool::new(false),
+            closed: AtomicUsize::new(0),
+        });
+        (controlled, tx)
+    }
+
+    fn fixture() -> (
+        Arc<WsStream>,
+        async_channel::Receiver<QueuedWireMessage>,
+        Arc<Controlled>,
+        mpsc::Sender<String>,
+    ) {
+        let (controlled, tx) = controlled_connection();
+        let io = AdapterIo::new(controlled.clone(), CancellationToken::new());
+        let cleanup = io.cleanup();
+        let (stream, messages) = WsStream::new_with_io(
+            io,
+            true,
+            Some(serde_json::json!({"instructions":"accepted"})),
+            true,
+            None,
+            false,
+            Some(cleanup),
+        );
+        (Arc::new(stream), messages, controlled, tx)
+    }
+
+    async fn stage_early_frames(controlled: &Controlled, tx: &mpsc::Sender<String>) {
+        for frame in [
+            serde_json::json!({"type":"session.updated","session":{"id":"s","instructions":"accepted"}}),
+            serde_json::json!({"type":"response.created","response":{"id":"r"}}),
+            serde_json::json!({"type":"response.output_item.added","response_id":"r","output_index":0,"item":{"id":"i","type":"function_call","call_id":"c","name":"tool","arguments":"{}"}}),
+        ] {
+            tx.send(frame.to_string()).await.unwrap();
+        }
+        tokio::time::timeout(std::time::Duration::from_secs(2), async {
+            while controlled.received.load(Ordering::Acquire) != 3 {
+                controlled.read.notified().await;
+            }
+        })
+        .await
+        .unwrap();
+    }
