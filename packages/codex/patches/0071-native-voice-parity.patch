+// Drive Core with the API reader's actual immutable wire admission, including its
+// response/tool ledger. Native execution and durable output are tested separately.
+async fn dispatch_sdk_wire_until(
+    connection: &codex_api::RealtimeWebsocketConnection,
+    handoff: &super::RealtimeHandoffState,
+    events: &async_channel::Sender<codex_api::RealtimeEvent>,
+    responses: &mut super::RealtimeResponseCreateQueue,
+    matches: fn(&codex_api::RealtimeEvent) -> bool,
+) {
+    tokio::time::timeout(std::time::Duration::from_secs(5), async {
+        loop {
+            let (event, configuration) = connection
+                .events()
+                .next_event_with_configuration()
+                .await
+                .unwrap()
+                .unwrap();
+            let done = matches(&event);
+            super::handle_realtime_server_event_with_configuration(
+                event,
+                &connection.writer(),
+                events,
+                handoff,
+                RealtimeSessionKind::V2,
+                &mut None,
+                responses,
+                configuration,
+            )
+            .await
+            .unwrap();
+            if done {
+                break;
+            }
+        }
+    })
+    .await
+    .unwrap();
+}
