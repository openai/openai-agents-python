+//! Application frame I/O below the native Realtime protocol owner.
+use futures::FutureExt;
+use futures::Sink;
+use futures::Stream;
+use futures::future::BoxFuture;
+use futures::future::Shared;
+use http::HeaderMap;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::task::Context;
+use std::task::Poll;
+use tokio::sync::mpsc;
+use tokio::sync::watch;
+use tokio_tungstenite::tungstenite::Error as WsError;
+use tokio_tungstenite::tungstenite::Message;
+use tokio_util::sync::CancellationToken;
+
+/// Trusted connection input. Header values and URL queries must not enter diagnostics.
+pub struct RealtimeAdapterContext {
+    pub url: String,
+    pub headers: HeaderMap,
+    pub model: Option<String>,
+    pub cancellation: CancellationToken,
+}
+
+impl std::fmt::Debug for RealtimeAdapterContext {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("RealtimeAdapterContext")
+            .field("header_count", &self.headers.len())
+            .finish_non_exhaustive()
+    }
+}
+
+/// Original application errors stay with the SDK, outside native diagnostics.
+#[derive(Clone, Copy, Debug, thiserror::Error)]
+#[error("Custom Realtime adapter failed")]
+pub struct RealtimeAdapterError;
+
+/// A factory must join cleanup of anything it created before returning an error.
+pub trait RealtimeAdapter: Send + Sync {
+    fn connect(
+        &self,
+        context: RealtimeAdapterContext,
+    ) -> BoxFuture<'_, Result<Arc<dyn RealtimeAdapterConnection>, RealtimeAdapterError>>;
+}
+
+/// One physical/model connection carrying canonical Realtime V2 JSON frames.
+/// Send completes after physical handoff, not configuration acceptance. Receive
+/// runs independently of send. Close must be idempotent and cancel pending I/O.
+pub trait RealtimeAdapterConnection: Send + Sync {
+    fn send(&self, frame: String) -> BoxFuture<'_, Result<(), RealtimeAdapterError>>;
+    fn receive(&self) -> BoxFuture<'_, Result<Option<String>, RealtimeAdapterError>>;
+    fn close(&self) -> BoxFuture<'_, Result<(), RealtimeAdapterError>>;
+}
+
+type CloseResult = Shared<BoxFuture<'static, Result<(), RealtimeAdapterError>>>;
+
+struct Cleanup {
+    connection: Arc<dyn RealtimeAdapterConnection>,
+    cancellation: CancellationToken,
+    reader: Mutex<Option<tokio::task::JoinHandle<()>>>,
+    close: Mutex<Option<CloseResult>>,
+}
+
+/// Native cleanup authority retained separately from protocol/publication state.
+/// Implicit callers share the same attempt, including its failure. The SDK
+/// retirement owner explicitly permits a retry after reporting that failure.
+#[derive(Clone)]
+pub struct RealtimeAdapterCleanup(Arc<Cleanup>);
+
+impl RealtimeAdapterCleanup {
+    fn begin_close(&self) -> CloseResult {
+        self.0.cancellation.cancel();
+        let mut pending = self.0.close.lock().expect("adapter cleanup poisoned");
+        if let Some(close) = pending.as_ref() {
+            return close.clone();
+        }
+        let owner = Arc::clone(&self.0);
+        let task = tokio::spawn(async move {
+            let result = owner.connection.close().await;
+            let reader = owner.reader.lock().expect("adapter reader poisoned").take();
+            if let Some(reader) = reader {
+                let _ = reader.await;
+            }
+            result
+        });
+        let close = async move { task.await.unwrap_or(Err(RealtimeAdapterError)) }
+            .boxed()
+            .shared();
+        *pending = Some(close.clone());
+        close
+    }
+
+    /// Called only when the owning SDK retirement creates an explicit retry.
+    pub fn retry_failed_close(&self) {
+        let mut pending = self.0.close.lock().expect("adapter cleanup poisoned");
+        if pending
+            .as_ref()
+            .is_some_and(|close| matches!(close.peek(), Some(Err(_))))
+        {
+            *pending = None;
+        }
+    }
+
+    pub async fn close(&self) -> Result<(), RealtimeAdapterError> {
+        self.begin_close().await
+    }
+}
+
+struct Frame {
+    text: String,
+    _permit: tokio::sync::OwnedSemaphorePermit,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum ReaderState {
+    Open,
+    Eof,
+    Failed,
+}
+
+/// The native protocol pump deliberately does not observe staged ingress until
+/// its physical write completes. This preserves configuration and tool-output
+/// publication order while the independent reader continues polling the adapter.
+pub(super) struct AdapterIo {
+    connection: Arc<dyn RealtimeAdapterConnection>,
+    cleanup: RealtimeAdapterCleanup,
+    incoming: mpsc::Receiver<Frame>,
+    reader_state: watch::Receiver<ReaderState>,
+    pending: Option<BoxFuture<'static, Result<(), WsError>>>,
+    terminal: bool,
+}
+
+fn io_error() -> WsError {
+    WsError::Io(std::io::Error::other("Custom Realtime adapter failed"))
+}
+
+impl AdapterIo {
+    pub(super) fn new(
+        connection: Arc<dyn RealtimeAdapterConnection>,
+        cancellation: CancellationToken,
+    ) -> Self {
+        let (tx, incoming) = mpsc::channel(super::methods::SDK_WIRE_EVENTS_CAPACITY);
+        let budget = Arc::new(tokio::sync::Semaphore::new(
+            super::methods::SDK_WIRE_BYTES_CAPACITY,
+        ));
+        let (reader_signal, reader_state) = watch::channel(ReaderState::Open);
+        let cleanup = RealtimeAdapterCleanup(Arc::new(Cleanup {
+            connection: Arc::clone(&connection),
+            cancellation: cancellation.clone(),
+            reader: Mutex::new(None),
+            close: Mutex::new(None),
+        }));
+        let reader_connection = Arc::clone(&connection);
+        let reader = tokio::spawn(async move {
+            loop {
+                let next = tokio::select! {
+                    biased;
+                    _ = cancellation.cancelled() => break,
+                    next = reader_connection.receive() => next,
+                };
+                let text = match next {
+                    Ok(Some(text)) => text,
+                    Ok(None) => {
+                        reader_signal.send_replace(ReaderState::Eof);
+                        break;
+                    }
+                    Err(_) => {
+                        reader_signal.send_replace(ReaderState::Failed);
+                        break;
+                    }
+                };
+                let permit = u32::try_from(text.len())
+                    .ok()
+                    .and_then(|bytes| Arc::clone(&budget).try_acquire_many_owned(bytes).ok());
+                let Some(permit) = permit else {
+                    reader_signal.send_replace(ReaderState::Failed);
+                    break;
+                };
+                if tx
+                    .try_send(Frame {
+                        text,
+                        _permit: permit,
+                    })
+                    .is_err()
+                {
+                    reader_signal.send_replace(ReaderState::Failed);
+                    break;
+                }
+            }
+        });
+        *cleanup.0.reader.lock().expect("adapter reader poisoned") = Some(reader);
+        Self {
+            connection,
+            cleanup,
+            incoming,
+            reader_state,
+            pending: None,
+            terminal: false,
+        }
+    }
+
+    pub(super) fn cleanup(&self) -> RealtimeAdapterCleanup {
+        self.cleanup.clone()
+    }
+
+    fn fail(&mut self) -> WsError {
+        self.terminal = true;
+        self.incoming.close();
+        while self.incoming.try_recv().is_ok() {}
+        drop(self.cleanup.begin_close());
+        io_error()
+    }
+}
+
+impl Stream for AdapterIo {
+    type Item = Result<Message, WsError>;
+
+    fn poll_next(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        if self.terminal {
+            return Poll::Ready(None);
+        }
+        let failed = *self.reader_state.borrow() == ReaderState::Failed;
+        if failed {
+            let error = self.fail();
+            return Poll::Ready(Some(Err(error)));
+        }
+        match self.incoming.poll_recv(cx) {
+            Poll::Ready(Some(frame)) => Poll::Ready(Some(Ok(Message::Text(frame.text.into())))),
+            Poll::Ready(None) => Poll::Ready(None),
+            Poll::Pending => Poll::Pending,
+        }
+    }
+}
+
+impl Sink<Message> for AdapterIo {
+    type Error = WsError;
+
+    fn poll_ready(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        self.poll_flush(cx)
+    }
+
+    fn start_send(mut self: Pin<&mut Self>, message: Message) -> Result<(), Self::Error> {
+        if self.terminal || self.pending.is_some() {
+            return Err(self.fail());
+        }
+        let Message::Text(frame) = message else {
+            return Err(self.fail());
+        };
+        if frame.len() > super::methods::SDK_WIRE_BYTES_CAPACITY {
+            return Err(self.fail());
+        }
+        let connection = Arc::clone(&self.connection);
+        let cancellation = self.cleanup.0.cancellation.clone();
+        let mut reader_state = self.reader_state.clone();
+        self.pending = Some(
+            async move {
+                if *reader_state.borrow() != ReaderState::Open {
+                    return Err(io_error());
+                }
+                tokio::select! {
+                    biased;
+                    _ = cancellation.cancelled() => Err(io_error()),
+                    _ = reader_state.changed() => Err(io_error()),
+                    result = connection.send(frame.to_string()) => result.map_err(|_| io_error()),
+                }
+            }
+            .boxed(),
+        );
+        Ok(())
+    }
+
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        if self.terminal {
+            return Poll::Ready(Err(io_error()));
+        }
+        let Some(pending) = self.pending.as_mut() else {
+            return Poll::Ready(Ok(()));
+        };
+        match pending.as_mut().poll(cx) {
+            Poll::Ready(Ok(())) => {
+                self.pending = None;
+                Poll::Ready(Ok(()))
+            }
+            Poll::Ready(Err(_)) => {
+                self.pending = None;
+                Poll::Ready(Err(self.fail()))
+            }
+            Poll::Pending => Poll::Pending,
+        }
+    }
+
+    fn poll_close(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        self.poll_flush(cx)
+    }
+}
+
+impl Drop for AdapterIo {
+    fn drop(&mut self) {
+        drop(self.cleanup.begin_close());
+    }
+}
+
+#[cfg(test)]
+mod cleanup_retry_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    struct Connection(AtomicUsize);
+    impl RealtimeAdapterConnection for Connection {
+        fn send(&self, _: String) -> BoxFuture<'_, Result<(), RealtimeAdapterError>> {
+            Box::pin(async { Ok(()) })
+        }
+        fn receive(&self) -> BoxFuture<'_, Result<Option<String>, RealtimeAdapterError>> {
+            Box::pin(std::future::pending())
+        }
+        fn close(&self) -> BoxFuture<'_, Result<(), RealtimeAdapterError>> {
+            Box::pin(async move {
+                if self.0.fetch_add(1, Ordering::SeqCst) == 0 {
+                    Err(RealtimeAdapterError)
+                } else {
+                    Ok(())
+                }
+            })
+        }
+    }
+
+    #[tokio::test]
+    async fn drop_and_implicit_cleanup_preserve_failure_until_explicit_retry() {
+        let connection = Arc::new(Connection(AtomicUsize::new(0)));
+        let io = AdapterIo::new(connection.clone(), CancellationToken::new());
+        let cleanup = io.cleanup();
+        drop(io);
+        assert!(cleanup.close().await.is_err());
+        drop(cleanup.begin_close());
+        assert!(cleanup.close().await.is_err());
+        assert_eq!(connection.0.load(Ordering::SeqCst), 1);
+        cleanup.retry_failed_close();
+        assert!(cleanup.close().await.is_ok());
+        assert!(cleanup.close().await.is_ok());
+        assert_eq!(connection.0.load(Ordering::SeqCst), 2);
+    }
+}
