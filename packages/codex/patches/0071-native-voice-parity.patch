+            || matches!(tool.name.as_str(), "background_agent" | "remain_silent")
+            || !names.insert(tool.name.as_str())
+            || !tool.parameters.is_object()
+        {
+            return Err(serde::ser::Error::custom(
+                "Invalid SDK Realtime function subset",
+            ));
+        }
+        let mut value = serde_json::to_value(tool)?;
+        value["type"] = Value::String("function".into());
+        tools.push(value);
+    }
+    Ok(Value::Array(tools))
+}
+
+pub(super) fn tools_json(
+    functions: &[RealtimeFunctionTool],
+    hosted: &[RealtimeHostedMcpTool],
+) -> serde_json::Result<Value> {
+    let Value::Array(mut tools) = function_tools_json(functions)? else {
