+    drop(first);
+    input_release.send(()).unwrap();
+    assert!(futures::poll!(second.as_mut()).is_pending());
+    fanout_release.send(()).unwrap();
+    assert!(
+        !tokio::time::timeout(std::time::Duration::from_secs(2), second)
+            .await
+            .unwrap()
+            .unwrap()
+    );
+    assert!(
+        manager
+            .state
+            .lock()
+            .await
+            .ensure_start_available(true)
+            .is_ok()
+    );
+}
