+#[test]
+fn legacy_history_is_dormant_until_sdk_start_then_finishes_canonical_transcript() {
+    let mut state = RealtimeHistoryState::sdk_only();
+    let started = EventMsg::RealtimeConversationStarted(RealtimeConversationStartedEvent {
+        realtime_session_id: Some("sdk-legacy".to_string()),
+        version: RealtimeConversationVersion::V2,
+    });
+    assert!(!state.should_observe(&started));
+    assert!(state.observe(&started).items.is_empty());
+    state.enable_sdk();
+    assert!(state.should_observe(&started));
+    assert_eq!(state.observe(&started).items.len(), 1);
+    let delta = observe_realtime(
+        &mut state,
+        RealtimeEvent::OutputTranscriptDelta(RealtimeTranscriptDelta {
+            output_guard: Default::default(),
+            response_id: Some("response".into()),
+            item_id: Some("item".into()),
+            content_index: Some(0),
+            output_index: Some(0),
+            output_kind: None,
+            profile_receipt: None,
+            delta: "canonical answer".into(),
+        }),
+    );
+    assert!(delta.transcript_stream.unwrap().started_item.is_some());
+    let done = observe_realtime(
+        &mut state,
+        RealtimeEvent::OutputTranscriptDone(RealtimeTranscriptDone {
+            output_guard: Default::default(),
+            response_id: Some("response".into()),
+            item_id: Some("item".into()),
+            content_index: Some(0),
+            output_index: Some(0),
+            output_kind: None,
+            profile_receipt: None,
+            text: "canonical answer".into(),
+        }),
+    );
+    assert_eq!(done.items.len(), 1);
+    assert!(
+        matches!(&done.items[0].content, RealtimeItemContent::TranscriptSegment { text, .. } if text == "canonical answer")
+    );
+}
