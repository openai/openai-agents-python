+fn assert_prepared_processes_reaped(log: &Path) -> anyhow::Result<Vec<String>> {
+    let mut pending = Vec::new();
+    for entry in std::fs::read_dir(log)? {
+        let events = std::fs::read_to_string(entry?.path())?
+            .lines()
+            .map(serde_json::from_str::<serde_json::Value>)
+            .collect::<Result<Vec<_>, _>>()?;
+        let start = events
+            .iter()
+            .find(|event| event["event"] == "start")
+            .expect("started child");
+        let pid = start["pid"].as_u64().expect("pid");
+        assert!(
+            !std::process::Command::new("kill")
+                .args(["-0", &pid.to_string()])
+                .output()?
+                .status
+                .success()
+        );
+        for event in events.iter().filter(|event| event["event"] == "pending") {
+            pending.push(event["label"].as_str().unwrap().to_owned());
+        }
+    }
+    pending.sort();
+    Ok(pending)
+}
