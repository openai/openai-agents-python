+pub(crate) async fn dispatch_update_sdk(
+    sess: &Arc<Session>,
+    generation: String,
+    update: RealtimeSessionUpdate,
+    profile: Option<codex_protocol::realtime_settings::RealtimeToolProfileUpdate>,
+    reply: tokio::sync::oneshot::Sender<CodexResult<()>>,
+) {
+    let mut reply = SdkUpdateReply(Some(reply));
+    let Some(request) = profile else {
+        let _ = sess
+            .conversation
+            .sdk_enqueue(
+                &generation,
+                SdkRealtimeCommand::OwnedUpdate {
+                    update,
+                    profile: None,
+                    reply,
+                },
+            )
+            .await;
+        return;
+    };
+    let Some(preparation) = sess
+        .conversation
+        .preparation(&generation)
+        .await
+        .filter(|preparation| !preparation.stop.is_cancelled())
+    else {
+        reply.finish(Err(CodexErr::InvalidRequest(
+            "SDK Realtime generation is not ready for profile refresh".into(),
+        )));
+        return;
+    };
+    let draft = match tool_task::capture_realtime_source_draft(sess).await {
+        Ok(draft) => draft,
+        Err(error) => {
+            reply.finish(Err(error));
+            return;
+        }
+    };
+    if draft.inputs.profile().map(|profile| &profile.receipt) != request.target.as_ref() {
+        reply.finish(Err(CodexErr::InvalidRequest(
+            "Realtime target is no longer the authoritative native profile".into(),
+        )));
+        return;
+    }
+    if let Err(error) = draft.validate_selection_identity(
+        request.function_tools.as_deref(),
+        request.expected_selection_id.as_deref(),
+    ) {
+        reply.finish(Err(error));
+        return;
+    }
+    let state = sess.conversation.state.lock().await;
+    if !state
+        .conversation
+        .as_ref()
+        .and_then(|state| state.handoff.sdk.as_ref())
+        .is_some_and(|sdk| sdk.generation == generation && sdk.active.load(Ordering::Acquire))
+        || preparation.stop.is_cancelled()
+    {
+        reply.finish(Err(CodexErr::TurnAborted));
+        return;
+    }
+    let mut slot = preparation.update_worker.lock().unwrap();
+    if slot
+        .as_ref()
+        .is_some_and(|worker| worker.clone().now_or_never().is_none())
+    {
+        reply.finish(Err(CodexErr::InvalidRequest(
+            "Realtime profile refresh is already preparing".into(),
+        )));
+        return;
+    }
+    let session = Arc::clone(sess);
+    let stop = preparation.stop.clone();
+    let task=tokio::spawn(async move {
+        let source=tokio::select! {biased;_=stop.cancelled()=>Err(CodexErr::TurnAborted),source=tool_task::finish_realtime_native_source(&session,draft)=>source};
+        match source {
+            Ok(source)=>{let _=session.conversation.sdk_enqueue(&generation,SdkRealtimeCommand::OwnedUpdate {update,profile:Some(SdkProfileUpdate {request,source}),reply}).await;}
+            Err(error)=>reply.finish(Err(error)),
+        }
+    }.instrument(tracing::Span::current()));
+    *slot = Some(
+        async move {
+            task.await
+                .map_err(|_| "Realtime profile preparation failed".into())
+        }
+        .boxed()
+        .shared(),
+    );
+}
