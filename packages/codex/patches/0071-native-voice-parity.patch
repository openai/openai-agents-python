+                serde_json::json!({"instructions": "Target B", "function_tools": []})
+            };
+            manager
+                .sdk_enqueue(
+                    "pending-media",
+                    super::SdkRealtimeCommand::Update(serde_json::from_value(update).unwrap()),
+                )
+                .await
+                .unwrap();
+            let command = sdk.commands_rx.recv().await;
+            let writer = connection.writer();
+            let stop = tokio_util::sync::CancellationToken::new();
+            let input_stop = stop.clone();
+            let handling = tokio::spawn(async move {
+                let (events, _events_rx) = async_channel::bounded(8);
+                let mut responses = super::RealtimeResponseCreateQueue::default();
+                super::handle_sdk_realtime_command_with_audio(
+                    command,
+                    &writer,
+                    &handoff,
+                    &mut responses,
+                    &events,
+                    &audio_rx,
+                    &input_stop,
+                )
+                .await
+            });
+            // Audio admitted before reservation reaches the old format first.
+            let prior = wire.recv().await.unwrap();
+            assert_eq!(prior["type"], "input_audio_buffer.append");
+            assert_eq!(prior["audio"], "AAA=");
+            assert_eq!(wire.recv().await.unwrap()["type"], "session.update");
+            assert!(!handling.is_finished());
+            assert!(
+                connection
+                    .writer()
+                    .configuration()
+                    .unwrap()
+                    .accepted()
+                    .is_err()
+            );
+            let mut next = pcm.clone();
+            next.data = "AQI=".into();
+            assert!(
+                manager
+                    .sdk_enqueue("stale", super::SdkRealtimeCommand::Audio(next.clone()))
+                    .await
+                    .is_err()
+            );
+            let admitted = manager
+                .sdk_enqueue("pending-media", super::SdkRealtimeCommand::Audio(next))
+                .await;
+            if media_change {
+                assert!(admitted.is_err());
+                assert!(
+                    tokio::time::timeout(std::time::Duration::from_millis(30), wire.recv())
+                        .await
+                        .is_err()
+                );
+            } else {
+                admitted.unwrap();
+                let frame = wire.recv().await.unwrap();
+                assert_eq!(frame["type"], "input_audio_buffer.append");
+                assert_eq!(frame["audio"], "AQI=");
+                assert!(!handling.is_finished());
+            }
+            control.send(SdkWireControl::Acknowledge).unwrap();
+            assert!(handling.await.unwrap().is_ok());
+            manager.shutdown_sdk("pending-media").await.unwrap();
+            assert!(
+                manager
+                    .sdk_enqueue("pending-media", super::SdkRealtimeCommand::Audio(pcm))
+                    .await
+                    .is_err()
+            );
+            connection.close().await.unwrap();
+            server.await.unwrap();
+        }
+    })
+    .await
+    .unwrap();
+}
