+#[tokio::test]
+async fn explicit_realtime_call_and_hangup_keep_one_bearer_without_backend_auth() {
+    for invalid_answer in [false, true] {
+        let server = MockServer::start().await;
+        let body = if invalid_answer {
+            vec![0xff]
+        } else {
+            b"v=answer\r\n".to_vec()
+        };
+        Mock::given(method("POST"))
+            .and(path("/v1/realtime/calls"))
+            .respond_with(
+                ResponseTemplate::new(201)
+                    .insert_header("location", "/v1/realtime/calls/rtc_explicit")
+                    .set_body_bytes(body),
+            )
+            .expect(1)
+            .mount(&server)
+            .await;
+        Mock::given(method("POST"))
+            .and(path("/v1/realtime/calls/rtc_explicit/hangup"))
+            .respond_with(ResponseTemplate::new(200))
+            .expect(1)
+            .mount(&server)
+            .await;
+        let (client, attestation_calls) = model_client_with_counting_attestation(true);
+        let provider =
+            ModelProviderInfo::create_openai_provider(Some(format!("{}/v1", server.uri())))
+                .to_api_provider(None)
+                .unwrap();
+        let auth = super::RealtimeConnectionAuth::from_bearer(
+            http::HeaderValue::from_static("Bearer explicit-realtime-secret"),
+            HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        );
+        let config = codex_api::RealtimeSessionConfig {
+            function_tools: Vec::new(),
+            v2: None,
+            instructions: "Help with the conversation".into(),
+            initial_items: Vec::new(),
+            delegation_ack_filler: None,
+            model: Some("fixture-realtime".into()),
+            session_id: None,
+            event_parser: codex_api::RealtimeEventParser::RealtimeV2,
+            session_mode: codex_api::RealtimeSessionMode::Conversational,
+            output_modality: codex_protocol::protocol::RealtimeOutputModality::Audio,
+            voice: codex_protocol::protocol::RealtimeVoice::Marin,
+        };
+        let created = client
+            .create_sdk_realtime_call_with_connection_auth(
+                "v=offer\r\n".into(),
+                config,
+                http::HeaderMap::new(),
+                provider,
+                auth,
+            )
+            .await
+            .unwrap();
+        assert_eq!(created.lease.call_id, "rtc_explicit");
+        assert_eq!(created.sdp.is_err(), invalid_answer);
+        assert_eq!(
+            created.sideband_headers[http::header::AUTHORIZATION],
+            "Bearer explicit-realtime-secret"
+        );
+        created.lease.hangup().await.unwrap();
+        let requests = server.received_requests().await.unwrap();
+        assert_eq!(requests.len(), 2);
+        for request in requests {
+            assert_eq!(
+                request.headers[http::header::AUTHORIZATION],
+                "Bearer explicit-realtime-secret"
