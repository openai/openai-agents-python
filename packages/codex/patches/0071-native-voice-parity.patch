+#[tokio::test]
+async fn sdk_terminal_function_rollover_preserves_payload_response_and_kind_identity() {
+    use codex_protocol::protocol::{RealtimeEvent, RealtimeFunctionCallRequested};
+    let (connection, _, server) = sdk_wire_connection().await;
+    let (manager, sdk) = sdk_manager("function-rollover");
+    let handoff = manager
+        .state
+        .lock()
+        .await
+        .conversation
+        .as_ref()
+        .unwrap()
+        .handoff
+        .clone();
+    let (tx, rx) = bounded(2);
+    let mut audio = None;
+    let mut responses = super::RealtimeResponseCreateQueue::default();
+    let first = RealtimeFunctionCallRequested {
+        namespace: None,
+        call_id: "terminal-function-0".into(),
+        item_id: "item-0".into(),
+        name: "function".into(),
+        arguments: "{}".into(),
+        response_id: Some("response-0".into()),
+    };
+    for index in 0..super::SDK_FUNCTION_CALL_LIMIT + 4 {
+        let request = RealtimeFunctionCallRequested {
+            call_id: format!("terminal-function-{index}"),
+            item_id: format!("item-{index}"),
+            response_id: Some(format!("response-{index}")),
+            ..first.clone()
+        };
+        super::handle_realtime_server_event(
+            RealtimeEvent::FunctionCallRequested(request.clone()),
+            &connection.writer(),
+            &tx,
+            &handoff,
+            RealtimeSessionKind::V2,
+            &mut audio,
+            &mut responses,
+        )
+        .await
+        .unwrap();
+        assert!(matches!(
+            rx.try_recv().unwrap(),
+            RealtimeEvent::FunctionCallRequested(_)
+        ));
+        // Model terminal native publication and physical callback settlement independently.
+        let mut calls = sdk.function_calls.lock().await;
+        let call = calls.get_mut(&request.call_id).unwrap();
+        call.claimed = true;
+        call.completed.cancel();
+        drop(calls);
+        sdk.pending.lock().await.remove(&request.call_id);
+        sdk.seen
+            .lock()
+            .await
+            .get_mut(&request.call_id)
+            .unwrap()
+            .output_published = true;
+        assert!(sdk.function_calls.lock().await.len() <= super::SDK_FUNCTION_CALL_LIMIT);
+    }
+    assert!(!sdk.function_calls.lock().await.contains_key(&first.call_id));
+    super::handle_realtime_server_event(
+        RealtimeEvent::FunctionCallRequested(first.clone()),
+        &connection.writer(),
+        &tx,
+        &handoff,
+        RealtimeSessionKind::V2,
+        &mut audio,
+        &mut responses,
+    )
+    .await
+    .unwrap();
+    assert!(
+        rx.is_empty(),
+        "reclaimed terminal payload must not dispatch twice"
+    );
+    for changed in [
+        RealtimeFunctionCallRequested {
+            arguments: "{\"changed\":true}".into(),
+            ..first.clone()
+        },
+        RealtimeFunctionCallRequested {
+            response_id: Some("different-response".into()),
+            ..first.clone()
+        },
+    ] {
+        assert!(
+            super::handle_realtime_server_event(
+                RealtimeEvent::FunctionCallRequested(changed),
+                &connection.writer(),
+                &tx,
+                &handoff,
+                RealtimeSessionKind::V2,
+                &mut audio,
+                &mut responses,
+            )
+            .await
+            .is_err()
+        );
+    }
+    // A terminal handoff's ID cannot be rebound as a function after heavy-row reclamation.
+    assert!(
+        sdk.register_for_response("old-handoff", Some("old-response"))
+            .await
+            .unwrap()
+    );
+    sdk.pending.lock().await.remove("old-handoff");
+    assert!(
+        super::handle_realtime_server_event(
+            RealtimeEvent::FunctionCallRequested(RealtimeFunctionCallRequested {
+                call_id: "old-handoff".into(),
+                response_id: Some("old-response".into()),
+                ..first
+            }),
+            &connection.writer(),
+            &tx,
+            &handoff,
+            RealtimeSessionKind::V2,
+            &mut audio,
+            &mut responses,
+        )
+        .await
+        .is_err()
+    );
+    assert!(rx.is_empty());
+    server.abort();
+}
