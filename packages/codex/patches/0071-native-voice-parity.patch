+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    async fn early_close_fences_a_late_prepare_without_blocking_a_fresh_generation() {
+        let manager = RealtimeConversationManager::new();
+        assert!(!manager.shutdown_sdk("late-generation").await.unwrap());
+        assert!(manager.reserve_sdk_start("late-generation").await.is_err());
+        manager.reserve_sdk_start("fresh-generation").await.unwrap();
+        assert!(manager.shutdown_sdk("fresh-generation").await.unwrap());
+        manager.reserve_sdk_start("next-generation").await.unwrap();
+        manager.shutdown_sdk("next-generation").await.unwrap();
+    }
+    #[tokio::test]
+    async fn close_cancels_and_joins_the_existing_prepared_owner() {
+        let manager = RealtimeConversationManager::new();
+        let preparation = manager.reserve_sdk_start("preparing").await.unwrap();
+        let completed = Arc::new(AtomicBool::new(false));
+        let finished = Arc::clone(&completed);
+        let stop = preparation.stop.clone();
+        let task = tokio::spawn(async move {
+            stop.cancelled().await;
+            tokio::task::yield_now().await;
+            finished.store(true, Ordering::Release);
+        });
+        assert!(
+            preparation
+                .worker
+                .set(
+                    async move { task.await.map_err(|_| "worker failed".into()) }
+                        .boxed()
+                        .shared()
+                )
+                .is_ok()
+        );
+        manager.shutdown_sdk("preparing").await.unwrap();
+        assert!(completed.load(Ordering::Acquire));
+        assert!(!manager.shutdown_sdk("preparing").await.unwrap());
+    }
+    #[tokio::test]
+    async fn startup_error_keeps_its_primary_classification_when_cleanup_also_fails() {
+        let preparation = SdkStartPreparation::new();
+        let (reply, receipt) = tokio::sync::oneshot::channel();
+        *preparation.reply.lock().unwrap() = Some(reply);
+        *preparation.failure.lock().unwrap() = Some(CodexErr::InvalidRequest(
+            "primary provider rejection".into(),
+        ));
+        preparation.finish_failure(true);
+        let error = receipt.await.unwrap().unwrap_err();
+        assert!(matches!(
+            error.details(),
+            codex_protocol::error::CodexErrorDetails::InvalidRequest(message)
+                if message == "primary provider rejection"
+        ));
+    }
+    #[test]
+    fn credential_debug_never_contains_the_key() {
+        let key = RealtimeConversationApiKey::new("private-voice-credential".into());
+        assert!(!format!("{key:?}").contains("private-voice-credential"));
+    }
+}
