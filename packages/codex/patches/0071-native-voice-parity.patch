@@ -0,0 +1,1788 @@
+//! Atomic, host-admitted Agent selection at actual sampling boundaries.
+
+use super::session::Session;
+use super::step_activation::check_legacy_turn_safety;
+use super::step_settings::ResolvedStepSettings;
+use super::turn_context::TurnContext;
+use codex_async_utils::OrCancelExt;
+use codex_extension_api::{
+    AgentProfile, AgentProfileBoundaryInput, AgentProfileModelSettings, AgentProfileReceipt,
+    CapturedAgentProfile,
+};
+use codex_history::{ResponseItemEnvelope, RolloutItem};
+use codex_protocol::error::{CodexErr, Result as CodexResult};
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::{EventMsg, ThreadSettingsAppliedEvent};
+use serde::{Deserialize, Serialize};
+use std::sync::Arc;
+use tokio::sync::Notify;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PersistedProfile {
+    profile_id: String,
+    epoch: u64,
+    model: AgentProfileModelSettings,
+}
+
+struct TaskFence {
+    context: Arc<TurnContext>,
+    done: Arc<Notify>,
+    cancellation: CancellationToken,
+}
+
+fn invalid(message: impl Into<String>) -> CodexErr {
+    CodexErr::InvalidRequest(message.into())
+}
+
+fn persistence_failure() -> CodexErr {
+    CodexErr::Fatal(
+        "Canonical Agent profile persistence failed; execution stopped pending recovery"
+            .to_string(),
+    )
+}
+
+fn validate_envelope(profile: &AgentProfile) -> CodexResult<()> {
+    if profile.profile_id.is_empty() || profile.model.model.is_empty() {
+        return Err(invalid(
+            "Agent profile and model identities must be nonempty",
+        ));
+    }
+    match &profile.application_instructions.item {
+        ResponseItem::Message {
+            id: Some(_), role, ..
+        } if role == "developer" => Ok(()),
+        _ => Err(invalid(
+            "Agent activation requires an annotated developer instruction envelope",
+        )),
+    }
+}
+
+fn persisted_profile(
+    items: &[RolloutItem],
+) -> CodexResult<Option<(&ResponseItemEnvelope, PersistedProfile)>> {
+    let mut latest = None;
+    for item in items {
+        let RolloutItem::ResponseItem(envelope) = item else {
+            continue;
+        };
+        let Some(value) = envelope
+            .metadata
+            .as_ref()
+            .and_then(|metadata| metadata.sdk_agent_profile.as_ref())
+        else {
+            continue;
+        };
+        let record: PersistedProfile = serde_json::from_value(value.clone())
+            .map_err(|_| invalid("Invalid persisted Agent profile receipt"))?;
+        if record.profile_id.is_empty() || record.model.model.is_empty() {
+            return Err(invalid("Invalid persisted Agent profile identity"));
+        }
+        if let Some((_, previous)) = &latest {
+            let previous: &PersistedProfile = previous;
+            if record.epoch
+                != previous
+                    .epoch
+                    .checked_add(1)
+                    .ok_or_else(|| invalid("Agent profile epoch exhausted"))?
+            {
+                return Err(invalid("Inconsistent persisted Agent profile epochs"));
+            }
+        } else if record.epoch != 0 {
+            return Err(invalid("Persisted Agent profile has no initial receipt"));
+        }
+        latest = Some((envelope, record));
+    }
+    Ok(latest)
+}
+
+impl Session {
+    fn revoke_agent_profile_admission(&self) {
+        self.services.local_agent_runtime.request_shutdown();
+        for contributor in self.services.extensions.thread_lifecycle_contributors() {
+            contributor.on_thread_execution_revoked(&self.services.thread_extension_data);
+        }
+    }
+
+    /// Synchronous revocation covers cached contexts and queued native roots as well as getters.
+    pub(crate) fn check_agent_profile_admission(&self) -> CodexResult<()> {
+        if self.services.local_agent_runtime.shutdown.is_cancelled() {
+            return Err(CodexErr::TurnAborted);
+        }
+        Ok(())
+    }
+
+    pub(crate) async fn captured_agent_profile(
+        &self,
+    ) -> CodexResult<Option<Arc<CapturedAgentProfile>>> {
+        self.check_agent_profile_admission()?;
+        let state = self.state.lock().await;
+        self.check_agent_profile_admission()?;
+        Ok(state.session_configuration.agent_profile.clone())
+    }
+
+    pub(crate) async fn agent_profile_receipt(&self) -> CodexResult<Option<AgentProfileReceipt>> {
+        Ok(self
+            .captured_agent_profile()
+            .await?
+            .map(|profile| profile.receipt.clone()))
+    }
+
+    /// Called by the in-process binding under its existing idle mutation owner.
+    pub(crate) async fn activate_agent_profile(
+        &self,
+        expected: Option<AgentProfileReceipt>,
+        target: Arc<AgentProfile>,
+    ) -> CodexResult<AgentProfileReceipt> {
+        self.check_agent_profile_admission()?;
+        validate_envelope(&target)?;
+        {
+            let active = self.active_turn.lock().await;
+            if active.is_some() {
+                return Err(invalid("Agent updates require an idle native Session"));
+            }
+        }
+        // This recording context performs no sampling or tool capture.
+        let context = self.new_inject_items_context().await;
+        let current = context.next_step_settings.load_full();
+        self.commit_agent_profile(None, context, current, expected, target)
+            .await
+    }
+
+    /// A real sampling/tools-only boundary consumes the accepted first handoff.
+    pub(crate) async fn activate_agent_at_tool_boundary(
+        &self,
+        context: &Arc<TurnContext>,
+        cancellation: &CancellationToken,
+        accepted_handoff: Option<&codex_protocol::agent_profile::AgentProfileHandoff>,
+    ) -> CodexResult<Option<AgentProfileReceipt>> {
+        self.check_agent_profile_admission()?;
+        let (fence, current) = {
+            let active = self.active_turn.lock().or_cancel(cancellation).await?;
+            let task = active
+                .as_ref()
+                .and_then(|active| active.task.as_ref())
+                .filter(|task| {
+                    Arc::ptr_eq(&task.turn_context, context)
+                        && !task.cancellation_token.is_cancelled()
+                })
+                .ok_or(CodexErr::TurnAborted)?;
+            (
+                TaskFence {
+                    context: Arc::clone(context),
+                    done: Arc::clone(&task.done),
+                    cancellation: cancellation.clone(),
+                },
+                context.next_step_settings.load_full(),
+            )
+        };
+        let receipt = current
+            .agent_profile
+            .as_ref()
+            .map(|profile| &profile.receipt);
+        if accepted_handoff.is_some_and(|handoff| Some(&handoff.source) != receipt) {
+            return Err(invalid(
+                "Accepted handoff belongs to another native profile source",
+            ));
+        }
+        let mut candidate = None;
+        for contributor in self.services.extensions.turn_lifecycle_contributors() {
+            let activation = contributor
+                .before_step_agent_activation(AgentProfileBoundaryInput {
+                    accepted_handoff,
+                    turn_id: &context.sub_id,
+                    active: receipt,
+                    session_store: &self.services.session_extension_data,
+                    thread_store: &self.services.thread_extension_data,
+                    turn_store: &context.extension_data,
+                })
+                .or_cancel(cancellation)
+                .await?
+                .map_err(invalid)?;
+            if let Some(activation) = activation {
+                if candidate.replace(activation).is_some() {
+                    return Err(invalid(
+                        "Multiple Agent activation contributors requested a transition",
+                    ));
+                }
+            }
+        }
+        let Some(candidate) = candidate else {
+            return Ok(None);
+        };
+        let receipt = self
+            .commit_agent_profile(
+                Some(fence),
+                Arc::clone(context),
+                current,
+                Some(candidate.expected),
+                candidate.target,
+            )
+            .await?;
+        Ok(Some(receipt))
+    }
+
+    async fn commit_agent_profile(
+        &self,
+        task_fence: Option<TaskFence>,
+        context: Arc<TurnContext>,
+        current: Arc<ResolvedStepSettings>,
+        expected: Option<AgentProfileReceipt>,
+        target: Arc<AgentProfile>,
+    ) -> CodexResult<AgentProfileReceipt> {
+        validate_envelope(&target)?;
+        let opening = self.state.lock().await.session_configuration.clone();
+        if opening
+            .agent_profile
+            .as_ref()
+            .map(|profile| &profile.receipt)
+            != expected.as_ref()
+        {
+            return Err(invalid("Expired Agent profile activation"));
+        }
+        let mut selected = current.selected().clone();
+        if expected.is_some() {
+            selected.collaboration_mode = selected.collaboration_mode.with_updates(
+                Some(target.model.model.clone()),
+                Some(target.model.reasoning_effort.clone()),
+                None,
+            );
+            selected.reasoning_summary = target.model.reasoning_summary;
+            selected.service_tier = target.model.service_tier.clone();
+            selected.tool_choice = target.model.tool_choice;
+            selected.personality = target.model.personality;
+            selected.request_controls = target.model.request_controls.clone();
+            selected.invocation_timeout_ms = target.model.invocation_timeout_ms;
+        }
+        let model = selected
+            .resolve_model_info(
+                self.services.models_manager.as_ref(),
+                &opening.model_info_overrides,
+            )
+            .await;
+        selected
+            .request_controls
+            .validate_profile(&model)
+            .map_err(invalid)?;
+        let mut destination = ResolvedStepSettings::new(
+            Arc::new(selected),
+            Arc::new(model),
+            self.features.enabled(codex_features::Feature::FastMode),
+            opening.model_info_overrides.context_window,
+        );
+        destination.mcp_approvals_reviewer_override = current.mcp_approvals_reviewer_override;
+        let target = Arc::new(AgentProfile {
+            mcp: Arc::new(
+                target
+                    .mcp
+                    .recapture_with_requirements(&[], &Default::default())
+                    .await
+                    .map_err(|error| invalid(error.to_string()))?,
+            ),
+            ..target.as_ref().clone()
+        });
+        // Preparation above can await; publish only against the exact original task/defaults.
+        let _persistence = super::thread_settings::acquire_persistence_lock(self).await;
+        let active = self.active_turn.lock().await;
+        self.check_agent_profile_admission()?;
+        match &task_fence {
+            Some(fence) => {
+                let task = active
+                    .as_ref()
+                    .and_then(|active| active.task.as_ref())
+                    .ok_or(CodexErr::TurnAborted)?;
+                if !Arc::ptr_eq(&task.done, &fence.done)
+                    || !Arc::ptr_eq(&task.turn_context, &fence.context)
+                    || task.cancellation_token.is_cancelled()
+                    || fence.cancellation.is_cancelled()
+                    || !Arc::ptr_eq(&context.next_step_settings.load_full(), &current)
+                {
+                    return Err(CodexErr::TurnAborted);
+                }
+            }
+            None if active.is_some() => {
+                return Err(invalid("Agent update lost native idle ownership"));
+            }
+            None => {}
+        }
+        let (mut configuration, restored) = {
+            let state = self.state.lock().await;
+            if !Arc::ptr_eq(
+                &state.session_configuration.step_settings,
+                &opening.step_settings,
+            ) || state
+                .session_configuration
+                .agent_profile
+                .as_ref()
+                .map(|profile| &profile.receipt)
+                != expected.as_ref()
+            {
+                return Err(invalid(
+                    "Agent activation source changed during preparation",
+                ));
+            }
+            self.validate_active_step_settings(
+                &context,
+                &destination,
+                &state.session_configuration,
+                &self.services.turn_environments.selections(),
+            )
+            .map_err(|error| invalid(error.to_string()))?;
+            if task_fence.is_some() {
+                check_legacy_turn_safety(
+                    &context,
+                    &current,
+                    &destination,
+                    &state.session_configuration.original_config_do_not_use,
+                )
+                .map_err(invalid)?;
+            }
+            (state.session_configuration.clone(), expected.is_none())
+        };
+        let live = self
+            .live_thread()
+            .ok_or_else(|| invalid("Agent profiles require retained native history"))?;
+        let saved = live
+            .load_history(true)
+            .await
+            .map_err(|_| persistence_failure())?;
+        let previous = persisted_profile(&saved.items)?;
+        if restored {
+            if let Some((envelope, record)) = previous {
+                if record.profile_id != target.profile_id
+                    || record.model != target.model
+                    || envelope.item != target.application_instructions.item
+                    || envelope
+                        .metadata
+                        .as_ref()
+                        .and_then(|metadata| metadata.sdk_instruction_files.as_ref())
+                        != target
+                            .application_instructions
+                            .metadata
+                            .as_ref()
+                            .and_then(|metadata| metadata.sdk_instruction_files.as_ref())
+                {
+                    return Err(invalid(
+                        "Restored Agent profile does not match the admitted model and instructions",
+                    ));
+                }
+                let receipt = AgentProfileReceipt {
+                    profile_id: record.profile_id,
+                    epoch: record.epoch,
+                };
+                let profile = Arc::new(CapturedAgentProfile {
+                    receipt: receipt.clone(),
+                    profile: target,
+                });
+                let latest = saved
+                    .items
+                    .iter()
+                    .rev()
+                    .find_map(|item| match item {
+                        RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event))
+                            if event.thread_id == Some(self.thread_id()) =>
+                        {
+                            Some(&event.thread_settings)
+                        }
+                        _ => None,
+                    })
+                    .ok_or_else(|| invalid("Restored Agent profile has no persisted settings"))?;
+                let effective = configuration.thread_settings_snapshot(&configuration.environments);
+                if latest.model != effective.model
+                    || latest.collaboration_mode != effective.collaboration_mode
+                    || latest.reasoning_effort != effective.reasoning_effort
+                    || latest.reasoning_summary != effective.reasoning_summary
+                    || latest.service_tier != effective.service_tier
+                    || latest.tool_choice != effective.tool_choice
+                    || latest.personality != effective.personality
+                    || latest.request_controls != effective.request_controls
+                    || latest.invocation_timeout_ms != effective.invocation_timeout_ms
+                {
+                    return Err(invalid(
+                        "Restored Agent effective settings differ from canonical history",
+                    ));
+                }
+                // Core already restored the effective settings, including explicit idle overrides.
+                let mut state = self.state.lock().await;
+                state.session_configuration.agent_profile = Some(profile);
+                return Ok(receipt);
+            }
+        } else if previous
+            .as_ref()
+            .map(|(_, record)| (&record.profile_id, record.epoch))
+            != expected
+                .as_ref()
+                .map(|receipt| (&receipt.profile_id, receipt.epoch))
+        {
+            return Err(invalid(
+                "Native history and Agent activation receipt disagree",
+            ));
+        }
+        let epoch = expected
+            .as_ref()
+            .map_or(Some(0), |receipt| receipt.epoch.checked_add(1))
+            .ok_or_else(|| invalid("Agent profile epoch exhausted"))?;
+        let receipt = AgentProfileReceipt {
+            profile_id: target.profile_id.clone(),
+            epoch,
+        };
+        let mut envelope = target.application_instructions.clone();
+        if saved.items.iter().any(|item| matches!(item, RolloutItem::ResponseItem(prior) if prior.item.id() == envelope.item.id())) {
+            return Err(invalid("Agent activation requires a fresh instruction publication identity"));
+        }
+        envelope.metadata.get_or_insert_default().sdk_agent_profile = Some(
+            serde_json::to_value(PersistedProfile {
+                profile_id: receipt.profile_id.clone(),
+                epoch,
+                model: target.model.clone(),
+            })
+            .map_err(|error| invalid(error.to_string()))?,
+        );
+        let profile = Arc::new(CapturedAgentProfile {
+            receipt: receipt.clone(),
+            profile: target,
+        });
+        destination.agent_profile = Some(Arc::clone(&profile));
+        configuration.agent_profile = Some(profile);
+        configuration.step_settings = Arc::new(destination.selected().clone());
+        let settings = configuration.thread_settings_snapshot(&configuration.environments);
+        let batch = [
+            RolloutItem::ResponseItem(envelope.clone()),
+            RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(
+                ThreadSettingsAppliedEvent {
+                    thread_id: Some(self.thread_id()),
+                    thread_settings: settings,
+                },
+            )),
+        ];
+        // Canonical history loading above can await after the first task check.
+        // A scoped batch can stop while its sibling keeps the root task alive.
+        if task_fence
+            .as_ref()
+            .is_some_and(|fence| fence.cancellation.is_cancelled())
+        {
+            return Err(CodexErr::TurnAborted);
+        }
+        // No reentrant context capture. The existing task gate stays held through durability.
+        // Once append begins, settle the durable publication even if cancellation arrives.
+        let publication = async {
+            live.append_items(&batch).await?;
+            live.flush().await?;
+            let durable = live.load_history(true).await?;
+            Ok::<_, codex_thread_store::ThreadStoreError>(durable)
+        }
+        .await;
+        let durable = match publication {
+            Ok(durable) => durable,
+            Err(_) => {
+                self.revoke_agent_profile_admission();
+                return Err(persistence_failure());
+            }
+        };
+        if !durable.items.windows(2).any(|items| {
+            matches!((&items[0], &items[1]), (RolloutItem::ResponseItem(recorded), RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(applied)))
+                if recorded == &envelope && matches!(&batch[1], RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(expected)) if applied == expected))
+        }) {
+            self.revoke_agent_profile_admission();
+            return Err(persistence_failure());
+        }
+        // One synchronous publication under state/task gates. Getters see only committed state.
+        let mut state = self.state.lock().await;
+        // Revalidate authority against current state after persistence awaits. Other configuration
+        // owners may update fields without taking the profile persistence gate.
+        if self
+            .validate_active_step_settings(
+                &context,
+                &destination,
+                &state.session_configuration,
+                &self.services.turn_environments.selections(),
+            )
+            .is_err()
+        {
+            self.revoke_agent_profile_admission();
+            return Err(persistence_failure());
+        }
+        state.history.record_annotated_items(
+            &mut vec![envelope],
+            destination.model_info.truncation_policy.into(),
+        );
+        state.session_configuration.agent_profile = configuration.agent_profile;
+        state.session_configuration.step_settings = configuration.step_settings;
+        if task_fence.is_some() {
+            context.next_step_settings.store(Arc::new(destination));
+        }
+        Ok(receipt)
+    }
+}
