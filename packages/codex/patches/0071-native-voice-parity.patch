+#[tokio::test]
+async fn captured_b_mcp_uses_child_owned_clients_after_root_moves_to_c() {
+    tokio::time::timeout(Duration::from_secs(30), async {
+        let script = r#"import json,sys,os
+for line in sys.stdin:
+ m=json.loads(line)
+ if 'id' not in m: continue
+ method=m.get('method')
+ if method=='initialize': r={'protocolVersion':'2025-06-18','capabilities':{'tools':{}},'serverInfo':{'name':'source-b','version':'1'}}
+ elif method=='tools/list': r={'tools':[{'name':'search','inputSchema':{'type':'object','properties':{}}}]}
+ elif method=='tools/call': r={'content':[{'type':'text','text':'source-b:'+str(os.getpid())}]}
+ else: r={}
+ print(json.dumps({'jsonrpc':'2.0','id':m['id'],'result':r}),flush=True)
+"#;
+        let (home, mut config) = test_config().await;
+        config.features.set_enabled(codex_features::Feature::Apps, false).unwrap();
+        let harness = child_source_memory_harness(home, config);
+        let (root_id, root) = harness.start_thread().await;
+        let opening = root.session.new_default_turn().await;
+        let a = root.session.activate_agent_profile(None, child_mcp_source_profile(&opening, "mcp-a")).await.unwrap();
+        let server = serde_json::from_value(serde_json::json!({"command":"python3","args":["-u","-c",script],"required":true,"startup_timeout_sec":5})).unwrap();
+        let (binding_b, plugins_b) = root.session.prepare_agent_profile_mcp(std::collections::HashMap::from([("records".into(), server)])).await.unwrap();
+        let mut profile_b = child_mcp_source_profile(&opening, "mcp-b");
+        let b = Arc::get_mut(&mut profile_b).unwrap();
+        b.mcp = Arc::clone(&binding_b);
+        b.data.insert(plugins_b);
+        let b_receipt = root.session.activate_agent_profile(Some(a), profile_b).await.unwrap();
+        let step_b = root.session.capture_step_context(root.session.new_default_turn().await, &CancellationToken::new()).await.unwrap();
+        let parent_call = binding_b.prepare_call("records", "search").unwrap();
+        let parent_result = serde_json::to_value(parent_call.call(None, None, None).await.unwrap()).unwrap();
+        root.session.activate_agent_profile(Some(b_receipt), child_mcp_source_profile(&opening, "mcp-c")).await.unwrap();
+        let child_id = harness.spawn_anonymous_child(root_id, SpawnAgentOptions {
+            spawning_source: Some(crate::AgentSpawnSource::from_step_context(step_b)),
+            parent_thread_id: Some(root_id),
+            ..Default::default()
+        }).await;
+        let child = harness.manager.get_thread(child_id).await.unwrap();
+        let child_step = child.session.capture_step_context_with_required_mcp_servers(child.session.new_default_turn().await, &CancellationToken::new(), &["records".to_owned()], &std::collections::HashSet::new()).await.unwrap();
+        let child_call = child_step.mcp.prepare_call("records", "search").unwrap();
+        let child_result = serde_json::to_value(child_call.call(None, None, None).await.unwrap()).unwrap();
+        assert!(child_result.to_string().contains("source-b:"));
+        assert_ne!(parent_call.transport_instance(), child_call.transport_instance());
+        assert_ne!(parent_result, child_result, "child owns a separate stdio process");
+        let nested_id = harness.spawn_anonymous_child(child_id, SpawnAgentOptions {
+            spawning_source: Some(crate::AgentSpawnSource::from_step_context(child_step)),
+            parent_thread_id: Some(child_id),
+            ..Default::default()
+        }).await;
+        let nested = harness.manager.get_thread(nested_id).await.unwrap();
+        let nested_step = nested.session.capture_step_context_with_required_mcp_servers(nested.session.new_default_turn().await, &CancellationToken::new(), &["records".to_owned()], &std::collections::HashSet::new()).await.unwrap();
+        let nested_call = nested_step.mcp.prepare_call("records", "search").unwrap();
+        let nested_result = serde_json::to_value(nested_call.call(None, None, None).await.unwrap()).unwrap();
+        assert!(nested_result.to_string().contains("source-b:"));
+        assert_ne!(nested_call.transport_instance(), child_call.transport_instance());
+        assert_ne!(nested_result, child_result);
+        assert!(root.session.captured_agent_profile().await.unwrap().unwrap().profile.profile_id == "mcp-c");
+        harness.control.shutdown_agent_tree(root_id).await.unwrap();
+    }).await.expect("source B child MCP test completes");
+}
