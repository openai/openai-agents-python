+    }
+
+    pub(super) fn observe_frame(&self, text: &str, media: bool) -> FrameObservation {
+        let mut observation = self.observe_native_frame(text, media);
+        let mut state = self.configuration.inner.state.lock().unwrap();
+        if state.failure.is_some() {
+            return observation;
+        }
+        if let Some(accepted) = state.accepted.clone() {
+            state.hosted_mcp.invalidate(&accepted);
+        }
+        if !media {
+            return observation;
+        }
+        let Ok(event) = serde_json::from_str::<Value>(text) else {
+            return observation;
+        };
+        loop {
+            let base_bytes =
+                retained_metadata_bytes(&state).saturating_sub(state.hosted_mcp.bytes());
+            let available = super::methods::SDK_WIRE_BYTES_CAPACITY.saturating_sub(base_bytes);
+            let ConfigurationState {
+                hosted_mcp,
+                response_contexts,
+                accepted,
+                ..
+            } = &mut *state;
+            match hosted_mcp.observe(&event, response_contexts, accepted.as_ref(), available) {
+                Ok(events) => {
+                    observation.hosted_mcp_events = events;
+                    return observation;
+                }
+                Err(super::hosted_mcp::ObserveError::Capacity) => {
+                    let protected = event["response_id"]
+                        .as_str()
+                        .or_else(|| event["response"]["id"].as_str());
+                    if evict_completed_context(&mut state, protected) {
+                        continue;
+                    }
+                }
+                Err(super::hosted_mcp::ObserveError::Invalid) => {}
+            }
+            state.failure = Some(ReadyState::Mismatch);
+            self.configuration
+                .inner
+                .signal
+                .send_replace(ReadyState::Mismatch);
+            return observation;
+        }
+    }
+    fn observe_native_frame(&self, text: &str, media: bool) -> FrameObservation {
+        let Ok(event) = serde_json::from_str::<Value>(text) else {
+            return FrameObservation::default();
+        };
+        let mut state = self.configuration.inner.state.lock().unwrap();
+        if state.failure.is_some() {
+            return FrameObservation::default();
+        }
+        let kind = event.get("type").and_then(Value::as_str);
+        match kind {
+            Some("error") if state.pending.is_some() => {
+                // Nested event_id references the client request. An unrelated
+                // provider error is terminal too, never proof of update rejection.
+                let rejected = state.pending.as_ref().is_some_and(|pending| {
+                    pending.phase == PendingPhase::Armed
+                        && pending
+                            .id
+                            .as_deref()
+                            .zip(event["error"]["event_id"].as_str())
+                            .is_some_and(|(request, referred)| request == referred)
+                });
+                let failure = if rejected {
+                    ReadyState::Rejected
+                } else {
+                    ReadyState::ProviderError
+                };
+                state.failure = Some(failure.clone());
+                if let Some(completion) =
+                    state.pending.take().and_then(|pending| pending.completion)
+                {
+                    completion.send_replace(ReceiptState::Failed(failure.clone()));
+                }
+                self.configuration.inner.signal.send_replace(failure);
+                return FrameObservation::default();
+            }
+            Some("conversation.item.truncated") => {
+                if let (Some(item), Some(index), Some(end_ms)) = (
+                    event["item_id"].as_str(),
+                    event["content_index"].as_u64(),
+                    event["audio_end_ms"].as_u64(),
+                ) {
+                    for record in state.received_audio.iter_mut().filter(|record| {
+                        record.item_id == item && u64::from(record.content_index) == index
+                    }) {
+                        if let Some(format) = record.configuration.output_format {
+                            record.samples = record
+                                .samples
+                                .min(end_ms.saturating_mul(u64::from(format.sample_rate())) / 1000);
+                            record.truncated = true;
+                        }
+                    }
+                }
+                return FrameObservation::default();
+            }
+            Some("conversation.item.deleted") => {
+                if let Some(item) = event["item_id"].as_str() {
+                    state.received_audio.retain(|record| record.item_id != item);
+                }
+                return FrameObservation::default();
+            }
+            Some("session.created" | "session.updated") => {
+                let phase = state.pending.as_ref().map(|pending| pending.phase);
+                if phase == Some(PendingPhase::InitialUpdate) && kind == Some("session.created") {
+                    return FrameObservation::default();
+                }
+                let accepted = event.get("session");
+                if phase == Some(PendingPhase::Reserved) {
+                    if accepted
+                        .zip(state.accepted.as_ref())
+                        .is_some_and(|(session, prior)| contains_expected(session, &prior.contract))
+                    {
+                        return FrameObservation::default();
+                    }
+                } else if let Some(pending) = &state.pending {
+                    let matched = accepted.is_some_and(|session| {
+                        session["id"].as_str().is_some_and(|id| !id.is_empty())
+                            && contains_expected(session, &pending.contract)
+                    });
+                    if matched {
+                        let accepted = accepted.unwrap();
+                        let pending = state.pending.take().unwrap();
+                        let accepted = Arc::new(RealtimeAcceptedConfiguration {
+                            hosted_owned: pending.hosted_owned,
+                            native_source: pending.native_source,
+                            input_format: accepted_format(accepted, "input"),
+                            output_format: accepted_format(accepted, "output"),
+                            contract: pending.contract,
+                        });
+                        state.accepted = Some(Arc::clone(&accepted));
+                        if let Some(completion) = pending.completion {
+                            completion.send_replace(ReceiptState::Accepted(accepted));
+                        }
+                        self.configuration
+                            .inner
+                            .signal
+                            .send_replace(ReadyState::Ready);
+                        return FrameObservation::default();
+                    }
+                    // A repeated prior snapshot cannot settle a new revision.
+                    if accepted
+                        .zip(state.accepted.as_ref())
+                        .is_some_and(|(session, prior)| contains_expected(session, &prior.contract))
+                    {
+                        return FrameObservation::default();
+                    }
+                } else if accepted
+                    .zip(state.accepted.as_ref())
+                    .is_some_and(|(session, prior)| contains_expected(session, &prior.contract))
+                {
+                    return FrameObservation::default();
+                }
+                state.failure = Some(ReadyState::Mismatch);
+                if let Some(completion) =
+                    state.pending.take().and_then(|pending| pending.completion)
+                {
+                    completion.send_replace(ReceiptState::Failed(ReadyState::Mismatch));
+                }
+                self.configuration
+                    .inner
+                    .signal
+                    .send_replace(ReadyState::Mismatch);
+                return FrameObservation::default();
+            }
+            _ => {}
+        }
+        if !media {
+            return FrameObservation::default();
+        }
+        let response_id = event
+            .get("response_id")
+            .and_then(Value::as_str)
+            .or_else(|| event["response"]["id"].as_str());
+        match kind {
+            // Interrupting speech and committed audio start a new user request.
+            // Provider echoes of our owned outgoing items do not change ownership.
+            Some("input_audio_buffer.speech_started") => {
+                let Some(item_id) = event["item_id"].as_str().filter(|id| !id.is_empty()) else {
+                    return FrameObservation::suppressed();
+                };
+                if !capture_audio_source(&mut state, item_id) {
+                    // A repeated source cannot interrupt or rebind newer work.
+                    return FrameObservation::suppressed();
+                }
+                let accepted = state.accepted.clone();
+                if accepted
+                    .as_ref()
+                    .is_some_and(|configuration| configuration.interrupts_on_speech_started())
+                {
+                    apply_audio_source(&mut state, item_id);
+                }
+                return FrameObservation {
+                    configuration: accepted,
+                    ..FrameObservation::default()
+                };
+            }
+            Some("input_audio_buffer.speech_stopped") => {
+                if let Some(item_id) = event["item_id"].as_str() {
+                    apply_audio_source(&mut state, item_id);
+                }
+                return FrameObservation::default();
+            }
+            Some("input_audio_buffer.timeout_triggered") => {
+                if let Some(item_id) = event["item_id"].as_str().filter(|id| !id.is_empty())
+                    && capture_audio_source(&mut state, item_id)
+                {
+                    apply_audio_source(&mut state, item_id);
+                }
+                return FrameObservation::default();
+            }
+            Some("input_audio_buffer.committed") => return FrameObservation::default(),
+            Some("response.created") => {
+                if let Some(id) = response_id {
+                    if let Some(active) = &state.active_response {
+                        if active.id.as_ref() == id {
+                            return FrameObservation::response(active);
+                        }
+                    } else if let Some(accepted) = state.accepted.clone() {
+                        if !retain_metadata_room(&mut state, id.len(), true) {
+                            state.failure = Some(ReadyState::Mismatch);
+                        } else {
+                            state.cancelled_response_id = None;
+                            state.feedback_response_id = None;
+                            state.response_create_pending = false;
+                            let response = Arc::new(ActiveResponse {
+                                id: Arc::from(id),
+                                configuration: accepted,
+                                request_owner: state
+                                    .pending_create_owner
+                                    .take()
+                                    .unwrap_or_else(|| Arc::clone(&state.request_owner)),
+                                output_guard: state
+                                    .pending_create_guard
+                                    .take()
+                                    .unwrap_or_else(|| state.output_owner.new_response()),
+                            });
+                            state.latest_response_id = Some(response.id.clone());
+                            let observation = FrameObservation::response(&response);
+                            state.response_contexts.push_back(Arc::clone(&response));
+                            state.active_response = Some(response);
+                            return observation;
+                        }
+                    }
+                }
+            }
+            Some("response.output_audio.delta" | "response.audio.delta") => {
+                if response_id.is_none() {
+                    state.failure = Some(ReadyState::Mismatch);
+                    self.configuration
+                        .inner
+                        .signal
+                        .send_replace(ReadyState::Mismatch);
+                    return FrameObservation::default();
+                }
+                let response = state
+                    .response_contexts
+                    .iter()
+                    .find(|response| Some(response.id.as_ref()) == response_id)
+                    .cloned();
+                let Some(response) = response else {
+                    return FrameObservation::suppressed();
+                };
+                if response.output_guard.is_retired() {
+                    return FrameObservation::response(&response);
+                }
+                if state
+                    .active_response
+                    .as_ref()
+                    .is_none_or(|active| !Arc::ptr_eq(active, &response))
+                {
+                    return FrameObservation::suppressed();
+                }
+                if let (Some(item_id), Some(content), Some(output), Some(data), Some(format)) = (
+                    event["item_id"].as_str(),
+                    event["content_index"]
+                        .as_u64()
+                        .and_then(|i| u32::try_from(i).ok()),
+                    event["output_index"]
+                        .as_u64()
+                        .and_then(|i| u32::try_from(i).ok()),
+                    event["delta"].as_str(),
+                    response.configuration.output_format,
+                ) {
+                    use base64::Engine;
+                    if let Ok(bytes) = base64::engine::general_purpose::STANDARD.decode(data) {
+                        let sample_bytes = if format == RealtimeAudioFormat::Pcm24k {
+                            2
+                        } else {
+                            1
+                        };
+                        if bytes.len() % sample_bytes == 0 {
+                            if let Some(record) = state.received_audio.iter_mut().find(|record| {
+                                record.response_id == response.id
+                                    && record.item_id == item_id
+                                    && record.content_index == content
+                            }) {
+                                if record.output_index != output {
+                                    state.failure = Some(ReadyState::Mismatch);
+                                } else if !record.truncated {
+                                    record.samples = record
+                                        .samples
+                                        .saturating_add((bytes.len() / sample_bytes) as u64);
+                                }
+                            } else if retain_metadata_room(&mut state, item_id.len(), false) {
+                                state.received_audio.push_back(ReceivedAudio {
+                                    response_id: response.id.clone(),
+                                    item_id: item_id.to_owned(),
+                                    content_index: content,
+                                    output_index: output,
+                                    samples: (bytes.len() / sample_bytes) as u64,
+                                    truncated: false,
+                                    configuration: Arc::clone(&response.configuration),
+                                });
+                            } else {
+                                state.failure = Some(ReadyState::Mismatch);
+                            }
+                            if state.failure.is_none() {
+                                return FrameObservation::response(&response);
+                            }
+                        }
+                    }
+                }
+            }
+            Some("response.done" | "response.cancelled") => {
+                if state
+                    .active_response
+                    .as_ref()
+                    .is_some_and(|active| response_id == Some(active.id.as_ref()))
+                {
+                    if kind == Some("response.cancelled")
+                        || event["response"]["status"] == "cancelled"
+                    {
+                        if let Some(active) = &state.active_response {
+                            active.output_guard.retire();
+                        }
+                    }
+                    return state
+                        .active_response
+                        .take()
+                        .map(|active| FrameObservation::response(&active))
+                        .unwrap_or_default();
+                }
+                return FrameObservation::default();
+            }
+            _ => {
+                return state
+                    .response_contexts
+                    .iter()
+                    .find(|response| response_id == Some(response.id.as_ref()))
+                    .map(|response| FrameObservation::response(response))
+                    .unwrap_or_else(|| match kind {
+                        Some(
+                            "response.output_audio_transcript.delta"
+                            | "response.output_audio_transcript.done"
+                            | "response.output_text.delta"
+                            | "response.output_text.done",
+                        ) => FrameObservation::suppressed(),
+                        _ => FrameObservation::default(),
+                    });
+            }
+        }
+        state.failure = Some(ReadyState::Mismatch);
+        self.configuration
+            .inner
+            .signal
+            .send_replace(ReadyState::Mismatch);
+        FrameObservation::default()
+    }
+}
+
+// Provider-added defaults are allowed. Caller-supplied values must be retained;
+// map keys and positional array values retain their actual schema meanings.
+fn contains_expected(accepted: &Value, expected: &Value) -> bool {
+    contains_expected_at(accepted, expected, MatchSite::Session)
+}
+#[derive(Clone, Copy, PartialEq)]
+enum MatchSite {
+    Session,
+    Tools,
+    HostedTool,
+    Value,
+}
+fn contains_expected_at(accepted: &Value, expected: &Value, site: MatchSite) -> bool {
+    match (accepted, expected) {
+        (Value::Object(accepted), Value::Object(expected)) => {
+            let hosted = site == MatchSite::HostedTool;
+            expected.iter().all(|(key, value)| {
+                // Credential values are write-only provider inputs. The ordered
+                // ACK accepts our request; it does not disclose those secrets.
+                if hosted && matches!(key.as_str(), "authorization" | "headers") {
+                    return true;
+                }
+                accepted.get(key).is_some_and(|accepted| {
+                    contains_expected_at(
+                        accepted,
+                        value,
+                        if site == MatchSite::Session && key == "tools" {
+                            MatchSite::Tools
+                        } else {
+                            MatchSite::Value
+                        },
+                    )
+                })
+            })
+        }
+        (Value::Array(accepted), Value::Array(expected)) => {
+            accepted.len() == expected.len()
+                && accepted.iter().zip(expected).all(|(accepted, expected)| {
+                    contains_expected_at(
+                        accepted,
+                        expected,
+                        if site == MatchSite::Tools && expected["type"] == "mcp" {
+                            MatchSite::HostedTool
+                        } else {
+                            MatchSite::Value
+                        },
+                    )
+                })
+        }
+        (Value::Number(accepted), Value::Number(expected)) => {
+            // Tolerate integer/float spelling only where neither side can lose
+            // integer precision. Large metadata integers must still match exactly.
+            let lossless = |number: &serde_json::Number| {
+                const EXACT_INTEGER_LIMIT: u64 = 1 << 53;
+                if let Some(value) = number.as_i64() {
+                    value.unsigned_abs() <= EXACT_INTEGER_LIMIT
+                } else if let Some(value) = number.as_u64() {
+                    value <= EXACT_INTEGER_LIMIT
+                } else {
+                    number
+                        .as_f64()
+                        .is_some_and(|value| value.abs() <= EXACT_INTEGER_LIMIT as f64)
+                }
+            };
+            accepted == expected
+                || (lossless(accepted)
+                    && lossless(expected)
+                    && accepted.as_f64() == expected.as_f64())
+        }
+        _ => accepted == expected,
+    }
+}
