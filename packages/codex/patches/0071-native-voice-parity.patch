+    struct BoundaryActivation {
+        candidate: std::sync::Mutex<Option<codex_extension_api::AgentProfileActivation>>,
+        gate: Option<(Arc<Notify>, Arc<Notify>)>,
+    }
+    impl codex_extension_api::TurnLifecycleContributor for BoundaryActivation {
+        fn before_step_agent_activation<'a>(
+            &'a self,
+            _: codex_extension_api::AgentProfileBoundaryInput<'a>,
+        ) -> codex_extension_api::ExtensionFuture<
+            'a,
+            Result<Option<codex_extension_api::AgentProfileActivation>, String>,
+        > {
+            Box::pin(async move {
+                let candidate = self.candidate.lock().unwrap().take();
+                if candidate.is_some()
+                    && let Some((entered, release)) = &self.gate
+                {
+                    entered.notify_one();
+                    release.notified().await;
+                }
+                Ok(candidate)
+            })
+        }
+    }
