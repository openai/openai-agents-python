+#[tokio::test]
+async fn sdk_terminal_reclamation_keeps_pending_physical_preparation_and_handoff_owners() {
+    use futures::FutureExt;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    use tokio_util::sync::CancellationToken;
+    let (connection, _, server) = sdk_wire_connection().await;
+    let sdk = super::SdkRealtimeState::new("retention-owners".into());
+    let configuration = connection
+        .writer()
+        .configuration()
+        .unwrap()
+        .accepted()
+        .unwrap();
+    let batch = Arc::new(super::RealtimeFunctionBatch {
+        completed: std::sync::OnceLock::new(),
+        root_dispatch: std::sync::OnceLock::new(),
+        response_id: "continuation-response".into(),
+        call_ids: vec!["continuation".into()],
+        configuration,
+        handoff_pending: AtomicBool::new(true),
+        handoff_accepted: AtomicBool::new(false),
+        pending_create: AtomicBool::new(true),
+        user_create: AtomicBool::new(false),
+        automatic_retired: AtomicBool::new(false),
+        committed_target: std::sync::Mutex::new(None),
+        update_reserved: AtomicBool::new(false),
+        continued: AtomicBool::new(false),
+    });
+    let done = CancellationToken::new();
+    done.cancel();
+    batch.completed.set(done).unwrap();
+    let (release, prepared) = tokio::sync::oneshot::channel::<()>();
+    let preparing = Arc::new(super::preparation::SdkToolPreparation {
+        completion: async move { prepared.await.map_err(|error| error.to_string()) }
+            .boxed()
+            .shared(),
+    });
+    for index in 0..super::SDK_FUNCTION_CALL_LIMIT {
+        let id = match index {
+            0 => "pending".to_owned(),
+            1 => "physical".to_owned(),
+            2 => "preparing".to_owned(),
+            3 => "continuation".to_owned(),
+            _ => format!("settled-{index}"),
+        };
+        assert!(sdk.register(&id).await.unwrap());
+        if index != 0 {
+            sdk.pending.lock().await.remove(&id);
+        }
+        let completed = CancellationToken::new();
+        if index != 1 {
+            completed.cancel();
+        }
+        let cancel = CancellationToken::new();
+        // Cancellation alone does not prove physical callback exit.
+        cancel.cancel();
+        sdk.function_calls.lock().await.insert(
+            id.clone(),
+            super::SdkFunctionCall {
+                preparation: (index == 2).then(|| Arc::clone(&preparing)),
+                request: codex_protocol::protocol::RealtimeFunctionCallRequested {
+                    namespace: None,
+                    call_id: id,
+                    item_id: format!("item-{index}"),
+                    name: "function".into(),
+                    arguments: "{}".into(),
+                    response_id: Some(format!("response-{index}")),
+                },
+                claimed: index != 0,
+                native_turn_id: (index != 0).then(|| "native-root".into()),
+                cancel,
+                completed,
+                configuration: None,
+                batch: (index == 3).then(|| Arc::clone(&batch)),
+            },
+        );
+    }
+    sdk.reclaim_terminal_calls("incoming-new-request").await;
+    let calls = sdk.function_calls.lock().await;
+    assert_eq!(calls.len(), 4);
+    for id in ["pending", "physical", "preparing", "continuation"] {
+        assert!(
+            calls.contains_key(id),
+            "still-owned {id} must survive pressure"
+        );
+    }
+    calls["physical"].completed.cancel();
+    drop(calls);
+    release.send(()).unwrap();
+    preparing.completion.clone().await.unwrap();
+    batch.continued.store(true, Ordering::Release);
+    // Fresh pressure can now release the settled owners, but never pending admission.
+    for index in 0..super::SDK_HANDOFF_LIMIT {
+        sdk.reclaim_terminal_calls("incoming-new-request").await;
+        let id = format!("history-pressure-{index}");
+        assert!(sdk.register(&id).await.unwrap());
+        sdk.pending.lock().await.remove(&id);
+    }
+    sdk.reclaim_terminal_calls("incoming-new-request").await;
+    let calls = sdk.function_calls.lock().await;
+    assert_eq!(calls.len(), 1);
+    assert!(calls.contains_key("pending"));
+    server.abort();
 }
