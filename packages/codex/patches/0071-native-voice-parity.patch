+    fn profile(context: &TurnContext, id: &str, revision: &str) -> Arc<AgentProfile> {
+        let settings = context.next_step_settings.load();
+        let selected = settings.selected();
+        Arc::new(AgentProfile {
+            profile_id: id.to_string(),
+            model: AgentProfileModelSettings {
+                model: selected.collaboration_mode.model().to_string(),
+                reasoning_effort: selected.collaboration_mode.reasoning_effort(),
+                reasoning_summary: selected.reasoning_summary,
+                service_tier: selected.service_tier.clone(),
+                tool_choice: selected.tool_choice,
+                personality: selected.personality,
+                request_controls: selected.request_controls.clone(),
+                invocation_timeout_ms: selected.invocation_timeout_ms,
+            },
+            application_instructions: ResponseItemEnvelope {
+                item: ResponseItem::Message {
+                    id: Some(ResponseItemId::with_suffix("msg_sdk_application", revision)),
+                    role: "developer".into(),
+                    content: vec![ContentItem::InputText {
+                        text: format!("Agent {id}, revision {revision}"),
+                    }],
+                    phase: None,
+                    internal_chat_message_metadata_passthrough: None,
+                },
+                metadata: None,
+            },
+            data: Default::default(),
+            mcp: Arc::new(codex_mcp::McpBinding::empty(mcp_config_for_test(
+                &context.config,
+            ))),
+        })
+    }
