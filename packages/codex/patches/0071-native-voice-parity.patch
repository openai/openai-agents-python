+        assert!(stream.configuration.as_ref().unwrap().accepted().is_err());
+    }
+
+    #[tokio::test]
+    async fn close_bypasses_blocked_write_and_preserves_retryable_cleanup() {
+        let (stream, messages, controlled, tx) = fixture();
+        controlled.fail_close.store(true, Ordering::Release);
+        let write = start_write(&stream, &controlled).await;
+        stage_early_frames(&controlled, &tx).await;
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_secs(2), stream.close())
+                .await
+                .unwrap()
+                .is_err()
+        );
+        assert!(write.await.unwrap().is_err());
+        assert!(messages.is_empty());
+        assert!(stream.configuration.as_ref().unwrap().accepted().is_err());
+        // Implicit close calls retain the failed attempt until its owner permits retry.
+        assert!(stream.close().await.is_err());
+        assert_eq!(controlled.closed.load(Ordering::Acquire), 1);
+        stream
+            .adapter_cleanup
+            .as_ref()
+            .unwrap()
+            .retry_failed_close();
+        stream.close().await.unwrap();
+        stream.close().await.unwrap();
+        assert_eq!(controlled.closed.load(Ordering::Acquire), 2);
+    }
