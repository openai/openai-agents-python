+//! Provider-hosted MCP observations and receipts inside the connection owner.
+use super::readiness::{ActiveResponse, RealtimeAcceptedConfiguration};
+use codex_protocol::protocol::{
+    RealtimeEvent, RealtimeHostedMcpApprovalRequest, RealtimeHostedMcpCallCompleted,
+    RealtimeHostedMcpListedTool, RealtimeHostedMcpToolsListed,
+};
+use serde_json::{Value, json};
+use std::collections::VecDeque;
+use std::sync::Arc;
+
+// Allocation policy, not a provider protocol catalog limit.
+pub(super) const MAX_HOSTED_MCP_TOOLS: usize = 1024;
+
+fn charge(bytes: &mut usize, additional: usize) -> Result<(), ObserveError> {
+    *bytes = bytes.saturating_add(additional);
+    if *bytes > super::methods::SDK_WIRE_BYTES_CAPACITY {
+        return Err(ObserveError::Capacity);
+    }
+    Ok(())
+}
+
+pub(super) fn json_bytes(value: &Value, bytes: &mut usize, depth: usize) -> Result<(), ObserveError> {
+    // Bound container/scalar/key allocations without serializing or cloning.
+    if depth > 128 {
+        return Err(ObserveError::Capacity);
+    }
+    charge(bytes, 256)?;
+    match value {
+        Value::String(text) => charge(bytes, text.len().saturating_mul(4))?,
+        Value::Array(values) => {
+            for value in values {
+                json_bytes(value, bytes, depth + 1)?;
+            }
+        }
+        Value::Object(values) => {
+            for (key, value) in values {
+                charge(bytes, 128usize.saturating_add(key.len().saturating_mul(4)))?;
+                json_bytes(value, bytes, depth + 1)?;
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+fn catalog_bytes(item_id: &str, label: &str) -> Result<usize, ObserveError> {
+    let mut bytes = 512;
+    charge(&mut bytes, item_id.len().saturating_mul(4))?;
+    charge(&mut bytes, label.len().saturating_mul(4))?;
+    Ok(bytes)
+}
+
+fn listed_tool_bytes(
+    name: &str,
+    description: Option<&str>,
+    schema: &Value,
+    bytes: &mut usize,
+) -> Result<(), ObserveError> {
+    charge(bytes, 256)?;
+    charge(bytes, name.len().saturating_mul(4))?;
+    charge(bytes, description.map_or(0, str::len).saturating_mul(4))?;
+    json_bytes(schema, bytes, 0)
+}
+
+pub(super) fn event_bytes(event: &RealtimeEvent) -> Result<usize, ObserveError> {
+    if let RealtimeEvent::HostedMcpToolsListed(catalog) = event {
+        if catalog.tools.len() > MAX_HOSTED_MCP_TOOLS {
+            return Err(ObserveError::Capacity);
+        }
+        let mut bytes = catalog_bytes(&catalog.item_id, &catalog.server_label)?;
+        for tool in &catalog.tools {
+            listed_tool_bytes(
+                &tool.name,
+                tool.description.as_deref(),
+                &tool.input_schema,
+                &mut bytes,
+            )?;
+        }
+        Ok(bytes)
+    } else {
+        // Admit structured errors before serializing, and retain their allocation
+        // charge in the same queue permits as the serialized event.
+        let mut bytes = 0;
+        if let RealtimeEvent::HostedMcpCallCompleted(call) = event {
+            if let Some(error) = &call.error {
+                json_bytes(error, &mut bytes, 0)?;
+            }
+        }
+        let encoded = serde_json::to_vec(event).map_err(|_| ObserveError::Invalid)?;
+        charge(&mut bytes, encoded.len())?;
+        Ok(bytes)
+    }
+}
+
+#[derive(Default)]
+pub(super) struct HostedMcpState {
+    records: Vec<Record>,
+}
+struct Record {
+    item_id: String,
+    server_label: String,
+    name: String,
+    arguments: String,
+    final_arguments: bool,
+    approval: bool,
+    native_call_id: Option<String>,
+    approval_request_id: Option<String>,
+    approval_id: Option<String>,
+    published: bool,
+    decision: Option<bool>,
+    completed: bool,
+    continuation_reserved: bool,
+    invalidated: bool,
+    source: Arc<ActiveResponse>,
+}
+#[derive(Debug)]
+pub(super) enum ObserveError {
+    Capacity,
+    Invalid,
+}
+struct Candidate<'a> {
+    item: &'a Value,
+    id: &'a str,
+    label: Option<&'a str>,
+    name: Option<&'a str>,
+    existing: Option<usize>,
+    linked: Option<usize>,
+    arguments: &'a str,
+    final_arguments: bool,
+    completed: bool,
+    approval: bool,
+    native_call_id: Option<&'a str>,
+    keep_arguments: bool,
+    source: Arc<ActiveResponse>,
+}
+impl HostedMcpState {
+    pub(super) fn bytes(&self) -> usize {
+        self.records
+            .iter()
+            .map(|r| {
+                r.item_id.len()
+                    + r.native_call_id.as_ref().map_or(0, String::len)
+                    + r.approval_request_id.as_ref().map_or(0, String::len)
+                    + r.server_label.len()
+                    + r.name.len()
+                    + r.arguments.len()
+                    + r.approval_id.as_ref().map_or(0, String::len)
+            })
+            .sum()
+    }
+    pub(super) fn pending_for(&self, response: &str) -> bool {
+        self.records.iter().any(|r| {
+            r.source.id.as_ref() == response && !r.completed && !r.source.output_guard.is_retired()
+        })
+    }
+    pub(super) fn has_calls(&self, response: &str) -> bool {
+        self.records
+            .iter()
+            .any(|r| r.source.id.as_ref() == response && !r.approval && r.native_call_id.is_none())
+    }
+    pub(super) fn native_continuation_available(&self, response: &str, call: &str) -> bool {
+        self.records.iter().any(|r| {
+            r.source.id.as_ref() == response
+                && r.native_call_id.as_deref() == Some(call)
+                && r.completed
+                && !r.continuation_reserved
+        })
+    }
+    pub(super) fn reserve_native_continuation(&mut self, response: &str, call: &str) {
+        if let Some(r) = self
+            .records
+            .iter_mut()
+            .find(|r| r.source.id.as_ref() == response && r.native_call_id.as_deref() == Some(call))
+        {
+            r.continuation_reserved = true;
+        }
+    }
+    pub(super) fn has_hosted(&self, response: &str) -> bool {
+        self.records
+            .iter()
+            .any(|r| r.source.id.as_ref() == response && r.native_call_id.is_none())
+    }
+    pub(super) fn pins(&self, response: &str) -> bool {
+        self.records.iter().any(|r| {
+            r.source.id.as_ref() == response
+                && !r.completed
+                && !r.invalidated
+                && (r.native_call_id.is_some() || r.source.configuration.hosted_owned)
+                && !r.source.output_guard.is_retired()
+        })
+    }
+    pub(super) fn remove_response(&mut self, response: &str) {
+        self.records.retain(|r| r.source.id.as_ref() != response);
+    }
+    pub(super) fn invalidate(&mut self, accepted: &RealtimeAcceptedConfiguration) {
+        for r in &mut self.records {
+            if r.approval
+                && r.source.configuration.hosted_declaration(&r.server_label)
+                    != accepted.hosted_declaration(&r.server_label)
+            {
+                r.invalidated = true;
+            }
+        }
+    }
+    pub(super) fn observe(
+        &mut self,
+        event: &Value,
+        contexts: &VecDeque<Arc<ActiveResponse>>,
+        accepted: Option<&Arc<RealtimeAcceptedConfiguration>>,
+        available_bytes: usize,
+    ) -> Result<Vec<RealtimeEvent>, ObserveError> {
+        let kind = event["type"].as_str().unwrap_or_default();
+        let response = event["response_id"]
+            .as_str()
+            .or_else(|| event["response"]["id"].as_str());
+        let items: Vec<&Value> = if kind == "response.done" {
+            event["response"]["output"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .collect()
+        } else if matches!(
+            kind,
+            "response.function_call_arguments.done"
+                | "response.mcp_call_arguments.done"
+                | "response.mcp_call.failed"
+        ) {
+            vec![event]
+        } else if matches!(
+            kind,
+            "conversation.item.added"
+                | "conversation.item.created"
+                | "conversation.item.done"
+                | "response.output_item.added"
+                | "response.output_item.done"
+        ) {
+            event.get("item").into_iter().collect()
+        } else {
+            Vec::new()
+        };
+        let mut candidates = Vec::new();
+        let mut observations = Vec::new();
+        let mut catalog_export_bytes = 0;
+        for item in items {
+            let item_kind = match kind {
+                "response.function_call_arguments.done" => "function_call",
+                "response.mcp_call_arguments.done" | "response.mcp_call.failed" => "mcp_call",
+                _ => item["type"].as_str().unwrap_or_default(),
+            };
+            if item_kind == "mcp_list_tools"
+                && matches!(kind, "conversation.item.done" | "response.output_item.done")
+            {
+                if let Some(config) = accepted
+                    && let Some(label) = item["server_label"].as_str()
+                    && config.hosted_declaration(label).is_some()
+                {
+                    let raw_tools = item["tools"]
+                        .as_array()
+                        .map(Vec::as_slice)
+                        .unwrap_or_default();
+                    if raw_tools.len() > MAX_HOSTED_MCP_TOOLS {
+                        return Err(ObserveError::Capacity);
+                    }
+                    let mut allocation =
+                        catalog_bytes(item["id"].as_str().unwrap_or_default(), label)?;
+                    for tool in raw_tools {
+                        if let (Some(name), Some(schema)) =
+                            (tool["name"].as_str(), tool.get("input_schema"))
+                        {
+                            listed_tool_bytes(
+                                name,
+                                tool["description"].as_str(),
+                                schema,
+                                &mut allocation,
+                            )?;
+                        }
+                    }
+                    charge(&mut catalog_export_bytes, allocation)?;
+                    let tools = raw_tools
+                        .iter()
+                        .filter_map(|tool| {
+                            Some(RealtimeHostedMcpListedTool {
+                                name: tool["name"].as_str()?.to_owned(),
+                                description: tool["description"].as_str().map(str::to_owned),
+                                input_schema: tool.get("input_schema")?.clone(),
+                            })
+                        })
+                        .collect();
+                    if observations.len() + candidates.len()
+                        >= super::methods::SDK_WIRE_EVENTS_CAPACITY
+                    {
+                        return Err(ObserveError::Capacity);
+                    }
+                    observations.push(RealtimeEvent::HostedMcpToolsListed(
+                        RealtimeHostedMcpToolsListed {
+                            item_id: item["id"].as_str().unwrap_or_default().to_owned(),
+                            server_label: label.to_owned(),
+                            tools,
+                        },
+                    ));
+                }
+                continue;
+            }
+            if !matches!(
+                item_kind,
+                "mcp_call" | "mcp_tool_call" | "mcp_approval_request" | "function_call"
+            ) {
+                continue;
+            }
+            let native_call_id = if item_kind == "function_call" {
+                Some(
+                    item["call_id"]
+                        .as_str()
+                        .or_else(|| item["id"].as_str())
+                        .or_else(|| item["item_id"].as_str())
+                        .ok_or(ObserveError::Invalid)?,
+                )
+            } else {
+                None
+            };
+            let Some(id) = item["id"]
+                .as_str()
+                .or_else(|| item["item_id"].as_str())
+                .or(native_call_id)
+            else {
+                return Err(ObserveError::Invalid);
+            };
+            let existing_index = self.records.iter().position(|r| r.item_id == id);
+            let sparse_failure = kind == "response.mcp_call.failed";
+            if sparse_failure && existing_index.is_none() {
+                continue;
+            }
+            let linked_id = item["approval_request_id"].as_str().or_else(|| {
+                existing_index.and_then(|i| self.records[i].approval_request_id.as_deref())
+            });
+            let linked_index = linked_id.and_then(|id| {
+                self.records
+                    .iter()
+                    .position(|r| r.approval && r.item_id == id)
+            });
+            let existing = existing_index.map(|i| &self.records[i]);
+            let linked = linked_index.map(|i| &self.records[i]);
+            let source = response
+                .and_then(|id| contexts.iter().find(|r| r.id.as_ref() == id))
+                .or_else(|| existing.map(|r| &r.source))
+                .or_else(|| linked.map(|r| &r.source));
+            let Some(source) = source else {
+                continue;
+            }; // No latest-response inference.
+            if response.is_some_and(|id| id != source.id.as_ref()) {
+                return Err(ObserveError::Invalid);
+            }
+            let added = matches!(
+                kind,
+                "response.output_item.added"
+                    | "conversation.item.added"
+                    | "conversation.item.created"
+                    | "response.function_call_arguments.done"
+                    | "response.mcp_call_arguments.done"
+                    | "response.mcp_call.failed"
+            );
+            let label = item["server_label"]
+                .as_str()
+                .or_else(|| existing.map(|r| r.server_label.as_str()))
+                .or_else(|| linked.map(|r| r.server_label.as_str()))
+                .unwrap_or_default();
+            let name = item["name"]
+                .as_str()
+                .or_else(|| existing.map(|r| r.name.as_str()))
+                .unwrap_or_default();
+            // This reserved builtin completes without a function_call_output.
+            // It must neither pin a batch nor request an automatic response.
+            if native_call_id.is_some() && name == "remain_silent" {
+                continue;
+            }
+            let arguments = if native_call_id.is_some() {
+                ""
+            } else {
+                item["arguments"].as_str().unwrap_or_default()
+            };
+            let approval = item_kind == "mcp_approval_request";
+            if !label.is_empty() && source.configuration.hosted_declaration(label).is_none() {
+                return Err(ObserveError::Invalid);
+            }
+            if !added
+                && (native_call_id.is_none() && name.is_empty() || approval && label.is_empty())
+            {
+                return Err(ObserveError::Invalid);
+            }
+            if approval && !added {
+                if let Some(declaration) = source.configuration.hosted_declaration(label) {
+                    let allowed = &declaration["allowed_tools"];
+                    let names = allowed
+                        .as_array()
+                        .or_else(|| allowed["tool_names"].as_array());
+                    if names.is_some_and(|names| {
+                        !names.iter().any(|allowed| allowed.as_str() == Some(name))
+                    }) {
+                        return Err(ObserveError::Invalid);
+                    }
+                }
+            }
+            if approval && !added && serde_json::from_str::<Value>(arguments).is_err() {
+                return Err(ObserveError::Invalid);
+            }
+            if let Some(linked) = linked {
+                let same_source = match (
+                    &linked.source.configuration.native_source,
+                    &source.configuration.native_source,
+                ) {
+                    (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+                    (None, None) => true,
+                    _ => false,
+                };
+                if linked.source.id != source.id
+                    || !same_source
+                    || linked
+                        .source
+                        .configuration
+                        .hosted_declaration(&linked.server_label)
+                        != source.configuration.hosted_declaration(label)
+                    || linked.server_label != label
+                    || linked.name != name
+                    || !added && linked.final_arguments && linked.arguments != arguments
+                {
+                    return Err(ObserveError::Invalid);
+                }
+            }
+            if let Some(old) = existing {
+                if old.native_call_id.as_deref() != native_call_id
+                    || old.approval != approval
+                    || old.source.id != source.id
+                    || !old.server_label.is_empty() && old.server_label != label
+                    || !old.name.is_empty() && old.name != name
+                    || old.final_arguments && !added && old.arguments != arguments
+                {
+                    return Err(ObserveError::Invalid);
+                }
+            }
+            if candidates.iter().any(|c: &Candidate<'_>| c.id == id) {
+                return Err(ObserveError::Invalid);
+            }
+            let completed = !approval
+                && native_call_id.is_none()
+                && (kind == "response.mcp_call.failed"
+                    || kind == "conversation.item.done"
+                    || item["status"] == "completed"
+                    || !item["output"].is_null()
+                    || !item["error"].is_null());
+            candidates.push(Candidate {
+                item,
+                id,
+                label: item["server_label"].as_str(),
+                name: item["name"].as_str(),
+                existing: existing_index,
+                linked: linked_index,
+                arguments,
+                final_arguments: !added,
+                completed,
+                approval,
+                native_call_id,
+                keep_arguments: sparse_failure,
+                source: Arc::clone(source),
+            });
+            if candidates.len() + observations.len() > super::methods::SDK_WIRE_EVENTS_CAPACITY {
+                return Err(ObserveError::Capacity);
+            }
+        }
+        let mut bytes = self.bytes();
+        let mut count = self.records.len();
+        let mut exported_bytes = catalog_export_bytes;
+        for c in &candidates {
+            if let Some(old) = self.records.iter().find(|r| r.item_id == c.id) {
+                bytes = bytes
+                    .saturating_sub(old.arguments.len() + old.server_label.len() + old.name.len());
+            } else {
+                count += 1;
+                bytes += c.id.len()
+                    + c.native_call_id.map_or(0, str::len)
+                    + c.item["approval_request_id"].as_str().map_or(0, str::len)
+                    + 36;
+            }
+            let label = c
+                .label
+                .or_else(|| c.existing.map(|i| self.records[i].server_label.as_str()))
+                .or_else(|| c.linked.map(|i| self.records[i].server_label.as_str()))
+                .unwrap_or_default();
+            let name = c
+                .name
+                .or_else(|| c.existing.map(|i| self.records[i].name.as_str()))
+                .unwrap_or_default();
+            let old = c.existing.map(|i| &self.records[i]);
+            let arguments_len = old
+                .filter(|r| r.final_arguments)
+                .map_or(c.arguments.len(), |r| r.arguments.len());
+            bytes += arguments_len + label.len() + name.len();
+            if c.approval && c.final_arguments && old.is_some_and(|r| r.approval_id.is_none()) {
+                bytes += 36;
+            }
+            let published = c.approval
+                && c.final_arguments
+                && old.is_none_or(|r| !r.published)
+                && c.source.configuration.hosted_owned
+                && !c.source.output_guard.is_retired();
+            let completed = !c.approval
+                && c.native_call_id.is_none()
+                && c.completed
+                && old.is_none_or(|r| !r.completed);
+            if published || completed {
+                let profile_bytes = c
+                    .source
+                    .configuration
+                    .profile_receipt()
+                    .map_or(0, |receipt| receipt.profile_id.len());
+                let output_bytes = c.item["output"].as_str().map_or(0, str::len);
+                let mut error_bytes = 0;
+                if let Some(error) = c.item.get("error").filter(|e| !e.is_null()) {
+                    json_bytes(error, &mut error_bytes, 0)?;
+                }
+                exported_bytes = exported_bytes.saturating_add(
+                    c.source.id.len()
+                        + c.id.len()
+                        + label.len()
+                        + name.len()
+                        + arguments_len
+                        + profile_bytes
+                        + output_bytes
+                        + error_bytes
+                        + 256,
+                );
+            }
+            if exported_bytes > super::methods::SDK_WIRE_BYTES_CAPACITY {
+                return Err(ObserveError::Capacity);
+            }
+        }
+        if count > super::methods::SDK_WIRE_EVENTS_CAPACITY || bytes > available_bytes {
+            return Err(ObserveError::Capacity);
+        }
+        for c in candidates {
+            let label = c
+                .label
+                .or_else(|| c.existing.map(|i| self.records[i].server_label.as_str()))
+                .or_else(|| c.linked.map(|i| self.records[i].server_label.as_str()))
+                .unwrap_or_default()
+                .to_owned();
+            let name = c
+                .name
+                .or_else(|| c.existing.map(|i| self.records[i].name.as_str()))
+                .unwrap_or_default()
+                .to_owned();
+            let approval_request_id = c.item["approval_request_id"]
+                .as_str()
+                .map(str::to_owned)
+                .or_else(|| {
+                    c.existing
+                        .and_then(|i| self.records[i].approval_request_id.clone())
+                });
+            if let Some(approval) = approval_request_id.as_deref().and_then(|id| {
+                self.records
+                    .iter_mut()
+                    .find(|r| r.approval && r.item_id == id)
+            }) {
+                approval.completed = true;
+                if c.completed && approval.decision.is_none() {
+                    approval.invalidated = true;
+                }
+            }
+            let index = match self.records.iter().position(|r| r.item_id == c.id) {
+                Some(index) => index,
+                None => {
+                    self.records.push(Record {
+                        item_id: c.id.to_owned(),
+                        server_label: label.clone(),
+                        name: name.clone(),
+                        arguments: c.arguments.to_owned(),
+                        final_arguments: c.final_arguments,
+                        approval: c.approval,
+                        native_call_id: c.native_call_id.map(str::to_owned),
+                        approval_request_id: approval_request_id.clone(),
+                        approval_id: None,
+                        published: false,
+                        decision: None,
+                        completed: false,
+                        continuation_reserved: false,
+                        invalidated: false,
+                        source: c.source,
+                    });
+                    self.records.len() - 1
+                }
+            };
+            let r = &mut self.records[index];
+            if r.server_label.is_empty() {
+                r.server_label = label.clone();
+            }
+            if r.name.is_empty() {
+                r.name = name.clone();
+            }
+            if !r.final_arguments && !c.keep_arguments {
+                r.server_label = label;
+                r.name = name;
+                r.arguments = c.arguments.to_owned();
+                r.final_arguments = c.final_arguments;
+            }
+            if r.approval
+                && r.final_arguments
+                && !r.published
+                && r.source.configuration.hosted_owned
+                && !r.source.output_guard.is_retired()
+                && !r.invalidated
+            {
+                r.approval_id = Some(uuid::Uuid::now_v7().to_string());
+                r.published = true;
+                observations.push(RealtimeEvent::HostedMcpApprovalRequested(
+                    RealtimeHostedMcpApprovalRequest {
+                        output_guard: r.source.output_guard.clone(),
+                        approval_id: r.approval_id.clone().unwrap(),
+                        request_id: r.item_id.clone(),
+                        server_label: r.server_label.clone(),
+                        tool_name: r.name.clone(),
+                        arguments: r.arguments.clone(),
+                        response_id: r.source.id.to_string(),
+                        profile_receipt: r.source.configuration.profile_receipt().cloned(),
+                    },
+                ));
+            }
+            if !r.approval && r.native_call_id.is_none() && c.completed && !r.completed {
+                r.completed = true;
+                observations.push(RealtimeEvent::HostedMcpCallCompleted(
+                    RealtimeHostedMcpCallCompleted {
+                        item_id: r.item_id.clone(),
+                        response_id: r.source.id.to_string(),
+                        server_label: r.server_label.clone(),
+                        tool_name: r.name.clone(),
+                        arguments: r.arguments.clone(),
+                        output: c.item["output"].as_str().map(str::to_owned),
+                        error: c.item.get("error").filter(|e| !e.is_null()).cloned().or_else(||c.keep_arguments.then(||json!({"type":"tool_execution_error","message":"MCP tool call failed"}))),
+                        profile_receipt: r.source.configuration.profile_receipt().cloned(),
+                    },
+                ));
+            }
+        }
+        Ok(observations)
+    }
+    pub(super) fn tool_response_id(&self, call_id: &str) -> Option<String> {
+        self.records
+            .iter()
+            .find(|record| record.native_call_id.as_deref() == Some(call_id))
+            .map(|record| record.source.id.to_string())
+    }
+    pub(super) fn function_output_sent(&mut self, call_id: &str) {
+        if let Some(record) = self
+            .records
+            .iter_mut()
+            .find(|record| record.native_call_id.as_deref() == Some(call_id))
+        {
+            record.completed = true;
+        }
+    }
+    pub(super) fn has_tools(&self, response: &str) -> bool {
+        self.records
+            .iter()
+            .any(|r| r.source.id.as_ref() == response)
+    }
+    pub(super) fn decide(
+        &mut self,
+        token: &str,
+        approve: bool,
+        reason: Option<&str>,
+        accepted: &RealtimeAcceptedConfiguration,
+    ) -> Result<Value, &'static str> {
+        let r = self
+            .records
+            .iter_mut()
+            .find(|r| r.approval_id.as_deref() == Some(token))
+            .ok_or("Hosted MCP approval receipt is unknown")?;
+        if r.decision.is_some()
+            || r.invalidated
+            || r.source.output_guard.is_retired()
+            || !r.source.configuration.hosted_owned
+            || r.source.configuration.hosted_declaration(&r.server_label)
+                != accepted.hosted_declaration(&r.server_label)
+        {
+            return Err("Hosted MCP approval receipt is stale or already consumed");
+        }
+        r.decision = Some(approve); // Consume before writing; uncertain writes are never replayed.
+        let mut item = json!({"type":"mcp_approval_response","id":uuid::Uuid::now_v7().to_string(),"approval_request_id":r.item_id,"approve":approve});
+        if let Some(reason) = reason {
+            item["reason"] = Value::String(reason.to_owned());
+        }
+        Ok(json!({"type":"conversation.item.create","previous_item_id":r.item_id,"item":item}))
+    }
+}
+
+pub(super) fn wire_diagnostic(text: &str) -> String {
+    let Ok(mut event) = serde_json::from_str::<Value>(text) else {
+        return text.to_owned();
+    };
+    for container in ["session", "response"] {
+        if let Some(tools) = event[container]
+            .get_mut("tools")
+            .and_then(Value::as_array_mut)
+        {
+            for tool in tools {
+                if tool["type"] == "mcp" {
+                    for field in ["headers", "authorization", "server_url"] {
+                        if tool.get(field).is_some() {
+                            tool[field] = Value::String("[redacted]".into());
+                        }
+                    }
+                }
+            }
+        }
+    }
+    event.to_string()
+}
