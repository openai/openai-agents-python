+#[test]
+fn accepted_handoff_metadata_survives_feedback_without_a_recorded_call() {
+    let handoff = codex_protocol::agent_profile::AgentProfileHandoff {
+        source: codex_protocol::agent_profile::AgentProfileReceipt {
+            profile_id: "source-A".into(),
+            epoch: 7,
+        },
+        target_profile_id: "target-B".into(),
+        call_id: "native-call".into(),
+    };
+    let mut result = AnyToolResult {
+        harness_metadata: Some(codex_history::CodexHarnessMetadata {
+            sdk_agent_handoff: Some(handoff.clone()),
+            ..Default::default()
+        }),
+        call_id: "native-call".into(),
+        payload: ToolPayload::Function {
+            arguments: "{}".into(),
+        },
+        result: Box::new(PostToolUseFeedbackOutput {
+            original: Box::new(crate::tools::context::FunctionToolOutput::from_text(
+                "raw-private-output".into(),
+                Some(true),
+            )),
+            model_visible: crate::tools::context::FunctionToolOutput::from_text(
+                "accepted policy feedback".into(),
+                None,
+            ),
+        }),
+        post_tool_use_payload: None,
+        pending_exec: None,
+    };
+    result.record_accepted_outcome(codex_tools::AcceptedToolOutcome {
+        handoff: Some(handoff.clone()),
+        start_response: false,
+    });
+    let envelope = result.into_response();
+    assert_eq!(
+        envelope.metadata.as_ref().unwrap().sdk_start_response,
+        Some(false)
+    );
+    assert_eq!(
+        envelope
+            .metadata
+            .as_ref()
+            .unwrap()
+            .sdk_agent_handoff
+            .as_ref(),
+        Some(&handoff)
+    );
+    let record = codex_history::RolloutItem::ResponseItem(envelope);
+    let serialized = serde_json::to_string(&record).unwrap();
+    assert!(serialized.contains("accepted policy feedback"));
+    assert!(!serialized.contains("raw-private-output"));
+    assert_eq!(
+        serde_json::to_value(
+            serde_json::from_str::<codex_history::RolloutItem>(&serialized).unwrap()
+        )
+        .unwrap(),
+        serde_json::to_value(record).unwrap()
+    );
+}
