+        tx.send("x".repeat(SDK_WIRE_BYTES_CAPACITY)).await.unwrap();
+        tx.send("x".into()).await.unwrap();
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_secs(2), write)
+                .await
+                .unwrap()
+                .unwrap()
+                .is_err()
