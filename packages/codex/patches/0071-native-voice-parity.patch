+#[tokio::test]
+async fn sdk_failed_wire_hangup_is_retained_for_cleanup_retry_and_blocks_new_start() {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::time::Duration;
+    use wiremock::matchers::{header, method, path};
+    use wiremock::{Mock, MockServer, ResponseTemplate};
+    struct SyntheticAuth;
+    impl codex_api::AuthProvider for SyntheticAuth {
+        fn add_auth_headers(&self, headers: &mut http::HeaderMap) {
+            headers.insert(
+                http::header::AUTHORIZATION,
+                http::HeaderValue::from_static("Bearer synthetic-call-owner"),
+            );
+        }
+    }
+    let server = MockServer::start().await;
+    let attempts = Arc::new(AtomicUsize::new(0));
+    let received = Arc::clone(&attempts);
+    Mock::given(method("POST"))
+        .and(path("/v1/realtime/calls/rtc_owned/hangup"))
+        .and(header("authorization", "Bearer synthetic-call-owner"))
+        .and(header("x-call-owner", "captured"))
+        .respond_with(move |_: &wiremock::Request| {
+            let status = if received.fetch_add(1, Ordering::SeqCst) == 0 {
+                500
+            } else {
+                200
+            };
+            ResponseTemplate::new(status)
+        })
+        .expect(2)
+        .mount(&server)
+        .await;
+    let transport = codex_client::ReqwestTransport::from_http_client(
+        codex_http_client::HttpClientBuilder::new()
+            .build_direct()
+            .unwrap(),
+    );
+    let client = codex_api::RealtimeCallClient::new(
+        transport,
+        codex_api::Provider {
+            name: "synthetic-call-provider".into(),
+            base_url: format!("{}/v1", server.uri()),
+            query_params: None,
+            headers: http::HeaderMap::new(),
+            retry: codex_api::RetryConfig {
+                max_attempts: 1,
+                base_delay: Duration::from_millis(1),
+                retry_429: false,
+                retry_5xx: false,
+                retry_transport: false,
+            },
+            stream_idle_timeout: Duration::from_secs(1),
+        },
+        Arc::new(SyntheticAuth),
+    );
+    let mut headers = http::HeaderMap::new();
+    headers.insert("x-call-owner", http::HeaderValue::from_static("captured"));
+    let lease = Arc::new(crate::client::RealtimeCallLease::new(
+        "rtc_owned".into(),
+        client,
+        headers,
+    ));
+    let (manager, _) = sdk_manager("owned-generation");
+    let manager = Arc::new(manager);
+    manager.state.lock().await.sdk_cleanup = Some(super::SdkCleanup {
+        preparation: None,
+        generation: "owned-generation".into(),
+        call: Some(Arc::clone(&lease)),
+        retirement: None,
+    });
+    assert!(manager.shutdown_sdk("owned-generation").await.is_err());
+    assert_eq!(attempts.load(Ordering::SeqCst), 1);
+    {
+        let state = manager.state.lock().await;
+        assert!(state.conversation.is_none());
+        assert!(state.ensure_start_available(true).is_err());
+        assert!(state.ensure_start_available(false).is_err());
+        assert!(Arc::ptr_eq(
+            state.sdk_cleanup.as_ref().unwrap().call.as_ref().unwrap(),
+            &lease
+        ));
+    }
+    assert!(manager.shutdown_sdk("stale-generation").await.is_err());
+    assert_eq!(attempts.load(Ordering::SeqCst), 1);
+    let cleanup = super::RealtimeConversationCleanup::new(Arc::clone(&manager));
+    cleanup.close("owned-generation").await.unwrap();
+    assert_eq!(attempts.load(Ordering::SeqCst), 2);
+    assert!(
+        manager
+            .state
+            .lock()
+            .await
+            .ensure_start_available(true)
+            .is_ok()
+    );
+    cleanup.close("owned-generation").await.unwrap();
+    assert_eq!(attempts.load(Ordering::SeqCst), 2);
+    server.verify().await;
+}
