diff --git a/codex-rs/core/src/realtime_conversation/tool_task.rs b/codex-rs/core/src/realtime_conversation/tool_task.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1c059a6a6fd49ab314f01ca395d9c10c7fa23979
--- /dev/null
+++ b/codex-rs/core/src/realtime_conversation/tool_task.rs
@@ -0,0 +1,1278 @@
+//! One issuing response's native-selected functions under the ordinary root task lifecycle.
+use super::SdkRealtimeCommand;
+use super::SdkRealtimeState;
+use crate::session::TurnInput;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::session::turn_context::TurnContext;
+use crate::state::TaskKind;
+use crate::tasks::SessionTask;
+use crate::tasks::SessionTaskResult;
+use crate::tools::parallel::ToolCallRuntime;
+use crate::tools::router::ToolRouter;
+use crate::turn_diff_tracker::TurnDiffTracker;
+use codex_extension_api::ToolsOnlyCallInput;
+use codex_extension_api::TurnStartPhase;
+use codex_history::CodexHarnessMetadata;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::error::CodexErr;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::RealtimeFunctionCallRequested;
+use codex_protocol::realtime_settings::RealtimeFunctionTool;
+use codex_tools::ToolSpec;
+use futures::FutureExt;
+use futures::StreamExt;
+use std::sync::Arc;
+use std::sync::atomic::Ordering;
+use tokio::sync::Mutex;
+use tokio_util::sync::CancellationToken;
+use tracing::Instrument;
+
+/// Only Core can mint this attachment; receipts alone cannot select native settings.
+struct RealtimeToolSource {
+    owner: std::sync::Weak<Session>,
+    settings: Arc<crate::session::step_settings::ResolvedStepSettings>,
+    declarations: Vec<codex_extension_api::RealtimeToolDeclaration>,
+    selection_id: String,
+    application_instructions: Option<String>,
+    execution: RealtimeToolExecutionSource,
+}
+
+/// Immutable SDK source inputs for a NEW actual step, without cached selection/admission.
+#[derive(Clone)]
+pub(crate) struct RealtimeToolExecutionSource {
+    pub(crate) data: codex_extension_api::ExtensionDataInit,
+    pub(crate) mcp: Option<Arc<codex_mcp::McpBinding>>,
+}
+
+pub(crate) fn uses_retained_mcp_binding(step: &StepContext) -> bool {
+    step.settings.agent_profile.is_some()
+        || step
+            .extension_data
+            .get::<crate::mcp::InheritedMcpCatalog>()
+            .is_some()
+        || step
+            .extension_data
+            .get::<RealtimeToolExecutionSource>()
+            .or_else(|| {
+                step.turn
+                    .extension_data
+                    .get::<RealtimeToolExecutionSource>()
+            })
+            .is_some_and(|source| source.mcp.is_some())
+}
+
+impl codex_api::RealtimeNativeSource for RealtimeToolSource {
+    fn profile_receipt(&self) -> Option<&codex_protocol::agent_profile::AgentProfileReceipt> {
+        self.settings
+            .agent_profile
+            .as_ref()
+            .map(|profile| &profile.receipt)
+    }
+    fn as_any(&self) -> &dyn std::any::Any {
+        self
+    }
+}
+
+pub(super) struct RealtimeSourceDraft {
+    pub(super) inputs: crate::session::RealtimeSourceInputs,
+    settings: Arc<crate::session::step_settings::ResolvedStepSettings>,
+    captured: Option<codex_extension_api::RealtimeToolDeclarations>,
+}
+
+impl RealtimeSourceDraft {
+    pub(super) fn validate_selection_identity(
+        &self,
+        tools: Option<&[RealtimeFunctionTool]>,
+        expected: Option<&str>,
+    ) -> codex_protocol::error::Result<()> {
+        if tools.is_some_and(|tools| !tools.is_empty())
+            && (self.captured.as_ref().is_none_or(|source| {
+                source.selection_id.is_empty() || Some(source.selection_id.as_str()) != expected
+            }))
+        {
+            return Err(CodexErr::InvalidRequest(
+                "Realtime subset belongs to another captured catalog/profile".into(),
+            ));
+        }
+        Ok(())
+    }
+    pub(super) fn application_instructions(&self) -> Option<String> {
+        self.captured.as_ref().map(|captured| {
+            captured
+                .application_instructions
+                .clone()
+                .unwrap_or_default()
+        })
+    }
+}
+
+fn capture_declarations(
+    session: &Arc<Session>,
+    inputs: &crate::session::RealtimeSourceInputs,
+    mcp: Option<&codex_mcp::McpBinding>,
+    retained_execution_data: Option<&codex_extension_api::ExtensionDataInit>,
+) -> codex_protocol::error::Result<Option<codex_extension_api::RealtimeToolDeclarations>> {
+    let mut captured = None;
+    for contributor in session.services.extensions.tool_contributors() {
+        if let Some(source) = contributor
+            .capture_realtime_tools(codex_extension_api::RealtimeToolCaptureInput {
+                session_store: &session.services.session_extension_data,
+                thread_store: &session.services.thread_extension_data,
+                profile: inputs.profile().map(Arc::as_ref),
+                mcp,
+                retained_execution_data,
+            })
+            .map_err(CodexErr::InvalidRequest)?
+        {
+            if captured.replace(source).is_some() {
+                return Err(CodexErr::InvalidRequest(
+                    "Multiple Realtime declaration owners".into(),
+                ));
+            }
+        }
+    }
+    Ok(captured)
+}
+
+/// Short reader phase. SDK mutation ownership covers this receipt; metadata resolution is cache-only.
+pub(super) async fn capture_realtime_source_draft(
+    session: &Arc<Session>,
+) -> codex_protocol::error::Result<RealtimeSourceDraft> {
+    let inputs = session.capture_realtime_source_inputs().await?;
+    let settings = inputs.resolve_settings(session).await?;
+    let captured = capture_declarations(session, &inputs, None, None)?;
+    Ok(RealtimeSourceDraft {
+        inputs,
+        settings,
+        captured,
+    })
+}
+
+#[cfg(test)]
+pub(super) async fn capture_realtime_native_source(
+    session: &Arc<Session>,
+) -> codex_protocol::error::Result<Arc<dyn codex_api::RealtimeNativeSource>> {
+    let draft = capture_realtime_source_draft(session).await?;
+    finish_realtime_native_source(session, draft).await
+}
+
+/// Slow owned phase: prepare the frozen binding, then project it using the first immutable SDK source.
+pub(super) async fn finish_realtime_native_source(
+    session: &Arc<Session>,
+    draft: RealtimeSourceDraft,
+) -> codex_protocol::error::Result<Arc<dyn codex_api::RealtimeNativeSource>> {
+    let RealtimeSourceDraft {
+        inputs,
+        settings,
+        captured,
+    } = draft;
+    let mcp = session.prepare_realtime_source_mcp(&inputs).await?;
+    let owns_application_instructions = captured.is_some();
+    let mut captured = captured.unwrap_or(codex_extension_api::RealtimeToolDeclarations {
+        tools: Vec::new(),
+        selection_id: String::new(),
+        application_instructions: None,
+        execution_data: Default::default(),
+    });
+    let projected = capture_declarations(
+        session,
+        &inputs,
+        mcp.as_deref(),
+        Some(&captured.execution_data),
+    )?;
+    match projected {
+        Some(projected)
+            if owns_application_instructions && projected.selection_id == captured.selection_id =>
+        {
+            captured.tools = projected.tools
+        }
+        None if !owns_application_instructions => {}
+        _ => {
+            return Err(CodexErr::InvalidRequest(
+                "Realtime declaration source changed during preparation".into(),
+            ));
+        }
+    }
+    let mut names = std::collections::HashSet::new();
+    for declaration in &mut captured.tools {
+        if declaration.spec.kind != "function" || declaration.spec.defer_loading == Some(true) {
+            return Err(CodexErr::InvalidRequest(
+                "Realtime declarations must be directly exposed functions".into(),
+            ));
+        }
+        declaration.spec.name =
+            codex_extension_api::realtime_tool_wire_name(&declaration.native_name);
+        if !names.insert(declaration.spec.name.clone()) {
+            return Err(CodexErr::InvalidRequest(
+                "Realtime declaration names collide".into(),
+            ));
+        }
+    }
+    // The SDK projects the accepted plain text from the same captured source.
+    // Canonical profile publications may contain SDK revision markup.
+    let application_instructions = owns_application_instructions
+        .then(|| captured.application_instructions.unwrap_or_default());
+    Ok(Arc::new(RealtimeToolSource {
+        owner: Arc::downgrade(session),
+        settings,
+        declarations: captured.tools,
+        selection_id: captured.selection_id,
+        application_instructions,
+        execution: RealtimeToolExecutionSource {
+            data: captured.execution_data,
+            mcp,
+        },
+    }))
+}
+
+fn wire_definition(
+    declaration: &codex_extension_api::RealtimeToolDeclaration,
+) -> codex_protocol::error::Result<RealtimeFunctionTool> {
+    Ok(RealtimeFunctionTool {
+        name: declaration.spec.name.clone(),
+        description: Some(declaration.spec.description.clone()),
+        parameters: declaration.spec.parameters.clone(),
+        strict: Some(declaration.spec.strict),
+    })
+}
+
+pub(super) fn select_source_tools(
+    source: &Arc<dyn codex_api::RealtimeNativeSource>,
+    requested: Option<Vec<RealtimeFunctionTool>>,
+    expected_selection_id: Option<&str>,
+) -> codex_protocol::error::Result<Vec<RealtimeFunctionTool>> {
+    let source = source
+        .as_any()
+        .downcast_ref::<RealtimeToolSource>()
+        .ok_or_else(|| CodexErr::InvalidRequest("Unknown native Realtime source".into()))?;
+    let admitted = source
+        .declarations
+        .iter()
+        .map(wire_definition)
+        .collect::<codex_protocol::error::Result<Vec<_>>>()?;
+    let Some(requested) = requested else {
+        return Ok(admitted);
+    };
+    if !requested.is_empty()
+        && (source.selection_id.is_empty()
+            || expected_selection_id != Some(source.selection_id.as_str()))
+    {
+        return Err(CodexErr::InvalidRequest(
+            "Realtime subset belongs to another captured catalog/profile".into(),
+        ));
+    }
+    requested
+        .into_iter()
+        .map(|definition| {
+            admitted
+                .iter()
+                .find(|captured| {
+                    captured.name == definition.name
+                        && captured.description == definition.description
+                        && captured.parameters == definition.parameters
+                        && definition
+                            .strict
+                            .is_none_or(|strict| captured.strict == Some(strict))
+                })
+                .cloned()
+                .ok_or_else(|| {
+                    CodexErr::InvalidRequest(
+                        "Realtime subset exceeds the captured declaration owner".into(),
+                    )
+                })
+        })
+        .collect()
+}
+
+pub(super) fn source_instructions(
+    source: &Arc<dyn codex_api::RealtimeNativeSource>,
+) -> codex_protocol::error::Result<Option<String>> {
+    let source = source
+        .as_any()
+        .downcast_ref::<RealtimeToolSource>()
+        .ok_or_else(|| CodexErr::InvalidRequest("Unknown native Realtime source".into()))?;
+    Ok(source.application_instructions.clone())
+}
+
+pub(super) fn same_source_identity(
+    accepted: Option<&Arc<dyn codex_api::RealtimeNativeSource>>,
+    captured: &Arc<dyn codex_api::RealtimeNativeSource>,
+) -> bool {
+    let Some(a) = accepted.and_then(|source| source.as_any().downcast_ref::<RealtimeToolSource>())
+    else {
+        return false;
+    };
+    let Some(b) = captured.as_any().downcast_ref::<RealtimeToolSource>() else {
+        return false;
+    };
+    a.owner.ptr_eq(&b.owner)
+        && a.selection_id == b.selection_id
+        && accepted.and_then(|source| source.profile_receipt()) == captured.profile_receipt()
+        && a.application_instructions == b.application_instructions
+}
+
+pub(super) fn select_accepted_tools(
+    configuration: &codex_api::RealtimeAcceptedConfiguration,
+    requested: Vec<RealtimeFunctionTool>,
+) -> codex_protocol::error::Result<Vec<RealtimeFunctionTool>> {
+    let source = configuration.native_source.as_ref().ok_or_else(|| {
+        CodexErr::InvalidRequest("Realtime configuration has no native source".into())
+    })?;
+    let key = source
+        .as_any()
+        .downcast_ref::<RealtimeToolSource>()
+        .ok_or_else(|| CodexErr::InvalidRequest("Unknown native Realtime source".into()))?
+        .selection_id
+        .clone();
+    // A sparse wire-only update operates on this already accepted source, never a global catalog.
+    select_source_tools(source, Some(requested), Some(&key))
+}
+
+pub(super) fn captured_definition(
+    configuration: &codex_api::RealtimeAcceptedConfiguration,
+    name: &str,
+) -> codex_protocol::error::Result<(RealtimeFunctionTool, codex_tools::ToolName)> {
+    let source = configuration
+        .native_source
+        .as_ref()
+        .and_then(|source| source.as_any().downcast_ref::<RealtimeToolSource>())
+        .ok_or_else(|| {
+            CodexErr::InvalidRequest("Realtime call has no captured declaration source".into())
+        })?;
+    let accepted = configuration
+        .function_tools()
+        .into_iter()
+        .find(|definition| definition.name == name)
+        .ok_or_else(|| {
+            CodexErr::InvalidRequest(
+                "Realtime function was not advertised in its response configuration".into(),
+            )
+        })?;
+    let declaration = source
+        .declarations
+        .iter()
+        .find(|declaration| declaration.spec.name == name)
+        .ok_or_else(|| {
+            CodexErr::InvalidRequest("Realtime function has no captured native owner".into())
+        })?;
+    if wire_definition(declaration)? != accepted {
+        return Err(CodexErr::InvalidRequest(
+            "Realtime function differs from its captured native declaration".into(),
+        ));
+    }
+    Ok((accepted, declaration.native_name.clone()))
+}
+
+fn source_settings(
+    session: &Arc<Session>,
+    configuration: &codex_api::RealtimeAcceptedConfiguration,
+) -> codex_protocol::error::Result<Arc<crate::session::step_settings::ResolvedStepSettings>> {
+    let source = configuration
+        .native_source
+        .as_ref()
+        .and_then(|source| source.as_any().downcast_ref::<RealtimeToolSource>())
+        .ok_or_else(|| CodexErr::InvalidRequest("Realtime batch has no native source".into()))?;
+    let owner = source
+        .owner
+        .upgrade()
+        .filter(|owner| Arc::ptr_eq(owner, session))
+        .ok_or_else(|| {
+            CodexErr::InvalidRequest("Realtime native source belongs to another Session".into())
+        })?;
+    if owner.services.local_agent_runtime.shutdown.is_cancelled() {
+        return Err(CodexErr::TurnAborted);
+    }
+    Ok(Arc::clone(&source.settings))
+}
+
+pub(super) struct RealtimeToolCall {
+    sdk: Arc<SdkRealtimeState>,
+    native_call_id: String,
+    native_name: codex_tools::ToolName,
+    batch: Option<Arc<super::RealtimeFunctionBatch>>,
+    request: RealtimeFunctionCallRequested,
+    definition: RealtimeFunctionTool,
+    cancel: CancellationToken,
+}
+
+impl RealtimeToolCall {
+    pub(super) fn new(
+        sdk: Arc<SdkRealtimeState>,
+        request: RealtimeFunctionCallRequested,
+        definition: RealtimeFunctionTool,
+        cancel: CancellationToken,
+        native_name: codex_tools::ToolName,
+        batch: Option<Arc<super::RealtimeFunctionBatch>>,
+    ) -> Self {
+        Self {
+            sdk,
+            native_call_id: format!("realtime_{}", uuid::Uuid::new_v4()),
+            native_name,
+            batch,
+            request,
+            definition,
+            cancel,
+        }
+    }
+    async fn live(&self) -> bool {
+        self.sdk.active.load(Ordering::Acquire)
+            && self.sdk.pending.lock().await.get(&self.request.call_id) == Some(&false)
+    }
+
+    async fn correlation(&self) -> serde_json::Value {
+        let response_id = self
+            .sdk
+            .function_calls
+            .lock()
+            .await
+            .get(&self.request.call_id)
+            .and_then(|call| call.request.response_id.clone());
+        serde_json::json!({
+            "generation": self.sdk.generation,
+            "provider_call_id": self.request.call_id,
+            "provider_item_id": self.request.item_id,
+            "provider_response_id": response_id,
+        })
+    }
+
+    async fn execute(
+        &self,
+        session: Arc<Session>,
+        ctx: Arc<TurnContext>,
+        step: Arc<StepContext>,
+        runtime: ToolCallRuntime,
+        cancellation: CancellationToken,
+    ) -> codex_protocol::error::Result<(String, bool, bool)> {
+        // The same immutable native definition must still be selected, directly visible,
+        // and compatible with the generation's advertisement. No deferred/code-mode widening.
+        let normalized = codex_tools::dynamic_tool_to_responses_api_tool(
+            &codex_protocol::dynamic_tools::DynamicToolFunctionSpec {
+                name: self.native_name.name.clone(),
+                description: self.definition.description.clone().unwrap_or_default(),
+                input_schema: self.definition.parameters.clone(),
+                defer_loading: false,
+            },
+        )
+        .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+        let matches_function = |tool: &codex_tools::ResponsesApiTool| {
+            tool.name == self.native_name.name
+                && tool.strict == self.definition.strict.unwrap_or(false)
+                && serde_json::to_value(&tool.parameters).ok().as_ref()
+                    == serde_json::to_value(&normalized.parameters).ok().as_ref()
+        };
+        let matches_definition =
+            step.tool_router
+                .model_visible_specs()
+                .iter()
+                .any(|spec| match spec {
+                    ToolSpec::Function(tool) => {
+                        self.native_name.is_default_namespace() && matches_function(tool)
+                    }
+                    ToolSpec::Namespace(namespace) => {
+                        self.native_name.namespace.as_deref() == Some(namespace.name.as_str())
+                            && namespace.tools.iter().any(|tool| match tool {
+                                codex_tools::ResponsesApiNamespaceTool::Function(tool) => {
+                                    matches_function(tool)
+                                }
+                                _ => false,
+                            })
+                    }
+                    _ => false,
+                });
+        if !matches_definition {
+            return Err(CodexErr::InvalidRequest(
+                "Realtime function does not match the selected native definition".into(),
+            ));
+        }
+        let native_call_id = self.native_call_id.clone();
+        let ignored = runtime.ignores_handoff(&self.native_name, &native_call_id);
+        let mut item = ResponseItem::FunctionCall {
+            id: None,
+            name: self.native_name.name.clone(),
+            namespace: self.native_name.namespace.clone(),
+            arguments: if ignored {
+                "{}".into()
+            } else {
+                self.request.arguments.clone()
+            },
+            encrypted_function_args: None,
+            call_id: native_call_id.clone(),
+            internal_chat_message_metadata_passthrough: None,
+        };
+        let admission = crate::model_request::tool_admission_for_step(
+            session.thread_id.to_string(),
+            Arc::clone(&step),
+        );
+        if !admission.admits(&item) {
+            return Err(CodexErr::InvalidRequest(
+                "Realtime function is not admitted by the native router".into(),
+            ));
+        }
+        for contributor in session
+            .services
+            .extensions
+            .model_request_contributors()
+            .iter()
+            .filter(|_| !ignored)
+        {
+            // The contributor owns any dispatched host callback until its physical
+            // release. Cancellation signals that owner; dropping its future is not a join.
+            item = contributor
+                .admit_tools_only_call(ToolsOnlyCallInput {
+                    admission: Arc::clone(&admission),
+                    model: step.settings.model_info.slug.clone(),
+                    item,
+                    cancellation: cancellation.clone(),
+                })
+                .await
+                .map_err(CodexErr::InvalidRequest)?;
+            if !matches!(&item, ResponseItem::FunctionCall { call_id, name, namespace, encrypted_function_args: None, .. } if call_id == &native_call_id && name == &self.native_name.name && namespace == &self.native_name.namespace)
+                || !admission.admits(&item)
+            {
+                return Err(CodexErr::InvalidRequest(
+                    "Realtime tool policy changed the captured function identity".into(),
+                ));
+            }
+        }
+        if cancellation.is_cancelled() || !self.live().await {
+            return Err(CodexErr::TurnAborted);
+        }
+        let metadata = CodexHarnessMetadata {
+            realtime_tool_call: Some(self.correlation().await),
+            ..Default::default()
+        };
+        session
+            .record_annotated_conversation_items(
+                &ctx,
+                &step.settings.model_info,
+                vec![ResponseItemEnvelope {
+                    item: item.clone(),
+                    metadata: Some(metadata),
+                }],
+            )
+            .await;
+        session.ensure_rollout_durable().await?;
+        let call = ToolRouter::build_tool_call(item)
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?
+            .ok_or_else(|| {
+                CodexErr::InvalidRequest("Realtime function has no native call".into())
+            })?;
+        let mut result = runtime
+            .handle_tool_call(call, cancellation.child_token())
+            .await?;
+        let start_response = result
+            .envelope
+            .metadata
+            .as_ref()
+            .and_then(|metadata| metadata.sdk_start_response)
+            .unwrap_or(true);
+        let accepted_handoff = result
+            .envelope
+            .metadata
+            .as_ref()
+            .and_then(|metadata| metadata.sdk_agent_handoff.as_ref())
+            .cloned();
+        let succeeded = !matches!(&result.envelope.item, ResponseItem::FunctionCallOutput { output, .. } if output.success == Some(false));
+        let text = match &result.envelope.item {
+            ResponseItem::FunctionCallOutput { output, .. } => match &output.body {
+                codex_protocol::models::FunctionCallOutputBody::Text(text) => Some(text.clone()),
+                codex_protocol::models::FunctionCallOutputBody::ContentItems(items)
+                    if items.iter().all(|item| {
+                        matches!(
+                            item,
+                            codex_protocol::models::FunctionCallOutputContentItem::InputText { .. }
+                        )
+                    }) =>
+                {
+                    output.body.to_text()
+                }
+                _ => None,
+            },
+            _ => None,
+        };
+        result
+            .envelope
+            .metadata
+            .get_or_insert_with(Default::default)
+            .realtime_tool_call = Some(self.correlation().await);
+        session
+            .record_tool_result(&ctx, &step.settings.model_info, result)
+            .await;
+        let text = text.ok_or_else(|| {
+            CodexErr::InvalidRequest("Realtime function requires a textual native output".into())
+        })?;
+        session.ensure_rollout_durable().await?;
+        if cancellation.is_cancelled() || !self.live().await {
+            return Err(CodexErr::TurnAborted);
+        }
+        if accepted_handoff.is_some() {
+            let batch = self.batch.as_ref().ok_or_else(|| {
+                CodexErr::InvalidRequest("Handoff requires its complete response batch".into())
+            })?;
+            batch.handoff_accepted.store(true, Ordering::Release);
+        }
+        Ok((text, succeeded, start_response))
+    }
+
+    async fn publish(
+        &self,
+        session: &Arc<Session>,
+        text: String,
+        succeeded: bool,
+        start_response: bool,
+        cancellation: Option<CancellationToken>,
+    ) -> codex_protocol::error::Result<()> {
+        if !self.live().await {
+            return Ok(());
+        }
+        session
+            .conversation
+            .sdk_enqueue(
+                &self.sdk.generation,
+                SdkRealtimeCommand::FunctionResult {
+                    call_id: self.request.call_id.clone(),
+                    text,
+                    succeeded,
+                    start_response,
+                    cancellation,
+                },
+            )
+            .await
+    }
+
+    async fn run(
+        &self,
+        session: Arc<Session>,
+        ctx: Arc<TurnContext>,
+        step: Arc<StepContext>,
+        runtime: ToolCallRuntime,
+        cancellation: CancellationToken,
+        publication_cancellation: CancellationToken,
+    ) -> codex_protocol::error::Result<()> {
+        let execution = cancellation.child_token();
+        let executing = self.execute(Arc::clone(&session), ctx, step, runtime, execution.clone());
+        tokio::pin!(executing);
+        let result = tokio::select! {
+            biased;
+            _ = self.cancel.cancelled() => {
+                execution.cancel();
+                // ToolCallRuntime aborts AND joins its dispatched executor. Keep
+                // polling through that path before advertising batch completion.
+                executing.await
+            }
+            result = &mut executing => result,
+        };
+        match result {
+            Ok((text, succeeded, start_response)) => {
+                self.publish(
+                    &session,
+                    text,
+                    succeeded,
+                    start_response,
+                    Some(publication_cancellation),
+                )
+                .await?
+            }
+            Err(error) => {
+                self.publish(&session, "The function failed.".into(), false, true, None)
+                    .await?;
+                if cancellation.is_cancelled()
+                    || matches!(
+                        error.details(),
+                        codex_protocol::error::CodexErrorDetails::Fatal(_)
+                            | codex_protocol::error::CodexErrorDetails::Io(_)
+                    )
+                {
+                    return Err(error);
+                }
+            }
+        }
+        Ok(())
+    }
+}
