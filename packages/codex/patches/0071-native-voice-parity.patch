+            assert!(std::ptr::eq(call.config(), captured.config().as_ref()));
+            assert!(
+                captured.prepare_call("pending", "echo").is_none(),
+                "the immutable cached map was not replaced"
+            );
+        }
+        manager.shutdown().await;
