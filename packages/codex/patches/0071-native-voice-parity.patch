+    async fn retained_readiness_waits_for_accepted_update_without_consuming_early_events() {
+        let (connection, send, server) =
+            readiness_connection(json!({"instructions": "brief"}), true).await;
+        send.send(
+            json!({"type": "session.created", "session": {"id": "s", "instructions": "default"}}),
+        )
+        .await
+        .unwrap();
+        send.send(json!({"type": "response.output_text.delta", "delta": "early"}))
+            .await
+            .unwrap();
+        assert!(
+            tokio::time::timeout(Duration::from_millis(20), connection.wait_ready())
+                .await
+                .is_err()
+        );
+        send.send(json!({"type": "session.updated", "session": {"id": "s", "instructions": "brief", "server_default": true}})).await.unwrap();
+        tokio::time::timeout(Duration::from_secs(1), connection.wait_ready())
+            .await
+            .unwrap()
+            .unwrap();
+        connection.wait_ready().await.unwrap();
+        assert!(
+            matches!(connection.next_event().await.unwrap(), Some(RealtimeEvent::OutputTranscriptDelta(delta)) if delta.delta == "early")
+        );
+        assert!(
+            matches!(connection.next_event().await.unwrap(), Some(RealtimeEvent::SessionUpdated { realtime_session_id, .. }) if realtime_session_id == "s")
+        );
+        connection.writer().abort_and_join().await;
+        assert!(connection.wait_ready().await.is_err());
+        server.abort();
+        let _ = server.await;
+    }
