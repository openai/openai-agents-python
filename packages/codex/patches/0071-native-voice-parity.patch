+    /// Wait for the pump to validate accepted public V2 session settings.
+    /// This passive wait never consumes events. The caller owns its timeout.
+    pub async fn wait_ready(&self) -> Result<(), ApiError> {
+        let mut readiness = self.writer.stream.readiness.clone();
+        loop {
+            let state = readiness.borrow_and_update().clone();
+            if !matches!(state, super::readiness::ReadyState::Unsupported)
+                && (self.writer.is_closed.load(Ordering::Acquire)
+                    || self.writer.stream.ingress_overflow.load(Ordering::Acquire)
+                    || readiness.has_changed().is_err())
+            {
