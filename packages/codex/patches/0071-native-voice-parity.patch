+async fn request_sdk_response_create(
+    sdk: &SdkRealtimeState,
+    writer: &RealtimeWebsocketWriter,
+    responses: &mut RealtimeResponseCreateQueue,
+    reason: &str,
+    origin: Option<&RealtimeFunctionBatch>,
+    automatic: bool,
+) -> anyhow::Result<()> {
