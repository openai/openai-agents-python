+            let budget = Arc::new(tokio::sync::Semaphore::new(SDK_WIRE_BYTES_CAPACITY));
+            assert!(
+                QueuedWireMessage::new(
+                    Ok(Message::Text(text.clone().into())),
+                    Some(Arc::clone(&budget)),
+                )
+                .is_err()
