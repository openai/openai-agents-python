+async fn sdk_wire_pending_handoff_case(interrupt: bool, full_terminal_queue: bool) {
+    use codex_api::RealtimeEvent;
+    use codex_extension_api::{AgentProfile, AgentProfileHandoffTools, AgentProfileModelSettings};
+    use codex_protocol::models::{ContentItem, ResponseItem};
+    let (session, sdk, native_events, policy, http, _) = realtime_tool_fixture(true, false).await;
+    let context = session.new_default_turn().await;
+    let mut data = codex_extension_api::ExtensionDataInit::new();
+    data.insert(AgentProfileHandoffTools {
+        targets: std::collections::HashMap::from([(
+            codex_tools::ToolName::plain("approved_function").with_default_namespace(),
+            "target-B".into(),
+        )]),
+    });
+    let profile = Arc::new(AgentProfile {
+        profile_id: "source-A".into(),
+        model: AgentProfileModelSettings {
+            model: context.collaboration_mode().model().to_string(),
+            reasoning_effort: context.reasoning_effort().cloned(),
+            reasoning_summary: None,
+            service_tier: None,
+            tool_choice: None,
+            personality: context.personality(),
+            request_controls: context
+                .next_step_settings
+                .load()
+                .selected()
+                .request_controls
+                .clone(),
+            invocation_timeout_ms: context
+                .next_step_settings
+                .load()
+                .selected()
+                .invocation_timeout_ms,
+        },
+        application_instructions: codex_history::ResponseItemEnvelope {
+            item: ResponseItem::Message {
+                id: Some(codex_protocol::ResponseItemId::with_suffix(
+                    "msg_sdk_application",
+                    "handoff-hold",
+                )),
+                role: "developer".into(),
+                content: vec![ContentItem::InputText {
+                    text: "source-A instructions".into(),
+                }],
+                phase: None,
+                internal_chat_message_metadata_passthrough: None,
+            },
+            metadata: None,
+        },
+        data,
+        mcp: Arc::new(codex_mcp::McpBinding::empty(
+            crate::session::tests::mcp_config_for_test(&context.config),
+        )),
+    });
+    session.activate_agent_profile(None, profile).await.unwrap();
+    let source = super::tool_task::capture_realtime_native_source(&session)
+        .await
+        .unwrap();
+    let (connection, mut wire, server, control) =
+        sdk_wire_connection_controlled(Some(source), sdk.function_tools.clone(), "handoff-source")
+            .await;
+    wire.recv().await.unwrap();
+    *sdk.configuration.lock().unwrap() = connection.writer().configuration();
+    let handoff = session
+        .conversation
+        .state
+        .lock()
+        .await
+        .conversation
+        .as_ref()
+        .unwrap()
+        .handoff
+        .clone();
+    let (events, _events_rx) = async_channel::unbounded();
+    let mut responses = super::RealtimeResponseCreateQueue::default();
+    connection.writer().send_response_create().await.unwrap();
+    assert_eq!(wire.recv().await.unwrap()["type"], "response.create");
+    dispatch_sdk_wire_until(&connection, &handoff, &events, &mut responses, |event| {
+        matches!(event, RealtimeEvent::ResponseCreated(_))
+    })
+    .await;
+    let ids = vec!["first-handoff".to_string(), "later-handoff".to_string()];
+    let items: Vec<_> = ids
+        .iter()
+        .map(|id| {
+            serde_json::json!({
+                "type":"function_call", "id":format!("item-{id}"), "call_id":id,
+                "name":"approved_function", "arguments":"{\"x\":1}", "status":"completed"
+            })
+        })
+        .collect();
+    for (index, item) in items.iter().enumerate() {
+        control.send(SdkWireControl::Event(serde_json::json!({
+            "type":"response.output_item.done", "response_id":"handoff-source", "output_index":index, "item":item
+        }))).unwrap();
+    }
+    control.send(SdkWireControl::Event(serde_json::json!({
+        "type":"response.done", "response":{"id":"handoff-source", "status":"completed", "output":items}
+    }))).unwrap();
+    dispatch_sdk_wire_until(&connection, &handoff, &events, &mut responses, |event| {
+        matches!(event, RealtimeEvent::ResponseDone(_))
+    })
+    .await;
+    let mut init = codex_extension_api::ExtensionDataInit::new();
+    init.insert(Arc::clone(&policy.owner));
+    super::handle_tools_sdk(
+        &session,
+        "tools-generation".into(),
+        "handoff-source".into(),
+        ids,
+        "pending-handoff-turn".into(),
+        crate::WithTurnExtensionData::new(Default::default(), init),
+    )
+    .await
+    .unwrap();
+    tokio::time::timeout(std::time::Duration::from_secs(5), policy.entered.notified())
+        .await
+        .unwrap();
+    // The later requested handoff is ignored, without entering its callback. Its
+    // physical output must not start a response while the first decision is pending.
+    let ignored = tokio::time::timeout(std::time::Duration::from_secs(5), sdk.commands_rx.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(
+        matches!(&ignored, super::SdkRealtimeCommand::FunctionResult { call_id, .. } if call_id == "later-handoff")
+    );
+    super::handle_sdk_realtime_command(
+        Ok(ignored),
+        &connection.writer(),
+        &handoff,
+        &mut responses,
+        &events,
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        wire.recv().await.unwrap()["item"]["call_id"],
+        "later-handoff"
+    );
+    assert!(
+        tokio::time::timeout(std::time::Duration::from_millis(40), wire.recv())
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        policy.admissions.load(std::sync::atomic::Ordering::Acquire),
+        1
+    );
+    set_sdk_wire_response_id(&control, "after-handoff").await;
+    if full_terminal_queue {
+        // Real native selection has installed the requested hold. Park distinct user
+        // input behind it before exhausting the existing command queue.
+        super::handle_sdk_realtime_command(
+            Ok(super::SdkRealtimeCommand::Text(ConversationTextParams {
+                text: "held user continuation".into(),
+                role: ConversationTextRole::User,
+            })),
+            &connection.writer(),
+            &handoff,
+            &mut responses,
+            &events,
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            wire.recv().await.unwrap()["type"],
+            "conversation.item.create"
+        );
+        assert!(sdk.function_calls.lock().await.values().any(|call| {
+            call.batch.as_ref().is_some_and(|batch| {
+                batch
+                    .handoff_pending
+                    .load(std::sync::atomic::Ordering::Acquire)
+                    && batch.user_create.load(std::sync::atomic::Ordering::Acquire)
+            })
+        }));
+        while sdk
+            .commands_tx
+            .try_send(super::SdkRealtimeCommand::Text(ConversationTextParams {
+                text: "queued input".into(),
+                role: ConversationTextRole::User,
+            }))
+            .is_ok()
+        {}
+        assert!(sdk.commands_tx.is_full());
+        // This is the ordinary task-retirement path, not a direct helper invocation.
+        super::cancel_sdk_tool_work(&session, "tools-generation", false, Some("handoff-source"))
+            .await;
+        assert!(!sdk.active.load(std::sync::atomic::Ordering::Acquire));
+        assert!(session.conversation.running_state().await.is_none());
+        tokio::time::timeout(
+            std::time::Duration::from_secs(2),
+            session.conversation.shutdown_sdk("tools-generation"),
+        )
+        .await
+        .unwrap()
+        .unwrap();
+        assert!(!sdk.active.load(std::sync::atomic::Ordering::Acquire));
+        assert!(session.conversation.running_state().await.is_none());
+        assert!(
+            session
+                .conversation
+                .state
+                .lock()
+                .await
+                .sdk_cleanup
+                .as_ref()
+                .unwrap()
+                .completed()
+        );
+        let mut terminal_error = false;
+        while let Ok(event) = native_events.try_recv() {
+            terminal_error |= matches!(
+                event.msg,
+                codex_protocol::protocol::EventMsg::RealtimeConversationRealtime(
+                    codex_protocol::protocol::RealtimeConversationRealtimeEvent {
+                        payload: codex_protocol::protocol::RealtimeEvent::Error(_)
+                    }
+                )
+            );
+        }
+        assert!(terminal_error);
+        connection.close().await.unwrap();
+        server.await.unwrap();
+        let retained = policy.connection.lock().unwrap().take();
+        if let Some((connection, _, server)) = retained {
+            connection.close().await.unwrap();
+            server.await.unwrap();
+        }
+        return;
+    }
+    if interrupt {
+        super::handle_sdk_realtime_command(
+            Ok(super::SdkRealtimeCommand::Interrupt {
+                response_id: Some("handoff-source".into()),
+                playback: None,
+                feedback: None,
+                reply: None,
+            }),
+            &connection.writer(),
+            &handoff,
+            &mut responses,
+            &events,
+        )
+        .await
+        .unwrap();
+        // Exercise the same task retirement used by the response-cancel fanout.
+        super::cancel_sdk_tool_work(&session, "tools-generation", false, Some("handoff-source"))
+            .await;
+        super::handle_sdk_realtime_command(
+            Ok(super::SdkRealtimeCommand::Text(ConversationTextParams {
+                text: "continue after cancelled handoff".into(),
+                role: ConversationTextRole::User,
+            })),
+            &connection.writer(),
+            &handoff,
+            &mut responses,
+            &events,
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            wire.recv().await.unwrap()["type"],
+            "conversation.item.create"
+        );
+    } else {
+        policy.decision.notify_one();
+        loop {
+            let command =
+                tokio::time::timeout(std::time::Duration::from_secs(5), sdk.commands_rx.recv())
+                    .await
+                    .unwrap()
+                    .unwrap();
+            let finished = matches!(&command, super::SdkRealtimeCommand::FinishBatch(_));
+            super::handle_sdk_realtime_command(
+                Ok(command),
+                &connection.writer(),
+                &handoff,
+                &mut responses,
+                &events,
+            )
+            .await
+            .unwrap();
+            if finished {
+                break;
+            }
+            assert_eq!(
+                wire.recv().await.unwrap()["item"]["call_id"],
+                "first-handoff"
+            );
+        }
+    }
+    let resumed = tokio::time::timeout(std::time::Duration::from_secs(2), wire.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(resumed["type"], "response.create");
+    assert_eq!(
+        policy.admissions.load(std::sync::atomic::Ordering::Acquire),
+        1
+    );
+    while let Ok(event) = native_events.try_recv() {
+        assert!(!matches!(
+            event.msg,
+            codex_protocol::protocol::EventMsg::DynamicToolCallRequest(_)
+        ));
+    }
+    assert!(http.received_requests().await.unwrap().is_empty());
+    connection.close().await.unwrap();
+    server.await.unwrap();
+    let retained = policy.connection.lock().unwrap().take();
+    if let Some((connection, _, server)) = retained {
+        connection.close().await.unwrap();
+        server.await.unwrap();
+    }
+}
