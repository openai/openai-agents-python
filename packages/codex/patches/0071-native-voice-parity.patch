+#[test]
+fn sdk_enable_preserves_turn_started_while_legacy_history_was_dormant() {
+    let mut state = RealtimeHistoryState::sdk_only();
+    let turn = EventMsg::TurnStarted(codex_protocol::protocol::TurnStartedEvent {
+        turn_id: "turn-1".to_string(),
+        root_turn_id: None,
+        trace_id: None,
+        started_at: None,
+        model_context_window: None,
+        collaboration_mode_kind: Default::default(),
+    });
+    // Match Session::send_event_raw_with_persistence: it filters before observe.
+    if state.should_observe(&turn) {
+        assert!(state.observe(&turn).items.is_empty());
+    }
+    let before = completed_item(dynamic_tool_call(
+        "before-voice",
+        DynamicToolCallStatus::Completed,
+    ));
+    assert!(!state.should_observe(&before));
+    state.enable_sdk();
+    let started = EventMsg::RealtimeConversationStarted(RealtimeConversationStartedEvent {
+        realtime_session_id: Some("sdk-legacy".into()),
+        version: RealtimeConversationVersion::V2,
+    });
+    if state.should_observe(&started) {
+        state.observe(&started);
+    }
+    let after = completed_item(dynamic_tool_call(
+        "during-voice",
+        DynamicToolCallStatus::Completed,
+    ));
+    let promoted = if state.should_observe(&after) {
+        state.observe(&after).items
+    } else {
+        Vec::new()
+    };
+    assert_eq!(promoted.len(), 1);
+    assert!(
+        matches!(&promoted[0].content, RealtimeItemContent::BemItemPromoted {turn_id, item_id, ..} if turn_id == "turn-1" && item_id == "during-voice")
+    );
+    assert_eq!(promoted[0].realtime_session_id, "sdk-legacy");
+}
