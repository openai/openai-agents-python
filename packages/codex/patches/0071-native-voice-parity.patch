+            .pause_cancel
+            .store(true, std::sync::atomic::Ordering::Release);
+        register_realtime_tool(&sdk).await;
+        assert!(matches!(
+            start_realtime_tool(&session, &policy).await,
+            codex_protocol::turn_input::TurnInputSubmission::Started { .. }
+        ));
+        policy.entered.notified().await;
+        let cancel = super::cancel_sdk_tool_work(
+            &session,
+            "tools-generation",
+            false,
+            Some("provider-response"),
+        );
+        tokio::pin!(cancel);
+        tokio::select! {
+            _ = &mut cancel => panic!("interrupt acknowledged before policy cleanup"),
+            _ = policy.cancel_entered.notified() => {}
+        }
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_millis(200), &mut cancel)
+                .await
+                .is_err(),
+            "tools root was force-aborted at the ordinary 100ms grace"
+        );
+        policy.cancel_release.notify_one();
+        cancel.await;
+        assert!(session.active_turn.lock().await.is_none());
+        assert!(http.received_requests().await.unwrap().is_empty());
+        while let Ok(event) = events.try_recv() {
+            assert!(
+                !matches!(
+                    event.msg,
+                    codex_protocol::protocol::EventMsg::DynamicToolCallRequest(_)
+                ),
+                "cancelled policy must not dispatch a function"
+            );
+        }
+        super::handle_close_sdk(&session, "tools-generation".into())
+            .await
+            .unwrap();
+    })
+    .await
+    .expect("tools-root physical policy cleanup exceeded 10s");
+}
