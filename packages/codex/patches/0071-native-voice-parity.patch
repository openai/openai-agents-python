+#[tokio::test]
+async fn sdk_function_withholds_accepted_handler_text_when_call_persistence_fails() {
+    use codex_protocol::protocol::EventMsg;
+    let (session, sdk, events, policy, http, _rollout) = realtime_tool_fixture(false, false).await;
+    register_realtime_tool(&sdk).await;
+    policy
+        .pause_finish
+        .store(true, std::sync::atomic::Ordering::Release);
+    start_realtime_tool(&session, &policy).await;
+    tokio::time::timeout(std::time::Duration::from_secs(5), policy.entered.notified())
+        .await
+        .unwrap();
+    policy.decision.notify_one();
+    let call = tokio::time::timeout(std::time::Duration::from_secs(5), async {
+        loop {
+            if let EventMsg::DynamicToolCallRequest(call) = events.recv().await.unwrap().msg {
+                break call;
+            }
+        }
+    })
+    .await
+    .unwrap();
+    let accepted_text = "accepted handler result must stay off the Realtime wire";
+    session
+        .notify_dynamic_tool_response(
+            &call.call_id,
+            codex_protocol::dynamic_tools::DynamicToolResponse {
+                content_items: vec![
+                    codex_protocol::dynamic_tools::DynamicToolCallOutputContentItem::InputText {
+                        text: accepted_text.into(),
+                    },
+                ],
+                success: true,
+            },
+        )
+        .await;
+    // The native handler and result policies accepted this output. Hold the real
+    // finish hook before the task records and flushes the canonical call result.
+    tokio::time::timeout(
+        std::time::Duration::from_secs(5),
+        policy.finish_entered.notified(),
+    )
+    .await
+    .unwrap();
+    assert!(
+        sdk.commands_rx.is_empty(),
+        "handler acceptance alone cannot publish"
+    );
+    session
+        .services
+        .thread_store
+        .discard_thread(session.thread_id)
+        .await
+        .unwrap();
+    policy.finish_release.notify_one();
+    let command = tokio::time::timeout(std::time::Duration::from_secs(5), sdk.commands_rx.recv())
+        .await
+        .unwrap();
+    match command {
+        Ok(command) => assert!(matches!(command,
+            super::SdkRealtimeCommand::FunctionResult { call_id, text, .. }
+                if call_id == "provider-call" && text == "The function failed.")),
+        Err(_) => assert!(
+            !sdk.active.load(std::sync::atomic::Ordering::Acquire),
+            "a closed result queue is valid only after failed persistence retires its owner"
+        ),
+    }
+    assert!(
+        session.flush_rollout().await.is_err(),
+        "fixture must fail the real durability barrier"
+    );
+    assert!(
+        sdk.commands_rx.is_empty(),
+        "accepted handler text must never be queued for the writer"
+    );
+    assert!(http.received_requests().await.unwrap().is_empty());
+    super::handle_close_sdk(&session, "tools-generation".into())
+        .await
+        .unwrap();
+}
