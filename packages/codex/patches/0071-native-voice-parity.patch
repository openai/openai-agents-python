+    pub(super) fn tools_response_create(
+        &self,
+        response_id: &str,
+        require_hosted: bool,
+        expected: Option<&Arc<RealtimeAcceptedConfiguration>>,
+    ) -> bool {
+        self.tools_response_create_inner(response_id, require_hosted, expected, None)
+    }
+    pub(super) fn function_response_create(&self, response_id: &str, call_id: &str) -> bool {
+        self.tools_response_create_inner(response_id, false, None, Some(call_id))
+    }
+    fn tools_response_create_inner(
+        &self,
+        response_id: &str,
+        require_hosted: bool,
+        expected: Option<&Arc<RealtimeAcceptedConfiguration>>,
+        native_call: Option<&str>,
+    ) -> bool {
+        let mut state = self.inner.state.lock().unwrap();
+        let request_owner = state
+            .response_contexts
+            .iter()
+            .find(|r| r.id.as_ref() == response_id)
+            .map(|r| Arc::clone(&r.request_owner));
+        let source_matches = state.accepted.as_ref().is_some_and(|current| {
+            if let Some(expected) = expected {
+                return Arc::ptr_eq(current, expected);
+            }
+            state
+                .response_contexts
+                .iter()
+                .find(|r| r.id.as_ref() == response_id)
+                .is_some_and(
+                    |r| match (&r.configuration.native_source, &current.native_source) {
+                        (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+                        (None, None) => true,
+                        _ => false,
+                    },
+                )
+        });
+        let ready = source_matches
+            && state.failure.is_none()
+            && state.pending.is_none()
+            && state.active_response.is_none()
+            && !state.response_create_pending
+            && request_owner
+                .as_ref()
+                .is_some_and(|owner| Arc::ptr_eq(owner, &state.request_owner))
+            && (native_call.is_some() || state.latest_response_id.as_deref() == Some(response_id))
+            && state.response_contexts.iter().any(|r| {
+                r.id.as_ref() == response_id
+                    && (!require_hosted || r.configuration.hosted_owned)
+                    && !r.output_guard.is_retired()
+            })
+            && (if require_hosted {
+                state.hosted_mcp.has_calls(response_id)
+            } else {
+                state.hosted_mcp.has_tools(response_id)
+            })
+            && native_call.is_none_or(|call| {
+                state
+                    .hosted_mcp
+                    .native_continuation_available(response_id, call)
+            })
+            && ((native_call.is_some() && !state.hosted_mcp.has_hosted(response_id))
+                || !state.hosted_mcp.pending_for(response_id));
+        if ready {
+            if let Some(call) = native_call {
+                state
+                    .hosted_mcp
+                    .reserve_native_continuation(response_id, call);
+            }
+            state.response_create_pending = true;
+            state.pending_create_owner = request_owner;
+            state.pending_create_guard = Some(state.output_owner.new_response());
+        }
+        ready
+    }
+    pub(super) fn decide_hosted_mcp(
+        &self,
+        token: &str,
+        approve: bool,
+        reason: Option<&str>,
+    ) -> Result<Value, ApiError> {
+        let mut state = self.inner.state.lock().unwrap();
+        let accepted = Self::settled(&state)?;
+        state
+            .hosted_mcp
+            .decide(token, approve, reason, &accepted)
+            .map_err(invalid)
+    }
+
+    pub(super) fn observe_user_input(&self) {
+        self.inner.state.lock().unwrap().request_owner = Arc::new(());
+    }
+    pub(super) fn observe_response_create(&self) -> bool {
+        let mut state = self.inner.state.lock().unwrap();
+        // Never overwrite the owner of a create already written to the socket.
+        if state.response_create_pending {
+            return false;
+        }
+        state.request_owner = Arc::new(());
+        state.pending_create_owner = Some(Arc::clone(&state.request_owner));
+        state.pending_create_guard = Some(state.output_owner.new_response());
+        state.response_create_pending = true;
+        true
+    }
+
+    pub(super) fn prepare_interrupt(
+        &self,
+        response_id: Option<&str>,
+        playback: Option<&codex_protocol::protocol::RealtimePlaybackPosition>,
+        feedback: Option<&str>,
+        server_managed_audio: bool,
+    ) -> Result<InterruptActions, ApiError> {
+        let mut state = self.inner.state.lock().unwrap();
+        if state.failure.is_some() {
+            return Err(invalid("Realtime configuration is retired"));
+        }
+        if feedback.is_some() && response_id.is_none() {
+            return Err(invalid(
+                "Guardrail feedback requires an explicit response ID",
+            ));
+        }
+        if let Some(position) = playback {
+            if response_id.is_some_and(|id| id != position.response_id) {
+                return Err(invalid(
+                    "Targeted interruption and playback refer to different responses",
+                ));
+            }
+            Self::validate_playback_in(&state, position)?;
+        }
+        let retired_response_ids = if let Some(id) = response_id {
+            state
+                .response_contexts
+                .iter()
+                .filter(|response| response.id.as_ref() == id)
+                .map(|response| {
+                    response.output_guard.retire();
+                    response.id.to_string()
+                })
+                .collect()
+        } else {
+            let ids = state
+                .response_contexts
+                .iter()
+                .filter(|response| !response.output_guard.is_retired())
+                .map(|response| response.id.to_string())
+                .collect();
+            state.output_owner.retire_owner();
+            state.output_owner = RealtimeOutputGuard::default();
+            ids
+        };
+        let active_response_id = state
+            .active_response
+            .as_ref()
+            .map(|active| active.id.to_string());
+        let target = match response_id {
+            Some(id) => active_response_id
+                .as_deref()
+                .filter(|active| *active == id)
+                .map(str::to_owned),
+            None => active_response_id.clone(),
+        };
+        let mut payloads = Vec::new();
+        let cancelled_response_id =
+            target.filter(|id| state.cancelled_response_id.as_deref() != Some(id.as_str()));
+        if let Some(id) = &cancelled_response_id {
+            payloads.push(serde_json::json!({"type": "response.cancel", "response_id": id}));
+            state.cancelled_response_id = state
+                .active_response
+                .as_ref()
+                .map(|active| active.id.clone());
+        } else if response_id.is_none()
+            && active_response_id.is_none()
+            && state.response_create_pending
+        {
+            payloads.push(serde_json::json!({"type": "response.cancel"}));
+        }
+        if let Some(position) = playback {
+            if let Some(record) = state.received_audio.iter_mut().find(|record| {
+                record.response_id.as_ref() == position.response_id
+                    && record.item_id == position.item_id
+                    && record.content_index == position.content_index
+            }) {
+                let rate = record.configuration.output_format.unwrap().sample_rate();
+                record.samples = record
+                    .samples
+                    .min(u64::from(position.audio_end_ms) * u64::from(rate) / 1000);
+                record.truncated = true;
+            }
+            payloads.push(serde_json::json!({"type": "conversation.item.truncate", "item_id": position.item_id,
+                "content_index": position.content_index, "audio_end_ms": position.audio_end_ms}));
+        }
+        let feedback_accepted = feedback.is_some()
+            && response_id.is_some_and(|id| {
+                state.latest_response_id.as_deref() == Some(id)
+                    && state.response_contexts.iter().any(|response| {
+                        response.id.as_ref() == id
+                            && Arc::ptr_eq(&response.request_owner, &state.request_owner)
+                    })
+                    && state.feedback_response_id.as_deref() != Some(id)
+                    && !state.response_create_pending
+                    && active_response_id
+                        .as_deref()
+                        .is_none_or(|active| active == id)
+            });
+        if feedback_accepted {
+            payloads.push(serde_json::json!({"type": "conversation.item.create", "item": {
+                "type": "message", "role": "developer", "content": [{"type": "input_text", "text": feedback.unwrap()}]
+            }}));
+            state.feedback_response_id = state
+                .response_contexts
+                .iter()
+                .find(|response| Some(response.id.as_ref()) == response_id)
+                .map(|response| response.id.clone());
+        }
+        if response_id.is_none() && server_managed_audio {
+            payloads.push(serde_json::json!({"type":"output_audio_buffer.clear"}));
+        }
+        Ok(InterruptActions {
+            payloads,
+            result: RealtimeInterruptResult {
+                cancelled_response_id,
+                retired_response_ids,
+                feedback_accepted,
+                active_response_id,
+            },
+        })
+    }
+}
+
+fn retained_metadata_bytes(state: &ConfigurationState) -> usize {
+    state
+        .response_contexts
+        .iter()
+        .map(|response| response.id.len())
+        .chain(
+            state
+                .received_audio
+                .iter()
+                .map(|record| record.item_id.len()),
+        )
+        .chain(state.audio_input_sources.iter().map(|(id, _)| id.len()))
+        .sum::<usize>()
+        .saturating_add(state.hosted_mcp.bytes())
+}
+
+fn capture_audio_source(state: &mut ConfigurationState, item_id: &str) -> bool {
+    if state
+        .audio_input_sources
+        .iter()
+        .any(|(id, _)| id == item_id)
+    {
+        return false;
+    }
+    loop {
+        if state.audio_input_sources.len() < super::methods::SDK_WIRE_EVENTS_CAPACITY
+            && retained_metadata_bytes(state)
+                .checked_add(item_id.len())
+                .is_some_and(|bytes| bytes <= super::methods::SDK_WIRE_BYTES_CAPACITY)
+        {
+            state.audio_input_sources.push_back((
+                item_id.to_owned(),
+                AudioInputSource {
+                    prior_owner: Arc::clone(&state.request_owner),
+                    owner: Arc::new(()),
+                },
+            ));
+            return true;
+        }
+        if !evict_completed_context(state, None) && !evict_audio_source(state) {
+            break;
+        }
+    }
+    state.failure = Some(ReadyState::Mismatch);
+    false
+}
+
+fn apply_audio_source(state: &mut ConfigurationState, item_id: &str) {
+    if let Some(source) = state
+        .audio_input_sources
+        .iter()
+        .find(|(id, _)| id == item_id)
+        .map(|(_, source)| source)
+        && (Arc::ptr_eq(&state.request_owner, &source.prior_owner)
+            || Arc::ptr_eq(&state.request_owner, &source.owner))
+    {
+        state.request_owner = Arc::clone(&source.owner);
+    }
+}
+
+fn evict_audio_source(state: &mut ConfigurationState) -> bool {
+    let pinned = |owner: &Arc<()>| {
+        Arc::ptr_eq(owner, &state.request_owner)
+            || state
+                .pending_create_owner
+                .as_ref()
+                .is_some_and(|pending| Arc::ptr_eq(owner, pending))
+            || state
+                .response_contexts
+                .iter()
+                .any(|response| Arc::ptr_eq(owner, &response.request_owner))
+    };
+    let Some(index) = state
+        .audio_input_sources
+        .iter()
+        .position(|(_, source)| !pinned(&source.prior_owner) && !pinned(&source.owner))
+    else {
+        return false;
+    };
+    state.audio_input_sources.remove(index);
+    true
+}
+
+fn retain_metadata_room(
+    state: &mut ConfigurationState,
+    extra_bytes: usize,
+    new_context: bool,
+) -> bool {
+    loop {
+        let bytes = retained_metadata_bytes(state);
+        let count_ok = if new_context {
+            state.response_contexts.len() < super::methods::SDK_WIRE_EVENTS_CAPACITY
+        } else {
+            state.received_audio.len() < super::methods::SDK_WIRE_EVENTS_CAPACITY
+        };
+        if count_ok
+            && bytes
+                .checked_add(extra_bytes)
+                .is_some_and(|bytes| bytes <= super::methods::SDK_WIRE_BYTES_CAPACITY)
+        {
+            return true;
+        }
+        if !evict_completed_context(state, None) && !evict_audio_source(state) {
+            return false;
+        }
+    }
+}
+
+fn evict_completed_context(state: &mut ConfigurationState, protected: Option<&str>) -> bool {
+    let active = state.active_response.as_ref().map(|r| r.id.as_ref());
+    let Some(index) = state.response_contexts.iter().position(|r| {
+        Some(r.id.as_ref()) != active
+            && Some(r.id.as_ref()) != protected
+            && !state.hosted_mcp.pins(&r.id)
+    }) else {
+        return false;
+    };
+    let expired = state.response_contexts.remove(index).unwrap();
+    state
+        .received_audio
+        .retain(|record| record.response_id != expired.id);
+    state.hosted_mcp.remove_response(&expired.id);
+    true
+}
+
+impl RealtimeConfigurationReservation {
+    pub(super) fn payload(&self) -> &Value {
+        &self.payload
+    }
+    pub(super) fn receipt(&self) -> RealtimeConfigurationReceipt {
+        self.receipt.clone()
+    }
+    pub(super) fn configuration(&self) -> &RealtimeConfiguration {
+        &self.configuration
+    }
+    pub(super) fn arm(&self) -> Result<(), ApiError> {
+        let mut state = self.configuration.inner.state.lock().unwrap();
+        if state.failure.is_some() {
+            return Err(invalid("Realtime configuration is retired"));
+        }
+        let pending = state
+            .pending
+            .as_mut()
+            .filter(|pending| {
+                pending.id.as_deref() == Some(&self.id) && pending.phase == PendingPhase::Reserved
+            })
+            .ok_or_else(|| invalid("Realtime configuration reservation is stale"))?;
+        pending.phase = PendingPhase::Armed;
+        Ok(())
+    }
+}
+
+// Structural audio containers merge; named settings objects and arrays replace.
+fn apply_contract_update(contract: &mut Value, patch: &Value) {
+    let contract = contract.as_object_mut().expect("typed session contract");
+    for (key, value) in patch.as_object().expect("typed update") {
+        if key == "audio" {
+            let audio = contract
+                .entry(key)
+                .or_insert_with(|| serde_json::json!({}))
+                .as_object_mut()
+                .expect("typed audio");
+            for (channel, fields) in value.as_object().expect("typed audio update") {
+                audio
+                    .entry(channel)
+                    .or_insert_with(|| serde_json::json!({}))
+                    .as_object_mut()
+                    .expect("typed audio channel")
+                    .extend(fields.as_object().expect("typed audio fields").clone());
+            }
+        } else {
+            contract.insert(key.clone(), value.clone());
+        }
+    }
+}
+
+fn accepted_format(session: &Value, channel: &str) -> Option<RealtimeAudioFormat> {
+    let format = &session["audio"][channel]["format"];
+    match format["type"].as_str()? {
+        "audio/pcm" if contains_expected(&format["rate"], &serde_json::json!(24000)) => {
+            Some(RealtimeAudioFormat::Pcm24k)
+        }
+        "audio/pcmu" => Some(RealtimeAudioFormat::G711Ulaw),
+        "audio/pcma" => Some(RealtimeAudioFormat::G711Alaw),
+        _ => None,
+    }
+}
