+    #[tokio::test]
+    async fn retained_attached_readiness_checks_created_profile_and_reports_terminal_failures() {
+        for (session, accepted) in [
+            (json!({"id": "s", "instructions": "brief"}), true),
+            (json!({"id": "s", "instructions": "wrong"}), false),
+        ] {
+            let (connection, send, server) =
+                readiness_connection(json!({"instructions": "brief"}), false).await;
+            send.send(json!({"type": "session.created", "session": session}))
+                .await
+                .unwrap();
+            assert_eq!(
+                tokio::time::timeout(Duration::from_secs(1), connection.wait_ready())
+                    .await
+                    .unwrap()
+                    .is_ok(),
+                accepted
+            );
+            connection.writer().abort_and_join().await;
+            server.abort();
+            let _ = server.await;
+        }
+        let (connection, send, server) = readiness_connection(json!({}), true).await;
+        send.send(json!({"type": "error", "error": {"message": "private provider detail"}}))
+            .await
+            .unwrap();
+        let error = tokio::time::timeout(Duration::from_secs(1), connection.wait_ready())
+            .await
+            .unwrap()
+            .unwrap_err();
+        assert!(!error.to_string().contains("private provider detail"));
+        // The original error remains available to the normal authoritative reader.
+        assert!(matches!(
+            connection.next_event().await.unwrap(),
+            Some(RealtimeEvent::Error(_))
+        ));
+        connection.writer().abort_and_join().await;
+        server.abort();
+        let _ = server.await;
+        let (connection, send, server) = readiness_connection(json!({}), true).await;
+        drop(send);
+        server.await.unwrap();
+        assert!(
+            tokio::time::timeout(Duration::from_secs(1), connection.wait_ready())
+                .await
+                .unwrap()
+                .is_err()
+        );
