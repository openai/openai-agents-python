+        }).await;
+    }
+    let mut statuses = Vec::new();
+    let mut published_ids = Vec::new();
+    for _ in 0..2 {
+        let command =
+            tokio::time::timeout(std::time::Duration::from_secs(5), sdk.commands_rx.recv())
+                .await
+                .unwrap()
+                .unwrap();
+        if let super::SdkRealtimeCommand::FunctionResult {
+            call_id, succeeded, ..
+        } = &command
+        {
+            published_ids.push(call_id.clone());
+            statuses.push(*succeeded);
+        } else {
+            panic!("expected independent function result");
+        }
+        super::handle_sdk_realtime_command(
+            Ok(command),
+            &connection.writer(),
+            &handoff,
+            &mut responses,
+            &tx,
+        )
+        .await
+        .unwrap();
+    }
+    statuses.sort();
+    published_ids.sort();
+    assert_eq!(statuses, [false, true]);
+    assert_eq!(published_ids, ids);
+    let mut finished = Vec::new();
+    while let Ok(event) = rx.try_recv() {
+        if let RealtimeEvent::FunctionCallFinished { succeeded, .. } = event {
+            finished.push(succeeded);
+        }
+    }
+    finished.sort();
+    assert_eq!(finished, [false, true]);
+    let complete = tokio::time::timeout(std::time::Duration::from_secs(5), async {
+        loop {
+            if let EventMsg::TurnComplete(complete) = events.recv().await.unwrap().msg {
+                break complete;
+            }
+        }
+    })
+    .await
+    .unwrap();
+    assert!(complete.error.is_none());
+    assert!(http.received_requests().await.unwrap().is_empty());
+    let persisted = tokio::fs::read_to_string(rollout).await.unwrap();
+    assert!(!persisted.contains("original_private_marker"));
+    assert!(persisted.contains("accepted member 0"));
+    assert!(persisted.contains("accepted member 1"));
+    connection.close().await.unwrap();
+    server.await.unwrap();
+}
