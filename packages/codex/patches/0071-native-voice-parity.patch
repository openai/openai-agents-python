+struct RealtimeBatchWork {
+    task: Arc<RealtimeToolTask>,
+    span: tracing::Span,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct RealtimeToolsDispatch {
+    root_id: Arc<std::sync::OnceLock<String>>,
+    settled: CancellationToken,
+    generation: String,
+    sender: async_channel::Sender<RealtimeBatchWork>,
+    receiver: async_channel::Receiver<RealtimeBatchWork>,
+}
+impl RealtimeToolsDispatch {
+    pub(crate) fn bind_root(&self, root: &str) {
+        self.root_id.get_or_init(|| root.to_owned());
+    }
+    pub(crate) fn root_id(&self) -> Option<&str> {
+        self.root_id.get().map(String::as_str)
+    }
+    pub(crate) fn mark_settled(&self) {
+        self.settled.cancel();
+    }
+    pub(crate) async fn wait_settled(&self) {
+        self.settled.cancelled().await;
+    }
+    pub(crate) fn seal_if_empty(&self, generation: &str) -> bool {
+        if self.generation != generation || !self.receiver.is_empty() {
+            return false;
+        }
+        self.sender.close();
+        true
+    }
+    pub(crate) fn accepts_generation(&self, task: &RealtimeToolTask) -> bool {
+        self.generation == task.calls.first().expect("nonempty batch").sdk.generation
+    }
+    pub(crate) fn try_attach(&self, task: RealtimeToolTask) -> bool {
+        let batch = task.batch.clone();
+        let admitted = self
+            .sender
+            .try_send(RealtimeBatchWork {
+                task: Arc::new(task),
+                span: tracing::Span::current(),
+            })
+            .is_ok();
+        if admitted && let Some(batch) = batch {
+            batch.root_dispatch.get_or_init(|| self.clone());
+            batch.completed.get_or_init(CancellationToken::new);
+        }
+        admitted
+    }
+}
+
+pub(crate) struct RealtimeToolTask {
+    dispatch: std::sync::OnceLock<RealtimeToolsDispatch>,
+    batch: Option<Arc<super::RealtimeFunctionBatch>>,
+    calls: Vec<RealtimeToolCall>,
+    configuration: Option<Arc<codex_api::RealtimeAcceptedConfiguration>>,
+}
+
+impl RealtimeToolTask {
+    fn dispatch(&self) -> RealtimeToolsDispatch {
+        let dispatch = self
+            .dispatch
+            .get_or_init(|| {
+                // Every admitted batch owns a distinct nonempty subset of the existing
+                // 256-call ledger. That also bounds preparing/executing work after drain.
+                let (sender, receiver) = async_channel::bounded(super::SDK_FUNCTION_CALL_LIMIT);
+                RealtimeToolsDispatch {
+                    root_id: Default::default(),
+                    settled: CancellationToken::new(),
+                    generation: self
+                        .calls
+                        .first()
+                        .expect("nonempty batch")
+                        .sdk
+                        .generation
+                        .clone(),
+                    sender,
+                    receiver,
+                }
+            })
+            .clone();
+        if let Some(batch) = &self.batch {
+            batch.root_dispatch.get_or_init(|| dispatch.clone());
+        }
+        dispatch
+    }
+
+    fn execution_source(&self) -> Result<RealtimeToolExecutionSource, CodexErr> {
+        self.configuration
+            .as_ref()
+            .and_then(|configuration| configuration.native_source.as_ref())
+            .and_then(|source| source.as_any().downcast_ref::<RealtimeToolSource>())
+            .map(|source| source.execution.clone())
+            .ok_or_else(|| CodexErr::InvalidRequest("Unknown native Realtime source".into()))
+    }
+
+    async fn execute_work(
+        self: Arc<Self>,
+        session: Arc<Session>,
+        root: Arc<TurnContext>,
+        cancellation: CancellationToken,
+        initial: bool,
+    ) -> Result<(), CodexErr> {
+        if let Some(batch) = &self.batch {
+            batch.completed.get_or_init(CancellationToken::new);
+        }
+        let preparing = async {
+            if initial {
+                Ok(Arc::clone(&root))
+            } else {
+                let source = self
+                    .source_settings(&session)?
+                    .ok_or_else(|| CodexErr::InvalidRequest("Realtime source is absent".into()))?;
+                let mut context = session
+                    .new_realtime_tool_turn_from_source(
+                        root.sub_id.clone(),
+                        source,
+                        None,
+                        Default::default(),
+                    )
+                    .await?;
+                Arc::get_mut(&mut context)
+                    .ok_or_else(|| {
+                        CodexErr::InvalidRequest("Realtime batch context is already shared".into())
+                    })?
+                    .extension_data = Arc::clone(&root.extension_data);
+                Ok(context)
+            }
+        };
+        // Context construction has not dispatched a tool and remains cancelable.
+        let context = tokio::select! {
+            biased;
+            _ = cancellation.cancelled() => Err(CodexErr::TurnAborted),
+            _ = self.calls.first().expect("nonempty batch").cancel.cancelled() => Err(CodexErr::TurnAborted),
+            result = preparing => result,
+        };
+        let result = match context {
+            Ok(context) => {
+                let execution = cancellation.child_token();
+                let running = self.run_batch(
+                    Arc::clone(&session),
+                    Arc::clone(&root),
+                    context,
+                    execution.clone(),
+                );
+                tokio::pin!(running);
+                tokio::select! {
+                    biased;
+                    _ = cancellation.cancelled() => {
+                        execution.cancel();
+                        running.await.map(|_| ())
+                    }
+                    _ = self.calls.first().expect("nonempty batch").cancel.cancelled() => {
+                        execution.cancel();
+                        running.await.map(|_| ())
+                    }
+                    result = &mut running => result.map(|_| ()),
+                }
+            }
+            Err(error) => Err(error),
+        };
+        if result.is_err() {
+            self.abort_batch(Arc::clone(&session)).await;
+        }
+        if let Some(batch) = &self.batch {
+            // A dropped/aborted future must never certify dispatched work joined.
+            batch.completed.get_or_init(CancellationToken::new).cancel();
+        }
+        for call in &self.calls {
+            if let Some(owned) = call
+                .sdk
+                .function_calls
+                .lock()
+                .await
+                .get(&call.request.call_id)
+            {
+                owned.completed.cancel();
+            }
+        }
+        result
+    }
+
+    async fn terminal_queue_error(&self, session: &Arc<Session>) -> CodexErr {
+        let sdk = &self.calls.first().expect("nonempty batch").sdk;
+        let message = "SDK Realtime completion queue is full or closed";
+        if sdk.active.load(Ordering::Acquire) {
+            // Reuse the generation's joined retirement; never await our own cleanup.
+            let _ = session
+                .conversation
+                .begin_shutdown_sdk(&sdk.generation)
+                .await;
+            session
+                .send_event_raw(codex_protocol::protocol::Event {
+                    id: sdk.generation.clone(),
+                    msg: codex_protocol::protocol::EventMsg::RealtimeConversationRealtime(
+                        codex_protocol::protocol::RealtimeConversationRealtimeEvent {
+                            payload: codex_protocol::protocol::RealtimeEvent::Error(message.into()),
+                        },
+                    ),
+                })
+                .await;
+        }
+        CodexErr::InvalidRequest(message.into())
+    }
+
+    async fn retire_requested_response(&self, session: &Arc<Session>) {
+        if let Some(batch) = &self.batch {
+            batch.automatic_retired.store(true, Ordering::Release);
+            batch.pending_create.store(false, Ordering::Release);
+            batch.handoff_pending.store(false, Ordering::Release);
+            let committed = batch.committed_target.lock().unwrap().is_some();
+            if !committed
+                && self
+                    .calls
+                    .first()
+                    .expect("nonempty batch")
+                    .sdk
+                    .commands_tx
+                    .try_send(SdkRealtimeCommand::FinishBatch(Arc::clone(batch)))
+                    .is_err()
+            {
+                // This wake also owns any held explicit user input and cannot be lost.
+                let _ = self.terminal_queue_error(session).await;
+            }
+        }
+    }
+
+    pub(crate) fn preparation_cancellation(&self) -> CancellationToken {
+        self.calls.first().expect("nonempty batch").cancel.clone()
+    }
+    pub(super) fn single(
+        sdk: Arc<SdkRealtimeState>,
+        request: RealtimeFunctionCallRequested,
+        definition: RealtimeFunctionTool,
+        cancel: CancellationToken,
+        configuration: Option<Arc<codex_api::RealtimeAcceptedConfiguration>>,
+        native_name: codex_tools::ToolName,
+        batch: Option<Arc<super::RealtimeFunctionBatch>>,
+    ) -> Self {
+        Self {
+            dispatch: std::sync::OnceLock::new(),
+            batch: batch.clone(),
+            calls: vec![RealtimeToolCall::new(
+                sdk,
+                request,
+                definition,
+                cancel,
+                native_name,
+                batch,
+            )],
+            configuration,
+        }
+    }
+    pub(super) fn batch(
+        _sdk: Arc<SdkRealtimeState>,
+        calls: Vec<RealtimeToolCall>,
+        configuration: Arc<codex_api::RealtimeAcceptedConfiguration>,
+        batch: Arc<super::RealtimeFunctionBatch>,
+    ) -> Self {
+        Self {
+            dispatch: std::sync::OnceLock::new(),
+            batch: Some(batch),
+            calls,
+            configuration: Some(configuration),
+        }
+    }
+    pub(crate) fn seed_source_context(
+        &self,
+        context: &Arc<TurnContext>,
+    ) -> codex_protocol::error::Result<()> {
+        if let Some(configuration) = &self.configuration {
+            let source = configuration
+                .native_source
+                .as_ref()
+                .and_then(|source| source.as_any().downcast_ref::<RealtimeToolSource>())
+                .ok_or_else(|| CodexErr::InvalidRequest("Unknown native Realtime source".into()))?;
+            context.extension_data.insert(source.execution.clone());
+        }
+        Ok(())
+    }
+    pub(crate) fn source_settings(
+        &self,
+        session: &Arc<Session>,
+    ) -> codex_protocol::error::Result<
+        Option<Arc<crate::session::step_settings::ResolvedStepSettings>>,
+    > {
+        self.configuration
+            .as_ref()
+            .map(|configuration| source_settings(session, configuration))
+            .transpose()
+    }
+}
+
+impl RealtimeToolTask {
+    async fn run_batch(
+        &self,
+        session: Arc<Session>,
+        root: Arc<TurnContext>,
+        ctx: Arc<TurnContext>,
+        cancellation: CancellationToken,
+    ) -> SessionTaskResult {
+        let step = session
+            .capture_realtime_tool_step(Arc::clone(&ctx), self.execution_source()?, &cancellation)
+            .await?;
+        let runtime = ToolCallRuntime::new(
+            Arc::clone(&session),
+            Arc::clone(&step),
+            Arc::new(Mutex::new(TurnDiffTracker::new())),
+        );
+        let execution = cancellation.child_token();
+        let _cancel_on_exit = execution.clone().drop_guard();
+        let mut calls = futures::stream::FuturesUnordered::new();
+        for call in &self.calls {
+            runtime.observe_requested_handoff(&call.native_name, &call.native_call_id);
+        }
+        if let Some(batch) = &self.batch {
+            let requested = step.settings.agent_profile.as_ref().is_some_and(|profile| {
+                profile
+                    .profile
+                    .data
+                    .get::<codex_extension_api::AgentProfileHandoffTools>()
+                    .is_some_and(|roles| {
+                        self.calls.iter().any(|call| {
+                            roles
+                                .targets
+                                .contains_key(&call.native_name.clone().with_default_namespace())
+                        })
+                    })
+            });
+            // Publish the hold before any sibling can finish or enqueue a response.
+            batch.handoff_pending.store(requested, Ordering::Release);
+        }
+        let result = async {
+            for call in &self.calls {
+                calls.push(call.run(
+                    Arc::clone(&session),
+                    Arc::clone(&ctx),
+                    Arc::clone(&step),
+                    runtime.clone(),
+                    execution.clone(),
+                    cancellation.clone(),
+                ));
+            }
+            let mut failure = None;
+            while let Some(result) = calls.next().await {
+                if let Err(error) = result {
+                    failure.get_or_insert(error);
+                }
+            }
+            if let Some(error) = failure {
+                return Err(error);
+            }
+            let accepted = runtime.accepted_handoff();
+            if let Some(accepted) = &accepted {
+                let target = session
+                    .activate_agent_at_tool_boundary(&root, &cancellation, Some(accepted))
+                    .await?
+                    .filter(|target| target.profile_id == accepted.target_profile_id)
+                    .ok_or_else(|| {
+                        CodexErr::InvalidRequest(
+                            "Accepted native handoff was not committed to its target".into(),
+                        )
+                    })?;
+                // No await between receipt publication and batch completion enqueue.
+                let batch = self.batch.as_ref().ok_or_else(|| {
+                    CodexErr::InvalidRequest("Handoff has no completed response batch".into())
+                })?;
+                *batch.committed_target.lock().unwrap() = Some(target);
+            }
+            if let Some(batch) = &self.batch {
+                let sdk = &self.calls.first().expect("nonempty batch").sdk;
+                if !sdk.active.load(Ordering::Acquire) {
+                    return Err(CodexErr::TurnAborted);
+                }
+                if sdk
+                    .commands_tx
+                    .try_send(SdkRealtimeCommand::FinishBatch(Arc::clone(batch)))
+                    .is_err()
+                {
+                    return Err(self.terminal_queue_error(&session).await);
+                }
+            }
+            Ok(None)
+        }
+        .await;
+        result
+    }
+    async fn abort_batch(&self, session: Arc<Session>) {
+        if let Some(batch) = &self.batch {
+            batch.automatic_retired.store(true, Ordering::Release);
+            batch.pending_create.store(false, Ordering::Release);
+            batch.handoff_pending.store(false, Ordering::Release);
+        }
+        for call in &self.calls {
+            let _ = call
+                .publish(&session, "The function failed.".into(), false, true, None)
+                .await;
+        }
+        self.retire_requested_response(&session).await;
+    }
+}
+
+impl SessionTask for RealtimeToolTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "session_task.realtime_tools"
+    }
+    fn realtime_tools(&self) -> Option<RealtimeToolsDispatch> {
+        Some(self.dispatch())
+    }
+    async fn run(
+        self: Arc<Self>,
+        session: Arc<Session>,
+        ctx: Arc<TurnContext>,
+        _input: Vec<TurnInput>,
+        cancellation: CancellationToken,
+    ) -> SessionTaskResult {
+        session.emit_turn_started(&ctx).await;
+        tokio::select! {
+            biased;
+            _ = cancellation.cancelled() => return Err(CodexErr::TurnAborted),
+            _ = session.emit_turn_start_lifecycle(&ctx, None, TurnStartPhase::RegularTaskStart) => {}
+        }
+        let dispatch = self.dispatch();
+        let mut work = futures::stream::FuturesUnordered::new();
+        work.push(
+            Arc::clone(&self)
+                .execute_work(
+                    Arc::clone(&session),
+                    Arc::clone(&ctx),
+                    cancellation.clone(),
+                    true,
+                )
+                .boxed(),
+        );
+        let mut stopping = false;
+        let mut fatal_error = None;
+        loop {
+            // Last-work closure and attachment both hold active_turn. A sender
+            // can never receive acceptance after this root commits to finishing.
+            if work.is_empty() {
+                let _active = session.active_turn.lock().await;
+                while let Ok(next) = dispatch.receiver.try_recv() {
+                    work.push(
+                        next.task
+                            .execute_work(
+                                Arc::clone(&session),
+                                Arc::clone(&ctx),
+                                cancellation.clone(),
+                                false,
+                            )
+                            .instrument(next.span)
+                            .boxed(),
+                    );
+                }
+                if work.is_empty() {
+                    dispatch.sender.close();
+                    break;
+                }
+            }
+            tokio::select! {
+                biased;
+                _ = cancellation.cancelled(), if !stopping => {
+                    stopping = true;
+                    dispatch.sender.close();
+                    while let Ok(next) = dispatch.receiver.try_recv() {
+                        work.push(next.task.execute_work(Arc::clone(&session), Arc::clone(&ctx), cancellation.clone(), false).instrument(next.span).boxed());
+                    }
+                }
+                next = dispatch.receiver.recv(), if !dispatch.sender.is_closed() => {
+                    if let Ok(next) = next {
+                        work.push(next.task.execute_work(Arc::clone(&session), Arc::clone(&ctx), cancellation.clone(), false).instrument(next.span).boxed());
+                    }
+                }
+                result = work.next(), if !work.is_empty() => {
+                    if let Some(Err(error)) = result {
+                        if matches!(error.details(), codex_protocol::error::CodexErrorDetails::Fatal(_) | codex_protocol::error::CodexErrorDetails::Io(_)) {
+                            let _ = self.terminal_queue_error(&session).await;
+                            fatal_error.get_or_insert(error);
+                            cancellation.cancel();
+                        }
+                    }
+                }
+            }
+        }
+        if let Some(error) = fatal_error {
+            Err(error)
+        } else if cancellation.is_cancelled() {
+            Err(CodexErr::TurnAborted)
+        } else {
+            Ok(None)
+        }
+    }
+    async fn abort(&self, session: Arc<Session>, ctx: Arc<TurnContext>) {
+        let dispatch = self.dispatch();
+        dispatch.sender.close();
+        while let Ok(work) = dispatch.receiver.try_recv() {
+            work.task.abort_batch(Arc::clone(&session)).await;
+            if let Some(batch) = &work.task.batch {
+                batch.completed.get_or_init(CancellationToken::new).cancel();
+            }
+        }
+        // The task runner joins this tools root before invoking abort. Running
+        // batch execution has drained; settle any never-started registered work.
+        let sdk = &self.calls.first().expect("nonempty batch").sdk;
+        let members = {
+            let mut calls = sdk.function_calls.lock().await;
+            calls
+                .values_mut()
+                .filter(|call| call.native_turn_id.as_deref() == Some(&ctx.sub_id))
+                .map(|call| {
+                    call.cancel.cancel();
+                    call.completed.cancel();
+                    (call.request.call_id.clone(), call.batch.clone())
+                })
+                .collect::<Vec<_>>()
+        };
+        for (id, batch) in members {
+            let _ = session
+                .conversation
+                .sdk_enqueue(
+                    &sdk.generation,
+                    SdkRealtimeCommand::FunctionResult {
+                        call_id: id,
+                        text: "The function failed.".into(),
+                        succeeded: false,
+                        start_response: false,
+                        cancellation: None,
+                    },
+                )
+                .await;
+            if let Some(batch) = batch {
+                batch.automatic_retired.store(true, Ordering::Release);
+                batch.pending_create.store(false, Ordering::Release);
+                batch.handoff_pending.store(false, Ordering::Release);
+                batch.completed.get_or_init(CancellationToken::new).cancel();
+                let committed = batch.committed_target.lock().unwrap().is_some();
+                if !committed
+                    && sdk
+                        .commands_tx
+                        .try_send(SdkRealtimeCommand::FinishBatch(batch.clone()))
+                        .is_err()
+                {
+                    let _ = self.terminal_queue_error(&session).await;
+                }
+            }
+        }
+        self.abort_batch(session).await;
+        if let Some(batch) = &self.batch {
+            batch.completed.get_or_init(CancellationToken::new).cancel();
+        }
+    }
+}
