+        strict: None,
+    };
+    let (manager, sdk) = sdk_manager_with_tools("dedup-generation", vec![definition]);
+    let handoff = manager
+        .state
+        .lock()
+        .await
+        .conversation
+        .as_ref()
+        .unwrap()
+        .handoff
+        .clone();
+    let (tx, rx) = bounded(8);
+    let mut audio = None;
+    let mut responses = super::RealtimeResponseCreateQueue::default();
+    let request = RealtimeFunctionCallRequested {
+        namespace: None,
+        call_id: "call".into(),
+        item_id: "item".into(),
+        name: "function".into(),
+        arguments: "{}".into(),
+        response_id: None,
+    };
+    for event in [
+        RealtimeEvent::ResponseCreated(RealtimeResponseCreated {
+            profile_receipt: None,
+            response_id: Some("A".into()),
+        }),
+        RealtimeEvent::FunctionCallRequested(request.clone()),
+        RealtimeEvent::ResponseDone(RealtimeResponseDone {
+            response_id: Some("A".into()),
+            // The uncorrelated call is not an authoritative member of A.
+            function_call_ids: Vec::new(),
+        }),
+        RealtimeEvent::ResponseCreated(RealtimeResponseCreated {
+            profile_receipt: None,
+            response_id: Some("B".into()),
+        }),
+        RealtimeEvent::FunctionCallRequested(request.clone()),
+    ] {
+        super::handle_realtime_server_event(
+            event,
+            &connection.writer(),
+            &tx,
+            &handoff,
+            RealtimeSessionKind::V2,
+            &mut audio,
+            &mut responses,
+        )
+        .await
+        .unwrap();
+    }
+    assert_eq!(
+        sdk.function_calls.lock().await["call"].request.response_id,
+        None
+    );
+    let mut received = 0;
+    while let Ok(event) = rx.try_recv() {
+        if let RealtimeEvent::FunctionCallRequested(call) = event {
+            received += 1;
+            assert_eq!(call.response_id, None);
+        }
+    }
+    assert_eq!(received, 1);
+    let mut explicit = request.clone();
+    explicit.response_id = Some("A".into());
+    super::handle_realtime_server_event(
+        RealtimeEvent::FunctionCallRequested(explicit.clone()),
+        &connection.writer(),
+        &tx,
+        &handoff,
+        RealtimeSessionKind::V2,
+        &mut audio,
+        &mut responses,
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        sdk.function_calls.lock().await["call"]
+            .request
+            .response_id
+            .as_deref(),
+        Some("A")
+    );
+    super::handle_realtime_server_event(
+        RealtimeEvent::FunctionCallRequested(request),
+        &connection.writer(),
+        &tx,
+        &handoff,
+        RealtimeSessionKind::V2,
+        &mut audio,
+        &mut responses,
+    )
+    .await
+    .unwrap();
+    assert!(rx.is_empty());
+    explicit.response_id = Some("B".into());
+    assert!(
+        super::handle_realtime_server_event(
+            RealtimeEvent::FunctionCallRequested(explicit.clone()),
+            &connection.writer(),
+            &tx,
+            &handoff,
+            RealtimeSessionKind::V2,
+            &mut audio,
+            &mut responses
+        )
+        .await
+        .is_err()
+    );
+    explicit.response_id = Some("A".into());
+    explicit.arguments = "{\"changed\":true}".into();
+    assert!(
+        super::handle_realtime_server_event(
+            RealtimeEvent::FunctionCallRequested(explicit.clone()),
+            &connection.writer(),
+            &tx,
+            &handoff,
+            RealtimeSessionKind::V2,
+            &mut audio,
+            &mut responses
+        )
+        .await
+        .is_err()
+    );
+    explicit.call_id = "namespaced-call".into();
+    explicit.namespace = Some("other".into());
+    assert!(
+        super::handle_realtime_server_event(
+            RealtimeEvent::FunctionCallRequested(explicit),
+            &connection.writer(),
+            &tx,
+            &handoff,
+            RealtimeSessionKind::V2,
+            &mut audio,
+            &mut responses
+        )
+        .await
+        .is_err()
+    );
+    assert!(
+        !sdk.function_calls
+            .lock()
+            .await
+            .contains_key("namespaced-call")
+    );
+    manager.shutdown_sdk("dedup-generation").await.unwrap();
+    connection.writer().abort_and_join().await;
+    server.abort();
+    let _ = server.await;
+}
