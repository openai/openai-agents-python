+async fn sdk_handoff_ack_race(interrupt: bool, queued_user: bool) {
+    use super::{
+        RealtimeFunctionBatch, SdkFunctionCall, SdkHandoffContinuation, SdkRealtimeCommand,
+    };
+    use std::sync::atomic::{AtomicBool, Ordering};
+    let target = codex_protocol::agent_profile::AgentProfileReceipt {
+        profile_id: "target-B".into(),
+        epoch: 2,
+    };
+    let source_a: Arc<dyn codex_api::RealtimeNativeSource> = Arc::new(RealtimeAckSource(
+        codex_protocol::agent_profile::AgentProfileReceipt {
+            profile_id: "source-A".into(),
+            epoch: 1,
+        },
+    ));
+    let source_b: Arc<dyn codex_api::RealtimeNativeSource> =
+        Arc::new(RealtimeAckSource(target.clone()));
+    let (connection, mut wire, server, control) = sdk_wire_connection_controlled(
+        Some(source_a),
+        vec![codex_protocol::realtime_settings::RealtimeFunctionTool {
+            name: "transfer_to_B".into(),
+            description: None,
+            parameters: serde_json::json!({"type":"object","properties":{}}),
+            strict: None,
+        }],
+        "handoff-response",
+    )
+    .await;
+    wire.recv().await.unwrap();
+    let writer = connection.writer();
+    writer.send_response_create().await.unwrap();
+    assert_eq!(wire.recv().await.unwrap()["type"], "response.create");
+    while !matches!(
+        connection.next_event().await.unwrap(),
+        Some(codex_api::RealtimeEvent::ResponseCreated(_))
+    ) {}
+    let provider_call = serde_json::json!({"type":"function_call","id":"accepted-item","call_id":"accepted-handoff","name":"transfer_to_B","arguments":"{}","status":"completed"});
+    control.send(SdkWireControl::Event(serde_json::json!({"type":"response.output_item.done","response_id":"handoff-response","output_index":0,"item":provider_call}))).unwrap();
+    control.send(SdkWireControl::Event(serde_json::json!({"type":"response.done","response":{"id":"handoff-response","status":"completed","output":[provider_call]}}))).unwrap();
+    while !matches!(
+        connection.next_event().await.unwrap(),
+        Some(codex_api::RealtimeEvent::ResponseDone(_))
+    ) {}
+    // The committed fixture's accepted output has also crossed the actual wire.
+    writer
+        .send_conversation_function_call_output("accepted-handoff".into(), String::new())
+        .await
+        .unwrap();
+    assert_eq!(
+        wire.recv().await.unwrap()["type"],
+        "conversation.item.create"
+    );
+    let configuration = writer.configuration().unwrap();
+    let batch = Arc::new(RealtimeFunctionBatch {
+        completed: std::sync::OnceLock::new(),
+        root_dispatch: std::sync::OnceLock::new(),
+        response_id: "handoff-response".into(),
+        call_ids: vec!["accepted-handoff".into()],
+        configuration: configuration.accepted().unwrap(),
+        handoff_pending: AtomicBool::new(false),
+        handoff_accepted: AtomicBool::new(true),
+        pending_create: AtomicBool::new(true),
+        user_create: AtomicBool::new(false),
+        automatic_retired: AtomicBool::new(false),
+        committed_target: std::sync::Mutex::new(Some(target.clone())),
+        update_reserved: AtomicBool::new(true),
+        continued: AtomicBool::new(false),
+    });
+    let (manager, sdk) = sdk_manager("ack-generation");
+    *sdk.configuration.lock().unwrap() = Some(configuration.clone());
+    sdk.function_calls.lock().await.insert(
+        "accepted-handoff".into(),
+        SdkFunctionCall {
+            preparation: None,
+            request: codex_protocol::protocol::RealtimeFunctionCallRequested {
+                namespace: None,
+                call_id: "accepted-handoff".into(),
+                item_id: "accepted-item".into(),
+                response_id: Some("handoff-response".into()),
+                name: "transfer_to_B".into(),
+                arguments: "{}".into(),
+            },
+            claimed: true,
+            native_turn_id: None,
+            cancel: tokio_util::sync::CancellationToken::new(),
+            completed: tokio_util::sync::CancellationToken::new(),
+            configuration: Some(Arc::clone(&batch.configuration)),
+            batch: Some(Arc::clone(&batch)),
+        },
+    );
+    let handoff = manager
+        .state
+        .lock()
+        .await
+        .conversation
+        .as_ref()
+        .unwrap()
+        .handoff
+        .clone();
+    let (tx, _rx) = bounded(4);
+    let mut responses = super::RealtimeResponseCreateQueue::default();
+    // A distinct refresh accepting exactly the same B source cannot release this batch.
+    let unrelated = configuration
+        .reserve_update_with_source(
+            &codex_protocol::realtime_settings::RealtimeSessionUpdate {
+                instructions: Some("unrelated B refresh".into()),
+                ..Default::default()
+            },
+            Arc::clone(&source_b),
+        )
+        .unwrap();
+    super::handle_sdk_realtime_command(
+        Ok(SdkRealtimeCommand::ApplyUpdate {
+            reservation: unrelated,
+            continuation: None,
+            delegation: None,
+            reply: None,
+        }),
+        &writer,
+        &handoff,
+        &mut responses,
+        &tx,
+    )
+    .await
+    .unwrap();
+    assert_eq!(wire.recv().await.unwrap()["type"], "session.update");
+    assert!(!batch.continued.load(Ordering::Acquire));
+    assert!(wire.try_recv().is_err());
+    if queued_user {
+        // The user request precedes native acceptance while another response is live.
+        batch.handoff_accepted.store(false, Ordering::Release);
+        control
+            .send(SdkWireControl::Event(
+                serde_json::json!({"type":"response.created","response":{"id":"live-response"}}),
+            ))
+            .unwrap();
+        let created = loop {
+            if let Some(event @ codex_api::RealtimeEvent::ResponseCreated(_)) =
+                connection.next_event().await.unwrap()
+            {
+                break event;
+            }
+        };
+        let mut audio = None;
+        super::handle_realtime_server_event(
+            created,
+            &writer,
+            &tx,
+            &handoff,
+            RealtimeSessionKind::V2,
+            &mut audio,
+            &mut responses,
+        )
+        .await
+        .unwrap();
+        super::handle_sdk_realtime_command(
+            Ok(SdkRealtimeCommand::Text(ConversationTextParams {
+                text: "queued explicit user text".into(),
+                role: ConversationTextRole::User,
+            })),
+            &writer,
+            &handoff,
+            &mut responses,
+            &tx,
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            wire.recv().await.unwrap()["type"],
+            "conversation.item.create"
+        );
+        assert!(responses.pending_create && responses.pending_user_create);
+        batch.handoff_accepted.store(true, Ordering::Release);
+        let stale = codex_api::RealtimeEvent::ResponseDone(
+            codex_protocol::protocol::RealtimeResponseDone {
+                response_id: Some("stale-response".into()),
+                function_call_ids: Vec::new(),
+            },
+        );
+        super::handle_realtime_server_event(
+            stale,
+            &writer,
+            &tx,
+            &handoff,
+            RealtimeSessionKind::V2,
+            &mut audio,
+            &mut responses,
+        )
+        .await
+        .unwrap();
+        assert!(responses.pending_create && responses.pending_user_create);
+        assert!(!batch.user_create.load(Ordering::Acquire));
+        control.send(SdkWireControl::Event(serde_json::json!({"type":"response.done","response":{"id":"live-response","status":"completed","output":[]}}))).unwrap();
+        let done = loop {
+            if let Some(event @ codex_api::RealtimeEvent::ResponseDone(_)) =
+                connection.next_event().await.unwrap()
+            {
+                break event;
+            }
+        };
+        super::handle_realtime_server_event(
+            done,
+            &writer,
+            &tx,
+            &handoff,
+            RealtimeSessionKind::V2,
+            &mut audio,
+            &mut responses,
+        )
+        .await
+        .unwrap();
+        assert!(!responses.pending_create && !responses.pending_user_create);
+        assert!(batch.user_create.load(Ordering::Acquire));
+    }
+    let (receipt_tx, receipt_rx) = tokio::sync::oneshot::channel();
+    control
+        .send(SdkWireControl::AutoAcknowledge(false, receipt_tx))
+        .unwrap();
+    receipt_rx.await.unwrap();
+    let exact = configuration
+        .reserve_update_with_source(
+            &codex_protocol::realtime_settings::RealtimeSessionUpdate {
+                instructions: Some("exact target B update".into()),
+                ..Default::default()
+            },
+            Arc::clone(&source_b),
+        )
+        .unwrap();
+    let command = SdkRealtimeCommand::ApplyUpdate {
+        reservation: exact,
+        continuation: Some(SdkHandoffContinuation {
+            batch: Arc::clone(&batch),
+            source: source_b,
+        }),
+        delegation: None,
+        reply: None,
+    };
+    let task_writer = writer.clone();
+    let task_handoff = handoff.clone();
+    let mut apply = tokio::spawn(async move {
+        super::handle_sdk_realtime_command(
+            Ok(command),
+            &task_writer,
+            &task_handoff,
+            &mut responses,
+            &tx,
+        )
+        .await
+        .unwrap();
+        responses
+    });
+    assert_eq!(wire.recv().await.unwrap()["type"], "session.update");
+    assert!(
+        tokio::time::timeout(std::time::Duration::from_millis(40), &mut apply)
+            .await
+            .is_err()
+    );
+    assert!(!batch.continued.load(Ordering::Acquire));
+    if interrupt {
+        manager
+            .retire_sdk_tool_work("ack-generation", false, Some("handoff-response"))
+            .await;
+        assert!(batch.automatic_retired.load(Ordering::Acquire));
+        assert_eq!(
+            *batch.committed_target.lock().unwrap(),
+            Some(target.clone())
+        );
+    }
+    let (next_tx, next_rx) = tokio::sync::oneshot::channel();
+    control
+        .send(SdkWireControl::ResponseId("target-response", next_tx))
+        .unwrap();
+    next_rx.await.unwrap();
+    control.send(SdkWireControl::Acknowledge).unwrap();
+    let mut responses = tokio::time::timeout(std::time::Duration::from_secs(2), apply)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(batch.continued.load(Ordering::Acquire));
+    assert_eq!(
+        configuration.accepted().unwrap().profile_receipt(),
+        Some(&target)
+    );
+    if interrupt && !queued_user {
+        assert!(wire.try_recv().is_err());
+        // A new explicit request uses the accepted B configuration.
+        super::request_sdk_response_create(
+            &sdk,
+            &writer,
+            &mut responses,
+            "new explicit request",
+            None,
+            false,
+        )
+        .await
+        .unwrap();
+    }
+    assert_eq!(wire.recv().await.unwrap()["type"], "response.create");
+    assert!(wire.try_recv().is_err());
+    connection.close().await.unwrap();
+    server.await.unwrap();
+}
