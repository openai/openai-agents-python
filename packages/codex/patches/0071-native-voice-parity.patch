@@ -0,0 +1,64 @@
+//! Declaration-only snapshots for an SDK-owned Realtime connection.
+use crate::{CapturedAgentProfile, ExtensionData, ExtensionDataInit};
+
+/// Captured native owners, without creating a turn or invoking step selectors.
+pub struct RealtimeToolCaptureInput<'a> {
+    pub session_store: &'a ExtensionData,
+    pub thread_store: &'a ExtensionData,
+    pub profile: Option<&'a CapturedAgentProfile>,
+    pub mcp: Option<&'a codex_mcp::McpBinding>,
+    /// Binding-only projection must reuse this frozen generation/default/MCP source.
+    /// Initial declaration capture uses `None` before starting network preparation.
+    pub retained_execution_data: Option<&'a ExtensionDataInit>,
+}
+
+/// One normalized declaration and its exact native routing identity.
+pub struct RealtimeToolDeclaration {
+    pub native_name: codex_tools::ToolName,
+    pub spec: crate::PreparedToolPresentation,
+}
+
+/// Immutable source inputs. Execution creates a fresh step and runs normal selectors.
+pub struct RealtimeToolDeclarations {
+    /// Exact immutable catalog/profile identity, captured with original tool validation.
+    pub selection_id: String,
+    /// Already accepted native application instructions, never rendered by this hook.
+    pub application_instructions: Option<String>,
+    pub tools: Vec<RealtimeToolDeclaration>,
+    /// Captured generation/defaults only; never pending selection or turn admission state.
+    pub execution_data: ExtensionDataInit,
+}
+
+/// Canonical private selection key; scoped to the native thread and actual source profile.
+pub fn realtime_tool_selection_id(
+    thread_scope: &str,
+    generation: u64,
+    profile: Option<&codex_protocol::agent_profile::AgentProfileReceipt>,
+) -> String {
+    serde_json::to_string(&(thread_scope, generation, profile))
+        .expect("selection identity contains only JSON primitives")
+}
+
+/// Existing native namespace/name convention at the flat Realtime wire boundary.
+pub fn realtime_tool_wire_name(name: &codex_tools::ToolName) -> String {
+    codex_tools::code_mode_name_for_tool_name(name)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn native_aliases_preserve_namespace_and_tool_underscores() {
+        let name = |server: &str, tool: &str| {
+            realtime_tool_wire_name(&codex_tools::ToolName::namespaced(server, tool))
+        };
+        assert_ne!(name("mcp__a", "lookup"), name("mcp__a_", "lookup"));
+        assert_ne!(name("mcp__a", "lookup"), name("mcp__a", "_lookup"));
+        assert_eq!(
+            name("mcp__a_", "lookup"),
+            codex_tools::code_mode_name_for_tool_name(&codex_tools::ToolName::namespaced(
+                "mcp__a_", "lookup"
+            ))
+        );
+    }
+}
