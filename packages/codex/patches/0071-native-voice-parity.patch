+    );
+    // A duplicate terminal event is inert even after the batch has been claimed.
+    super::handle_realtime_server_event_with_configuration(
+        done,
+        &connection.writer(),
+        &tx,
+        &handoff,
+        RealtimeSessionKind::V2,
+        &mut audio,
+        &mut responses,
+        Some(configuration),
