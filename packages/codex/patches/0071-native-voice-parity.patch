+#[cfg(test)]
+mod realtime_mcp_environment_tests {
+    use super::*;
+
+    #[test]
+    fn retained_mcp_environment_projection_preserves_exact_host_cwds() {
+        let fallback = AbsolutePathBuf::try_from(std::env::temp_dir()).unwrap();
+        let selected = fallback.join("selected");
+        let changed = fallback.join("changed");
+        let local = codex_config::DEFAULT_MCP_SERVER_ENVIRONMENT_ID.to_string();
+        let local_fallback = HashMap::from([(local.clone(), PathUri::from_abs_path(&fallback))]);
+        // The SDK reserves a lazy MCP executor without selecting a workspace.
+        assert_eq!(
+            realtime_mcp_environment_cwds(&[], &fallback),
+            local_fallback
+        );
+        assert_ne!(realtime_mcp_environment_cwds(&[], &changed), local_fallback);
+        for id in [local.as_str(), "remote"] {
+            let environment = TurnEnvironmentSelection {
+                environment_id: id.to_string(),
+                cwd: PathUri::from_abs_path(&selected),
+                workspace_roots: Vec::new(),
+                config: EnvironmentConfigState::FromThread,
+            };
+            let expected = HashMap::from([
+                (local.clone(), PathUri::from_abs_path(&selected)),
+                (id.to_string(), PathUri::from_abs_path(&selected)),
+            ]);
+            let projected =
+                realtime_mcp_environment_cwds(std::slice::from_ref(&environment), &fallback);
+            assert_eq!(projected, expected);
+            let mut moved = environment.clone();
+            moved.cwd = PathUri::from_abs_path(&changed);
+            assert_ne!(realtime_mcp_environment_cwds(&[moved], &fallback), expected);
+            let mut renamed = environment;
+            renamed.environment_id = "other".to_string();
+            assert_ne!(
+                realtime_mcp_environment_cwds(&[renamed], &fallback),
+                expected
+            );
+            let mut extra = expected.clone();
+            extra.insert("unadmitted".to_string(), PathUri::from_abs_path(&selected));
+            assert_ne!(projected, extra);
+        }
+    }
+}
