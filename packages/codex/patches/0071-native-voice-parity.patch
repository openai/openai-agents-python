+async fn set_sdk_wire_response_id(
+    control: &tokio::sync::mpsc::UnboundedSender<SdkWireControl>,
+    id: &'static str,
+) {
+    let (tx, rx) = tokio::sync::oneshot::channel();
+    control.send(SdkWireControl::ResponseId(id, tx)).unwrap();
+    rx.await.unwrap();
+}
