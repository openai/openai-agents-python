+#[tokio::test]
+async fn sdk_terminal_handoff_rollover_preserves_recent_duplicates() {
+    use codex_protocol::protocol::RealtimeEvent;
+    let (connection, _, server) = sdk_wire_connection().await;
+    let (manager, sdk) = sdk_manager("handoff-rollover");
+    let handoff = manager
+        .state
+        .lock()
+        .await
+        .conversation
+        .as_ref()
+        .unwrap()
+        .handoff
+        .clone();
+    let (tx, rx) = bounded(2);
+    let mut audio = None;
+    let mut responses = super::RealtimeResponseCreateQueue::default();
+    for index in 0..super::SDK_HANDOFF_LIMIT + 4 {
+        let id = format!("terminal-handoff-{index}");
+        let request = RealtimeHandoffRequested {
+            response_id: Some(format!("response-{index}")),
+            handoff_id: id.clone(),
+            item_id: format!("item-{index}"),
+            input_transcript: "prepared input".into(),
+            active_transcript: Vec::new(),
+        };
+        super::handle_realtime_server_event(
+            RealtimeEvent::HandoffRequested(request.clone()),
+            &connection.writer(),
+            &tx,
+            &handoff,
+            RealtimeSessionKind::V2,
+            &mut audio,
+            &mut responses,
+        )
+        .await
+        .unwrap();
+        assert!(matches!(
+            rx.try_recv().unwrap(),
+            RealtimeEvent::HandoffRequested(_)
+        ));
+        // The actual command path marks accepted publication before removing pending.
+        sdk.seen.lock().await.get_mut(&id).unwrap().output_published = true;
+        sdk.pending.lock().await.remove(&id);
+        if index + 1 == super::SDK_HANDOFF_LIMIT {
+            let before = sdk.seen.lock().await.keys().cloned().collect::<Vec<_>>();
+            super::handle_realtime_server_event(
+                RealtimeEvent::HandoffRequested(RealtimeHandoffRequested {
+                    response_id: Some("response-0".into()),
+                    handoff_id: "terminal-handoff-0".into(),
+                    item_id: "item-0".into(),
+                    input_transcript: "prepared input".into(),
+                    active_transcript: Vec::new(),
+                }),
+                &connection.writer(),
+                &tx,
+                &handoff,
+                RealtimeSessionKind::V2,
+                &mut audio,
+                &mut responses,
+            )
+            .await
+            .unwrap();
+            assert!(
+                rx.is_empty(),
+                "oldest duplicate at full capacity must stay inert"
+            );
+            assert_eq!(
+                sdk.seen.lock().await.keys().cloned().collect::<Vec<_>>(),
+                before
+            );
+        }
+        super::handle_realtime_server_event(
+            RealtimeEvent::HandoffRequested(request),
+            &connection.writer(),
+            &tx,
+            &handoff,
+            RealtimeSessionKind::V2,
+            &mut audio,
+            &mut responses,
+        )
+        .await
+        .unwrap();
+        assert!(rx.is_empty(), "a recent completed handoff must stay inert");
+        assert!(sdk.seen.lock().await.len() <= super::SDK_HANDOFF_LIMIT);
+    }
+    assert!(!sdk.seen.lock().await.contains_key("terminal-handoff-0"));
+    server.abort();
+}
