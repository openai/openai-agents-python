+/// Immutable settings and selected environments for one Realtime source capture.
+#[derive(Clone)]
+pub(crate) struct RealtimeSourceInputs {
+    configuration: SessionConfiguration,
+    environments: TurnEnvironmentSnapshot,
+    config: Arc<Config>,
+    sub_id: String,
+    fast_mode_enabled: bool,
+}
+
+impl RealtimeSourceInputs {
+    pub(crate) fn profile(&self) -> Option<&Arc<codex_extension_api::CapturedAgentProfile>> {
+        self.configuration.agent_profile.as_ref()
+    }
+
+    pub(crate) fn config(&self) -> &Arc<Config> {
+        &self.config
+    }
+
+    pub(crate) fn provider(&self) -> &codex_model_provider::SharedModelProvider {
+        &self.configuration.provider
+    }
+
+    /// Resolves only cached model metadata, with no context, plugins, or executor wait.
+    pub(crate) async fn resolve_settings(
+        &self,
+        session: &Session,
+    ) -> CodexResult<Arc<super::step_settings::ResolvedStepSettings>> {
+        session.check_agent_profile_admission()?;
+        let model = self
+            .configuration
+            .step_settings
+            .resolve_model_info(
+                session.services.models_manager.as_ref(),
+                &self.configuration.model_info_overrides,
+            )
+            .await;
+        session.check_agent_profile_admission()?;
+        Ok(Arc::new(
+            super::step_settings::ResolvedStepSettings::new(
+                Arc::clone(&self.configuration.step_settings),
+                Arc::new(model),
+                self.fast_mode_enabled,
+                self.configuration.model_info_overrides.context_window,
+            )
+            .with_agent_profile(self.configuration.agent_profile.clone()),
+        ))
+    }
+}
+
 impl Session {
+    /// Captures per-Agent servers without changing thread settings or shared-latest runtime.
+    pub(crate) async fn prepare_agent_profile_mcp(
+        self: &Arc<Self>,
+        servers: std::collections::HashMap<String, codex_config::McpServerConfig>,
+    ) -> CodexResult<(
+        Arc<codex_mcp::McpBinding>,
+        codex_extension_api::SelectedPluginSnapshot,
+    )> {
+        self.check_agent_profile_admission()?;
+        let _refresh = self
+            .mcp_refresh
+            .acquire()
+            .await
+            .map_err(|_| CodexErr::TurnAborted)?;
+        self.check_agent_profile_admission()?;
+        let environments = self.services.turn_environments.snapshot().await;
+        let auth = self.services.auth_manager.auth().await;
+        let mut desired = self.latest_mcp_desired_state(auth, environments).await;
+        let mut config = desired.config.as_ref().clone();
+        config
+            .mcp_servers
+            .set(servers)
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+        desired.config = Arc::new(config);
+        self.prepare_mcp_binding_from_desired(desired).await
+    }
+
+    /// Captures owners without waiting for plugins, executors, MCP, or model discovery.
+    pub(crate) async fn capture_realtime_source_inputs(
+        self: &Arc<Self>,
+    ) -> CodexResult<RealtimeSourceInputs> {
+        self.check_agent_profile_admission()?;
+        let configuration = self.state.lock().await.session_configuration.clone();
+        let environments = self.services.turn_environments.snapshot_now();
+        let cwd = environments
+            .primary()
+            .and_then(|environment| environment.cwd().to_abs_path().ok())
+            .unwrap_or_else(|| configuration.cwd().clone());
+        let config = Arc::new(self.build_per_turn_config(
+            &configuration,
+            cwd,
+            environments.primary_workspace_roots(),
+        ));
+        self.check_agent_profile_admission()?;
+        Ok(RealtimeSourceInputs {
+            configuration,
+            environments,
+            config,
+            sub_id: format!("sdk-realtime-source-{}", uuid::Uuid::now_v7()),
+            fast_mode_enabled: self.features.enabled(Feature::FastMode),
+        })
+    }
+
+    /// Prepares from the captured owners; it never rereads thread default settings.
+    pub(crate) async fn prepare_realtime_source_mcp(
+        self: &Arc<Self>,
+        source: &RealtimeSourceInputs,
+    ) -> CodexResult<Option<Arc<codex_mcp::McpBinding>>> {
+        self.check_agent_profile_admission()?;
+        if let Some(profile) = source.profile() {
+            return Ok(Some(Arc::clone(&profile.profile.mcp)));
+        }
+        let _refresh = self
+            .mcp_refresh
+            .acquire()
+            .await
+            .map_err(|_| CodexErr::TurnAborted)?;
+        self.check_agent_profile_admission()?;
+        let environments = self
+            .services
+            .turn_environments
+            .resolve_snapshot(source.environments.clone())
+            .await;
+        // Readiness may resolve the captured selections, but never replaces them
+        // with newer thread defaults. Apply those same selections to config A.
+        let cwd = environments
+            .primary()
+            .and_then(|environment| environment.cwd().to_abs_path().ok())
+            .unwrap_or_else(|| source.configuration.cwd().clone());
+        let config = Arc::new(self.build_per_turn_config(
+            &source.configuration,
+            cwd,
+            environments.primary_workspace_roots(),
+        ));
+        let desired = McpDesiredState {
+            config: Arc::clone(&config),
+            auth: self.services.auth_manager.auth().await,
+            submit_id: source.sub_id.clone(),
+            originator: source.configuration.originator.clone(),
+            session_source: source.configuration.session_source.clone(),
+            local_process_cwd: environments
+                .local_environment_cwd()
+                .unwrap_or_else(|| config.cwd.clone())
+                .to_path_buf(),
+            environments,
+            disabled_plugin_ids: source.configuration.disabled_plugin_ids.clone(),
+        };
+        let (binding, _) = self.prepare_mcp_binding_from_desired(desired).await?;
+        self.check_agent_profile_admission()?;
+        Ok(Some(binding))
+    }
+
+    #[cfg(test)]
+    pub(crate) async fn capture_realtime_settings_and_mcp(
+        self: &Arc<Self>,
+    ) -> CodexResult<(
+        Arc<super::step_settings::ResolvedStepSettings>,
+        Option<Arc<codex_mcp::McpBinding>>,
+    )> {
+        let source = self.capture_realtime_source_inputs().await?;
+        let settings = source.resolve_settings(self).await?;
+        let binding = self.prepare_realtime_source_mcp(&source).await?;
+        Ok((settings, binding))
+    }
+
+    async fn prepare_mcp_binding_from_desired(
+        self: &Arc<Self>,
+        desired: McpDesiredState,
+    ) -> CodexResult<(
+        Arc<codex_mcp::McpBinding>,
+        codex_extension_api::SelectedPluginSnapshot,
+    )> {
+        let roots = self
+            .resolve_selected_capability_roots_for_step(&desired.environments)
+            .await;
+        let ready = Self::ready_selected_capability_roots(&roots);
+        let discovery = self
+            .executor_capability_discovery_for_step(&desired.config, &ready, &desired.environments)
+            .await;
+        let projection = self
+            .services
+            .mcp_manager
+            .runtime_config_for_step(
+                &desired.config,
+                &self.services.mcp_thread_init,
+                &self.services.thread_extension_data,
+                crate::mcp::McpThreadIdentity {
+                    auth_changed: !self
+                        .services
+                        .mcp_runtime
+                        .current_auth_matches(desired.auth.as_ref()),
+                    session_source: &desired.session_source,
+                    originator: &desired.originator,
+                    disabled_plugin_ids: &desired.disabled_plugin_ids,
+                    environments: crate::mcp::McpEnvironmentScope::Selected(
+                        &desired.environments.all_selections(),
+                    ),
+                },
+                &ready,
+                discovery.as_deref(),
+            )
+            .await;
+        let projection = self
+            .project_selected_environment_mcp_servers(
+                &desired.config,
+                &desired.environments,
+                projection,
+            )
+            .await;
+        let plugins = projection.selected_plugins.clone();
+        let input = self.build_mcp_runtime_input(
+            &desired,
+            projection,
+            &ready,
+            Some(self.mcp_elicitation_reviewer()),
+        );
+        let binding = AuthStorageOriginator::from_client_name(&desired.originator)
+            .scope(self.services.mcp_runtime.prepare_profile_binding(input))
+            .await
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+        self.check_agent_profile_admission()?;
+        Ok((binding, plugins))
+    }
