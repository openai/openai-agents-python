+                    .lock()
+                    .unwrap()
+                    .as_ref()
+                    .unwrap()
+                    .accepted()
+                    .unwrap(),
+            ),
+            batch: None,
+            request,
+            claimed: false,
+            native_turn_id: None,
+            cancel: tokio_util::sync::CancellationToken::new(),
