+async fn sdk_wire_native_continuation_case(late_third: bool, new_owner: Option<&str>) {
+    use codex_api::RealtimeEvent;
+    let (session, sdk, _, policy, _, _) = realtime_tool_fixture(false, false).await;
+    let source = sdk
+        .configuration
+        .lock()
+        .unwrap()
+        .as_ref()
+        .unwrap()
+        .accepted()
+        .unwrap()
+        .native_source
+        .clone()
+        .unwrap();
+    let (connection, mut wire, server, control) =
+        sdk_wire_connection_controlled(Some(source), sdk.function_tools.clone(), "response-A")
+            .await;
+    assert_eq!(wire.recv().await.unwrap()["type"], "session.update");
+    *sdk.configuration.lock().unwrap() = connection.writer().configuration();
+    let handoff = session
+        .conversation
+        .state
+        .lock()
+        .await
+        .conversation
+        .as_ref()
+        .unwrap()
+        .handoff
+        .clone();
+    let (events, _events_rx) = async_channel::unbounded();
+    let mut responses = super::RealtimeResponseCreateQueue::default();
+    connection.writer().send_response_create().await.unwrap();
+    assert_eq!(wire.recv().await.unwrap()["type"], "response.create");
+    dispatch_sdk_wire_until(&connection, &handoff, &events, &mut responses, |event| {
+        matches!(event, RealtimeEvent::ResponseCreated(_))
+    })
+    .await;
+    let ids = ["call-A1", "call-A2", "call-A3"];
+    let items: Vec<_> = ids
+        .iter()
+        .map(|id| {
+            serde_json::json!({
+                "type":"function_call", "id":format!("item-{id}"), "call_id":id,
+                "name":"approved_function", "arguments":"{\"x\":1}", "status":"completed"
+            })
+        })
+        .collect();
+    for (index, item) in items.iter().enumerate() {
+        control
+            .send(SdkWireControl::Event(serde_json::json!({
+                "type":"response.output_item.done", "response_id":"response-A",
+                "output_index":index, "item":item
+            })))
+            .unwrap();
+    }
+    control.send(SdkWireControl::Event(serde_json::json!({
+        "type":"response.done", "response":{"id":"response-A", "status":"completed", "output":items}
+    }))).unwrap();
+    dispatch_sdk_wire_until(&connection, &handoff, &events, &mut responses, |event| {
+        matches!(event, RealtimeEvent::ResponseDone(_))
+    })
+    .await;
+    // Claim the exact reader-produced batch; inject only the completed native outputs.
+    let _task = session
+        .conversation
+        .claim_sdk_tools(
+            "tools-generation",
+            "response-A",
+            &ids.iter().map(|id| id.to_string()).collect::<Vec<_>>(),
+            "native-output-fixture",
+        )
+        .await
+        .unwrap();
+    set_sdk_wire_response_id(&control, "response-B").await;
+    publish_sdk_wire_result(
+        &session,
+        &sdk,
+        &connection,
+        &handoff,
+        &events,
+        &mut responses,
+        ids[0],
+    )
+    .await;
+    assert_eq!(wire.recv().await.unwrap()["item"]["call_id"], ids[0]);
+    assert_eq!(wire.recv().await.unwrap()["type"], "response.create");
+    dispatch_sdk_wire_until(&connection, &handoff, &events, &mut responses, |event| {
+        matches!(event, RealtimeEvent::ResponseCreated(_))
+    })
+    .await;
+
+    if new_owner.is_none() {
+        publish_sdk_wire_result(
+            &session,
+            &sdk,
+            &connection,
+            &handoff,
+            &events,
+            &mut responses,
+            ids[1],
+        )
+        .await;
+        assert_eq!(wire.recv().await.unwrap()["item"]["call_id"], ids[1]);
+        if !late_third {
+            publish_sdk_wire_result(
+                &session,
+                &sdk,
+                &connection,
+                &handoff,
+                &events,
+                &mut responses,
+                ids[2],
+            )
+            .await;
+            assert_eq!(wire.recv().await.unwrap()["item"]["call_id"], ids[2]);
+        }
+    }
+    set_sdk_wire_response_id(&control, "response-C").await;
+    control.send(SdkWireControl::Event(serde_json::json!({
+        "type":"response.done", "response":{"id":"response-B", "status":"completed", "output":[]}
+    }))).unwrap();
+    dispatch_sdk_wire_until(&connection, &handoff, &events, &mut responses, |event| {
+        matches!(event, RealtimeEvent::ResponseDone(_))
+    })
+    .await;
+    match new_owner {
+        Some("user") => super::handle_sdk_realtime_command(
+            Ok(super::SdkRealtimeCommand::Text(ConversationTextParams {
+                text: "a new user request".into(),
+                role: ConversationTextRole::User,
+            })),
+            &connection.writer(),
+            &handoff,
+            &mut responses,
+            &events,
+        )
+        .await
+        .unwrap(),
+        Some("manual") => connection.writer().send_response_create().await.unwrap(),
+        Some("speech") => {
+            control.send(SdkWireControl::Event(serde_json::json!({
+                "type":"input_audio_buffer.speech_started", "item_id":"new-speech", "audio_start_ms":0
+            }))).unwrap();
+            dispatch_sdk_wire_until(&connection, &handoff, &events, &mut responses, |event| {
+                matches!(event, RealtimeEvent::InputAudioSpeechStarted(_))
+            })
+            .await;
+            control
+                .send(SdkWireControl::Event(serde_json::json!({
+                    "type":"response.created", "response":{"id":"response-C"}
+                })))
+                .unwrap();
+        }
+        None => {}
+        _ => unreachable!(),
+    }
+    if new_owner == Some("user") {
+        assert_eq!(
+            wire.recv().await.unwrap()["type"],
+            "conversation.item.create"
+        );
+    }
+    if new_owner != Some("speech") {
+        assert_eq!(wire.recv().await.unwrap()["type"], "response.create");
+    }
+    dispatch_sdk_wire_until(&connection, &handoff, &events, &mut responses, |event| {
+        matches!(event, RealtimeEvent::ResponseCreated(_))
+    })
+    .await;
+    if new_owner == Some("speech") {
+        // Default VAD interruption retires the callbacks as well as continuation intent.
+        for call_id in &ids[1..] {
+            let rejected = session
+                .conversation
+                .sdk_enqueue(
+                    "tools-generation",
+                    super::SdkRealtimeCommand::FunctionResult {
+                        call_id: (*call_id).into(),
+                        text: format!("accepted {call_id}"),
+                        succeeded: true,
+                        start_response: true,
+                        cancellation: None,
+                    },
+                )
+                .await;
+            let error = rejected.expect_err("speech interruption retires pending calls");
+            assert!(
+                error
+                    .to_string()
+                    .contains("handoff is unknown or already resolved")
+            );
+        }
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_millis(40), wire.recv())
+                .await
+                .is_err(),
+            "retired speech callbacks must publish neither output nor response.create"
+        );
+    } else if new_owner.is_some() {
+        publish_sdk_wire_result(
+            &session,
+            &sdk,
+            &connection,
+            &handoff,
+            &events,
+            &mut responses,
+            ids[1],
+        )
+        .await;
+        assert_eq!(wire.recv().await.unwrap()["item"]["call_id"], ids[1]);
+    }
+    if new_owner != Some("speech") && (late_third || new_owner.is_some()) {
+        publish_sdk_wire_result(
+            &session,
+            &sdk,
+            &connection,
+            &handoff,
+            &events,
+            &mut responses,
+            ids[2],
+        )
+        .await;
+        assert_eq!(wire.recv().await.unwrap()["item"]["call_id"], ids[2]);
+    }
+    set_sdk_wire_response_id(&control, "response-D").await;
+    control.send(SdkWireControl::Event(serde_json::json!({
+        "type":"response.done", "response":{"id":"response-C", "status":"completed", "output":[]}
+    }))).unwrap();
+    dispatch_sdk_wire_until(&connection, &handoff, &events, &mut responses, |event| {
+        matches!(event, RealtimeEvent::ResponseDone(_))
+    })
+    .await;
+    if late_third && new_owner.is_none() {
+        assert_eq!(wire.recv().await.unwrap()["type"], "response.create");
+    }
+    assert!(
+        tokio::time::timeout(std::time::Duration::from_millis(40), wire.recv())
+            .await
+            .is_err()
+    );
+    connection.close().await.unwrap();
+    server.await.unwrap();
+    let retained = policy.connection.lock().unwrap().take();
+    if let Some((connection, _, server)) = retained {
+        connection.close().await.unwrap();
+        server.await.unwrap();
+    }
+}
