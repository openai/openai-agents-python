+        stream.close().await.unwrap();
+        assert_eq!(controlled.closed.load(Ordering::Acquire), 1);
+    }
+
+    #[tokio::test]
+    async fn ordinary_ingress_eof_drains_final_frames_in_order() {
+        let (controlled, tx) = controlled_connection();
+        let mut io = AdapterIo::new(controlled, CancellationToken::new());
+        let frames = [
+            r#"{"type":"response.output_text.done","response_id":"r","text":"final"}"#,
+            r#"{"type":"response.done","response":{"id":"r","output":[]}}"#,
+        ];
+        for frame in frames {
+            tx.send(frame.into()).await.unwrap();
+        }
+        drop(tx);
+        for expected in frames {
+            let received = tokio::time::timeout(std::time::Duration::from_secs(2), io.next())
+                .await
+                .unwrap()
+                .unwrap()
+                .unwrap();
+            assert_eq!(received, Message::Text(expected.into()));
+        }
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_secs(2), io.next())
+                .await
+                .unwrap()
+                .is_none()
+        );
+        io.cleanup().close().await.unwrap();
+    }
+
+    #[tokio::test]
