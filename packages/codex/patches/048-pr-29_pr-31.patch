+
+type Reply<T> = oneshot::Sender<CodexResult<T>>;
+
+#[derive(Deserialize)]
+#[serde(tag = "type", deny_unknown_fields)]
+enum ClientEvent {
+    #[serde(rename = "response.create")]
+    ResponseCreate { response: Option<Value> },
+    #[serde(rename = "response.cancel")]
+    ResponseCancel { response_id: Option<String> },
+    #[serde(rename = "conversation.item.create")]
+    ItemCreate {
+        item: Value,
+        previous_item_id: Option<String>,
+    },
+    #[serde(rename = "conversation.item.retrieve")]
+    ItemRetrieve { item_id: String },
+    #[serde(rename = "conversation.item.delete")]
+    ItemDelete { item_id: String },
+    #[serde(rename = "conversation.item.truncate")]
+    ItemTruncate {
+        item_id: String,
+        content_index: u32,
+        audio_end_ms: u32,
+    },
+    #[serde(rename = "input_audio_buffer.append")]
+    AudioAppend { audio: String },
+    #[serde(rename = "input_audio_buffer.clear")]
+    AudioClear {},
+    #[serde(rename = "input_audio_buffer.commit")]
+    AudioCommit {},
+    #[serde(rename = "output_audio_buffer.clear")]
+    OutputClear {},
+    #[serde(rename = "session.update")]
+    SessionUpdate { session: Value },
+    #[serde(other)]
+    ProviderEvent,
+}
+
+#[derive(Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Response {
+    conversation: Option<RealtimeResponseConversation>,
+    input: Option<Vec<Value>>,
+    instructions: Option<String>,
+    output_modalities: Option<[RealtimeOutputModality; 1]>,
+    max_output_tokens: Option<RealtimeMaxOutputTokens>,
+    metadata: Option<BTreeMap<String, String>>,
+    parallel_tool_calls: Option<bool>,
+    reasoning: Option<Reasoning>,
+    #[serde(default, deserialize_with = "present_value")]
+    prompt: Option<Value>,
+    #[serde(default, deserialize_with = "present_value")]
+    audio: Option<Value>,
+    tools: Option<Vec<RealtimeResponseTool>>,
+    tool_choice: Option<RealtimeToolChoice>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Reasoning {
+    effort: Option<String>,
+}
+
+fn present_value<'de, D: serde::Deserializer<'de>>(
+    deserializer: D,
+) -> Result<Option<Value>, D::Error> {
+    Value::deserialize(deserializer).map(Some)
+}
+
+fn invalid(message: &str) -> CodexErr {
+    CodexErr::InvalidRequest(message.into())
+}
+
+fn response_options(
+    response: Option<Value>,
+    event_id: Option<String>,
+) -> CodexResult<RealtimeResponseOptions> {
+    let response: Response = match response {
+        Some(value @ Value::Object(_)) => serde_json::from_value(value)
+            .map_err(|_| invalid("Unsupported or invalid raw Realtime response options"))?,
+        Some(_) => return Err(invalid("Raw Realtime response options must be an object")),
+        None => Response::default(),
+    };
+    if response.metadata.as_ref().is_some_and(|metadata| {
+        metadata.len() > 16
+            || metadata
+                .iter()
+                .any(|(key, value)| key.chars().count() > 64 || value.chars().count() > 512)
+    }) {
+        return Err(invalid(
+            "Raw Realtime response metadata exceeds provider limits",
+        ));
+    }
+    if response.input.iter().flatten().any(|item| {
+        !matches!(
+            item["type"].as_str(),
+            Some("message" | "function_call" | "function_call_output")
+        ) && !(item["type"] == "item_reference"
+            && item["id"]
+                .as_str()
+                .is_some_and(|id| !id.is_empty() && id.len() <= 512)
+            && item.as_object().is_some_and(|fields| fields.len() == 2))
+    }) {
+        return Err(invalid("Unsupported raw Realtime response input item"));
+    }
+    if let Some(tools) = &response.tools {
+        let mut names = BTreeSet::new();
+        let mut labels = BTreeSet::new();
+        if tools.len() > 128
+            || tools.iter().any(|tool| match tool {
+                RealtimeResponseTool::Function(tool) => {
+                    tool.name.is_empty()
+                        || tool.name.len() > 128
+                        || !tool.parameters.is_object()
+                        || !names.insert(tool.name.as_str())
+                }
+                RealtimeResponseTool::Mcp(tool) => {
+                    tool.server_label.is_empty()
+                        || tool.server_label.len() > 512
+                        || !labels.insert(tool.server_label.as_str())
+                }
+            })
+        {
+            return Err(invalid("Invalid raw Realtime response tool declarations"));
+        }
+    }
+    Ok(RealtimeResponseOptions {
+        conversation: response.conversation,
+        input: response.input,
+        instructions: response.instructions,
+        output_modality: response.output_modalities.map(|[modality]| modality),
+        max_output_tokens: response.max_output_tokens,
+        metadata: response.metadata,
+        parallel_tool_calls: response.parallel_tool_calls,
+        reasoning: response
+            .reasoning
+            .map(|Reasoning { effort }| RealtimeReasoning { effort }),
+        prompt: response
+            .prompt
+            .map(response_prompt)
+            .transpose()
+            .map_err(|_| invalid("Unsupported or invalid raw Realtime response prompt"))?,
+        audio_output: response
+            .audio
+            .as_ref()
+            .map(response_audio)
+            .transpose()
+            .map_err(|_| invalid("Unsupported or invalid raw Realtime response audio"))?
+            .flatten(),
+        tools: response.tools,
+        tool_choice: response.tool_choice,
+        event_id,
+    })
+}
+
+fn completion<T: Send + 'static>(
+    mut reply: Reply<Option<Value>>,
+    convert: fn(T) -> Option<Value>,
+) -> Reply<T> {
+    let (tx, rx) = oneshot::channel();
+    // The session dispatcher must remain free to process close while a
+    // generation-owned command waits for its provider receipt.
+    tokio::spawn(async move {
+        tokio::select! {
+            result = rx => {
+                let _ = reply.send(result.unwrap_or(Err(CodexErr::TurnAborted)).map(convert));
+            }
+            () = reply.closed() => {}
+        }
+    });
+    tx
+}
+
+async fn validate_connection(sess: &Arc<Session>, generation: &str) -> CodexResult<()> {
+    let state = sess.conversation.state.lock().await;
+    let conversation = state
+        .conversation
+        .as_ref()
+        .filter(|conversation| {
+            conversation.handoff.sdk.as_ref().is_some_and(|sdk| {
+                sdk.generation == generation && sdk.active.load(Ordering::Acquire)
+            })
+        })
+        .ok_or_else(|| invalid("SDK Realtime generation is stale"))?;
+    if conversation.handoff.event_parser != RealtimeEventParser::RealtimeV2 {
+        return Err(invalid("Raw client events require RealtimeV2"));
+    }
+    Ok(())
+}
+
+pub(crate) async fn handle_send_event_sdk(
+    sess: &Arc<Session>,
+    generation: String,
+    mut value: Value,
+    reply: Reply<Option<Value>>,
+) {
+    let (event, event_id, bytes) = match parse_event(&mut value) {
+        Ok(event) => event,
+        Err(error) => {
+            let _ = reply.send(Err(error));
+            return;
+        }
+    };
+    if let Err(error) = validate_connection(sess, &generation).await {
+        let _ = reply.send(Err(error));
+        return;
+    }
+    match event {
+        ClientEvent::ResponseCreate { response } => {
+            let result = match response_options(response, event_id) {
+                Ok(options) if options.conversation == Some(RealtimeResponseConversation::None) => {
+                    dispatch_sdk_control(sess, generation, completion(reply, |()| None), |reply| {
+                        SdkRealtimeCommand::RequestDetachedResponse(PendingDetachedResponse {
+                            options,
+                            bytes,
+                            reply,
+                        })
+                    })
+                    .await;
+                    return;
+                }
+                Ok(options) => {
+                    sess.conversation
+                        .sdk_enqueue(&generation, SdkRealtimeCommand::RequestResponse(options))
+                        .await
+                }
+                Err(error) => Err(error),
+            };
+            let _ = reply.send(result.map(|()| None));
+        }
+        ClientEvent::ResponseCancel { response_id } => {
+            if response_id
+                .as_ref()
+                .is_some_and(|id| id.is_empty() || id.len() > 512)
+            {
+                let _ = reply.send(Err(invalid("Raw Realtime response ID is invalid")));
+                return;
+            }
+            dispatch_interrupt_sdk(
+                sess,
+                generation,
+                response_id,
+                event_id,
+                None,
+                None,
+                completion(reply, |receipt: RealtimeInterruptReceipt| {
+                    Some(serde_json::json!(receipt))
+                }),
+            )
+            .await;
+        }
+        ClientEvent::ItemCreate {
+            item,
+            previous_item_id,
+        } => {
+            if item.get("type").and_then(Value::as_str) == Some("mcp_approval_response") {
+                dispatch_raw_approval(sess, generation, item, previous_item_id, event_id, reply)
+                    .await;
+                return;
+            }
+            let mut item = match item {
+                Value::Object(item)
+                    if matches!(
+                        item.get("type").and_then(Value::as_str),
+                        Some("message" | "function_call" | "function_call_output")
+                    ) =>
+                {
+                    item
+                }
+                _ => {
+                    let _ = reply.send(Err(invalid("Unsupported raw Realtime conversation item")));
+                    return;
+                }
+            };
+            item.entry("id").or_insert_with(|| {
+                Value::String(format!("item_{}", uuid::Uuid::new_v4().simple()))
+            });
+            handle_history_sdk(
+                sess,
+                generation,
+                Request::Create {
+                    item: Value::Object(item),
+                    previous: previous_item_id,
+                    event_id,
+                    reply: completion(reply, |_| None),
+                },
+            )
+            .await;
+        }
+        ClientEvent::ItemRetrieve { item_id } => {
+            handle_history_sdk(
+                sess,
+                generation,
+                Request::Item {
+                    id: item_id,
+                    event_id,
+                    reply: completion(reply, Some),
+                },
+            )
+            .await;
+        }
+        ClientEvent::ItemDelete { item_id } => {
+            handle_delete_item_sdk(
+                sess,
+                generation,
+                item_id,
+                event_id,
+                completion(reply, |_| None),
+            )
+            .await;
+        }
+        ClientEvent::AudioAppend { audio } => {
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::RawAudio {
+                    audio,
+                    event_id,
+                    reply,
+                }
+            })
+            .await;
+        }
+        ClientEvent::AudioClear {} | ClientEvent::AudioCommit {} => {
+            let control = if matches!(event, ClientEvent::AudioClear {}) {
+                AudioBufferControl::Clear
+            } else {
+                AudioBufferControl::Commit
+            };
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::AudioControl {
+                    control,
+                    event_id,
+                    reply,
+                }
+            })
+            .await;
+        }
+        ClientEvent::ItemTruncate {
+            item_id,
+            content_index,
+            audio_end_ms,
+        } => {
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::PlaybackControl {
+                    control: RealtimePlaybackControl::Truncate {
+                        item_id,
+                        content_index,
+                        audio_end_ms,
+                    },
+                    event_id,
+                    reply,
+                }
+            })
+            .await;
+        }
+        ClientEvent::OutputClear {} => {
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::PlaybackControl {
+                    control: RealtimePlaybackControl::Clear,
+                    event_id,
+                    reply,
+                }
+            })
+            .await;
+        }
+        ClientEvent::SessionUpdate { session } => match session_update(session) {
+            Ok(update) => {
+                dispatch_update_sdk(
+                    sess,
+                    generation,
+                    update,
+                    None,
+                    event_id,
+                    completion(reply, |_| None),
+                )
+                .await
+            }
+            Err(error) => {
+                let _ = reply.send(Err(error));
+            }
+        },
+        ClientEvent::ProviderEvent => {
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::RawProviderEvent {
+                    payload: value.to_string(),
+                    reply,
+                }
+            })
+            .await;
+        }
+    }
+}
+
+fn parse_event(value: &mut Value) -> CodexResult<(ClientEvent, Option<String>, usize)> {
+    let mut retained_bytes = 0;
+    codex_api::charge_realtime_json_storage(value, &mut retained_bytes)
+        .map_err(|_| invalid("Raw Realtime event exceeds its 8 MiB estimated storage limit"))?;
+    let fields = value
+        .as_object_mut()
+        .ok_or_else(|| invalid("Raw Realtime event must be an object"))?;
+    if !fields
+        .get("type")
+        .and_then(Value::as_str)
+        .is_some_and(|name| !name.is_empty() && name.len() <= 512)
+    {
+        return Err(invalid("Raw Realtime event type is invalid"));
+    }
+    let original_id = fields.remove("event_id");
+    let event_id = match &original_id {
+        Some(Value::String(id)) if !id.is_empty() && id.len() <= 512 => Some(id.clone()),
+        None | Some(Value::Null) => None,
+        Some(_) => return Err(invalid("Raw Realtime event ID is invalid")),
+    };
+    let event = ClientEvent::deserialize(&*value)
+        .map_err(|_| invalid("Unsupported or invalid raw Realtime client event"))?;
+    if matches!(event, ClientEvent::ProviderEvent)
+        && let Some(original_id) = original_id
+    {
+        value["event_id"] = original_id;
+    }
+    Ok((event, event_id, retained_bytes))
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ApprovalResponse {
+    #[serde(rename = "type")]
+    kind: String,
+    id: Option<String>,
+    approval_request_id: String,
+    approve: bool,
+    reason: Option<String>,
+}
+
+async fn dispatch_raw_approval(
+    sess: &Arc<Session>,
+    generation: String,
+    item: Value,
+    previous: Option<String>,
+    event_id: Option<String>,
+    reply: Reply<Option<Value>>,
+) {
+    let response = serde_json::from_value::<ApprovalResponse>(item);
+    let response = match response {
+        Ok(response)
+            if response.kind == "mcp_approval_response"
+                && !response.approval_request_id.is_empty()
+                && response.approval_request_id.len() <= 512
+                && response.approval_request_id != "root"
+                && response.id.as_ref().is_none_or(|id| {
+                    !id.is_empty()
+                        && id.len() <= 512
+                        && id != "root"
+                        && id != &response.approval_request_id
+                })
+                && previous
+                    .as_ref()
+                    .is_none_or(|id| id == &response.approval_request_id) =>
+        {
+            response
+        }
+        _ => {
+            let _ = reply.send(Err(invalid(
+                "Unsupported or invalid raw Hosted MCP approval response",
+            )));
+            return;
+        }
+    };
+    dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+        SdkRealtimeCommand::HostedMcpApprovalResponse {
+            request_id: response.approval_request_id,
+            approve: response.approve,
+            reason: response.reason,
+            item_id: response.id,
+            event_id,
+            reply,
+        }
+    })
+    .await;
+}
