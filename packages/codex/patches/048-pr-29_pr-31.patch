+                    self.expected_create(id) && self.is_replayed_call(call_id, id)
+                })
+    }
+
+    pub(super) fn is_replayed_call(&self, call_id: &str, item_id: &str) -> bool {
+        self.replayed_calls
+            .get(call_id)
+            .is_some_and(|call| call.caller.is_none() && call.item_id == item_id)
+    }
+
+    pub(super) fn replayed_call_for_item<'a>(&self, item: &'a Value) -> Option<&'a str> {
+        let call_id = item["call_id"].as_str()?;
+        let id = item["id"].as_str()?;
+        let call = self.replayed_calls.get(call_id)?;
+        let replayed = match item["type"].as_str() {
+            Some("function_call") => call.caller.is_none() && call.item_id == id,
+            Some("function_call_output") => {
+                call.output_id.as_deref() == Some(id)
+                    && call
+                        .caller
+                        .as_ref()
+                        .is_none_or(|caller| caller.output_confirmed)
+            }
+            _ => false,
+        };
+        replayed.then_some(call_id)
+    }
