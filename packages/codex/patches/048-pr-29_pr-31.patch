 use tracing::Instrument;
 
+pub(crate) use codex_extension_api::RealtimeVoiceProfileScope as VoiceProfileScope;
+
+#[derive(Default)]
+struct VoiceProfileSources {
+    next_epoch: std::sync::atomic::AtomicU64,
+    sources: std::sync::Mutex<
+        std::collections::HashMap<(String, String, u64), Arc<dyn codex_api::RealtimeNativeSource>>,
+    >,
+}
+
+async fn accepted_voice_configuration(
+    session: &Arc<Session>,
+    generation: &str,
+) -> codex_protocol::error::Result<Arc<codex_api::RealtimeAcceptedConfiguration>> {
+    let state = session.conversation.state.lock().await;
+    let sdk = state
+        .conversation
+        .as_ref()
+        .and_then(|state| state.handoff.sdk.as_ref())
+        .filter(|sdk| sdk.generation == generation && sdk.active.load(Ordering::Acquire))
+        .ok_or_else(|| CodexErr::InvalidRequest("Expired Realtime generation".into()))?;
+    sdk.configuration
+        .lock()
+        .unwrap()
+        .as_ref()
+        .ok_or_else(|| CodexErr::InvalidRequest("Realtime configuration is not ready".into()))?
+        .accepted()
+        .map_err(|error| CodexErr::InvalidRequest(error.to_string()))
+}
+
+/// Capture a host-admitted profile without changing the persistent root or issued work.
+pub(crate) async fn capture_voice_agent_source(
+    session: &Arc<Session>,
+    generation: &str,
+    expected: Option<&codex_extension_api::AgentProfileReceipt>,
+    target: Arc<codex_extension_api::AgentProfile>,
+) -> codex_protocol::error::Result<codex_extension_api::AgentProfileReceipt> {
+    capture_voice_handoff_source(session, generation, expected, target)
+        .await?
+        .ok_or_else(|| CodexErr::InvalidRequest("Voice Agent source changed during capture".into()))
+}
+
+/// A stale issuing handoff is a scoped refusal, not a failure of newer voice work.
+pub(crate) async fn capture_voice_handoff_source(
+    session: &Arc<Session>,
+    generation: &str,
+    expected: Option<&codex_extension_api::AgentProfileReceipt>,
+    target: Arc<codex_extension_api::AgentProfile>,
+) -> codex_protocol::error::Result<Option<codex_extension_api::AgentProfileReceipt>> {
+    session.validate_voice_agent_profile(&target)?;
+    let accepted = accepted_voice_configuration(session, generation).await?;
+    if accepted.profile_receipt() != expected {
+        return Ok(None);
+    }
+    let registry = session
+        .services
+        .thread_extension_data
+        .get_or_init(VoiceProfileSources::default);
+    if registry.sources.lock().unwrap().len() >= 1024 {
+        return Err(CodexErr::InvalidRequest(
+            "Voice Agent source capacity exceeded".into(),
+        ));
+    }
+    let receipt = codex_extension_api::AgentProfileReceipt {
+        profile_id: target.profile_id.clone(),
+        epoch: registry
+            .next_epoch
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |epoch| {
+                epoch.checked_add(1)
+            })
+            .map_err(|_| CodexErr::InvalidRequest("Voice Agent epoch exhausted".into()))?
+            + 1,
+    };
+    let mut target = target.as_ref().clone();
+    let controls = target.model.request_controls.clone();
+    target.data.insert(VoiceProfileScope {
+        generation: generation.to_owned(),
+    });
+    let profile = Arc::new(codex_extension_api::CapturedAgentProfile {
+        receipt: receipt.clone(),
+        profile: Arc::new(target),
+    });
+    let inputs = session
+        .capture_realtime_source_inputs()
+        .await?
+        .with_voice_profile(profile);
+    let settings = inputs.resolve_settings(session).await?;
+    controls
+        .validate_profile(&settings.model_info)
+        .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+    let captured = capture_declarations(session, &inputs, None, None)?;
+    let source = finish_realtime_native_source(
+        session,
+        RealtimeSourceDraft {
+            inputs,
+            settings,
+            captured,
+            voice_expected: Some(expected.cloned()),
+        },
+    )
+    .await?;
+    if accepted_voice_configuration(session, generation)
+        .await?
+        .profile_receipt()
+        != expected
+    {
+        return Ok(None);
+    }
+    let mut sources = registry.sources.lock().unwrap();
+    if sources.len() >= 1024 {
+        return Err(CodexErr::InvalidRequest(
+            "Voice Agent source capacity exceeded".into(),
+        ));
+    }
+    sources.insert(
+        (
+            generation.to_owned(),
+            receipt.profile_id.clone(),
+            receipt.epoch,
+        ),
+        source,
+    );
+    Ok(Some(receipt))
+}
+
+pub(crate) fn retained_voice_agent_source(
+    session: &Arc<Session>,
+    generation: &str,
+    receipt: &codex_extension_api::AgentProfileReceipt,
+) -> Option<Arc<dyn codex_api::RealtimeNativeSource>> {
+    session
+        .services
+        .thread_extension_data
+        .get::<VoiceProfileSources>()?
+        .sources
+        .lock()
+        .unwrap()
+        .get(&(
+            generation.to_owned(),
+            receipt.profile_id.clone(),
+            receipt.epoch,
+        ))
+        .cloned()
+}
+
+pub(crate) fn release_voice_agent_sources(session: &Arc<Session>, generation: &str) {
+    if let Some(registry) = session
+        .services
+        .thread_extension_data
+        .get::<VoiceProfileSources>()
+    {
+        registry
+            .sources
+            .lock()
+            .unwrap()
+            .retain(|(owner, _, _), _| owner != generation);
+    }
+}
+
+pub(crate) async fn realtime_source_selection(
+    session: &Arc<Session>,
+    generation: Option<&str>,
+    receipt: Option<&codex_extension_api::AgentProfileReceipt>,
+) -> codex_protocol::error::Result<(String, Vec<serde_json::Value>)> {
+    let source = match (generation, receipt) {
+        (Some(generation), Some(receipt)) => {
+            accepted_voice_configuration(session, generation).await?;
+            retained_voice_agent_source(session, generation, receipt).ok_or_else(|| {
+                CodexErr::InvalidRequest("Unknown voice Agent source receipt".into())
+            })?
+        }
+        (None, None) => {
+            finish_realtime_native_source(session, capture_realtime_source_draft(session).await?)
