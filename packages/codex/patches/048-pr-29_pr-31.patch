+    // Caller-owned live calls share the exact call/output receipt ledger with
+    // imported calls, but never acquire native dispatch or batch authority.
+    pub(super) fn observe_caller_call(
+        &mut self,
+        request: &RealtimeFunctionCallRequested,
+        detached: bool,
+    ) -> CodexResult<bool> {
+        let response_id = request
+            .response_id
+            .as_deref()
+            .filter(|id| valid_id(id))
+            .ok_or_else(|| invalid("Caller-managed function has no response identity"))?;
+        if !valid_id(&request.call_id) || !valid_id(&request.item_id) || request.namespace.is_some()
+        {
+            return Err(invalid("Invalid caller-managed function identity"));
+        }
+        let fingerprint = caller_call_fingerprint(request)?;
+        if let Some(previous) = self.replayed_calls.get(&request.call_id) {
+            if previous.item_id == request.item_id
+                && previous.caller.as_ref().is_some_and(|caller| {
+                    caller.response_id == response_id
+                        && caller.fingerprint == fingerprint
+                        && caller.detached == detached
+                })
+            {
+                return Ok(false);
+            }
+            return Err(invalid(
+                "Caller-managed function ID changed ownership or payload",
+            ));
+        }
+        if !detached {
+            if !self.order.contains(&request.item_id) {
+                return Err(invalid(
+                    "Caller-managed function item is not tracked in history",
+                ));
+            }
+            if self
+                .replayed_calls
+                .values()
+                .any(|call| call.item_id == request.item_id)
+            {
+                return Err(invalid("Caller-managed function reused a provider item ID"));
+            }
+        }
+        if !self.reserve_call_identity() {
+            return Err(invalid(
+                "Caller-managed function identity capacity exceeded",
+            ));
+        }
+        self.replayed_calls.insert(
+            request.call_id.clone(),
+            ReplayedCall {
+                item_id: request.item_id.clone(),
+                output_id: None,
+                confirmed: true,
+                caller: Some(CallerCall {
+                    response_id: response_id.to_owned(),
+                    fingerprint,
+                    output_confirmed: false,
+                    response_finished: false,
+                    detached,
+                }),
+            },
+        );
+        Ok(true)
+    }
