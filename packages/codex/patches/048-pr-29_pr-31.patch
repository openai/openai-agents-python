+// An unknown unscoped function echo is normally detached from native authority.
+// Exact historical receipts only restore the existing ACK/done paths, never dispatch.
+fn normalize_historical_replay_receipt(
+    event: RealtimeEvent,
+    history: &provider_history::State,
+    detached_response: bool,
+) -> RealtimeEvent {
+    if detached_response {
+        return event;
+    }
+    match event {
+        RealtimeEvent::DetachedResponse(inner) => match inner.as_ref() {
+            RealtimeEvent::ConversationItemAdded { item, .. }
+                if history.is_pending_replayed_call_receipt(item) =>
+            {
+                *inner
+            }
+            RealtimeEvent::FunctionCallRequested(call)
+                if call.response_id.is_none()
+                    && history.is_replayed_call(&call.call_id, &call.item_id) =>
+            {
+                RealtimeEvent::ConversationItemDone {
+                    item_id: call.item_id.clone(),
+                }
+            }
+            _ => RealtimeEvent::DetachedResponse(inner),
+        },
+        _ => event,
+    }
