new file mode 100644
index 0000000000000000000000000000000000000000..cb2bcca110b02df30a0f262c4ecdeb157675a256
--- /dev/null
+++ b/codex-rs/core/src/realtime_conversation/raw_settings.rs
@@ -0,0 +1,326 @@
+//! Translate provider session and response settings into native settings.
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::realtime_settings::RealtimeAudioFormat;
+use codex_protocol::realtime_settings::RealtimePrompt;
+use codex_protocol::realtime_settings::RealtimeResponseAudioOutput;
+use codex_protocol::realtime_settings::RealtimeSessionTool;
+use codex_protocol::realtime_settings::RealtimeSessionUpdate;
+use serde_json::Map;
+use serde_json::Value;
+
+fn invalid() -> CodexErr {
+    CodexErr::InvalidRequest("Unsupported or invalid raw Realtime session settings".into())
+}
+
+fn object<'a>(value: &'a Value, keys: &[&str]) -> CodexResult<&'a Map<String, Value>> {
+    let fields = value.as_object().ok_or_else(invalid)?;
+    if fields.keys().any(|key| !keys.contains(&key.as_str())) {
+        return Err(invalid());
+    }
+    Ok(fields)
+}
+
+fn nonempty_string(value: Option<&Value>) -> bool {
+    value
+        .and_then(Value::as_str)
+        .is_some_and(|value| !value.trim().is_empty())
+}
+
+fn format(value: &Value) -> CodexResult<RealtimeAudioFormat> {
+    let fields = object(value, &["type", "rate"])?;
+    Ok(match fields.get("type").and_then(Value::as_str) {
+        Some("audio/pcm")
+            if fields
+                .get("rate")
+                .is_none_or(|rate| rate.as_u64() == Some(24000)) =>
+        {
+            RealtimeAudioFormat::Pcm24k
+        }
+        Some("audio/pcmu") if !fields.contains_key("rate") => RealtimeAudioFormat::G711Ulaw,
+        Some("audio/pcma") if !fields.contains_key("rate") => RealtimeAudioFormat::G711Alaw,
+        _ => return Err(invalid()),
+    })
+}
+
+// Protocol DTOs intentionally tolerate extra fields on several settings. Raw
+// provider input must name only supported leaves before those DTOs decode it.
+fn nested(name: &str, value: &Value) -> CodexResult<()> {
+    if value.is_null() {
+        return if matches!(
+            name,
+            "noise_reduction" | "transcription" | "turn_detection" | "prompt" | "tracing"
+        ) {
+            Ok(())
+        } else {
+            Err(invalid())
+        };
+    }
+    match name {
+        "noise_reduction" => {
+            object(value, &["type"])?;
+        }
+        "transcription" => {
+            object(
+                value,
+                &[
+                    "model",
+                    "language",
+                    "prompt",
+                    "keywords",
+                    "languages",
+                    "delay",
+                ],
+            )?;
+        }
+        "turn_detection" => {
+            let keys: &[&str] = match value.get("type").and_then(Value::as_str) {
+                Some("server_vad") => &[
+                    "type",
+                    "model_version",
+                    "create_response",
+                    "interrupt_response",
+                    "threshold",
+                    "prefix_padding_ms",
+                    "silence_duration_ms",
+                    "idle_timeout_ms",
+                ],
+                Some("semantic_vad") => &[
+                    "type",
+                    "model_version",
+                    "create_response",
+                    "interrupt_response",
+                    "eagerness",
+                ],
+                _ => return Err(invalid()),
+            };
+            object(value, keys)?;
+        }
+        "voice" => {
+            let voice = if value.is_object() {
+                object(value, &["id"])?.get("id")
+            } else {
+                Some(value)
+            };
+            if !nonempty_string(voice) {
+                return Err(invalid());
+            }
+        }
+        "tool_choice" if value.is_object() => {
+            object(value, &["type", "name"])?;
+        }
+        "reasoning" => {
+            object(value, &["effort"])?;
+        }
+        "tracing" if value.is_object() => {
+            object(value, &["workflow_name", "group_id", "metadata"])?;
+        }
+        "prompt" => {
+            let fields = object(value, &["id", "version", "variables"])?;
+            if !nonempty_string(fields.get("id")) {
+                return Err(invalid());
+            }
+            if let Some(variables) = fields.get("variables").filter(|value| !value.is_null()) {
+                for value in variables.as_object().ok_or_else(invalid)?.values() {
+                    if value.is_string() {
+                        continue;
+                    }
+                    let keys: &[&str] = match value.get("type").and_then(Value::as_str) {
+                        Some("input_text") => &["type", "text"],
+                        Some("input_image") => &["type", "image_url", "file_id", "detail"],
+                        Some("input_file") => {
+                            &["type", "file_url", "file_id", "file_data", "filename"]
+                        }
+                        _ => return Err(invalid()),
+                    };
+                    object(value, keys)?;
+                }
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+pub(super) fn response_prompt(value: Value) -> CodexResult<Option<RealtimePrompt>> {
+    nested("prompt", &value)?;
+    serde_json::from_value(value).map_err(|_| invalid())
+}
+
+pub(super) fn response_audio(value: &Value) -> CodexResult<Option<RealtimeResponseAudioOutput>> {
+    let Some(output) = object(value, &["output"])?.get("output") else {
+        return Ok(None);
+    };
+    let output = object(output, &["format", "voice"])?;
+    let format = output.get("format").map(format).transpose()?;
+    let voice = output
+        .get("voice")
+        .map(|value| {
+            nested("voice", value)?;
+            serde_json::from_value(value.clone()).map_err(|_| invalid())
+        })
+        .transpose()?;
+    Ok(Some(RealtimeResponseAudioOutput { format, voice }))
+}
+
+/// Decode the `session` object before checking the native tool catalog.
+pub(super) fn session_update(value: Value) -> CodexResult<RealtimeSessionUpdate> {
+    let fields = object(
+        &value,
+        &[
+            "type",
+            "model",
+            "instructions",
+            "output_modalities",
+            "audio",
+            "tools",
+            "tool_choice",
+            "prompt",
+            "tracing",
+            "max_output_tokens",
+            "parallel_tool_calls",
+            "reasoning",
+        ],
+    )?;
+    if fields
+        .get("type")
+        .is_some_and(|value| value.as_str() != Some("realtime"))
+    {
+        return Err(invalid());
+    }
+    let mut update = Map::new();
+    for name in [
+        "model",
+        "instructions",
+        "tool_choice",
+        "prompt",
+        "tracing",
+        "max_output_tokens",
+        "parallel_tool_calls",
+        "reasoning",
+    ] {
+        if let Some(value) = fields.get(name) {
+            nested(name, value)?;
+            update.insert(name.into(), value.clone());
+        }
+    }
+    if let Some(value) = fields.get("output_modalities") {
+        let modalities = value
+            .as_array()
+            .filter(|values| values.len() == 1)
+            .ok_or_else(invalid)?;
+        if !matches!(modalities[0].as_str(), Some("text" | "audio")) {
+            return Err(invalid());
+        }
+        update.insert("output_modality".into(), modalities[0].clone());
+    }
+    if let Some(audio) = fields.get("audio") {
+        for (direction, section) in object(audio, &["input", "output"])? {
+            let names: &[&str] = if direction == "input" {
+                &[
+                    "format",
+                    "noise_reduction",
+                    "transcription",
+                    "turn_detection",
+                ]
+            } else {
+                &["format", "voice", "speed"]
+            };
+            for (name, value) in object(section, names)? {
+                let (key, translated) = if name == "format" {
+                    (
+                        if direction == "input" {
+                            "input_format"
+                        } else {
+                            "output_format"
+                        },
+                        serde_json::to_value(format(value)?).map_err(|_| invalid())?,
+                    )
+                } else {
+                    nested(name, value)?;
+                    (
+                        match name.as_str() {
+                            "voice" => "output_voice",
+                            "speed" => "output_speed",
+                            name => name,
+                        },
+                        value.clone(),
+                    )
+                };
+                update.insert(key.into(), translated);
+            }
+        }
+    }
+    let mut update: RealtimeSessionUpdate =
+        serde_json::from_value(Value::Object(update)).map_err(|_| invalid())?;
+    update.raw_tools = fields
+        .get("tools")
+        .map(|value| {
+            value
+                .as_array()
+                .filter(|tools| tools.len() <= 128)
+                .ok_or_else(invalid)?
+                .iter()
+                .map(|tool| {
+                    let mut tool = tool.clone();
+                    if tool["type"] == "function"
+                        && let Some(fields) = tool.as_object_mut()
+                    {
+                        fields.entry("parameters").or_insert_with(
+                            || serde_json::json!({"type": "object", "properties": {}}),
+                        );
+                    }
+                    serde_json::from_value::<RealtimeSessionTool>(tool).map_err(|_| invalid())
+                })
+                .collect()
+        })
+        .transpose()?;
+    Ok(update)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn maps_wire_audio_and_preserves_sparse_nulls() {
+        let update = session_update(json!({"type":"realtime", "output_modalities":["text"],
+            "audio":{"input":{"format":{"type":"audio/pcm","rate":24000},
+                "noise_reduction":null,"transcription":null,"turn_detection":null},
+                "output":{"format":{"type":"audio/pcmu"},"voice":"marin","speed":1.2}},
+            "prompt":null,"tracing":null}))
+        .unwrap();
+        assert_eq!(
+            serde_json::to_value(update).unwrap(),
+            json!({"output_modality":"text",
+            "input_format":"pcm16","output_format":"g711_ulaw","output_voice":"marin",
+            "output_speed":1.2,"noise_reduction":null,"transcription":null,
+            "turn_detection":null,"prompt":null,"tracing":null})
+        );
+        assert_eq!(
+            session_update(json!({})).unwrap(),
+            RealtimeSessionUpdate::default()
+        );
+    }
+
+    #[test]
+    fn rejects_unknown_nested_fields_and_authority_changes() {
+        for value in [
+            json!([]),
+            json!({"tools":[{"type":"unsupported"}]}),
+            json!({"tools":null}),
+            json!({"function_tools":[]}),
+            json!({"hosted_mcp_tools":[]}),
+            json!({"type":"transcription"}),
+            json!({"output_modalities":["text","audio"]}),
+            json!({"model":null}),
+            json!({"audio":{"output":{"voice":{"id":"custom","extra":true}}}}),
+            json!({"audio":{"input":{"format":{"type":"audio/pcm","rate":16000}}}}),
+            json!({"audio":{"input":{"turn_detection":{"type":"semantic_vad","threshold":0.5}}}}),
+            json!({"reasoning":{"effort":"low","unknown":true}}),
+        ] {
+            assert!(session_update(value).is_err());
+        }
+    }
+}
