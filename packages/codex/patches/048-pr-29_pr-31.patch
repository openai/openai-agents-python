+    pub(super) fn is_caller_call(&self, call_id: &str, response_id: Option<&str>) -> bool {
+        self.replayed_calls.get(call_id).is_some_and(|call| {
+            call.caller.as_ref().is_some_and(|caller| {
+                response_id.is_none_or(|response| caller.response_id == response)
+            })
+        })
+    }
+
+    fn reserve_call_identity(&mut self) -> bool {
+        if self.replayed_calls.len() < LIMIT {
+            return true;
+        }
+        // Keep recent terminal records for duplicate frames until a new
+        // identity needs their slot. Active calls and ordered receipts stay.
+        let ordered_items = self.order.iter().map(String::as_str).collect();
+        let reclaim = self
+            .replayed_calls
+            .values()
+            .position(|call| call.can_reclaim(&ordered_items));
+        reclaim.is_some_and(|index| self.replayed_calls.shift_remove_index(index).is_some())
+    }
+
+    pub(super) fn is_detached_caller_call(&self, call_id: &str, item_id: &str) -> bool {
+        self.replayed_calls.get(call_id).is_some_and(|call| {
+            call.item_id == item_id && call.caller.as_ref().is_some_and(|caller| caller.detached)
+        })
+    }
+
+    pub(super) fn has_live_caller_item(&self, id: &str, call_id: Option<&str>) -> bool {
+        self.replayed_calls.iter().any(|(known_call, call)| {
+            call.confirmed
+                && call
+                    .caller
+                    .as_ref()
+                    .is_some_and(|caller| !caller.output_confirmed)
+                && (call.item_id == id
+                    || call.output_id.as_deref() == Some(id)
+                    || call_id == Some(known_call.as_str()))
+        })
+    }
+
+    pub(super) fn is_live_caller_output(&self, item: &Value) -> bool {
+        item["type"] == "function_call_output"
+            && replay_item(item).is_ok()
+            && item["call_id"]
+                .as_str()
+                .and_then(|id| self.replayed_calls.get(id))
+                .is_some_and(|call| {
+                    call.caller.as_ref().is_some_and(|caller| !caller.detached)
+                        && call.confirmed
+                        && call.output_id.is_none()
+                        && self.order.contains(&call.item_id)
+                })
+    }
+
+    pub(super) fn retire_caller_calls(&mut self, response_id: Option<&str>) {
+        for call in self.replayed_calls.values_mut() {
+            if call.caller.as_ref().is_some_and(|caller| {
+                response_id.is_none_or(|response| caller.response_id == response)
+            }) {
+                call.confirmed = false;
+            }
+        }
+    }
+
+    pub(super) fn finish_caller_response(&mut self, response_id: &str, cancelled: bool) {
+        for call in self.replayed_calls.values_mut() {
+            if let Some(caller) = call
+                .caller
+                .as_mut()
+                .filter(|caller| caller.response_id == response_id)
+            {
+                caller.response_finished = true;
+                if cancelled || caller.detached {
+                    call.confirmed = false;
+                }
+            }
+        }
+    }
+
+    pub(super) fn is_pending_replayed_call_receipt(&self, item: &Value) -> bool {
+        item["type"] == "function_call"
+            && item["id"]
+                .as_str()
+                .zip(item["call_id"].as_str())
