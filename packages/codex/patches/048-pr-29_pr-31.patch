+            panic!("missing replay create");
+        };
+        let frame = |item| {
+            RealtimeEvent::DetachedResponse(Box::new(RealtimeEvent::ConversationItemAdded {
+                item,
+                previous_item_id: None,
+            }))
+        };
+        let normalize = |event, detached| {
+            super::super::normalize_historical_replay_receipt(event, &history, detached)
+        };
+        assert!(matches!(
+            normalize(frame(item.clone()), false),
+            RealtimeEvent::ConversationItemAdded { .. }
+        ));
+        assert!(matches!(
+            normalize(frame(item.clone()), true),
+            RealtimeEvent::DetachedResponse(_)
+        ));
+        let mut wrong = item.clone();
+        wrong["id"] = json!("foreign-item");
+        assert!(matches!(
+            normalize(frame(wrong), false),
+            RealtimeEvent::DetachedResponse(_)
+        ));
+        let mut wrong = item.clone();
+        wrong["call_id"] = json!("foreign-call");
+        assert!(matches!(
+            normalize(frame(wrong), false),
+            RealtimeEvent::DetachedResponse(_)
+        ));
+        let request = |response_id| {
+            RealtimeEvent::DetachedResponse(Box::new(RealtimeEvent::FunctionCallRequested(
+                codex_protocol::protocol::RealtimeFunctionCallRequested {
+                    namespace: None,
+                    call_id: "past-call".into(),
