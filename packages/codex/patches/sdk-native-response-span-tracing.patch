+/// One SDK response scope around a logical model round and all of its attempts.
+/// Construction reuses the public scope's live-parent, ID and export validation.
+pub struct ProviderResponseSpan {
+    key: String,
+    context: Context,
+    finished: AtomicBool,
+}
+
+#[derive(Clone, Copy)]
+pub enum ProviderResponseOutcome {
+    Ok,
+    Error,
+    Cancelled,
+}
+
+pub fn start_provider_response_span(
+    parent: &ContextLease,
+    span_id: Option<String>,
+) -> Result<ProviderResponseSpan, String> {
+    let started = start_trace_span_options(
+        Options {
+            name: "response".into(),
+            kind: "model".into(),
+            parent: Some(parent.token().to_owned()),
+            span_id,
+            ..Options::default()
+        },
+        true,
+    )?;
+    Ok(ProviderResponseSpan {
+        key: started.key,
+        context: explicit_submission_context(started.handle.context.clone()),
+        finished: AtomicBool::new(false),
+    })
+}
+
+impl ProviderResponseSpan {
+    pub fn context(&self) -> Context {
+        self.context.clone()
+    }
+
+    pub fn record_response(&self, response_id: &str) {
+        if !response_id.is_empty()
+            && response_id.len() <= 4096
+            && policy_for_context(&self.context).is_some_and(|policy| policy.include_sensitive_data)
+        {
+            self.context
+                .span()
+                .set_attribute(KeyValue::new("sdk.response.id", response_id.to_owned()));
+        }
+    }
+
+    pub fn finish(&self, outcome: ProviderResponseOutcome) {
+        if self.finished.swap(true, Ordering::AcqRel) {
+            return;
+        }
+        let status = match outcome {
+            ProviderResponseOutcome::Ok => "ok",
+            ProviderResponseOutcome::Error => "error",
+            ProviderResponseOutcome::Cancelled => "cancelled",
+        };
+        let _ = end_trace_span(&self.key, &json!({"status": status}).to_string());
+    }
+}
+
+impl Drop for ProviderResponseSpan {
+    fn drop(&mut self) {
+        self.finish(ProviderResponseOutcome::Cancelled);
+        release_trace_span(&self.key);
+    }
 }
