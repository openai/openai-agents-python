+#[tokio::test]
+async fn retired_environment_rejects_in_flight_and_future_reconnects() -> Result<()> {
+    let _clock = freeze_clock();
+    let executor = Executor::start(Validator::default()).await?;
+    let (client, registry) = executor.client()?;
+    let original = client.get().await?;
+    original.inner.retire().await;
+    let release = registry.block_next_lookup();
+    let reconnect = client.get();
+    tokio::pin!(reconnect);
+    assert!(futures::poll!(reconnect.as_mut()).is_pending());
+    registry.lookup_started.notified().await;
+
+    client.retire_current_connection().await;
+    assert!(matches!(
+        futures::poll!(reconnect.as_mut()),
+        std::task::Poll::Ready(Err(ExecServerError::ConnectionAttempt(_)))
+    ));
+    drop(release);
+    let calls = registry.calls.load(Ordering::Relaxed);
+    assert!(matches!(
+        client.get().await,
+        Err(ExecServerError::Disconnected(_))
+    ));
+    assert!(matches!(
+        client.refresh_connection().await,
+        Err(ExecServerError::Disconnected(_))
+    ));
+    assert_eq!(registry.calls.load(Ordering::Relaxed), calls);
+    assert!(Arc::ptr_eq(
+        &original.inner,
+        &client
+            .cached_client()
+            .expect("original client remains cached")
+            .inner,
+    ));
     Ok(())
 }
 
