         },
     }
 }
+
+/// The caller has already rejected handler lookup and excluded strict rejection.
+pub(crate) async fn format_tool_not_found(
+    invocation: &ToolInvocation,
+    default_message: &str,
+) -> Result<Option<String>, ()> {
+    for contributor in invocation
+        .session
+        .services
+        .extensions
+        .tool_lifecycle_contributors()
+    {
+        let formatted = contributor
+            .on_tool_not_found(codex_extension_api::ToolNotFoundInput {
+                step_store: Some(&invocation.step_context.extension_data),
+                thread_store: &invocation.session.services.thread_extension_data,
+                turn_store: invocation.turn.extension_data.as_ref(),
+                turn_id: &invocation.turn.sub_id,
+                call_id: &invocation.call_id,
+                tool_name: &invocation.tool_name,
+                model: &invocation.step_context.settings.model_info.slug,
+                default_message,
+                cancellation: invocation.cancellation_token.clone(),
+            })
+            .await?;
+        if formatted.is_some() {
+            return Ok(formatted);
+        }
+    }
+    Ok(None)
+}
