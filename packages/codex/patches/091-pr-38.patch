+/// The original native publication remains the projection boundary after idle updates.
+#[derive(Clone)]
+struct HandoffPresentationAnchor(ResponseItem, Arc<std::sync::atomic::AtomicBool>);
+
+impl HandoffPresentationAnchor {
+    fn new(item: ResponseItem) -> Self {
+        Self(item, Arc::new(std::sync::atomic::AtomicBool::new(true)))
+    }
+}
+
+pub(super) fn handoff_presentation_is_live(profile: &AgentProfile) -> bool {
+    profile
+        .data
+        .get::<HandoffPresentationAnchor>()
+        .is_none_or(|anchor| anchor.1.load(std::sync::atomic::Ordering::Acquire))
+}
+
+pub(super) fn handoff_presentation_anchor(profile: &AgentProfile) -> ResponseItem {
+    profile
+        .data
+        .get::<HandoffPresentationAnchor>()
+        .map_or_else(
+            || profile.application_instructions.item.clone(),
+            |anchor| anchor.0.clone(),
