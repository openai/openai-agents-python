+    #[tokio::test]
+    async fn prepared_owner_waits_for_real_publication_and_refuses_cancelled_admission() {
+        for cancel in [false, true] {
+            let (mut session, context) = make_session_and_context().await;
+            attach_thread_persistence(&mut session).await;
+            let source = session.activate_agent_profile(None, profile(&context, "a", "owned-source"))
+                .await.unwrap();
+            let target = profile(&context, "b", "owned-target");
+            let observer = Arc::new(ObserveProfileAdmission::default());
+            target.data.insert(codex_extension_api::AgentProfileAdmissionObserverOwner(observer.clone()));
+            let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+            extensions.turn_lifecycle_contributor(Arc::new(BoundaryActivation {
+                candidate: std::sync::Mutex::new(Some(codex_extension_api::AgentProfileActivation {
+                    expected: source.clone(), target,
+                })), gate: None,
+            }));
+            session.services.extensions = Arc::new(extensions.build());
+            let session = Arc::new(session);
+            let root = session.new_default_turn().await;
+            let entered = Arc::new(Notify::new());
+            assert!(session.start_task(Arc::clone(&root), Vec::new(), HoldProfileRoot(entered.clone())).await);
+            tokio::time::timeout(std::time::Duration::from_secs(15), entered.notified()).await.unwrap();
+            let root_cancel = session.active_turn.lock().await.as_ref().unwrap().task.as_ref().unwrap()
+                .cancellation_token.clone();
+            let batch_cancel = root_cancel.child_token();
+            let gate = super::super::thread_settings::acquire_persistence_lock(&session).await;
+            let activation = session.activate_agent_at_tool_boundary(&root, &batch_cancel, None);
+            tokio::pin!(activation);
+            assert!(futures::poll!(&mut activation).is_pending());
+            assert_eq!(observer.accepted.load(std::sync::atomic::Ordering::SeqCst), 0);
+            assert_eq!(observer.refused.load(std::sync::atomic::Ordering::SeqCst), 0);
+            if cancel { batch_cancel.cancel(); }
+            drop(gate);
+            if cancel {
+                assert!(activation.await.is_err());
+                assert_eq!(session.agent_profile_receipt().await.unwrap(), Some(source));
+                assert_eq!(observer.accepted.load(std::sync::atomic::Ordering::SeqCst), 0);
+                assert_eq!(observer.refused.load(std::sync::atomic::Ordering::SeqCst), 1);
