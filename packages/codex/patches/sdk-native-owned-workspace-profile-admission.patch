+struct AgentProfileAdmissionGuard {
+    owner: Option<std::sync::Arc<codex_extension_api::AgentProfileAdmissionObserverOwner>>,
+    accepted: bool,
+}
+
+impl AgentProfileAdmissionGuard {
+    fn new(profile: &AgentProfile) -> Self {
+        Self { owner: profile.data.get::<codex_extension_api::AgentProfileAdmissionObserverOwner>(), accepted: false }
+    }
+
+    fn accept(&mut self, receipt: &AgentProfileReceipt) {
+        self.accepted = true;
+        if let Some(owner) = &self.owner {
+            owner.0.accepted(receipt);
+        }
+    }
+}
+
+impl Drop for AgentProfileAdmissionGuard {
+    fn drop(&mut self) {
+        if !self.accepted {
+            if let Some(owner) = &self.owner {
+                owner.0.refused();
+            }
+        }
+    }
+}
