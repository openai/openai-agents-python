+#[cfg(test)]
+mod text_demand_tests {
+    use super::*;
+    #[tokio::test]
+    async fn actual_websocket_parser_flushes_text_before_tool_and_terminal() {
+        let (tx_command, mut rx_command) = mpsc::channel(1);
+        let (tx_message, rx_message) = mpsc::unbounded_channel();
+        let pump_task = tokio::spawn(async move {
+            let Some(WsCommand::Send { tx_result, .. }) = rx_command.recv().await else {
+                panic!("missing create");
+            };
+            tx_result.send(Ok(())).unwrap();
+        });
+        for event in [
+            serde_json::json!({"type":"response.output_text.delta", "item_id":"i", "output_index":0, "content_index":0, "delta":"a", "logprobs":[]}),
+            serde_json::json!({"type":"response.output_text.delta", "item_id":"i", "output_index":0, "content_index":0, "delta":"b", "logprobs":[]}),
+            serde_json::json!({"type":"response.output_item.done", "item":{"type":"function_call", "id":"f", "call_id":"call", "name":"tool", "arguments":"{}"}}),
+            serde_json::json!({"type":"response.completed", "response":{"id":"r", "status":"completed"}}),
+        ] {
+            tx_message
+                .send(Ok(Message::Text(event.to_string().into())))
+                .unwrap();
+        }
+        drop(tx_message);
+        let mut stream = WsStream {
+            tx_command,
+            rx_message,
+            pump_task,
+            upgrade_rate_limits: None,
+        };
+        let (tx, mut rx) = mpsc::channel(32);
+        let (_interrupt, interrupted) = oneshot::channel();
+        let context = ResponsesWebsocketTimingLogContext {
+            model: "test".into(),
+            session_id: None,
+            thread_id: None,
+            turn_id: None,
+            traceparent: None,
+            previous_response_id: None,
+            request_start_ms: None,
+            warmup: false,
+            connection_reused: false,
+        };
+        run_websocket_response_stream(
+            &mut stream,
+            tx,
+            "{}".into(),
+            Some(Duration::from_secs(1)),
+            Some(Duration::from_secs(1)),
+            None,
+            None,
+            &context,
+            interrupted,
+            false,
+            None,
+            Some(Arc::default()),
+        )
+        .await
+        .unwrap();
+        let mut tags = Vec::new();
+        let mut text = String::new();
+        while let Some(event) = rx.recv().await {
+            match event.unwrap() {
+                ResponseEvent::OutputTextDelta(s) => {
+                    text.push_str(&s);
+                    tags.push("text");
+                }
+                ResponseEvent::ResponseFact(_) => tags.push("fact"),
+                ResponseEvent::OutputItemDone(
+                    codex_protocol::models::ResponseItem::FunctionCall { call_id, .. },
+                ) => {
+                    assert_eq!(call_id, "call");
+                    tags.push("tool");
+                }
+                ResponseEvent::ResponseObserved(_) => tags.push("observed"),
+                ResponseEvent::Completed { .. } => tags.push("completed"),
+                other => panic!("unexpected {other:?}"),
+            }
+        }
+        assert_eq!(text, "ab");
+        assert_eq!(
+            tags,
+            ["fact", "text", "text", "tool", "observed", "completed"]
+        );
+        (&mut stream.pump_task).await.unwrap();
+    }
+    #[tokio::test(start_paused = true)]
+    async fn demand_wakes_pending_websocket_without_restarting_idle_deadline() {
+        assert_pending_websocket_text_demand(Some(Duration::from_secs(10))).await;
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn demand_wakes_pending_websocket_with_receive_deadline_disabled() {
+        assert_pending_websocket_text_demand(None).await;
+    }
+
+    async fn assert_pending_websocket_text_demand(receive_timeout: Option<Duration>) {
+        let (tx_command, mut rx_command) = mpsc::channel(1);
+        let (tx_message, rx_message) = mpsc::unbounded_channel();
+        let pump_task = tokio::spawn(async move {
+            let Some(WsCommand::Send { tx_result, .. }) = rx_command.recv().await else {
+                panic!("missing create");
+            };
+            tx_result.send(Ok(())).unwrap();
+        });
+        for event in [
+            serde_json::json!({"type":"response.created", "response":{"id":"r"}}),
+            serde_json::json!({"type":"response.output_text.delta", "item_id":"i", "output_index":0, "content_index":0, "delta":"a"}),
+            serde_json::json!({"type":"response.output_text.delta", "item_id":"i", "output_index":0, "content_index":0, "delta":"b"}),
+        ] {
+            tx_message
+                .send(Ok(Message::Text(event.to_string().into())))
+                .unwrap();
+        }
+        let mut stream = WsStream {
+            tx_command,
+            rx_message,
+            pump_task,
+            upgrade_rate_limits: None,
+        };
+        let (tx, mut rx) = mpsc::channel(16);
+        let (_interrupt, interrupted) = oneshot::channel();
+        let demand = Arc::new(crate::TextDeltaDemand::default());
+        let producer_demand = demand.clone();
+        let producer = tokio::spawn(async move {
+            let context = ResponsesWebsocketTimingLogContext {
+                model: "test".into(),
+                session_id: None,
+                thread_id: None,
+                turn_id: None,
+                traceparent: None,
+                previous_response_id: None,
+                request_start_ms: None,
+                warmup: false,
+                connection_reused: false,
+            };
+            let result = run_websocket_response_stream(
+                &mut stream,
+                tx,
+                "{}".into(),
+                Some(Duration::from_secs(10)),
+                receive_timeout,
+                None,
+                None,
+                &context,
+                interrupted,
+                false,
+                None,
+                Some(producer_demand),
+            )
+            .await;
+            (&mut stream.pump_task).await.unwrap();
+            result
+        });
+        assert!(matches!(
+            rx.recv().await.unwrap().unwrap(),
+            ResponseEvent::Created { .. }
+        ));
+        assert!(
+            matches!(rx.recv().await.unwrap().unwrap(), ResponseEvent::OutputTextDelta(t) if t=="a")
+        );
+        tokio::task::yield_now().await;
+        tokio::time::advance(Duration::from_secs(6)).await;
+        demand.cancel();
+        assert!(
+            matches!(rx.recv().await.unwrap().unwrap(), ResponseEvent::OutputTextDelta(t) if t=="b")
+        );
+        tokio::time::advance(Duration::from_secs(5)).await;
+        tokio::task::yield_now().await;
+        if receive_timeout.is_some() {
+            assert!(
+                producer.is_finished(),
+                "observation demand restarted the idle deadline"
+            );
+            assert!(
+                matches!(producer.await.unwrap(), Err(ApiError::Stream(message)) if message.contains("idle timeout"))
+            );
+        } else {
+            assert!(
+                !producer.is_finished(),
+                "disabled receive deadline expired after observation demand"
+            );
+            tx_message
+                .send(Ok(Message::Text(
+                    serde_json::json!({"type":"response.completed", "response":{"id":"r", "status":"completed"}})
+                        .to_string()
+                        .into(),
+                )))
+                .unwrap();
+            assert!(matches!(
+                rx.recv().await.unwrap().unwrap(),
+                ResponseEvent::ResponseObserved(_)
+            ));
+            assert!(matches!(
+                rx.recv().await.unwrap().unwrap(),
+                ResponseEvent::Completed { response_id, .. } if response_id == "r"
+            ));
+            assert!(producer.await.unwrap().is_ok());
+        }
+        drop(tx_message);
+    }
+}
