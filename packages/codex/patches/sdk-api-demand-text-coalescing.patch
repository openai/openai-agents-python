+                    }
+                    ResponseEvent::ResponseObserved(_) => tags.push("observed"),
+                    ResponseEvent::Completed { .. } => tags.push("completed"),
+                    e => panic!("unexpected {e:?}"),
+                }
+            }
+            assert_eq!(texts.concat(), "abcde");
+            if raw {
+                assert_eq!(raws, events);
+                assert_eq!(texts, ["a", "b", "c", "d", "e"]);
+            } else {
+                assert_eq!(texts, ["a", "bc", "d", "e"]);
+                assert_eq!(
+                    tags,
+                    [
+                        "fact",
+                        "text",
+                        "text",
+                        "fact",
+                        "text",
+                        "fact",
+                        "text",
+                        "observed",
+                        "completed"
+                    ]
+                );
+            }
+        }
+    }
+    #[tokio::test(start_paused = true)]
+    async fn demand_wakes_pending_sse_without_restarting_idle_deadline() {
+        let (input, mut incoming) =
+            mpsc::channel::<Result<bytes::Bytes, codex_client::TransportError>>(8);
+        let bytes: ByteStream =
+            Box::pin(futures::stream::poll_fn(move |cx| incoming.poll_recv(cx)));
+        let (tx, mut rx) = mpsc::channel(16);
+        let demand = Arc::new(crate::TextDeltaDemand::default());
+        let owner_demand = demand.clone();
+        let producer = tokio::spawn(process_sse_with_treatment(
+            bytes,
+            tx,
+            Duration::from_secs(10),
+            None,
+            SafetyBufferingTreatment::default(),
+            false,
+            false,
+            Some(owner_demand),
+        ));
+        for text in ["a", "b"] {
+            input.send(Ok(bytes::Bytes::from(format!("data: {{\"type\":\"response.output_text.delta\",\"item_id\":\"i\",\"output_index\":0,\"content_index\":0,\"delta\":\"{text}\"}}\n\n")))).await.unwrap();
+        }
+        assert!(
+            matches!(rx.recv().await.unwrap().unwrap(), ResponseEvent::OutputTextDelta(t) if t=="a")
+        );
+        tokio::task::yield_now().await;
+        tokio::time::advance(Duration::from_secs(6)).await;
+        demand.cancel();
+        assert!(
+            matches!(rx.recv().await.unwrap().unwrap(), ResponseEvent::OutputTextDelta(t) if t=="b")
+        );
+        tokio::time::advance(Duration::from_secs(5)).await;
+        tokio::task::yield_now().await;
+        // A reset at activation would still be pending at this point.
+        assert!(
+            matches!(rx.try_recv().unwrap(), Err(ApiError::Stream(message)) if message.contains("idle timeout"))
+        );
+        producer.await.unwrap();
+    }
+}
