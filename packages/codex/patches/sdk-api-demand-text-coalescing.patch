diff --git a/codex-rs/codex-api/src/text_delta.rs b/codex-rs/codex-api/src/text_delta.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a4a70f18059b743bf8e4e30bae9bb8fa6a5eb520
--- /dev/null
+++ b/codex-rs/codex-api/src/text_delta.rs
@@ -0,0 +1,285 @@
+//! Request-local accumulation; the original parser task keeps transport ownership.
+use crate::sse::ResponsesStreamEvent;
+use crate::{ApiError, ResponseEvent};
+use std::sync::Arc;
+use tokio::sync::mpsc;
+
+/// A sticky observation-demand latch, never a task cancellation owner.
+pub type TextDeltaDemand = tokio_util::sync::CancellationToken;
+
+pub(crate) struct TextDeltaBuffer {
+    pub(crate) demand: Option<Arc<TextDeltaDemand>>,
+    identity: Option<(String, u64, u64)>,
+    text: String,
+}
+impl TextDeltaBuffer {
+    pub(crate) fn new(demand: Option<Arc<TextDeltaDemand>>) -> Self {
+        Self {
+            demand,
+            identity: None,
+            text: String::new(),
+        }
+    }
+    pub(crate) fn enabled(&self) -> bool {
+        self.demand.is_some()
+    }
+    pub(crate) async fn activate(
+        &mut self,
+        tx: &mpsc::Sender<Result<ResponseEvent, ApiError>>,
+    ) -> Result<(), ()> {
+        self.demand = None;
+        self.flush(tx).await
+    }
+    pub(crate) async fn flush(
+        &mut self,
+        tx: &mpsc::Sender<Result<ResponseEvent, ApiError>>,
+    ) -> Result<(), ()> {
+        if !self.text.is_empty() {
+            tx.send(Ok(ResponseEvent::OutputTextDelta(std::mem::take(
+                &mut self.text,
+            ))))
+            .await
+            .map_err(|_| ())?;
+        }
+        Ok(())
+    }
+    // The wire identity is still present here; OutputTextDelta itself has none.
+    pub(crate) async fn push(
+        &mut self,
+        event: &ResponsesStreamEvent,
+        tx: &mpsc::Sender<Result<ResponseEvent, ApiError>>,
+    ) -> Result<bool, ()> {
+        let Some(demand) = &self.demand else {
+            return Ok(false);
+        };
+        if demand.is_cancelled() {
+            self.activate(tx).await?;
+            return Ok(false);
+        }
+        let raw = &event.raw;
+        let candidate = (|| {
+            if raw.get("type")?.as_str()? != "response.output_text.delta" {
+                return None;
+            }
+            if raw.as_object()?.keys().any(|key| {
+                !matches!(
+                    key.as_str(),
+                    "type"
+                        | "item_id"
+                        | "output_index"
+                        | "content_index"
+                        | "delta"
+                        | "logprobs"
+                        | "sequence_number"
+                        | "obfuscation"
+                )
+            }) {
+                return None;
+            }
+            let item = raw.get("item_id")?.as_str()?;
+            if item.is_empty() || item.len() > 256 {
+                return None;
+            }
+            match raw.get("logprobs") {
+                None | Some(serde_json::Value::Null) => {}
+                Some(serde_json::Value::Array(tokens)) if tokens.is_empty() => {}
+                _ => return None,
+            }
+            let delta = raw.get("delta")?.as_str()?;
+            if delta.is_empty() {
+                return None;
+            }
+            Some((
+                (
+                    item,
+                    raw.get("output_index")?.as_u64()?,
+                    raw.get("content_index")?.as_u64()?,
+                ),
+                delta,
+            ))
+        })();
+        let Some((identity, delta)) = candidate else {
+            self.flush(tx).await?;
+            self.identity = None;
+            return Ok(false);
+        };
+        if self
+            .identity
+            .as_ref()
+            .map(|(item, output, content)| (item.as_str(), *output, *content))
+            != Some(identity)
+        {
+            self.flush(tx).await?;
+            self.identity = Some((identity.0.to_owned(), identity.1, identity.2));
+            return Ok(false); // First delta for this item/content remains immediate.
+        }
+        const MAX_BYTES: usize = 16 * 1024;
+        if self.text.len().saturating_add(delta.len()) > MAX_BYTES {
+            self.flush(tx).await?;
+        }
+        if delta.len() > MAX_BYTES {
+            return Ok(false);
+        }
+        self.text.push_str(delta);
+        // Replacing sends must not remove cooperative cancellation progress.
+        tokio::task::consume_budget().await;
+        Ok(true)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn delta(text: &str, item: &str, probability: serde_json::Value) -> ResponsesStreamEvent {
+        ResponsesStreamEvent::from_wire(serde_json::json!({"type":"response.output_text.delta", "item_id":item, "output_index":0, "content_index":0, "delta":text, "logprobs":probability})).unwrap()
+    }
+    #[tokio::test]
+    async fn first_identity_probability_and_size_barriers_preserve_text() {
+        let (tx, mut rx) = mpsc::channel(32);
+        let mut buffer = TextDeltaBuffer::new(Some(Arc::default()));
+        assert!(
+            !buffer
+                .push(&delta("", "a", serde_json::json!([])), &tx)
+                .await
+                .unwrap()
+        );
+        assert!(
+            !buffer
+                .push(&delta("first", "a", serde_json::json!([])), &tx)
+                .await
+                .unwrap()
+        );
+        assert!(
+            buffer
+                .push(&delta("second", "a", serde_json::json!([])), &tx)
+                .await
+                .unwrap()
+        );
+        assert!(
+            !buffer
+                .push(&delta("new", "b", serde_json::json!([])), &tx)
+                .await
+                .unwrap()
+        );
+        assert!(
+            matches!(rx.recv().await.unwrap().unwrap(), ResponseEvent::OutputTextDelta(s) if s=="second")
+        );
+        assert!(
+            buffer
+                .push(&delta("pending", "b", serde_json::json!([])), &tx)
+                .await
+                .unwrap()
+        );
+        for probability in [
+            serde_json::json!([{"token":"x","logprob":-1.0}]),
+            serde_json::json!({"invalid":true}),
+        ] {
+            assert!(
+                !buffer
+                    .push(&delta("sensitive", "b", probability), &tx)
+                    .await
+                    .unwrap()
+            );
+        }
+        assert!(
+            matches!(rx.recv().await.unwrap().unwrap(), ResponseEvent::OutputTextDelta(s) if s=="pending")
+        );
+        assert!(
+            !buffer
+                .push(&delta("first", "b", serde_json::json!([])), &tx)
+                .await
+                .unwrap()
+        );
+        let block = "x".repeat(16 * 1024);
+        assert!(
+            buffer
+                .push(&delta(&block, "b", serde_json::json!([])), &tx)
+                .await
+                .unwrap()
+        );
+        assert!(
+            buffer
+                .push(&delta("tail", "b", serde_json::json!([])), &tx)
+                .await
+                .unwrap()
+        );
+        assert!(
+            matches!(rx.recv().await.unwrap().unwrap(), ResponseEvent::OutputTextDelta(s) if s==block)
+        );
+        buffer.flush(&tx).await.unwrap();
+        assert!(
+            matches!(rx.recv().await.unwrap().unwrap(), ResponseEvent::OutputTextDelta(s) if s=="tail")
+        );
+        assert!(rx.try_recv().is_err());
+    }
+    #[tokio::test]
+    async fn observation_is_sticky_and_wakes_an_already_pending_wait() {
+        let demand = Arc::new(TextDeltaDemand::default());
+        let (tx, mut rx) = mpsc::channel(8);
+        let mut buffer = TextDeltaBuffer::new(Some(demand.clone()));
+        assert!(
+            !buffer
+                .push(&delta("a", "a", serde_json::json!([])), &tx)
+                .await
+                .unwrap()
+        );
+        assert!(
+            buffer
+                .push(&delta("b", "a", serde_json::json!([])), &tx)
+                .await
+                .unwrap()
+        );
+        let waiter = demand.cancelled();
+        tokio::pin!(waiter);
+        assert!(futures::poll!(waiter.as_mut()).is_pending());
+        demand.cancel();
+        waiter.await;
+        buffer.activate(&tx).await.unwrap();
+        assert!(
+            matches!(rx.recv().await.unwrap().unwrap(), ResponseEvent::OutputTextDelta(s) if s=="b")
+        );
+        assert!(
+            !buffer
+                .push(&delta("c", "a", serde_json::json!([])), &tx)
+                .await
+                .unwrap()
+        );
+        let mut next_request = TextDeltaBuffer::new(Some(demand.clone()));
+        assert!(
+            !next_request
+                .push(&delta("d", "a", serde_json::json!([])), &tx)
+                .await
+                .unwrap()
+        );
+        assert!(!next_request.enabled());
+    }
+}
+
+#[cfg(test)]
+mod cooperative_tests {
+    use super::*;
+    #[tokio::test]
+    async fn skipped_sends_yield_and_leave_the_pending_buffer_owned() {
+        let (tx, mut rx) = mpsc::channel(8);
+        let mut buffer = TextDeltaBuffer::new(Some(Arc::default()));
+        let event = ResponsesStreamEvent::from_wire(serde_json::json!({"type":"response.output_text.delta", "item_id":"i", "output_index":0, "content_index":0, "delta":"x"})).unwrap();
+        assert!(!buffer.push(&event, &tx).await.unwrap());
+        let attempts = std::cell::Cell::new(0);
+        tokio::task::yield_now().await;
+        tokio::select! {
+            biased;
+            _ = async {
+                for _ in 0..4096 {
+                    attempts.set(attempts.get()+1);
+                    assert!(buffer.push(&event,&tx).await.unwrap());
+                }
+            } => panic!("ready skipped sends starved a ready sibling"),
+            _ = std::future::ready(()) => {},
+        }
+        assert!(attempts.get() > 0 && attempts.get() < 4096);
+        buffer.flush(&tx).await.unwrap();
+        assert!(
+            matches!(rx.recv().await.unwrap().unwrap(),ResponseEvent::OutputTextDelta(text) if text=="x".repeat(attempts.get()))
+        );
+    }
+}
