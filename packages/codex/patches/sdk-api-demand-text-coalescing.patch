+#[test]
+fn text_grouping_requires_exact_shared_capability_and_no_capture() {
+    use codex_extension_api::{ModelResponseInterceptor, ModelResponseStream};
+    struct Known(Arc<codex_api::TextDeltaDemand>);
+    impl ModelResponseInterceptor for Known {
+        fn text_delta_demand(&self) -> Option<Arc<codex_api::TextDeltaDemand>> {
+            Some(self.0.clone())
+        }
+        fn intercept(self: Box<Self>, stream: ModelResponseStream) -> ModelResponseStream {
+            stream
+        }
+    }
+    struct Unknown;
+    impl ModelResponseInterceptor for Unknown {
+        fn intercept(self: Box<Self>, stream: ModelResponseStream) -> ModelResponseStream {
+            stream
+        }
+    }
+    let signal = Arc::new(codex_api::TextDeltaDemand::default());
+    let mut interceptors: Vec<Box<dyn ModelResponseInterceptor>> = vec![
+        Box::new(Known(signal.clone())),
+        Box::new(Known(signal.clone())),
+    ];
+    assert!(Arc::ptr_eq(
+        &text_delta_demand(None, false, &interceptors).unwrap(),
+        &signal
+    ));
+    assert!(text_delta_demand(Some(0), false, &interceptors).is_none());
+    assert!(text_delta_demand(Some(3), false, &interceptors).is_none());
+    assert!(text_delta_demand(None, true, &interceptors).is_none());
+    interceptors.push(Box::new(Known(Arc::default())));
+    assert!(text_delta_demand(None, false, &interceptors).is_none());
+    interceptors.pop();
+    interceptors.push(Box::new(Unknown));
+    assert!(text_delta_demand(None, false, &interceptors).is_none());
+}
