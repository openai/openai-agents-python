diff --git a/codex-rs/protocol/src/input_video.rs b/codex-rs/protocol/src/input_video.rs
new file mode 100644
index 00000000..31707113
--- /dev/null
+++ b/codex-rs/protocol/src/input_video.rs
@@ -0,0 +1,66 @@
+//! An opaque remote reference for a model producer. The runtime never fetches it.
+
+use crate::models::{ContentItem, ResponseItem};
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+use ts_rs::TS;
+
+#[derive(Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+#[serde(try_from = "String", into = "String")]
+#[schemars(with = "String")]
+#[ts(type = "string")]
+pub struct VideoUrl(String);
+
+impl VideoUrl {
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl std::fmt::Debug for VideoUrl {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("VideoUrl(..)")
+    }
+}
+
+impl TryFrom<String> for VideoUrl {
+    type Error = &'static str;
+
+    fn try_from(value: String) -> Result<Self, Self::Error> {
+        const INVALID: &str = "video_url must be an absolute HTTP(S) URL without credentials";
+        if value.len() > 8192
+            || value
+                .chars()
+                .any(|character| character.is_whitespace() || character.is_control())
+        {
+            return Err("video_url exceeds the supported size or contains whitespace");
+        }
+        let parsed = gix_url::Url::try_from(value.as_str()).map_err(|_| INVALID)?;
+        if !matches!(
+            parsed.scheme,
+            gix_url::Scheme::Http | gix_url::Scheme::Https
+        ) || parsed.host.as_deref().is_none_or(str::is_empty)
+            || parsed.user().is_some()
+            || parsed.password().is_some()
+        {
+            return Err(INVALID);
+        }
+        Ok(Self(value))
+    }
+}
+
+impl From<VideoUrl> for String {
+    fn from(value: VideoUrl) -> Self {
+        value.0
+    }
+}
+
+pub fn contains_video_input(items: &[ResponseItem]) -> bool {
+    items.iter().any(|item| match item {
+        ResponseItem::Message { content, .. } => content
+            .iter()
+            .any(|part| matches!(part, ContentItem::InputVideo { .. })),
+        _ => false,
+    })
+}
