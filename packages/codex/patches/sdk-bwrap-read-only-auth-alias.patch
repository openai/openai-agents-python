+    #[test]
+    fn root_read_file_deny_coalesces_only_direct_absolute_symlinks() {
+        let temp_dir = TempDir::new().expect("temp dir");
+        let workspace = temp_dir.path().join("workspace");
+        fs::create_dir(&workspace).expect("create workspace");
+        let target = temp_dir.path().join("target");
+        fs::write(&target, "").expect("create target");
+        let alias_parent = temp_dir.path().join("alias-parent");
+        std::os::unix::fs::symlink(&workspace, &alias_parent).expect("create parent symlink");
+
+        for (parent, masks_alias) in [(temp_dir.path(), false), (alias_parent.as_path(), true)] {
+            let alias = parent.join("alias");
+            std::os::unix::fs::symlink(&target, &alias).expect("create absolute symlink");
+
+            let policy = FileSystemSandboxPolicy::restricted(vec![
+                FileSystemSandboxEntry::new(
+                    FileSystemPath::Special {
+                        value: FileSystemSpecialPath::Root,
+                    },
+                    FileSystemAccessMode::Read,
+                ),
