+    pub(super) fn drain_remote_output_for_close(&self, confirmed: bool) {
+        if !confirmed {
+            self.state_tx.send_modify(|state| {
+                if !state.peer_exit_confirmed && state.failure_message.is_none() {
+                    *state = state
+                        .clone()
+                        .failed("could not confirm remote command exit".into());
+                }
+            });
+        }
+        // Peer process exit and output closure are separate receipts. Start the
+        // normal trailing-output grace period without aborting the producer.
+        self.output.cancellation_token.cancel();
     }
 
