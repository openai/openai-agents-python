 use crate::ToolName;
+use std::collections::HashSet;
+use std::sync::OnceLock;
+
+/// The built-in tools exposed by the finalized router for one issuing step.
+/// An executor can retain this receipt before the router finishes selection.
+#[derive(Debug, Default)]
+pub struct FinalStepBuiltinTools(OnceLock<HashSet<ToolName>>);
+
+impl FinalStepBuiltinTools {
+    pub fn names(&self) -> Option<&HashSet<ToolName>> {
+        self.0.get()
+    }
+
+    /// Freeze the first finalized set and require repeated builds to agree.
+    pub fn capture(&self, names: HashSet<ToolName>) -> bool {
+        match self.0.set(names) {
+            Ok(()) => true,
+            Err(names) => self.0.get() == Some(&names),
+        }
+    }
+}

