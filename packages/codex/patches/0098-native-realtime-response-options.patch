+pub(super) fn response_create_json(options: &RealtimeResponseOptions) -> serde_json::Result<Value> {
+    let mut response = Map::new();
+    put(&mut response, "instructions", &options.instructions)?;
+    put(
+        &mut response,
+        "max_output_tokens",
+        &options.max_output_tokens,
+    )?;
+    if let Some(modality) = &options.output_modality {
+        response.insert("output_modalities".into(), serde_json::json!([modality]));
+    }
+    let mut event = serde_json::json!({"type": "response.create"});
+    if !response.is_empty() {
+        event["response"] = Value::Object(response);
+    }
+    Ok(event)
+}
