+/// Canonical local write grants, their filesystem identities, and Linux mounts.
+pub struct LocalWriteRoots<'a> {
+    roots: &'a [AbsolutePathBuf],
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    physical: PhysicalWriteRoots,
+    #[cfg(target_os = "linux")]
+    mounts: WritableMounts,
+}
+
+impl<'a> LocalWriteRoots<'a> {
+    pub fn new(roots: &'a [AbsolutePathBuf]) -> io::Result<Self> {
+        #[cfg(target_os = "linux")]
+        let mounts = if roots.is_empty() {
+            WritableMounts::default()
+        } else {
+            WritableMounts::new(roots, &fs::read("/proc/self/mountinfo")?)?
+        };
+        Ok(Self {
+            roots,
+            #[cfg(any(target_os = "linux", target_os = "macos"))]
+            physical: PhysicalWriteRoots::new(roots)?,
+            #[cfg(target_os = "linux")]
+            mounts,
+        })
+    }
+
+    /// Includes alternate paths to the same filesystem entries and Linux mounts.
+    pub fn contains_entry(&self, path: &Path) -> io::Result<bool> {
+        if self
+            .roots
+            .iter()
+            .any(|root| path.starts_with(root.as_path()))
+        {
+            return Ok(true);
+        }
+        #[cfg(any(target_os = "linux", target_os = "macos"))]
+        if self.physical.contains_entry(path)? {
+            return Ok(true);
+        }
+        #[cfg(target_os = "linux")]
+        return self.mounts.contains_entry(path);
+        #[cfg(not(target_os = "linux"))]
+        Ok(false)
+    }
+
+    /// Detect ordinary hard links to resolved helper files in local write grants.
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    pub fn contains_hard_link_to_any(&self, paths: &[PathBuf]) -> io::Result<bool> {
+        let mut linked_helpers = HashSet::new();
+        for path in paths {
+            let metadata = fs::symlink_metadata(path)?;
+            if metadata.is_file() && metadata.nlink() > 1 {
+                linked_helpers.insert((metadata.dev(), metadata.ino()));
+            }
+        }
+        if linked_helpers.is_empty() {
+            return Ok(false);
+        }
+
+        // A package manager may keep other links outside the grants. Walk the
+        // grants once for all multiply linked helpers and never follow symlinks.
+        let mut directories = Vec::new();
+        for root in self.roots {
+            if !self
+                .roots
+                .iter()
+                .any(|other| root != other && root.as_path().starts_with(other.as_path()))
+            {
+                directories.push((root.as_path(), root.as_path().to_path_buf()));
+            }
+        }
+        while let Some((root, directory)) = directories.pop() {
+            #[cfg(target_os = "linux")]
+            let (_directory_fd, entries) = read_helper_directory(root, &directory)?;
+            #[cfg(not(target_os = "linux"))]
+            let entries = fs::read_dir(&directory)?;
+            for entry in entries {
+                let entry = entry?;
+                let kind = entry.file_type()?;
+                if kind.is_dir() {
+                    directories.push((root, directory.join(entry.file_name())));
+                } else if kind.is_file() {
+                    let metadata = entry.metadata()?;
+                    if linked_helpers.contains(&(metadata.dev(), metadata.ino())) {
+                        return Ok(true);
+                    }
+                }
+            }
+        }
+        Ok(false)
+    }
+
+    #[cfg(not(any(target_os = "linux", target_os = "macos")))]
+    pub fn contains_hard_link_to_any(&self, _paths: &[PathBuf]) -> io::Result<bool> {
+        Ok(false)
+    }
+
+    /// Includes physical ancestors of a grant and mounts below the protected path.
+    pub fn has_root_at_or_below(&self, path: &Path) -> io::Result<bool> {
+        if self
+            .roots
+            .iter()
+            .any(|root| root.as_path().starts_with(path))
+        {
+            return Ok(true);
+        }
+        #[cfg(any(target_os = "linux", target_os = "macos"))]
+        if self.physical.has_root_at_or_below(path)? {
+            return Ok(true);
+        }
+        #[cfg(target_os = "linux")]
+        return self.mounts.contains_descendant(path);
+        #[cfg(not(target_os = "linux"))]
+        Ok(false)
+    }
+}
+
+// A finite bind view can exceed PATH_MAX even when its original tree does not.
+// Keep the ordinary path walk fast; reopen only overlong paths one component at
+// a time. Retain the final descriptor until its ReadDir entries have been used.
+#[cfg(target_os = "linux")]
+fn read_helper_directory(
+    root: &Path,
+    directory: &Path,
+) -> io::Result<(Option<fs::File>, fs::ReadDir)> {
+    match fs::read_dir(directory) {
+        Ok(entries) => Ok((None, entries)),
+        Err(error) if error.raw_os_error() == Some(libc::ENAMETOOLONG) => {
+            let relative = directory.strip_prefix(root).map_err(io::Error::other)?;
+            // Preserve the existing grant-root lookup, including an explicit
+            // root alias. Descendants are still never followed through symlinks.
+            let mut opened = fs::File::open(root)?;
+            for component in relative {
+                let path =
+                    PathBuf::from(format!("/proc/self/fd/{}", opened.as_raw_fd())).join(component);
+                opened = fs::OpenOptions::new()
+                    .read(true)
+                    .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW)
+                    .open(path)?;
+            }
+            let entries = fs::read_dir(format!("/proc/self/fd/{}", opened.as_raw_fd()))?;
+            Ok((Some(opened), entries))
+        }
+        Err(error) => Err(error),
+    }
+}
