+        let roots = [AbsolutePathBuf::from_absolute_path(&root)?];
+        let grants = LocalWriteRoots::new(&roots)?;
+
+        assert!(grants.contains_entry(&alternate.join("grant/existing"))?);
+        assert!(grants.contains_entry(&alternate.join("grant/missing/child"))?);
+        assert!(!grants.contains_entry(&alternate)?);
+        assert!(grants.has_root_at_or_below(&alternate)?);
+        assert!(grants.has_root_at_or_below(&alternate.join("grant"))?);
+        assert!(!grants.has_root_at_or_below(&alternate.join("grant/missing"))?);
+        assert!(!grants.contains_entry(&alternate.join("sibling"))?);
+        assert!(!grants.has_root_at_or_below(&alternate.join("sibling"))?);
+        Ok(())
+    }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn hard_link_scan_handles_deep_directories_without_skipping_helpers() -> io::Result<()> {
+        let temp = tempfile::tempdir()?;
+        let helper = temp.path().join("helper");
+        fs::write(&helper, "synthetic helper")?;
+        let store = temp.path().join("store");
+        fs::create_dir(&store)?;
+        fs::hard_link(&helper, store.join("store-entry"))?;
+        for (name, depth, width) in [("ordinary", 600, 1), ("overlong", 19, 240)] {
+            let workspace = temp.path().join(name);
+            fs::create_dir(&workspace)?;
+            let mut directory = fs::File::open(&workspace)?;
+            for _ in 0..depth {
+                let path = PathBuf::from(format!("/proc/self/fd/{}", directory.as_raw_fd()))
+                    .join("d".repeat(width));
+                fs::create_dir(&path)?;
+                directory = fs::File::open(path)?;
+            }
+            let deepest = PathBuf::from(format!("/proc/self/fd/{}", directory.as_raw_fd()));
+            std::os::unix::fs::symlink(&store, deepest.join("outside-store"))?;
+            let roots = [AbsolutePathBuf::from_absolute_path(&workspace)?];
+            let grants = LocalWriteRoots::new(&roots)?;
+            let helpers = [helper.clone()];
+            assert!(!grants.contains_hard_link_to_any(&helpers)?, "{name}");
+            fs::hard_link(&helper, deepest.join("helper-alias"))?;
+            assert!(grants.contains_hard_link_to_any(&helpers)?, "{name}");
+        }
+        Ok(())
+    }
