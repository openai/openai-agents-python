+#[cfg(target_os = "linux")]
+#[derive(Default)]
+struct WritableMounts {
+    mounts: Vec<Mount>,
+    identities: HashSet<EntryIdentity>,
+    backing_entries: HashSet<BackingEntry>,
+}
+
+#[cfg(target_os = "linux")]
+impl WritableMounts {
+    fn new(roots: &[AbsolutePathBuf], mountinfo: &[u8]) -> io::Result<Self> {
+        let mut grants = Self::default();
+        for line in mountinfo
+            .split(|&byte| byte == b'\n')
+            .filter(|line| !line.is_empty())
+        {
+            let mut fields = line.split(|&byte| byte == b' ').skip(3);
+            let (Some(backing), Some(destination)) = (fields.next(), fields.next()) else {
+                return Err(io::Error::other("invalid mountinfo entry"));
+            };
+            grants.mounts.push(Mount {
+                destination: decode_mountinfo_path(destination)?,
+                backing: backing
+                    .starts_with(b"/")
+                    .then(|| decode_mountinfo_path(backing))
+                    .transpose()?,
+            });
+        }
+        for root in roots {
+            grants.insert(root.as_path(), write_root_identity(root.as_path())?);
+        }
+        for index in 0..grants.mounts.len() {
+            let destination = &grants.mounts[index].destination;
+            if roots
+                .iter()
+                .any(|root| destination.starts_with(root.as_path()))
+                && let Some(identity) = entry_identity(destination)?
+            {
+                // Use the visible entry because mountinfo can also describe covered mounts.
+                grants.insert(&destination.clone(), identity);
+            }
+        }
+        Ok(grants)
+    }
+
+    fn insert(&mut self, path: &Path, identity: EntryIdentity) {
+        self.identities.insert(identity);
+        self.backing_entries
+            .extend(self.mounts.iter().filter_map(|mount| {
+                Some(BackingEntry {
+                    visible: path.to_path_buf(),
+                    backing: mount.backing_path(path)?,
+                    identity,
+                })
+            }));
+    }
+
+    fn contains_entry(&self, path: &Path) -> io::Result<bool> {
+        if self.identities.is_empty() {
+            return Ok(false);
+        }
+        let Some(identity) = entry_identity(path)? else {
+            return Ok(false);
+        };
+        if self.identities.contains(&identity) {
+            return Ok(true);
+        }
+        for mount in &self.mounts {
+            if let Some(backing) = mount.backing_path(path)
+                && self.contains_backing_path(&backing, identity)?
+            {
+                return Ok(true);
+            }
+        }
+        Ok(false)
+    }
+
+    fn contains_backing_path(&self, backing: &Path, identity: EntryIdentity) -> io::Result<bool> {
+        for entry in &self.backing_entries {
+            let Ok(relative) = backing.strip_prefix(&entry.backing) else {
+                continue;
+            };
+            // The protected path can be mounted from beneath a grant. Confirm the
+            // proposed writable name still exposes that inode without following a
+            // symlink out of the grant or through a covered mount.
+            let candidate = join_mount_relative(&entry.visible, relative);
+            if entry_identity(&candidate)? == Some(identity)
+                && fs::canonicalize(&candidate)? == candidate
+            {
+                return Ok(true);
+            }
+        }
+        Ok(false)
+    }
+
+    fn contains_descendant(&self, path: &Path) -> io::Result<bool> {
+        for mount in &self.mounts {
+            let (directory, backing) = if let Some(backing) = mount.backing_path(path) {
+                (path, backing)
+            } else if mount.destination.starts_with(path)
+                && let Some(backing) = &mount.backing
+            {
+                (mount.destination.as_path(), backing.clone())
+            } else {
+                continue;
+            };
+            if let Some(identity) = entry_identity(directory)?
+                && self.contains_backing_path(&backing, identity)?
+            {
+                return Ok(true);
+            }
+            for entry in &self.backing_entries {
+                // Mount roots propose a location. Stat the candidate to establish actual
+                // identity, including when a different mount covers the proposed path.
+                let Ok(relative) = entry.backing.strip_prefix(&backing) else {
+                    continue;
+                };
+                if entry_identity(&join_mount_relative(directory, relative))?
+                    == Some(entry.identity)
+                {
+                    return Ok(true);
+                }
+            }
+        }
+        Ok(false)
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn join_mount_relative(path: &Path, relative: &Path) -> PathBuf {
+    // Adding a slash to a file mount's own path makes it unstatable.
+    if relative.as_os_str().is_empty() {
+        path.to_path_buf()
+    } else {
+        path.join(relative)
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+fn write_root_identity(path: &Path) -> io::Result<EntryIdentity> {
+    entry_identity(path)?
+        .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "local writable root disappeared"))
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+fn entry_identity(path: &Path) -> io::Result<Option<EntryIdentity>> {
+    match fs::symlink_metadata(path) {
+        Ok(metadata) => Ok(Some((metadata.dev(), metadata.ino()))),
+        Err(error)
+            if matches!(
+                error.kind(),
+                io::ErrorKind::NotFound | io::ErrorKind::NotADirectory
+            ) =>
+        {
+            Ok(None)
+        }
+        Err(error) => Err(error),
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub fn decode_mountinfo_path(encoded: &[u8]) -> io::Result<PathBuf> {
+    let mut decoded = Vec::new();
+    let mut bytes = encoded.iter().copied();
+    while let Some(byte) = bytes.next() {
+        decoded.push(if byte == b'\\' {
+            let digits: Vec<_> = bytes.by_ref().take(3).collect();
+            match digits.as_slice() {
+                b"040" => b' ',
+                b"011" => b'\t',
+                b"012" => b'\n',
+                b"134" => b'\\',
+                _ => return Err(io::Error::other("invalid mountinfo path escape")),
+            }
+        } else {
+            byte
+        });
+    }
+    let path = PathBuf::from(std::ffi::OsString::from_vec(decoded));
+    if !path.is_absolute() {
+        return Err(io::Error::other("mountinfo path is not absolute"));
+    }
+    Ok(path)
+}
