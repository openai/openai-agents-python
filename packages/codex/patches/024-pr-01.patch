+/// A live local exec can outlast the invocation only after its handle is delivered.
+pub(crate) struct PendingLocalExec {
+    pub(crate) process_id: i32,
+    process: Arc<UnifiedExecProcess>,
+    returned: Arc<AtomicBool>,
+}
+
+impl PendingLocalExec {
+    pub(crate) fn mark_delivered(self) {
+        self.returned.store(true, Ordering::Release);
+    }
+}
+
+impl Drop for PendingLocalExec {
+    fn drop(&mut self) {
+        if !self.returned.load(Ordering::Acquire) && !self.process.has_exited() {
+            self.process.request_terminate();
+        }
+    }
