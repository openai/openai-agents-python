+    fn start_managed_process(
+        &mut self,
+        process_id: i32,
+        generation: &Arc<()>,
+        turn: &Arc<codex_extension_api::ExtensionData>,
+        process: &Arc<UnifiedExecProcess>,
+    ) -> Result<(), UnifiedExecError> {
+        if !self.owns_reservation(process_id, generation)
+            || turn.get::<ManagedLocalExecStopped>().is_some()
+        {
+            return Err(UnifiedExecError::process_failed("command cancelled".into()));
+        }
+        if self.processes.contains_key(&process_id) {
+            return Err(UnifiedExecError::create_process(
+                "a command already owns this process id".into(),
+            ));
+        }
+        let std::collections::hash_map::Entry::Vacant(starting) =
+            self.starting_processes.entry(process_id)
+        else {
+            return Err(UnifiedExecError::create_process(
+                "a command already owns this process id".into(),
+            ));
+        };
+        starting.insert(StartingManagedProcess {
+            turn: Arc::clone(turn),
+            process: Arc::clone(process),
+        });
+        // Hold the same lock used by interrupt and store promotion. A command
+        // can start only after the interrupt barrier has a process to join.
+        if let Err(err) = process.start_managed_local_sandbox() {
+            self.starting_processes.remove(&process_id);
+            return Err(UnifiedExecError::create_process(err.to_string()));
+        }
+        Ok(())
+    }
+
+    fn remove_starting_process(
+        &mut self,
+        process_id: i32,
+        process: &Arc<UnifiedExecProcess>,
+    ) -> bool {
+        let std::collections::hash_map::Entry::Occupied(starting) =
+            self.starting_processes.entry(process_id)
+        else {
+            return false;
+        };
+        if !Arc::ptr_eq(&starting.get().process, process) {
+            return false;
+        }
+        starting.remove();
+        true
+    }
+}
