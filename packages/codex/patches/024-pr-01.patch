+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+unsigned int la_version(unsigned int version) { return version; }
+
+__attribute__((constructor)) static void loaded(void) {
+    const char *names[] = {"CODEX_TEST_OUTSIDE_MARKER", "CODEX_TEST_INSIDE_MARKER"};
+    for (unsigned int i = 0; i < 2; ++i) {
+        const char *path = getenv(names[i]);
+        if (path == NULL) continue;
+        int fd = open(path, O_WRONLY | O_CREAT | O_APPEND, 0600);
+        if (fd >= 0) {
+            write(fd, "loaded\n", 7);
+            close(fd);
+        }
+    }
+    write(STDOUT_FILENO, "payload-constructor\n", 20);
+}
