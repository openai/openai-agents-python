+fn terminal_observation(response_id: &str) -> ResponseEvent {
+    ResponseEvent::ResponseObserved(codex_protocol::protocol::ResponseObservation {
+        response_id: Some(response_id.to_owned()),
+        status: codex_protocol::protocol::ResponseObservationStatus::Completed,
+        incomplete_reason: None,
+        usage: None,
+    })
+}
+
+#[tokio::test]
+async fn observation_retention_precedes_upstream_rejection() {
+    let polled = Arc::new(AtomicUsize::new(0));
+    let observed_polls = Arc::clone(&polled);
+    let api_stream = futures::stream::iter([
+        Ok(terminal_observation("retained")),
+        Err(ApiError::Stream("integrity rejection".to_owned())),
+    ])
+    .inspect(move |_| {
+        observed_polls.fetch_add(1, Ordering::SeqCst);
+    });
+    let (mut stream, _) = super::map_response_events(
+        None,
+        api_stream,
+        test_session_telemetry(),
+        InferenceTraceAttempt::disabled(),
+        test_model_provider(),
+    );
+    let (entered, retaining) = tokio::sync::oneshot::channel();
+    let (release, retained) = tokio::sync::oneshot::channel();
+    let consumer = tokio::spawn(async move {
+        assert!(matches!(
+            stream.next().await,
+            Some(Ok(ResponseEvent::ResponseObserved(_)))
+        ));
+        // Hold the consumer at the same boundary as an awaited canonical append.
+        entered.send(()).unwrap();
+        retained.await.unwrap();
+        stream.next().await
+    });
+    retaining.await.unwrap();
+    assert_eq!(polled.load(Ordering::SeqCst), 1);
+    release.send(()).unwrap();
+    let error = tokio::time::timeout(Duration::from_secs(5), consumer)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap()
+        .unwrap_err();
+    assert!(error.to_string().contains("integrity rejection"));
+    assert_eq!(polled.load(Ordering::SeqCst), 2);
+}
+
+#[tokio::test]
+async fn pending_polls_cannot_acknowledge_a_later_observation() {
+    use futures::FutureExt;
+    use futures::Stream;
+
+    let (provider, mut events) = futures::channel::mpsc::unbounded();
+    provider
+        .unbounded_send(Ok(terminal_observation("first")))
+        .unwrap();
+    let polled = Arc::new(AtomicUsize::new(0));
+    let observed_polls = Arc::clone(&polled);
+    let (waiting, first_ack_consumed) = tokio::sync::oneshot::channel();
+    let mut waiting = Some(waiting);
+    let api_stream = futures::stream::poll_fn(move |cx| {
+        let next = std::pin::Pin::new(&mut events).poll_next(cx);
+        if matches!(&next, std::task::Poll::Ready(Some(_))) {
+            observed_polls.fetch_add(1, Ordering::SeqCst);
+        } else if next.is_pending()
+            && let Some(waiting) = waiting.take()
+        {
+            // Reaching upstream Pending proves the first acknowledgment was consumed.
+            waiting.send(()).unwrap();
+        }
+        next
+    });
+    let (mut stream, _) = super::map_response_events(
+        None,
+        api_stream,
+        test_session_telemetry(),
+        InferenceTraceAttempt::disabled(),
+        test_model_provider(),
+    );
+    assert!(matches!(
+        stream.next().await,
+        Some(Ok(ResponseEvent::ResponseObserved(_)))
+    ));
+    assert!(stream.next().now_or_never().is_none());
+    first_ack_consumed.await.unwrap();
+    // These polls happen after the first permit was consumed. An erroneous
+    // extra acknowledgment cannot hide by coalescing with the first permit.
+    for _ in 0..3 {
+        assert!(stream.next().now_or_never().is_none());
+    }
+    provider
+        .unbounded_send(Ok(terminal_observation("second")))
+        .unwrap();
+    provider
+        .unbounded_send(Err(ApiError::Stream("integrity rejection".to_owned())))
+        .unwrap();
+    assert!(matches!(
+        stream.next().await,
+        Some(Ok(ResponseEvent::ResponseObserved(_)))
+    ));
+    assert_eq!(polled.load(Ordering::SeqCst), 2);
+    let error = stream.next().await.unwrap().unwrap_err();
+    assert!(error.to_string().contains("integrity rejection"));
+    assert_eq!(polled.load(Ordering::SeqCst), 3);
+}
+
+#[tokio::test]
+async fn dropped_observation_consumer_joins_blocked_producer() {
+    struct ProducerDropped(Option<tokio::sync::oneshot::Sender<()>>);
+    impl Drop for ProducerDropped {
+        fn drop(&mut self) {
+            let _ = self.0.take().unwrap().send(());
+        }
+    }
+
+    for consume in [false, true] {
+        let (done, joined) = tokio::sync::oneshot::channel();
+        let guard = ProducerDropped(Some(done));
+        let mut event = Some(terminal_observation("abandoned"));
+        let polled = Arc::new(AtomicUsize::new(0));
+        let observed_polls = Arc::clone(&polled);
+        let (started, produced) = tokio::sync::oneshot::channel();
+        let mut started = Some(started);
+        let api_stream = futures::stream::poll_fn(move |_| {
+            let _guard = &guard;
+            observed_polls.fetch_add(1, Ordering::SeqCst);
+            if let Some(event) = event.take() {
+                started.take().unwrap().send(()).unwrap();
+                std::task::Poll::Ready(Some(Ok(event)))
+            } else {
+                std::task::Poll::Pending
+            }
+        });
+        let (mut stream, _) = super::map_response_events(
+            None,
+            api_stream,
+            test_session_telemetry(),
+            InferenceTraceAttempt::disabled(),
+            test_model_provider(),
+        );
+        produced.await.unwrap();
+        if consume {
+            assert!(matches!(
+                stream.next().await,
+                Some(Ok(ResponseEvent::ResponseObserved(_)))
+            ));
+        }
+        assert_eq!(polled.load(Ordering::SeqCst), 1);
+        drop(stream);
+        // The upstream guard drops only when the mapper task actually exits.
+        tokio::time::timeout(Duration::from_secs(5), joined)
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(polled.load(Ordering::SeqCst), 1);
+    }
+}
