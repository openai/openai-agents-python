+#[tokio::test]
+async fn mid_turn_compaction_retention_failure_after_tool_reaches_task_error_owner() {
+    let (release_compaction, compaction_gate) = tokio::sync::oneshot::channel();
+    let (server, _) = start_streaming_sse_server(vec![
+        vec![StreamingSseChunk {
+            gate: None,
+            body: responses::sse(vec![
+                responses::ev_function_call(
+                    "plan-before-compaction",
+                    "update_plan",
+                    r#"{"plan":[{"step":"Record one tool effect","status":"completed"}]}"#,
+                ),
+                responses::ev_completed_with_tokens("sampling-response", 500),
+            ]),
+        }],
+        vec![StreamingSseChunk {
+            gate: Some(compaction_gate),
+            body: responses::sse_completed("compaction-response"),
+        }],
+    ])
+    .await;
+    let mut provider = built_in_model_providers(/*openai_base_url*/ None)["openai"].clone();
+    provider.base_url = Some(format!("{}/v1", server.uri()));
+    provider.supports_websockets = false;
+    let server_uri = server.uri().to_string();
+    let (mut session, turn, events) = make_session_and_context_with_auth_and_config_and_rx(
+        CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+        Vec::new(),
+        move |config| {
+            config.model = Some("gpt-5.2".to_string());
+            config.model_provider = provider;
+            config.chatgpt_base_url = server_uri;
+            config.update_plan_enabled = true;
+            config.model_auto_compact_token_limit = Some(200);
+            let _ = config.features.disable(Feature::TokenBudget);
+            let _ = config.features.disable(Feature::EnableRequestCompression);
+        },
+    )
+    .await;
+    open_thread_persistence(Arc::get_mut(&mut session).expect("unshared session")).await;
+    session
+        .record_conversation_items(&turn, turn.model_info(), &[user_message("Update the plan")])
+        .await;
+    session
+        .spawn_task(
+            Arc::clone(&turn),
+            Vec::new(),
+            crate::tasks::RegularTask::new(),
+        )
+        .await;
+    timeout(Duration::from_secs(10), server.wait_for_request_count(2))
+        .await
+        .expect("tool result must reach the mid-turn compaction request");
+    session
+        .live_thread()
+        .expect("local persistence")
+        .shutdown()
+        .await
+        .expect("close recorder before compaction terminal");
+    release_compaction
+        .send(())
+        .expect("release compaction terminal");
+
+    let mut errors = 0;
+    let mut terminals = 0;
+    let mut plan_updates = 0;
+    timeout(Duration::from_secs(10), async {
+        loop {
+            let event = events.recv().await.expect("owning task event");
+            match event.msg {
+                EventMsg::PlanUpdate(_) => plan_updates += 1,
+                EventMsg::Error(error) => {
+                    errors += 1;
+                    assert!(
+                        error
+                            .message
+                            .contains("Could not retain response observation")
+                    );
+                }
+                EventMsg::TurnComplete(_) | EventMsg::TurnAborted(_) => {
+                    terminals += 1;
+                    break;
+                }
+                _ => {}
+            }
+        }
+    })
+    .await
+    .expect("retention failure must settle its owning task");
+    while let Ok(event) = events.try_recv() {
+        match event.msg {
+            EventMsg::PlanUpdate(_) => plan_updates += 1,
+            EventMsg::Error(_) => errors += 1,
+            EventMsg::TurnComplete(_) | EventMsg::TurnAborted(_) => terminals += 1,
+            _ => {}
+        }
+    }
+    assert_eq!((errors, terminals, plan_updates), (1, 1, 1));
+    let requests = server.requests().await;
+    assert_eq!(
+        requests.len(),
+        2,
+        "retention failure must not repeat inference"
+    );
+    let compaction_request = String::from_utf8_lossy(&requests[1]);
+    assert!(compaction_request.contains("compaction_trigger"));
+    assert!(compaction_request.contains("function_call_output"));
+}
