 impl ResponsesStreamEvent {
+    /// Read only safe typed facts; malformed or missing counters stay unknown.
+    pub(crate) fn response_observation(
+        &self,
+    ) -> Option<codex_protocol::protocol::ResponseObservation> {
+        use codex_protocol::protocol::{
+            ReceivedResponseUsage, ResponseIncompleteReason, ResponseObservation,
+            ResponseObservationStatus,
+        };
+        let status = match self.kind() {
+            "response.completed" => ResponseObservationStatus::Completed,
+            "response.incomplete" => ResponseObservationStatus::Incomplete,
+            "response.failed" => ResponseObservationStatus::Failed,
+            _ => return None,
+        };
+        let response = self.response.as_ref();
+        let usage = response
+            .and_then(|r| r.get("usage"))
+            .filter(|u| u.is_object())
+            .map(|u| ReceivedResponseUsage {
+                input_tokens: u.get("input_tokens").and_then(Value::as_i64),
+                cached_input_tokens: u
+                    .pointer("/input_tokens_details/cached_tokens")
+                    .and_then(Value::as_i64),
+                cache_write_input_tokens: u
+                    .pointer("/input_tokens_details/cache_write_tokens")
+                    .and_then(Value::as_i64),
+                output_tokens: u.get("output_tokens").and_then(Value::as_i64),
+                reasoning_output_tokens: u
+                    .pointer("/output_tokens_details/reasoning_tokens")
+                    .and_then(Value::as_i64),
+                total_tokens: u.get("total_tokens").and_then(Value::as_i64),
+            });
+        let incomplete_reason = (status == ResponseObservationStatus::Incomplete).then(|| {
+            match response
+                .and_then(|r| r.pointer("/incomplete_details/reason"))
+                .and_then(Value::as_str)
+            {
+                Some("content_filter") => ResponseIncompleteReason::ContentFilter,
+                Some("max_output_tokens") => ResponseIncompleteReason::MaxOutputTokens,
+                Some("interrupted") => ResponseIncompleteReason::Interrupted,
+                _ => ResponseIncompleteReason::Unknown,
+            }
+        });
+        Some(ResponseObservation {
+            response_id: response
+                .and_then(|r| r.get("id"))
+                .and_then(Value::as_str)
+                .map(str::to_owned),
+            status,
+            incomplete_reason,
+            usage,
+        })
+    }
