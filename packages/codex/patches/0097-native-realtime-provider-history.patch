+        ] {
+            let mut output = std::io::Cursor::new(Vec::new());
+            image::DynamicImage::new_rgb8(1, 1)
+                .write_to(&mut output, format)
+                .unwrap();
+            let encoded = base64::engine::general_purpose::STANDARD.encode(output.into_inner());
+            let item = json!({"id":"image","type":"message","role":"user","content":[{"type":"input_image","image_url":format!("data:image/{mime};base64,{encoded}")}]});
+            assert!(creation_item(&item).is_ok());
+        }
+        let audio = json!({"id":"audio","type":"message","role":"user","content":[{"type":"input_audio","audio":"invalid!"}]});
+        assert!(creation_item(&audio).is_err());
+        assert!(
+            edits(&[audio.clone()], &[audio], Some("root"))
+                .unwrap()
+                .is_empty()
+        );
+    }
+    #[test]
+    fn image_dimensions_are_bounded_before_full_decode() {
+        for width in [4096, 4097] {
+            let mut output = std::io::Cursor::new(Vec::new());
+            image::DynamicImage::new_luma8(width, 1)
+                .write_to(&mut output, image::ImageFormat::Png)
+                .unwrap();
+            let encoded = base64::engine::general_purpose::STANDARD.encode(output.into_inner());
+            assert_eq!(
+                valid_image_data_uri(&format!("data:image/png;base64,{encoded}")),
+                width == 4096
+            );
+        }
+    }
+    #[test]
+    fn creation_receipts_compare_present_fields_and_allow_omitted_media() {
+        let expected = json!({"id":"audio","type":"message","role":"user","content":[{"type":"input_audio","audio":"AAA=","transcript":"requested"}]});
+        let omitted = json!({"id":"audio","object":"realtime.item","status":"completed","type":"message","role":"user","content":[{"type":"input_audio","audio":null,"transcript":null}]});
+        assert!(!creation_receipt_conflicts(&expected, &omitted));
+        let conflict = json!({"id":"audio","type":"message","role":"user","content":[{"type":"input_audio","transcript":"different"}]});
+        assert!(creation_receipt_conflicts(&expected, &conflict));
+        let empty = json!({"id":"empty","type":"message","role":"user","content":[{"type":"input_audio","audio":""}]});
+        assert!(creation_item(&empty).is_err());
+    }
+    #[test]
+    fn absent_position_marks_unsolicited_observations_incomplete() {
+        for added in [false, true] {
+            let mut state = State::default();
+            if added {
+                state
+                    .observe_added(&message("unknown", "unknown"), None)
+                    .unwrap();
+            } else {
+                state.observe_id("unknown").unwrap();
+            }
+            assert!(state.incomplete);
+        }
+    }
+    #[test]
+    fn root_position_alias_and_self_predecessor_are_distinct_from_item_identity() {
+        for root in [None, Some("root")] {
+            let mut state = State::default();
+            state
+                .observe_added(&message("first", "first"), Some(root))
+                .unwrap();
+            assert_eq!(state.boundary.as_deref(), Some("root"));
+            assert!(!state.incomplete);
+        }
+        for prior in [false, true] {
+            let mut state = State::default();
+            if prior {
+                state
+                    .observe_added(&message("first", "first"), Some(None))
+                    .unwrap();
+            }
+            state
+                .observe_added(&message("self", "self"), Some(Some("self")))
+                .unwrap();
+            assert!(state.incomplete);
+            assert_ne!(state.boundary.as_deref(), Some("self"));
+        }
+        assert!(!valid_id("root"));
+    }
+}
