+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    fn message(id: &str, text: &str) -> Value {
+        json!({"id":id,"type":"message","role":"user","content":[{"type":"input_text","text":text}]})
+    }
+    #[tokio::test]
+    async fn explicit_retrieval_returns_full_media_and_retirement_releases_waiter() {
+        let mut state = State::default();
+        let (reply, receipt) = tokio::sync::oneshot::channel();
+        assert!(
+            matches!(state.start(Request::Item{id:"audio".into(),reply}).unwrap(),Some(Action::Retrieve(id)) if id=="audio")
+        );
+        assert!(
+            state
+                .retrieved(message("unrelated", "ignored"))
+                .unwrap()
+                .is_none()
+        );
+        let media = json!({"id":"audio","type":"message","role":"user","content":[{"type":"input_audio","audio":"AA==","transcript":"hello"},{"type":"input_image","image_url":"data:image/png;base64,AA=="}]});
+        assert!(state.retrieved(media.clone()).unwrap().is_none());
+        assert_eq!(receipt.await.unwrap().unwrap(), media);
+        let (reply, receipt) = tokio::sync::oneshot::channel();
+        state.start(Request::List { reply }).unwrap();
+        assert!(receipt.await.unwrap().unwrap().is_empty());
+        let (reply, receipt) = tokio::sync::oneshot::channel();
+        state
+            .start(Request::Item {
+                id: "audio".into(),
+                reply,
+            })
+            .unwrap();
+        state.retire();
+        assert!(receipt.await.unwrap().is_err());
+    }
+    #[tokio::test]
+    async fn update_waits_for_retrieval_then_deletion_then_creation_receipts() {
+        let first = message("first", "keep");
+        let old = message("old", "remove");
+        let new = message("new", "correct");
+        let mut state = State::default();
+        state.observe_added(&first).unwrap();
+        state.observe_added(&old).unwrap();
+        let (reply, mut receipt) = tokio::sync::oneshot::channel();
+        assert!(
+            matches!(state.start(Request::Update{items:vec![first.clone(),new.clone()],reply}).unwrap(),Some(Action::Retrieve(id)) if id=="first")
+        );
+        assert!(
+            matches!(state.retrieved(first.clone()).unwrap(),Some(Action::Retrieve(id)) if id=="old")
+        );
+        assert!(matches!(state.retrieved(old).unwrap(),Some(Action::Delete(id)) if id=="old"));
+        assert!(receipt.try_recv().is_err());
+        assert!(!state.deleted("unrelated").unwrap());
+        assert!(state.deleted("old").unwrap());
+        assert!(
+            matches!(state.advance().unwrap(),Some(Action::Create {item,previous}) if item==new && previous=="first")
+        );
+        assert!(receipt.try_recv().is_err());
+        state.observe_added(&new).unwrap();
+        state.created(&new).unwrap();
+        assert!(receipt.await.unwrap().is_ok());
+        assert_eq!(state.order, vec!["first", "new"]);
+    }
+    #[test]
+    fn tool_rows_are_exact_stable_anchors_and_message_reordering_is_supported() {
+        let a = message("a", "A");
+        let b = message("b", "B");
+        let tool = json!({"id":"tool","type":"function_call","call_id":"native","name":"run","arguments":"{}"});
+        let current = vec![a.clone(), b.clone(), tool.clone()];
+        let mut plan = edits(&current, &[b.clone(), a.clone(), tool.clone()]).unwrap();
+        assert!(matches!(plan.pop_front(),Some(Action::Delete(id)) if id=="a"));
+        assert!(
+            matches!(plan.pop_front(),Some(Action::Create {item,previous}) if item==a && previous=="b")
+        );
+        assert!(plan.is_empty());
+        assert!(edits(&current, &[tool.clone(), a.clone(), b.clone()]).is_err());
+        let mut manufactured = tool.clone();
+        manufactured["arguments"] = json!("changed");
+        assert!(edits(&current, &[a.clone(), b.clone(), manufactured]).is_err());
+        assert!(edits(&current, &[a, b]).is_err());
+    }
+    #[test]
+    fn correcting_or_inserting_before_unchanged_assistant_audio_preserves_its_item() {
+        let user = message("user", "original");
+        let audio = json!({"id":"assistant-audio","type":"message","role":"assistant",
+            "content":[{"type":"audio","audio":"AQI=","transcript":"Accepted spoken answer"}]});
+        let corrected = message("user", "corrected");
+        let mut plan = edits(&[user, audio.clone()], &[corrected.clone(), audio.clone()]).unwrap();
+        assert!(matches!(plan.pop_front(),Some(Action::Delete(id)) if id=="user"));
+        assert!(
+            matches!(plan.pop_front(),Some(Action::Create {item,previous}) if item==corrected && previous=="root")
+        );
+        assert!(plan.is_empty());
+        let inserted = message("inserted", "before audio");
+        let mut plan = edits(&[audio.clone()], &[inserted.clone(), audio]).unwrap();
+        assert!(
+            matches!(plan.pop_front(),Some(Action::Create {item,previous}) if item==inserted && previous=="root")
+        );
+        assert!(plan.is_empty());
+    }
+
+    #[test]
+    fn deleted_receipts_ignore_late_done_and_reject_reusing_tool_identity() {
+        let sdk = SdkRealtimeState::new("history-test".into());
+        let item = message("deleted-message", "accepted");
+        sdk.history.lock().unwrap().observe_added(&item).unwrap();
+        let mut deletion = sdk.item_deletion.lock().unwrap();
+        let mut terminal = item.clone();
+        terminal["status"] = json!("completed");
+        deletion
+            .observe(&RealtimeEvent::ConversationItemAdded(terminal))
+            .unwrap();
+        let (reply, _receipt) = tokio::sync::oneshot::channel();
+        assert!(deletion.begin(
+            "deleted-message".into(),
+            item_deletion::DeleteReply::new(reply)
+        ));
+        assert!(deletion.acknowledge("deleted-message"));
+        deletion.finish("deleted-message", Ok(()));
+        drop(deletion);
+        sdk.history
+            .lock()
+            .unwrap()
+            .deleted("deleted-message")
+            .unwrap();
+        sdk.observe_history_item_id("deleted-message").unwrap();
+        assert!(sdk.history.lock().unwrap().order.is_empty());
+        sdk.item_deletion
+            .lock()
+            .unwrap()
+            .allow_recreation("deleted-message");
+        sdk.history.lock().unwrap().observe_added(&item).unwrap();
+        sdk.observe_history_item_id("deleted-message").unwrap();
+        assert_eq!(sdk.history.lock().unwrap().order, vec!["deleted-message"]);
+        let mut deletion = sdk.item_deletion.lock().unwrap();
+        deletion.observe(&RealtimeEvent::ConversationItemAdded(json!({"id":"deleted-tool", "type":"function_call", "call_id":"native-call", "status":"completed"}))).unwrap();
+        deletion.settle_call("native-call");
+        let (reply, _receipt) = tokio::sync::oneshot::channel();
+        assert!(deletion.begin(
+            "deleted-tool".into(),
+            item_deletion::DeleteReply::new(reply)
+        ));
+        assert!(deletion.acknowledge("deleted-tool"));
+        deletion.finish("deleted-tool", Ok(()));
+        assert!(
+            validate_update_ids(
+                &[message("deleted-tool", "manufactured message")],
+                &deletion
+            )
+            .is_err()
+        );
+        assert!(validate_update_ids(&[message("new-message", "new")], &deletion).is_ok());
+    }
+
+    #[tokio::test]
+    async fn cancelling_host_waiter_does_not_retire_admitted_remote_receipt() {
+        let mut state = State::default();
+        let (reply, receipt) = tokio::sync::oneshot::channel();
+        state
+            .start(Request::Item {
+                id: "same".into(),
+                reply,
+            })
+            .unwrap();
+        drop(receipt);
+        assert!(state.busy());
+        let (reply, receipt) = tokio::sync::oneshot::channel();
+        state
+            .start(Request::Item {
+                id: "same".into(),
+                reply,
+            })
+            .unwrap();
+        assert!(receipt.await.unwrap().is_err());
+        state.retrieved(message("same", "settled")).unwrap();
+        assert!(!state.busy());
+    }
+}
