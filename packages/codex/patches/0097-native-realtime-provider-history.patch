+async fn run_history_action(
+    sdk: &SdkRealtimeState,
+    writer: &RealtimeWebsocketWriter,
+    action: Option<provider_history::Action>,
+) -> anyhow::Result<()> {
+    let result = match action {
+        Some(provider_history::Action::Retrieve(id)) => writer.retrieve_conversation_item(id).await,
+        Some(provider_history::Action::Create { item, previous }) => {
+            if let Some(id) = item["id"].as_str() {
+                sdk.item_deletion.lock().unwrap().allow_recreation(id);
+            }
+            writer.create_conversation_item_raw(item, previous).await
+        }
+        Some(provider_history::Action::Delete(id)) => {
+            // Validate the complete pending deletion plan before its first remote edit.
+            let validation = {
+                let history = sdk.history.lock().unwrap();
+                let deletion = sdk.item_deletion.lock().unwrap();
+                let result = history.deletions().try_for_each(|id| deletion.validate(id));
+                result
+            };
+            if let Err(error) = validation {
+                sdk.history.lock().unwrap().fail(error);
+                return Ok(());
+            }
+            let (reply, _result) = tokio::sync::oneshot::channel();
+            if !sdk
+                .item_deletion
+                .lock()
+                .unwrap()
+                .begin_history_message(id.clone(), item_deletion::DeleteReply::new(reply))
+            {
+                sdk.history.lock().unwrap().fail(CodexErr::InvalidRequest(
+                    "Provider item cannot be edited while work is unresolved".into(),
+                ));
+                return Ok(());
+            }
+            writer.send_conversation_item_delete(id).await
+        }
+        None => return Ok(()),
+    };
+    if result.is_err() {
+        sdk.history.lock().unwrap().fail(CodexErr::InvalidRequest(
+            "Provider history transport write failed".into(),
+        ));
+    }
+    result.map_err(Into::into)
+}
