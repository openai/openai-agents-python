+pub(crate) async fn handle_history_sdk(
+    sess: &Arc<Session>,
+    generation: String,
+    request: provider_history::Request,
+) {
+    let state = sess.conversation.state.lock().await;
+    let sdk = state
+        .conversation
+        .as_ref()
+        .and_then(|state| state.handoff.sdk.as_ref())
+        .filter(|sdk| sdk.generation == generation && sdk.active.load(Ordering::Acquire));
+    let Some(sdk) = sdk else {
+        provider_history::reject(
+            request,
+            CodexErr::InvalidRequest("SDK Realtime generation is stale".into()),
+        );
+        return;
+    };
+    if state.conversation.as_ref().unwrap().handoff.event_parser != RealtimeEventParser::RealtimeV2
+    {
+        provider_history::reject(
+            request,
+            CodexErr::InvalidRequest("Provider history requires RealtimeV2".into()),
+        );
+        return;
+    }
+    if let Err(error) = sdk
+        .commands_tx
+        .try_send(SdkRealtimeCommand::History(request))
+    {
+        if let SdkRealtimeCommand::History(request) = error.into_inner() {
+            provider_history::reject(
+                request,
+                CodexErr::InvalidRequest("Realtime command queue is unavailable".into()),
+            );
+        }
+    }
+}
