+//! Current-generation provider identities and acknowledged history operations.
+//! Item bodies, including media, live only for an explicit retrieval operation.
+use super::*;
+use base64::Engine as _;
+use serde_json::Value;
+use std::collections::VecDeque;
+const LIMIT: usize = 4096;
+const ID_BYTES: usize = 512;
+const MAX_IMAGE_DIMENSION: u32 = 4096;
+const MAX_IMAGE_DECODE_BYTES: u64 = 64 * 1024 * 1024;
+
+type Reply<T> = tokio::sync::oneshot::Sender<CodexResult<T>>;
+#[derive(Debug)]
+pub(crate) enum Request {
+    Item { id: String, reply: Reply<Value> },
+    List { reply: Reply<Vec<Value>> },
+    Update { items: Vec<Value>, reply: Reply<()> },
+}
+#[derive(Debug)]
+pub(super) enum Action {
+    Retrieve(String),
+    Delete(String),
+    Create {
+        item: Value,
+        previous: Option<String>,
+    },
+}
+#[derive(Debug)]
+struct Pending {
+    request: Option<Request>,
+    retained_bytes: usize,
+    ids: VecDeque<String>,
+    snapshot: Vec<Value>,
+    actions: VecDeque<Action>,
+    waiting: Option<Action>,
+    deadline: tokio::time::Instant,
+}
+#[derive(Debug)]
+pub(super) struct State {
+    order: Vec<String>,
+    boundary: Option<String>,
+    incomplete: bool,
+    pending: Option<Pending>,
+}
+impl Default for State {
+    fn default() -> Self {
+        Self {
+            order: Vec::new(),
+            boundary: Some("root".into()),
+            incomplete: false,
+            pending: None,
+        }
+    }
+}
+fn invalid(message: &str) -> CodexErr {
+    CodexErr::InvalidRequest(message.into())
+}
+fn valid_id(id: &str) -> bool {
+    !id.is_empty() && id.len() <= ID_BYTES && id != "root"
+}
+fn item_id(item: &Value) -> CodexResult<&str> {
+    item["id"]
+        .as_str()
+        .filter(|id| valid_id(id))
+        .ok_or_else(|| invalid("Provider history item requires a valid ID"))
+}
+pub(super) fn validate_request_ids(
+    request: &Request,
+    deletion: &item_deletion::State,
+) -> CodexResult<()> {
+    let deleted = match request {
+        Request::Item { id, .. } => !deletion.can_retrieve(id),
+        Request::Update { items, .. } => items.iter().any(|item| {
+            item["id"].as_str().is_some_and(|id| {
+                deletion.is_deleted(id)
+                    && (!deletion.can_recreate_message(id) || validate_creation(item).is_err())
+            })
+        }),
+        Request::List { .. } => false,
+    };
+    if deleted {
+        return Err(invalid(
+            "Provider history cannot use a deleted item ID or an unverified ID after deletion receipts were evicted",
+        ));
+    }
+    Ok(())
+}
+fn valid_base64(value: &str) -> bool {
+    base64::engine::general_purpose::STANDARD
+        .decode(value)
+        .is_ok_and(|bytes| !bytes.is_empty())
+}
+fn valid_image_data_uri(value: &str) -> bool {
+    let Some((header, data)) = value.split_once(',') else {
+        return false;
+    };
+    let Some(header) = header.strip_prefix("data:") else {
+        return false;
+    };
+    let Some((mime, encoding)) = header.split_once(';') else {
+        return false;
+    };
+    let format = if mime.eq_ignore_ascii_case("image/png") {
+        image::ImageFormat::Png
+    } else if mime.eq_ignore_ascii_case("image/jpeg") {
+        image::ImageFormat::Jpeg
+    } else {
+        return false;
+    };
+    if !encoding.eq_ignore_ascii_case("base64") {
+        return false;
+    }
+    let Ok(bytes) = base64::engine::general_purpose::STANDARD.decode(data) else {
+        return false;
+    };
+    if bytes.is_empty() {
+        return false;
+    }
+    let mut limits = image::Limits::default();
+    limits.max_image_width = Some(MAX_IMAGE_DIMENSION);
+    limits.max_image_height = Some(MAX_IMAGE_DIMENSION);
+    limits.max_alloc = Some(MAX_IMAGE_DECODE_BYTES);
+    let mut header =
+        image::ImageReader::with_format(std::io::Cursor::new(bytes.as_slice()), format);
+    header.limits(limits.clone());
+    if header.into_dimensions().is_err() {
+        return false;
+    }
+    let mut reader = image::ImageReader::with_format(std::io::Cursor::new(bytes), format);
+    reader.limits(limits);
+    reader.decode().is_ok()
+}
+
+fn mutable_message(item: &Value) -> bool {
+    item["type"] == "message"
+        && matches!(item["role"].as_str(), Some("user" | "assistant" | "system"))
+}
+fn same_message(a: &Value, b: &Value) -> bool {
+    let (Some(a), Some(b)) = (a.as_object(), b.as_object()) else {
+        return a == b;
+    };
+    a.iter()
+        .filter(|(key, _)| key.as_str() != "status")
+        .all(|(key, value)| b.get(key) == Some(value))
+        && a.keys().filter(|key| key.as_str() != "status").count()
+            == b.keys().filter(|key| key.as_str() != "status").count()
+}
+fn validate_creation(item: &Value) -> CodexResult<()> {
+    if !mutable_message(item) {
+        return Err(invalid(
+            "Only system, user, and assistant messages may be created or corrected",
+        ));
+    }
+    let role = item["role"].as_str().unwrap();
+    let content = item["content"]
+        .as_array()
+        .ok_or_else(|| invalid("Provider message content must be an array"))?;
+    if content.is_empty()
+        || content
+            .iter()
+            .any(|part| match (role, part["type"].as_str()) {
+                ("system" | "user", Some("input_text")) | ("assistant", Some("output_text")) => {
+                    part["text"].as_str().is_none()
+                }
+                ("user", Some("input_image")) => {
+                    part["image_url"]
+                        .as_str()
+                        .is_none_or(|image| !valid_image_data_uri(image))
+                        || part.get("detail").is_some_and(|detail| {
+                            !matches!(detail.as_str(), Some("auto" | "low" | "high"))
+                        })
+                }
+                ("user", Some("input_audio")) => {
+                    part["audio"]
+                        .as_str()
+                        .is_none_or(|audio| !valid_base64(audio))
+                        || part
+                            .get("transcript")
+                            .is_some_and(|text| text.as_str().is_none())
+                }
+                _ => true,
+            })
+    {
+        return Err(invalid(
+            "Unsupported provider message role/content combination",
+        ));
+    }
+    Ok(())
+}
+fn creation_item(item: &Value) -> CodexResult<Value> {
+    validate_creation(item)?;
+    let parts = item["content"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|part| {
+            let names: &[&str] = match part["type"].as_str().unwrap() {
+                "input_image" => &["type", "image_url", "detail"],
+                "input_audio" => &["type", "audio", "transcript"],
+                _ => &["type", "text"],
+            };
+            Value::Object(
+                names
+                    .iter()
+                    .filter_map(|name| {
+                        part.get(*name)
+                            .map(|value| ((*name).to_owned(), value.clone()))
+                    })
+                    .collect(),
+            )
+        })
+        .collect::<Vec<_>>();
+    Ok(
+        serde_json::json!({"id": item["id"], "type": "message", "role": item["role"], "content": parts}),
+    )
+}
+
+// Server receipts may omit optional media or add defaults. Only contradictory
+// writable fields that are actually present establish a different item.
+fn creation_receipt_conflicts(expected: &Value, actual: &Value) -> bool {
+    for field in ["type", "role"] {
+        if actual
+            .get(field)
+            .is_some_and(|value| !value.is_null() && value != &expected[field])
+        {
+            return true;
+        }
+    }
+    let Some(content) = actual.get("content").filter(|value| !value.is_null()) else {
+        return false;
+    };
+    let (Some(expected), Some(actual)) = (expected["content"].as_array(), content.as_array())
+    else {
+        return true;
+    };
+    expected.len() != actual.len()
+        || expected.iter().zip(actual).any(|(expected, actual)| {
+            let Some(fields) = expected.as_object() else {
+                return true;
+            };
+            !actual.is_object()
+                || fields.iter().any(|(name, expected)| {
+                    actual
+                        .get(name)
+                        .is_some_and(|value| !value.is_null() && value != expected)
+                })
+        })
+}
+
+/// Preserve authoritative tool/control rows and their stable anchors. Within each
+/// anchor segment, retain unchanged rows in relative order and edit only the other rows.
+fn edits(
+    current: &[Value],
+    desired: &[Value],
+    boundary: Option<&str>,
+) -> CodexResult<VecDeque<Action>> {
+    let mut ids = HashSet::new();
+    for item in desired {
+        if !ids.insert(item_id(item)?.to_owned()) {
+            return Err(invalid("Provider history IDs must be unique"));
+        }
+    }
+    let old_anchors: Vec<_> = current
+        .iter()
+        .filter(|item| !mutable_message(item))
+        .collect();
+    let new_anchors: Vec<_> = desired
+        .iter()
+        .filter(|item| !mutable_message(item))
+        .collect();
+    if old_anchors != new_anchors {
+        return Err(invalid(
+            "Provider tool and control items must retain their exact IDs, contents, and order",
+        ));
+    }
+    let segments = |items: &[Value]| -> CodexResult<HashMap<String, usize>> {
+        let mut segment = 0;
+        let mut result = HashMap::new();
+        for item in items {
+            if mutable_message(item) {
+                result.insert(item_id(item)?.to_owned(), segment);
+            } else {
+                segment += 1;
+            }
+        }
+        Ok(result)
+    };
+    let old_segments = segments(current)?;
+    for (id, segment) in segments(desired)? {
+        if old_segments.get(&id).is_some_and(|old| *old != segment) {
+            return Err(invalid(
+                "Messages cannot move across authoritative tool or control anchors",
+            ));
+        }
+    }
+    let mut deletes = VecDeque::new();
+    let mut creates = VecDeque::new();
+    let mut old_start = 0;
+    let mut new_start = 0;
+    let mut previous = boundary.map(str::to_owned);
+    for anchor in old_anchors
+        .into_iter()
+        .map(Some)
+        .chain(std::iter::once(None))
+    {
+        let old_end = anchor.map_or(current.len(), |anchor| {
+            current[old_start..]
+                .iter()
+                .position(|item| item == anchor)
+                .unwrap()
+                + old_start
+        });
+        let new_end = anchor.map_or(desired.len(), |anchor| {
+            desired[new_start..]
+                .iter()
+                .position(|item| item == anchor)
+                .unwrap()
+                + new_start
+        });
+        let old = &current[old_start..old_end];
+        let new = &desired[new_start..new_end];
+        // Preserve unchanged rows that the provider does not permit us to recreate.
+        // Their order bounds the ordinary text retention scan within this authority segment.
+        let by_id: HashMap<_, _> = old
+            .iter()
+            .enumerate()
+            .map(|(index, item)| Ok((item_id(item)?, (index, item))))
+            .collect::<CodexResult<_>>()?;
+        let mut mandatory = Vec::new();
+        for (new_index, item) in new.iter().enumerate() {
+            if let Some(&(old_index, known)) = by_id.get(item_id(item)?) {
+                if same_message(known, item) && validate_creation(item).is_err() {
+                    if mandatory
+                        .last()
+                        .is_some_and(|&(_, previous)| previous >= old_index)
+                    {
+                        return Err(invalid("Provider-only media cannot change relative order"));
+                    }
+                    mandatory.push((new_index, old_index));
+                }
+            }
+        }
+        let mut cursor = 0;
+        let mut new_cursor = 0;
+        let mut retained = HashSet::new();
+        for (new_bound, old_bound) in mandatory
+            .iter()
+            .copied()
+            .chain(std::iter::once((new.len(), old.len())))
+        {
+            for item in &new[new_cursor..new_bound] {
+                if let Some(&(index, known)) = by_id.get(item_id(item)?) {
+                    if index >= cursor && index < old_bound && same_message(known, item) {
+                        cursor = index + 1;
+                        retained.insert(item_id(item)?.to_owned());
+                    }
+                }
+            }
+            if new_bound < new.len() {
+                retained.insert(item_id(&new[new_bound])?.to_owned());
+                cursor = old_bound + 1;
+            }
+            new_cursor = new_bound + 1;
+        }
+        for item in old {
+            if !retained.contains(item_id(item)?) {
+                deletes.push_back(Action::Delete(item_id(item)?.to_owned()));
+            }
+        }
+        for item in new {
+            let id = item_id(item)?.to_owned();
+            if !retained.contains(&id) {
+                if previous.is_none()
+                    && (anchor.is_some()
+                        || new
+                            .iter()
+                            .any(|row| retained.contains(item_id(row).unwrap())))
+                {
+                    return Err(invalid(
+                        "Provider history predecessor is unknown; cannot insert before retained items",
+                    ));
+                }
+                creates.push_back(Action::Create {
+                    item: creation_item(item)?,
+                    previous: previous.clone(),
+                });
+            }
+            previous = Some(id);
+        }
+        if let Some(anchor) = anchor {
+            previous = Some(item_id(anchor)?.to_owned());
+        }
+        old_start = old_end + 1;
+        new_start = new_end + 1;
+    }
+    deletes.extend(creates);
+    Ok(deletes)
+}
+impl State {
+    pub(super) fn set_boundary(&mut self, known_root: bool) {
+        self.boundary = known_root.then(|| "root".to_owned());
+    }
+    pub(super) fn deletions(&self) -> impl Iterator<Item = &str> {
+        self.pending
+            .iter()
+            .flat_map(|pending| pending.waiting.iter().chain(pending.actions.iter()))
+            .filter_map(|action| match action {
+                Action::Delete(id) => Some(id.as_str()),
+                _ => None,
+            })
+    }
+    pub(super) fn busy(&self) -> bool {
+        self.pending.is_some()
+    }
+    pub(super) fn editing(&self) -> bool {
+        self.pending
+            .as_ref()
+            .is_some_and(|pending| matches!(pending.request, Some(Request::Update { .. })))
+    }
+    pub(super) fn deadline(&self) -> Option<tokio::time::Instant> {
+        self.pending.as_ref().and_then(|pending| {
+            if pending.request.is_none() && matches!(pending.waiting, Some(Action::Retrieve(_))) {
+                None
+            } else {
+                Some(pending.deadline)
+            }
+        })
+    }
+    pub(super) fn expire_read(&mut self) -> bool {
+        if self.pending.as_ref().is_some_and(|pending| {
+            pending.deadline <= tokio::time::Instant::now()
+                && matches!(pending.waiting, Some(Action::Retrieve(_)))
+        }) {
+            self.interrupt(invalid("Provider history retrieval timed out"));
+            true
+        } else {
+            false
+        }
+    }
+    pub(super) fn observe_added(
+        &mut self,
+        item: &Value,
+        previous: Option<Option<&str>>,
+    ) -> CodexResult<()> {
+        let id = item_id(item)?.to_owned();
+        let previous = previous.map(|previous| previous.filter(|id| *id != "root"));
+        if previous.flatten() == Some(id.as_str()) {
+            self.mark_order_unknown();
+            self.record_id(&id, false)?;
+            return Ok(());
+        }
+        let expected_create = self.expected_create(&id);
+        let contradictory = self.expected_create_previous(&id).is_some_and(|expected| {
+            expected.as_deref().is_some_and(|expected| {
+                previous.is_some_and(|actual| actual.unwrap_or("root") != expected)
+            })
+        });
+        if (previous.is_none() && !expected_create) || contradictory {
+            self.mark_order_unknown();
+        }
+        if self.order.is_empty() {
+            if let Some(previous) = previous {
+                if previous.is_some_and(|id| !valid_id(id)) {
+                    return Err(invalid("Invalid provider history predecessor"));
+                }
+                self.boundary = Some(previous.unwrap_or("root").to_owned());
+            }
+        }
+        self.record_id(&id, previous.is_some() || expected_create)?;
+        if let Some(previous) = previous {
+            let Some(old_index) = self.order.iter().position(|known| known == &id) else {
+                return Ok(());
+            };
+            self.order.remove(old_index);
+            let index = if previous.is_none() {
+                (self.boundary.as_deref() == Some("root")).then_some(0)
+            } else if previous == self.boundary.as_deref() {
+                Some(0)
+            } else {
+                self.order
+                    .iter()
+                    .position(|known| Some(known.as_str()) == previous)
+                    .map(|index| index + 1)
+            };
+            if let Some(index) = index {
+                if old_index != index && self.editing() && !self.expected_create(&id) {
+                    self.interrupt(invalid(
+                        "Provider conversation changed during history replacement",
+                    ));
+                }
+                self.order.insert(index, id);
+            } else {
+                self.order.insert(old_index, id);
+                self.incomplete = true;
+                if self.editing() {
+                    self.interrupt(invalid("Provider conversation position is unknown"));
+                }
+            }
+        }
+        Ok(())
+    }
+    fn expected_create_previous(&self, id: &str) -> Option<&Option<String>> {
+        self.pending
+            .as_ref()
+            .and_then(|pending| match &pending.waiting {
+                Some(Action::Create { item, previous }) if item["id"].as_str() == Some(id) => {
+                    Some(previous)
+                }
+                _ => None,
+            })
+    }
+    fn expected_create(&self, id: &str) -> bool {
+        self.expected_create_previous(id).is_some()
+    }
+    fn mark_order_unknown(&mut self) {
+        self.incomplete = true;
+        if self.editing() {
+            self.interrupt(invalid(
+                "Provider conversation position is unknown or contradictory",
+            ));
+        }
+    }
+    pub(super) fn observe_id(&mut self, id: &str) -> CodexResult<()> {
+        self.record_id(id, false)
+    }
+    fn record_id(&mut self, id: &str, positioned: bool) -> CodexResult<()> {
+        if !valid_id(id) {
+            return Err(invalid("Invalid provider item ID"));
+        }
+        let id = id.to_owned();
+        if self.editing() && !self.order.contains(&id) && !self.expected_create(&id) {
+            self.interrupt(invalid(
+                "Provider conversation changed during history replacement",
+            ));
+        }
+        if !self.order.contains(&id) {
+            if !positioned && !self.expected_create(&id) {
+                self.mark_order_unknown();
+            }
+            if self.order.len() == LIMIT {
+                self.incomplete = true;
+            } else {
+                self.order.push(id);
+            }
+        }
+        Ok(())
+    }
+    pub(super) fn start(&mut self, request: Request) -> CodexResult<Option<Action>> {
+        if self.busy() {
+            finish_request(
+                request,
+                Err(invalid("Another provider history operation is pending")),
+            );
+            return Ok(None);
+        }
+        if self.incomplete && !matches!(request, Request::Item { .. }) {
+            finish_request(
+                request,
+                Err(invalid(
+                    "Provider history does not have a complete ordered current-generation identity view",
+                )),
+            );
+            return Ok(None);
+        }
+        let ids = match &request {
+            Request::Item { id, .. } => {
+                if !valid_id(id) {
+                    finish_request(request, Err(invalid("Invalid provider item ID")));
+                    return Ok(None);
+                }
+                VecDeque::from([id.clone()])
+            }
+            Request::List { .. } | Request::Update { .. } => self.order.iter().cloned().collect(),
+        };
+        if let Request::Update { items, .. } = &request {
+            if items.len() > LIMIT {
+                finish_request(
+                    request,
+                    Err(invalid("Provider history contains too many items")),
+                );
+                return Ok(None);
+            }
+        }
+        let mut retained_bytes = 0;
+        if let Request::Update { items, .. } = &request {
+            for item in items {
+                if codex_api::charge_realtime_json_storage(item, &mut retained_bytes).is_err() {
+                    finish_request(
+                        request,
+                        Err(invalid(
+                            "Provider history exceeds its 8 MiB estimated storage limit",
+                        )),
+                    );
+                    return Ok(None);
+                }
+            }
+        }
+        self.pending = Some(Pending {
+            request: Some(request),
+            retained_bytes,
+            ids,
+            snapshot: vec![],
+            actions: VecDeque::new(),
+            waiting: None,
+            deadline: tokio::time::Instant::now() + Duration::from_secs(10),
+        });
+        self.advance()
+    }
+    pub(super) fn retrieved(&mut self, item: Value) -> CodexResult<Option<Action>> {
+        if !self
+            .pending
+            .as_ref()
+            .is_some_and(|pending| matches!(pending.waiting, Some(Action::Retrieve(_))))
+        {
+            return Ok(None);
+        }
+        let id = match item_id(&item) {
+            Ok(id) => id,
+            Err(error) => {
+                self.interrupt(error);
+                return Ok(None);
+            }
+        };
+        let Some(pending) = self.pending.as_mut() else {
+            return Ok(None);
+        };
+        if !matches!(&pending.waiting, Some(Action::Retrieve(expected)) if expected == id) {
+            return Ok(None);
+        }
+        // This matching receipt is consumed even if retaining its body exceeds the budget.
+        pending.waiting = None;
+        if pending.request.is_some() {
+            codex_api::charge_realtime_json_storage(&item, &mut pending.retained_bytes).map_err(
+                |_| invalid("Provider history exceeds its 8 MiB estimated storage limit"),
+            )?;
+            pending.snapshot.push(item);
+        }
+        self.advance()
+    }
+    pub(super) fn created(
+        &mut self,
+        item: &Value,
+        position_observed: bool,
+    ) -> CodexResult<Option<Action>> {
+        if !self
+            .pending
+            .as_ref()
+            .is_some_and(|pending| matches!(pending.waiting, Some(Action::Create { .. })))
+        {
+            return Ok(None);
+        }
+        let id = match item_id(item) {
+            Ok(id) => id.to_owned(),
+            Err(error) => {
+                self.interrupt(error);
+                return Ok(None);
+            }
+        };
+        let Some(pending) = self.pending.as_mut() else {
+            return Ok(None);
+        };
+        let Some(Action::Create {
+            item: expected,
+            previous,
+        }) = &pending.waiting
+        else {
+            return Ok(None);
+        };
+        if item_id(expected)? != id {
+            return Ok(None);
+        }
+        if creation_receipt_conflicts(expected, item) {
+            self.interrupt(invalid(
+                "Provider create receipt conflicts with the requested message",
+            ));
+            return Ok(None);
+        }
+        if !position_observed {
+            let previous = previous.clone();
+            self.order.retain(|known| known != &id);
+            let index = if previous.is_none() {
+                self.order.len()
+            } else if previous.as_deref() == Some("root") {
+                0
+            } else if self.boundary.as_ref() == previous.as_ref() {
+                0
+            } else {
+                self.order
+                    .iter()
+                    .position(|known| Some(known) == previous.as_ref())
+                    .ok_or_else(|| invalid("Provider history anchor disappeared"))?
+                    + 1
+            };
+            self.order.insert(index, id);
+        }
+        pending.waiting = None;
+        self.advance()
+    }
+    pub(super) fn observe_deleted(&mut self, id: &str) {
+        self.order.retain(|known| known != id);
+        if self.boundary.as_deref() == Some(id) {
+            self.incomplete = true;
+        }
+        let affected = self
+            .pending
+            .as_ref()
+            .is_some_and(|pending| match &pending.request {
+                Some(Request::Item { id: requested, .. }) => requested == id,
+                Some(Request::List { .. } | Request::Update { .. }) => true,
+                None => false,
+            });
+        if affected {
+            self.interrupt(invalid(
+                "Provider item was deleted during history operation",
+            ));
+        }
+    }
+    pub(super) fn deleted(&mut self, id: &str) -> CodexResult<bool> {
+        self.order.retain(|known| known != id);
+        let Some(pending) = self.pending.as_mut() else {
+            return Ok(false);
+        };
+        if !matches!(&pending.waiting, Some(Action::Delete(expected)) if expected == id) {
+            return Ok(false);
+        }
+        pending.waiting = None;
+        Ok(true)
+    }
+    pub(super) fn advance(&mut self) -> CodexResult<Option<Action>> {
+        let Some(pending) = self.pending.as_mut() else {
+            return Ok(None);
+        };
+        if pending.waiting.is_some() {
+            return Ok(None);
+        }
+        if pending.request.is_none() {
+            self.pending.take();
+            return Ok(None);
+        }
+        if let Some(id) = pending.ids.pop_front() {
+            pending.waiting = Some(Action::Retrieve(id.clone()));
+            pending.deadline = tokio::time::Instant::now() + Duration::from_secs(10);
+            return Ok(Some(Action::Retrieve(id)));
+        }
+        if let Some(Request::Update { items, .. }) = &pending.request {
+            if pending.actions.is_empty() && !pending.snapshot.is_empty() {
+                pending.actions = edits(&pending.snapshot, items, self.boundary.as_deref())?;
+                pending.snapshot.clear();
+            } else if pending.actions.is_empty() && self.order.is_empty() {
+                pending.actions = edits(&[], items, self.boundary.as_deref())?;
+            }
+        }
+        if let Some(action) = pending.actions.pop_front() {
+            pending.waiting = Some(match &action {
+                Action::Retrieve(id) => Action::Retrieve(id.clone()),
+                Action::Delete(id) => Action::Delete(id.clone()),
+                Action::Create { item, previous } => Action::Create {
+                    item: item.clone(),
+                    previous: previous.clone(),
+                },
+            });
+            pending.deadline = tokio::time::Instant::now() + Duration::from_secs(10);
+            return Ok(Some(action));
+        }
+        let pending = self.pending.take().unwrap();
+        match pending.request.unwrap() {
+            Request::Item { reply, .. } => {
+                let _ = reply.send(
+                    pending
+                        .snapshot
+                        .into_iter()
+                        .next()
+                        .ok_or_else(|| invalid("Provider item retrieval was empty")),
+                );
+            }
+            Request::List { reply } => {
+                let _ = reply.send(Ok(pending.snapshot));
+            }
+            Request::Update { reply, .. } => {
+                let _ = reply.send(Ok(()));
+            }
+        }
+        Ok(None)
+    }
+    pub(super) fn interrupt(&mut self, error: CodexErr) {
+        if let Some(pending) = &mut self.pending {
+            if let Some(request) = pending.request.take() {
+                finish_request(request, Err(error));
+            }
+            pending.ids.clear();
+            pending.snapshot.clear();
+            pending.actions.clear();
+            pending.retained_bytes = 0;
+            if pending.waiting.is_none() {
+                self.pending.take();
+            }
+        }
+    }
+    pub(super) fn fail(&mut self, error: CodexErr) {
+        if let Some(pending) = self.pending.take() {
+            if let Some(request) = pending.request {
+                finish_request(request, Err(error));
+            }
+        }
+    }
+    pub(super) fn retire(&mut self) {
+        self.fail(CodexErr::TurnAborted);
+        self.order.clear();
+    }
+}
+fn finish_request(request: Request, result: CodexResult<()>) {
+    let error = result.err().unwrap_or(CodexErr::TurnAborted);
+    match request {
+        Request::Item { reply, .. } => {
+            let _ = reply.send(Err(error));
+        }
+        Request::List { reply } => {
+            let _ = reply.send(Err(error));
+        }
+        Request::Update { reply, .. } => {
+            let _ = reply.send(Err(error));
+        }
+    }
+}
+
+pub(crate) fn reject(request: Request, error: CodexErr) {
+    finish_request(request, Err(error));
+}
