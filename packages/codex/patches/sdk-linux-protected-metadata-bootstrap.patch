     use pretty_assertions::assert_eq;
     use tempfile::TempDir;
 
+    #[test]
+    fn restricted_read_bootstrap_defers_protected_metadata_to_the_writable_bind() {
+        let workspace = TempDir::new().expect("workspace");
+        let root = workspace.path();
+        let dot_git = root.join(".git");
+        fs::create_dir(&dot_git).expect("create transient .git directory");
+        let workspace_root = AbsolutePathBuf::from_absolute_path(root).expect("absolute workspace");
+        let mut policy = FileSystemSandboxPolicy::workspace_write(&[], true, true)
+            .materialize_project_roots_with_workspace_roots(&[workspace_root]);
+        let root_read = policy
+            .entries
+            .iter_mut()
+            .find(|entry| {
+                matches!(
+                    entry.path,
+                    FileSystemPath::Special {
+                        value: FileSystemSpecialPath::Root,
+                    }
+                )
+            })
+            .expect("workspace root read baseline");
+        root_read.path = FileSystemPath::Special {
+            value: FileSystemSpecialPath::Minimal,
+        };
+        let plan = || {
+            create_filesystem_args(&policy, root, BwrapOptions::default()).expect("filesystem args")
+        };
+        let transient = plan();
+        fs::remove_dir(&dot_git).expect("remove transient .git directory");
+        let dot_git_str = path_to_string(&dot_git);
+        let readonly_binds = |args: &BwrapArgs| {
+            args.args
+                .windows(3)
+                .enumerate()
+                .filter_map(|(index, window)| {
+                    (window == ["--ro-bind", dot_git_str.as_str(), dot_git_str.as_str()])
+                        .then_some(index)
+                })
+                .collect::<Vec<_>>()
+        };
+        assert_empty_directory_mounted_read_only(&transient.args, &dot_git);
+        assert!(readonly_binds(&transient).is_empty());
+        assert!(synthetic_mount_target_paths(&transient).contains(&dot_git));
+
+        fs::create_dir(&dot_git).expect("create real .git directory");
+        fs::write(dot_git.join("HEAD"), "ref: refs/heads/main\n").expect("write HEAD");
+        let real = plan();
+        let root_str = path_to_string(root);
+        let writable_bind = real
+            .args
+            .windows(3)
+            .position(|window| window == ["--bind", root_str.as_str(), root_str.as_str()])
+            .expect("workspace writable bind");
+        let binds = readonly_binds(&real);
+        assert_eq!(binds.len(), 1);
+        assert!(
+            binds[0] > writable_bind,
+            "the real metadata stays read-only"
+        );
+    }
