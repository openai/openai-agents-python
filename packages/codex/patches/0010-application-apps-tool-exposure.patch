+#[tokio::test]
+async fn application_proof_exposure_follows_current_binding_and_visibility() {
+    let config = test_config().await;
+    let runtime = application_runtime_config(&config);
+    let proof = make_mcp_tool(
+        CODEX_APPS_MCP_SERVER_NAME,
+        "search",
+        "mcp__codex_apps",
+        "search",
+        None,
+        None,
+    );
+    let hidden = with_visibility(
+        make_mcp_tool(
+            CODEX_APPS_MCP_SERVER_NAME,
+            "hidden",
+            "mcp__codex_apps",
+            "hidden",
+            None,
+            None,
+        ),
+        &["app"],
+    );
+    let tools = [proof.clone(), hidden];
+    let mut handlers = HashMap::new();
+    let mut registry = ToolRegistry::default();
+    let selected = append_mcp_tools(
+        &tools,
+        &config,
+        false,
+        &runtime,
+        false,
+        &mut handlers,
+        &mut registry,
+    );
+    assert_eq!(selected, HashSet::from([proof.canonical_tool_name()]));
+    assert_eq!(registry.entries().count(), 1);
+
+    // Cached metadata cannot preserve exposure after the capability is removed.
+    let mut unadmitted = runtime.clone();
+    unadmitted.application_apps = None;
+    let mut next = ToolRegistry::default();
+    assert!(
+        append_mcp_tools(
+            &tools,
+            &config,
+            false,
+            &unadmitted,
+            false,
+            &mut handlers,
+            &mut next,
+        )
+        .is_empty()
+    );
+    assert_eq!(next.entries().count(), 0);
+
+    let mut empty = ToolRegistry::default();
+    assert!(
+        append_mcp_tools(
+            &[],
+            &config,
+            false,
+            &runtime,
+            false,
+            &mut handlers,
+            &mut empty,
+        )
+        .is_empty()
+    );
+    assert_eq!(empty.entries().count(), 0);
+
+    let mut restored = ToolRegistry::default();
+    assert_eq!(
+        append_mcp_tools(
+            &tools,
+            &config,
+            false,
+            &runtime,
+            true,
+            &mut handlers,
+            &mut restored,
+        ),
+        selected
+    );
+    assert_eq!(
+        restored.entries().next().expect("proof tool").exposure,
+        ToolExposure::Deferred
+    );
+}
