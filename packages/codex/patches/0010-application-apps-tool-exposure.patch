+#[tokio::test]
+async fn personal_application_exposure_requires_its_own_backend_principal() {
+    let config = test_config().await;
+    let mut runtime = application_runtime_config(&config);
+    let server = runtime
+        .application_apps
+        .as_ref()
+        .expect("application")
+        .registration()
+        .clone();
+    let proof = make_mcp_tool(
+        CODEX_APPS_MCP_SERVER_NAME,
+        "search",
+        "mcp__codex_apps",
+        "search",
+        None,
+        None,
+    );
+    for (auth, expected) in [
+        (
+            codex_login::CodexAuth::from_api_key("model-only-key"),
+            false,
+        ),
+        (
+            codex_login::CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+            true,
+        ),
+    ] {
+        runtime.application_apps = Some(Arc::new(codex_mcp::ApplicationApps::chatgpt(
+            server.clone(),
+            codex_login::AuthManager::from_auth_for_testing(auth),
+        )));
+        let mut handlers = HashMap::new();
+        let mut registry = ToolRegistry::default();
+        let names = append_mcp_tools(
+            std::slice::from_ref(&proof),
+            &config,
+            false,
+            &runtime,
+            false,
+            &mut handlers,
+            &mut registry,
+        );
+        assert_eq!(names.contains(&proof.canonical_tool_name()), expected);
+    }
+}
