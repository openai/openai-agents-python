+#[tokio::test]
+async fn application_proof_exposure_rejects_changed_source_and_registration() {
+    let config = test_config().await;
+    let runtime = application_runtime_config(&config);
+    let original = runtime
+        .application_apps
+        .as_ref()
+        .expect("application")
+        .registration()
+        .clone();
+    let tool = make_mcp_tool(
+        CODEX_APPS_MCP_SERVER_NAME,
+        "search",
+        "mcp__codex_apps",
+        "search",
+        None,
+        None,
+    );
+    for mismatch in [
+        "ordinary",
+        "ordinary-extension",
+        "contributor",
+        "transport",
+        "auth",
+        "environment",
+    ] {
+        let mut server = original.clone();
+        if mismatch == "transport" {
+            server.transport =
+                codex_mcp::codex_apps_mcp_server_config("https://different.invalid", None, None)
+                    .transport;
+        } else if mismatch == "auth" {
+            server.auth = codex_config::McpServerAuth::OAuth;
+        } else if mismatch == "environment" {
+            server.environment_id = "unrelated-environment".to_string();
+        }
+        let mut catalog = ResolvedMcpCatalog::builder();
+        catalog.register(if mismatch == "ordinary" {
+            McpServerRegistration::from_config(CODEX_APPS_MCP_SERVER_NAME.to_string(), server)
+        } else if mismatch == "ordinary-extension" {
+            McpServerRegistration::from_extension(
+                CODEX_APPS_MCP_SERVER_NAME.to_string(),
+                codex_mcp::APPLICATION_APPS_CONTRIBUTOR_ID,
+                0,
+                server,
+            )
+        } else {
+            McpServerRegistration::from_hosted_apps(
+                if mismatch == "contributor" {
+                    "unrelated-extension"
+                } else {
+                    codex_mcp::APPLICATION_APPS_CONTRIBUTOR_ID
+                },
+                0,
+                server,
+            )
+        });
+        let mut changed = runtime.clone();
+        changed.mcp_server_catalog = catalog.build();
+        let mut handlers = HashMap::new();
+        let mut registry = ToolRegistry::default();
+        assert!(
+            append_mcp_tools(
+                std::slice::from_ref(&tool),
+                &config,
+                false,
+                &changed,
+                false,
+                &mut handlers,
+                &mut registry,
+            )
+            .is_empty(),
+            "{mismatch}"
+        );
+        assert_eq!(registry.entries().count(), 0, "{mismatch}");
+    }
+}
