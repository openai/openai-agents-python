+#[tokio::test]
+async fn application_exposure_keeps_default_and_connector_tool_policy() {
+    let config = test_config().await;
+    let runtime = application_runtime_config(&config);
+    let proof = make_mcp_tool(
+        CODEX_APPS_MCP_SERVER_NAME,
+        "search",
+        "mcp__codex_apps",
+        "search",
+        None,
+        None,
+    );
+    let calendar = make_mcp_tool(
+        CODEX_APPS_MCP_SERVER_NAME,
+        "calendar_search",
+        "mcp__codex_apps",
+        "calendar_search",
+        Some("calendar"),
+        Some("Calendar"),
+    );
+    let tools = [proof.clone(), calendar.clone()];
+    for (policy, expected) in [
+        ("[apps._default]\nenabled = false\n", HashSet::new()),
+        (
+            "[apps.calendar]\ndefault_tools_enabled = false\n",
+            HashSet::from([proof.canonical_tool_name()]),
+        ),
+    ] {
+        let home = tempdir().expect("policy directory");
+        std::fs::write(home.path().join(CONFIG_TOML_FILE), policy).expect("write app policy");
+        let restricted = ConfigBuilder::without_managed_config_for_tests()
+            .codex_home(home.path().to_path_buf())
+            .build()
+            .await
+            .expect("app policy");
+        let mut handlers = HashMap::new();
+        let mut registry = ToolRegistry::default();
+        assert_eq!(
+            append_mcp_tools(
+                &tools,
+                &restricted,
+                false,
+                &runtime,
+                false,
+                &mut handlers,
+                &mut registry,
+            ),
+            expected
+        );
+    }
+    let generic = mcp_config_with_catalog(&config, ResolvedMcpCatalog::default());
+    let mut handlers = HashMap::new();
+    let mut registry = ToolRegistry::default();
+    assert!(
+        append_mcp_tools(
+            &tools,
+            &config,
+            false,
+            &generic,
+            false,
+            &mut handlers,
+            &mut registry,
+        )
+        .is_empty()
+    );
+    assert_eq!(
+        append_mcp_tools(
+            &tools,
+            &config,
+            true,
+            &generic,
+            false,
+            &mut handlers,
+            &mut registry,
+        ),
+        HashSet::from([calendar.canonical_tool_name()])
+    );
+}
