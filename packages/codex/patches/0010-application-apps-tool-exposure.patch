+fn application_runtime_config(config: &Config) -> codex_mcp::McpConfig {
+    let server = codex_mcp::codex_apps_mcp_server_config("https://example.invalid", None, None);
+    let mut catalog = ResolvedMcpCatalog::builder();
+    catalog.register(McpServerRegistration::from_hosted_apps(
+        codex_mcp::APPLICATION_APPS_CONTRIBUTOR_ID,
+        0,
+        server.clone(),
+    ));
+    let mut runtime = mcp_config_with_catalog(config, catalog.build());
+    runtime.apps_enabled = false;
+    runtime.application_apps = Some(Arc::new(codex_mcp::ApplicationApps::verification(server)));
+    runtime
+}
