+async fn admit_tool_span(
+    session: &Session,
+    step: &Arc<StepContext>,
+    name: &codex_tools::ToolName,
+    parent: Option<&codex_otel::sdk_trace::ContextLease>,
+    cancellation: &CancellationToken,
+) -> Result<(bool, Option<codex_otel::sdk_trace::ProviderResponseSpan>), FunctionCallError> {
+    let Some(parent) = parent else {
+        return Ok((false, None));
+    };
+    let admission =
+        crate::model_request::tool_admission_for_step(session.thread_id.to_string(), step.clone(), Vec::new());
+    let scope = codex_extension_api::SdkToolSpanScope {
+        name: name.to_string(),
+        is_handoff: step.settings.agent_profile.as_ref()
+            .is_some_and(|profile| admits_handoff(&profile.profile.data, name, None)),
+    };
+    use codex_extension_api::SdkToolSpanAdmission;
+    let mut selected = None;
+    for contributor in session.services.extensions.model_request_contributors() {
+        let reply = contributor
+            .admit_tool_span(codex_extension_api::SdkProviderResponseSpanInput {
+                admission: admission.clone(),
+                tool_scope: Some(scope.clone()),
+                parent_context: parent.token().to_owned(),
+                cancellation: cancellation.clone(),
+            })
+            .await
+            .map_err(FunctionCallError::Fatal)?;
+        if !matches!(reply, SdkToolSpanAdmission::Unhandled) && selected.replace(reply).is_some() {
+            return Err(FunctionCallError::Fatal("Multiple SDK tool span admissions".into()));
+        }
+    }
+    let Some(reply) = selected else {
+        return Ok((false, None));
+    };
+    if cancellation.is_cancelled() {
+        return Err(FunctionCallError::Fatal("SDK tool span admission cancelled".into()));
+    }
+    let kind = if scope.is_handoff { "handoff" } else { "tool" };
+    let trace = match reply {
+        SdkToolSpanAdmission::Record(reply) => Some(
+            codex_otel::sdk_trace::start_sdk_semantic_span(parent, reply.span_id, scope.name, kind)
+                .map_err(FunctionCallError::Fatal)?,
+        ),
+        SdkToolSpanAdmission::Suppress => None,
+        SdkToolSpanAdmission::Unhandled => unreachable!("Unhandled admission is excluded"),
+    };
+    Ok((true, trace))
+}
+
 impl ToolCallRuntime {
     fn tool_task_join_error(err: JoinError) -> FunctionCallError {
         FunctionCallError::Fatal(format!("tool task failed to receive: {err:?}"))
