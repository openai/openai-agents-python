+#[tokio::test]
+async fn item_references_require_unique_owned_output_in_the_current_anchor() {
+    use wiremock::matchers::{header, method, path};
+    use wiremock::{Mock, MockServer, ResponseTemplate};
+    for (output, accepted) in [
+        (json!([{"id":"msg_first"},{"id":"msg_second"}]), true),
+        (json!([{"id":"msg_first"}]), false),
+        (
+            json!([{"id":"msg_first"},{"id":"msg_second"},{"id":"msg_first"}]),
+            false,
+        ),
+    ] {
+        let server = MockServer::start().await;
+        Mock::given(method("GET"))
+            .and(path("/responses/resp_anchor"))
+            .and(header("authorization", "Bearer current-account"))
+            .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+                "id":"resp_anchor", "status":"completed", "output":output
+            })))
+            .expect(1)
+            .mount(&server)
+            .await;
+        let selected = ProviderHistorySelection::PreviousResponse {
+            id: Some("resp_anchor".into()),
+            item_ids: Some(vec!["msg_second".into(), "msg_first".into()]),
+        };
+        let result = history_client(&server, "Bearer current-account")
+            .verify_history_anchor(&selected, Some(true), http::HeaderMap::new())
+            .await;
+        assert_eq!(result.is_ok(), accepted);
+        assert_eq!(server.received_requests().await.unwrap().len(), 1);
+    }
+}
