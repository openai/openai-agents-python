+#[test]
+fn saved_item_references_supply_data_but_require_the_exact_current_selection() {
+    use codex_protocol::provider_history::ProviderHistoryReference;
+    let selected: ProviderHistorySelection = serde_json::from_value(json!({
+        "type":"previous_response","id":"resp_owned","item_ids":["msg_owned"]
+    }))
+    .unwrap();
+    let saved = ProviderHistoryReference {
+        selection: selected.clone(),
+        provider_route: "https://synthetic.invalid/v1".into(),
+        window: None,
+        pending: false,
+        stored_response: Some(true),
+    };
+    assert!(saved.validate_rebind(&selected).is_ok());
+    let unselected: ProviderHistorySelection = serde_json::from_value(json!({
+        "type":"previous_response","id":"resp_owned"
+    }))
+    .unwrap();
+    assert!(saved.validate_rebind(&unselected).is_err());
+    let changed: ProviderHistorySelection = serde_json::from_value(json!({
+        "type":"previous_response","id":"resp_owned","item_ids":["msg_other"]
+    }))
+    .unwrap();
+    assert!(saved.validate_rebind(&changed).is_err());
+    let data = serde_json::to_value(saved).unwrap();
+    assert!(data.get("headers").is_none());
+    assert!(data.get("authorized").is_none());
