+#[test]
+fn item_references_require_bounded_unique_ids_and_an_exact_anchor() {
+    for value in [
+        json!({"type":"previous_response","item_ids":["msg_owned"]}),
+        json!({"type":"previous_response","id":"resp_owned","item_ids":[]}),
+        json!({"type":"previous_response","id":"resp_owned","item_ids":["same","same"]}),
+        json!({"type":"previous_response","id":"resp_owned","item_ids":[""]}),
+        json!({"type":"previous_response","id":"resp_owned","item_ids":vec!["id";4097]}),
+    ] {
+        let selected: ProviderHistorySelection = serde_json::from_value(value).unwrap();
+        assert!(selected.validate_shape().is_err());
+    }
+    let selected: ProviderHistorySelection = serde_json::from_value(json!({
+        "type":"previous_response","id":"resp_owned","item_ids":["msg_second","msg_first"]
+    }))
+    .unwrap();
+    selected.validate_shape().unwrap();
+    assert_eq!(selected.item_ids(), &["msg_second", "msg_first"]);
+}
