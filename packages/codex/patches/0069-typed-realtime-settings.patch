+    #[tokio::test]
+    async fn public_v2_settings_use_the_existing_writer_without_resetting_other_fields() {
+        use super::super::settings::RealtimeSessionUpdate;
+        use super::super::settings::RealtimeV2SessionSettings;
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let server = tokio::spawn(async move {
+            let (stream, _) = listener.accept().await.unwrap();
+            let mut ws = accept_async(stream).await.unwrap();
+            let first: Value =
+                serde_json::from_str(&ws.next().await.unwrap().unwrap().into_text().unwrap())
+                    .unwrap();
+            assert_eq!(
+                first["session"]["audio"]["input"]["turn_detection"],
+                Value::Null
+            );
+            assert_eq!(first["session"]["audio"]["output"]["voice"], "marin");
+            assert_eq!(first["session"]["audio"]["output"]["speed"], 0.75);
+            assert!(first["session"].get("id").is_none());
+            let second: Value =
+                serde_json::from_str(&ws.next().await.unwrap().unwrap().into_text().unwrap())
+                    .unwrap();
+            assert_eq!(
+                second,
+                json!({"type": "session.update", "session": {
+                    "type": "realtime", "audio": {"output": {"speed": 1.25}}
+                }})
+            );
+        });
+        let client = test_client(Provider {
+            name: "test".into(),
+            base_url: format!("http://{addr}"),
+            query_params: None,
+            headers: HeaderMap::new(),
+            retry: crate::provider::RetryConfig {
+                max_attempts: 1,
+                base_delay: Duration::from_millis(1),
+                retry_429: false,
+                retry_5xx: false,
+                retry_transport: false,
+            },
+            stream_idle_timeout: Duration::from_secs(5),
+        });
+        let config = RealtimeSessionConfig {
+            v2: Some(RealtimeV2SessionSettings {
+                turn_detection: Some(None),
+                output_speed: Some(0.75),
+                ..Default::default()
+            }),
+            instructions: "brief".into(),
+            initial_items: vec![],
+            delegation_ack_filler: None,
+            model: Some("gpt-realtime".into()),
+            session_id: Some("native-conversation".into()),
+            event_parser: RealtimeEventParser::RealtimeV2,
+            session_mode: RealtimeSessionMode::Conversational,
+            output_modality: RealtimeOutputModality::Audio,
+            voice: RealtimeVoice::Marin,
+        };
+        let connection = client
+            .connect(config.clone(), HeaderMap::new(), HeaderMap::new())
+            .await
+            .unwrap();
+        connection
+            .writer()
+            .send_session_patch(&RealtimeSessionUpdate {
+                settings: RealtimeV2SessionSettings {
+                    output_speed: Some(1.25),
+                    ..Default::default()
+                },
+                ..Default::default()
+            })
+            .await
+            .unwrap();
+        server.await.unwrap();
+
+        // Invalid settings must fail before an otherwise valid transport accepts anything.
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let client = test_client(Provider {
+            name: "test".into(),
+            base_url: format!("http://{}", listener.local_addr().unwrap()),
+            query_params: None,
+            headers: HeaderMap::new(),
+            retry: crate::provider::RetryConfig {
+                max_attempts: 1,
+                base_delay: Duration::from_millis(1),
+                retry_429: false,
+                retry_5xx: false,
+                retry_transport: false,
+            },
+            stream_idle_timeout: Duration::from_secs(5),
+        });
+        let mut invalid = config;
+        invalid.v2.as_mut().unwrap().output_speed = Some(f64::NAN);
+        assert!(matches!(
