+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::endpoint::realtime_websocket::protocol::RealtimeEventParser;
+    use crate::endpoint::realtime_websocket::protocol::RealtimeSessionConfig;
+    use crate::endpoint::realtime_websocket::protocol::RealtimeSessionMode;
+    use crate::endpoint::realtime_websocket::protocol::RealtimeVoice;
+    use crate::endpoint::realtime_websocket::session_update_session_json;
+    use serde_json::json;
+
+    fn config() -> RealtimeSessionConfig {
+        RealtimeSessionConfig {
+            v2: None,
+            instructions: "Keep it brief".into(),
+            initial_items: vec![],
+            delegation_ack_filler: None,
+            model: Some("gpt-realtime".into()),
+            session_id: None,
+            event_parser: RealtimeEventParser::RealtimeV2,
+            session_mode: RealtimeSessionMode::Conversational,
+            output_modality: RealtimeOutputModality::Audio,
+            voice: RealtimeVoice::Marin,
+        }
+    }
+
+    #[test]
+    fn nullable_settings_preserve_missing_null_and_value() {
+        for (field, value) in [
+            (
+                "turn_detection",
+                json!({"type": "semantic_vad", "create_response": false}),
+            ),
+            ("noise_reduction", json!({"type": "far_field"})),
+            ("transcription", json!({"model": "gpt-transcribe"})),
+            ("tracing", json!("auto")),
+            ("prompt", json!({"id": "pmpt_123"})),
+        ] {
+            for object in [json!({}), json!({(field): null}), json!({(field): value})] {
+                let settings: RealtimeV2SessionSettings =
+                    serde_json::from_value(object.clone()).unwrap();
+                assert_eq!(serde_json::to_value(&settings).unwrap(), object);
+                let update: RealtimeSessionUpdate = serde_json::from_value(object.clone()).unwrap();
+                assert_eq!(serde_json::to_value(&update).unwrap(), object);
+            }
+        }
+    }
+
+    #[test]
+    fn speed_update_does_not_reset_other_settings() {
+        let update = RealtimeSessionUpdate {
+            settings: RealtimeV2SessionSettings {
+                output_speed: Some(1.25),
+                ..Default::default()
+            },
+            ..Default::default()
+        };
+        assert_eq!(
+            realtime_v2_session_update_json(&update).unwrap(),
+            json!({
+                "type": "session.update", "session": { "type": "realtime", "audio": {"output": {"speed": 1.25}} }
+            })
+        );
+    }
+
+    #[test]
+    fn disabled_settings_do_not_restore_initial_defaults() {
+        let update: RealtimeSessionUpdate = serde_json::from_value(json!({
+            "turn_detection": null, "noise_reduction": null, "transcription": null, "tracing": null
+        }))
+        .unwrap();
+        assert_eq!(
+            realtime_v2_session_update_json(&update).unwrap(),
+            json!({
+                "type": "session.update", "session": {"type": "realtime", "tracing": null,
+                    "audio": {"input": {"turn_detection": null, "noise_reduction": null, "transcription": null}}}
+            })
+        );
+        let mut initial = config();
+        initial.v2 = Some(update.settings);
+        let value = session_update_session_json(initial).unwrap();
+        assert_eq!(value["audio"]["input"]["turn_detection"], Value::Null);
+        assert_eq!(value["audio"]["output"]["voice"], "marin");
+        assert_eq!(value["tracing"], Value::Null);
+    }
+
+    #[test]
+    fn each_format_has_its_provider_shape_for_both_channels() {
+        for (format, expected) in [
+            (
+                RealtimeAudioFormat::Pcm24k,
+                json!({"type": "audio/pcm", "rate": 24000}),
+            ),
+            (RealtimeAudioFormat::G711Ulaw, json!({"type": "audio/pcmu"})),
+            (RealtimeAudioFormat::G711Alaw, json!({"type": "audio/pcma"})),
+        ] {
+            let update = RealtimeSessionUpdate {
+                settings: RealtimeV2SessionSettings {
+                    input_format: Some(format),
+                    output_format: Some(format),
+                    ..Default::default()
+                },
+                ..Default::default()
+            };
+            let value = realtime_v2_session_update_json(&update).unwrap();
+            assert_eq!(value["session"]["audio"]["input"]["format"], expected);
+            assert_eq!(value["session"]["audio"]["output"]["format"], expected);
+        }
+    }
+
+    #[test]
+    fn full_settings_preserve_false_zero_and_typed_payloads() {
+        let update: RealtimeSessionUpdate = serde_json::from_value(json!({
+            "model": "gpt-realtime-2", "instructions": "Hello", "output_modality": "text",
+            "turn_detection": {"type": "server_vad", "create_response": false, "interrupt_response": false,
+                "threshold": 0.0, "prefix_padding_ms": 0, "silence_duration_ms": 0, "idle_timeout_ms": 10000},
+            "transcription": {"model": "gpt-transcribe", "language": "en", "prompt": "names",
+                "keywords": ["Codex"], "languages": ["en", "es"], "delay": "low"},
+            "output_voice": {"id": "voice_123"}, "output_speed": 0.5,
+            "noise_reduction": {"type": "near_field"},
+            "prompt": {"id": "pmpt_123", "version": "2", "variables": {
+                "city": "Paris", "text": {"type": "input_text", "text": "Hello"},
+                "image": {"type": "input_image", "image_url": "https://example.com/a.png", "detail": "auto"},
+                "file": {"type": "input_file", "file_id": "file_123"}}},
+            "tracing": {"workflow_name": "voice", "group_id": "group_123", "metadata": {"count": 1}},
+            "max_output_tokens": "inf", "parallel_tool_calls": false, "reasoning": {"effort": "high"}
+        })).unwrap();
+        let session = realtime_v2_session_update_json(&update).unwrap()["session"].clone();
+        assert_eq!(session["output_modalities"], json!(["text"]));
+        assert_eq!(
+            session["audio"]["input"]["turn_detection"]["threshold"],
+            0.0
+        );
+        assert_eq!(
+            session["audio"]["input"]["turn_detection"]["create_response"],
+            false
+        );
+        assert_eq!(
+            session["audio"]["input"]["turn_detection"]["prefix_padding_ms"],
+            0
+        );
+        assert_eq!(
+            session["audio"]["input"]["transcription"],
+            serde_json::to_value(update.settings.transcription.unwrap().unwrap()).unwrap()
+        );
+        assert_eq!(
+            session["audio"]["output"],
+            json!({"voice": {"id": "voice_123"}, "speed": 0.5})
+        );
+        assert_eq!(
+            session["prompt"],
+            serde_json::to_value(update.settings.prompt.unwrap().unwrap()).unwrap()
+        );
+        assert_eq!(session["tracing"]["group_id"], "group_123");
+        assert_eq!(session["max_output_tokens"], "inf");
+        assert_eq!(session["parallel_tool_calls"], false);
+        assert_eq!(session["reasoning"], json!({"effort": "high"}));
+    }
+
+    #[test]
+    fn legacy_defaults_are_retained_and_only_named_overrides_replace_them() {
+        let initial = session_update_session_json(config()).unwrap();
+        let mut changed = config();
+        changed.v2 = Some(RealtimeV2SessionSettings {
+            output_speed: Some(1.25),
+            ..Default::default()
+        });
+        let mut actual = session_update_session_json(changed).unwrap();
+        assert_eq!(
+            actual["audio"]["output"]
+                .as_object_mut()
+                .unwrap()
+                .remove("speed"),
+            Some(json!(1.25))
+        );
+        assert_eq!(actual, initial);
+        assert_eq!(
+            initial["audio"]["input"]["turn_detection"]["silence_duration_ms"],
+            500
+        );
+        assert_eq!(initial["tools"].as_array().unwrap().len(), 2);
+    }
+
+    #[test]
+    fn nonfinite_settings_and_wrong_protocol_fail_before_serialization() {
+        for number in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY] {
+            let update = RealtimeSessionUpdate {
+                settings: RealtimeV2SessionSettings {
+                    output_speed: Some(number),
+                    ..Default::default()
+                },
+                ..Default::default()
+            };
+            assert!(realtime_v2_session_update_json(&update).is_err());
+            let mut initial = config();
+            initial.v2 = Some(update.settings);
+            assert!(session_update_session_json(initial).is_err());
+            let update = RealtimeSessionUpdate {
+                settings: RealtimeV2SessionSettings {
+                    turn_detection: Some(Some(RealtimeTurnDetection::ServerVad {
+                        threshold: Some(number),
+                        create_response: None,
+                        interrupt_response: None,
+                        prefix_padding_ms: None,
+                        silence_duration_ms: None,
+                        idle_timeout_ms: None,
+                    })),
+                    ..Default::default()
+                },
+                ..Default::default()
+            };
+            assert!(realtime_v2_session_update_json(&update).is_err());
+        }
+        for parser in [RealtimeEventParser::V1, RealtimeEventParser::FramelessBidi] {
+            let mut initial = config();
+            initial.event_parser = parser;
+            initial.v2 = Some(RealtimeV2SessionSettings::default());
+            assert!(session_update_session_json(initial).is_err());
+        }
+    }
+}
