+}
+
+fn put<T: Serialize>(
+    map: &mut Map<String, Value>,
+    key: &str,
+    value: &Option<T>,
+) -> serde_json::Result<()> {
+    if let Some(value) = value {
+        map.insert(key.to_string(), serde_json::to_value(value)?);
+    }
+    Ok(())
+}
+
+fn format_value(format: RealtimeAudioFormat) -> Value {
+    match format {
+        RealtimeAudioFormat::Pcm24k => serde_json::json!({"type": "audio/pcm", "rate": 24000}),
+        RealtimeAudioFormat::G711Ulaw => serde_json::json!({"type": "audio/pcmu"}),
+        RealtimeAudioFormat::G711Alaw => serde_json::json!({"type": "audio/pcma"}),
+    }
+}
+
+impl RealtimeV2SessionSettings {
+    pub(super) fn validate(&self) -> serde_json::Result<()> {
+        let threshold = match &self.turn_detection {
+            Some(Some(RealtimeTurnDetection::ServerVad { threshold, .. })) => *threshold,
+            _ => None,
+        };
+        if self.output_speed.is_some_and(|speed| !speed.is_finite())
+            || threshold.is_some_and(|value| !value.is_finite())
+        {
+            return Err(serde::ser::Error::custom(
+                "Realtime numeric settings must be finite",
+            ));
+        }
+        Ok(())
+    }
+
+    // Only named leaves are replaced; initial defaults and sparse updates use
+    // the same mapping without maintaining another copy of session state.
+    pub(super) fn apply(&self, session: &mut Map<String, Value>) -> serde_json::Result<()> {
+        self.validate()?;
+        put(session, "prompt", &self.prompt)?;
+        put(session, "tracing", &self.tracing)?;
+        put(session, "max_output_tokens", &self.max_output_tokens)?;
+        put(session, "parallel_tool_calls", &self.parallel_tool_calls)?;
+        put(session, "reasoning", &self.reasoning)?;
+        let mut input = Map::new();
+        if let Some(format) = self.input_format {
+            input.insert("format".into(), format_value(format));
+        }
+        put(&mut input, "noise_reduction", &self.noise_reduction)?;
+        put(&mut input, "transcription", &self.transcription)?;
+        put(&mut input, "turn_detection", &self.turn_detection)?;
+        let mut output = Map::new();
+        if let Some(format) = self.output_format {
+            output.insert("format".into(), format_value(format));
+        }
+        put(&mut output, "voice", &self.output_voice)?;
+        put(&mut output, "speed", &self.output_speed)?;
+        if !input.is_empty() || !output.is_empty() {
+            let audio = session
+                .entry("audio")
+                .or_insert_with(|| Value::Object(Map::new()));
+            let audio = audio.as_object_mut().expect("typed audio object");
+            for (name, fields) in [("input", input), ("output", output)] {
+                if !fields.is_empty() {
+                    let section = audio
+                        .entry(name)
+                        .or_insert_with(|| Value::Object(Map::new()));
+                    section
+                        .as_object_mut()
+                        .expect("typed audio section")
+                        .extend(fields);
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Build a sparse public V2 session.update event without connecting to a provider.
+/// Only supplied fields are sent. The provider owns phase-dependent mutability.
+pub fn realtime_v2_session_update_json(
+    update: &RealtimeSessionUpdate,
+) -> serde_json::Result<Value> {
+    let mut session = Map::new();
+    session.insert("type".into(), Value::String("realtime".into()));
+    put(&mut session, "model", &update.model)?;
+    put(&mut session, "instructions", &update.instructions)?;
+    if let Some(modality) = update.output_modality {
+        let value = match modality {
+            RealtimeOutputModality::Text => "text",
+            RealtimeOutputModality::Audio => "audio",
+        };
+        session.insert("output_modalities".into(), serde_json::json!([value]));
+    }
+    update.settings.apply(&mut session)?;
+    Ok(serde_json::json!({"type": "session.update", "session": session}))
+}
