 }
+
+#[test]
+fn request_admission_rechecks_the_captured_interceptor_before_transport() {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    struct Captured(Arc<AtomicBool>);
+    impl ModelResponseInterceptor for Captured {
+        fn admit_request(&self) -> Result<(), String> {
+            if self.0.load(Ordering::Acquire) {
+                Err("original request revoked".into())
+            } else {
+                Ok(())
+            }
+        }
+        fn intercept(self: Box<Self>, stream: ModelResponseStream) -> ModelResponseStream {
+            stream
+        }
+    }
+    let stopped = Arc::new(AtomicBool::new(false));
+    let original: Vec<Box<dyn ModelResponseInterceptor>> = vec![Box::new(BoundInterceptor {
+        inner: Box::new(Captured(stopped.clone())),
+        admission: None,
+    })];
+    let successor: Vec<Box<dyn ModelResponseInterceptor>> = vec![Box::new(BoundInterceptor {
+        inner: Box::new(Captured(Arc::new(AtomicBool::new(false)))),
+        admission: None,
+    })];
+    assert!(admit_request(&original).is_ok());
+    stopped.store(true, Ordering::Release);
+    assert_eq!(
+        admit_request(&original).unwrap_err(),
+        "original request revoked"
+    );
+    assert!(admit_request(&successor).is_ok());
+}
