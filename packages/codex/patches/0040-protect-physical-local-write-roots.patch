+#[cfg(any(target_os = "linux", target_os = "macos"))]
 type EntryIdentity = (u64, u64);
 
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+#[derive(Default)]
+struct PhysicalWriteRoots {
+    roots: HashSet<EntryIdentity>,
+    ancestors: HashSet<EntryIdentity>,
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+impl PhysicalWriteRoots {
+    fn new(roots: &[AbsolutePathBuf]) -> io::Result<Self> {
+        let mut physical = Self::default();
+        for root in roots {
+            physical.roots.insert(write_root_identity(root.as_path())?);
+            for ancestor in root.as_path().ancestors().skip(1) {
+                physical.ancestors.extend(entry_identity(ancestor)?);
+            }
+        }
+        Ok(physical)
+    }
+
+    fn contains_entry(&self, path: &Path) -> io::Result<bool> {
+        if self.roots.is_empty() {
+            return Ok(false);
+        }
+        // An alternate spelling can hide a grant even when only an ancestor
+        // of the proposed path already exists.
+        for ancestor in path.ancestors() {
+            if entry_identity(ancestor)?.is_some_and(|identity| self.roots.contains(&identity)) {
+                return Ok(true);
+            }
+        }
+        Ok(false)
+    }
+
+    fn has_root_at_or_below(&self, path: &Path) -> io::Result<bool> {
+        if self.roots.is_empty() {
+            return Ok(false);
+        }
+        Ok(entry_identity(path)?.is_some_and(|identity| {
+            self.roots.contains(&identity) || self.ancestors.contains(&identity)
+        }))
+    }
+}
