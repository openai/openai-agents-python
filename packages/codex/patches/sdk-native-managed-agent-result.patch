+    pub role: &'a str,
+    pub source: serde_json::Value,
+    pub result: &'a crate::ManagedAgentToolResult,
+    pub cancellation: CancellationToken,
+}
+
+pub trait ManagedAgentResultCallback: Send + Sync {
+    /// None preserves native output. Err withholds this tool result, not the parent run.
+    fn settle<'a>(
+        &'a self,
+        input: ManagedAgentResultInput<'a>,
+    ) -> BoxFuture<'a, Result<Option<String>, ()>>;
+}
+
+/// A live registration, never a checkpoint or model-declared capability.
+#[derive(Clone)]
+pub struct ManagedAgentResultGate(pub Arc<dyn ManagedAgentResultCallback>);
