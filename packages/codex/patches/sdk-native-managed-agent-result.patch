+//! Process-local result admission for explicitly opted-in managed role tools.
+use codex_extension_api::ExtensionData;
+use codex_tools::ToolName;
+use futures::future::BoxFuture;
+use std::sync::Arc;
+use tokio_util::sync::CancellationToken;
+
+pub struct ManagedAgentProducedItems {
+    pub root_turn_id: Option<String>,
+    pub items: Result<String, String>,
+}
+
+pub struct ManagedAgentResultInput<'a> {
+    pub step_store: &'a ExtensionData,
+    pub thread_store: &'a ExtensionData,
+    pub parent_thread_id: &'a str,
+    pub parent_turn_id: &'a str,
+    pub call_id: &'a str,
