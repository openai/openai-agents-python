+// Source history retains its audit facts. Only its derived presentation archives
+// completed approval pairs, matching the SDK portable-import replay policy.
+fn handoff_source_values(
+    all: &[&ResponseItem],
+    selected: &[&ResponseItem],
+) -> CodexResult<Vec<serde_json::Value>> {
+    let approved: std::collections::HashSet<_> = all.iter().filter_map(|item| match item {
+        ResponseItem::McpApprovalResponse { approve: true, approval_request_id, .. } =>
+            Some(approval_request_id.as_str()),
+        _ => None,
+    }).collect();
+    selected.iter().filter(|item| match item {
+        ResponseItem::Message { role, .. } => role == "user" || role == "assistant",
+        ResponseItem::McpApprovalRequest { id: Some(id), .. } => !approved.contains(id.as_str()),
+        ResponseItem::McpApprovalResponse { approval_request_id, .. } =>
+            !approved.contains(approval_request_id.as_str()),
+        _ => true,
+    }).map(|item| serde_json::to_value(item).map_err(|error| invalid(error.to_string()))).collect()
 }

