+pub(crate) fn is_http_slow_down(error: &TransportError) -> bool {
+    let TransportError::Http {
+        status: http::StatusCode::SERVICE_UNAVAILABLE,
+        body: Some(body),
+        ..
+    } = error
+    else {
+        return false;
+    };
+    service_unavailable_error(body)
+        .is_some_and(|error| matches!(error.details(), CodexErrorDetails::RateLimitExceeded(_)))
+}
+
+fn service_unavailable_error(body: &str) -> Option<CodexErr> {
+    let value = serde_json::from_str::<Value>(body).ok()?;
+    let error = value.get("error")?;
+    match error.get("code").and_then(Value::as_str) {
+        Some("server_is_overloaded") => Some(CodexErr::ServerOverloaded),
+        Some("slow_down") => Some(CodexErr::new(CodexErrorDetails::RateLimitExceeded(
+            error
+                .get("message")
+                .and_then(Value::as_str)
+                .unwrap_or_default()
+                .to_owned(),
+        ))),
+        _ => None,
+    }
+}
