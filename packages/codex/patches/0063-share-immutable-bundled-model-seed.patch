+// Keep the public/persisted ModelsCacheEntry owned. Only the immutable bundled
+// seed needs shared storage; every remote/cache publication moves its own Vec.
+#[derive(Debug)]
+struct InMemoryModelsEntry {
+    fetched_at: DateTime<Utc>,
+    etag: Option<String>,
+    identity: Option<String>,
+    models: Cow<'static, [ModelInfo]>,
+}
+
+impl From<ModelsCacheEntry> for InMemoryModelsEntry {
+    fn from(entry: ModelsCacheEntry) -> Self {
+        Self {
+            fetched_at: entry.fetched_at,
+            etag: entry.etag,
+            identity: entry.identity,
+            models: Cow::Owned(entry.models),
+        }
+    }
+}
