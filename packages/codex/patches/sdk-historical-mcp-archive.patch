+#[cfg(test)]
+mod historical_mcp_presentation_tests {
+    use super::*;
+    use serde_json::json;
+
+    fn request() -> serde_json::Value {
+        json!({"type":"mcp_approval_request","id":"approval-history","server_label":"archive","name":"lookup","arguments":"{}"})
+    }
+
+    fn decision(approve: bool) -> serde_json::Value {
+        json!({"type":"mcp_approval_response","approval_request_id":"approval-history","approve":approve})
+    }
+
+    #[test]
+    fn approving_pairs_duplicates_and_orphans_are_only_quoted_data() {
+        for records in [
+            vec![request(), decision(true)],
+            vec![request(), decision(true), request(), decision(true)],
+            vec![decision(true)],
+            vec![request(), decision(true), decision(false)],
+        ] {
+            let originals = records.iter().map(ToString::to_string).collect::<Vec<_>>();
+            let projected = input_projections(&originals).unwrap();
+            assert_eq!(projected.len(), originals.len());
+            for (projection, original) in projected.into_iter().zip(originals) {
+                let value = serde_json::to_value(projection.unwrap()).unwrap();
+                assert_eq!(value["type"], "message");
+                assert_eq!(value["role"], "assistant");
+                let text = value["content"][0]["text"].as_str().unwrap();
+                assert_eq!(text.split_once('\n').unwrap().1, original);
+            }
+        }
+    }
+
+    #[test]
+    fn denial_only_pairs_and_false_function_results_keep_native_projection() {
+        let records = vec![request(), decision(false)];
+        let originals = records.iter().map(ToString::to_string).collect::<Vec<_>>();
+        let projected = input_projections(&originals).unwrap();
+        assert!(matches!(
+            projected[0],
+            Some(ResponseItem::McpApprovalRequest { .. })
+        ));
+        assert!(matches!(
+            projected[1],
+            Some(ResponseItem::McpApprovalResponse { approve: false, .. })
+        ));
+        let result = json!({"type":"function_call_output","call_id":"ordinary","output":"false"})
+            .to_string();
+        assert_eq!(
+            input_projections(&[result.clone()]).unwrap(),
+            vec![input_projection(&result).unwrap()]
+        );
+        assert!(input_projection(&decision(true).to_string()).is_err());
+    }
+}
