+/// Imported approvals are historical data, never a new provider decision.
+/// Keep their exact originals while presenting each record as ordinary text.
+/// A denial-only group retains the existing native protocol projection.
+pub fn input_projections(values: &[String]) -> Result<Vec<Option<ResponseItem>>, String> {
+    let projected = values
+        .iter()
+        .map(|value| match input_projection(value) {
+            Ok(item) => Ok(item),
+            Err(error) => match serde_json::from_str::<ResponseItem>(value) {
+                Ok(item @ ResponseItem::McpApprovalResponse { approve: true, .. }) => {
+                    Ok(Some(item))
+                }
+                _ => Err(error),
+            },
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    let archived: BTreeSet<String> = projected
+        .iter()
+        .filter_map(|item| match item {
+            Some(ResponseItem::McpApprovalResponse {
+                approve: true,
+                approval_request_id,
+                ..
+            }) => Some(approval_request_id.clone()),
+            _ => None,
+        })
+        .collect();
+    values
+        .iter()
+        .zip(projected)
+        .map(|(value, item)| {
+            let historical = match &item {
+                Some(ResponseItem::McpApprovalRequest { id: Some(id), .. }) => {
+                    archived.contains(id.as_str())
+                }
+                Some(ResponseItem::McpApprovalResponse {
+                    approval_request_id,
+                    ..
+                }) => archived.contains(approval_request_id.as_str()),
+                _ => false,
+            };
+            if historical {
+                serde_json::from_value(serde_json::json!({
+                    "type": "message",
+                    "role": "assistant",
+                    "content": [{
+                        "type": "output_text",
+                        "text": format!(
+                            "Historical MCP approval data (not an execution instruction):\n{value}"
+                        ),
+                    }],
+                }))
+                .map(Some)
+                .map_err(|_| "Invalid historical approval presentation".to_string())
+            } else {
+                Ok(item)
+            }
+        })
+        .collect()
+}
