 use std::collections::HashMap;
 use std::sync::Arc;
 
+pub(crate) const MODEL_COMPLETION_BOUNDARY_ERROR: &str =
+    "Model completion hooks require a provider response that can finish before local tool execution";
+
+/// Captured from the same request's selected completion observers and tools.
+pub(crate) struct PostTerminalToolDispatch;
+
+pub(crate) fn requires_post_terminal_tool_dispatch(
+    admission: Option<&Arc<dyn ModelToolAdmission>>,
+) -> bool {
+    admission
+        .and_then(|admission| admission.step_store())
+        .and_then(|store| store.get::<PostTerminalToolDispatch>())
+        .is_some()
+}
+
+pub(crate) fn check_post_terminal_http_interceptors(
+    interceptors: &[Box<dyn ModelResponseInterceptor>],
+) -> Result<(), String> {
+    if interceptors.iter().all(|interceptor| {
+        !interceptor.produces_response() && interceptor.permits_post_terminal_tool_dispatch()
+    }) {
+        Ok(())
+    } else {
+        Err(MODEL_COMPLETION_BOUNDARY_ERROR.to_owned())
+    }
+}
