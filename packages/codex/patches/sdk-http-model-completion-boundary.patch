+#[cfg(test)]
+mod post_terminal_http_tests {
+    use super::*;
+
+    struct Native;
+    impl ModelResponseInterceptor for Native {
+        fn permits_post_terminal_tool_dispatch(&self) -> bool {
+            true
+        }
+        fn intercept(self: Box<Self>, stream: ModelResponseStream) -> ModelResponseStream {
+            stream
+        }
+    }
+    struct Unknown;
+    impl ModelResponseInterceptor for Unknown {
+        fn intercept(self: Box<Self>, stream: ModelResponseStream) -> ModelResponseStream {
+            stream
+        }
+    }
+    struct Producer;
+    impl ModelResponseInterceptor for Producer {
+        fn permits_post_terminal_tool_dispatch(&self) -> bool {
+            true
+        }
+        fn produces_response(&self) -> bool {
+            true
+        }
+        fn intercept(self: Box<Self>, stream: ModelResponseStream) -> ModelResponseStream {
+            stream
+        }
+    }
+
+    #[test]
+    fn only_owned_native_http_wrappers_allow_terminal_before_tools() {
+        assert!(check_post_terminal_http_interceptors(&[]).is_ok());
+        assert!(check_post_terminal_http_interceptors(&[Box::new(Native)]).is_ok());
+        assert!(
+            check_post_terminal_http_interceptors(&[Box::new(Native), Box::new(Unknown)]).is_err()
+        );
+        assert!(check_post_terminal_http_interceptors(&[Box::new(Producer)]).is_err());
+    }
+}
