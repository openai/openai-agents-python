+impl LocalThreadStore {
+    async fn original_history_segments(
+        &self,
+        params: LoadThreadHistoryParams,
+    ) -> ThreadStoreResult<Vec<crate::OriginalHistorySegment>> {
+        let path = if let Ok(path) = live_writer::rollout_path(self, params.thread_id).await {
+            if !params.include_archived
+                && helpers::rollout_path_is_archived(
+                    self.config.codex_home.as_path(),
+                    path.as_path(),
+                )
+            {
+                return Err(crate::ThreadStoreError::InvalidRequest {
+                    message: format!("thread {} is archived", params.thread_id),
+                });
+            }
+            path
+        } else {
+            read_thread::read_thread(
+                self,
+                ReadThreadParams {
+                    thread_id: params.thread_id,
+                    include_archived: params.include_archived,
+                    include_history: false,
+                },
+            )
+            .await?
+            .rollout_path
+            .ok_or_else(|| crate::ThreadStoreError::Internal {
+                message: "original history rollout path unavailable".into(),
+            })?
+        };
+        let session_meta = codex_rollout::read_session_meta_line(&path)
+            .await
+            .map_err(|_| crate::ThreadStoreError::Internal {
+                message: "original history rollout unavailable".into(),
+            })?;
+        if session_meta.meta.id != params.thread_id {
+            return Err(crate::ThreadStoreError::ThreadNotFound {
+                thread_id: params.thread_id,
+            });
+        }
+        let ranges = if session_meta.meta.history_mode
+            == codex_protocol::protocol::ThreadHistoryMode::Paginated
+        {
+            self.resolve_rollout_lineage(params.thread_id, Some(path))
+                .await?
+                .segments
+                .into_iter()
+                .map(|segment| {
+                    (
+                        segment.rollout_path,
+                        segment.end.map(|end| end.end_byte_offset),
+                    )
+                })
+                .collect::<Vec<_>>()
+        } else {
+            vec![(path, None)]
+        };
+        tokio::task::spawn_blocking(move || {
+            ranges
+                .into_iter()
+                .map(|(rollout_path, end)| {
+                    let file = codex_rollout::open_rollout_seekable_reader(&rollout_path).map_err(
+                        |_| crate::ThreadStoreError::Internal {
+                            message: "original history rollout unavailable".into(),
+                        },
+                    )?;
+                    let length = file
+                        .metadata()
+                        .map_err(|_| crate::ThreadStoreError::Internal {
+                            message: "original history rollout unavailable".into(),
+                        })?
+                        .len();
+                    let end_byte_offset = end.unwrap_or(length);
+                    if end_byte_offset > length {
+                        return Err(crate::ThreadStoreError::Internal {
+                            message: "original history prefix unavailable".into(),
+                        });
+                    }
+                    Ok(crate::OriginalHistorySegment {
+                        rollout_path,
+                        end_byte_offset,
+                    })
+                })
+                .collect()
+        })
+        .await
+        .map_err(|_| crate::ThreadStoreError::Internal {
+            message: "original history reader task failed".into(),
+        })?
+    }
+}
