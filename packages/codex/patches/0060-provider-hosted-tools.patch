+#[tokio::test]
+async fn hosted_step_selection_retains_captured_specs_without_local_executors() {
+    let (mut session, mut turn) = make_session_and_context().await;
+    update_turn_settings_for_test(&mut turn, |settings| {
+        Arc::make_mut(&mut settings.model_info).use_responses_lite = false;
+    });
+    let hosted: codex_extension_api::HostedModelTools = serde_json::from_value(json!({"tools":[
+        {"type":"file_search","vector_store_ids":["vs_original"],"include_search_results":true},
+        {"type":"code_interpreter","container":"cntr_test"},
+        {"type":"image_generation","partial_images":2}
+    ]}))
+    .unwrap();
+    session.services.thread_extension_data.insert(hosted);
+    let selector = Arc::new(StepSelector {
+        calls: Default::default(),
+        names: vec![ToolName::plain("file_search")],
+    });
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::default();
+    extensions.tool_contributor(selector.clone());
+    session.services.extensions = Arc::new(extensions.build());
+    let step = StepContext::for_test(Arc::new(turn));
+    for attempt in 0..2 {
+        if attempt == 1 {
+            session
+                .services
+                .thread_extension_data
+                .insert(codex_extension_api::HostedModelTools::default());
+        }
+        let router = super::build_tool_router(
+            &session,
+            step.turn.as_ref(),
+            &step.settings.model_info,
+            &step.environments,
+            &step.mcp,
+            false,
+            &step.extension_data,
+            None,
+        )
+        .await
+        .unwrap();
+        let specs = router.model_visible_specs();
+        assert_eq!(specs.len(), 1);
+        assert_eq!(specs[0].name(), "file_search");
+        assert_eq!(
+            serde_json::to_value(&specs[0]).unwrap()["vector_store_ids"],
+            json!(["vs_original"])
+        );
+        assert!(!router.exposes_tool(&ToolName::plain("file_search")));
+    }
+    assert_eq!(selector.calls.load(std::sync::atomic::Ordering::SeqCst), 1);
+}
