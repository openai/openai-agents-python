@@ -0,0 +1,216 @@
+//! Provider-executed Responses tools. These declarations never register local executors.
+use serde::{Deserialize, Serialize};
+
+/// Trusted host declarations, captured before each step selects its tool catalog.
+#[derive(Debug, Clone, Default, Serialize, Deserialize, PartialEq)]
+pub struct HostedModelTools {
+    pub tools: Vec<HostedToolSpec>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum HostedToolSpec {
+    FileSearch(FileSearchTool),
+    CodeInterpreter(CodeInterpreterTool),
+    ImageGeneration(ImageGenerationTool),
+}
+
+impl From<HostedToolSpec> for crate::ToolSpec {
+    fn from(spec: HostedToolSpec) -> Self {
+        match spec {
+            HostedToolSpec::FileSearch(config) => Self::FileSearch(config),
+            HostedToolSpec::CodeInterpreter(config) => Self::CodeInterpreter(config),
+            HostedToolSpec::ImageGeneration(config) => Self::ImageGeneration(config),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+#[serde(untagged)]
+pub enum CodeInterpreterContainer {
+    Existing(String),
+    Auto(AutoCodeInterpreterContainer),
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum CodeInterpreterNetworkPolicy {
+    Disabled,
+    Allowlist {
+        allowed_domains: Vec<String>,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        domain_secrets: Option<Vec<CodeInterpreterDomainSecret>>,
+    },
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct FileSearchTool {
+    pub vector_store_ids: Vec<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub filters: Option<serde_json::Value>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub max_num_results: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub ranking_options: Option<FileSearchRankingOptions>,
+    /// Requests raw results through the top-level Responses include list.
+    #[serde(default, skip_serializing)]
+    pub include_search_results: bool,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct FileSearchRankingOptions {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub ranker: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub score_threshold: Option<f64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub hybrid_search: Option<FileSearchHybridSearch>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct FileSearchHybridSearch {
+    pub embedding_weight: f64,
+    pub text_weight: f64,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct CodeInterpreterTool {
+    pub container: CodeInterpreterContainer,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub allowed_callers: Option<Vec<String>>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct AutoCodeInterpreterContainer {
+    #[serde(rename = "type")]
+    pub kind: AutoCodeInterpreterContainerKind,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub file_ids: Option<Vec<String>>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub memory_limit: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub network_policy: Option<CodeInterpreterNetworkPolicy>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct CodeInterpreterDomainSecret {
+    pub domain: String,
+    pub name: String,
+    pub value: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct ImageGenerationTool {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
