+#[test]
+fn hosted_item_projection_preserves_raw_provider_data_and_existing_image_wire_name() {
+    for value in [
+        serde_json::json!({"type":"file_search_call","id":"fs_test","status":"completed","queries":[],"results":[],"future":7}),
+        serde_json::json!({"type":"code_interpreter_call","id":"ci_test","status":"completed","code":null,"outputs":null,"container_id":"cntr_test","future":7}),
+        serde_json::json!({"type":"image_generation_call","id":"ig_test","status":"in_progress","result":null,"quality":"high","future":7}),
+    ] {
+        let item: ResponseItem = serde_json::from_value(value.clone()).unwrap();
+        assert!(
+            crate::tools::router::ToolRouter::build_tool_call(item.clone())
+                .unwrap()
+                .is_none()
+        );
+        let projected = serde_json::to_value(parse_turn_item(&item).unwrap()).unwrap();
+        if value["type"] == "image_generation_call" {
+            assert_eq!(projected["type"], "ImageGeneration");
+            assert_eq!(projected["provider_data"], value);
+            assert!(projected["result"].is_null());
+        } else {
+            assert_eq!(projected["type"], "hosted_tool_call");
+            assert_eq!(projected["item"], value);
+        }
