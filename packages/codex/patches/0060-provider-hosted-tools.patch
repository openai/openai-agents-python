+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn hosted_declarations_serialize_provider_fields_without_include_flag() {
+        let input = json!({"tools": [
+            {"type":"file_search", "vector_store_ids":["vs_test"],
+             "filters":{"type":"and", "filters":[{"type":"eq", "key":"team", "value":"docs"}]},
+             "max_num_results":4, "ranking_options":{"hybrid_search":{"embedding_weight":0.8,"text_weight":0.2}},
+             "include_search_results":true},
+            {"type":"code_interpreter", "container":{"type":"auto", "file_ids":["file_test"],
+             "memory_limit":"4g", "network_policy":{"type":"disabled"}}},
+            {"type":"image_generation", "model":"gpt-image-2", "action":"edit", "quality":"high",
+             "size":"1024x1024", "background":"transparent", "partial_images":2,
+             "input_image_mask":{"image_url":"data:image/png;base64,AA=="}}
+        ]});
+        let tools: HostedModelTools = serde_json::from_value(input.clone()).unwrap();
+        let specs: Vec<crate::ToolSpec> = tools.tools.into_iter().map(Into::into).collect();
+        let mut expected = input["tools"].clone();
+        expected[0]
+            .as_object_mut()
+            .unwrap()
+            .remove("include_search_results");
+        assert_eq!(serde_json::to_value(&specs).unwrap(), expected);
+        assert!(
+            matches!(&specs[0], crate::ToolSpec::FileSearch(config) if config.include_search_results)
+        );
+        assert_eq!(
+            specs.iter().map(crate::ToolSpec::name).collect::<Vec<_>>(),
+            vec!["file_search", "code_interpreter", "image_generation"]
+        );
+    }
+
+    #[test]
+    fn hosted_container_accepts_existing_id_and_rejects_wrong_auto_discriminator() {
+        let existing: HostedToolSpec = serde_json::from_value(json!({
+            "type":"code_interpreter", "container":"cntr_test"
+        }))
+        .unwrap();
+        assert_eq!(
+            serde_json::to_value(existing).unwrap()["container"],
+            "cntr_test"
+        );
+        assert!(
+            serde_json::from_value::<HostedToolSpec>(json!({
+                "type":"code_interpreter", "container":{"type":"container_auto"}
+            }))
+            .is_err()
+        );
+    }
+}
