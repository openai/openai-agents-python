+/// Checks override names using the target's native environment-key identity.
+/// No process is started. POSIX names remain case-sensitive.
+#[doc(hidden)]
+pub fn env_override_names_are_distinct(
+    overrides: &HashMap<std::ffi::OsString, std::ffi::OsString>,
+) -> bool {
+    let mut names = std::process::Command::new("");
+    names.env_clear();
+    for name in overrides.keys() {
+        names.env(name, "");
+    }
+    names.get_envs().count() == overrides.len()
+}
