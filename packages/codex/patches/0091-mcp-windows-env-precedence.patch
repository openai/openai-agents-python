+/// Applies one ordered layer using the target's native environment-key identity.
+/// Duplicate validation is separate; shell policies may also merge unchecked layers.
+#[doc(hidden)]
+pub fn merge_env_overrides(
+    base: HashMap<std::ffi::OsString, std::ffi::OsString>,
+    overrides: HashMap<std::ffi::OsString, std::ffi::OsString>,
+) -> HashMap<std::ffi::OsString, std::ffi::OsString> {
+    let mut command = std::process::Command::new("");
+    command.env_clear().envs(base);
+    for (name, value) in overrides {
+        command.env_remove(&name).env(name, value);
+    }
+    command
+        .get_envs()
+        .filter_map(|(name, value)| value.map(|value| (name.to_os_string(), value.to_os_string())))
+        .collect()
 }
 
