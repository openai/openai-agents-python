+/// A fresh bearer can succeed after ordinary HTTP recovery.
+#[tokio::test]
+async fn authentication_recovery_rotates_http_credentials() -> anyhow::Result<()> {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(wiremock::matchers::header(
+            "authorization",
+            "Bearer synthetic-rotation-0",
+        ))
+        .respond_with(ResponseTemplate::new(401))
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(method("POST"))
+        .and(wiremock::matchers::header("authorization", "Bearer synthetic-rotation-1"))
+        .respond_with(ResponseTemplate::new(200)
+            .insert_header("content-type", "text/event-stream")
+            .set_body_string(concat!(
+                "data: {\"type\":\"response.created\",\"response\":{\"id\":\"recovered\"}}\n\n",
+                "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"recovered\"}}\n\n",
+            )))
+        .expect(1).mount(&server).await;
+    let (client, attempts) =
+        auth_recovery_model_client(format!("{}/v1", server.uri()), false, true);
+    let mut stream = auth_recovery_stream(&mut client.new_session()).await?;
+    let mut completed = false;
+    while let Some(event) = stream.next().await {
+        completed |= matches!(event?, ResponseEvent::Completed { .. });
+    }
+    assert!(completed);
+    assert_eq!(attempts.load(Ordering::Relaxed), 1);
+    assert_eq!(server.received_requests().await.unwrap().len(), 2);
+    Ok(())
+}
