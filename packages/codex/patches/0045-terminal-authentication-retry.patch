+/// Rejected handshakes negotiate HTTP without spending the sampling retry budget.
+/// Exercise both startup preconnect and ordinary generation connection owners.
+#[tokio::test]
+async fn rejected_websocket_auth_falls_back_and_preserves_final_http_failure() -> anyhow::Result<()>
+{
+    for preconnect in [false, true] {
+        for final_status in [401, 403] {
+            let server = MockServer::start().await;
+            Mock::given(method("GET"))
+                .and(path("/v1/responses"))
+                .respond_with(ResponseTemplate::new(401))
+                .expect(1)
+                .mount(&server)
+                .await;
+            let final_body = r#"{"error":{"message":"final HTTP rejection","code":"final_http_rejection","type":"invalid_request_error"}}"#;
+            Mock::given(method("POST"))
+                .and(path("/v1/responses"))
+                .respond_with(
+                    ResponseTemplate::new(final_status)
+                        .insert_header("content-type", "application/json")
+                        .insert_header("x-request-id", "final-http-request")
+                        .set_body_string(final_body),
+                )
+                .expect(1)
+                .mount(&server)
+                .await;
+            let mut provider =
+                ModelProviderInfo::create_openai_provider(Some(format!("{}/v1", server.uri())));
+            provider.requires_openai_auth = false;
+            provider.supports_websockets = true;
+            provider.request_max_retries = Some(0);
+            let mut client = test_model_client(SessionSource::Cli);
+            Arc::get_mut(&mut client.state)
+                .expect("test client should own unique state")
+                .provider = create_model_provider(provider, /*auth_manager*/ None);
+            let metadata = test_responses_metadata_for_client(
+                &client,
+                None,
+                format!("{}:0", client.state.thread_id),
+                None,
+                TestCodexResponsesRequestKind::Turn,
+            );
+            let mut session = client.new_session();
+            if preconnect {
+                session
+                    .preconnect_websocket(
+                        &test_model_info(),
+                        None,
+                        &test_session_telemetry(),
+                        &metadata,
+                    )
+                    .await?;
+                assert!(!client.responses_websocket_enabled());
+            }
+            let error = session
+                .stream(
+                    &Prompt::default(),
+                    &test_model_info(),
+                    &test_session_telemetry(),
+                    None,
+                    codex_protocol::config_types::ReasoningSummary::None,
+                    None,
+                    &metadata,
+                    &InferenceTraceContext::disabled(),
+                )
+                .await
+                .err()
+                .expect("the final HTTP request must fail");
+            let codex_protocol::error::CodexErrorDetails::UnexpectedStatus(details) =
+                error.details()
+            else {
+                panic!("final HTTP failure must remain structured");
+            };
+            assert_eq!(details.status.as_u16(), final_status);
+            assert_eq!(details.body, final_body);
+            assert_eq!(details.request_id.as_deref(), Some("final-http-request"));
+            assert!(!client.responses_websocket_enabled());
+            assert_eq!(server.received_requests().await.unwrap().len(), 2);
+        }
+    }
+    Ok(())
+}
