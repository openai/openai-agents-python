+/// A successful rotated WebSocket handshake still dispatches exactly one prompt.
+#[tokio::test]
+async fn authentication_recovery_rotates_websocket_credentials() -> anyhow::Result<()> {
+    use futures::SinkExt;
+    use tokio_tungstenite::tungstenite::Message;
+    use tokio_tungstenite::tungstenite::handshake::server::{Request, Response};
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+    let address = listener.local_addr()?;
+    let peer = tokio::spawn(async move {
+        for attempt in 0..2 {
+            let (socket, _) = listener.accept().await.unwrap();
+            let upgraded = tokio_tungstenite::accept_hdr_async(
+                socket,
+                move |request: &Request, response: Response| {
+                    assert_eq!(
+                        request
+                            .headers()
+                            .get("authorization")
+                            .unwrap()
+                            .to_str()
+                            .unwrap(),
+                        format!("Bearer synthetic-rotation-{attempt}")
+                    );
+                    if attempt == 0 {
+                        Err(http::Response::builder()
+                            .status(401)
+                            .body(Some("rejected".to_owned()))
+                            .unwrap())
+                    } else {
+                        Ok(response)
+                    }
+                },
+            )
+            .await;
+            if attempt == 0 {
+                assert!(upgraded.is_err());
+                continue;
+            }
+            let mut websocket = upgraded.unwrap();
+            let request = websocket.next().await.unwrap().unwrap();
+            let request: serde_json::Value =
+                serde_json::from_str(request.to_text().unwrap()).unwrap();
+            assert_eq!(request["type"], "response.create");
+            for event in [
+                json!({"type":"response.created","response":{"id":"recovered"}}),
+                json!({"type":"response.completed","response":{"id":"recovered"}}),
+            ] {
+                websocket
+                    .send(Message::Text(event.to_string().into()))
+                    .await
+                    .unwrap();
+            }
+        }
+    });
+    let (client, attempts) = auth_recovery_model_client(format!("http://{address}/v1"), true, true);
+    let mut stream = auth_recovery_stream(&mut client.new_session()).await?;
+    let mut completed = false;
+    while let Some(event) = stream.next().await {
+        completed |= matches!(event?, ResponseEvent::Completed { .. });
+    }
+    assert!(completed);
+    assert_eq!(attempts.load(Ordering::Relaxed), 1);
+    assert!(client.responses_websocket_enabled());
+    peer.await?;
+    Ok(())
+}
