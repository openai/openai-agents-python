+
+/// Once client authentication recovery has failed, the sampling owner returns
+/// the structured failure immediately instead of beginning another request attempt.
+#[tokio::test]
+async fn terminal_unauthorized_does_not_restart_sampling_or_discard_metadata() {
+    let (session, turn_context) = make_session_and_context().await;
+    let step_context = StepContext::for_test(Arc::new(turn_context));
+    let mut client_session = session.services.model_client.new_session();
+    let mut retry_state = ResponsesStreamRetryState::default();
+    let original = CodexErr::UnexpectedStatus(codex_protocol::error::UnexpectedResponseError {
+        status: http::StatusCode::UNAUTHORIZED,
+        body: r#"{"error":{"code":"invalid_api_key","message":"synthetic rejection"}}"#.to_owned(),
+        user_message: Some("synthetic rejection".to_owned()),
+        url: None,
+        cf_ray: None,
+        request_id: Some("synthetic-auth-request".to_owned()),
+        identity_authorization_error: None,
+        identity_error_code: None,
+    })
+    .with_retry_after(RetryAfter::from_delay(Duration::ZERO).expect("retry deadline"));
+    let returned = handle_response_stream_error(
+        &mut retry_state,
+        /*max_retries*/ 5,
+        original,
+        &mut client_session,
+        &session,
+        &step_context,
+        ResponsesStreamRequest::Sampling,
+    )
+    .await
+    .expect_err("terminal authentication must not retry sampling");
+    assert_eq!(retry_state.retries, 0);
+    let codex_protocol::error::CodexErrorDetails::UnexpectedStatus(details) = returned.details()
+    else {
+        panic!("original authentication details must remain available");
+    };
+    assert_eq!(details.status, http::StatusCode::UNAUTHORIZED);
+    assert_eq!(
+        details.request_id.as_deref(),
+        Some("synthetic-auth-request")
+    );
+    assert!(details.body.contains("invalid_api_key"));
+}
