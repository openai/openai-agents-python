+/// Only the request that attempted the rejected upgrade owns its spent recovery.
+#[tokio::test]
+async fn authentication_recovery_spans_fallback_but_not_preconnect_or_later_requests()
+-> anyhow::Result<()> {
+    for preconnect in [false, true] {
+        for status in [401, 403] {
+            let server = MockServer::start().await;
+            Mock::given(method("GET"))
+                .respond_with(ResponseTemplate::new(401))
+                .expect(2)
+                .mount(&server)
+                .await;
+            let http_attempts = if preconnect && status == 401 { 2 } else { 1 };
+            Mock::given(method("POST"))
+                .respond_with(
+                    ResponseTemplate::new(status)
+                        .insert_header("x-request-id", "final-http-request")
+                        .set_body_string("final HTTP rejection"),
+                )
+                .expect(http_attempts as u64)
+                .mount(&server)
+                .await;
+            let (client, attempts) =
+                auth_recovery_model_client(format!("{}/v1", server.uri()), true, true);
+            let metadata = test_responses_metadata_for_client(
+                &client,
+                None,
+                format!("{}:0", client.state.thread_id),
+                None,
+                TestCodexResponsesRequestKind::Turn,
+            );
+            let mut session = client.new_session();
+            if preconnect {
+                session
+                    .preconnect_websocket(
+                        &test_model_info(),
+                        None,
+                        &test_session_telemetry(),
+                        &metadata,
+                    )
+                    .await?;
+            }
+            let error = auth_recovery_stream(&mut session).await.err().unwrap();
+            let CodexErrorDetails::UnexpectedStatus(details) = error.details() else {
+                panic!("the final HTTP failure must remain structured");
+            };
+            assert_eq!(details.status.as_u16(), status);
+            assert_eq!(details.request_id.as_deref(), Some("final-http-request"));
+            assert!(error.retry_delay(1).is_none());
+            assert_eq!(
+                attempts.load(Ordering::Relaxed),
+                if preconnect && status == 401 { 2 } else { 1 }
+            );
+            assert_eq!(
+                server.received_requests().await.unwrap().len(),
+                2 + http_attempts
+            );
+        }
+    }
+
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .respond_with(ResponseTemplate::new(401))
+        .expect(2)
+        .mount(&server)
+        .await;
+    Mock::given(method("POST"))
+        .respond_with(ResponseTemplate::new(401))
+        .expect(3)
+        .mount(&server)
+        .await;
+    let (client, attempts) = auth_recovery_model_client(format!("{}/v1", server.uri()), true, true);
+    let mut session = client.new_session();
+    assert!(auth_recovery_stream(&mut session).await.is_err());
+    assert_eq!(attempts.load(Ordering::Relaxed), 1);
+    assert_eq!(server.received_requests().await.unwrap().len(), 3);
+    assert!(auth_recovery_stream(&mut session).await.is_err());
+    assert_eq!(attempts.load(Ordering::Relaxed), 2);
+    assert_eq!(server.received_requests().await.unwrap().len(), 5);
+    Ok(())
+}
