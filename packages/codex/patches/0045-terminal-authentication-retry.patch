+/// Recovery belongs to one model request, including its transport negotiation.
+/// Preconnect, warmup and later requests create independent recovery budgets.
+struct RequestAuthRecovery {
+    manager: Option<UnauthorizedRecovery>,
+    provider_attempted: bool,
+    pending_retry: PendingUnauthorizedRetry,
+}
+
+impl RequestAuthRecovery {
+    fn new(provider: &SharedModelProvider) -> Self {
+        Self {
+            manager: provider
+                .auth_manager()
+                .as_ref()
+                .map(AuthManager::unauthorized_recovery),
+            provider_attempted: false,
+            pending_retry: PendingUnauthorizedRetry::default(),
+        }
+    }
+}
