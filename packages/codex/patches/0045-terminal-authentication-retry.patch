+/// Terminal authentication keeps its details and cannot gain eligibility from advice.
+#[test]
+fn terminal_unauthorized_preserves_details_without_retry() {
+    for (status, expected_retry) in [
+        (StatusCode::UNAUTHORIZED, false),
+        (StatusCode::FORBIDDEN, true),
+        (StatusCode::TOO_MANY_REQUESTS, true),
+        (StatusCode::INTERNAL_SERVER_ERROR, true),
+        (StatusCode::SERVICE_UNAVAILABLE, true),
+    ] {
+        for advised in [false, true] {
+            let mut error = CodexErr::UnexpectedStatus(UnexpectedResponseError {
+                status,
+                body: r#"{"error":{"code":"invalid_api_key","message":"synthetic rejection"}}"#
+                    .to_owned(),
+                user_message: Some("synthetic rejection".to_owned()),
+                url: None,
+                cf_ray: None,
+                request_id: Some("synthetic-auth-request".to_owned()),
+                identity_authorization_error: None,
+                identity_error_code: None,
+            });
+            if advised {
+                error = error.with_retry_after(
+                    RetryAfter::from_delay(Duration::ZERO).expect("retry deadline"),
+                );
+            }
+            for attempt in [1, 5] {
+                assert_eq!(error.retry_delay(attempt).is_some(), expected_retry);
+            }
+
+            let CodexErrorDetails::UnexpectedStatus(details) = error.details() else {
+                panic!("authentication error details must remain structured");
+            };
+            assert_eq!(details.status, status);
+            assert_eq!(
+                details.request_id.as_deref(),
+                Some("synthetic-auth-request")
+            );
+            assert!(details.body.contains("invalid_api_key"));
+        }
+    }
+}
