+/// Cancellation drops the actual provider-recovery future before it can dispatch
+/// another authenticated request or switch a rejected WebSocket handshake to HTTP.
+#[tokio::test]
+async fn cancellation_during_auth_recovery_stops_provider_dispatch() -> anyhow::Result<()> {
+    use codex_async_utils::OrCancelExt;
+    use tokio_util::sync::CancellationToken;
+
+    for websockets in [false, true] {
+        let server = MockServer::start().await;
+        Mock::given(method(if websockets { "GET" } else { "POST" }))
+            .and(path("/v1/responses"))
+            .respond_with(ResponseTemplate::new(401))
+            .expect(1)
+            .mount(&server)
+            .await;
+        let started = Arc::new(Notify::new());
+        let release = Arc::new(Notify::new());
+        let attempts = Arc::new(AtomicUsize::new(0));
+        let mut info =
+            ModelProviderInfo::create_openai_provider(Some(format!("{}/v1", server.uri())));
+        info.requires_openai_auth = false;
+        info.supports_websockets = websockets;
+        info.request_max_retries = Some(0);
+        let provider: SharedModelProvider = Arc::new(TestRecoveryProvider {
+            inner: create_model_provider(info, /*auth_manager*/ None),
+            should_fail: false,
+            attempts: Arc::clone(&attempts),
+            recovery_gate: Some((Arc::clone(&started), Arc::clone(&release))),
+            rotate_keys: false,
+        });
+        let mut client = test_model_client(SessionSource::Cli);
+        Arc::get_mut(&mut client.state)
+            .expect("unique test client state")
+            .provider = provider;
+        let metadata = test_responses_metadata_for_client(
+            &client,
+            None,
+            format!("{}:0", client.state.thread_id),
+            None,
+            TestCodexResponsesRequestKind::Turn,
+        );
+        let mut session = client.new_session();
+        let prompt = Prompt::default();
+        let model_info = test_model_info();
+        let telemetry = test_session_telemetry();
+        let trace = InferenceTraceContext::disabled();
+        let cancellation = CancellationToken::new();
+        let outcome = {
+            let pending = session
+                .stream(
+                    &prompt,
+                    &model_info,
+                    &telemetry,
+                    None,
+                    codex_protocol::config_types::ReasoningSummary::None,
+                    None,
+                    &metadata,
+                    &trace,
+                )
+                .or_cancel(&cancellation);
+            tokio::pin!(pending);
+            tokio::select! {
+                _ = started.notified() => {}
+                _ = &mut pending => panic!("recovery must remain pending at its gate"),
+            }
+            assert_eq!(attempts.load(Ordering::Relaxed), 1);
+            cancellation.cancel();
+            pending.await
+        };
+        assert!(outcome.is_err(), "sampling cancellation must drop recovery");
+        release.notify_one();
+        tokio::task::yield_now().await;
+        assert_eq!(attempts.load(Ordering::Relaxed), 1);
+        assert_eq!(server.received_requests().await.unwrap().len(), 1);
+        assert_eq!(client.responses_websocket_enabled(), websockets);
+    }
+    Ok(())
+}
