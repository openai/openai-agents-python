+                strict: false,
+                output_schema: None,
+                name: "gate".into(),
+                description: "Host-owned gate".into(),
+                input_schema: json!({"type":"object","properties":{}}),
+                defer_loading: false,
+            })],
+            ..StartThreadOptions::new(test.config.clone())
+        })
+        .await?;
+    test.codex = thread.thread;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Perform two gated operations.".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let mut effects = Vec::new();
+    for expected in ["call_one", "call_two"] {
+        let event = wait_for_event(&test.codex, |event| {
+            matches!(
+                event,
+                EventMsg::DynamicToolCallRequest(_) | EventMsg::Error(_)
+            )
+        })
+        .await;
+        let EventMsg::DynamicToolCallRequest(call) = event else {
+            panic!("Native provider history sampling failed: {event:?}")
+        };
+        assert_eq!(call.call_id, expected);
+        effects.push(call.call_id.clone());
+        test.codex
+            .submit(Op::DynamicToolResponse {
+                id: call.call_id,
+                response: DynamicToolResponse {
+                    content_items: vec![DynamicToolCallOutputContentItem::InputText {
+                        text: expected.into(),
+                    }],
+                    success: true,
+                },
+            })
+            .await?;
+    }
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    assert_eq!(effects, ["call_one", "call_two"]);
+    let requests = server
+        .received_requests()
+        .await
+        .unwrap()
+        .into_iter()
+        .filter(|request| request.method.as_str() == "POST")
+        .map(|request| request.body_json::<serde_json::Value>().unwrap())
+        .collect::<Vec<_>>();
+    assert_eq!(requests.len(), 3);
+    for (index, anchor) in ["resp_external", "resp_one", "resp_two"].iter().enumerate() {
+        assert_eq!(requests[index]["previous_response_id"], *anchor);
+        assert_eq!(requests[index]["store"], true);
+    }
+    for (index, call) in [(1, "call_one"), (2, "call_two")] {
+        let body = &requests[index];
+        let input = body["input"].as_array().unwrap();
+        assert_eq!(
+            input.len(),
+            1,
+            "only the unsent result belongs on the wire: {body}"
+        );
+        assert_eq!(input[0]["type"], "function_call_output");
+        assert_eq!(input[0]["call_id"], call);
+    }
+    let reference = test
+        .codex
+        .thread_settings_snapshot()
+        .await
+        .provider_history
+        .unwrap();
+    assert_eq!(
+        reference.selection,
+        ProviderHistorySelection::PreviousResponse {
+            id: Some("resp_three".into())
+        }
+    );
+    assert!(!reference.pending);
+    test.codex.submit(Op::Shutdown).await?;
+    Ok(())
+}
+
+struct RejectAcceptedCheckpoint {
+    inner: OnceLock<LocalThreadStore>,
+    rejected: AtomicBool,
+}
+
+impl ThreadStore for RejectAcceptedCheckpoint {
+    fn as_any(&self) -> &dyn std::any::Any {
+        self
+    }
+    fn create_thread(&self, params: CreateThreadParams) -> ThreadStoreFuture<'_, ()> {
+        self.inner.get().unwrap().create_thread(params)
+    }
+    fn resume_thread(
+        &self,
+        params: ResumeThreadParams,
+    ) -> ThreadStoreFuture<'_, Arc<Vec<RolloutItem>>> {
+        self.inner.get().unwrap().resume_thread(params)
+    }
+    fn append_items(&self, params: AppendThreadItemsParams) -> ThreadStoreFuture<'_, ()> {
+        let acknowledged = params.items.iter().any(|item| {
+            let RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event)) = item else {
+                return false;
+            };
+            event
+                .thread_settings
+                .provider_history
+                .as_ref()
+                .is_some_and(|reference| {
+                    !reference.pending
+                        && reference.selection
+                            == (ProviderHistorySelection::PreviousResponse {
+                                id: Some("resp_accepted".into()),
+                            })
+                })
+        });
+        if acknowledged {
+            self.rejected.store(true, Ordering::SeqCst);
+            return Box::pin(async {
+                Err(ThreadStoreError::Internal {
+                    message: "synthetic accepted-checkpoint failure".into(),
+                })
+            });
+        }
+        self.inner.get().unwrap().append_items(params)
+    }
+    fn persist_thread(
+        &self,
+        thread_id: ThreadId,
+        context: PersistContext,
+    ) -> ThreadStoreFuture<'_, ()> {
+        self.inner.get().unwrap().persist_thread(thread_id, context)
+    }
+    fn flush_thread(&self, thread_id: ThreadId) -> ThreadStoreFuture<'_, ()> {
+        self.inner.get().unwrap().flush_thread(thread_id)
+    }
+    fn shutdown_thread(&self, thread_id: ThreadId) -> ThreadStoreFuture<'_, ()> {
+        self.inner.get().unwrap().shutdown_thread(thread_id)
+    }
+    fn discard_thread(&self, thread_id: ThreadId) -> ThreadStoreFuture<'_, ()> {
+        self.inner.get().unwrap().discard_thread(thread_id)
+    }
+    fn load_history(
+        &self,
+        params: LoadThreadHistoryParams,
+    ) -> ThreadStoreFuture<'_, StoredThreadHistory> {
+        self.inner.get().unwrap().load_history(params)
+    }
+    fn read_thread(&self, params: ReadThreadParams) -> ThreadStoreFuture<'_, StoredThread> {
+        self.inner.get().unwrap().read_thread(params)
+    }
+    fn read_thread_by_rollout_path(
+        &self,
+        params: ReadThreadByRolloutPathParams,
+    ) -> ThreadStoreFuture<'_, StoredThread> {
+        ThreadStore::read_thread_by_rollout_path(self.inner.get().unwrap(), params)
+    }
+    fn list_threads(&self, params: ListThreadsParams) -> ThreadStoreFuture<'_, ThreadPage> {
+        self.inner.get().unwrap().list_threads(params)
+    }
+    fn update_thread_metadata(
+        &self,
+        params: UpdateThreadMetadataParams,
+    ) -> ThreadStoreFuture<'_, Option<StoredThread>> {
+        self.inner.get().unwrap().update_thread_metadata(params)
+    }
+    fn archive_thread(&self, params: ArchiveThreadParams) -> ThreadStoreFuture<'_, ()> {
+        self.inner.get().unwrap().archive_thread(params)
+    }
+    fn unarchive_thread(&self, params: ArchiveThreadParams) -> ThreadStoreFuture<'_, StoredThread> {
+        self.inner.get().unwrap().unarchive_thread(params)
+    }
+    fn delete_thread(&self, params: DeleteThreadParams) -> ThreadStoreFuture<'_, ()> {
+        self.inner.get().unwrap().delete_thread(params)
+    }
+}
+
+#[tokio::test]
+async fn accepted_response_journal_failure_blocks_live_and_cold_replay() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    responses::mount_sse_once(
+        &server,
+        responses::sse(vec![
+            responses::ev_response_created("resp_accepted"),
+            responses::ev_assistant_message("accepted-answer", "Accepted."),
+            responses::ev_completed("resp_accepted"),
+        ]),
+    )
+    .await;
+    let store = Arc::new(RejectAcceptedCheckpoint {
+        inner: OnceLock::new(),
+        rejected: AtomicBool::new(false),
+    });
+    let configured_store = store.clone();
+    let mut builder = test_codex()
+        .with_config(move |config| {
+            config.sdk_provider_history =
+                Some(ProviderHistorySelection::PreviousResponse { id: None });
+            config.sdk_request_controls.store = Some(Some(true));
+            assert!(
+                configured_store
+                    .inner
+                    .set(LocalThreadStore::new(
+                        LocalThreadStoreConfig::from_config(config),
+                        None
+                    ))
+                    .is_ok()
+            );
+        })
+        .with_thread_store(store.clone());
+    let test = builder.build_with_auto_env(&server).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "One accepted response.".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let terminal = wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    assert!(
+        matches!(&terminal, EventMsg::TurnComplete(done) if done.error.is_some()),
+        "{terminal:?}"
+    );
+    assert!(store.rejected.load(Ordering::SeqCst));
+    let rollout = ThreadStore::read_thread(
+        store.inner.get().unwrap(),
+        ReadThreadParams {
+            thread_id: test.session_configured.thread_id,
+            include_archived: false,
+            include_history: false,
+        },
+    )
+    .await?
+    .rollout_path
+    .unwrap();
+    let live = test
+        .codex
+        .thread_settings_snapshot()
+        .await
+        .provider_history
+        .unwrap();
+    assert_eq!(
+        live.selection,
+        ProviderHistorySelection::PreviousResponse {
+            id: Some("resp_accepted".into())
+        }
+    );
+    assert!(
+        !live.pending,
+        "the live advance precedes the failed journal commit"
+    );
+    if test
+        .codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Never redispatch.".into(),
+            text_elements: vec![],
+        }]))
+        .await
+        .is_ok()
+    {
+        let terminal = wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        })
+        .await;
+        assert!(
+            matches!(&terminal, EventMsg::TurnComplete(done) if done.error.is_some()),
+            "{terminal:?}"
+        );
+    }
+    assert_eq!(server.received_requests().await.unwrap().len(), 1);
+    test.codex.submit(Op::Shutdown).await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::ShutdownComplete)
+    })
+    .await;
+    test.thread_manager
+        .remove_thread(&test.session_configured.thread_id)
+        .await;
+    drop(test.codex);
+    let mut config = test.config.clone();
+    config.sdk_provider_history = Some(ProviderHistorySelection::PreviousResponse {
+        id: Some("resp_accepted".into()),
+    });
+    let result = test
+        .thread_manager
+        .resume_legacy_thread_from_rollout(
+            config,
+            rollout,
+            test.thread_manager.auth_manager(),
+            None,
+            Default::default(),
+        )
+        .await;
+    let Err(error) = result else {
+        panic!("cold replay must require reconciliation after the failed journal commit")
+    };
+    assert!(error.to_string().contains("reconcil"), "{error}");
+    assert_eq!(server.received_requests().await.unwrap().len(), 1);
+    Ok(())
+}
