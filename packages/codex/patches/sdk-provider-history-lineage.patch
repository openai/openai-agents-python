+    /// Authenticated exact-anchor lookup, without generation or saved credentials.
+    pub async fn verify_history_anchor(
+        &self,
+        selection: &codex_protocol::provider_history::ProviderHistorySelection,
+        stored_response: Option<bool>,
+        headers: HeaderMap,
+    ) -> Result<(), ApiError> {
+        use codex_protocol::provider_history::ProviderHistorySelection;
+
+        let invalid = |message: &str| ApiError::InvalidRequest {
+            message: message.into(),
+        };
+        selection
+            .validate_shape()
+            .map_err(|message| invalid(&message))?;
+        let (resource, id) = match selection {
+            ProviderHistorySelection::Conversation { id } => ("conversations", id),
+            ProviderHistorySelection::PreviousResponse { id: Some(id) } => {
+                if stored_response == Some(false) {
+                    return Err(invalid(
+                        "Unstored provider history requires its live WebSocket owner",
+                    ));
+                }
+                ("responses", id)
+            }
+            ProviderHistorySelection::PreviousResponse { id: None } => {
+                return Err(invalid(
+                    "Cold provider history requires an exact response anchor",
+                ));
+            }
+        };
+        if id == "." || id == ".." {
+            return Err(invalid("Invalid provider history anchor"));
+        }
+        let mut path = url::Url::parse("https://provider-history.invalid/")
+            .expect("static provider history URL");
+        path.path_segments_mut()
+            .expect("hierarchical URL")
+            .push(resource)
+            .push(id);
+        let path = path.path().trim_start_matches('/');
+        let prepared = crate::prepare_request_transport(
+            &self.session.provider().url_for_path(path),
+            self.request_transport.as_ref(),
+        )?;
+        let response = self
+            .session
+            .execute_with(Method::GET, path, headers, None, |request| {
+                prepared.apply(request);
+                request.response_body_limit_bytes = Some(MAX_JSON_RESPONSE_BODY_BYTES);
+            })
+            .await?;
+        super::responses_json::check_json_structure(&response.body)?;
+        let body: Value = serde_json::from_slice(&response.body)
+            .map_err(|_| invalid("Invalid provider history anchor response"))?;
+        let valid = body.get("id").and_then(Value::as_str) == Some(id.as_str())
+            && if resource == "responses" {
+                body.get("status").and_then(Value::as_str) == Some("completed")
+            } else {
+                body.get("object").and_then(Value::as_str) == Some("conversation")
+            };
+        if !valid {
+            return Err(invalid(
+                "Provider history anchor is unconfirmed or mismatched",
+            ));
+        }
+        Ok(())
+    }
