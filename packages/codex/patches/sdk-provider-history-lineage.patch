+    output_sha256: Vec<String>,
+    admitted_calls: Vec<Option<ProviderCall>>,
+    wire_calls: Vec<Option<ProviderCall>>,
+    wire_output_sha256: Vec<Option<String>>,
+    mcp_rewrites: Vec<(usize, ProviderCall, ProviderCall)>,
+    attempt: Option<Weak<dyn codex_extension_api::ModelAttemptAdmission>>,
+    stored: bool,
