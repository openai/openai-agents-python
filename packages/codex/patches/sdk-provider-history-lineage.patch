@@ -0,0 +1,91 @@
+use codex_protocol::provider_history::ProviderHistorySelection;
+use serde_json::json;
+
+#[test]
+fn selection_preserves_opaque_ids_and_rejects_conflicting_shapes() {
+    let selected: ProviderHistorySelection = serde_json::from_value(json!({
+        "type": "conversation", "id": "custom-provider-conversation"
+    }))
+    .unwrap();
+    selected.validate_shape().unwrap();
+    assert_eq!(
+        serde_json::to_value(selected).unwrap(),
+        json!({"type": "conversation", "id": "custom-provider-conversation"})
+    );
+    assert!(
+        serde_json::from_value::<ProviderHistorySelection>(json!({
+            "type": "conversation", "id": "conv_current", "previous_response_id": "resp_other"
+        }))
+        .is_err()
+    );
+    assert!(
+        ProviderHistorySelection::PreviousResponse {
+            id: Some(" \t".into())
+        }
+        .validate_shape()
+        .is_err()
+    );
+    serde_json::from_value::<ProviderHistorySelection>(json!({"type":"previous_response"}))
+        .unwrap()
+        .validate_shape()
+        .unwrap();
+}
+
+#[test]
+fn acknowledged_occurrences_preserve_interleaved_unsent_tool_results() {
+    use codex_protocol::provider_history::ProviderHistoryWindowReceipt;
+
+    let digest = |value: &str| value.repeat(32);
+    let prefix = digest("00");
+    let call_a = digest("11");
+    let call_b = digest("22");
+    let result_a = digest("33");
+    let result_b = digest("44");
+    let user = digest("55");
+    let receipt = ProviderHistoryWindowReceipt {
+        input_len: 2,
+        input_sha256: prefix.clone(),
+        output_sha256: vec![call_a.clone(), call_b.clone()],
+    };
+    let receipt: ProviderHistoryWindowReceipt =
+        serde_json::from_value(serde_json::to_value(receipt).unwrap()).unwrap();
+    assert_eq!(
+        receipt
+            .unsent_input_indices(7, &prefix, &[call_a, result_a, call_b, result_b, user])
+            .unwrap(),
+        vec![3, 5, 6]
+    );
+}
+
+#[test]
+fn acknowledged_occurrences_reject_rewrites_missing_and_repeated_outputs() {
+    use codex_protocol::provider_history::ProviderHistoryWindowReceipt;
+
+    let digest = |value: &str| value.repeat(32);
+    let prefix = digest("00");
+    let a = digest("11");
+    let b = digest("22");
+    let receipt = ProviderHistoryWindowReceipt {
+        input_len: 1,
+        input_sha256: prefix.clone(),
+        output_sha256: vec![a.clone(), b.clone()],
+    };
+    for tail in [
+        vec![a.clone()],
+        vec![b.clone(), a.clone()],
+        vec![a.clone(), b.clone(), b.clone()],
+    ] {
+        assert!(
+            receipt
+                .unsent_input_indices(1 + tail.len(), &prefix, &tail)
+                .is_err()
+        );
+    }
+    assert!(
+        receipt
+            .unsent_input_indices(3, &digest("ff"), &[a.clone(), b.clone()])
+            .is_err()
+    );
+    assert!(receipt.unsent_input_indices(0, &prefix, &[]).is_err());
+    assert!(receipt.unsent_input_indices(4, &prefix, &[a, b]).is_err());
+}
