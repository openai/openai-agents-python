+#[tokio::test]
+async fn response_chain_advances_with_only_unsent_tool_results() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    Mock::given(method("GET"))
+        .and(path("/v1/responses/resp_external"))
+        .respond_with(
+            ResponseTemplate::new(200)
+                .set_body_json(json!({"id":"resp_external","status":"completed"})),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    // This provider owns the preceding calls through previous_response_id;
+    // the ordinary full-history mock requires those calls in every request.
+    let bodies = vec![
+        responses::sse(vec![
+            responses::ev_response_created("resp_one"),
+            responses::ev_function_call("call_one", "gate", "{}"),
+            responses::ev_completed("resp_one"),
+        ]),
+        responses::sse(vec![
+            responses::ev_response_created("resp_two"),
+            responses::ev_function_call("call_two", "gate", "{}"),
+            responses::ev_completed("resp_two"),
+        ]),
+        responses::sse(vec![
+            responses::ev_response_created("resp_three"),
+            responses::ev_assistant_message("answer", "Finished."),
+            responses::ev_completed("resp_three"),
+        ]),
+    ];
+    let next = std::sync::atomic::AtomicUsize::new(0);
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(move |_: &wiremock::Request| {
+            let index = next.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            ResponseTemplate::new(200)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(bodies[index].clone())
+        })
+        .expect(3)
+        .mount(&server)
+        .await;
+    let mut builder = test_codex().with_config(|config| {
+        config.sdk_provider_history = Some(ProviderHistorySelection::PreviousResponse {
+            id: Some("resp_external".into()),
+        });
+        config.sdk_request_controls.store = Some(Some(true));
+    });
+    let mut test = builder.build_with_auto_env(&server).await?;
+    let thread = test
+        .thread_manager
+        .start_thread(StartThreadOptions {
+            dynamic_tools: vec![DynamicToolSpec::Function(DynamicToolFunctionSpec {
+                strict: false,
+                output_schema: None,
+                name: "gate".into(),
+                description: "Host-owned gate".into(),
+                input_schema: json!({"type":"object","properties":{}}),
+                defer_loading: false,
+            })],
+            ..StartThreadOptions::new(test.config.clone())
+        })
+        .await?;
+    test.codex = thread.thread;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Perform two gated operations.".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let mut effects = Vec::new();
+    for expected in ["call_one", "call_two"] {
+        let event = wait_for_event(&test.codex, |event| {
+            matches!(
+                event,
+                EventMsg::DynamicToolCallRequest(_) | EventMsg::Error(_)
+            )
+        })
+        .await;
+        let EventMsg::DynamicToolCallRequest(call) = event else {
+            panic!("Native provider history sampling failed: {event:?}")
+        };
+        assert_eq!(call.call_id, expected);
+        effects.push(call.call_id.clone());
+        test.codex
+            .submit(Op::DynamicToolResponse {
+                id: call.call_id,
+                response: DynamicToolResponse {
+                    content_items: vec![DynamicToolCallOutputContentItem::InputText {
+                        text: expected.into(),
+                    }],
+                    success: true,
+                },
+            })
+            .await?;
+    }
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    assert_eq!(effects, ["call_one", "call_two"]);
+    let requests = server
+        .received_requests()
+        .await
+        .unwrap()
+        .into_iter()
+        .filter(|request| request.method.as_str() == "POST")
+        .map(|request| request.body_json::<serde_json::Value>().unwrap())
+        .collect::<Vec<_>>();
+    assert_eq!(requests.len(), 3);
+    for (index, anchor) in ["resp_external", "resp_one", "resp_two"].iter().enumerate() {
+        assert_eq!(requests[index]["previous_response_id"], *anchor);
+        assert_eq!(requests[index]["store"], true);
+    }
+    for (index, call) in [(1, "call_one"), (2, "call_two")] {
+        let body = &requests[index];
+        let input = body["input"].as_array().unwrap();
+        assert_eq!(
+            input.len(),
+            1,
+            "only the unsent result belongs on the wire: {body}"
+        );
+        assert_eq!(input[0]["type"], "function_call_output");
+        assert_eq!(input[0]["call_id"], call);
+    }
+    let reference = test
+        .codex
+        .thread_settings_snapshot()
+        .await
+        .provider_history
+        .unwrap();
+    assert_eq!(
+        reference.selection,
+        ProviderHistorySelection::PreviousResponse {
+            id: Some("resp_three".into())
+        }
+    );
+    assert!(!reference.pending);
+    test.codex.submit(Op::Shutdown).await?;
+    Ok(())
+}
