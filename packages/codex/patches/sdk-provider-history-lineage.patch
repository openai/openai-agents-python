+}
+
+#[derive(Debug)]
+struct State {
+    reference: ProviderHistoryReference,
+    live_scope: Option<Scope>,
+    pending: Option<Pending>,
+}
+
+pub(crate) struct McpRewriteAdmission(pub(crate) std::sync::Arc<Cursor>);
+
+#[derive(Debug)]
+pub(crate) struct Cursor {
+    state: StdMutex<State>,
+    session: OnceLock<Weak<crate::session::session::Session>>,
+}
+
+fn invalid(message: &str) -> CodexErr {
+    CodexErr::InvalidRequest(message.into())
+}
+
+fn route(base: &str) -> Result<String> {
+    let mut value = url::Url::parse(base).map_err(|_| invalid("Invalid provider history route"))?;
+    let _ = value.set_username("");
+    let _ = value.set_password(None);
+    value.set_query(None);
+    value.set_fragment(None);
+    Ok(value.to_string().trim_end_matches('/').to_owned())
+}
+
+fn item_digest(item: &ResponseItem) -> Result<[u8; 32]> {
+    let mut plain = item.clone();
+    plain.clear_internal_chat_message_metadata_passthrough();
+    let mut results = Vec::new();
+    if let Some(calls) = item
+        .executed_tool_call_metadata()
+        .and_then(|meta| meta.executed_tool_calls.as_ref())
+    {
+        for (index, call) in calls.iter().enumerate() {
+            let value = serde_json::to_value(call)?;
+            if let Some(metadata) = value.get("tool_result_metadata") {
+                results.push(serde_json::json!([
+                    index,
+                    call.name,
+                    call.arguments(),
+                    metadata
+                ]));
+            }
+        }
+    }
+    let mut value = serde_json::json!({"item": plain, "result_metadata": results});
+    value.sort_all_objects();
+    Ok(Sha256::digest(serde_json::to_vec(&value)?).into())
+}
+
+#[derive(Debug, PartialEq, Eq)]
+struct ProviderCall {
+    identity: String,
+    arguments: String,
+}
+
+fn provider_call(item: &ResponseItem) -> Option<ProviderCall> {
+    let (kind, call_id, name, namespace, input) = match item {
+        ResponseItem::FunctionCall {
+            call_id,
+            name,
+            namespace,
+            arguments,
+            ..
+        } => (
+            "function_call",
+            serde_json::json!(call_id),
+            serde_json::json!(name),
+            serde_json::json!(namespace),
+            match serde_json::from_str::<serde_json::Value>(arguments) {
+                Ok(value) => serde_json::json!(["json", value]),
+                Err(_) => serde_json::json!(["raw", arguments]),
+            },
+        ),
+        ResponseItem::CustomToolCall {
+            call_id,
+            name,
+            input,
+            ..
+        } => (
+            "custom_tool_call",
+            serde_json::json!(call_id),
+            serde_json::json!(name),
+            serde_json::Value::Null,
+            serde_json::json!(input),
+        ),
+        ResponseItem::ToolSearchCall {
+            call_id, arguments, ..
+        } => (
+            "tool_search_call",
+            serde_json::json!(call_id),
+            serde_json::Value::Null,
+            serde_json::Value::Null,
+            arguments.clone(),
+        ),
+        _ => return None,
+    };
+    // Search controls retain their existing exact argument requirement.
+    let mut identity = serde_json::json!([
+        kind,
+        call_id,
+        name,
+        namespace,
+        (kind == "tool_search_call").then_some(&input)
+    ]);
+    identity.sort_all_objects();
+    let mut value = input;
+    value.sort_all_objects();
+    Some(ProviderCall {
+        identity: hex(Sha256::digest(
+            serde_json::to_vec(&identity).expect("JSON call identity"),
+        )),
+        arguments: hex(Sha256::digest(
+            serde_json::to_vec(&value).expect("JSON call input"),
+        )),
+    })
+}
+
+fn hex(digest: impl AsRef<[u8]>) -> String {
+    digest
+        .as_ref()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+
+fn input_digest<'a>(items: impl IntoIterator<Item = &'a ResponseItem>) -> Result<String> {
+    let mut digest = Sha256::new();
+    digest.update(b"sdk-provider-history-input-v1\0");
+    for item in items {
+        digest.update(item_digest(item)?);
+    }
+    Ok(hex(digest.finalize()))
+}
+
+pub(crate) fn canonical_input_boundary(
+    items: &[ResponseItem],
+) -> Result<ProviderHistoryInputBoundary> {
+    Ok(ProviderHistoryInputBoundary {
+        input_len: items.len(),
+        input_sha256: input_digest(items)?,
+    })
+}
+
+pub(crate) fn canonical_input_projection(
+    items: &[ResponseItem],
+    wire_input_indices: Vec<usize>,
+    prefix_len: usize,
+) -> Result<codex_api::ProviderHistoryInputProjection> {
+    let hashes = items.iter().map(item_digest).collect::<Result<Vec<_>>>()?;
+    Ok(codex_api::ProviderHistoryInputProjection {
+        boundary: ProviderHistoryInputBoundary {
+            input_len: items.len(),
+            input_sha256: canonical_prefix_digest(&hashes),
+        },
+        item_sha256: hashes.clone(),
+        item_ids: items
+            .iter()
+            .map(|item| item.id().map(ToString::to_string))
+            .collect(),
+        sampling_item_sha256: hashes,
+        delivered_input_indices: (0..items.len()).collect(),
+        wire_input_indices,
+        prefix_len,
+    })
+}
+
+pub(crate) fn sampling_input_projection(
+    captured: Option<&codex_api::ProviderHistoryInputProjection>,
+    items: &[ResponseItem],
+    wire_input_indices: Vec<usize>,
+    prefix_len: usize,
+) -> Result<codex_api::ProviderHistoryInputProjection> {
+    let Some(captured) = captured else {
+        return canonical_input_projection(items, wire_input_indices, prefix_len);
+    };
+    let mut projection = captured.clone();
+    projection.sampling_item_sha256 = items.iter().map(item_digest).collect::<Result<Vec<_>>>()?;
+    projection.wire_input_indices = wire_input_indices;
+    projection.prefix_len = prefix_len;
+    projection.delivered_input_indices.clear();
+    if projection.sampling_item_sha256 == projection.item_sha256 {
+        projection
+            .delivered_input_indices
+            .extend(0..projection.item_sha256.len());
+        return Ok(projection);
+    }
+    let mut delivered = std::collections::HashSet::new();
+    for (item, digest) in items.iter().zip(&projection.sampling_item_sha256) {
+        let id = item.id().map(ToString::to_string);
+        let by_id = id
+            .as_ref()
+            .map(|id| {
+                projection
+                    .item_ids
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, candidate)| candidate.as_ref() == Some(id))
+                    .map(|(index, _)| index)
+                    .collect::<Vec<_>>()
+            })
+            .unwrap_or_default();
+        let index = match by_id.as_slice() {
+            [index] if !delivered.contains(index) => Some(*index),
+            [] => {
+                let matches = projection
+                    .item_sha256
+                    .iter()
+                    .enumerate()
+                    .filter(|(index, candidate)| *candidate == digest && !delivered.contains(index))
+                    .map(|(index, _)| index)
+                    .collect::<Vec<_>>();
+                match matches.as_slice() {
+                    [] => None,
+                    [index] => Some(*index),
+                    _ if item.id().is_none()
+                        && projection
+                            .item_sha256
+                            .iter()
+                            .filter(|candidate| *candidate == digest)
+                            .count()
+                            == projection
+                                .sampling_item_sha256
+                                .iter()
+                                .filter(|candidate| *candidate == digest)
+                                .count() =>
+                    {
+                        Some(matches[0])
+                    }
+                    _ => {
+                        return Err(invalid(
+                            "Provider history cannot associate an ambiguous sampling occurrence",
+                        ));
+                    }
+                }
+            }
+            _ => {
+                return Err(invalid(
+                    "Provider history contains a repeated sampling identity",
+                ));
+            }
+        };
+        if let Some(index) = index {
+            delivered.insert(index);
+        }
+    }
+    projection.delivered_input_indices.extend(delivered);
+    projection.delivered_input_indices.sort_unstable();
+    Ok(projection)
+}
+
+fn canonical_window(window: &ProviderHistoryWindowReceipt) -> Option<ProviderHistoryWindowReceipt> {
+    let boundary = window.canonical_input.as_ref()?;
+    Some(ProviderHistoryWindowReceipt {
+        canonical_input: None,
+        canonical_tail_sha256: None,
+        input_len: boundary.input_len,
+        input_sha256: boundary.input_sha256.clone(),
+        output_sha256: window
+            .canonical_tail_sha256
+            .as_ref()
+            .unwrap_or(&window.output_sha256)
+            .clone(),
+    })
+}
+
+fn unsent_hash_indices(
+    window: &ProviderHistoryWindowReceipt,
+    hashes: &[[u8; 32]],
+) -> Result<Vec<usize>> {
+    let prefix = hashes
+        .get(..window.input_len)
+        .ok_or_else(|| invalid("Provider history lost acknowledged canonical input"))?;
+    let tail = hashes[window.input_len..]
+        .iter()
+        .map(hex)
+        .collect::<Vec<_>>();
+    window
+        .unsent_input_indices(hashes.len(), &canonical_prefix_digest(prefix), &tail)
+        .map_err(CodexErr::InvalidRequest)
+}
+
+fn delivered_boundary(
+    projection: &codex_api::ProviderHistoryInputProjection,
+) -> Result<(ProviderHistoryInputBoundary, Option<Vec<String>>)> {
+    let delivered = projection
+        .delivered_input_indices
+        .iter()
+        .copied()
+        .collect::<std::collections::HashSet<_>>();
+    if delivered.len() != projection.delivered_input_indices.len()
+        || delivered
+            .iter()
+            .any(|index| *index >= projection.item_sha256.len())
+    {
+        return Err(invalid(
+            "Provider history has an invalid delivered occurrence map",
+        ));
+    }
+    let prefix_len = (0..projection.item_sha256.len())
+        .take_while(|index| delivered.contains(index))
+        .count();
+    let tail = (prefix_len < projection.item_sha256.len()).then(|| {
+        projection
+            .item_sha256
+            .iter()
+            .enumerate()
+            .skip(prefix_len)
+            .filter(|(index, _)| delivered.contains(index))
+            .map(|(_, digest)| hex(digest))
+            .collect()
+    });
+    Ok((
+        ProviderHistoryInputBoundary {
+            input_len: prefix_len,
+            input_sha256: canonical_prefix_digest(&projection.item_sha256[..prefix_len]),
+        },
+        tail,
+    ))
+}
+
+fn canonical_prefix_digest(items: &[[u8; 32]]) -> String {
+    let mut digest = Sha256::new();
+    digest.update(b"sdk-provider-history-input-v1\0");
+    for item in items {
+        digest.update(item);
+    }
+    hex(digest.finalize())
+}
+
+pub(crate) fn definitive_pre_stream_rejection(error: &codex_api::ApiError) -> bool {
+    let status = match error {
+        codex_api::ApiError::Api { status, .. }
+        | codex_api::ApiError::Transport(codex_client::TransportError::Http { status, .. }) => {
+            status.as_u16()
+        }
+        _ => return false,
+    };
+    matches!(
+        status,
+        400 | 401 | 403 | 404 | 405 | 410 | 413 | 415 | 422 | 429
+    )
+}
+
+impl Cursor {
+    pub(crate) fn new(start: Start) -> Self {
+        Self {
+            state: StdMutex::new(State {
+                reference: start.reference.unwrap_or(ProviderHistoryReference {
+                    selection: start.selection,
+                    provider_route: String::new(),
+                    window: None,
+                    pending: false,
+                    stored_response: None,
+                }),
+                live_scope: None,
+                pending: None,
+            }),
+            session: OnceLock::new(),
+        }
+    }
+
+    pub(crate) fn attach(&self, session: Weak<crate::session::session::Session>) {
+        let _ = self.session.set(session);
+    }
+    pub(crate) fn snapshot(&self) -> ProviderHistoryReference {
+        self.state.lock().unwrap().reference.clone()
+    }
+    pub(crate) fn selection(&self) -> ProviderHistorySelection {
+        self.snapshot().selection
+    }
+
+    async fn persist(&self) -> Result<()> {
+        let session = self
+            .session
+            .get()
+            .and_then(Weak::upgrade)
+            .ok_or_else(|| invalid("Provider history has no live Session owner"))?;
+        session
+            .checkpoint_thread_settings()
+            .await
+            .map_err(|error| CodexErr::Fatal(error.to_string()))
+    }
+
+    pub(crate) async fn prepare(
+        &self,
+        request: &mut ResponsesApiRequest,
+        setup: &CurrentClientSetup,
+        transport: ReqwestTransport,
+        headers: HeaderMap,
+        request_transport: Option<&codex_protocol::model_request_transport::RequestTransportOverrides>,
+        attempt: Option<std::sync::Arc<dyn codex_extension_api::ModelAttemptAdmission>>,
+    ) -> Result<Option<Vec<ResponseItem>>> {
+        let canonical_input = request
+            .request_controls
+            .canonical_history_input
+            .take()
+            .ok_or_else(|| invalid("Provider history has no admitted canonical input"))?;
+        let mut auth_headers = setup.api_provider.headers.clone();
+        setup.api_auth.add_auth_headers(&mut auth_headers);
+        let mut effective_url = setup.api_provider.url_for_path("/responses");
+        let prepared = codex_api::prepare_request_transport(&effective_url, request_transport)
+            .map_err(self_error)?;
+        prepared.apply_parts(&mut effective_url, &mut auth_headers);
+        let scope = Scope {
+            generation: setup.auth_owner_generation,
+            revision: setup.auth_revision,
+            headers: auth_headers,
+            effective_url,
+        };
+        let current_route = route(&setup.api_provider.base_url)?;
+        let (saved, needs_read) = {
+            let state = self.state.lock().unwrap();
+            if state.reference.pending {
+                return Err(invalid(
+                    "Provider history dispatch requires reconciliation before reuse",
+                ));
+            }
+            if !state.reference.provider_route.is_empty()
+                && state.reference.provider_route != current_route
+            {
+                return Err(invalid(
+                    "Provider history belongs to a different provider route",
+                ));
+            }
+            (
+                state.reference.clone(),
+                state.live_scope.as_ref() != Some(&scope),
+            )
+        };
+        let full_len = request.input.len();
+        let full_digest = input_digest(&request.input)?;
+        let unsent = if let Some(window) = &saved.window {
+            let canonical = if let Some(canonical) = canonical_window(window) {
+                if canonical_input.prefix_len + canonical_input.wire_input_indices.len() != full_len
+                    || canonical_input.item_sha256.len() != canonical_input.boundary.input_len
+                    || canonical_input.item_ids.len() != canonical_input.item_sha256.len()
+                    || canonical_input
+                        .wire_input_indices
+                        .iter()
+                        .any(|index| *index >= canonical_input.sampling_item_sha256.len())
+                {
+                    return Err(invalid(
+                        "Provider history has an invalid current input projection",
+                    ));
+                }
+                // Persisted canonical history stays independently bound even when
+                // the approved wire view uses a stable replacement.
+                unsent_hash_indices(&canonical, &canonical_input.item_sha256)?;
+                Some(canonical)
+            } else {
+                None
+            };
+            let unchanged_wire_prefix = request
+                .input
+                .get(..window.input_len)
+                .map(input_digest)
+                .transpose()?
+                .is_some_and(|digest| digest == window.input_sha256);
+            let wire_unsent = (|| -> Result<Vec<usize>> {
+                let prefix = request
+                    .input
+                    .get(..window.input_len)
+                    .ok_or_else(|| invalid("Provider history lost acknowledged input"))?;
+                let tail = request.input[window.input_len..]
+                    .iter()
+                    .map(item_digest)
+                    .map(|digest| digest.map(hex))
+                    .collect::<Result<Vec<_>>>()?;
+                window
+                    .unsent_input_indices(full_len, &input_digest(prefix)?, &tail)
+                    .map_err(CodexErr::InvalidRequest)
+            })();
+            if unchanged_wire_prefix && wire_unsent.is_ok() {
+                Some(wire_unsent?)
+            } else if unchanged_wire_prefix
+                && canonical.is_some()
+                && window.canonical_tail_sha256.is_some()
+            {
+                // The same delivered input can coexist with a locally admitted
+                // MCP output. Prove the input and output projections separately.
+                let mut outputs = canonical.expect("checked canonical receipt");
+                let first = outputs
+                    .output_sha256
+                    .len()
+                    .checked_sub(window.output_sha256.len())
+                    .ok_or_else(|| {
+                        invalid("Provider history has an incomplete canonical output")
+                    })?;
+                outputs.output_sha256 = outputs.output_sha256[first..].to_vec();
+                outputs.input_len = 0;
+                outputs.input_sha256 = canonical_prefix_digest(&[]);
+                let mapped = canonical_input
+                    .wire_input_indices
+                    .iter()
+                    .enumerate()
+                    .map(|(offset, source)| (canonical_input.prefix_len + offset, *source))
+                    .filter(|(wire, _)| *wire >= window.input_len)
+                    .collect::<Vec<_>>();
+                let hashes = mapped
+                    .iter()
+                    .map(|(_, source)| canonical_input.sampling_item_sha256[*source])
+                    .collect::<Vec<_>>();
+                let unsent = unsent_hash_indices(&outputs, &hashes)?;
+                let mut indices =
+                    (window.input_len..canonical_input.prefix_len).collect::<Vec<_>>();
+                indices.extend(unsent.into_iter().map(|index| mapped[index].0));
+                Some(indices)
+            } else if let Some(canonical) = canonical {
+                let unsent =
+                    unsent_hash_indices(&canonical, &canonical_input.sampling_item_sha256)?
+                        .into_iter()
+                        .collect::<std::collections::HashSet<_>>();
+                let mut indices = if unchanged_wire_prefix {
+                    Vec::new()
+                } else {
+                    (0..canonical_input.prefix_len).collect::<Vec<_>>()
+                };
+                indices.extend(
+                    canonical_input
+                        .wire_input_indices
+                        .iter()
+                        .enumerate()
+                        .filter(|(_, index)| unsent.contains(*index))
+                        .map(|(offset, _)| canonical_input.prefix_len + offset),
+                );
+                Some(indices)
+            } else {
+                Some(wire_unsent?)
+            }
+        } else {
+            None
+        };
+        let (delivered_input, delivered_tail) = delivered_boundary(&canonical_input)?;
+        if needs_read
+            && !matches!(
+                saved.selection,
+                ProviderHistorySelection::PreviousResponse { id: None }
+            )
+        {
+            ApiResponsesClient::new(
+                transport,
+                setup.api_provider.clone(),
+                setup.api_auth.clone(),
+            )
+            .with_request_transport(request_transport.cloned())
+            .verify_history_anchor(&saved.selection, saved.stored_response, headers)
+            .await
+            .map_err(|error| self_error(error))?;
+        }
+        {
+            let mut state = self.state.lock().unwrap();
+            if state.reference.pending {
+                return Err(invalid("Provider history already has an active dispatch"));
+            }
+            state.reference.provider_route = current_route;
+            state.reference.pending = true;
+            state.pending = Some(Pending {
+                canonical_input: delivered_input,
+                canonical_tail_sha256: delivered_tail,
+                input_len: full_len,
+                input_sha256: full_digest,
+                output_sha256: Vec::new(),
+                admitted_calls: Vec::new(),
+                wire_calls: Vec::new(),
+                wire_output_sha256: Vec::new(),
+                mcp_rewrites: Vec::new(),
+                attempt: attempt.as_ref().map(std::sync::Arc::downgrade),
+                stored: request.store,
+                scope,
+            });
+        }
+        self.persist().await?;
+        let logical = unsent.map(|indices| {
+            let full = std::mem::take(&mut request.input);
+            request.input = indices
+                .into_iter()
+                .map(|index| full[index].clone())
+                .collect();
+            full
+        });
+        request.request_controls.provider_history = Some(saved.selection);
+        Ok(logical)
+    }
+
+    pub(crate) fn validate_replacement(
+        &self,
+        current: &[&ResponseItem],
+        items: &[&ResponseItem],
+    ) -> Result<()> {
+        let state = self.state.lock().unwrap();
+        let refused = || invalid("Cannot replace acknowledged provider history input or output");
+        if state.reference.pending {
+            return Err(refused());
+        }
+        let Some(window) = &state.reference.window else {
+            return Ok(());
+        };
+        let Some(boundary) = &window.canonical_input else {
+            // Older wire-only receipts cannot prove a shorter canonical boundary.
+            // Retaining the entire current projection or appending is still safe.
+            let prefix = items.get(..current.len()).ok_or_else(refused)?;
+            if input_digest(current.iter().copied())? != input_digest(prefix.iter().copied())? {
+                return Err(refused());
+            }
+            return Ok(());
+        };
+        let prefix = items.get(..boundary.input_len).ok_or_else(refused)?;
+        let tail = items[boundary.input_len..]
+            .iter()
+            .map(|item| item_digest(item).map(hex))
+            .collect::<Result<Vec<_>>>()?;
+        let canonical = ProviderHistoryWindowReceipt {
+            input_len: boundary.input_len,
+            input_sha256: boundary.input_sha256.clone(),
+            output_sha256: window
+                .canonical_tail_sha256
+                .as_ref()
+                .unwrap_or(&window.output_sha256)
+                .clone(),
+            canonical_input: None,
+            canonical_tail_sha256: None,
+        };
+        canonical
+            .unsent_input_indices(items.len(), &input_digest(prefix.iter().copied())?, &tail)
+            .map_err(|_| refused())?;
+        Ok(())
+    }
+
+    pub(crate) fn admit_mcp_argument_rewrite(
+        &self,
+        original: &ResponseItem,
+        replacement: &ResponseItem,
+        attempt: &std::sync::Arc<dyn codex_extension_api::ModelAttemptAdmission>,
+    ) -> std::result::Result<(), String> {
+        let before = provider_call(original).ok_or("Missing original MCP call")?;
+        let after = provider_call(replacement).ok_or("Missing replacement MCP call")?;
+        if before.identity != after.identity || before == after {
+            return Err("MCP argument rewrite changed its call identity".into());
+        }
+        let mut state = self.state.lock().unwrap();
+        let pending = state
+            .pending
+            .as_mut()
+            .ok_or("Missing pending provider dispatch")?;
+        if attempt.cancellation().is_cancelled()
+            || !pending
+                .attempt
+                .as_ref()
+                .is_some_and(|pending| pending.ptr_eq(&std::sync::Arc::downgrade(attempt)))
+        {
+            return Err("MCP argument rewrite has no matching live attempt".into());
+        }
+        let digest = hex(item_digest(original).map_err(|error| error.to_string())?);
+        // Interceptors may defer an overlapping item. Its complete raw identity,
+        // not the most recently polled stream item, locates its occurrence.
+        let mut matches = pending
+            .wire_calls
+            .iter()
+            .enumerate()
+            .filter(|(index, call)| {
+                call.as_ref() == Some(&before)
+                    && pending
+                        .wire_output_sha256
+                        .get(*index)
+                        .and_then(Option::as_ref)
+                        == Some(&digest)
+                    && !pending
+                        .mcp_rewrites
+                        .iter()
+                        .any(|(occurrence, _, _)| occurrence == index)
+            })
+            .map(|(index, _)| index);
+        let index = matches
+            .next()
+            .ok_or("Missing original MCP provider occurrence")?;
+        if matches.next().is_some() {
+            return Err("Ambiguous MCP provider occurrence".into());
+        }
+        pending.mcp_rewrites.push((index, before, after));
+        Ok(())
+    }
+
+    pub(crate) fn observe_wire_output(&self, item: &ResponseItem) {
+        if let Some(pending) = self.state.lock().unwrap().pending.as_mut() {
+            pending.wire_calls.push(provider_call(item));
+            pending
+                .wire_output_sha256
+                .push(item_digest(item).ok().map(hex));
+        }
+    }
+
+    pub(crate) fn observe_output(&self, item: &ResponseItem) -> Result<()> {
+        let digest = hex(item_digest(item)?);
+        let mut state = self.state.lock().unwrap();
+        let pending = state
+            .pending
+            .as_mut()
+            .ok_or_else(|| invalid("Provider history has no admitted dispatch"))?;
+        // Native output admission assigns missing item IDs. Keep the exact item
+        // entering history, rather than its earlier unannotated transport copy.
+        pending.output_sha256.push(digest);
+        pending.admitted_calls.push(provider_call(item));
+        Ok(())
+    }
+
+    pub(crate) async fn accept(&self, response: LastResponse) -> Result<()> {
+        if response.response_id.is_empty() {
+            return Err(invalid(
+                "Provider history requires a completed response identity",
+            ));
+        }
+        {
+            let mut state = self.state.lock().unwrap();
+            if state
+                .pending
+                .as_ref()
+                .is_none_or(|pending| pending.output_sha256.len() != response.items_added.len())
+            {
+                return Err(invalid("Provider history output admission is incomplete"));
+            }
+            let pending = state.pending.as_ref().expect("checked pending admission");
+            let mut rewritten = false;
+            for (index, (admitted, wire)) in pending
+                .admitted_calls
+                .iter()
+                .zip(&pending.wire_calls)
+                .enumerate()
+            {
+                if admitted == wire {
+                    continue;
+                }
+                if !pending
+                    .mcp_rewrites
+                    .iter()
+                    .any(|(occurrence, original, replacement)| {
+                        *occurrence == index
+                            && wire.as_ref() == Some(original)
+                            && admitted.as_ref() == Some(replacement)
+                    })
+                {
+                    return Err(invalid(
+                        "Provider history cannot acknowledge unproven tool arguments",
+                    ));
+                }
+                rewritten = true;
+            }
+            if pending.admitted_calls.len() != pending.wire_calls.len() {
+                return Err(invalid("Provider history output admission is incomplete"));
+            }
+            let wire_output = if rewritten {
+                pending
+                    .wire_output_sha256
+                    .iter()
+                    .cloned()
+                    .collect::<Option<Vec<_>>>()
+                    .filter(|items| items.len() == pending.output_sha256.len())
+                    .ok_or_else(|| {
+                        invalid("Provider history wire output admission is incomplete")
+                    })?
+            } else {
+                Vec::new()
+            };
+            let pending = state
+                .pending
+                .take()
+                .ok_or_else(|| invalid("Provider history has no admitted dispatch"))?;
+            if let ProviderHistorySelection::PreviousResponse { id } =
+                &mut state.reference.selection
+            {
+                *id = Some(response.response_id);
+            }
+            let mut canonical_tail_sha256 = pending.canonical_tail_sha256;
+            if rewritten && canonical_tail_sha256.is_none() {
+                canonical_tail_sha256 = Some(Vec::new());
+            }
+            if let Some(tail) = &mut canonical_tail_sha256 {
+                tail.extend(pending.output_sha256.iter().cloned());
+            }
+            state.reference.window = Some(ProviderHistoryWindowReceipt {
+                canonical_input: Some(pending.canonical_input),
+                canonical_tail_sha256,
+                input_len: pending.input_len,
+                input_sha256: pending.input_sha256,
+                // Keep remote output distinct from the approved local view.
+                output_sha256: if rewritten {
+                    wire_output
+                } else {
+                    pending.output_sha256
+                },
+            });
+            state.reference.stored_response = Some(pending.stored);
+            state.reference.pending = false;
+            state.live_scope = Some(pending.scope);
+        }
+        self.persist().await
+    }
+
+    pub(crate) async fn reject_pre_stream(&self) -> Result<()> {
+        {
+            let mut state = self.state.lock().unwrap();
+            state.pending = None;
+            state.reference.pending = false;
+        }
+        self.persist().await
+    }
+}
+
+fn self_error(error: codex_api::ApiError) -> CodexErr {
+    invalid(&format!(
+        "Provider history anchor validation failed: {error}"
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn call(kind: &str, input: &str) -> ResponseItem {
+        serde_json::from_value(serde_json::json!({
+            "type": kind, "id": "provider-initial", "name": "effect", "call_id": "call", "arguments": input,
+            "input": input,
+        }))
+        .expect("fixture call")
+    }
+
+    #[test]
+    fn function_arguments_compare_json_values_and_ignore_item_ids() {
+        let first = call("function_call", r#"{"a":1,"b":{"x":2}}"#);
+        let mut same = call("function_call", " { \"b\": {\"x\":2}, \"a\":1 } ");
+        same.set_id(None);
+        assert_eq!(provider_call(&first), provider_call(&same));
+        assert_ne!(
+            provider_call(&first),
+            provider_call(&call("function_call", r#"{"a":2}"#))
+        );
+    }
+
+    #[test]
+    fn malformed_raw_arguments_do_not_equal_a_valid_json_string() {
+        assert_ne!(
+            provider_call(&call("function_call", "text")),
+            provider_call(&call("function_call", r#""text""#))
+        );
+    }
+
+    #[test]
+    fn custom_call_input_keeps_exact_raw_text() {
+        assert_ne!(
+            provider_call(&call("custom_tool_call", "text")),
+            provider_call(&call("custom_tool_call", " text"))
+        );
+    }
+
+    fn input_message(id: &str, text: &str) -> ResponseItem {
+        serde_json::from_value(serde_json::json!({
+            "type":"message", "id":id, "role":"user",
+            "content":[{"type":"input_text","text":text}]
+        }))
+        .unwrap()
+    }
+
+    #[test]
+    fn sampling_append_and_same_identity_replacement_keep_canonical_boundary() {
+        let original = vec![input_message("msg_original", "original")];
+        let captured = canonical_input_projection(&original, vec![], 0).unwrap();
+        for sample in [
+            vec![
+                original[0].clone(),
+                input_message("msg_reference", "reference"),
+            ],
+            vec![input_message("msg_original", "replacement")],
+        ] {
+            let projected =
+                sampling_input_projection(Some(&captured), &sample, (0..sample.len()).collect(), 0)
+                    .unwrap();
+            let (boundary, tail) = delivered_boundary(&projected).unwrap();
+            assert_eq!(boundary, captured.boundary);
+            assert!(tail.is_none());
+            assert_eq!(projected.delivered_input_indices, vec![0]);
+        }
+    }
+
+    #[test]
+    fn sampling_omission_retains_pending_original_between_acknowledged_occurrences() {
+        let original = vec![
+            input_message("msg_a", "a"),
+            input_message("msg_b", "b"),
+            input_message("msg_c", "c"),
+        ];
+        let captured = canonical_input_projection(&original, vec![], 0).unwrap();
+        let sample = vec![original[0].clone(), original[2].clone()];
+        let projected = sampling_input_projection(Some(&captured), &sample, vec![0, 1], 0).unwrap();
+        let (boundary, mut tail) = delivered_boundary(&projected).unwrap();
+        assert_eq!(boundary.input_len, 1);
+        let output = input_message("msg_output", "output");
+        tail.as_mut()
+            .unwrap()
+            .push(hex(item_digest(&output).unwrap()));
+        let window = ProviderHistoryWindowReceipt {
+            canonical_input: Some(boundary),
+            canonical_tail_sha256: tail,
+            input_len: 2,
+            input_sha256: input_digest(&sample).unwrap(),
+            output_sha256: vec![hex(item_digest(&output).unwrap())],
+        };
+        let mut current = original;
+        current.push(output);
+        let hashes = current
+            .iter()
+            .map(item_digest)
+            .collect::<Result<Vec<_>>>()
+            .unwrap();
+        assert_eq!(
+            unsent_hash_indices(&canonical_window(&window).unwrap(), &hashes).unwrap(),
+            vec![1]
+        );
+        current[1] = input_message("msg_b", "still pending and editable");
+        let hashes = current
+            .iter()
+            .map(item_digest)
+            .collect::<Result<Vec<_>>>()
+            .unwrap();
+        assert_eq!(
+            unsent_hash_indices(&canonical_window(&window).unwrap(), &hashes).unwrap(),
+            vec![1]
+        );
+    }
+
+    #[test]
+    fn sampling_cannot_rewrite_acknowledged_input() {
+        let original = vec![input_message("msg_a", "a")];
+        let boundary = canonical_input_boundary(&original).unwrap();
+        let window = ProviderHistoryWindowReceipt {
+            canonical_input: Some(boundary.clone()),
+            canonical_tail_sha256: None,
+            input_len: 1,
+            input_sha256: boundary.input_sha256,
+            output_sha256: vec![],
+        };
+        let changed = vec![input_message("msg_a", "changed")];
+        let hashes = changed
+            .iter()
+            .map(item_digest)
+            .collect::<Result<Vec<_>>>()
+            .unwrap();
+        assert!(unsent_hash_indices(&canonical_window(&window).unwrap(), &hashes).is_err());
+    }
+
+
+    #[test]
+    fn full_idless_group_retains_source_ordinals_after_prefix_insertion_and_reordering() {
+        let same: ResponseItem = serde_json::from_value(
+            serde_json::json!({"type":"item_reference","id":"provider_item"}),
+        )
+        .unwrap();
+        let other = input_message("msg_other", "other");
+        let original = vec![same.clone(), other.clone(), same.clone()];
+        let captured = canonical_input_projection(&original, vec![], 0).unwrap();
+        let sample = vec![
+            input_message("msg_new", "new"),
+            same.clone(),
+            same.clone(),
+            other.clone(),
+        ];
+        let projected =
+            sampling_input_projection(Some(&captured), &sample, vec![0, 1, 2, 3], 0).unwrap();
+        assert_eq!(projected.delivered_input_indices, vec![0, 1, 2]);
+        assert!(sampling_input_projection(Some(&captured), &[same, other], vec![0, 1], 0).is_err());
+    }
+
+}
