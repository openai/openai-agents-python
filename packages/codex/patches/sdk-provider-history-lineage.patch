+#[tokio::test]
+async fn cold_response_lookup_rejects_unfinished_anchors() {
+    use wiremock::matchers::{method, path};
+    use wiremock::{Mock, MockServer, ResponseTemplate};
+    let server = MockServer::start().await;
+    let client = history_client(&server, "Bearer current-account");
+    let selection = ProviderHistorySelection::PreviousResponse {
+        id: Some("resp_anchor".into()),
+    };
+    for status in ["in_progress", "incomplete"] {
+        let _reply = Mock::given(method("GET"))
+            .and(path("/responses/resp_anchor"))
+            .respond_with(
+                ResponseTemplate::new(200)
+                    .set_body_json(json!({"id":"resp_anchor","status":status})),
+            )
+            .expect(1)
+            .mount_as_scoped(&server)
+            .await;
+        assert!(
+            client
+                .verify_history_anchor(&selection, Some(true), http::HeaderMap::new())
+                .await
+                .is_err()
+        );
+    }
+    assert_eq!(server.received_requests().await.unwrap().len(), 2);
+}
