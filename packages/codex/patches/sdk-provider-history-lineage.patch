index 0000000000000000000000000000000000000000..85849f5df6de865942cc12adcf5f7f1f1c3a725e
--- /dev/null
+++ b/codex-rs/protocol/src/provider_history.rs
@@ -0,0 +1,117 @@
+//! Session-scoped provider history data; live provider authority stays external.
+
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+use ts_rs::TS;
+
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+#[serde(tag = "type", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ProviderHistorySelection {
+    Conversation {
+        id: String,
+    },
+    PreviousResponse {
+        /// An omitted initial ID for a new automatic response chain.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        #[ts(optional)]
+        id: Option<String>,
+    },
+}
+
+impl ProviderHistorySelection {
+    pub fn validate_shape(&self) -> Result<(), String> {
+        let id = match self {
+            Self::Conversation { id } => Some(id),
+            Self::PreviousResponse { id } => id.as_ref(),
+        };
+        if id.is_some_and(|id| id.trim().is_empty()) {
+            return Err("Empty provider history ID".into());
+        }
+        Ok(())
+    }
+}
+
+/// Data-only occurrence receipt, without live provider or callback authority.
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ProviderHistoryWindowReceipt {
+    pub input_len: usize,
+    pub input_sha256: String,
+    pub output_sha256: Vec<String>,
+}
+
+impl ProviderHistoryWindowReceipt {
+    /// Input occurrences outside the acknowledged prefix and ordered response output.
+    pub fn unsent_input_indices(
+        &self,
+        current_input_len: usize,
+        current_prefix_sha256: &str,
+        tail_sha256: &[String],
+    ) -> Result<Vec<usize>, String> {
+        let valid_digest = |digest: &str| {
+            digest.len() == 64
+                && digest
+                    .bytes()
+                    .all(|byte| matches!(byte, b'0'..=b'9' | b'a'..=b'f'))
+        };
+        if !valid_digest(&self.input_sha256)
+            || self
+                .output_sha256
+                .iter()
+                .any(|digest| !valid_digest(digest))
+            || tail_sha256.iter().any(|digest| !valid_digest(digest))
+            || current_input_len.checked_sub(self.input_len) != Some(tail_sha256.len())
+            || self.input_sha256 != current_prefix_sha256
+        {
+            return Err("Provider history no longer matches its acknowledged input".into());
+        }
+        let acknowledged = self
+            .output_sha256
+            .iter()
+            .map(String::as_str)
+            .collect::<std::collections::HashSet<_>>();
+        let mut next_output = 0;
+        let mut unsent = Vec::new();
+        for (index, digest) in tail_sha256.iter().enumerate() {
+            if self.output_sha256.get(next_output) == Some(digest) {
+                next_output += 1;
+            } else if acknowledged.contains(digest.as_str()) {
+                return Err(
+                    "Provider history contains reordered or repeated acknowledged output".into(),
+                );
+            } else {
+                unsent.push(self.input_len + index);
+            }
+        }
+        if next_output != self.output_sha256.len() {
+            return Err("Provider history is missing acknowledged output".into());
+        }
+        Ok(unsent)
+    }
+}
+
+/// Portable reference data; only a current declaration supplies provider authority.
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ProviderHistoryReference {
+    pub selection: ProviderHistorySelection,
+    pub provider_route: String,
+    pub window: Option<ProviderHistoryWindowReceipt>,
+    pub pending: bool,
+    pub stored_response: Option<bool>,
+}
+
+impl ProviderHistoryReference {
+    pub fn validate_rebind(&self, current: &ProviderHistorySelection) -> Result<(), String> {
+        self.selection.validate_shape()?;
+        current.validate_shape()?;
+        if self.pending {
+            return Err("Provider history dispatch requires reconciliation before reuse".into());
+        }
+        if &self.selection != current {
+            return Err("Restored provider history requires its exact current anchor declaration".into());
+        }
+        Ok(())
+    }
+}
