+fn serialize_provider_history<S>(
+    history: &Option<codex_protocol::provider_history::ProviderHistorySelection>,
+    serializer: S,
+) -> Result<S::Ok, S::Error>
+where
+    S: serde::Serializer,
+{
+    use codex_protocol::provider_history::ProviderHistorySelection;
+    use serde::ser::SerializeMap;
+
+    let mut map = serializer.serialize_map(None)?;
+    match history {
+        Some(ProviderHistorySelection::Conversation { id }) => {
+            map.serialize_entry("conversation", id)?;
+        }
+        Some(ProviderHistorySelection::PreviousResponse { id: Some(id) }) => {
+            map.serialize_entry("previous_response_id", id)?;
+        }
+        Some(ProviderHistorySelection::PreviousResponse { id: None }) | None => {}
+    }
+    map.end()
+}
