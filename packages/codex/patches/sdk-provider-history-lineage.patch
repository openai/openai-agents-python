+#[tokio::test]
+async fn cold_resume_requires_current_anchor_and_only_sends_new_input() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    Mock::given(method("GET"))
+        .and(path("/v1/responses/resp_before"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "id": "resp_before", "status": "completed"
+        })))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let bodies = ["resp_before", "resp_after"].map(|id| {
+        responses::sse(vec![
+            responses::ev_response_created(id),
+            responses::ev_assistant_message(id, "Done."),
+            responses::ev_completed(id),
+        ])
+    });
+    let next = std::sync::atomic::AtomicUsize::new(0);
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(move |_: &wiremock::Request| {
+            let index = next.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            ResponseTemplate::new(200)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(bodies[index].clone())
+        })
+        .expect(2)
+        .mount(&server)
+        .await;
+    let mut builder = test_codex().with_config(|config| {
+        config.sdk_provider_history = Some(ProviderHistorySelection::PreviousResponse { id: None });
+        config.sdk_request_controls.store = Some(Some(true));
+    });
+    let test = builder.build_with_auto_env(&server).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Before reopen.".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let terminal = wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_) | EventMsg::Error(_))
+    })
+    .await;
+    assert!(
+        matches!(terminal, EventMsg::TurnComplete(_)),
+        "{terminal:?}"
+    );
+    let rollout = test.codex.rollout_path().unwrap();
+    test.codex.submit(Op::Shutdown).await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::ShutdownComplete)
+    })
+    .await;
+    test.thread_manager
+        .remove_thread(&test.session_configured.thread_id)
+        .await;
+    drop(test.codex);
+    for selection in [
+        None,
+        Some(ProviderHistorySelection::PreviousResponse {
+            id: Some("resp_wrong".into()),
+        }),
+    ] {
+        let mut config = test.config.clone();
+        config.sdk_provider_history = selection;
+        let result = test
+            .thread_manager
+            .resume_legacy_thread_from_rollout(
+                config,
+                rollout.clone(),
+                test.thread_manager.auth_manager(),
+                None,
+                Default::default(),
+            )
+            .await;
+        assert!(
+            result.is_err(),
+            "saved data must require the current exact anchor"
+        );
+        assert_eq!(server.received_requests().await.unwrap().len(), 1);
+    }
+    let mut config = test.config.clone();
+    config.sdk_provider_history = Some(ProviderHistorySelection::PreviousResponse {
+        id: Some("resp_before".into()),
+    });
+    let resumed = test
+        .thread_manager
+        .resume_legacy_thread_from_rollout(
+            config,
+            rollout,
+            test.thread_manager.auth_manager(),
+            None,
+            Default::default(),
+        )
+        .await?;
+    resumed
+        .thread
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "After reopen.".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let terminal = wait_for_event(&resumed.thread, |event| {
+        matches!(event, EventMsg::TurnComplete(_) | EventMsg::Error(_))
+    })
+    .await;
+    assert!(
+        matches!(terminal, EventMsg::TurnComplete(_)),
+        "{terminal:?}"
+    );
+    let requests = server.received_requests().await.unwrap();
+    let post = requests
+        .iter()
+        .filter(|request| request.method.as_str() == "POST")
+        .collect::<Vec<_>>();
+    assert_eq!(post.len(), 2);
+    let body: serde_json::Value = post[1].body_json()?;
+    assert_eq!(body["previous_response_id"], "resp_before");
+    let input = body["input"].as_array().unwrap();
+    assert_eq!(input.len(), 1, "{body}");
+    assert_eq!(input[0]["role"], "user");
+    assert_eq!(input[0]["content"][0]["text"], "After reopen.");
+    let reference = resumed
+        .thread
+        .thread_settings_snapshot()
+        .await
+        .provider_history
+        .unwrap();
+    assert!(!reference.pending);
+    assert_eq!(
+        reference.selection,
+        ProviderHistorySelection::PreviousResponse {
+            id: Some("resp_after".into())
+        }
+    );
+    resumed.thread.submit(Op::Shutdown).await?;
+    Ok(())
+}
