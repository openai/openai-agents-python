+use codex_api::ResponseCreateWsRequest;
+use codex_api::ResponsesApiRequest;
+use codex_api::ResponsesRequestControls;
+use codex_protocol::provider_history::ProviderHistorySelection;
+use serde_json::json;
+
+#[test]
+fn history_selection_projects_one_wire_member_without_changing_storage() {
+    let mut request = ResponsesApiRequest {
+        model: "fixture-model".to_owned().into(),
+        stream: true,
+        service_tier: None,
+        input: Vec::new(),
+        tools: None,
+        tool_choice: Some("auto".into()),
+        request_controls: ResponsesRequestControls::default(),
+        parallel_tool_calls: Some(false),
+        reasoning: None,
+        store: false,
+        stream_options: None,
+        include: Vec::new(),
+        prompt_cache_key: None,
+        text: None,
+        client_metadata: None,
+        access_programs: None,
+    };
+    for (selection, key, value) in [
+        (
+            ProviderHistorySelection::Conversation {
+                id: "conv_external".into(),
+            },
+            "conversation",
+            "conv_external",
+        ),
+        (
+            ProviderHistorySelection::PreviousResponse {
+                id: Some("resp_external".into()),
+            },
+            "previous_response_id",
+            "resp_external",
+        ),
+    ] {
+        request.request_controls.provider_history = Some(selection);
+        for wire in [
+            serde_json::to_value(&request).unwrap(),
+            serde_json::to_value(ResponseCreateWsRequest::from(&request)).unwrap(),
+        ] {
+            assert_eq!(wire[key], value);
+            let other = if key == "conversation" {
+                "previous_response_id"
+            } else {
+                "conversation"
+            };
+            assert!(wire.get(other).is_none());
+            assert_eq!(wire["store"], false);
+            assert!(wire.get("type").is_none());
+            assert!(wire.get("provider_history").is_none());
+        }
+    }
+    request.request_controls.provider_history =
+        Some(ProviderHistorySelection::PreviousResponse { id: None });
+    let wire = serde_json::to_value(&request).unwrap();
+    assert!(wire.get("previous_response_id").is_none());
+    assert!(wire.get("conversation").is_none());
+    assert_eq!(wire["input"], json!([]));
+    assert_eq!(wire["store"], false);
+}
