+#[tokio::test]
+async fn cold_anchor_lookup_uses_current_account_without_generation() {
+    use wiremock::matchers::{header, method, path};
+    use wiremock::{Mock, MockServer, ResponseTemplate};
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/responses/resp_anchor"))
+        .and(header("authorization", "Bearer current-account"))
+        .respond_with(
+            ResponseTemplate::new(200)
+                .set_body_json(json!({"id":"resp_anchor","status":"completed"})),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(method("GET"))
+        .and(path("/responses/resp_anchor"))
+        .and(header("authorization", "Bearer wrong-account"))
+        .respond_with(ResponseTemplate::new(403))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let selected = ProviderHistorySelection::PreviousResponse {
+        id: Some("resp_anchor".into()),
+    };
+    history_client(&server, "Bearer current-account")
+        .verify_history_anchor(&selected, Some(true), http::HeaderMap::new())
+        .await
+        .unwrap();
+    assert!(
+        history_client(&server, "Bearer wrong-account")
+            .verify_history_anchor(&selected, Some(true), http::HeaderMap::new())
+            .await
+            .is_err()
+    );
+    let requests = server.received_requests().await.unwrap();
+    assert_eq!(requests.len(), 2);
+    assert!(
+        requests
+            .iter()
+            .all(|request| request.method == http::Method::GET)
+    );
+}
+
+#[tokio::test]
+async fn cold_anchor_lookup_rejects_unstored_and_missing_socket_anchors() {
+    let server = wiremock::MockServer::start().await;
+    let client = history_client(&server, "Bearer current-account");
+    for (id, stored) in [(Some("resp_socket".into()), Some(false)), (None, None)] {
+        assert!(
+            client
+                .verify_history_anchor(
+                    &ProviderHistorySelection::PreviousResponse { id },
+                    stored,
+                    http::HeaderMap::new()
+                )
+                .await
+                .is_err()
+        );
+    }
+    assert!(server.received_requests().await.unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn cold_conversation_lookup_confirms_only_the_exact_subject() {
+    use wiremock::matchers::{method, path};
+    use wiremock::{Mock, MockServer, ResponseTemplate};
+    let server = MockServer::start().await;
+    let client = history_client(&server, "Bearer current-account");
+    let selection = ProviderHistorySelection::Conversation {
+        id: "conv_anchor".into(),
+    };
+    for (body, accepted) in [
+        (json!({"id":"conv_anchor","object":"conversation"}), true),
+        (json!({"id":"conv_other","object":"conversation"}), false),
+        (json!({"id":"conv_anchor","object":"response"}), false),
+    ] {
+        let _reply = Mock::given(method("GET"))
+            .and(path("/conversations/conv_anchor"))
+            .respond_with(ResponseTemplate::new(200).set_body_json(body))
+            .expect(1)
+            .mount_as_scoped(&server)
+            .await;
+        assert_eq!(
+            client
+                .verify_history_anchor(&selection, None, http::HeaderMap::new())
+                .await
+                .is_ok(),
+            accepted
+        );
+    }
+    let requests = server.received_requests().await.unwrap();
+    assert_eq!(requests.len(), 3);
+    assert!(
+        requests
+            .iter()
+            .all(|request| request.method == http::Method::GET)
+    );
+}
