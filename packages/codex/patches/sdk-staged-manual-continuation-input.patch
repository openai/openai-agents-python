+/// Native-owned marker for one discarded recovery preparation, not a sampling admission.
+/// The capture owner closes every clone before returning or dropping its future.
+#[derive(Clone)]
+pub struct StagedInputPreparation {
+    turn_id: String,
+    active: Arc<AtomicBool>,
+}
+
+impl StagedInputPreparation {
+    pub fn new(turn_id: String) -> Self {
+        Self {
+            turn_id,
+            active: Arc::new(AtomicBool::new(true)),
+        }
+    }
+
+    pub fn is_for(&self, turn_id: &str) -> bool {
+        self.turn_id == turn_id && self.active.load(Ordering::Acquire)
+    }
+
+    pub fn finish(&self) {
+        self.active.store(false, Ordering::Release);
+    }
+}
+
+/// Application input staged on a portable manual checkpoint.
+#[derive(Clone)]
+pub struct StagedInputBatch {
+    turn_id: String,
+    items: Arc<[ResponseItem]>,
+    admitted: Arc<AtomicBool>,
+}
+
+impl StagedInputBatch {
+    pub fn new(turn_id: String, items: Vec<ResponseItem>) -> Self {
+        Self {
+            turn_id,
+            items: items.into(),
+            admitted: Arc::new(AtomicBool::new(false)),
+        }
+    }
+
+    pub fn items_for(&self, turn_id: &str) -> Option<&[ResponseItem]> {
+        (self.turn_id == turn_id && self.is_pending()).then_some(self.items.as_ref())
+    }
+
+    pub fn is_pending(&self) -> bool {
+        !self.items.is_empty() && !self.admitted.load(Ordering::Acquire)
+    }
+
+    pub fn acknowledge(&self) {
+        self.admitted.store(true, Ordering::Release);
+    }
+}
+
+/// Core publishes this view only after the next sampling agent has been selected.
+pub struct SelectedStagedInput(pub Arc<StagedInputBatch>);
