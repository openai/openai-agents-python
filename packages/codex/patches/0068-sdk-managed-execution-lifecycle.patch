index 0000000000000000000000000000000000000000..bcd8b12192ca85577abc4e70d391efc6eccf3d10
--- /dev/null
+++ b/codex-rs/core/src/config/execution.rs
@@ -0,0 +1,372 @@
+//! Cold admission for resolved, file-free managed execution configuration.
+//!
+//! The ordinary loader owns resolution. This token checks its captured inputs
+//! and capability ceiling without retaining configuration or ambient authority.
+
+use super::Config;
+use codex_config::{ConfigLayerSource, ConfigRequirementsToml};
+use codex_features::Feature;
+use std::ffi::OsString;
+
+/// A checked opening ceiling. SDK callers still bind fresh tool declarations.
+#[derive(Clone, Debug)]
+pub struct ManagedExecution {
+    _private: (),
+}
+
+/// Proof that ordinary cold resolution admitted the managed execution ceiling.
+pub struct ExecutionConfig {
+    profile: ManagedExecution,
+}
+
+/// Opaque ambient inputs captured before ordinary cold configuration loading.
+#[derive(PartialEq, Eq)]
+pub struct ExecutionAmbientInputs(Vec<Option<OsString>>);
+
+// These values affect cold resolution, including unused built-in OSS providers.
+// Credential values are resolved by fresh AuthManager/request owners, not stored here.
+const AMBIENT: &[&str] = &[
+    "HOME",
+    "USERPROFILE",
+    "HOMEDRIVE",
+    "HOMEPATH",
+    "TMPDIR",
+    "TMP",
+    "TEMP",
+    "CODEX_OSS_PORT",
+    "CODEX_OSS_BASE_URL",
+];
+
+fn ambient() -> ExecutionAmbientInputs {
+    ExecutionAmbientInputs(AMBIENT.iter().map(std::env::var_os).collect())
+}
+
+impl ExecutionConfig {
+    pub fn ambient_inputs() -> ExecutionAmbientInputs {
+        ambient()
+    }
+
+    pub fn try_new(config: Config, inputs: ExecutionAmbientInputs) -> Result<Self, Config> {
+        if ambient() != inputs || Self::ineligibility(&config).is_some() {
+            return Err(config);
+        }
+        Ok(Self {
+            profile: ManagedExecution { _private: () },
+        })
+    }
+
+    pub fn profile(&self) -> ManagedExecution {
+        self.profile.clone()
+    }
+
+    /// A diagnostic reason contains no input values or credential material.
+    pub fn ineligibility(config: &Config) -> Option<&'static str> {
+        if !cfg!(target_os = "linux") {
+            return Some("managed execution currently requires Linux");
+        }
+        if config.config_layer_stack.cloud_config_binding().is_some()
+            || config.config_layer_stack.requirements_toml() != &ConfigRequirementsToml::default()
+            || !config
+                .config_layer_stack
+                .ignore_user_and_project_exec_policy_rules()
+        {
+            return Some("managed execution requires empty isolated requirements");
+        }
+        if !Self::capabilities_eligible(config) {
+            return Some("managed execution has host capabilities");
+        }
+        if config.explicit_permission_profile_mode
+            || !config.custom_permission_profiles.is_empty()
+            || config.workspace_roots_explicit
+            || config.permissions.network.is_some()
+            || config.active_project.trust_level.is_some()
+            || config.model_catalog.is_some()
+            || !config.startup_warnings.is_empty()
+        {
+            return Some("managed execution has non-template policy or model inputs");
+        }
+        if config.model_provider.experimental_bearer_token.is_some()
+            || config.model_provider.auth.is_some()
+            || config.model_provider.gateway_oauth.is_some()
+            || config.model_provider.aws.is_some()
+        {
+            return Some("managed execution requires freshly bound API-key authority");
+        }
+        for layer in config.config_layer_stack.all_layers_low_to_high() {
+            if layer.is_disabled() {
+                return Some("managed execution has disabled layers");
+            }
+            match &layer.name {
+                ConfigLayerSource::PackagedDefaults { .. } => {}
+                ConfigLayerSource::System { .. }
+                | ConfigLayerSource::User { profile: None, .. }
+                    if layer.config.as_table().is_some_and(|t| t.is_empty()) => {}
+                ConfigLayerSource::SessionFlags if supported_flags(&layer.config) => {}
+                _ => return Some("managed execution has unsupported configuration sources"),
+            }
+        }
+        // A configured absolute policy path must not retain the previous private home.
+        for entry in config
+            .permissions
+            .permission_profile()
+            .file_system_sandbox_policy()
+            .entries
+        {
+            if let codex_protocol::permissions::FileSystemPath::Path { path } = entry.path
+                && let Ok(path) = path.to_abs_path()
+                && (path.as_path().starts_with(config.codex_home.as_path())
+                    || path.as_path().starts_with(config.cwd.as_path()))
+            {
+                return Some("managed execution has conversation-relative policy paths");
+            }
+        }
+        None
+    }
+
+    pub(crate) fn capabilities_eligible(config: &Config) -> bool {
+        !config.include_environment_context
+            && !config.include_permissions_instructions
+            && !config.agents_enabled
+            && config.mcp_servers.get().is_empty()
+            && config.project_doc_max_bytes == 0
+            && !config.bundled_skills_enabled()
+            && config.features.enabled(Feature::SkipHostSkillDiscovery)
+            && !config.features.enabled(Feature::CodeMode)
+            && !config.features.enabled(Feature::MemoryTool)
+            && !config.features.enabled(Feature::Goals)
+            && !config.update_plan_enabled
+            && config.web_search_mode.value()
+                == codex_protocol::config_types::WebSearchMode::Disabled
+    }
+}
+
+impl ManagedExecution {
+    pub(crate) fn accepts(&self, config: &Config) -> bool {
+        ExecutionConfig::capabilities_eligible(config)
+    }
+}
+
+fn supported_flags(value: &toml::Value) -> bool {
+    let Some(table) = value.as_table() else {
+        return false;
+    };
+    table.iter().all(|(key, value)| match key.as_str() {
+        "model"
+        | "model_provider"
+        | "openai_base_url"
+        | "model_reasoning_effort"
+        | "model_reasoning_summary"
+        | "model_verbosity"
+        | "service_tier"
+        | "include_environment_context"
+        | "include_permissions_instructions"
+        | "project_doc_max_bytes"
+        | "web_search" => true,
+        "model_providers" => value.as_table().is_some_and(|providers| {
+            providers.values().all(|provider| {
+                only_keys(
+                    provider,
+                    &[
+                        "name",
+                        "base_url",
+                        "wire_api",
+                        "requires_openai_auth",
+                        "supports_websockets",
+                        "supports_standalone_web_search",
+                        "env_key",
+                        "env_http_headers",
+                    ],
+                )
+            })
+        }),
+        "otel" => {
+            only_keys(
+                value,
+                &[
+                    "exporter",
+                    "log_user_prompt",
+                    "log_agent_responses",
+                    "tool_result",
+                ],
+            ) && value.get("exporter").and_then(toml::Value::as_str) == Some("none")
+                && value.get("log_user_prompt").and_then(toml::Value::as_bool) == Some(false)
+                && value
+                    .get("log_agent_responses")
+                    .and_then(toml::Value::as_bool)
+                    == Some(false)
+                && value.get("tool_result").is_some_and(|v| {
+                    only_keys(v, &["max_bytes"])
+                        && v.get("max_bytes").and_then(toml::Value::as_integer) == Some(0)
+                })
+        }
+        "mcp_servers" => value.as_table().is_some_and(|v| v.is_empty()),
+        "agents" => only_keys(value, &["enabled"]),
+        "analytics" => only_keys(value, &["enabled"]),
+        "skills" => {
+            only_keys(value, &["bundled"])
+                && value
+                    .get("bundled")
+                    .is_some_and(|v| only_keys(v, &["enabled"]))
+        }
+        "tools" => {
+            only_keys(value, &["update_plan"])
+                && value
+                    .get("update_plan")
+                    .is_some_and(|v| only_keys(v, &["enabled"]))
+        }
+        "features" => {
+            only_keys(
+                value,
+                &[
+                    "skip_host_skill_discovery",
+                    "shell_snapshot",
+                    "api_key_model_discovery",
+                    "goals",
+                    "non_prefixed_mcp_tool_names",
+                    "code_mode",
+                    "code_mode_interrupt",
+                    "standalone_web_search",
+                ],
+            ) && value.get("code_mode").is_none_or(|v| {
+                v.is_bool() || only_keys(v, &["enabled", "direct_only_tool_namespaces"])
+            })
+        }
+        _ => false,
+    })
+}
+
+fn only_keys(value: &toml::Value, keys: &[&str]) -> bool {
+    value
+        .as_table()
+        .is_some_and(|table| table.keys().all(|key| keys.contains(&key.as_str())))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::config::{ConfigBuilder, ConfigOverrides, LoaderOverrides};
+
+    async fn resolve(root: &std::path::Path, file_input: bool) -> Config {
+        let home = root.join("home");
+        let cwd = home.join("workspace");
+        std::fs::create_dir_all(&cwd).unwrap();
+        let absent = root.join("absent-sources");
+        let loader = LoaderOverrides {
+            managed_config_path: Some(absent.join("managed_config_path")),
+            system_config_path: Some(absent.join("system_config_path")),
+            system_requirements_path: Some(absent.join("system_requirements_path")),
+            ignore_user_config: true,
+            ignore_project_config: true,
+            ignore_user_and_project_exec_policy_rules: true,
+            ignore_managed_requirements: true,
+            ignore_login_requirements: true,
+            ..Default::default()
+        };
+        let flags: toml::Value = toml::from_str(
+            r#"
+model = "gpt-5.2"
+model_provider = "native_agent"
+include_environment_context = false
+include_permissions_instructions = false
+project_doc_max_bytes = 0
+web_search = "disabled"
+[model_providers.native_agent]
+name = "Synthetic test provider"
+base_url = "http://127.0.0.1:9/v1"
+wire_api = "responses"
+requires_openai_auth = true
+supports_websockets = false
+supports_standalone_web_search = false
+[agents]
+enabled = false
+[mcp_servers]
+[features]
+skip_host_skill_discovery = true
+shell_snapshot = false
+api_key_model_discovery = false
+goals = false
+code_mode = false
+[tools.update_plan]
+enabled = false
+[skills.bundled]
+enabled = false
+[analytics]
+enabled = false
+[otel]
+exporter = "none"
+log_user_prompt = false
+log_agent_responses = false
+[otel.tool_result]
+max_bytes = 0
+"#,
+        )
+        .unwrap();
+        let mut overrides: Vec<_> = flags.as_table().unwrap().clone().into_iter().collect();
+        if file_input {
+            overrides.push((
+                "log_dir".into(),
+                toml::Value::String("/tmp/execution-test-log".into()),
+            ));
+        }
+        ConfigBuilder::default()
+            .codex_home(home)
+            .cli_overrides(overrides)
+            .loader_overrides(loader)
+            .harness_overrides(ConfigOverrides {
+                cwd: Some(cwd),
+                base_instructions: Some("Synthetic base instructions".into()),
+                ..Default::default()
+            })
+            .build()
+            .await
+            .unwrap()
+    }
+
+    #[cfg(target_os = "linux")]
+    #[tokio::test]
+    async fn ordinary_managed_shape_is_admitted_and_later_capabilities_are_checked() {
+        let root = tempfile::tempdir().unwrap();
+        let inputs = ExecutionConfig::ambient_inputs();
+        let config = resolve(root.path(), false).await;
+        assert_eq!(ExecutionConfig::ineligibility(&config), None);
+        let admission = ExecutionConfig::try_new(config.clone(), inputs)
+            .unwrap_or_else(|_| panic!("ordinary managed shape rejected"));
+        let profile = admission.profile();
+        assert!(profile.accepts(&config));
+        let mut changed = config;
+        changed.include_environment_context = true;
+        assert!(!profile.accepts(&changed));
+    }
+
+    #[cfg(target_os = "linux")]
+    #[tokio::test]
+    async fn unsupported_file_input_and_changed_ambient_snapshot_are_rejected() {
+        let root = tempfile::tempdir().unwrap();
+        let config = resolve(root.path(), true).await;
+        assert_eq!(
+            ExecutionConfig::ineligibility(&config),
+            Some("managed execution has unsupported configuration sources")
+        );
+        assert!(ExecutionConfig::try_new(config, ExecutionConfig::ambient_inputs()).is_err());
+        let config = resolve(root.path(), false).await;
+        let original = config.clone();
+        // A different snapshot cannot authorize reuse; no process environment is mutated.
+        let rejected = ExecutionConfig::try_new(config, ExecutionAmbientInputs(Vec::new()));
+        match rejected {
+            Err(config) => assert_eq!(config, original),
+            Ok(_) => panic!("changed ambient snapshot admitted"),
+        }
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    #[tokio::test]
+    async fn unsupported_platform_uses_the_ordinary_path() {
+        let root = tempfile::tempdir().unwrap();
+        let config = resolve(root.path(), false).await;
+        assert_eq!(
+            ExecutionConfig::ineligibility(&config),
+            Some("managed execution currently requires Linux")
+        );
+        assert!(ExecutionConfig::try_new(config, ExecutionConfig::ambient_inputs()).is_err());
+    }
+}
