@@ -0,0 +1,101 @@
+//! One-shot canonical initial publication using the first real sampling context.
+use super::session::Session;
+use super::step_context::StepContext;
+use super::turn_context::TurnContext;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use futures::future::BoxFuture;
+use std::sync::Arc;
+use tokio::sync::Mutex;
+use tokio_util::sync::CancellationToken;
+
+type Commit = Arc<dyn Fn() -> BoxFuture<'static, anyhow::Result<()>> + Send + Sync>;
+
+/// A staged publication for an eligible fresh managed conversation.
+///
+/// The callback confirms receipts and updates the SDK publication owner only after
+/// Core's canonical durability barrier. A failed or cancelled attempt cannot replay.
+/// Attach this value as `Arc<InitialTurnInitialization>` in the turn initializer.
+pub struct InitialTurnInitialization {
+    state: Mutex<State>,
+}
+struct State {
+    pending: Option<(Vec<ResponseItemEnvelope>, Commit)>,
+    attempted: bool,
+    completed: bool,
+}
+impl InitialTurnInitialization {
+    pub fn new(items: Vec<ResponseItemEnvelope>, commit: Commit) -> Self {
+        Self {
+            state: Mutex::new(State {
+                pending: Some((items, commit)),
+                attempted: false,
+                completed: false,
+            }),
+        }
+    }
+
+    pub(crate) async fn prepare(
+        &self,
+        session: &Arc<Session>,
+        turn: Arc<TurnContext>,
+        cancellation: &CancellationToken,
+    ) -> CodexResult<Option<Arc<StepContext>>> {
+        let mut state = self.state.lock().await;
+        if state.completed {
+            return Ok(None);
+        }
+        if state.attempted {
+            return Err(CodexErr::InvalidRequest(
+                "initial publication already failed or was cancelled".to_owned(),
+            ));
+        }
+        state.attempted = true;
+        let (items, commit) = state.pending.take().ok_or_else(|| {
+            CodexErr::InvalidRequest("initial publication has no payload".to_owned())
+        })?;
+        if items.is_empty() || items.iter().any(|envelope| !matches!(&envelope.item,
+            codex_protocol::models::ResponseItem::Message { id: Some(_), role, .. } if role == "developer")) {
+            return Err(CodexErr::InvalidRequest("initial publication requires identified developer messages".to_owned()));
+        }
+        if !session
+            .services
+            .thread_extension_data
+            .get::<crate::config::ManagedExecution>()
+            .is_some_and(|profile| profile.accepts(&turn.config))
+        {
+            return Err(CodexErr::InvalidRequest(
+                "initial publication requires managed execution".to_owned(),
+            ));
+        }
+        if session.reference_context_item().await.is_some() {
+            return Err(CodexErr::InvalidRequest(
+                "initial publication requires fresh context".to_owned(),
+            ));
+        }
+        let step = session
+            .capture_step_context(Arc::clone(&turn), cancellation)
+            .await?;
+        session
+            .record_context_updates_and_set_reference_context_item(step.as_ref())
+            .await?;
+        // This is deliberately a direct record: active-turn injection queues the
+        // items behind user input, which would violate the publication ordering.
+        session
+            .record_annotated_conversation_items(&turn, &step.settings.model_info, items)
+            .await;
+        session.ensure_rollout_durable().await?;
+        // No history, persistence or active-turn lock is held during the callback.
+        // Do not race the commit acknowledgment against cancellation: once durable,
+        // complete its receipt/owner update before returning control to the task.
+        commit().await.map_err(|error| {
+            CodexErr::Fatal(format!("initial publication receipt failed: {error}"))
+        })?;
+        state.completed = true;
+        if cancellation.is_cancelled() {
+            return Err(CodexErr::TurnAborted);
+        }
+        Ok(Some(step))
+    }
+}
