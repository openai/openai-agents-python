diff --git a/codex-rs/history/src/sdk_originals.rs b/codex-rs/history/src/sdk_originals.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7728908b6f91631324ef40565f9aafbbb65eb2f3
--- /dev/null
+++ b/codex-rs/history/src/sdk_originals.rs
@@ -0,0 +1,524 @@
+//! Original SDK values and their separately admitted model projections.
+use codex_protocol::models::ResponseItem;
+use schemars::JsonSchema;
+use serde::{Deserialize, Deserializer, Serialize};
+use serde_json::value::RawValue;
+use sha2::{Digest, Sha256};
+use std::collections::BTreeMap;
+
+use crate::ResponseItemEnvelope;
+
+/// The projection is fixed at admission. Restore never promotes an audit-only value.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize, JsonSchema)]
+pub struct SdkOriginalItem {
+    pub original: String,
+    pub projection: Option<ResponseItemEnvelope>,
+}
+
+impl SdkOriginalItem {
+    pub fn from_native(projection: ResponseItemEnvelope) -> Self {
+        Self {
+            original: serde_json::to_string(&projection.item).expect("response items serialize"),
+            projection: Some(projection),
+        }
+    }
+}
+
+/// Decode supported input once, without treating unknown or harness-only records as work.
+pub fn input_projection(value: &str) -> Result<Option<ResponseItem>, String> {
+    let fields: BTreeMap<String, &RawValue> = serde_json::from_str(value)
+        .map_err(|_| "canonical history items must be JSON objects".to_string())?;
+    let Some(kind) = fields
+        .get("type")
+        .and_then(|value| serde_json::from_str::<String>(value.get()).ok())
+    else {
+        return Ok(None);
+    };
+    if matches!(kind.as_str(), "configuration_update" | "compaction_trigger") {
+        return Ok(None);
+    }
+    let item: ResponseItem =
+        serde_json::from_str(value).map_err(|_| "Invalid canonical history item".to_string())?;
+    Ok(match item {
+        ResponseItem::Other
+        | ResponseItem::ConfigurationUpdate { .. }
+        | ResponseItem::CompactionTrigger { .. } => None,
+        ResponseItem::Message { ref role, .. } if role == "system" => None,
+        item => Some(item),
+    })
+}
+
+/// The serialized catalog has one owner and no public execution authority.
+#[derive(Clone, Debug, Serialize, JsonSchema)]
+pub struct SdkOriginalHistory {
+    format_version: u32,
+    pub items: Vec<SdkOriginalItem>,
+    #[serde(skip)]
+    index: OriginalIndex,
+}
+
+#[derive(Clone, Debug)]
+struct OriginalIndex {
+    hash: Sha256,
+    revision: String,
+}
+
+impl Default for OriginalIndex {
+    fn default() -> Self {
+        let mut hash = Sha256::new();
+        hash.update(b"[");
+        let mut completed = hash.clone();
+        completed.update(b"]");
+        Self {
+            hash,
+            revision: format!("{:x}", completed.finalize()),
+        }
+    }
+}
+
+impl Default for SdkOriginalHistory {
+    fn default() -> Self {
+        Self {
+            format_version: 1,
+            items: Vec::new(),
+            index: OriginalIndex::default(),
+        }
+    }
+}
+
+impl PartialEq for SdkOriginalHistory {
+    fn eq(&self, other: &Self) -> bool {
+        self.format_version == other.format_version && self.items == other.items
+    }
+}
+
+impl<'de> Deserialize<'de> for SdkOriginalHistory {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        struct Stored {
+            format_version: u32,
+            items: Vec<SdkOriginalItem>,
+        }
+        let stored = Stored::deserialize(deserializer)?;
+        if stored.format_version != 1 {
+            return Err(serde::de::Error::custom(
+                "unsupported original history format",
+            ));
+        }
+        let mut history = Self::default();
+        for item in stored.items {
+            if serde_json::from_str::<BTreeMap<String, &RawValue>>(&item.original).is_err() {
+                return Err(serde::de::Error::custom("invalid original history value"));
+            }
+            history.append(item);
+        }
+        Ok(history)
+    }
+}
+
+impl SdkOriginalHistory {
+    pub fn revision(&self) -> &str {
+        &self.index.revision
+    }
+
+    pub fn append(&mut self, item: SdkOriginalItem) {
+        if !self.items.is_empty() {
+            self.index.hash.update(b",");
+        }
+        self.index.hash.update(item.original.as_bytes());
+        let mut completed = self.index.hash.clone();
+        completed.update(b"]");
+        self.index.revision = format!("{:x}", completed.finalize());
+        self.items.push(item);
+    }
+
+    /// A hot suffix read clones only the requested values and uses the cached revision.
+    pub fn snapshot(&self, limit: Option<usize>) -> (String, usize, Vec<String>) {
+        let total = self.items.len();
+        let start = total.saturating_sub(limit.unwrap_or(total));
+        (
+            self.revision().to_owned(),
+            total,
+            self.items[start..]
+                .iter()
+                .map(|item| item.original.clone())
+                .collect(),
+        )
+    }
+
+    pub fn prefix(&self, keep: usize) -> Self {
+        let mut retained = Self::default();
+        for item in &self.items[..keep] {
+            retained.append(item.clone());
+        }
+        retained
+    }
+
+    pub fn projection(&self) -> Vec<ResponseItemEnvelope> {
+        self.items
+            .iter()
+            .filter_map(|item| item.projection.clone())
+            .collect()
+    }
+
+    /// Preserve current model admission when retaining originals, without replaying old values.
+    pub fn retained_projection(
+        &self,
+        current: &[ResponseItemEnvelope],
+        keep: usize,
+    ) -> Result<Vec<ResponseItemEnvelope>, &'static str> {
+        if keep > self.items.len() {
+            return Err("history keep exceeds snapshot length");
+        }
+        if keep == 0 {
+            return Ok(Vec::new());
+        }
+        if keep == self.items.len() {
+            return Ok(current.to_vec());
+        }
+        // The current model window is an ordered subsequence of admitted
+        // originals until compaction introduces a summary. Never reconstruct
+        // that summary from originals or retain its deleted content implicitly.
+        let mut originals = self.items.iter().enumerate();
+        let mut retained = Vec::new();
+        for row in current {
+            let Some((index, _)) =
+                originals.find(|(_, item)| item.projection.as_ref() == Some(row))
+            else {
+                return Err(
+                    "cannot shorten original history across model compaction; use keep=0 to replace it explicitly",
+                );
+            };
+            if index < keep {
+                retained.push(row.clone());
+            }
+        }
+        Ok(retained)
+    }
+
+    /// Legacy compaction defines the migration boundary. New checkpoints carry originals.
+    pub fn replay(
+        records: &[crate::RolloutItem],
+        project: impl Fn(&ResponseItemEnvelope) -> Option<ResponseItemEnvelope>,
+        rewind: impl Fn(&[ResponseItemEnvelope], u32) -> Vec<ResponseItemEnvelope>,
+    ) -> Self {
+        let mut history = Self::default();
+        for record in records {
+            match record {
+                crate::RolloutItem::ResponseItem(envelope) => {
+                    if let Some(projection) = project(envelope) {
+                        history.append(SdkOriginalItem {
+                            original: serde_json::to_string(&envelope.item)
+                                .expect("response items serialize"),
+                            projection: Some(projection),
+                        });
+                    }
+                }
+                crate::RolloutItem::Compacted(checkpoint) => {
+                    if let Some(originals) = &checkpoint.sdk_originals {
+                        history = originals.clone();
+                    } else if let Some(items) = &checkpoint.replacement_history {
+                        // Never resurrect values removed by an older canonical transaction.
+                        history = Self::default();
+                        for envelope in items {
+                            if let Some(projection) = project(envelope) {
+                                history.append(SdkOriginalItem {
+                                    original: serde_json::to_string(&envelope.item)
+                                        .expect("response items serialize"),
+                                    projection: Some(projection),
+                                });
+                            }
+                        }
+                    }
+                }
+                crate::RolloutItem::EventMsg(
+                    codex_protocol::protocol::EventMsg::ThreadRolledBack(event),
+                ) => {
+                    let projection = history.projection();
+                    let retained = rewind(&projection, event.num_turns);
+                    history = history.after_rollback(retained);
+                }
+                _ => {}
+            }
+        }
+        history
+    }
+
+    fn after_rollback(&self, retained: Vec<ResponseItemEnvelope>) -> Self {
+        let mut by_id: std::collections::HashMap<_, _> = retained
+            .iter()
+            .filter_map(|row| row.item.id().map(|id| (id.to_string(), row.clone())))
+            .collect();
+        let mut without_id: Vec<_> = retained
+            .into_iter()
+            .filter(|row| row.item.id().is_none())
+            .collect();
+        let matched = |row: &ResponseItemEnvelope| {
+            row.item.id().map_or_else(
+                || without_id.iter().any(|kept| kept.item == row.item),
+                |id| by_id.contains_key(id.as_str()),
+            )
+        };
+        // Audit-only values belong to the user-turn prefix containing their admitted position.
+        let boundary = self
+            .items
+            .iter()
+            .position(|entry| {
+                entry.projection.as_ref().is_some_and(|row| {
+                    matches!(&row.item, ResponseItem::Message { role, .. } if role == "user")
+                        && !matched(row)
+                })
+            })
+            .unwrap_or(self.items.len());
+        let mut history = Self::default();
+        for entry in &self.items[..boundary] {
+            let mut entry = entry.clone();
+            if let Some(projection) = &entry.projection {
+                let retained = if let Some(id) = projection.item.id() {
+                    by_id.remove(id.as_str())
+                } else {
+                    without_id
+                        .iter()
+                        .position(|row| row.item == projection.item)
+                        .map(|index| without_id.remove(index))
+                };
+                let Some(retained) = retained else {
+                    continue;
+                };
+                entry.projection = Some(retained);
+            }
+            history.append(entry);
+        }
+        history
+    }
+}
