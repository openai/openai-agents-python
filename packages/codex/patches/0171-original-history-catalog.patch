+#[tokio::test]
+async fn sdk_partial_compaction_edit_rejects_without_live_change() {
+    use serde_json::json;
+    let (session, _turn, _) = make_session_and_context_with_rx().await;
+    let revision = session.sdk_history_snapshot(None).await.0;
+    session.sdk_replace_history(&revision, 0, vec![
+        json!({"type":"message","role":"user","content":[{"type":"input_text","text":"first"}]}).to_string(),
+        json!({"type":"message","role":"user","content":[{"type":"input_text","text":"second"}]}).to_string(),
+    ]).await.unwrap();
+    let summary: ResponseItem = serde_json::from_value(json!({"type":"message","id":"compaction-summary","role":"user","content":[{"type":"input_text","text":"summary of both"}]})).unwrap();
+    session
+        .state
+        .lock()
+        .await
+        .history
+        .replace_annotated(vec![summary.into()]);
+    let before = session.sdk_history_snapshot(None).await;
+    let model_before = session.clone_history().await.into_annotated_items();
+    let error = session
+        .sdk_replace_history(&before.0, 1, Vec::new())
+        .await
+        .unwrap_err();
+    assert!(error.to_string().contains("compaction"));
+    assert_eq!(session.sdk_history_snapshot(None).await, before);
+    assert_eq!(
+        session.clone_history().await.into_annotated_items(),
+        model_before
+    );
+    session
+        .sdk_replace_history(
+            &before.0,
+            before.1,
+            vec![json!({"type":"audit","appended":true}).to_string()],
+        )
+        .await
+        .unwrap();
+    assert_eq!(
+        session.clone_history().await.into_annotated_items(),
+        model_before
+    );
+    let appended = session.sdk_history_snapshot(None).await;
+    session
+        .sdk_replace_history(
+            &appended.0,
+            0,
+            vec![json!({"type":"audit","replacement":true}).to_string()],
+        )
+        .await
+        .unwrap();
+    assert!(
+        session
+            .clone_history()
+            .await
+            .into_annotated_items()
+            .is_empty()
+    );
+}
