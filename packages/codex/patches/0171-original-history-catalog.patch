+        json!({"type":"message","role":"user","content":[{"type":"input_text","text":"second"}],"future":2}),
+        json!({"type":"future","audit":"second"}),
+        json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"answer two"}]}),
+    ].into_iter().map(|value| value.to_string()).collect::<Vec<_>>();
+    let revision = session.sdk_history_snapshot(None).await.0;
+    session
+        .sdk_replace_history(&revision, 0, originals.clone())
+        .await
+        .unwrap();
+    let model = session.clone_history().await.into_annotated_items();
+    let catalog = session.state.lock().await.sdk_originals.clone();
+    let mut checkpoint: codex_history::CompactedItem =
+        serde_json::from_value(json!({"message":""})).unwrap();
+    checkpoint.replacement_history = Some(model.clone());
+    checkpoint.sdk_originals = Some(catalog);
+    // Core rollback crosses a compaction only with its surviving native prefix.
+    let mut records: Vec<_> = model.into_iter().map(RolloutItem::ResponseItem).collect();
+    records.push(RolloutItem::Compacted(checkpoint));
+    records = serde_json::from_value(serde_json::to_value(records).unwrap()).unwrap();
+    session.apply_rollout_reconstruction(&turn, &records).await;
+    assert_eq!(session.sdk_history_snapshot(None).await.2, originals);
+    records.push(RolloutItem::EventMsg(EventMsg::ThreadRolledBack(
+        ThreadRolledBackEvent { num_turns: 1 },
+    )));
+    session.apply_rollout_reconstruction(&turn, &records).await;
+    assert_eq!(session.sdk_history_snapshot(None).await.2, originals[..3]);
+    let retained_model = session.clone_history().await.into_annotated_items();
+    assert_eq!(retained_model.len(), 2);
+    assert_eq!(
+        serde_json::to_value(&retained_model[0].item).unwrap()["content"][0]["text"],
+        "first"
+    );
+}
