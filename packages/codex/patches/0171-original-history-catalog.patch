+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn unknown_values_and_extra_fields_survive_restore_without_projection_promotion() {
+        let unknown =
+            json!({"type":"future_tool_call","payload":{"nested":[1,null,true]}}).to_string();
+        let known = json!({"type":"message","role":"user","content":[{"type":"input_text","text":"kept"}],"future":{"value":7}}).to_string();
+        let mut history = SdkOriginalHistory::default();
+        history.append(SdkOriginalItem {
+            original: unknown.clone(),
+            projection: None,
+        });
+        history.append(SdkOriginalItem {
+            projection: input_projection(&known)
+                .unwrap()
+                .map(ResponseItemEnvelope::new),
+            original: known.clone(),
+        });
+        let restored: SdkOriginalHistory =
+            serde_json::from_slice(&serde_json::to_vec(&history).unwrap()).unwrap();
+        assert_eq!(restored, history);
+        assert_eq!(restored.snapshot(None).2, vec![unknown, known]);
+        assert!(restored.items[0].projection.is_none());
+        assert_eq!(restored.revision(), history.revision());
+        assert_eq!(restored.projection().len(), 1);
+    }
+
+    #[test]
+    fn malformed_known_calls_reject_instead_of_becoming_audit_only() {
+        for raw in [
+            r#"{"type":"function_call","arguments":17}"#,
+            r#"{"type":"message","content":false}"#,
+        ] {
+            assert!(input_projection(raw).is_err());
+        }
+        for raw in [
+            r#"{"type":"unknown","arguments":17}"#,
+            r#"{"type":"configuration_update","opaque":true}"#,
+            r#"{"type":"compaction_trigger","opaque":true}"#,
+        ] {
+            assert!(input_projection(raw).unwrap().is_none());
+        }
+        for raw in ["null", "[]", "42", "false", r#""scalar""#] {
+            assert!(input_projection(raw).is_err());
+        }
+    }
+
+    #[test]
+    fn original_numeric_values_and_untyped_objects_remain_exact() {
+        let original = r#"{"type":17,"n":184467440737095516161234567890,"nested":{"fraction":1.2345678901234567890123456789}}"#.to_owned();
+        assert!(input_projection(&original).unwrap().is_none());
+        let mut history = SdkOriginalHistory::default();
+        history.append(SdkOriginalItem {
+            original: original.clone(),
+            projection: None,
+        });
+        let restored: SdkOriginalHistory =
+            serde_json::from_value(serde_json::to_value(&history).unwrap()).unwrap();
+        assert_eq!(restored.snapshot(None).2, vec![original]);
+    }
+
+    #[test]
+    fn rollback_preserves_original_prefix_and_audit_position() {
+        let mut history = SdkOriginalHistory::default();
+        for (id, role, text) in [
+            ("user-1", "user", "first"),
+            ("assistant-1", "assistant", "answer"),
+            ("user-2", "user", "second"),
+            ("assistant-2", "assistant", "removed"),
+        ] {
+            let original = json!({"type":"message","id":id,"role":role,"content":[{"type":"input_text","text":text}],"unknown":"preserved"}).to_string();
+            history.append(SdkOriginalItem {
+                projection: input_projection(&original)
+                    .unwrap()
+                    .map(ResponseItemEnvelope::new),
+                original,
+            });
+            if role == "user" {
+                history.append(SdkOriginalItem {
+                    original: json!({"type":"audit","user":id}).to_string(),
+                    projection: None,
+                });
+            }
+        }
+        let expected = history.snapshot(None).2[..3].to_vec();
+        let retained = history.projection()[..2].to_vec();
+        let restored: SdkOriginalHistory =
+            serde_json::from_slice(&serde_json::to_vec(&history).unwrap()).unwrap();
+        let rolled = restored.after_rollback(retained.clone());
+        assert_eq!(rolled.snapshot(None).2, expected);
+        assert_eq!(rolled.projection(), retained);
+        assert_eq!(rolled.items.len(), 3);
+        assert_ne!(rolled.revision(), history.revision());
+        assert!(rolled.items[1].projection.is_none());
+    }
+
+    #[test]
+    fn projection_identifiers_never_rewrite_missing_original_identifiers() {
+        let original = json!({"type":"message","role":"user","content":[{"type":"input_text","text":"kept"}],"future":true});
+        let mut projected = original.clone();
+        projected["id"] = json!("trusted-projection-id");
+        let mut history = SdkOriginalHistory::default();
+        history.append(SdkOriginalItem {
+            original: original.to_string(),
+            projection: input_projection(&projected.to_string())
+                .unwrap()
+                .map(ResponseItemEnvelope::new),
+        });
+        let restored: SdkOriginalHistory =
+            serde_json::from_slice(&serde_json::to_vec(&history).unwrap()).unwrap();
+        assert_eq!(restored.snapshot(None).2, vec![original.to_string()]);
+        assert_eq!(
+            restored.projection()[0].item.id().unwrap().as_str(),
+            "trusted-projection-id"
+        );
+    }
+
+    #[test]
+    fn prefix_edits_preserve_model_payload_and_reject_ambiguous_summaries() {
+        let mut history = SdkOriginalHistory::default();
+        for (id, text) in [
+            ("first", "full original payload"),
+            ("second", "second turn"),
+        ] {
+            let original = json!({"type":"message","id":id,"role":"user","content":[{"type":"input_text","text":text}]});
+            let mut admitted = original.clone();
+            if id == "first" {
+                admitted["content"][0]["text"] = json!("truncated model payload");
+            }
+            history.append(SdkOriginalItem {
+                original: original.to_string(),
+                projection: input_projection(&admitted.to_string())
+                    .unwrap()
+                    .map(ResponseItemEnvelope::new),
+            });
+        }
+        let model = history.projection();
+        assert_eq!(history.retained_projection(&model, 1).unwrap(), model[..1]);
+        assert!(history.snapshot(None).2[0].contains("full original payload"));
+        let summary = input_projection(&json!({"type":"message","id":"compacted-summary","role":"user","content":[{"type":"input_text","text":"summary of both originals"}]}).to_string()).unwrap().map(ResponseItemEnvelope::new).unwrap();
+        let compacted = vec![summary];
+        let before = history.snapshot(None);
+        assert!(
+            history
+                .retained_projection(&compacted, 1)
+                .unwrap_err()
+                .contains("compaction")
+        );
+        assert_eq!(history.snapshot(None), before);
+        assert_eq!(
+            history.retained_projection(&compacted, 2).unwrap(),
+            compacted
+        );
+        assert!(
+            history
+                .retained_projection(&compacted, 0)
+                .unwrap()
+                .is_empty()
+        );
+    }
+
+    #[test]
+    fn original_numbers_survive_tagged_rollout_value_roundtrip() {
+        let original = format!(
+            r#"{{"type":"future_record","large":1{},"nested":{{"fraction":1.2345678901234567890123456789}}}}"#,
+            "0".repeat(80)
+        );
+        let mut history = SdkOriginalHistory::default();
+        history.append(SdkOriginalItem {
+            original,
+            projection: None,
+        });
+        let before = history.snapshot(None);
+        let wire =
+            json!({"type":"compacted", "payload":{"message":"summary", "sdk_originals":history}});
+        let restored: crate::RolloutItem = serde_json::from_value(wire).unwrap();
+        let crate::RolloutItem::Compacted(compacted) = restored else {
+            panic!("compacted record");
+        };
+        assert_eq!(compacted.sdk_originals.unwrap().snapshot(None), before);
+    }
+
+    #[test]
+    fn magic_map_keys_remain_original_data_without_type_promotion() {
+        for original in [
+            r#"{"type":"future","payload":{"$serde_json::private::Number":"7"}}"#,
+            r#"{"type":"future","payload":{"$serde_json::private::RawValue":"{\"converted\":true}"}}"#,
+            r#"{"$serde_json::private::RawValue":"{\"type\":\"message\",\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"no authority\"}]}"}"#,
+            r#"{"type":{"$serde_json::private::RawValue":"\"message\""}}"#,
+            r#"{"__proto__":{"preserved":true}}"#,
+        ] {
+            assert!(input_projection(original).unwrap().is_none());
+            let mut history = SdkOriginalHistory::default();
+            history.append(SdkOriginalItem {
+                original: original.to_owned(),
+                projection: None,
+            });
+            let restored: SdkOriginalHistory =
+                serde_json::from_value(serde_json::to_value(&history).unwrap()).unwrap();
+            assert_eq!(restored.snapshot(None), history.snapshot(None));
+            assert!(restored.projection().is_empty());
+        }
+    }
+
+    #[test]
+    fn original_revision_and_tail_include_audit_only_values() {
+        let mut history = SdkOriginalHistory::default();
+        for index in 0..10_000 {
+            history.append(SdkOriginalItem {
+                original: json!({"type":"future","value":index}).to_string(),
+                projection: None,
+            });
+        }
+        let (revision, total, values) = history.snapshot(Some(2));
+        assert_eq!(total, 10_000);
+        assert_eq!(
+            values,
+            vec![
+                json!({"type":"future","value":9998}).to_string(),
+                json!({"type":"future","value":9999}).to_string()
+            ]
+        );
+        assert_eq!(history.snapshot(Some(0)), (revision, total, vec![]));
+        assert_ne!(history.prefix(9999).revision(), history.revision());
+    }
+}
