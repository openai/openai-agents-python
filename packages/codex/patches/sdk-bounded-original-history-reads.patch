+//! Borrowed canonical records for bounded original-history queries.
+//!
+//! The reader owns query logic, while the store owns record lifetime and frozen fork ranges.
+//! This boundary never substitutes a complete cloned journal for a targeted read.
+use std::path::PathBuf;
+
+use codex_rollout::RolloutItem;
+
+use crate::ThreadStoreResult;
+
+pub type OriginalHistorySnapshot = (String, usize, Vec<String>);
+
+/// A frozen logical JSONL prefix. Offsets refer to the decoded rollout representation.
+#[derive(Debug)]
+pub struct OriginalHistorySegment {
+    pub rollout_path: PathBuf,
+    pub end_byte_offset: u64,
+}
+
+/// Native read-only query run against store-owned canonical history.
+/// Implementations must discard partial output on any decoding or I/O error.
+pub trait OriginalHistoryReader: Send + 'static {
+    fn read_items(&mut self, items: &[RolloutItem]) -> ThreadStoreResult<OriginalHistorySnapshot>;
+    fn read_segments(
+        &mut self,
+        segments: &[OriginalHistorySegment],
+    ) -> ThreadStoreResult<OriginalHistorySnapshot>;
+}
