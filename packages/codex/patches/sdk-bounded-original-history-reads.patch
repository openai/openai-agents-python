+impl OriginalSource for LocalSource<'_> {
+    fn rewind(&mut self) -> io::Result<()> {
+        self.segment = 0;
+        self.next_record = 0;
+        self.array = None;
+        Ok(())
+    }
+    fn next(&mut self, reader: &SnapshotReader) -> io::Result<Option<Action>> {
+        loop {
+            if let Some(mut array) = self.array.take() {
+                let input = self.cursor(array.segment, array.next)?;
+                let Some(item) = input.next_array(array.first)? else {
+                    continue;
+                };
+                array.first = false;
+                array.next = input.position()?;
+                self.array = Some(array);
+                if array.legacy {
+                    let position = Position {
+                        kind: 13,
+                        record: array.segment as u64,
+                        item: item.start,
+                    };
+                    let row = self.envelope(position)?.ok_or_else(invalid)?;
+                    if !crate::context_manager::is_api_message(&row.item, row.metadata.as_ref()) {
+                        continue;
+                    }
+                    return Ok(Some(Action::Append(Entry {
+                        original: position,
+                        projection: position,
+                        ..Default::default()
+                    })));
+                }
+                let input = self.cursor(array.segment, item.start)?;
+                let mut original = None;
+                let mut projection = None;
+                input.object(|key, input| {
+                    match key {
+                        Some("original") => {
+                            if original.is_some() || input.peek_value()? != Some(b'"') {
+                                return Err(invalid());
+                            }
+                            original = Some(input.skip()?);
+                        }
+                        Some("projection") => {
+                            if projection.is_some() {
+                                return Err(invalid());
+                            }
+                            let present = input.peek_value()? != Some(b'n');
+                            let span = input.skip()?;
+                            projection = Some((present, span));
+                        }
+                        _ => {
+                            input.skip()?;
+                        }
+                    }
+                    Ok(())
+                })?;
+                let original = Position {
+                    kind: 11,
+                    record: array.segment as u64,
+                    item: original.ok_or_else(invalid)?.start,
+                };
+                let projection = projection
+                    .filter(|(present, _)| *present)
+                    .map(|(_, span)| Position {
+                        kind: 12,
+                        record: array.segment as u64,
+                        item: span.start,
+                    })
+                    .unwrap_or_default();
+                return Ok(Some(Action::Append(Entry {
+                    original,
+                    projection,
+                    ..Default::default()
+                })));
+            }
+            if self.segment >= self.segments.len() {
+                return Ok(None);
+            }
+            let segment = self.segment;
+            let position = self.next_record;
+            if self.cursor(segment, position)?.eof()? {
+                self.segment += 1;
+                self.next_record = 0;
+                continue;
+            }
+            let frame = self.frame(segment, position)?;
+            self.next_record = frame.end;
+            match frame.kind.as_deref() {
+                Some("response_item") => {
+                    let position = Position {
+                        kind: 10,
+                        record: segment as u64,
+                        item: position,
+                    };
+                    let row = self.native(position)?;
+                    if crate::context_manager::is_api_message(&row.item, row.metadata.as_ref()) {
+                        return Ok(Some(Action::Append(Entry {
+                            original: position,
+                            projection: position,
+                            ..Default::default()
+                        })));
+                    }
+                }
+                Some("compacted") => {
+                    if let Some(action) =
+                        self.compacted(segment, frame.payload.ok_or_else(invalid)?)?
+                    {
+                        return Ok(Some(action));
+                    }
+                }
+                Some("event_msg") => {
+                    let input = self.cursor(segment, frame.payload.ok_or_else(invalid)?.start)?;
+                    let mut kind = None;
+                    let mut turns = None;
+                    input.object(|key, input| {
+                        match key {
+                            Some("type") => kind = input.small_string()?,
+                            Some("num_turns") => turns = Some(input.skip()?),
+                            _ => {
+                                input.skip()?;
+                            }
+                        }
+                        Ok(())
+                    })?;
+                    if kind.as_deref() == Some("thread_rolled_back") {
+                        let turns = self
+                            .cursor(segment, turns.ok_or_else(invalid)?.start)?
+                            .value::<u32>()?;
+                        return Ok(Some(Action::Rollback(turns)));
+                    }
+                }
+                Some(_) => {}
+                None => return Err(invalid()),
+            }
+            let _ = reader;
+        }
+    }
+    fn projection(
+        &mut self,
+        position: Position,
+        reader: &SnapshotReader,
+    ) -> io::Result<Option<ResponseItemEnvelope>> {
+        match position.kind {
+            10 => Ok(reader.native_projection(&self.native(position)?)),
+            12 => self.envelope(position),
+            13 => Ok(self
+                .envelope(position)?
+                .and_then(|row| reader.native_projection(&row))),
+            _ => Err(invalid()),
+        }
+    }
+    fn original(
+        &mut self,
+        position: Position,
+        _reader: &SnapshotReader,
+        fold: &mut SdkOriginalSnapshotFold,
+    ) -> io::Result<()> {
+        match position.kind {
+            11 => self
+                .cursor(position.record as usize, position.item)?
+                .string(|bytes| fold.write_item(bytes).map_err(|_| invalid())),
+            10 => serde_json::to_writer(FoldWriter(fold), &self.native(position)?.item)
+                .map_err(|_| invalid()),
+            13 => serde_json::to_writer(
+                FoldWriter(fold),
+                &self.envelope(position)?.ok_or_else(invalid)?.item,
+            )
+            .map_err(|_| invalid()),
+            _ => Err(invalid()),
+        }
+    }
+}
