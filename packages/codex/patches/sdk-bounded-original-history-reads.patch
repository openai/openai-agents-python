+/// Classify the contiguous context updates immediately before a removed instruction turn.
+/// The boolean requests the existing baseline reset for a mixed developer bundle.
+pub(crate) fn rollback_context_update(item: &ResponseItem) -> Option<bool> {
+    match item {
+        ResponseItem::Message { role, content, .. }
+            if role == "developer" && is_contextual_dev_message_content(content) =>
+        {
+            Some(has_non_contextual_dev_message_content(content))
+        }
+        ResponseItem::Message { role, content, .. }
+            if role == "user" && is_contextual_user_message_content(content) =>
+        {
+            Some(false)
+        }
+        _ => None,
+    }
+}
