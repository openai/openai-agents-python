+    fn native(&mut self, position: Position) -> io::Result<ResponseItemEnvelope> {
+        let segment = usize::try_from(position.record).map_err(|_| invalid())?;
+        let frame = self.frame(segment, position.item)?;
+        if frame.kind.as_deref() != Some("response_item") {
+            return Err(invalid());
+        }
+        let payload = self
+            .cursor(segment, frame.payload.ok_or_else(invalid)?.start)?
+            .value::<serde_json::Value>()?;
+        let mut value = serde_json::Map::new();
+        value.insert("type".into(), "response_item".into());
+        value.insert("payload".into(), payload);
+        if let Some(metadata) = frame.metadata {
+            value.insert(
+                "metadata".into(),
+                self.cursor(segment, metadata.start)?.value()?,
+            );
+        }
+        // Reuse the canonical RolloutItem decoder, including its persisted response normalization.
+        match serde_json::from_value::<codex_history::RolloutItem>(serde_json::Value::Object(value))
+            .map_err(|_| invalid())?
+        {
+            codex_history::RolloutItem::ResponseItem(row) => Ok(row),
+            _ => Err(invalid()),
+        }
+    }
+    fn envelope(&mut self, position: Position) -> io::Result<Option<ResponseItemEnvelope>> {
+        let value = self
+            .cursor(position.record as usize, position.item)?
+            .value::<serde_json::Value>()?;
+        serde_json::from_value(value).map_err(|_| invalid())
+    }
+    fn array(&mut self, segment: usize, start: u64, legacy: bool) -> io::Result<()> {
+        let input = self.cursor(segment, start)?;
+        input.begin_array()?;
+        let next = input.position()?;
+        self.array = Some(Array {
+            segment,
+            next,
+            first: true,
+            legacy,
+        });
+        Ok(())
+    }
+    fn compacted(&mut self, segment: usize, payload: Span) -> io::Result<Option<Action>> {
+        let input = self.cursor(segment, payload.start)?;
+        let mut originals = None;
+        let mut replacement = None;
+        input.object(|key, input| {
+            match key {
+                Some("sdk_originals") => {
+                    if originals.is_some() {
+                        return Err(invalid());
+                    }
+                    originals = Some(input.skip()?);
+                }
+                Some("replacement_history") => {
+                    if replacement.is_some() {
+                        return Err(invalid());
+                    }
+                    replacement = Some(input.skip()?);
+                }
+                _ => {
+                    input.skip()?;
+                }
+            }
+            Ok(())
+        })?;
+        if let Some(originals) = originals {
+            let input = self.cursor(segment, originals.start)?;
+            if input.peek_value()? != Some(b'n') {
+                let mut preserve = None;
+                let mut version = None;
+                let mut items = None;
+                input.object(|key, input| {
+                    match key {
+                        Some("preserve") => {
+                            if preserve.is_some() {
+                                return Err(invalid());
+                            }
+                            preserve = Some(input.value::<bool>()?);
+                        }
+                        Some("format_version") => {
+                            if version.is_some() {
+                                return Err(invalid());
+                            }
+                            version = Some(input.unsigned()?);
+                        }
+                        Some("items") => {
+                            if items.is_some() {
+                                return Err(invalid());
+                            }
+                            items = Some(input.skip()?);
+                        }
+                        _ => {
+                            input.skip()?;
+                        }
+                    }
+                    Ok(())
+                })?;
+                if preserve == Some(true) && version.is_none() && items.is_none() {
+                    return Ok(None);
+                }
+                if preserve.is_some() || version != Some(1) {
+                    return Err(invalid());
+                }
+                self.array(segment, items.ok_or_else(invalid)?.start, false)?;
+                return Ok(Some(Action::Reset));
+            }
+        }
+        if let Some(replacement) = replacement {
+            if self.cursor(segment, replacement.start)?.peek_value()? != Some(b'n') {
+                self.array(segment, replacement.start, true)?;
+                return Ok(Some(Action::Reset));
+            }
+        }
+        Ok(None)
+    }
