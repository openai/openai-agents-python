+    fn local_limited_snapshot_streams_huge_replacement_with_bounded_rss() {
+        const CHILD: &str = "CODEX_TEST_BOUNDED_HISTORY_RSS_CHILD";
+        if std::env::var_os(CHILD).is_none() {
+            let output = std::process::Command::new(std::env::current_exe().unwrap())
+                .args([
+                    "--exact",
+                    "session::original_history_read::tests::local_limited_snapshot_streams_huge_replacement_with_bounded_rss",
+                    "--test-threads=1",
+                ])
+                .env(CHILD, "1")
+                .output()
+                .unwrap();
+            assert!(
+                output.status.success(),
+                "{}",
+                String::from_utf8_lossy(&output.stdout)
+            );
+            return;
+        }
+        fn peak_rss() -> usize {
+            std::fs::read_to_string("/proc/self/status")
+                .unwrap()
+                .lines()
+                .find_map(|line| {
+                    line.strip_prefix("VmHWM:").map(|value| {
+                        value
+                            .split_whitespace()
+                            .next()
+                            .unwrap()
+                            .parse::<usize>()
+                            .unwrap()
+                            * 1024
+                    })
+                })
+                .unwrap()
+        }
+        const PAYLOAD: usize = 128 * 1024 * 1024;
+        let record = checkpoint(&[
+            json!({"type":"future","large":"HUGE_HISTORY_PLACEHOLDER"}),
+            json!({"type":"future","tail":true}),
+        ]);
+        let line = serde_json::to_string(&codex_history::RolloutLine {
+            timestamp: "2026-11-10T00:00:00Z".into(),
+            ordinal: None,
+            item: record,
+        })
+        .unwrap();
+        let (before, after) = line.split_once("HUGE_HISTORY_PLACEHOLDER").unwrap();
+        let mut file = tempfile::NamedTempFile::new().unwrap();
+        file.write_all(before.as_bytes()).unwrap();
+        let chunk = [b'x'; 16 * 1024];
+        for _ in 0..PAYLOAD / chunk.len() {
+            file.write_all(&chunk).unwrap();
+        }
+        file.write_all(after.as_bytes()).unwrap();
+        file.write_all(b"\n").unwrap();
+        file.flush().unwrap();
+        let segments = [OriginalHistorySegment {
+            rollout_path: file.path().to_owned(),
+            end_byte_offset: file.as_file().metadata().unwrap().len(),
+        }];
+        let baseline = peak_rss();
+        let mut reader = SnapshotReader {
+            limit: 1,
+            policy: TruncationPolicy::Bytes(4096),
+        };
+        let snapshot = reader.read_segments(&segments).unwrap();
+        let bounded_peak = peak_rss();
+        assert_eq!(snapshot.1, 2);
+        assert_eq!(
+            snapshot.2,
+            vec![json!({"type":"future","tail":true}).to_string()]
+        );
+        assert!(
+            bounded_peak.saturating_sub(baseline) < 16 * 1024 * 1024,
+            "limited reader RSS growth: {} bytes",
+            bounded_peak.saturating_sub(baseline)
+        );
+        // Positive sensitivity control: full decoding has been intentionally allocating
+        // the complete requested original, unlike the limited production reader above.
+        let complete: RolloutItem =
+            serde_json::from_reader(std::io::BufReader::new(File::open(file.path()).unwrap()))
+                .unwrap();
+        let RolloutItem::Compacted(compacted) = complete else {
+            panic!("checkpoint expected")
+        };
+        let Some(SdkOriginalHistoryCheckpoint::Replace(originals)) = compacted.sdk_originals else {
+            panic!("replacement expected")
+        };
+        assert!(originals.items[0].original.len() > PAYLOAD);
+        assert_eq!(snapshot.0, originals.snapshot(Some(1)).0);
+        assert!(
+            peak_rss().saturating_sub(baseline) > PAYLOAD / 2,
+            "full decode sensitivity control has not crossed half the source payload"
+        );
+    }
+}
