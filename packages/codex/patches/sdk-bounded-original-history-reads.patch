+/// Apply the owning rollback's acceptance and first-turn developer selection to one item.
+/// Cutoff selection and retained-context/review state remain with the caller.
+pub(crate) fn rollback_retained_item(
+    item: &ResponseItemEnvelope,
+    source: RetainedInputSource,
+    trim_first_turn_developer: bool,
+    first_turn_id: Option<&str>,
+) -> Option<ResponseItemEnvelope> {
+    if source.acceptance_order().is_some_and(|boundary| {
+        (matches!(&item.item, ResponseItem::Message { role, .. } if role == "assistant")
+            || matches!(
+                &item.item,
+                ResponseItem::FunctionCall { .. } | ResponseItem::ComputerCall { .. }
+            ))
+            && RetainedInputSource::from(item.metadata.as_ref())
+                .acceptance_order()
+                .is_some_and(|order| order >= boundary)
+    }) {
+        return None;
+    }
+    let mut item = item.clone();
+    if trim_first_turn_developer
+        && first_turn_id.is_some_and(|turn| item.turn_id() == Some(turn))
+        && matches!(&item.item, ResponseItem::Message { role, .. } if role == "developer")
+    {
+        let mut content = to_annotated_content(&mut item.item)?;
+        content.retain(|content| {
+            // Rebuild these from the next step's model and effort after rollback.
+            !matches!(content.content(), ContentItem::InputText { text }
+                if ModelSwitchInstructions::matches_text(text)
+                    || PersistentModeState::matches_text(text))
+        });
+        if content.is_empty() || set_annotated_content(&mut item.item, content).is_none() {
+            return None;
+        }
+    }
+    Some(item)
+}
