@@ -0,0 +1,307 @@
+//! Structural cursor for selective journal decoding. Large ignored values stay in the reader.
+//! serde_json keeps primitive grammar/recursion validation; only object/array navigation is local.
+
+use serde::de::IgnoredAny;
+use std::io::{self, BufRead, Seek, SeekFrom};
+#[path = "original_history_json_string.rs"]
+mod json_string;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Span {
+    pub start: u64,
+    pub end: u64,
+}
+
+pub struct Cursor<R> {
+    reader: R,
+}
+
+fn invalid() -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, "invalid history record")
+}
+
+impl<R: BufRead + Seek> Cursor<R> {
+    pub fn new(reader: R) -> Self {
+        Self { reader }
+    }
+    pub fn position(&mut self) -> io::Result<u64> {
+        self.reader.stream_position()
+    }
+    pub fn seek(&mut self, position: u64) -> io::Result<()> {
+        self.reader.seek(SeekFrom::Start(position))?;
+        Ok(())
+    }
+    fn peek(&mut self) -> io::Result<Option<u8>> {
+        Ok(self.reader.fill_buf()?.first().copied())
+    }
+    fn whitespace(&mut self) -> io::Result<()> {
+        while self.peek()?.is_some_and(|b| b" \r\n\t".contains(&b)) {
+            self.reader.consume(1);
+        }
+        Ok(())
+    }
+    fn take(&mut self, wanted: u8) -> io::Result<()> {
+        self.whitespace()?;
+        if self.peek()? != Some(wanted) {
+            return Err(invalid());
+        }
+        self.reader.consume(1);
+        Ok(())
+    }
+    pub fn eof(&mut self) -> io::Result<bool> {
+        self.whitespace()?;
+        Ok(self.peek()?.is_none())
+    }
+
+    /// Unknown or oversized keys are distinguishable from every known schema key without buffering.
+    pub fn small_string(&mut self) -> io::Result<Option<String>> {
+        self.whitespace()?;
+        let mut value = [0; 64];
+        let mut length: usize = 0;
+        let mut oversized = false;
+        json_string::decode_json_string(&mut self.reader, |chunk| {
+            if !oversized && length.saturating_add(chunk.len()) <= value.len() {
+                value[length..length + chunk.len()].copy_from_slice(chunk);
+                length += chunk.len();
+            } else {
+                oversized = true;
+            }
+            Ok(())
+        })?;
+        if oversized {
+            Ok(None)
+        } else {
+            String::from_utf8(value[..length].to_vec())
+                .map(Some)
+                .map_err(|_| invalid())
+        }
+    }
+
+    pub fn string(&mut self, sink: impl FnMut(&[u8]) -> io::Result<()>) -> io::Result<()> {
+        self.whitespace()?;
+        json_string::decode_json_string(&mut self.reader, sink)
+    }
+
+    pub fn unsigned(&mut self) -> io::Result<u64> {
+        self.whitespace()?;
+        let mut value = 0_u64;
+        let mut count = 0;
+        let mut leading_zero = false;
+        while let Some(digit @ b'0'..=b'9') = self.peek()? {
+            if count != 0 && leading_zero {
+                return Err(invalid());
+            }
+            leading_zero = count == 0 && digit == b'0';
+            value = value
+                .checked_mul(10)
+                .and_then(|v| v.checked_add(u64::from(digit - b'0')))
+                .ok_or_else(invalid)?;
+            count += 1;
+            self.reader.consume(1);
+        }
+        if count == 0 {
+            return Err(invalid());
+        }
+        Ok(value)
+    }
+
+    pub fn line_end(&mut self) -> io::Result<u64> {
+        loop {
+            match self.peek()? {
+                Some(b'\n') => {
+                    self.reader.consume(1);
+                    return self.position();
+                }
+                Some(b' ' | b'\t' | b'\r') => self.reader.consume(1),
+                None => return self.position(),
+                _ => return Err(invalid()),
+            }
+        }
+    }
+    pub fn peek_value(&mut self) -> io::Result<Option<u8>> {
+        self.whitespace()?;
+        self.peek()
+    }
+    pub fn begin_array(&mut self) -> io::Result<()> {
+        self.take(b'[')
+    }
+    pub fn next_array(&mut self, first: bool) -> io::Result<Option<Span>> {
+        self.whitespace()?;
+        if self.peek()? == Some(b']') {
+            self.reader.consume(1);
+            return Ok(None);
+        }
+        if !first {
+            self.take(b',')?;
+        }
+        self.skip().map(Some)
+    }
+    pub fn value<T: serde::de::DeserializeOwned>(&mut self) -> io::Result<T> {
+        self.whitespace()?;
+        let start = self.position()?;
+        let (value, consumed) = {
+            let mut values =
+                serde_json::Deserializer::from_reader(&mut self.reader).into_iter::<T>();
+            let value = values
+                .next()
+                .transpose()
+                .map_err(|_| invalid())?
+                .ok_or_else(invalid)?;
+            (
+                value,
+                u64::try_from(values.byte_offset()).map_err(|_| invalid())?,
+            )
+        };
+        self.seek(start.checked_add(consumed).ok_or_else(invalid)?)?;
+        Ok(value)
+    }
+    pub fn skip(&mut self) -> io::Result<Span> {
+        self.whitespace()?;
+        let start = self.position()?;
+        // A number decoder may peek at the following separator. Restore the exact consumed offset
+        // before dropping serde's private lookahead, keeping the enclosing structural cursor intact.
+        let consumed = {
+            let mut values =
+                serde_json::Deserializer::from_reader(&mut self.reader).into_iter::<IgnoredAny>();
+            values
+                .next()
+                .transpose()
+                .map_err(|_| invalid())?
+                .ok_or_else(invalid)?;
+            u64::try_from(values.byte_offset()).map_err(|_| invalid())?
+        };
+        let end = start.checked_add(consumed).ok_or_else(invalid)?;
+        self.seek(end)?;
+        Ok(Span { start, end })
+    }
+
+    pub fn object(
+        &mut self,
+        mut field: impl FnMut(Option<&str>, &mut Self) -> io::Result<()>,
+    ) -> io::Result<()> {
+        self.take(b'{')?;
+        self.whitespace()?;
+        if self.peek()? == Some(b'}') {
+            self.reader.consume(1);
+            return Ok(());
+        }
+        loop {
+            let key = self.small_string()?;
+            self.take(b':')?;
+            let before = self.position()?;
+            field(key.as_deref(), self)?;
+            if self.position()? <= before {
+                return Err(invalid());
+            }
+            self.whitespace()?;
+            match self.peek()? {
+                Some(b'}') => {
+                    self.reader.consume(1);
+                    return Ok(());
+                }
+                Some(b',') => self.reader.consume(1),
+                _ => return Err(invalid()),
+            }
+        }
+    }
+
+    pub fn array(&mut self, mut item: impl FnMut(&mut Self) -> io::Result<()>) -> io::Result<()> {
+        self.take(b'[')?;
+        self.whitespace()?;
+        if self.peek()? == Some(b']') {
+            self.reader.consume(1);
+            return Ok(());
+        }
+        loop {
+            let before = self.position()?;
+            item(self)?;
+            if self.position()? <= before {
+                return Err(invalid());
+            }
+            self.whitespace()?;
+            match self.peek()? {
+                Some(b']') => {
+                    self.reader.consume(1);
+                    return Ok(());
+                }
+                Some(b',') => self.reader.consume(1),
+                _ => return Err(invalid()),
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::{BufReader, Cursor as Bytes};
+
+    #[test]
+    fn skipped_scalars_preserve_every_following_separator() {
+        let mut cursor = Cursor::new(BufReader::with_capacity(
+            2,
+            Bytes::new(br#"{"one":17,"two":true,"three":null,"four":[{"value":"text"}]}"#),
+        ));
+        let mut fields = Vec::new();
+        cursor
+            .object(|key, cursor| {
+                fields.push(key.unwrap().to_owned());
+                cursor.skip()?;
+                Ok(())
+            })
+            .unwrap();
+        assert_eq!(fields, ["one", "two", "three", "four"]);
+        assert!(cursor.eof().unwrap());
+    }
+
+    #[test]
+    fn payload_ranges_allow_a_bounded_second_pass_in_any_field_order() {
+        let mut cursor = Cursor::new(BufReader::with_capacity(
+            3,
+            Bytes::new(br#"{"payload":{"items":["first","last"]},"type":"compacted"}"#),
+        ));
+        let mut payload = None;
+        cursor
+            .object(|key, cursor| {
+                if key == Some("payload") {
+                    payload = Some(cursor.skip()?);
+                } else {
+                    cursor.skip()?;
+                }
+                Ok(())
+            })
+            .unwrap();
+        cursor.seek(payload.unwrap().start).unwrap();
+        let mut items = Vec::new();
+        cursor
+            .object(|key, cursor| {
+                if key == Some("items") {
+                    cursor.array(|cursor| {
+                        items.push(cursor.small_string()?.unwrap());
+                        Ok(())
+                    })?;
+                } else {
+                    cursor.skip()?;
+                }
+                Ok(())
+            })
+            .unwrap();
+        assert_eq!(items, ["first", "last"]);
+    }
+
+    #[test]
+    fn invalid_structure_and_unconsumed_values_reject() {
+        for input in [b"{\"x\":1,}".as_slice(), b"{\"x\":}", b"{\"x\":01}"] {
+            assert!(
+                Cursor::new(Bytes::new(input))
+                    .object(|_, c| c.skip().map(|_| ()))
+                    .is_err()
+            );
+        }
+        assert!(
+            Cursor::new(Bytes::new(b"{\"x\":1}"))
+                .object(|_, _| Ok(()))
+                .is_err()
+        );
+    }
+}
