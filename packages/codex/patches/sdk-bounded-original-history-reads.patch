+//! Selective local JSONL source. Replacement catalogs never become a whole line or Vec.
+use super::{Action, Entry, FoldWriter, OriginalSource, Position, SnapshotReader, invalid};
+use codex_history::ResponseItemEnvelope;
+use codex_history::sdk_originals::SdkOriginalSnapshotFold;
+use codex_thread_store::OriginalHistorySegment;
+use std::fs::File;
+use std::io::{self, BufReader, Read, Seek, SeekFrom};
+
+#[path = "original_history_cursor.rs"]
+mod cursor;
+use cursor::{Cursor, Span};
+
+struct Prefix {
+    file: File,
+    end: u64,
+}
+impl Read for Prefix {
+    fn read(&mut self, output: &mut [u8]) -> io::Result<usize> {
+        let left = self.end.saturating_sub(self.file.stream_position()?);
+        let count = output
+            .len()
+            .min(usize::try_from(left).unwrap_or(usize::MAX));
+        self.file.read(&mut output[..count])
+    }
+}
+impl Seek for Prefix {
+    fn seek(&mut self, from: SeekFrom) -> io::Result<u64> {
+        let target = match from {
+            SeekFrom::Start(value) => value,
+            SeekFrom::Current(delta) => self
+                .file
+                .stream_position()?
+                .checked_add_signed(delta)
+                .ok_or_else(invalid)?,
+            SeekFrom::End(delta) => self.end.checked_add_signed(delta).ok_or_else(invalid)?,
+        };
+        if target > self.end {
+            return Err(invalid());
+        }
+        self.file.seek(SeekFrom::Start(target))
+    }
+}
+type Input = Cursor<BufReader<Prefix>>;
+#[derive(Clone, Copy)]
+struct Array {
+    segment: usize,
+    next: u64,
+    first: bool,
+    legacy: bool,
+}
+struct Frame {
+    kind: Option<String>,
+    payload: Option<Span>,
+    metadata: Option<Span>,
+    end: u64,
+}
+
+pub(super) struct LocalSource<'a> {
+    segments: &'a [OriginalHistorySegment],
+    segment: usize,
+    next_record: u64,
+    array: Option<Array>,
+    input: Option<(usize, Input)>,
+}
+impl<'a> LocalSource<'a> {
+    pub(super) fn new(segments: &'a [OriginalHistorySegment]) -> Self {
+        Self {
+            segments,
+            segment: 0,
+            next_record: 0,
+            array: None,
+            input: None,
+        }
+    }
+    fn cursor(&mut self, segment: usize, position: u64) -> io::Result<&mut Input> {
+        if self.input.as_ref().map(|(index, _)| *index) != Some(segment) {
+            let source = self.segments.get(segment).ok_or_else(invalid)?;
+            let file = codex_rollout::open_rollout_seekable_reader(&source.rollout_path)?;
+            if file.metadata()?.len() < source.end_byte_offset {
+                return Err(invalid());
+            }
+            self.input = Some((
+                segment,
+                Cursor::new(BufReader::with_capacity(
+                    16 * 1024,
+                    Prefix {
+                        file,
+                        end: source.end_byte_offset,
+                    },
+                )),
+            ));
+        }
+        let (_, input) = self.input.as_mut().unwrap();
+        input.seek(position)?;
+        Ok(input)
+    }
+    fn frame(&mut self, segment: usize, position: u64) -> io::Result<Frame> {
+        let input = self.cursor(segment, position)?;
+        let mut kind = None;
+        let mut payload = None;
+        let mut metadata = None;
+        input.object(|key, input| {
+            match key {
+                Some("type") => {
+                    if kind.is_some() {
+                        return Err(invalid());
+                    }
+                    kind = input.small_string()?;
+                }
+                Some("payload") => {
+                    if payload.is_some() {
+                        return Err(invalid());
+                    }
+                    payload = Some(input.skip()?);
+                }
+                Some("metadata") => {
+                    if metadata.is_some() {
+                        return Err(invalid());
+                    }
+                    metadata = Some(input.skip()?);
+                }
+                _ => {
+                    input.skip()?;
+                }
+            }
+            Ok(())
+        })?;
+        Ok(Frame {
+            kind,
+            payload,
+            metadata,
+            end: input.line_end()?,
+        })
