+/// Folds a complete effective original stream while retaining only its requested suffix.
+///
+/// The first pass supplies the complete count. Readers must then feed every effective original,
+/// in order, using decoded UTF-8 chunks. No full catalog or skipped original string is required
+/// merely to compute the complete revision. Journal selection and JSON validation remain with
+/// the reader; this fold grants no replacement authority to a partial stream.
+pub struct SdkOriginalSnapshotFold {
+    expected_total: usize,
+    completed: usize,
+    skip: usize,
+    index: OriginalIndex,
+    items: Vec<String>,
+    active: bool,
+    current: Option<Vec<u8>>,
+}
+
+impl SdkOriginalSnapshotFold {
+    pub fn new(total: usize, limit: usize) -> Self {
+        Self {
+            expected_total: total,
+            completed: 0,
+            skip: total.saturating_sub(limit),
+            index: OriginalIndex::default(),
+            items: Vec::new(),
+            active: false,
+            current: None,
+        }
+    }
+
+    pub fn begin_item(&mut self) -> Result<(), &'static str> {
+        if self.active || self.completed == self.expected_total {
+            return Err("inconsistent original stream");
+        }
+        if self.completed != 0 {
+            self.index.hash.update(b",");
+        }
+        self.active = true;
+        self.current = (self.completed >= self.skip).then(Vec::new);
+        Ok(())
+    }
+
+    pub fn write_item(&mut self, bytes: &[u8]) -> Result<(), &'static str> {
+        if !self.active {
+            return Err("inconsistent original stream");
+        }
+        self.index.hash.update(bytes);
+        if let Some(current) = &mut self.current {
+            current.extend_from_slice(bytes);
+        }
+        Ok(())
+    }
+
+    pub fn end_item(&mut self) -> Result<(), &'static str> {
+        if !self.active {
+            return Err("inconsistent original stream");
+        }
+        if let Some(current) = self.current.take() {
+            self.items
+                .push(String::from_utf8(current).map_err(|_| "invalid original stream encoding")?);
+        }
+        self.active = false;
+        self.completed += 1;
+        self.index.complete();
+        Ok(())
+    }
+
+    pub fn finish(self) -> Result<(String, usize, Vec<String>), &'static str> {
+        if self.active || self.completed != self.expected_total {
+            return Err("incomplete original stream");
+        }
+        Ok((self.index.revision, self.completed, self.items))
+    }
+}
