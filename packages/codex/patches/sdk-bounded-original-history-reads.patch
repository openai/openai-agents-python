+++ b/codex-rs/core/src/session/original_history_json_string.rs
@@ -0,0 +1,199 @@
+//! Incremental decoding for an original stored as a JSON string in the journal.
+//! No complete JSONL record or decoded original is buffered here.
+
+use std::io::{self, BufRead};
+
+fn byte(reader: &mut impl BufRead) -> io::Result<u8> {
+    let value =
+        reader.fill_buf()?.first().copied().ok_or_else(|| {
+            io::Error::new(io::ErrorKind::UnexpectedEof, "incomplete JSON string")
+        })?;
+    reader.consume(1);
+    Ok(value)
+}
+
+fn invalid() -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, "invalid JSON string")
+}
+
+fn hex_quad(reader: &mut impl BufRead) -> io::Result<u32> {
+    let mut value = 0;
+    for _ in 0..4 {
+        let digit = match byte(reader)? {
+            c @ b'0'..=b'9' => u32::from(c - b'0'),
+            c @ b'a'..=b'f' => u32::from(c - b'a' + 10),
+            c @ b'A'..=b'F' => u32::from(c - b'A' + 10),
+            _ => return Err(invalid()),
+        };
+        value = (value << 4) | digit;
+    }
+    Ok(value)
+}
+
+pub fn decode_json_string(
+    reader: &mut impl BufRead,
+    mut sink: impl FnMut(&[u8]) -> io::Result<()>,
+) -> io::Result<()> {
+    if byte(reader)? != b'"' {
+        return Err(invalid());
+    }
+    let mut output = [0_u8; 4096];
+    let mut used = 0;
+    loop {
+        let mut character = [0_u8; 4];
+        let size = match byte(reader)? {
+            b'"' => {
+                if used != 0 {
+                    sink(&output[..used])?;
+                }
+                return Ok(());
+            }
+            b'\\' => match byte(reader)? {
+                c @ (b'"' | b'\\' | b'/') => {
+                    character[0] = c;
+                    1
+                }
+                c @ (b'b' | b'f' | b'n' | b'r' | b't') => {
+                    character[0] = match c {
+                        b'b' => 8,
+                        b'f' => 12,
+                        b'n' => b'\n',
+                        b'r' => b'\r',
+                        _ => b'\t',
+                    };
+                    1
+                }
+                b'u' => {
+                    let first = hex_quad(reader)?;
+                    let scalar = match first {
+                        0xd800..=0xdbff => {
+                            if byte(reader)? != b'\\' || byte(reader)? != b'u' {
+                                return Err(invalid());
+                            }
+                            let second = hex_quad(reader)?;
+                            if !(0xdc00..=0xdfff).contains(&second) {
+                                return Err(invalid());
+                            }
+                            0x10000 + ((first - 0xd800) << 10) + (second - 0xdc00)
+                        }
+                        0xdc00..=0xdfff => return Err(invalid()),
+                        scalar => scalar,
+                    };
+                    char::from_u32(scalar)
+                        .ok_or_else(invalid)?
+                        .encode_utf8(&mut character)
+                        .len()
+                }
+                _ => return Err(invalid()),
+            },
+            c @ 0x20..=0x7f => {
+                character[0] = c;
+                1
+            }
+            first => {
+                let size = match first {
+                    0xc2..=0xdf => 2,
+                    0xe0..=0xef => 3,
+                    0xf0..=0xf4 => 4,
+                    _ => return Err(invalid()),
+                };
+                character[0] = first;
+                for next in &mut character[1..size] {
+                    *next = byte(reader)?;
+                }
+                std::str::from_utf8(&character[..size]).map_err(|_| invalid())?;
+                size
+            }
+        };
+        if used + size > output.len() {
+            sink(&output[..used])?;
+            used = 0;
+        }
+        output[used..used + size].copy_from_slice(&character[..size]);
+        used += size;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::{BufReader, Cursor, Read};
+
+    #[test]
+    fn escapes_unicode_and_delimiter_consumption() {
+        let mut input = BufReader::with_capacity(
+            2,
+            Cursor::new(br#""a\n\u00e9\ud83d\ude00\\\"\/\b\f\r\t",tail"#),
+        );
+        let mut output = Vec::new();
+        decode_json_string(&mut input, |bytes| {
+            output.extend_from_slice(bytes);
+            Ok(())
+        })
+        .unwrap();
+        assert_eq!(
+            String::from_utf8(output).unwrap(),
+            "a\né😀\\\"/\x08\x0c\r\t"
+        );
+        assert_eq!(byte(&mut input).unwrap(), b',');
+        let mut input = BufReader::with_capacity(1, Cursor::new("\"é😀\""));
+        let mut output = Vec::new();
+        decode_json_string(&mut input, |bytes| {
+            output.extend_from_slice(bytes);
+            Ok(())
+        })
+        .unwrap();
+        assert_eq!(String::from_utf8(output).unwrap(), "é😀");
+    }
+
+    #[test]
+    fn a_large_escaped_string_has_only_fixed_decoder_buffers() {
+        // A generated source and counting sink retain neither the encoded nor decoded string.
+        let count = 131_072;
+        struct RepeatedEscape {
+            remaining: usize,
+            position: usize,
+        }
+        impl Read for RepeatedEscape {
+            fn read(&mut self, output: &mut [u8]) -> io::Result<usize> {
+                let count = self.remaining.min(output.len());
+                for value in &mut output[..count] {
+                    *value = b"\\u0061"[self.position % 6];
+                    self.position += 1;
+                }
+                self.remaining -= count;
+                Ok(count)
+            }
+        }
+        let source = Cursor::new(b"\"")
+            .chain(RepeatedEscape {
+                remaining: count * 6,
+                position: 0,
+            })
+            .chain(Cursor::new(b"\""));
+        let mut reader = BufReader::with_capacity(257, source);
+        let mut decoded = 0;
+        decode_json_string(&mut reader, |bytes| {
+            assert!(bytes.len() <= 4096);
+            assert!(bytes.iter().all(|&value| value == b'a'));
+            decoded += bytes.len();
+            Ok(())
+        })
+        .unwrap();
+        assert_eq!(decoded, count);
+    }
+
+    #[test]
+    fn malformed_strings_and_invalid_utf8_reject() {
+        for source in [
+            b"\"\\ud800\"".as_slice(),
+            b"\"\\udc00\"",
+            b"\"\\x\"",
+            b"\"\x01\"",
+            b"\"\xf0\x80\x80\x80\"",
+            b"\"\\ud800\\u0000\"",
+        ] {
+            assert!(decode_json_string(&mut Cursor::new(source), |_| Ok(())).is_err());
+        }
+    }
+}
diff --git a/codex-rs/core/src/session/original_history_lookup.rs b/codex-rs/core/src/session/original_history_lookup.rs
new file mode 100644
index 00000000..89428b45
--- /dev/null
+++ b/codex-rs/core/src/session/original_history_lookup.rs
@@ -0,0 +1,207 @@
+//! Query-local occurrence lookup. Anonymous files contain source positions only.
+use std::collections::hash_map::RandomState;
+use std::fs::File;
+use std::hash::{BuildHasher, Hash, Hasher};
+use std::io::{self, Read, Seek, SeekFrom, Write};
+
+use codex_protocol::models::ResponseItem;
+
+#[derive(Clone, Copy, Default)]
+struct Slot {
+    key: u64,
+    head: u64,
+    tail: u64,
+}
+
+pub(super) struct Occurrences {
+    slots: File,
+    next: File,
+    capacity: u64,
+    hash: RandomState,
+}
+fn invalid() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "invalid original position lookup",
+    )
+}
+impl Occurrences {
+    pub(super) fn new(count: usize) -> io::Result<Self> {
+        let capacity = u64::try_from(count)
+            .map_err(|_| invalid())?
+            .checked_mul(2)
+            .and_then(|n| n.checked_add(1))
+            .and_then(u64::checked_next_power_of_two)
+            .ok_or_else(invalid)?;
+        let slots = tempfile::tempfile()?;
+        slots.set_len(capacity.checked_mul(24).ok_or_else(invalid)?)?;
+        let next = tempfile::tempfile()?;
+        next.set_len((count as u64).checked_mul(8).ok_or_else(invalid)?)?;
+        Ok(Self {
+            slots,
+            next,
+            capacity,
+            hash: RandomState::new(),
+        })
+    }
+    fn slot(&mut self, index: u64) -> io::Result<Slot> {
+        let mut bytes = [0; 24];
+        self.slots
+            .seek(SeekFrom::Start(index.checked_mul(24).ok_or_else(invalid)?))?;
+        self.slots.read_exact(&mut bytes)?;
+        Ok(Slot {
+            key: u64::from_le_bytes(bytes[..8].try_into().unwrap()),
+            head: u64::from_le_bytes(bytes[8..16].try_into().unwrap()),
+            tail: u64::from_le_bytes(bytes[16..].try_into().unwrap()),
+        })
+    }
+    fn put(&mut self, index: u64, slot: Slot) -> io::Result<()> {
+        let mut bytes = [0; 24];
+        for (part, value) in bytes
+            .chunks_exact_mut(8)
+            .zip([slot.key, slot.head, slot.tail])
+        {
+            part.copy_from_slice(&value.to_le_bytes());
+        }
+        self.slots
+            .seek(SeekFrom::Start(index.checked_mul(24).ok_or_else(invalid)?))?;
+        self.slots.write_all(&bytes)
+    }
+    fn hash(&self, item: &ResponseItem) -> io::Result<u64> {
+        let mut hash = self.hash.build_hasher();
+        if let Some(id) = item.id() {
+            hash.write_u8(1);
+            hash.write(id.as_str().as_bytes());
+        } else {
+            hash.write_u8(0);
+            // Value's existing Hash honors object equality even with preserve_order enabled.
+            // This temporary is one projected item, never the catalog or replacement line.
+            serde_json::to_value(item)
+                .map_err(|_| invalid())?
+                .hash(&mut hash);
+        }
+        Ok(hash.finish())
+    }
+    fn find(
+        &mut self,
+        item: &ResponseItem,
+        mut same: impl FnMut(usize) -> io::Result<bool>,
+    ) -> io::Result<(u64, Slot)> {
+        let start = self.hash(item)? & (self.capacity - 1);
+        for step in 0..self.capacity {
+            let index = start.wrapping_add(step) & (self.capacity - 1);
+            let slot = self.slot(index)?;
+            if slot.key == 0 || same(usize::try_from(slot.key - 1).map_err(|_| invalid())?)? {
+                return Ok((index, slot));
+            }
+        }
+        Err(invalid())
+    }
+    pub(super) fn insert(
+        &mut self,
+        item: &ResponseItem,
+        position: usize,
+        same: impl FnMut(usize) -> io::Result<bool>,
+    ) -> io::Result<()> {
+        let pointer = u64::try_from(position)
+            .map_err(|_| invalid())?
+            .checked_add(1)
+            .ok_or_else(invalid)?;
+        let (index, mut slot) = self.find(item, same)?;
+        if slot.key == 0 {
+            slot = Slot {
+                key: pointer,
+                head: pointer,
+                tail: pointer,
+            };
+        } else if item.id().is_some() {
+            slot.head = pointer;
+            slot.tail = pointer;
+        } else {
+            self.next.seek(SeekFrom::Start(
+                (slot.tail - 1).checked_mul(8).ok_or_else(invalid)?,
+            ))?;
+            self.next.write_all(&pointer.to_le_bytes())?;
+            slot.tail = pointer;
+        }
+        self.put(index, slot)
+    }
+    pub(super) fn take(
+        &mut self,
+        item: &ResponseItem,
+        same: impl FnMut(usize) -> io::Result<bool>,
+    ) -> io::Result<Option<usize>> {
+        let (index, mut slot) = self.find(item, same)?;
+        if slot.key == 0 || slot.head == 0 {
+            return Ok(None);
+        }
+        let position = usize::try_from(slot.head - 1).map_err(|_| invalid())?;
+        if item.id().is_some() {
+            slot.head = 0;
+        } else {
+            self.next.seek(SeekFrom::Start(
+                (slot.head - 1).checked_mul(8).ok_or_else(invalid)?,
+            ))?;
+            let mut bytes = [0; 8];
+            self.next.read_exact(&mut bytes)?;
+            slot.head = u64::from_le_bytes(bytes);
+        }
+        self.put(index, slot)?;
+        Ok(Some(position))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    fn message(id: Option<&str>, text: &str) -> ResponseItem {
+        let mut value =
+            json!({"type":"message","role":"user","content":[{"type":"input_text","text":text}]});
+        if let Some(id) = id {
+            value["id"] = id.into();
+        }
+        serde_json::from_value(value).unwrap()
+    }
+    #[test]
+    fn ids_select_last_once_and_idless_items_consume_in_order() {
+        let rows = [
+            message(Some("shared"), "first"),
+            message(Some("shared"), "last"),
+            message(None, "equal"),
+            message(None, "equal"),
+        ];
+        let mut index = Occurrences::new(rows.len()).unwrap();
+        for (position, row) in rows.iter().enumerate() {
+            index
+                .insert(row, position, |other| {
+                    Ok(match (row.id(), rows[other].id()) {
+                        (Some(a), Some(b)) => a == b,
+                        (None, None) => row == &rows[other],
+                        _ => false,
+                    })
+                })
+                .unwrap();
+        }
+        assert_eq!(
+            index
+                .take(&rows[0], |other| Ok(rows[other].id() == rows[0].id()))
+                .unwrap(),
+            Some(1)
+        );
+        assert_eq!(
+            index
+                .take(&rows[0], |other| Ok(rows[other].id() == rows[0].id()))
+                .unwrap(),
+            None
+        );
+        for expected in [Some(2), Some(3), None] {
+            assert_eq!(
+                index
+                    .take(&rows[2], |other| Ok(rows[other] == rows[2]))
+                    .unwrap(),
+                expected
+            );
+        }
+    }
+}
diff --git a/codex-rs/core/src/session/original_history_read.rs b/codex-rs/core/src/session/original_history_read.rs
new file mode 100644
index 00000000..72b861ae
--- /dev/null
+++ b/codex-rs/core/src/session/original_history_read.rs
@@ -0,0 +1,916 @@
+//! Limited original-history snapshots without a second payload catalog.
+#[path = "original_history_stream.rs"]
+mod stream;
+use std::fs::File;
+use std::io::{self, Read, Seek, SeekFrom, Write};
+
+use codex_history::sdk_originals::{SdkOriginalHistoryCheckpoint, SdkOriginalSnapshotFold};
+use codex_history::{ResponseItemEnvelope, RetainedInputSource, RolloutItem};
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::EventMsg;
+use codex_thread_store::{
+    OriginalHistoryReader, OriginalHistorySegment, OriginalHistorySnapshot, ThreadStoreError,
+    ThreadStoreResult,
+};
+use codex_utils_output_truncation::TruncationPolicy;
+
+use crate::context_manager::{
+    ContextManager, is_api_message, is_user_turn_boundary, rollback_context_update,
+    rollback_retained_item,
+};
+
+// Only fixed-size source positions and rewrite flags enter this anonymous query scratch.
+// Original text, projected content, ids and application metadata remain in the owning store.
+#[derive(Clone, Copy, Default)]
+struct Position {
+    kind: u64,
+    record: u64,
+    item: u64,
+}
+#[derive(Clone, Copy, Default)]
+struct Entry {
+    original: Position,
+    projection: Position,
+    strip_developer: bool,
+}
+const ENTRY_BYTES: u64 = 64;
+struct Positions {
+    file: File,
+    len: usize,
+}
+impl Positions {
+    fn new() -> io::Result<Self> {
+        Ok(Self {
+            file: tempfile::tempfile()?,
+            len: 0,
+        })
+    }
+    fn clear(&mut self) -> io::Result<()> {
+        self.file.set_len(0)?;
+        self.len = 0;
+        Ok(())
+    }
+    fn push(&mut self, entry: Entry) -> io::Result<()> {
+        self.write(self.len, entry)?;
+        self.len = self.len.checked_add(1).ok_or_else(invalid)?;
+        Ok(())
+    }
+    fn write(&mut self, index: usize, entry: Entry) -> io::Result<()> {
+        self.file.seek(SeekFrom::Start(
+            (index as u64)
+                .checked_mul(ENTRY_BYTES)
+                .ok_or_else(invalid)?,
+        ))?;
+        for value in [
+            entry.original.kind,
+            entry.original.record,
+            entry.original.item,
+            entry.projection.kind,
+            entry.projection.record,
+            entry.projection.item,
+            u64::from(entry.strip_developer),
+            0,
+        ] {
+            self.file.write_all(&value.to_le_bytes())?;
+        }
+        Ok(())
+    }
+    fn get(&mut self, index: usize) -> io::Result<Entry> {
+        if index >= self.len {
+            return Err(invalid());
+        }
+        self.file.seek(SeekFrom::Start(
+            (index as u64)
+                .checked_mul(ENTRY_BYTES)
+                .ok_or_else(invalid)?,
+        ))?;
+        let mut words = [0u64; 8];
+        for word in &mut words {
+            let mut bytes = [0; 8];
+            self.file.read_exact(&mut bytes)?;
+            *word = u64::from_le_bytes(bytes);
+        }
+        Ok(Entry {
+            original: Position {
+                kind: words[0],
+                record: words[1],
+                item: words[2],
+            },
+            projection: Position {
+                kind: words[3],
+                record: words[4],
+                item: words[5],
+            },
+            strip_developer: words[6] != 0,
+        })
+    }
+}
+fn invalid() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "invalid original history stream",
+    )
+}
+
+pub(super) struct SnapshotReader {
+    pub(super) limit: usize,
+    pub(super) policy: TruncationPolicy,
+}
+impl SnapshotReader {
+    fn native_projection(&self, row: &ResponseItemEnvelope) -> Option<ResponseItemEnvelope> {
+        let mut projected = ContextManager::new();
+        let normalized = if matches!(&row.item, ResponseItem::Message { .. }) {
+            let mut normalized = row.clone();
+            if let Some(content) =
+                codex_context_fragments::to_annotated_content(&mut normalized.item)
+            {
+                let _ =
+                    codex_context_fragments::set_annotated_content(&mut normalized.item, content);
+            }
+            Some(normalized)
+        } else {
+            None
+        };
+        projected.replay_annotated_item(normalized.as_ref().unwrap_or(row), self.policy);
+        projected.annotated_items().last().cloned()
+    }
+    fn row<'a>(&self, items: &'a [RolloutItem], position: Position) -> io::Result<Row<'a>> {
+        let record = items
+            .get(usize::try_from(position.record).map_err(|_| invalid())?)
+            .ok_or_else(invalid)?;
+        match (position.kind, record) {
+            (1, RolloutItem::ResponseItem(row)) => Ok(Row::Native(row)),
+            (2, RolloutItem::Compacted(checkpoint)) => {
+                let Some(SdkOriginalHistoryCheckpoint::Replace(history)) =
+                    &checkpoint.sdk_originals
+                else {
+                    return Err(invalid());
+                };
+                Ok(Row::Original(
+                    history
+                        .items
+                        .get(position.item as usize)
+                        .ok_or_else(invalid)?,
+                ))
+            }
+            (3, RolloutItem::Compacted(checkpoint)) => Ok(Row::Native(
+                checkpoint
+                    .replacement_history
+                    .as_ref()
+                    .and_then(|rows| rows.get(position.item as usize))
+                    .ok_or_else(invalid)?,
+            )),
+            _ => Err(invalid()),
+        }
+    }
+    fn projection(
+        &self,
+        source: &mut dyn OriginalSource,
+        entry: Entry,
+    ) -> io::Result<Option<ResponseItemEnvelope>> {
+        if entry.projection.kind == 0 {
+            return Ok(None);
+        }
+        Ok(source.projection(entry.projection, self)?.and_then(|row| {
+            if entry.strip_developer {
+                let turn = row.turn_id().map(str::to_owned);
+                rollback_retained_item(&row, RetainedInputSource::Inherited, true, turn.as_deref())
+            } else {
+                Some(row)
+            }
+        }))
+    }
+    fn fold_original(
+        &self,
+        source: &mut dyn OriginalSource,
+        entry: Entry,
+        fold: &mut SdkOriginalSnapshotFold,
+    ) -> io::Result<()> {
+        fold.begin_item().map_err(|_| invalid())?;
+        source.original(entry.original, self, fold)?;
+        fold.end_item().map_err(|_| invalid())
+    }
+    fn read(&self, items: &[RolloutItem]) -> io::Result<OriginalHistorySnapshot> {
+        self.read_source(&mut MemorySource::new(items))
+    }
+    fn read_source(&self, source: &mut dyn OriginalSource) -> io::Result<OriginalHistorySnapshot> {
+        // Identify the final replacement and whether its suffix has rollback. No payload retained.
+        let mut generation = 0usize;
+        let mut total = 0usize;
+        let mut has_rollback = false;
+        while let Some(action) = source.next(self)? {
+            match action {
+                Action::Reset => {
+                    generation = generation.checked_add(1).ok_or_else(invalid)?;
+                    total = 0;
+                    has_rollback = false;
+                }
+                Action::Append(_) => total = total.checked_add(1).ok_or_else(invalid)?,
+                Action::Rollback(_) => has_rollback = true,
+            }
+        }
+        source.rewind()?;
+        let mut seen_generation = 0usize;
+        if !has_rollback {
+            let mut fold = SdkOriginalSnapshotFold::new(total, self.limit);
+            while let Some(action) = source.next(self)? {
+                match action {
+                    Action::Reset => seen_generation += 1,
+                    Action::Append(entry) if seen_generation == generation => {
+                        self.fold_original(source, entry, &mut fold)?
+                    }
+                    _ => {}
+                }
+            }
+            if seen_generation != generation {
+                return Err(invalid());
+            }
+            return fold.finish().map_err(|_| invalid());
+        }
+        // Rollback needs only an ephemeral sparse sequence of source positions.
+        let mut positions = Positions::new()?;
+        while let Some(action) = source.next(self)? {
+            match action {
+                Action::Reset => {
+                    seen_generation += 1;
+                }
+                Action::Append(entry) if seen_generation == generation => positions.push(entry)?,
+                Action::Rollback(turns) if seen_generation == generation => {
+                    self.rollback(source, &mut positions, turns)?
+                }
+                _ => {}
+            }
+        }
+        if seen_generation != generation {
+            return Err(invalid());
+        }
+        let mut fold = SdkOriginalSnapshotFold::new(positions.len, self.limit);
+        for index in 0..positions.len {
+            self.fold_original(source, positions.get(index)?, &mut fold)?;
+        }
+        fold.finish().map_err(|_| invalid())
+    }
+    fn rollback(
+        &self,
+        source: &mut dyn OriginalSource,
+        positions: &mut Positions,
+        turns: u32,
+    ) -> io::Result<()> {
+        let mut boundaries = 0usize;
+        let mut projection_total = 0usize;
+        for index in 0..positions.len {
+            if let Some(row) = self.projection(source, positions.get(index)?)? {
+                projection_total = projection_total.checked_add(1).ok_or_else(invalid)?;
+                if is_user_turn_boundary(&row.item) {
+                    boundaries = boundaries.checked_add(1).ok_or_else(invalid)?;
+                }
+            }
+        }
+        let unchanged_projection = turns == 0 || boundaries == 0;
+        let removed_boundary = boundaries.saturating_sub(turns as usize);
+        let mut seen_boundaries = 0;
+        let mut projection_index = 0;
+        let mut first = None;
+        let mut first_turn = None;
+        let mut context_start = None;
+        let mut cut = unchanged_projection.then_some(projection_total);
+        let mut rollback_source = RetainedInputSource::Inherited;
+        for index in 0..positions.len {
+            if unchanged_projection {
+                break;
+            }
+            let Some(row) = self.projection(source, positions.get(index)?)? else {
+                continue;
+            };
+            if is_user_turn_boundary(&row.item) {
+                if first.is_none() {
+                    first = Some(projection_index);
+                    first_turn = row.turn_id().map(str::to_owned);
+                }
+                if seen_boundaries == removed_boundary {
+                    cut = Some(
+                        context_start
+                            .unwrap_or(projection_index)
+                            .max(first.unwrap()),
+                    );
+                    rollback_source = RetainedInputSource::from(row.metadata.as_ref());
+                    break;
+                }
+                seen_boundaries += 1;
+            }
+            if rollback_context_update(&row.item).is_some() {
+                context_start.get_or_insert(projection_index);
+            } else {
+                context_start = None;
+            }
+            projection_index += 1;
+        }
+        let cut = cut.ok_or_else(invalid)?;
+        let mut retained = Positions::new()?;
+        projection_index = 0;
+        for index in 0..positions.len {
+            let mut entry = positions.get(index)?;
+            let Some(row) = self.projection(source, entry)? else {
+                continue;
+            };
+            if projection_index >= cut {
+                break;
+            }
+            projection_index += 1;
+            if let Some(kept) = rollback_retained_item(
+                &row,
+                rollback_source,
+                Some(cut) == first,
+                first_turn.as_deref(),
+            ) {
+                entry.strip_developer |= kept.item != row.item;
+                retained.push(entry)?;
+            }
+        }
+        // Preserve the existing occurrence-consuming raw/audit boundary, including legacy ids.
+        let mut next_retained_user = 0;
+        let mut boundary = positions.len;
+        for index in 0..positions.len {
+            let Some(row) = self.projection(source, positions.get(index)?)? else {
+                continue;
+            };
+            if !matches!(&row.item, ResponseItem::Message { role, .. } if role == "user") {
+                continue;
+            }
+            let mut found = false;
+            while next_retained_user < retained.len {
+                let kept = self
+                    .projection(source, retained.get(next_retained_user)?)?
+                    .ok_or_else(invalid)?;
+                if !matches!(&kept.item, ResponseItem::Message { role, .. } if role == "user") {
+                    next_retained_user += 1;
+                    continue;
+                }
+                found = row
+                    .item
+                    .id()
+                    .map_or_else(|| kept.item == row.item, |id| kept.item.id() == Some(id));
+                if found {
+                    next_retained_user += 1;
+                }
+                break;
+            }
+            if !found {
+                boundary = index;
+                break;
+            }
+        }
+        let mut occurrences = super::original_history_lookup::Occurrences::new(retained.len)?;
+        for candidate in 0..retained.len {
+            let row = self
+                .projection(source, retained.get(candidate)?)?
+                .ok_or_else(invalid)?;
+            occurrences.insert(&row.item, candidate, |other| {
+                let kept = self
+                    .projection(source, retained.get(other)?)?
+                    .ok_or_else(invalid)?;
+                Ok(same_occurrence_key(&row.item, &kept.item))
+            })?;
+        }
+        let mut result = Positions::new()?;
+        for index in 0..boundary {
+            let mut entry = positions.get(index)?;
+            let Some(row) = self.projection(source, entry)? else {
+                result.push(entry)?;
+                continue;
+            };
+            let matched = occurrences.take(&row.item, |other| {
+                let kept = self
+                    .projection(source, retained.get(other)?)?
+                    .ok_or_else(invalid)?;
+                Ok(same_occurrence_key(&row.item, &kept.item))
+            })?;
+            if let Some(candidate) = matched {
+                let reference = retained.get(candidate)?;
+                entry.projection = reference.projection;
+                entry.strip_developer = reference.strip_developer;
+                result.push(entry)?;
+            }
+        }
+        *positions = result;
+        Ok(())
+    }
+}
+enum Action {
+    Reset,
+    Append(Entry),
+    Rollback(u32),
+}
+trait OriginalSource {
+    fn next(&mut self, reader: &SnapshotReader) -> io::Result<Option<Action>>;
+    fn rewind(&mut self) -> io::Result<()>;
+    fn projection(
+        &mut self,
+        position: Position,
+        reader: &SnapshotReader,
+    ) -> io::Result<Option<ResponseItemEnvelope>>;
+    fn original(
+        &mut self,
+        position: Position,
+        reader: &SnapshotReader,
+        fold: &mut SdkOriginalSnapshotFold,
+    ) -> io::Result<()>;
+}
+struct MemorySource<'a> {
+    items: &'a [RolloutItem],
+    record: usize,
+    nested: Option<usize>,
+}
+impl<'a> MemorySource<'a> {
+    fn new(items: &'a [RolloutItem]) -> Self {
+        Self {
+            items,
+            record: 0,
+            nested: None,
+        }
+    }
+}
+impl OriginalSource for MemorySource<'_> {
+    fn rewind(&mut self) -> io::Result<()> {
+        self.record = 0;
+        self.nested = None;
+        Ok(())
+    }
+    fn next(&mut self, _reader: &SnapshotReader) -> io::Result<Option<Action>> {
+        loop {
+            let Some(record) = self.items.get(self.record) else {
+                return Ok(None);
+            };
+            let base = Position {
+                kind: 1,
+                record: self.record as u64,
+                item: 0,
+            };
+            if let Some(nested) = self.nested {
+                let RolloutItem::Compacted(checkpoint) = record else {
+                    return Err(invalid());
+                };
+                self.nested = Some(nested.checked_add(1).ok_or_else(invalid)?);
+                let entry = match &checkpoint.sdk_originals {
+                    Some(SdkOriginalHistoryCheckpoint::Replace(history)) => {
+                        history.items.get(nested).map(|row| {
+                            let position = Position {
+                                kind: 2,
+                                item: nested as u64,
+                                ..base
+                            };
+                            Entry {
+                                original: position,
+                                projection: if row.projection.is_some() {
+                                    position
+                                } else {
+                                    Position::default()
+                                },
+                                ..Default::default()
+                            }
+                        })
+                    }
+                    None => checkpoint
+                        .replacement_history
+                        .as_ref()
+                        .and_then(|rows| rows.get(nested))
+                        .map(|row| {
+                            let position = Position {
+                                kind: 3,
+                                item: nested as u64,
+                                ..base
+                            };
+                            Entry {
+                                original: position,
+                                projection: if is_api_message(&row.item, row.metadata.as_ref()) {
+                                    position
+                                } else {
+                                    Position::default()
+                                },
+                                ..Default::default()
+                            }
+                        }),
+                    _ => return Err(invalid()),
+                };
+                if let Some(entry) = entry {
+                    if entry.original.kind == 3 && entry.projection.kind == 0 {
+                        continue;
+                    }
+                    return Ok(Some(Action::Append(entry)));
+                }
+                self.nested = None;
+                self.record += 1;
+                continue;
+            }
+            match record {
+                RolloutItem::ResponseItem(row) => {
+                    self.record += 1;
+                    if is_api_message(&row.item, row.metadata.as_ref()) {
+                        return Ok(Some(Action::Append(Entry {
+                            original: base,
+                            projection: base,
+                            ..Default::default()
+                        })));
+                    }
+                }
+                RolloutItem::Compacted(checkpoint)
+                    if matches!(
+                        &checkpoint.sdk_originals,
+                        Some(SdkOriginalHistoryCheckpoint::Replace(_))
+                    ) || (checkpoint.sdk_originals.is_none()
+                        && checkpoint.replacement_history.is_some()) =>
+                {
+                    self.nested = Some(0);
+                    return Ok(Some(Action::Reset));
+                }
+                RolloutItem::EventMsg(EventMsg::ThreadRolledBack(event)) => {
+                    self.record += 1;
+                    return Ok(Some(Action::Rollback(event.num_turns)));
+                }
+                _ => self.record += 1,
+            }
+        }
+    }
+    fn projection(
+        &mut self,
+        position: Position,
+        reader: &SnapshotReader,
+    ) -> io::Result<Option<ResponseItemEnvelope>> {
+        Ok(match reader.row(self.items, position)? {
+            Row::Native(row) => reader.native_projection(row),
+            Row::Original(row) => row.projection.clone(),
+        })
+    }
+    fn original(
+        &mut self,
+        position: Position,
+        reader: &SnapshotReader,
+        fold: &mut SdkOriginalSnapshotFold,
+    ) -> io::Result<()> {
+        match reader.row(self.items, position)? {
+            Row::Native(row) => {
+                serde_json::to_writer(FoldWriter(fold), &row.item).map_err(|_| invalid())
+            }
+            Row::Original(row) => fold
+                .write_item(row.original.as_bytes())
+                .map_err(|_| invalid()),
+        }
+    }
+}
+
+fn same_occurrence_key(left: &ResponseItem, right: &ResponseItem) -> bool {
+    match (left.id(), right.id()) {
+        (Some(left), Some(right)) => left == right,
+        (None, None) => left == right,
+        _ => false,
+    }
+}
+
+enum Row<'a> {
+    Native(&'a ResponseItemEnvelope),
+    Original(&'a codex_history::sdk_originals::SdkOriginalItem),
+}
+struct FoldWriter<'a>(&'a mut SdkOriginalSnapshotFold);
+impl Write for FoldWriter<'_> {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.0.write_item(bytes).map_err(|_| invalid())?;
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+impl OriginalHistoryReader for SnapshotReader {
+    fn read_items(&mut self, items: &[RolloutItem]) -> ThreadStoreResult<OriginalHistorySnapshot> {
+        self.read(items).map_err(|_| ThreadStoreError::Internal {
+            message: "original history stream unavailable".to_string(),
+        })
+    }
+    fn read_segments(
+        &mut self,
+        _segments: &[OriginalHistorySegment],
+    ) -> ThreadStoreResult<OriginalHistorySnapshot> {
+        self.read_source(&mut stream::LocalSource::new(_segments))
+            .map_err(|_| ThreadStoreError::Internal {
+                message: "original history stream unavailable".into(),
+            })
+    }
+}
+
