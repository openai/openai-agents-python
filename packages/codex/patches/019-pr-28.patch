@@ -0,0 +1,261 @@
+//! Provider-executed Responses tools. These declarations never register local executors.
+use serde::{Deserialize, Serialize};
+
+/// Trusted host declarations, captured before each step selects its tool catalog.
+#[derive(Debug, Clone, Default, Serialize, Deserialize, PartialEq)]
+pub struct HostedModelTools {
+    pub tools: Vec<HostedToolSpec>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum HostedToolSpec {
+    FileSearch(FileSearchTool),
+    CodeInterpreter(CodeInterpreterTool),
+    ImageGeneration(ImageGenerationTool),
+}
+
+impl From<HostedToolSpec> for crate::ToolSpec {
+    fn from(spec: HostedToolSpec) -> Self {
+        match spec {
+            HostedToolSpec::FileSearch(config) => Self::FileSearch(config),
+            HostedToolSpec::CodeInterpreter(config) => Self::CodeInterpreter(config),
+            HostedToolSpec::ImageGeneration(config) => Self::ImageGeneration(config),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+#[serde(untagged)]
+pub enum CodeInterpreterContainer {
+    Existing(String),
+    Auto(AutoCodeInterpreterContainer),
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum CodeInterpreterNetworkPolicy {
+    Disabled,
+    Allowlist {
+        allowed_domains: Vec<String>,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        domain_secrets: Option<Vec<CodeInterpreterDomainSecret>>,
+    },
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct FileSearchTool {
+    #[serde(flatten)]
+    pub provider_data: serde_json::Map<String, serde_json::Value>,
+    pub vector_store_ids: Vec<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub filters: Option<serde_json::Value>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub max_num_results: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub ranking_options: Option<FileSearchRankingOptions>,
+    /// Requests raw results through the top-level Responses include list.
+    #[serde(default, skip_serializing)]
+    pub include_search_results: bool,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct FileSearchRankingOptions {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub ranker: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub score_threshold: Option<f64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub hybrid_search: Option<FileSearchHybridSearch>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct FileSearchHybridSearch {
+    pub embedding_weight: f64,
+    pub text_weight: f64,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct CodeInterpreterTool {
+    #[serde(default = "include_outputs_default", skip_serializing)]
+    pub include_outputs: bool,
+    #[serde(flatten)]
+    pub provider_data: serde_json::Map<String, serde_json::Value>,
+    pub container: CodeInterpreterContainer,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub allowed_callers: Option<Vec<String>>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct AutoCodeInterpreterContainer {
+    #[serde(rename = "type")]
+    pub kind: AutoCodeInterpreterContainerKind,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub file_ids: Option<Vec<String>>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub memory_limit: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub network_policy: Option<CodeInterpreterNetworkPolicy>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct CodeInterpreterDomainSecret {
+    pub domain: String,
+    pub name: String,
+    pub value: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct ImageGenerationTool {
+    #[serde(flatten)]
+    pub provider_data: serde_json::Map<String, serde_json::Value>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub action: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub background: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub complexity: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub input_fidelity: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub model: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub moderation: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub output_format: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub quality: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub size: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub frame_count: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub frame_duration_ms: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub output_compression: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub partial_images: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub input_image_mask: Option<ImageGenerationMask>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub svg: Option<ImageGenerationSvg>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct ImageGenerationMask {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub file_id: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub image_url: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct ImageGenerationSvg {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub model: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub reasoning: Option<ImageGenerationSvgReasoning>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct ImageGenerationSvgReasoning {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub effort: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub enum AutoCodeInterpreterContainerKind {
+    #[serde(rename = "auto")]
+    Auto,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn hosted_declarations_serialize_provider_fields_without_include_flag() {
+        let input = json!({"tools": [
+            {"type":"file_search", "vector_store_ids":["vs_test"],
+             "filters":{"type":"and", "filters":[{"type":"eq", "key":"team", "value":"docs"}]},
+             "max_num_results":4, "ranking_options":{"hybrid_search":{"embedding_weight":0.8,"text_weight":0.2}},
+             "include_search_results":true},
+            {"type":"code_interpreter", "container":{"type":"auto", "file_ids":["file_test"],
+             "memory_limit":"4g", "network_policy":{"type":"disabled"}}},
+            {"type":"image_generation", "model":"gpt-image-2", "action":"edit", "quality":"high",
+             "size":"1024x1024", "background":"transparent", "partial_images":2,
+             "input_image_mask":{"image_url":"data:image/png;base64,AA=="}}
+        ]});
+        let tools: HostedModelTools = serde_json::from_value(input.clone()).unwrap();
+        let specs: Vec<crate::ToolSpec> = tools.tools.into_iter().map(Into::into).collect();
+        let mut expected = input["tools"].clone();
+        expected[0]
+            .as_object_mut()
+            .unwrap()
+            .remove("include_search_results");
+        assert_eq!(serde_json::to_value(&specs).unwrap(), expected);
+        assert!(
+            matches!(&specs[0], crate::ToolSpec::FileSearch(config) if config.include_search_results)
+        );
+        assert_eq!(
+            specs.iter().map(crate::ToolSpec::name).collect::<Vec<_>>(),
+            vec!["file_search", "code_interpreter", "image_generation"]
+        );
+    }
+
+    #[test]
+    fn hosted_container_accepts_existing_id_and_rejects_wrong_auto_discriminator() {
+        let existing: HostedToolSpec = serde_json::from_value(json!({
+            "type":"code_interpreter", "container":"cntr_test"
+        }))
+        .unwrap();
+        assert_eq!(
+            serde_json::to_value(existing).unwrap()["container"],
+            "cntr_test"
+        );
+        assert!(
+            serde_json::from_value::<HostedToolSpec>(json!({
+                "type":"code_interpreter", "container":{"type":"container_auto"}
+            }))
+            .is_err()
+        );
+    }
+}
+
+fn include_outputs_default() -> bool {
+    true
+}
+
+#[cfg(test)]
+mod option_fidelity_tests {
+    use super::*;
+
+    #[test]
+    fn hosted_provider_fields_survive_without_sdk_include_controls() {
+        for value in [
+            serde_json::json!({"type":"file_search", "vector_store_ids":["vs_test"], "future_option":{"nested":[true, null]}}),
+            serde_json::json!({"type":"code_interpreter", "container":"cntr_test", "future_option":{"nested":[true, null]}}),
+            serde_json::json!({"type":"image_generation", "future_option":{"nested":[true, null]}}),
+        ] {
+            let spec: HostedToolSpec = serde_json::from_value(value.clone()).unwrap();
+            assert_eq!(serde_json::to_value(spec).unwrap(), value);
+        }
+    }
+
+    #[test]
+    fn code_output_inclusion_defaults_true_and_is_not_a_provider_field() {
+        for include in [None, Some(false), Some(true)] {
+            let mut value = serde_json::json!({"container":"cntr_test"});
+            if let Some(include) = include {
+                value["include_outputs"] = include.into();
+            }
+            let config: CodeInterpreterTool = serde_json::from_value(value).unwrap();
+            assert_eq!(config.include_outputs, include.unwrap_or(true));
+            assert_eq!(
+                serde_json::to_value(config).unwrap(),
+                serde_json::json!({"container":"cntr_test"})
+            );
+        }
+    }
+}
