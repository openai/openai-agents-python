+        .unwrap(),
+    );
+    let step = StepContext::for_test(Arc::new(turn));
+    let result = super::build_tool_router(
+        &session,
+        step.turn.as_ref(),
+        &step.settings.model_info,
+        &step.environments,
+        &step.mcp,
+        false,
+        &step.extension_data,
+        None,
