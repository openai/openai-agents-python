+    ] {
+        let item = serde_json::from_value(value).unwrap();
+        assert!(
+            super::finalize_non_tool_response_item(
+                &session,
+                super::TurnItemContributorPolicy::Skip,
+                &item,
+                false,
+            )
+            .await
+            .is_some()
+        );
+    }
+}
