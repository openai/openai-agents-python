+// A retained compaction excerpt no longer shares the original part's offsets.
+fn truncate_text_content(item: &mut ContentItem, remaining: &mut usize) -> bool {
+    let (text, annotations) = match item {
+        ContentItem::InputText { text } => (text, None),
+        ContentItem::OutputText { text, annotations } => (text, Some(annotations)),
+        _ => return false,
+    };
+    if *remaining == 0 {
+        return false;
+    }
+    let token_count = approx_token_count(text);
+    if token_count <= *remaining {
+        *remaining -= token_count;
+    } else {
+        *text = truncate_text(text, TruncationPolicy::Tokens(*remaining));
+        if let Some(annotations) = annotations {
+            *annotations = None;
+        }
+        *remaining = 0;
+    }
+    !text.is_empty()
+}
