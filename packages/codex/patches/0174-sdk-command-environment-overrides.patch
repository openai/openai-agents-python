+#[test]
+fn sdk_environment_overrides_preserve_exact_payload_values_after_filtering() {
+    use codex_protocol::config_types::{EnvironmentVariablePattern, ShellEnvironmentPolicyInherit};
+    let mut policy = ShellEnvironmentPolicy {
+        inherit: ShellEnvironmentPolicyInherit::All,
+        include_only: vec![EnvironmentVariablePattern::new_case_insensitive("KEEP")],
+        r#set: HashMap::from([("ORDINARY".to_owned(), "filtered".to_owned())]),
+        ..Default::default()
+    };
+    let inherited = HashMap::from([
+        ("KEEP".to_owned(), "same".to_owned()),
+        ("LITERAL".to_owned(), "excluded".to_owned()),
+        ("LITX".to_owned(), "excluded".to_owned()),
+    ]);
+    let baseline =
+        codex_protocol::shell_environment::create_env_from_vars(inherited, &policy, None);
+    assert_eq!(baseline.get("KEEP"), Some(&"same".to_owned()));
+    let selected = HashMap::from([
+        ("SDK_NORMAL".to_owned(), "private-value".to_owned()),
+        ("LIT*".to_owned(), "star".to_owned()),
+        ("LIT?".to_owned(), "question".to_owned()),
+        ("KEEP".to_owned(), "same".to_owned()),
+        ("TERM".to_owned(), "xterm".to_owned()),
+        ("LANG".to_owned(), "fr_FR".to_owned()),
+        ("PATH".to_owned(), "/upper".to_owned()),
+        ("Path".to_owned(), "/mixed".to_owned()),
+    ]);
+    policy.set_sdk_environment_overrides(selected.clone());
+    let payload =
+        apply_sdk_environment_overrides(apply_unified_exec_env(baseline.clone()), &policy);
+    for (name, value) in &selected {
+        assert_eq!(payload.get(name), Some(value));
+    }
+    assert!(!payload.contains_key("LITERAL"));
+    assert!(!payload.contains_key("LITX"));
+    assert!(!payload.contains_key("ORDINARY"));
+    assert!(!format!("{policy:?}").contains("private-value"));
+    let cwd: codex_utils_absolute_path::AbsolutePathBuf =
+        std::env::current_dir().unwrap().try_into().unwrap();
+    let permission_profile = codex_protocol::models::PermissionProfile::Disabled;
+    let mut request = ExecRequest {
+        command: vec!["bash".to_string(), "-lc".to_string(), "true".to_string()],
+        cwd: cwd.clone().into(),
+        env: HashMap::from([
+            ("HOME".to_string(), "/client-home".to_string()),
+            ("PATH".to_string(), "/sandbox-path".to_string()),
+            ("CODEX_THREAD_ID".to_string(), "thread-1".to_string()),
+            (
+                "HTTP_PROXY".to_string(),
+                "http://127.0.0.1:43123".to_string(),
+            ),
+            ("CODEX_NETWORK_PROXY_ACTIVE".to_string(), "1".to_string()),
+            (
+                "SSL_CERT_FILE".to_string(),
+                "/client/custom-ca.pem".to_string(),
+            ),
+        ]),
+        exec_server_env_config: Some(ExecServerEnvConfig {
+            sdk_env_override_names: Default::default(),
+            policy: codex_exec_server::ExecEnvPolicy {
+                inherit: codex_protocol::config_types::ShellEnvironmentPolicyInherit::Core,
+                ignore_default_excludes: false,
+                exclude: Vec::new(),
+                r#set: HashMap::new(),
+                include_only: Vec::new(),
+            },
+            local_policy_env: HashMap::from([
+                ("HOME".to_string(), "/client-home".to_string()),
+                ("PATH".to_string(), "/client-path".to_string()),
+                (
+                    "HTTP_PROXY".to_string(),
+                    "http://127.0.0.1:43123".to_string(),
+                ),
+                ("CODEX_NETWORK_PROXY_ACTIVE".to_string(), "1".to_string()),
+                (
+                    "SSL_CERT_FILE".to_string(),
+                    "/client/custom-ca.pem".to_string(),
+                ),
+            ]),
+        }),
+        exec_server_shell_snapshot: None,
+        network: None,
+        network_environment_id: None,
+        expiration: crate::exec::ExecExpiration::DefaultTimeout,
+        capture_policy: crate::exec::ExecCapturePolicy::ShellTool,
+        sandbox: codex_sandboxing::SandboxType::None,
+        windows_sandbox_policy_cwd: cwd.clone().into(),
+        windows_sandbox_workspace_roots: vec![cwd],
+        windows_sandbox_level: codex_protocol::config_types::WindowsSandboxLevel::Disabled,
+        permission_profile: permission_profile.clone(),
+        windows_sandbox_filesystem_overrides: None,
+        arg0: None,
+        exec_server_sandbox: None,
+        exec_server_enforce_managed_network: true,
+        exec_server_managed_network: None,
+        exec_server_network_proxy: None,
+    };
+    request.env = payload;
+    let config = request.exec_server_env_config.as_mut().unwrap();
+    config.policy = exec_env_policy_from_shell_policy(&policy);
+    config.local_policy_env = baseline;
+    config.sdk_env_override_names = selected.keys().cloned().collect();
+    let (remote_policy, remote_env) = exec_server_env_for_request(&request);
+    for (name, value) in &selected {
+        assert_eq!(remote_env.get(name), Some(value));
+    }
+    let remote_policy = remote_policy.unwrap();
+    assert_eq!(remote_policy.include_only, vec!["KEEP".to_owned()]);
+    assert_eq!(
+        remote_policy.r#set,
+        HashMap::from([("ORDINARY".to_owned(), "filtered".to_owned())])
+    );
+    assert!(!remote_env.contains_key("LITERAL"));
+    assert!(!remote_env.contains_key("LITX"));
+    request
+        .exec_server_env_config
+        .as_mut()
+        .unwrap()
+        .sdk_env_override_names = std::collections::HashSet::from(["Path".to_owned()]);
+    let local = local_sdk_environment_for_request(&request);
+    assert_eq!(local.get("Path"), Some(&"/mixed".to_owned()));
+    if cfg!(windows) {
+        assert!(!local.contains_key("PATH"));
+    } else {
+        assert_eq!(local.get("PATH"), Some(&"/upper".to_owned()));
+    }
+    policy.set_sdk_environment_overrides(HashMap::new());
+    assert!(policy.sdk_environment_overrides().next().is_none());
+}
