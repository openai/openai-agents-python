+fn apply_sdk_environment_overrides(
+    mut inherited: HashMap<String, String>,
+    policy: &ShellEnvironmentPolicy,
+) -> HashMap<String, String> {
+    // Preserve exact names until the selected receiver applies its native identity.
+    inherited.extend(
+        policy
+            .sdk_environment_overrides()
+            .map(|(name, value)| (name.to_owned(), value.to_owned())),
+    );
+    inherited
+}
+
+// This runs only at the direct local spawn boundary: controller and receiver match.
+#[cfg(any(windows, test))]
+fn local_sdk_environment_for_request(request: &ExecRequest) -> HashMap<String, String> {
+    let mut inherited = request.env.clone();
+    let Some(config) = &request.exec_server_env_config else {
+        return inherited;
+    };
+    let overrides = config
+        .sdk_env_override_names
+        .iter()
+        .filter_map(|name| inherited.remove_entry(name))
+        .map(|(name, value)| (name.into(), value.into()))
+        .collect();
+    codex_protocol::shell_environment::merge_env_overrides(
+        inherited
+            .into_iter()
+            .map(|(name, value)| (name.into(), value.into()))
+            .collect(),
+        overrides,
+    )
+    .into_iter()
+    .map(|(name, value)| {
+        (
+            name.into_string().expect("Unicode environment name"),
+            value.into_string().expect("Unicode environment value"),
+        )
+    })
+    .collect()
+}
