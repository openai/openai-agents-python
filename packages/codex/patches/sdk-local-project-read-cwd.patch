+++ b/codex-rs/core/src/project_read_path.rs
@@ -0,0 +1,37 @@
+//! Host-installed mapping for reads relative to an admitted local cwd alias.
+use codex_utils_path_uri::{PathUri, PathUriParseError};
+
+#[doc(hidden)]
+pub struct ProjectReadPathMapping {
+    pub environment_id: String,
+    pub declared_cwd: PathUri,
+    pub canonical_cwd: PathUri,
+}
+
+impl ProjectReadPathMapping {
+    pub fn cwd<'a>(&'a self, environment_id: &str, cwd: &'a PathUri) -> &'a PathUri {
+        if self.environment_id == environment_id && &self.declared_cwd == cwd {
+            &self.canonical_cwd
+        } else {
+            cwd
+        }
+    }
+
+    pub fn resolve(
+        mapping: Option<&Self>,
+        environment_id: &str,
+        cwd: &PathUri,
+        path: &str,
+    ) -> Result<PathUri, PathUriParseError> {
+        if let Some(mapping) = mapping
+            && mapping.cwd(environment_id, cwd) != cwd
+        {
+            if let Ok(descendant) = cwd.join_descendant(path) {
+                if let Some(suffix) = descendant.relative_path_from(cwd) {
+                    return mapping.canonical_cwd.join_descendant(&suffix);
+                }
+            }
+        }
+        cwd.join(path)
+    }
+}
