 pub(crate) struct ValidatedToolCompletion(pub(crate) codex_protocol::protocol::ToolTurnCompletion);
 
+/// One accepted use on the current captured profile, owned by this logical turn.
+struct ToolChoiceUse {
+    profile: Option<codex_extension_api::AgentProfileReceipt>,
+}
+
+pub(super) fn tool_choice_reset_applies(
+    settings: &super::step_settings::ResolvedStepSettings,
+    store: &codex_extension_api::ExtensionData,
+) -> bool {
+    settings.request_controls().reset_tool_choice.flatten() == Some(true)
+        && store.get::<ToolChoiceUse>().is_some_and(|used| {
+            used.profile.as_ref()
+                == settings
+                    .agent_profile
+                    .as_ref()
+                    .map(|profile| &profile.receipt)
+        })
+}
+
+fn record_tool_choice_use(
+    settings: &super::step_settings::ResolvedStepSettings,
+    store: &codex_extension_api::ExtensionData,
+    tools: &SettledDirectTools,
+) {
+    if settings.request_controls().reset_tool_choice.flatten() == Some(true)
+        && !tools.calls.is_empty()
+        && !tools.outputs.is_empty()
+    {
+        store.insert(ToolChoiceUse {
+            profile: settings
+                .agent_profile
+                .as_ref()
+                .map(|profile| profile.receipt.clone()),
+        });
+    }
+}
