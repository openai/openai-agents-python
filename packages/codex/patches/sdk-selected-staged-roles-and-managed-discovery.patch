+/// Process-local ancestry for an SDK-owned thread opening.
+pub struct OpeningContext(Context);
+
+impl OpeningContext {
+    pub fn resolve(token: &str) -> Result<Self, String> {
+        context(token).map(explicit_submission_context).map(Self)
+    }
+
+    pub async fn scope<F: std::future::Future>(self, future: F) -> F::Output {
+        future.with_context(self.0).await
+    }
+}
