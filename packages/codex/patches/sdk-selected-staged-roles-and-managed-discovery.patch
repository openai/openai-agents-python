+fn start_sdk_mcp_discovery_span(server: &str) -> Option<sdk_trace::ProviderResponseSpan> {
+    let policy = sdk_trace::current_scope_policy()?;
+    // Synchronous host policy and custom IDs require admission by the host loop.
+    // A runtime-only observer span cannot stand in for that admission.
+    if policy.disabled || policy.named_tool_policy {
+        return None;
+    }
+    let parent = sdk_trace::ContextLease::capture()?;
+    sdk_trace::start_sdk_semantic_span(&parent, None, server.to_owned(), "mcp_tools").ok()
+}
