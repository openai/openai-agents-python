+#[test]
+fn shared_layers_preserve_detached_exports_and_raw_source() {
+    let temporary = TempDir::new().expect("tempdir");
+    let file = test_user_config_path(&temporary, "config.toml");
+    let folder = test_user_config_path(&temporary, "hook-source");
+    let raw = "model = \"original\"\n";
+    let layer = ConfigLayerEntry::new_with_raw_toml(
+        ConfigLayerSource::User {
+            file: file.clone(),
+            profile: None,
+        },
+        toml::from_str(raw).expect("config"),
+        raw.to_owned(),
+        AbsolutePathBuf::from_absolute_path(temporary.path()).expect("absolute tempdir"),
+    )
+    .with_hooks_config_folder_override(Some(folder.clone()));
+    let stack = ConfigLayerStack::new(
+        vec![layer],
+        ConfigRequirements::default(),
+        ConfigRequirementsToml::default(),
+    )
+    .expect("stack");
+    let snapshot = stack.clone();
+    let mut detached_entry = snapshot
+        .get_active_user_layer()
+        .expect("user layer")
+        .clone();
+    detached_entry.config["model"] = TomlValue::String("changed-entry".into());
+    detached_entry.disabled_reason = Some("detached".into());
+    let mut detached_export = snapshot
+        .get_active_user_layer()
+        .expect("user layer")
+        .as_layer();
+    detached_export.config["model"] = serde_json::Value::String("changed-export".into());
+    let mut detached_effective = snapshot.effective_config();
+    detached_effective["model"] = TomlValue::String("changed-effective".into());
+    let mut detached_origins = snapshot.origins();
+    detached_origins.clear();
+    assert!(detached_origins.is_empty());
+    for unchanged in [&stack, &snapshot] {
+        let entry = unchanged.get_active_user_layer().expect("user layer");
+        assert_eq!(entry.raw_toml(), Some(raw));
+        assert_eq!(entry.hooks_config_folder(), Some(folder.clone()));
+        assert!(!entry.is_disabled());
+        assert_eq!(
+            unchanged.effective_config()["model"].as_str(),
+            Some("original")
+        );
+        assert!(unchanged.origins().contains_key("model"));
+        assert_eq!(entry.as_layer().config["model"].as_str(), Some("original"));
+    }
+    let changed = snapshot
+        .with_user_config(
+            &file,
+            toml::from_str("model = \"replaced\"").expect("replacement"),
+        )
+        .expect("changed stack");
+    assert_eq!(
+        changed.effective_config()["model"].as_str(),
+        Some("replaced")
+    );
+    assert!(
+        changed
+            .get_active_user_layer()
+            .expect("new entry")
+            .raw_toml()
+            .is_none()
+    );
+    assert_eq!(
+        stack.get_active_user_layer().expect("old entry").raw_toml(),
+        Some(raw)
+    );
+}
+
+#[test]
+fn shared_layers_preserve_replacement_isolation_and_non_user_layers() {
+    let temporary = TempDir::new().expect("tempdir");
+    let file = test_user_config_path(&temporary, "config.toml");
+    let original = ConfigLayerStack::new(
+        vec![
+            ConfigLayerEntry::new(
+                ConfigLayerSource::User {
+                    file: file.clone(),
+                    profile: None,
+                },
+                toml::from_str("model = \"original\"").expect("user config"),
+            ),
+            ConfigLayerEntry::new(
+                ConfigLayerSource::SessionFlags,
+                toml::from_str("destination_marker = \"retained\"").expect("flags"),
+            ),
+        ],
+        ConfigRequirements::default(),
+        ConfigRequirementsToml::default(),
+    )
+    .expect("stack");
+    let snapshot = original.clone();
+    let updated = snapshot
+        .with_user_config(
+            &file,
+            toml::from_str("model = \"updated\"").expect("new user config"),
+        )
+        .expect("updated");
+    let copied = original.with_user_layer_from(&updated);
+    assert_eq!(
+        original.effective_config()["model"].as_str(),
+        Some("original")
+    );
+    assert_eq!(
+        snapshot.effective_config()["model"].as_str(),
+        Some("original")
+    );
+    for changed in [&updated, &copied] {
+        assert_eq!(
+            changed.effective_config()["model"].as_str(),
+            Some("updated")
+        );
+        assert_eq!(
+            changed.effective_config()["destination_marker"].as_str(),
+            Some("retained")
+        );
+    }
+    let invalid = toml::from_str("[shell_environment_policy]\ninclude_only = 4").expect("TOML");
+    assert!(snapshot.with_user_config(&file, invalid).is_err());
+    assert_eq!(snapshot, original);
+}
