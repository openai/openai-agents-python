+#[test]
+fn shared_layers_keep_value_equality_including_non_reflexive_values() {
+    let make = || {
+        ConfigLayerStack::new(
+            vec![ConfigLayerEntry::new(
+                ConfigLayerSource::SessionFlags,
+                toml::from_str("uninterpreted_value = nan").expect("NaN TOML"),
+            )],
+            ConfigRequirements::default(),
+            ConfigRequirementsToml::default(),
+        )
+        .expect("raw stack")
+    };
+    let stack = make();
+    // Sharing an allocation must not turn existing value comparison into
+    // pointer equality. The raw TOML float remains non-reflexive.
+    assert_ne!(stack, stack.clone());
+    assert_ne!(stack, make());
+    let empty = ConfigLayerStack::default();
+    assert_eq!(empty, empty.clone());
+    assert_eq!(empty, ConfigLayerStack::default());
+    let mut owned = empty.effective_config();
+    owned
+        .as_table_mut()
+        .expect("table")
+        .insert("owned_only".into(), TomlValue::Boolean(true));
+    assert!(empty.effective_config().get("owned_only").is_none());
+}
