index 0000000000000000000000000000000000000000..ea07c2e7dce8d7601ca55432ed581d37a9c4407c
--- /dev/null
+++ b/codex-rs/ext/extension-api/src/model_attempt.rs
@@ -0,0 +1,24 @@
+//! SDK-local accounting for entry into the transport send operation.
+use std::sync::Arc;
+
+use crate::ModelRequestTransport;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ModelAttemptOperation {
+    Generation,
+    Compaction,
+    Internal,
+}
+
+pub trait ModelAttemptRecorder: Send + Sync + std::fmt::Debug {
+    /// Check the immutable root identity before a child uses this route.
+    fn matches_root_turn(&self, root_turn_id: Option<&str>) -> bool;
+    /// Record that a caller-owned model producer handles this request.
+    fn unavailable(&self);
+    /// Record a send locally. This hook must neither block on delivery nor call host code.
+    fn record(&self, operation: ModelAttemptOperation, transport: ModelRequestTransport);
+}
+
+/// Captured for the exact native turn that owns the send.
+#[derive(Clone, Debug)]
+pub struct ModelAttemptRoute(pub Arc<dyn ModelAttemptRecorder>);
