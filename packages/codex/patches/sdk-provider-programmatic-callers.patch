diff --git a/codex-rs/core/src/tools/program_callers.rs b/codex-rs/core/src/tools/program_callers.rs
new file mode 100644
index 00000000..836137a6
--- /dev/null
+++ b/codex-rs/core/src/tools/program_callers.rs
@@ -0,0 +1,162 @@
+use codex_extension_api::ExtensionData;
+use codex_protocol::models::ResponseItem;
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex, Weak};
+
+const MAX_PROGRAMS: usize = 4096;
+const MAX_PROGRAM_BYTES: usize = 1024 * 1024;
+#[derive(Default)]
+struct LivePrograms {
+    entries: HashMap<String, bool>,
+    bytes: usize,
+    exhausted: bool,
+}
+#[derive(Default)]
+struct ProgramOwner(Mutex<LivePrograms>);
+
+/// Existing per-call state owns this after the exact live parent is admitted.
+#[derive(Clone)]
+pub(crate) struct ProgrammaticCallReceipt {
+    owner: Weak<ExtensionData>,
+}
+impl ProgrammaticCallReceipt {
+    pub(crate) fn belongs_to(&self, owner: &Arc<ExtensionData>) -> bool {
+        Weak::ptr_eq(&self.owner, &Arc::downgrade(owner))
+    }
+}
+
+pub(crate) fn observe(
+    store: &Arc<ExtensionData>,
+    item: &ResponseItem,
+    declared: bool,
+) -> Result<(), String> {
+    let (id, opening) = match item {
+        ResponseItem::Program { call_id, .. } => (call_id, true),
+        ResponseItem::ProgramOutput { call_id, .. } => (call_id, false),
+        _ => return Ok(()),
+    };
+    if id.is_empty() {
+        return Ok(());
+    }
+    let state = store.get_or_init(ProgramOwner::default);
+    let mut state = state
+        .0
+        .lock()
+        .map_err(|_| "Provider program owner poisoned")?;
+    if state.exhausted {
+        return Ok(());
+    }
+    if let Some(active) = state.entries.get_mut(id) {
+        *active = false;
+        return Ok(());
+    }
+    let cost = serde_json::to_vec(id)
+        .map_err(|_| "Invalid provider program identity")?
+        .len()
+        .saturating_add(64);
+    if state.entries.len() >= MAX_PROGRAMS || state.bytes.saturating_add(cost) > MAX_PROGRAM_BYTES {
+        state.entries.clear();
+        state.bytes = 0;
+        state.exhausted = true;
+        return Ok(());
+    }
+    state.bytes += cost;
+    state.entries.insert(id.clone(), opening && declared);
+    Ok(())
+}
+
+pub(crate) fn admit(
+    store: &Arc<ExtensionData>,
+    caller_id: &str,
+    declared: bool,
+) -> Result<ProgrammaticCallReceipt, String> {
+    if !declared {
+        return Err(
+            "Programmatic caller requires a currently declared provider program tool".into(),
+        );
+    }
+    let state = store
+        .get::<ProgramOwner>()
+        .ok_or("Programmatic caller has no live parent program")?;
+    if !state
+        .0
+        .lock()
+        .map_err(|_| "Provider program owner poisoned")?
+        .entries
+        .get(caller_id)
+        .copied()
+        .unwrap_or(false)
+    {
+        return Err("Programmatic caller has no unique active parent program".into());
+    }
+    Ok(ProgrammaticCallReceipt {
+        owner: Arc::downgrade(store),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn program(id: &str) -> ResponseItem {
+        serde_json::from_value(serde_json::json!({"type":"program","call_id":id,"code":"passive"}))
+            .unwrap()
+    }
+    fn output(id: &str) -> ResponseItem {
+        serde_json::from_value(serde_json::json!({"type":"program_output","call_id":id,"status":"completed","result":"done"})).unwrap()
+    }
+    #[test]
+    fn receipts_require_a_unique_live_parent_in_the_exact_turn_owner() {
+        let owner = Arc::new(ExtensionData::default());
+        assert!(admit(&owner, "parent", true).is_err());
+        observe(&owner, &program("parent"), true).unwrap();
+        assert!(admit(&owner, "parent", false).is_err());
+        let receipt = admit(&owner, "parent", true).unwrap();
+        assert!(receipt.belongs_to(&owner));
+        assert!(!receipt.belongs_to(&Arc::new(ExtensionData::default())));
+        observe(&owner, &output("parent"), true).unwrap();
+        assert!(admit(&owner, "parent", true).is_err());
+        // Completion cannot revoke an already admitted occurrence.
+        assert!(receipt.belongs_to(&owner));
+        observe(&owner, &program("parent"), true).unwrap();
+        assert!(admit(&owner, "parent", true).is_err());
+        let weak = Arc::downgrade(&owner);
+        drop(owner);
+        assert!(weak.upgrade().is_none());
+    }
+    #[test]
+    fn repeated_and_unavailable_programs_do_not_grant_admission() {
+        let owner = Arc::new(ExtensionData::default());
+        observe(&owner, &program("duplicate"), true).unwrap();
+        observe(&owner, &program("duplicate"), true).unwrap();
+        assert!(admit(&owner, "duplicate", true).is_err());
+        observe(&owner, &program("undeclared"), false).unwrap();
+        assert!(admit(&owner, "undeclared", true).is_err());
+        observe(&owner, &output("closed"), true).unwrap();
+        observe(&owner, &program("closed"), true).unwrap();
+        assert!(admit(&owner, "closed", true).is_err());
+        observe(&owner, &program(""), true).unwrap();
+        assert!(admit(&owner, "", true).is_err());
+    }
+    #[test]
+    fn retained_parent_limits_fail_closed_without_rejecting_passive_items() {
+        for bytes in [false, true] {
+            let owner = Arc::new(ExtensionData::default());
+            observe(&owner, &program("first"), true).unwrap();
+            if bytes {
+                observe(&owner, &program(&"x".repeat(MAX_PROGRAM_BYTES)), true).unwrap();
+            } else {
+                for n in 0..MAX_PROGRAMS {
+                    observe(&owner, &program(&n.to_string()), true).unwrap();
+                }
+            }
+            assert!(admit(&owner, "first", true).is_err());
+            observe(&owner, &program("later"), true).unwrap();
+            assert!(admit(&owner, "later", true).is_err());
+            let state = owner.get::<ProgramOwner>().unwrap();
+            let state = state.0.lock().unwrap();
+            assert!(state.exhausted);
+            assert!(state.entries.is_empty());
+            assert_eq!(state.bytes, 0);
+        }
+    }
+}
