+#[tokio::test]
+async fn retirement_preserves_child_checkpoint_but_rejects_source_paths_and_id_reuse() {
+    let home = TempDir::new().unwrap();
+    let config = test_config(home.path());
+    let db = codex_state::StateRuntime::init(
+        config.sqlite.clone(),
+        config.default_model_provider_id.clone(),
+    )
+    .await
+    .unwrap();
+    let store = LocalThreadStore::new(config, Some(db));
+    let source = ThreadId::new();
+    store.create_thread(create(&store, source)).await.unwrap();
+    let message = serde_json::from_value(serde_json::json!({
+        "type":"message", "role":"user",
+        "content":[{"type":"input_text","text":"shared original 😀"}]
+    }))
+    .unwrap();
+    store
+        .append_items(AppendThreadItemsParams {
+            thread_id: source,
+            items: vec![RolloutItem::ResponseItem(message)],
+        })
+        .await
+        .unwrap();
+    store
+        .persist_thread(source, PersistContext::Standard)
+        .await
+        .unwrap();
+    let source_path = store.live_rollout_path(source).await.unwrap();
+    store.shutdown_thread(source).await.unwrap();
+    let prepared = store
+        .prepare_fork(PrepareForkParams {
+            thread_id: source,
+            boundary: ForkBoundary::Latest,
+        })
+        .await
+        .unwrap();
+    let child = ThreadId::new();
+    let mut child_params = create(&store, child);
+    child_params.forked_from_id = Some(source);
+    child_params.history_base = prepared.history_base;
+    store.create_thread(child_params).await.unwrap();
+    store
+        .persist_thread(child, PersistContext::Standard)
+        .await
+        .unwrap();
+    let child_path = store.live_rollout_path(child).await.unwrap();
+    store.shutdown_thread(child).await.unwrap();
+    drop(prepared);
+    let original = store
+        .load_original_history(LoadThreadHistoryParams {
+            thread_id: child,
+            include_archived: true,
+        })
+        .await
+        .unwrap();
+    let saved_child = Arc::new(
+        store
+            .load_latest_model_context(LoadThreadHistoryParams {
+                thread_id: child,
+                include_archived: true,
+            })
+            .await
+            .unwrap()
+            .items,
+    );
+    let saved_revision = super::super::history_revision::read(&child_path)
+        .await
+        .unwrap();
+    let source_bytes = tokio::fs::read(&source_path).await.unwrap();
+    let child_bytes = tokio::fs::read(&child_path).await.unwrap();
+    assert!(
+        store
+            .delete_thread(DeleteThreadParams { thread_id: source })
+            .await
+            .is_err()
+    );
+
+    // Same existing fork reservation order as archive/delete: no early owner retirement.
+    let reservation = store.live_writer_locks.reserve_lifecycle(source).await;
+    let mut retire = Box::pin(store.retire_thread_owner(source));
+    tokio::select! {
+        biased;
+        result = &mut retire => panic!("retirement passed a pending fork reservation: {result:?}"),
+        _ = tokio::task::yield_now() => {}
+    }
+    let writer = tokio::time::timeout(Duration::from_secs(1), store.live_writer_locks.lock(source))
+        .await
+        .expect("waiting retirement must not take the writer lock first");
+    drop(writer);
+    drop(reservation);
+    retire.await.unwrap();
+
+    assert_eq!(tokio::fs::read(&source_path).await.unwrap(), source_bytes);
+    assert_eq!(tokio::fs::read(&child_path).await.unwrap(), child_bytes);
+    assert_eq!(
+        super::super::history_revision::read(&child_path)
+            .await
+            .as_deref(),
+        Some(saved_revision.as_str())
+    );
+    assert!(
+        store
+            .read_thread(ReadThreadParams {
+                thread_id: source,
+                include_archived: true,
+                include_history: false
+            })
+            .await
+            .is_err()
+    );
+    assert!(
+        ThreadStore::read_thread_by_rollout_path(
+            &store,
+            ReadThreadByRolloutPathParams {
+                rollout_path: source_path.clone(),
+                include_archived: true,
+                include_history: false,
+            }
+        )
+        .await
+        .is_err()
+    );
+    assert!(
+        store
+            .resume_thread(ResumeThreadParams {
+                thread_id: source,
+                rollout_path: Some(source_path),
+                history: None,
+                history_revision: None,
+                include_archived: true,
+                metadata: metadata(),
+            })
+            .await
+            .is_err()
+    );
+    assert!(store.create_thread(create(&store, source)).await.is_err());
+    let page = store
+        .list_threads_including_empty_preview(listing(false))
+        .await
+        .unwrap();
+    assert_eq!(
+        page.items
+            .iter()
+            .map(|thread| thread.thread_id)
+            .collect::<Vec<_>>(),
+        vec![child]
+    );
+    assert!(
+        store
+            .list_threads_including_empty_preview(listing(true))
+            .await
+            .unwrap()
+            .items
+            .is_empty()
+    );
+    let cold = store
+        .load_original_history(LoadThreadHistoryParams {
+            thread_id: child,
+            include_archived: true,
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        serde_json::to_value(&cold.items).unwrap(),
+        serde_json::to_value(&original.items).unwrap()
+    );
+    let resumed = store
+        .resume_thread(ResumeThreadParams {
+            thread_id: child,
+            rollout_path: Some(child_path),
+            history: Some(saved_child.clone()),
+            history_revision: Some(saved_revision),
+            include_archived: true,
+            metadata: metadata(),
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        serde_json::to_value(&*resumed).unwrap(),
+        serde_json::to_value(&*saved_child).unwrap()
+    );
+    store.shutdown_thread(child).await.unwrap();
+}
+
+#[tokio::test]
+async fn supplied_history_cannot_resume_another_owners_retired_rollout() {
+    let home = TempDir::new().unwrap();
+    let config = test_config(home.path());
+    let db = codex_state::StateRuntime::init(
+        config.sqlite.clone(),
+        config.default_model_provider_id.clone(),
+    )
+    .await
+    .unwrap();
+    let store = LocalThreadStore::new(config, Some(db));
+    let source = ThreadId::new();
+    store.create_thread(create(&store, source)).await.unwrap();
+    store
+        .persist_thread(source, PersistContext::Standard)
+        .await
+        .unwrap();
+    let source_path = store.live_rollout_path(source).await.unwrap();
+    store.shutdown_thread(source).await.unwrap();
+    store.retire_thread_owner(source).await.unwrap();
+    let bytes = tokio::fs::read(&source_path).await.unwrap();
+    let error = store
+        .resume_thread(ResumeThreadParams {
+            thread_id: ThreadId::new(),
+            rollout_path: Some(source_path.clone()),
+            history: Some(Arc::new(Vec::new())),
+            history_revision: None,
+            include_archived: true,
+            metadata: metadata(),
+        })
+        .await
+        .unwrap_err();
+    assert!(matches!(
+        error,
+        crate::ThreadStoreError::InvalidRequest { .. }
+    ));
+    assert_eq!(tokio::fs::read(&source_path).await.unwrap(), bytes);
+}
