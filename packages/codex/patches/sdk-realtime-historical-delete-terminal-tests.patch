+    #[test]
+    fn retrieved_external_nonterminal_work_is_rejected_without_adoption() {
+        let terminal = [
+            serde_json::json!({"id":"work","type":"function_call","call_id":"call"}),
+            serde_json::json!({"id":"work","type":"function_call_output","call_id":"call","output":"done"}),
+            serde_json::json!({"id":"work","type":"mcp_call","output":"done"}),
+            serde_json::json!({"id":"work","type":"mcp_tool_call","error":{}}),
+            serde_json::json!({"id":"work","type":"mcp_list_tools","tools":[]}),
+            serde_json::json!({"id":"work","type":"mcp_approval_request"}),
+            serde_json::json!({"id":"work","type":"mcp_approval_response","approval_request_id":"prior","approve":true}),
+        ];
+        for value in terminal {
+            for status in ["in_progress", "incomplete"] {
+                let mut state = State::default();
+                state.observe(&RealtimeEvent::ConversationItemAdded {
+                    item: serde_json::json!({"id":"decision","type":"mcp_approval_response","approval_request_id":"work","approve":true,"status":"completed"}),
+                    previous_item_id: None,
+                }).unwrap();
+                let mut value = value.clone();
+                value["status"] = status.into();
+                assert!(state.admit_retrieved_item(&value).is_err(), "{value}");
+                assert!(!state.items.contains_key("work"));
+            }
+        }
+    }
