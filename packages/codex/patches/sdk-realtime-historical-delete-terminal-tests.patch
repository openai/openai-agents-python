+    #[test]
+    fn retrieved_approval_request_needs_matching_accepted_decision() {
+        let request =
+            serde_json::json!({"id":"request","type":"mcp_approval_request","status":"completed"});
+        let mut state = State::default();
+        state
+            .observe(&RealtimeEvent::ConversationItemAdded {
+                item: request.clone(),
+                previous_item_id: None,
+            })
+            .unwrap();
+        state
+            .observe(&RealtimeEvent::ConversationItemDone {
+                item_id: "request".into(),
+            })
+            .unwrap();
+        assert!(state.admit_retrieved_item(&request).is_err());
+        // This request was already observed; a done envelope cannot decide it.
+        assert!(state.validate("request").is_err());
+        let mut state = State::default();
+        state.admit_retrieved_item(&serde_json::json!({"id":"foreign-decision","type":"mcp_approval_response","approval_request_id":"other","approve":false})).unwrap();
+        assert!(state.admit_retrieved_item(&request).is_err());
+        state.admit_retrieved_item(&serde_json::json!({"id":"decision","type":"mcp_approval_response","approval_request_id":"request","approve":false})).unwrap();
+        state.admit_retrieved_item(&request).unwrap();
+        assert!(state.validate("request").is_ok());
+    }
+
+    #[test]
+    fn same_item_terminal_receipt_during_lookup_keeps_native_ownership() {
+        let mut state = State::default();
+        let value =
+            serde_json::json!({"id":"call-item","type":"function_call","call_id":"native-call"});
+        state
+            .observe(&RealtimeEvent::ConversationItemAdded {
+                item: value.clone(),
+                previous_item_id: None,
+            })
+            .unwrap();
+        state
+            .observe(&RealtimeEvent::ConversationItemDone {
+                item_id: "call-item".into(),
+            })
+            .unwrap();
+        assert!(state.admit_retrieved_item(&value).is_err());
+        state
+            .observe(&RealtimeEvent::FunctionCallFinished {
+                call_id: "native-call".into(),
+                succeeded: true,
+            })
+            .unwrap();
+        state.admit_retrieved_item(&value).unwrap();
+        assert!(state.external_identity("call-item").is_none());
+        let mut changed = value;
+        changed["call_id"] = "foreign-call".into();
+        assert!(state.admit_retrieved_item(&changed).is_err());
+    }
