+const MAX_APPLICATION_STREAM_BYTES: usize = 8 * 1024 * 1024;
+const MAX_DEFERRED_APPLICATION_EVENTS: usize = 4096;
+
+/// Projects a native application model stream without admitting unfinished tool calls.
+#[derive(Default)]
+pub struct ApplicationModelStream {
+    deferred: Vec<ResponseEvent>,
+    deferred_bytes: usize,
+    completion: Option<ResponseEvent>,
+}
+
+impl ApplicationModelStream {
+    /// Projects a frame, deferring ordered output that can invoke a tool.
+    pub fn push(&mut self, json: &str) -> Result<Option<ResponseEvent>, &'static str> {
+        if self.completion.is_some() {
+            return Err("Native model stream yielded after completion");
+        }
+        if json.len() > MAX_APPLICATION_STREAM_BYTES {
+            return Err("Native model stream event exceeds the byte limit");
+        }
+        let event: crate::sse::ResponsesStreamEvent =
+            serde_json::from_str(json).map_err(|_| "Malformed native model response event")?;
+        if event.kind == "error" {
+            return Err("Native model stream reported a provider error");
+        }
+        let interrupted = event.kind == "response.incomplete";
+        let Some(event) = crate::sse::process_responses_event(event)
+            .map_err(|_| "Native model stream reported an invalid or failed response")?
+        else {
+            return Ok(None);
+        };
+        if let ResponseEvent::Completed { response_id, .. } = &event {
+            if response_id.trim().is_empty() {
+                return Err("Native model stream completed without a response ID");
+            }
+            if interrupted {
+                self.deferred.clear();
+            }
+            self.completion = Some(event);
+            return Ok(None);
+        }
+        // Finalized non-message items can trigger native tool execution. Keep them
+        // and the rest of the stream in provider order until the iterator ends.
+        let can_call_tool = matches!(
+            &event,
+            ResponseEvent::OutputItemDone(item)
+                if !matches!(item, ResponseItem::Message { .. } | ResponseItem::Reasoning { .. })
+        );
+        if self.deferred.is_empty() && !can_call_tool {
+            return Ok(Some(event));
+        }
+        self.deferred_bytes = self.deferred_bytes.saturating_add(json.len());
+        if self.deferred_bytes > MAX_APPLICATION_STREAM_BYTES
+            || self.deferred.len() >= MAX_DEFERRED_APPLICATION_EVENTS
+        {
+            return Err("Native model stream deferred output exceeds its limit");
+        }
+        self.deferred.push(event);
+        Ok(None)
+    }
+
+    /// Takes the deferred output and terminal event after the iterator has ended.
+    pub fn finish(mut self) -> Result<Vec<ResponseEvent>, &'static str> {
+        let completion = self
+            .completion
+            .take()
+            .ok_or("Native model stream ended without a terminal response")?;
+        self.deferred.push(completion);
+        Ok(self.deferred)
+    }
+}
