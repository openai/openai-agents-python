+const MAX_APPLICATION_STREAM_BYTES: usize = 8 * 1024 * 1024;
+
+/// Projects a native application model stream without admitting unfinished tool calls.
+#[derive(Default)]
+pub struct ApplicationModelStream {
+    deferred: Vec<ResponseEvent>,
+    deferred_bytes: usize,
+    completion: Option<ResponseEvent>,
+    failure: Option<ApiError>,
+}
+
+impl ApplicationModelStream {
+    /// Returns ready events and whether the application should advance its iterator.
+    pub fn push(&mut self, json: &str) -> (Vec<ResponseEvent>, bool) {
+        let mut ready = Vec::new();
+        if self.failure.is_none() {
+            self.failure = self.project(json, &mut ready).err();
+        }
+        (ready, self.failure.is_none())
+    }
+
+    fn project(&mut self, json: &str, ready: &mut Vec<ResponseEvent>) -> Result<(), ApiError> {
+        if self.completion.is_some() {
+            return Err(invalid_application_stream(
+                "Native model stream yielded after completion",
+            ));
+        }
+        if json.len() > MAX_APPLICATION_STREAM_BYTES {
+            return Err(invalid_application_stream(
+                "Native model stream event exceeds the byte limit",
+            ));
+        }
+        let event: crate::sse::ResponsesStreamEvent = serde_json::from_str(json)
+            .map_err(|_| invalid_application_stream("Malformed native model response event"))?;
+        if event.kind == "error" {
+            return Err(invalid_application_stream(
+                "Native model stream reported a provider error",
+            ));
+        }
+        let interrupted = event.kind == "response.incomplete";
+        if let Some(observation) = event.response_observation() {
+            ready.push(ResponseEvent::ResponseObserved(observation));
+        }
+        ready.extend(
+            event_facts(&event.raw)
+                .into_iter()
+                .map(|fact| ResponseEvent::ResponseFact(fact.into())),
+        );
+        let event =
+            crate::sse::process_responses_event(event).map_err(|error| error.into_api_error())?;
+        if let Some(ResponseEvent::Completed { response_id, .. }) = &event {
+            if response_id.trim().is_empty() {
+                return Err(invalid_application_stream(
+                    "Native model stream completed without a response ID",
+                ));
+            }
+            if interrupted {
+                self.deferred.clear();
+            }
+            self.completion = event;
+            return Ok(());
+        }
+        // Finalized non-message items can trigger native tool execution. Keep them
+        // and the rest of the stream in provider order until the iterator ends.
+        let can_call_tool = matches!(
+            &event,
+            Some(ResponseEvent::OutputItemDone(item))
+                if !matches!(item, ResponseItem::Message { .. } | ResponseItem::Reasoning { .. })
+        );
+        if self.deferred.is_empty() && !can_call_tool {
+            ready.extend(event);
+            return Ok(());
+        }
+        let count = ready.len() + usize::from(event.is_some());
+        if count == 0 {
+            return Ok(());
+        }
+        self.deferred_bytes = self
+            .deferred_bytes
+            .saturating_add(json.len())
+            .saturating_add(count.saturating_mul(std::mem::size_of::<ResponseEvent>()));
+        if self.deferred_bytes > MAX_APPLICATION_STREAM_BYTES {
+            ready.clear();
+            return Err(invalid_application_stream(
+                "Native model stream deferred output exceeds its limit",
+            ));
+        }
+        self.deferred.append(ready);
+        self.deferred.extend(event);
+        Ok(())
+    }
+
+    /// Takes the deferred output and terminal event after the iterator has ended.
+    pub fn finish(mut self, producer_error: Option<&str>) -> Result<Vec<ResponseEvent>, ApiError> {
+        if let Some(error) = self.failure.take() {
+            return Err(error);
+        }
+        if let Some(message) = producer_error {
+            return Err(invalid_application_stream(message));
+        }
+        let completion = self.completion.take().ok_or_else(|| {
+            invalid_application_stream("Native model stream ended without a terminal response")
+        })?;
+        self.deferred.push(completion);
+        Ok(self.deferred)
+    }
+}
+
+fn invalid_application_stream(message: &str) -> ApiError {
+    ApiError::InvalidRequest {
+        message: message.into(),
+    }
+}
