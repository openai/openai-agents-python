+#[cfg(test)]
+mod application_stream_retention_tests {
+    use super::*;
+    use serde_json::json;
+
+    fn deferred_tool() -> ApplicationModelStream {
+        let mut stream = ApplicationModelStream::default();
+        let (ready, advance) = stream.push(
+            &json!({
+                "type":"response.output_item.done", "output_index":0,
+                "item":{"type":"function_call", "call_id":"call", "name":"lookup", "arguments":"{}"}
+            })
+            .to_string(),
+        );
+        assert!(ready.is_empty());
+        assert!(advance);
+        stream
+    }
+
+    #[test]
+    fn many_small_deferred_deltas_remain_valid() {
+        let mut stream = deferred_tool();
+        let delta = json!({"type":"response.output_text.delta", "delta":"x"}).to_string();
+        for _ in 0..5000 {
+            let (ready, advance) = stream.push(&delta);
+            assert!(ready.is_empty());
+            assert!(advance);
+        }
+        let (_, advance) = stream
+            .push(&json!({"type":"response.completed", "response":{"id":"response"}}).to_string());
+        assert!(advance);
+        let events = stream.finish(None).unwrap();
+        assert!(matches!(
+            events.first(),
+            Some(ResponseEvent::OutputItemDone(_))
+        ));
+        assert_eq!(
+            events
+                .iter()
+                .filter(|event| matches!(event, ResponseEvent::OutputTextDelta(_)))
+                .count(),
+            5000
+        );
+        assert!(matches!(
+            events.last(),
+            Some(ResponseEvent::Completed { .. })
+        ));
+    }
+
+    #[test]
+    fn retained_storage_budget_rejects_without_admitting_tool_events() {
+        let mut stream = deferred_tool();
+        let delta = json!({"type":"response.output_text.delta", "delta":"x"}).to_string();
+        let mut rejected = false;
+        for _ in 0..100_000 {
+            let (ready, advance) = stream.push(&delta);
+            assert!(ready.is_empty());
+            if !advance {
+                rejected = true;
+                break;
+            }
+        }
+        assert!(rejected);
+        assert!(matches!(
+            stream.finish(None),
+            Err(ApiError::InvalidRequest { .. })
+        ));
+    }
+}
