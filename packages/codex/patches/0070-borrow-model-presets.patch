@@ -479,6 +479,26 @@ impl ModelsManager for OpenAiModelsManager {
         Ok(self.models_for_entry(&entry).to_vec())
     }
 
+    fn try_list_models(&self) -> Result<Vec<ModelPreset>, TryLockError> {
+        let mut presets = {
+            let entry = self.remote_models.try_read()?;
+            let mut models = self.models_for_entry(&entry).iter().collect::<Vec<_>>();
+            // Match the owned conversion's stable priority ordering.
+            models.sort_by_key(|model| model.priority);
+            models
+                .into_iter()
+                .map(ModelPreset::from)
+                .collect::<Vec<_>>()
+        };
+        // Keep auth filtering after catalog capture and after releasing the read lock.
+        let uses_codex_backend = self
+            .auth_manager()
+            .is_some_and(AuthManager::current_auth_uses_codex_backend);
+        presets = ModelPreset::filter_by_auth(presets, uses_codex_backend);
+        ModelPreset::mark_default_by_picker_visibility(&mut presets);
+        Ok(presets)
+    }
+
     fn auth_manager(&self) -> Option<&AuthManager> {
         self.auth_manager.as_deref()
     }
