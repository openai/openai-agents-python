+/// Explicit provider-tool selection; it never grants a function identity.
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+#[serde(tag = "type", rename_all = "snake_case", deny_unknown_fields)]
+pub enum HostedToolChoice {
+    WebSearch {},
+    FileSearch {},
+    CodeInterpreter {},
+    ImageGeneration {},
+    Computer {},
+    ComputerUsePreview {},
+    Shell {},
+    ApplyPatch {},
+    ToolSearch {},
+    Mcp {
+        server_label: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        name: Option<String>,
+    },
+}
+
+impl HostedToolChoice {
+    pub fn validate(&self) -> Result<(), String> {
+        if let Self::Mcp { server_label, name } = self
+            && (server_label.trim().is_empty()
+                || name.as_ref().is_some_and(|name| name.trim().is_empty()))
+        {
+            return Err(
+                "hosted MCP choice needs a nonempty captured server and tool identity".into(),
+            );
+        }
+        Ok(())
+    }
+}
