+    /// Match only provider-tool declarations already present in the final catalog.
+    /// Same-name functions and deferred functions never satisfy this selection.
+    pub fn captured_hosted_choice(
+        &self,
+        choice: &codex_protocol::model_request_controls::HostedToolChoice,
+    ) -> Option<codex_protocol::model_request_controls::HostedToolChoice> {
+        use codex_protocol::model_request_controls::HostedToolChoice as Choice;
+        let matches = match (self, choice) {
+            (Self::WebSearch { .. }, Choice::WebSearch {})
+            | (Self::FileSearch(_), Choice::FileSearch {})
+            | (Self::CodeInterpreter(_), Choice::CodeInterpreter {})
+            | (Self::ImageGeneration(_), Choice::ImageGeneration {})
+            | (Self::Computer { .. }, Choice::Computer {})
+            | (Self::ComputerUsePreview { .. }, Choice::ComputerUsePreview {})
+            | (Self::Shell(_) | Self::ApplicationShell { .. }, Choice::Shell {})
+            | (Self::ApplyPatch { .. }, Choice::ApplyPatch {})
+            | (Self::ToolSearch { .. } | Self::ProviderToolSearch(_), Choice::ToolSearch {}) => {
+                true
+            }
+            (Self::ComputerUsePreview { .. }, Choice::Computer {}) => {
+                return Some(Choice::ComputerUsePreview {});
+            }
+            (Self::Mcp(tool), Choice::Mcp { server_label, name }) => {
+                tool.server_label == *server_label
+                    && name.as_ref().is_none_or(|name| {
+                        match tool.provider_data.get("allowed_tools") {
+                            None | Some(Value::Null) => true,
+                            Some(Value::Array(names)) => names
+                                .iter()
+                                .any(|value| value.as_str() == Some(name.as_str())),
+                            Some(Value::Object(filter)) => filter
+                                .get("tool_names")
+                                .is_none_or(|names| {
+                                    names.as_array().is_some_and(|names| {
+                                        names
+                                            .iter()
+                                            .any(|value| value.as_str() == Some(name.as_str()))
+                                    })
+                                }),
+                            _ => false,
+                        }
+                    })
+            }
+            _ => false,
+        };
+        matches.then(|| choice.clone())
+    }
