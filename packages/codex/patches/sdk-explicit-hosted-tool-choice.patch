@@ -0,0 +1,87 @@
+use codex_protocol::model_request_controls::HostedToolChoice as Choice;
+use codex_tools::*;
+use serde_json::json;
+
+#[test]
+fn hosted_tool_choice_never_promotes_same_name_or_deferred_functions() {
+    for deferred in [false, true] {
+        let function = ToolSpec::Function(ResponsesApiTool {
+            name: "web_search".into(),
+            description: "application callback".into(),
+            strict: false,
+            defer_loading: Some(deferred),
+            parameters: JsonSchema::default(),
+            output_schema: None,
+        });
+        assert_eq!(function.captured_hosted_choice(&Choice::WebSearch {}), None);
+        assert_eq!(
+            function.has_eager_callable(&codex_protocol::ToolName::plain("web_search")),
+            !deferred
+        );
+    }
+    assert_eq!(
+        ToolSpec::Computer {}.captured_hosted_choice(&Choice::Computer {}),
+        Some(Choice::Computer {})
+    );
+    assert_eq!(
+        ToolSpec::ComputerUsePreview {
+            display_width: 800,
+            display_height: 600,
+            environment: "browser".into()
+        }
+        .captured_hosted_choice(&Choice::Computer {}),
+        Some(Choice::ComputerUsePreview {})
+    );
+}
+
+#[test]
+fn hosted_tool_choice_mcp_respects_the_captured_server_and_allowed_names() {
+    let spec = ToolSpec::Mcp(crate::HostedMcpTool {
+        server_label: "search".into(),
+        provider_data:
+            json!({"server_url":"https://fixture.invalid/mcp","allowed_tools":["lookup"]})
+                .as_object()
+                .unwrap()
+                .clone(),
+    });
+    let select = |server: &str, name: &str| Choice::Mcp {
+        server_label: server.into(),
+        name: Some(name.into()),
+    };
+    assert!(
+        spec.captured_hosted_choice(&select("search", "lookup"))
+            .is_some()
+    );
+    assert!(
+        spec.captured_hosted_choice(&select("other", "lookup"))
+            .is_none()
+    );
+    assert!(
+        spec.captured_hosted_choice(&select("search", "delete"))
+            .is_none()
+    );
+}
+
+#[test]
+fn hosted_mcp_filter_omission_does_not_create_an_empty_name_list() {
+    let choice = Choice::Mcp {
+        server_label: "docs".into(),
+        name: Some("lookup".into()),
+    };
+    for (filter, allowed) in [
+        (json!({"read_only": true}), true),
+        (json!({}), true),
+        (json!({"read_only": true, "tool_names": ["lookup"]}), true),
+        (json!({"read_only": true, "tool_names": []}), false),
+        (json!({"tool_names": ["other"]}), false),
+    ] {
+        let spec = ToolSpec::Mcp(HostedMcpTool {
+            server_label: "docs".into(),
+            provider_data: json!({"server_url":"https://docs.invalid/mcp", "allowed_tools":filter})
+                .as_object()
+                .unwrap()
+                .clone(),
+        });
+        assert_eq!(spec.captured_hosted_choice(&choice).is_some(), allowed);
+    }
+}
