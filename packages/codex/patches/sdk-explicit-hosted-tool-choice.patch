index 0000000000000000000000000000000000000000..c2855f374ac788feb6846eb9b46953bd3fd8727d
--- /dev/null
+++ b/codex-rs/protocol/tests/hosted_tool_choice.rs
@@ -0,0 +1,46 @@
+use codex_protocol::model_request_controls::*;
+use serde_json::json;
+
+#[test]
+fn hosted_tool_choice_preserves_omit_clear_and_captured_selector() {
+    let mut controls = ModelRequestControls::default();
+    assert!(controls.is_empty());
+    assert!(
+        serde_json::to_value(&controls)
+            .unwrap()
+            .get("hosted_tool_choice")
+            .is_none()
+    );
+    let choice: ModelRequestControls = serde_json::from_value(json!({
+        "hosted_tool_choice": {"type":"web_search"}
+    }))
+    .unwrap();
+    controls.apply_patch(&choice);
+    assert_eq!(
+        controls.hosted_tool_choice,
+        Some(Some(HostedToolChoice::WebSearch {}))
+    );
+    assert!(controls.has_wire_values());
+    let clear: ModelRequestControls =
+        serde_json::from_value(json!({"hosted_tool_choice":null})).unwrap();
+    controls.apply_patch(&clear);
+    assert_eq!(controls.hosted_tool_choice, Some(None));
+    assert!(!controls.has_wire_values());
+}
+
+#[test]
+fn hosted_tool_choice_rejects_function_shape_and_extra_authority() {
+    assert!(
+        serde_json::from_value::<HostedToolChoice>(json!({"type":"function","name":"web_search"}))
+            .is_err()
+    );
+    assert!(
+        serde_json::from_value::<HostedToolChoice>(json!({"type":"web_search","name":"injected"}))
+            .is_err()
+    );
+    let choice = HostedToolChoice::Mcp {
+        server_label: " ".into(),
+        name: None,
+    };
+    assert!(choice.validate().is_err());
+}
