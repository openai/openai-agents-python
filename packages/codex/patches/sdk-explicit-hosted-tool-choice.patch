+use codex_api::*;
+use codex_protocol::model_request_controls::HostedToolChoice;
+use serde_json::json;
+
+#[test]
+fn hosted_tool_choice_uses_one_structured_member_for_http_and_websocket() {
+    let request = ResponsesApiRequest {
+        model: Some("fixture-model".into()),
+        stream: true,
+        service_tier: None,
+        input: Vec::new(),
+        tools: None,
+        tool_choice: None,
+        request_controls: ResponsesRequestControls {
+            hosted_tool_choice: Some(HostedToolChoice::WebSearch {}),
+            ..Default::default()
+        },
+        parallel_tool_calls: None,
+        reasoning: None,
+        store: false,
+        stream_options: None,
+        include: Vec::new(),
+        prompt_cache_key: None,
+        text: None,
+        client_metadata: None,
+        access_programs: None,
+    };
+    for encoded in [
+        serde_json::to_string(&request).unwrap(),
+        serde_json::to_string(&ResponseCreateWsRequest::from(&request)).unwrap(),
+    ] {
+        assert_eq!(encoded.matches("\"tool_choice\"").count(), 1);
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(&encoded).unwrap()["tool_choice"],
+            json!({"type":"web_search"})
+        );
+    }
+}
