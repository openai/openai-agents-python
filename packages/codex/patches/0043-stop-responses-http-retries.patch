 use codex_extension_api::ExtensionData;
 use codex_extension_api::ModelRequestContributor;
 use codex_extension_api::ModelRequestInput;
@@ -20,5 +26,23 @@
     if stop.is_some_and(TurnSamplingStop::requested) {
         // Keep the native interrupt responsible for aborting the task and joining cleanup.
         std::future::pending::<()>().await;
+    }
+}
+
+// Responses HTTP retries invoke the transport again without returning to the
+// outer model-request admission check. Retain the exact turn's stop at that boundary.
+pub(crate) struct SamplingStopTransport {
+    pub(crate) inner: ReqwestTransport,
+    pub(crate) stop: Option<Arc<TurnSamplingStop>>,
+}
+
+impl HttpTransport for SamplingStopTransport {
+    async fn execute(&self, request: Request) -> Result<Response, TransportError> {
+        self.inner.execute(request).await
+    }
+
+    async fn stream(&self, request: Request) -> Result<StreamResponse, TransportError> {
+        wait_if_sampling_stopped(self.stop.as_deref()).await;
+        self.inner.stream(request).await
     }
 }
