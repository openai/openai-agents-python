diff --git a/codex-rs/core/src/prepared_request.rs b/codex-rs/core/src/prepared_request.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a70e5faf6d3b77f8fa6d90f9c92276aed1cb8ec0
--- /dev/null
+++ b/codex-rs/core/src/prepared_request.rs
@@ -0,0 +1,289 @@
+//! Sampling-copy editing, separate from the selected execution plan and canonical history.
+use crate::client_common::Prompt;
+use codex_extension_api::{PreparedRequestData, PreparedToolPresentation};
+use codex_protocol::models::ResponseItem;
+use codex_tools::{JsonSchema, ResponsesApiNamespaceTool, ResponsesApiTool, ToolSpec};
+use serde::Serialize;
+use serde::de::DeserializeOwned;
+use serde_json::Value;
+
+const PROFILE: &str = "prepare_request requires a standard Responses (non-Lite) model, Responses HTTP (supports_websockets=false), and direct-root eager function/MCP tools";
+
+/// Preserve submitted keys, including null values, while allowing native defaults.
+fn preserves(submitted: &Value, native: &Value) -> bool {
+    match (submitted, native) {
+        (Value::Object(a), Value::Object(b)) => a
+            .iter()
+            .all(|(key, value)| b.get(key).is_some_and(|actual| preserves(value, actual))),
+        (Value::Array(a), Value::Array(b)) => {
+            a.len() == b.len() && a.iter().zip(b).all(|(a, b)| preserves(a, b))
+        }
+        _ => submitted == native,
+    }
+}
+
+fn parse_preserving<T: DeserializeOwned + Serialize>(value: Value) -> Result<T, String> {
+    let parsed: T = serde_json::from_value(value.clone())
+        .map_err(|_| "invalid native prepared-request value".to_string())?;
+    let canonical = serde_json::to_value(&parsed)
+        .map_err(|_| "cannot serialize prepared-request value".to_string())?;
+    if !preserves(&value, &canonical) {
+        return Err("prepared-request value loses fields in native serialization; omit skipped optional fields instead of explicit null".into());
+    }
+    Ok(parsed)
+}
+
+fn presentation(
+    namespace: Option<&str>,
+    tool: &ResponsesApiTool,
+) -> Result<PreparedToolPresentation, String> {
+    if tool.defer_loading == Some(true) {
+        return Err(PROFILE.into());
+    }
+    Ok(PreparedToolPresentation {
+        namespace: namespace.map(str::to_owned),
+        name: tool.name.clone(),
+        kind: "function".into(),
+        strict: tool.strict,
+        defer_loading: tool.defer_loading,
+        description: tool.description.clone(),
+        parameters: serde_json::to_value(&tool.parameters)
+            .map_err(|_| "cannot serialize native schema".to_string())?,
+    })
+}
+
+pub(crate) fn snapshot(prompt: &Prompt) -> Result<PreparedRequestData, String> {
+    let mut tools = Vec::new();
+    for spec in prompt.tools.iter() {
+        match spec {
+            ToolSpec::Function(tool) => tools.push(presentation(None, tool)?),
+            ToolSpec::Namespace(namespace) => {
+                for leaf in &namespace.tools {
+                    match leaf {
+                        ResponsesApiNamespaceTool::Function(tool) => {
+                            tools.push(presentation(Some(&namespace.name), tool)?)
+                        }
+                        _ => return Err(PROFILE.into()),
+                    }
+                }
+            }
+            _ => return Err(PROFILE.into()),
+        }
+    }
+    Ok(PreparedRequestData {
+        instructions: prompt.base_instructions.text.clone(),
+        input: prompt
+            .input
+            .iter()
+            .map(serde_json::to_value)
+            .collect::<Result<_, _>>()
+            .map_err(|_| "cannot serialize native input".to_string())?,
+        tools,
+    })
+}
+
+fn edit_tool(
+    namespace: Option<&str>,
+    tool: &mut ResponsesApiTool,
+    edit: &PreparedToolPresentation,
+) -> Result<(), String> {
+    let original = presentation(namespace, tool)?;
+    if edit.namespace != original.namespace
+        || edit.name != original.name
+        || edit.kind != original.kind
+        || edit.strict != original.strict
+        || edit.defer_loading != original.defer_loading
+    {
+        return Err(
+            "prepared-request tool identity, order, kind, strict and defer_loading are immutable"
+                .into(),
+        );
+    }
+    if !edit.parameters.is_object() {
+        return Err("prepared-request parameters must be a supported schema object".into());
+    }
+    if edit.parameters != original.parameters {
+        let mut schema: JsonSchema = parse_preserving(edit.parameters.clone())?;
+        // Retain native-only MCP bookkeeping; the executable owner remains untouched.
+        schema.mcp_input_schema_max_bytes = tool.parameters.mcp_input_schema_max_bytes;
+        tool.parameters = schema;
+    }
+    tool.description = edit.description.clone();
+    Ok(())
+}
+
+pub(crate) fn apply(original: &Prompt, data: PreparedRequestData) -> Result<Prompt, String> {
+    let before = snapshot(original)?;
+    if before.tools.len() != data.tools.len() {
+        return Err("prepared-request tool count is immutable".into());
+    }
+    let input: Vec<ResponseItem> = data
+        .input
+        .into_iter()
+        .enumerate()
+        .map(|(index, value)| {
+            parse_preserving(value)
+                .map_err(|category| format!("prepared-request input[{index}]: {category}"))
+        })
+        .collect::<Result<_, _>>()?;
+    let mut tools = original.tools.to_vec();
+    let mut edits = data.tools.iter();
+    for spec in &mut tools {
+        match spec {
+            ToolSpec::Function(tool) => {
+                edit_tool(None, tool, edits.next().ok_or("missing tool presentation")?)?
+            }
+            ToolSpec::Namespace(namespace) => {
+                for leaf in &mut namespace.tools {
+                    match leaf {
+                        ResponsesApiNamespaceTool::Function(tool) => edit_tool(
+                            Some(&namespace.name),
+                            tool,
+                            edits.next().ok_or("missing tool presentation")?,
+                        )?,
+                        _ => return Err(PROFILE.into()),
+                    }
+                }
+            }
+            _ => return Err(PROFILE.into()),
+        }
+    }
+    let mut result = original.clone();
+    result.input = input;
+    result.base_instructions.text = data.instructions;
+    result.tools = tools.into();
+    Ok(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn native_text_function_and_mcp_items_preserve_submitted_fields() {
+        for item in [
+            json!({"type":"message","role":"user","content":[{"type":"input_text","text":"note"}]}),
+            json!({"type":"function_call","name":"reserve","arguments":"{\"seats\":2}","call_id":"call-1"}),
+            json!({"type":"function_call_output","call_id":"call-1","output":"SHAPED_RESULT"}),
+            json!({"type":"function_call","namespace":"mcp__local","name":"reserve","arguments":"{}","call_id":"mcp-1"}),
+            json!({"type":"function_call_output","call_id":"mcp-1","output":"ok"}),
+        ] {
+            assert!(parse_preserving::<ResponseItem>(item).is_ok());
+        }
+    }
+
+    #[test]
+    fn unknown_nested_null_and_skipped_optional_null_are_rejected() {
+        for item in [
+            json!({"type":"message","role":"user","content":[{"type":"input_text","text":"note","unknown":null}]}),
+            json!({"type":"message","role":"user","id":null,"content":[]}),
+        ] {
+            assert!(parse_preserving::<ResponseItem>(item).is_err());
+        }
+    }
+
+    #[test]
+    fn native_schema_rejects_discarded_keywords_without_sanitizing() {
+        assert!(parse_preserving::<JsonSchema>(json!({"type":"integer","maximum":99})).is_err());
+        assert!(
+            parse_preserving::<JsonSchema>(json!({"type":"string","enum":["one","two"]})).is_ok()
+        );
+    }
+
+    fn function(name: &str) -> ResponsesApiTool {
+        ResponsesApiTool {
+            name: name.into(),
+            description: "original".into(),
+            strict: false,
+            defer_loading: None,
+            parameters: serde_json::from_value(json!({"type":"string","enum":["one"]})).unwrap(),
+            output_schema: None,
+        }
+    }
+
+    #[test]
+    fn edit_changes_only_detached_sampling_presentation_and_input() {
+        let original = Prompt {
+            tools: vec![
+                ToolSpec::Function(function("local")),
+                ToolSpec::Namespace(codex_tools::ResponsesApiNamespace {
+                    name: "mcp__local".into(),
+                    description: "container".into(),
+                    tools: vec![ResponsesApiNamespaceTool::Function(function("remote"))],
+                }),
+            ]
+            .into(),
+            ..Default::default()
+        };
+        let original_tools = original.tools.clone();
+        let mut data = snapshot(&original).unwrap();
+        data.instructions = "edited".into();
+        data.input.push(json!({"type":"message","role":"user","content":[{"type":"input_text","text":"sampling only"}]}));
+        for tool in &mut data.tools {
+            tool.description = "edited description".into();
+            tool.parameters = json!({"type":"string","enum":["one","two"]});
+        }
+        let edited = apply(&original, data).unwrap();
+        assert_eq!(
+            snapshot(&edited).unwrap().tools[1].namespace.as_deref(),
+            Some("mcp__local")
+        );
+        assert_eq!(edited.base_instructions.text, "edited");
+        assert_eq!(edited.input.len(), 1);
+        assert!(original.input.is_empty());
+        assert_eq!(original.tools, original_tools);
+        assert_eq!(
+            snapshot(&original).unwrap().tools[0].description,
+            "original"
+        );
+        match &edited.tools[1] {
+            ToolSpec::Namespace(namespace) => assert_eq!(namespace.description, "container"),
+            _ => panic!("namespace was lost"),
+        }
+    }
+
+    #[test]
+    fn tool_mutations_and_invalid_schemas_apply_nothing() {
+        let original = Prompt {
+            tools: vec![ToolSpec::Function(function("local"))].into(),
+            ..Default::default()
+        };
+        let before = snapshot(&original).unwrap();
+        for mutation in 0..6 {
+            let mut data = before.clone();
+            match mutation {
+                0 => data.tools[0].name = "invented".into(),
+                1 => data.tools[0].strict = true,
+                2 => data.tools[0].defer_loading = Some(true),
+                3 => data.tools.clear(),
+                4 => data.tools[0].parameters = json!({"maximum":99}),
+                _ => data.tools[0].namespace = Some("other".into()),
+            }
+            assert!(apply(&original, data).is_err());
+            assert_eq!(snapshot(&original).unwrap(), before);
+        }
+    }
+
+    #[test]
+    fn unsupported_selected_presentations_fail_before_callback_entry() {
+        let mut tool = function("deferred");
+        tool.defer_loading = Some(true);
+        let original = Prompt {
+            tools: vec![ToolSpec::Function(tool)].into(),
+            ..Default::default()
+        };
+        assert!(snapshot(&original).is_err());
+    }
+
+    #[test]
+    fn defaults_may_be_added_but_array_shape_and_scalar_values_must_stay() {
+        assert!(preserves(
+            &json!({"a":[1]}),
+            &json!({"a":[1],"default":null})
+        ));
+        assert!(!preserves(&json!({"a":null}), &json!({})));
+        assert!(!preserves(&json!([1]), &json!([1, 2])));
+        assert!(!preserves(&json!(1), &json!(2)));
+    }
+}
