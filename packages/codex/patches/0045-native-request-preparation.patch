+/// Detached native sampling data. Unknown fields are rejected at the host reply boundary.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PreparedRequestData {
+    pub instructions: String,
+    pub input: Vec<Value>,
+    pub tools: Vec<PreparedToolPresentation>,
+}
+
+/// Ordered function leaf. Only description and parameters may change.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PreparedToolPresentation {
+    pub namespace: Option<String>,
+    pub name: String,
+    pub kind: String,
+    pub strict: bool,
+    pub defer_loading: Option<bool>,
+    pub description: String,
+    pub parameters: Value,
+}
+
+/// Native ownership evidence; hosts add their generation and one-shot nonce.
+pub struct PreparedRequestInput {
+    pub admission: Arc<dyn ModelToolAdmission>,
+    /// Outer sampling recovery count; lower-level transport retries reuse this preparation.
+    pub recovery_attempt: usize,
+    pub data: PreparedRequestData,
+}
+
+/// A settled reply retains an owner check even when it makes no edit.
+pub struct PreparedRequestOutput {
+    pub data: Option<PreparedRequestData>,
+    pub admission: Arc<dyn PreparedRequestAdmission>,
+}
+
+pub trait PreparedRequestAdmission: Send + Sync + std::fmt::Debug {
+    fn admit_request(&self) -> Result<(), String>;
+}
