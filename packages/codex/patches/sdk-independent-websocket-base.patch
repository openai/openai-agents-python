+#[tokio::test]
+async fn independent_websocket_keeps_managed_http_fallback_without_opening_a_socket() -> Result<()>
+{
+    skip_if_no_network!(Ok(()));
+    let http = responses::start_mock_server().await;
+    let events = vec![
+        responses::ev_output_text_delta("low"),
+        responses::ev_completed("score"),
+    ];
+    let output = responses::mount_sse_sequence(&http, vec![responses::sse(events)]).await;
+    let ws = responses::start_websocket_server(vec![Vec::new()]).await;
+    let gateway = Gateway::new(&http.uri(), ws.uri()).await?;
+    let base_url = format!("{}/v1", http.uri());
+    let mut provider = ModelProviderInfo::create_openai_provider(Some(base_url.clone()));
+    provider.websocket_base_url = Some(format!("{}/v1", gateway.url).into());
+    let mut config = sampler_config(base_url);
+    config.provider = create_model_provider(
+        provider,
+        Some(AuthManager::from_auth_for_testing(
+            CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+        )),
+    );
+    let sampler = LunaSampler::new(config);
+    let permit = Arc::clone(&sampler.connections.sockets)
+        .acquire_owned()
+        .await?;
+    assert!(matches!(
+        sampler.connections.open_connection(permit).await,
+        Err(LunaSamplerError::Api(ApiError::InvalidRequest { .. }))
+    ));
+    assert_eq!(sampler.sample(sample_request("managed-http")).await?, "low");
+    assert_eq!(output.requests().len(), 1);
+    assert_eq!(gateway.opens.load(Ordering::SeqCst), 0);
+    Ok(())
+}
