+#[derive(Debug)]
+struct SwitchingModeProvider {
+    inner: codex_model_provider::SharedModelProvider,
+    manager: Arc<AuthManager>,
+    first: std::sync::atomic::AtomicBool,
+    tracked: bool,
+}
+
+struct ManagedCredential(CodexAuth);
+impl codex_login::ExternalAuth for ManagedCredential {
+    fn resolve(&self) -> codex_login::ExternalAuthFuture<'_, CodexAuth> {
+        Box::pin(async { Ok(self.0.clone()) })
+    }
+    fn refresh(
+        &self,
+        _: codex_login::ExternalAuthRefreshContext,
+    ) -> codex_login::ExternalAuthFuture<'_, CodexAuth> {
+        self.resolve()
+    }
+}
+
+impl codex_model_provider::ModelProvider for SwitchingModeProvider {
+    fn models_manager(
+        &self,
+        home: std::path::PathBuf,
+        catalog: Option<codex_protocol::openai_models::ModelsResponse>,
+    ) -> codex_models_manager::manager::SharedModelsManager {
+        self.inner.models_manager(home, catalog)
+    }
+    fn info(&self) -> &ModelProviderInfo {
+        self.inner.info()
+    }
+    fn auth_manager(&self) -> Option<Arc<AuthManager>> {
+        self.tracked.then(|| Arc::clone(&self.manager))
+    }
+    fn account_state(&self) -> codex_model_provider::ProviderAccountResult {
+        self.inner.account_state()
+    }
+    fn auth(&self) -> ModelProviderFuture<'_, Option<CodexAuth>> {
+        Box::pin(async {
+            let previous = self.inner.auth().await;
+            if self.first.swap(false, Ordering::SeqCst) {
+                assert_eq!(
+                    previous.as_ref().map(CodexAuth::auth_mode),
+                    Some(AuthMode::ApiKey)
+                );
+                self.manager
+                    .set_external_auth(Arc::new(ManagedCredential(
+                        CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+                    )))
+                    .await
+                    .expect("install managed credential");
+            }
+            previous
+        })
+    }
+}
