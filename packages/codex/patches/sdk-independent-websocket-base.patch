+        AuthMode::AgentIdentity,
+        AuthMode::PersonalAccessToken,
+    ] {
+        assert!(info.to_api_provider(Some(mode)).is_ok());
+        assert!(info.validate_websocket_auth(Some(mode)).is_err());
+    }
+    assert!(info.to_api_provider(Some(AuthMode::ApiKey)).is_ok());
+    info.experimental_bearer_token = Some("synthetic-explicit-key".into());
+    assert!(info.to_api_provider(Some(AuthMode::Chatgpt)).is_ok());
+    info.experimental_bearer_token = None;
+    info.env_key = Some("SYNTHETIC_EXPLICIT_PROVIDER_KEY".into());
+    assert!(info.to_api_provider(Some(AuthMode::Chatgpt)).is_ok());
+    info.env_key = None;
+    info.requires_openai_auth = false;
+    assert!(info.to_api_provider(Some(AuthMode::Chatgpt)).is_ok());
+}
+
+#[test]
+fn websocket_override_schema_keeps_an_optional_string() {
+    let schema = schemars::r#gen::SchemaSettings::draft07()
+        .with(|settings| settings.option_add_null_type = false)
+        .into_generator()
+        .into_root_schema_for::<ModelProviderInfo>();
+    let object = schema.schema.object.unwrap();
+    assert!(!object.required.contains("websocket_base_url"));
+    let schemars::schema::Schema::Object(property) = &object.properties["websocket_base_url"]
+    else {
+        panic!("expected an endpoint string schema");
+    };
+    assert_eq!(
+        property.instance_type,
+        Some(schemars::schema::InstanceType::String.into())
+    );
+    assert_eq!(
+        property.metadata.as_ref().unwrap().description.as_deref(),
+        Some("Optional independent base URL for Responses WebSocket requests.")
+    );
+}
