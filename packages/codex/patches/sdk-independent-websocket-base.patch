+    struct LazyWebsocketAuth {
+        resolutions: Arc<AtomicUsize>,
+        credential_on_first: bool,
+    }
+
+    impl AuthProvider for LazyWebsocketAuth {
+        fn add_auth_headers(&self, _: &mut HeaderMap) {}
+
+        fn resolve_auth_headers(&self) -> AuthHeadersFuture<'_> {
+            Box::pin(async move {
+                let count = self.resolutions.fetch_add(1, Ordering::SeqCst);
+                let mut headers = HeaderMap::new();
+                if self.credential_on_first || count > 0 {
+                    headers.insert(
+                        AUTHORIZATION,
+                        HeaderValue::from_static("Bearer synthetic-lazy-credential"),
+                    );
+                }
+                Ok(headers)
+            })
+        }
+    }
