+#[test]
+fn websocket_override_keeps_http_and_encoded_path_query() {
+    for (scheme, expected_scheme) in [
+        ("http", "ws"),
+        ("https", "wss"),
+        ("ws", "ws"),
+        ("wss", "wss"),
+    ] {
+        let mut info = ModelProviderInfo::create_openai_provider(Some(
+            "https://http.example/http%2Froot?original=a%26b&original=".into(),
+        ));
+        info.websocket_base_url = Some(
+            format!("{scheme}://socket.example/ws%2Froot%23slot?original=%23&original=").into(),
+        );
+        info.query_params = Some(maplit::hashmap! {"extra".into() => "a&=+%#".into()});
+        let provider = info.to_api_provider(Some(AuthMode::ApiKey)).unwrap();
+        assert_eq!(
+            provider.url_for_path("/responses"),
+            "https://http.example/http%2Froot/responses?original=a%26b&original=&extra=a%26%3D%2B%25%23"
+        );
+        assert_eq!(
+            provider
+                .websocket_url_for_path("/realtime")
+                .unwrap()
+                .as_str(),
+            "wss://http.example/http%2Froot/realtime?original=a%26b&original=&extra=a%26%3D%2B%25%23"
+        );
+        let websocket = provider.websocket_url_for_path("/responses").unwrap();
+        assert_eq!(
+            websocket.as_str(),
+            format!(
+                "{expected_scheme}://socket.example/ws%2Froot%23slot/responses?original=%23&original=&extra=a%26%3D%2B%25%23"
+            )
+        );
+    }
+    let info = ModelProviderInfo::create_openai_provider(Some(
+        "https://http.example/v1?original=%23".into(),
+    ));
+    let provider = info.to_api_provider(None).unwrap();
+    assert_eq!(
+        provider
+            .websocket_url_for_path("responses")
+            .unwrap()
+            .as_str(),
+        "wss://http.example/v1/responses?original=%23"
+    );
+    assert!(
+        !toml::to_string(&info)
+            .unwrap()
+            .contains("websocket_base_url")
+    );
+}
