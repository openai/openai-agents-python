+        .with(|settings| settings.option_add_null_type = false)
+        .into_generator()
+        .into_root_schema_for::<ModelProviderInfo>();
+    let object = schema.schema.object.unwrap();
+    assert!(!object.required.contains("websocket_base_url"));
+    let schemars::schema::Schema::Object(property) = &object.properties["websocket_base_url"]
+    else {
+        panic!("expected an endpoint string schema");
+    };
+    assert_eq!(
