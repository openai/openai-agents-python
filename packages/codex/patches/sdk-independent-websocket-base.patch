+    assert!(info.to_api_provider(Some(AuthMode::ApiKey)).is_ok());
+    info.experimental_bearer_token = Some("synthetic-explicit-key".into());
+    assert!(info.to_api_provider(Some(AuthMode::Chatgpt)).is_ok());
+    info.experimental_bearer_token = None;
+    info.env_key = Some("SYNTHETIC_EXPLICIT_PROVIDER_KEY".into());
+    assert!(info.to_api_provider(Some(AuthMode::Chatgpt)).is_ok());
+    info.env_key = None;
+    info.requires_openai_auth = false;
+    assert!(info.to_api_provider(Some(AuthMode::Chatgpt)).is_ok());
