+#[test]
+fn websocket_override_rejects_ambiguous_urls_and_redacts_debug() {
+    for value in [
+        "",
+        "relative",
+        "https:socket.example",
+        "https:///socket.example",
+        "https://",
+        "https://@socket.example",
+        "https://:@socket.example",
+        "https://user@socket.example",
+        "https://socket.example/#",
+        "https://socket.example/#private",
+        " https://socket.example",
+        "https://socket.example/a b",
+        "https://socket.example/\n",
+    ] {
+        let info = ModelProviderInfo {
+            websocket_base_url: Some(value.into()),
+            ..ModelProviderInfo::default()
+        };
+        assert!(info.validate().is_err(), "{value:?}");
+        assert!(info.to_api_provider(None).is_err(), "{value:?}");
+    }
+    let endpoint = "wss://private-socket.example/path%23item?private=synthetic-endpoint-secret%23";
+    let info = ModelProviderInfo {
+        websocket_base_url: Some(endpoint.into()),
+        ..ModelProviderInfo::default()
+    };
+    assert!(info.validate().is_ok());
+    assert!(!format!("{info:?}").contains("private-socket"));
+    let provider = info.to_api_provider(None).unwrap();
+    assert!(!format!("{provider:?}").contains("synthetic-endpoint-secret"));
+    assert!(!format!("{provider:?}").contains("private-socket"));
+    assert!(
+        toml::to_string(&info)
+            .unwrap()
+            .contains("websocket_base_url")
+    );
+}
