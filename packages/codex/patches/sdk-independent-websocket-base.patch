+#[test]
+fn independent_websocket_gateway_oauth_preserves_normalized_origin() {
+    for delivery in [
+        "delivery = { kind = 'header', name = 'x-gateway-auth' }",
+        "delivery = { kind = 'cookie', name = 'gateway_session' }",
+    ] {
+        let valid = provider(delivery);
+        for endpoint in [
+            "https://gateway.example.test/other?route=socket",
+            "wss://GATEWAY.EXAMPLE.TEST:443/other%23path?route=%23socket",
+        ] {
+            let mut same = valid.clone();
+            same.websocket_base_url = Some(endpoint.into());
+            assert_eq!(same.validate(), Ok(()));
+        }
+        for endpoint in [
+            "wss://different.example.test/v1",
+            "wss://gateway.example.test:444/v1",
+            "ws://gateway.example.test/v1",
+            "http://gateway.example.test/v1",
+        ] {
+            let mut distinct = valid.clone();
+            distinct.websocket_base_url = Some(endpoint.into());
+            let error = distinct
+                .validate()
+                .expect_err("gateway credential must stay on the configured origin");
+            assert!(!error.contains(endpoint));
+        }
+        let mut loopback = valid;
+        loopback.base_url = Some("http://127.0.0.1/v1".into());
+        loopback.websocket_base_url = Some("ws://127.0.0.1:80/other".into());
+        assert_eq!(loopback.validate(), Ok(()));
+    }
+}
