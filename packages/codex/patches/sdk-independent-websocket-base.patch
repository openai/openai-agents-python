+#[tokio::test]
+async fn realtime_keeps_its_origin_with_a_separate_responses_websocket_base() {
+    let trap = TcpListener::bind("127.0.0.1:0")
+        .await
+        .expect("trap listener");
+    let trap_url = format!("ws://{}", trap.local_addr().unwrap());
+    let trap_opened = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let observed = std::sync::Arc::clone(&trap_opened);
+    let trap_task = tokio::spawn(async move {
+        if trap.accept().await.is_ok() {
+            observed.store(true, std::sync::atomic::Ordering::SeqCst);
+        }
+    });
+    let (addr, server) = spawn_realtime_ws_server(|mut ws| async move {
+        let first = ws.next().await.unwrap().unwrap().into_text().unwrap();
+        assert_eq!(
+            serde_json::from_str::<Value>(&first).unwrap()["type"],
+            "session.update"
+        );
+        ws.send(Message::Text(
+            json!({"type":"session.updated","session":{"id":"ordinary-realtime"}})
+                .to_string()
+                .into(),
+        ))
+        .await
+        .unwrap();
+        while let Some(message) = ws.next().await {
+            if matches!(message, Ok(Message::Close(_))) {
+                break;
+            }
+        }
+    })
+    .await;
+    let mut provider = test_provider(format!("http://{addr}"));
+    provider.websocket_base_url = Some(trap_url);
+    let client = test_client(provider);
+    let connection = tokio::time::timeout(
+        Duration::from_secs(5),
+        client.connect(
+            RealtimeSessionConfig {
+                function_tools: Vec::new(),
+                v2: None,
+                instructions: "Answer.".into(),
+                initial_items: Vec::new(),
+                delegation_ack_filler: None,
+                model: Some("realtime-test-model".into()),
+                session_id: None,
+                event_parser: RealtimeEventParser::V1,
+                session_mode: RealtimeSessionMode::Conversational,
+                output_modality: RealtimeOutputModality::Audio,
+                voice: RealtimeVoice::Cove,
+            },
+            HeaderMap::new(),
+            HeaderMap::new(),
+        ),
+    )
+    .await
+    .expect("connect timeout")
+    .expect("connect");
+    assert!(
+        matches!(connection.next_event().await.unwrap(), Some(RealtimeEvent::SessionUpdated { realtime_session_id, .. }) if realtime_session_id == "ordinary-realtime")
+    );
+    connection.close().await.unwrap();
+    server.await.unwrap();
+    assert!(!trap_opened.load(std::sync::atomic::Ordering::SeqCst));
+    trap_task.abort();
+    let _ = trap_task.await;
+}
