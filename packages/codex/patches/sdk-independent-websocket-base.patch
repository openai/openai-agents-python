+/// Freeze anonymous authentication before opening an independent WebSocket.
+/// A lazy provider must not resolve a different credential during the handshake.
+pub async fn prepare_websocket_auth(
+    provider: &ModelProviderInfo,
+    mode: Option<AuthMode>,
+    tracked_owner: bool,
+    auth: SharedAuthProvider,
+) -> Result<SharedAuthProvider, String> {
+    provider.validate_websocket_auth(mode)?;
+    if provider.websocket_base_url.is_none() || tracked_owner {
+        return Ok(auth);
+    }
+    let denied = "independent WebSocket requires tracked credential ownership";
+    if provider.requires_openai_auth || mode.is_some() {
+        return Err(denied.into());
+    }
+    let headers = auth
+        .resolve_auth_headers()
+        .await
+        .map_err(|_| denied.to_string())?;
+    if !headers.is_empty() {
+        return Err(denied.into());
+    }
+    Ok(unauthenticated_auth_provider())
+}
