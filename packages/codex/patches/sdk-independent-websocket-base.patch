+    use codex_protocol::auth::AuthMode;
+
+    fn managed_headers() -> CodexAuth {
+        let mut headers = HeaderMap::new();
+        headers.insert(
+            http::header::AUTHORIZATION,
+            HeaderValue::from_static("Bearer synthetic-managed"),
+        );
+        CodexAuth::Headers(AuthHeaders::new(headers))
+    }
+
+    #[test]
+    fn websocket_endpoint_http_keeps_managed_and_explicit_credentials() {
+        let ambient = managed_headers();
+        let mut provider =
+            ModelProviderInfo::create_openai_provider(Some("https://http.example/v1".into()));
+        provider.websocket_base_url = Some("wss://socket.example/v1".into());
+        assert_eq!(ambient.auth_mode(), AuthMode::Headers);
+        assert!(resolve_provider_auth(Some(&ambient), &provider).is_ok());
+        assert!(
+            provider
+                .validate_websocket_auth(Some(ambient.auth_mode()))
+                .is_err()
+        );
+        provider.experimental_bearer_token = Some("synthetic-explicit-key".into());
+        let headers = resolve_provider_auth(Some(&ambient), &provider)
+            .unwrap()
+            .to_auth_headers();
+        assert_eq!(
+            headers.get(http::header::AUTHORIZATION).unwrap(),
+            "Bearer synthetic-explicit-key"
+        );
+    }
+
+    #[tokio::test]
+    async fn websocket_endpoint_http_allows_scoped_managed_resolution() {
+        let ambient = managed_headers();
+        let mut provider =
+            ModelProviderInfo::create_openai_provider(Some("https://http.example/v1".into()));
+        provider.websocket_base_url = Some("wss://socket.example/v1".into());
+        let scope = ProviderAuthScope {
+            agent_identity_policy: AgentIdentityAuthPolicy::ChatGptAuth,
+            session_source: SessionSource::Cli,
+            agent_identity_session_fallback: AgentIdentitySessionFallback::default(),
+        };
+        assert!(
+            resolve_provider_auth_for_scope(None, Some(&ambient), &provider, scope.clone())
+                .await
+                .is_ok()
+        );
+        assert!(
+            provider
+                .validate_websocket_auth(Some(ambient.auth_mode()))
+                .is_err()
+        );
+        provider.experimental_bearer_token = Some("synthetic-explicit-key".into());
+        let resolved = resolve_provider_auth_for_scope(None, Some(&ambient), &provider, scope)
+            .await
+            .unwrap();
+        assert_eq!(
+            resolved
+                .auth
+                .to_auth_headers()
+                .get(http::header::AUTHORIZATION)
+                .unwrap(),
+            "Bearer synthetic-explicit-key"
+        );
+    }
+}
