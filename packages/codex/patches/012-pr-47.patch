     communication: &InterAgentCommunication,
     receiver_thread_id: ThreadId,
 ) {
+    let policy = codex_otel::sdk_trace::current_scope_policy();
+    if policy.as_ref().is_some_and(|policy| policy.disabled) {
+        return;
+    }
+    let content = policy
+        .is_none_or(|policy| policy.include_sensitive_data)
+        .then(|| {
+            communication
+                .encrypted_content
+                .as_deref()
+                .unwrap_or("[plaintext]")
+        });
+
     tracing::info!(
         target: AGENT_COMMUNICATION_TARGET,
         {
@@ -59,10 +72,7 @@ pub(crate) fn emit_agent_communication_send(
