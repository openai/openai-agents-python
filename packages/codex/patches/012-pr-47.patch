             sender_thread_id = %context.sender_thread_id,
             receiver_thread_id = %receiver_thread_id,
-            content = communication
-                .encrypted_content
-                .as_deref()
-                .unwrap_or("[plaintext]"),
+            content,
         },
         "agent communication"
     );
