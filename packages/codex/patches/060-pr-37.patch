+
+pub(crate) async fn run(
+    invocation: ToolInvocation,
+    role: &str,
+    (result_control, capture_items): (bool, bool),
+) -> Result<Box<dyn ToolOutput>, FunctionCallError> {
+    let outer_call_id = if result_control {
+        invocation
+            .originating_call()
+            .await
+            .map(|origin| origin.call_id)
+    } else {
+        None
+    };
+    let result_source = match &invocation.source {
+        crate::tools::context::ToolCallSource::CodeMode {
+            cell_id,
+            runtime_tool_call_id,
+        } => serde_json::json!({"route":"code_mode", "cell_id":cell_id,
+                "runtime_tool_call_id":runtime_tool_call_id, "outer_call_id":outer_call_id}),
+        _ => serde_json::json!({"route":"direct"}),
+    };
+    let ToolInvocation {
+        session,
+        step_context,
+        payload,
+        call_id,
+        tool_name,
+        cancellation_token,
+        ..
+    } = invocation;
+    let turn = &step_context.turn;
+    let gate = if result_control {
+        Some(
+            session
+                .services
+                .thread_extension_data
+                .get::<crate::managed_agent_result::ManagedAgentResultGate>()
+                .ok_or_else(|| {
+                    FunctionCallError::RespondToModel(
+                        "Managed result control requires a live SDK callback".into(),
+                    )
+                })?,
+        )
+    } else {
+        None
+    };
+    if turn.multi_agent_version != MultiAgentVersion::V2 {
+        return Err(FunctionCallError::RespondToModel(
+            "Managed agent tools require native multi-agent V2".to_owned(),
+        ));
+    }
+    let args: ManagedToolInput = parse_arguments(&function_arguments(payload)?)?;
+    if args.input.trim().is_empty() {
+        return Err(FunctionCallError::RespondToModel(
+            "Managed agent tool input must contain a message".to_owned(),
+        ));
+    }
+    let prepared = prepare_agent_spawn_config(
+        &session,
+        step_context.as_ref(),
+        SpawnConfigOptions {
+            version: SpawnConfigVersion::V2,
+            full_history_fork: false,
+            role_name: Some(role),
+            model: None,
+            reasoning_effort: None,
+        },
+    )
+    .await
+    .map_err(FunctionCallError::RespondToModel)?;
+    let task_name = format!("tool_{}", uuid::Uuid::now_v7().simple());
+    let source = thread_spawn_source(
+        session.thread_id,
+        &turn.session_source,
+        next_thread_spawn_depth(&turn.session_source),
+        prepared.role_name.as_deref(),
+        Some(task_name),
+    )?;
+    let agent_path = source.get_agent_path().ok_or_else(|| {
+        FunctionCallError::Fatal("managed child is missing its canonical agent path".to_owned())
+    })?;
+    let origin = SdkManagedToolOrigin {
+        tool_name: tool_name.name.clone(),
+        role: role.to_owned(),
+        native_call_id: call_id.clone(),
+        parent_thread_id: session.thread_id,
+        parent_turn_id: turn.sub_id.clone(),
+        cell_id: result_source
+            .get("cell_id")
+            .and_then(|v| v.as_str())
+            .map(str::to_owned),
+        runtime_tool_call_id: result_source
+            .get("runtime_tool_call_id")
+            .and_then(|v| v.as_str())
+            .map(str::to_owned),
+        input: result_control.then(|| args.input.clone()),
+    };
+    let managed = session
+        .services
+        .agent_control
+        .spawn_managed_tool_with_control(
+            SpawnRequest {
+                caller: session.thread_id,
+                config: prepared.config,
+                input: AgentInput::Message {
+                    message: AgentMessage::Plaintext(args.input),
+                    mode: MessageDeliveryMode::TriggerTurn,
+                },
+                source,
+                options: SpawnAgentOptions {
+                    spawning_source: Some(AgentSpawnSource::from_step_context(Arc::clone(
+                        &step_context,
+                    ))),
+                    parent_thread_id: Some(session.thread_id),
+                    parent_turn_id: Some(turn.sub_id.clone()),
+                    root_turn_id: turn.turn_metadata_state.root_turn_id(),
+                    turn_trigger: turn.turn_metadata_state.current_turn_trigger(),
+                    environments: Some(step_context.environments.clone()),
+                    cyber_access_program: turn.cyber_access_program,
+                    ..Default::default()
+                },
+            },
+            origin,
+            result_control,
+            capture_items,
+        )
+        .await
+        .map_err(collab_spawn_error)?;
+    let thread_id = managed.agent.thread_id;
+    let turn_id = managed.turn_id.clone();
+    super::emit_sub_agent_activity(
+        &session,
+        turn,
+        SubAgentActivityItem {
+            id: call_id.clone(),
+            agent_thread_id: thread_id,
+            agent_path,
+            kind: SubAgentActivityKind::Started,
+        },
+    )
+    .await;
+    let result = managed.wait().await.map_err(|_| {
+        FunctionCallError::Fatal("managed child did not deliver its terminal outcome".to_owned())
+    })?;
+    if result.thread_id != thread_id || result.turn_id != turn_id {
+        return Err(FunctionCallError::Fatal(
+            "managed child delivered an unrelated terminal outcome".to_owned(),
+        ));
+    }
+    let replacement = if let Some(gate) = gate {
+        gate.0
+            .settle(crate::managed_agent_result::ManagedAgentResultInput {
+                step_store: &step_context.extension_data,
+                thread_store: &session.services.thread_extension_data,
+                parent_thread_id: &session.thread_id.to_string(),
+                parent_turn_id: &turn.sub_id,
+                call_id: &call_id,
+                tool_name: &tool_name,
+                role,
+                source: result_source,
+                result: &result,
+                cancellation: cancellation_token.clone(),
+            })
+            .await
+            .map_err(|_| {
+                FunctionCallError::RespondToModel(
+                    "Managed agent result withheld by application policy".into(),
+                )
+            })?
+    } else {
+        None
+    };
+    if cancellation_token.is_cancelled() {
+        return Err(FunctionCallError::RespondToModel(
+            "Managed agent invocation cancelled".into(),
+        ));
+    }
+    if capture_items
+        && result
+            .items
+            .as_ref()
+            .is_none_or(|capture| capture.items.is_err())
+    {
+        return Err(FunctionCallError::RespondToModel(
+            "Managed child items unavailable".into(),
+        ));
+    }
+    let AgentStatus::Completed(message) = result.status else {
+        return Err(FunctionCallError::RespondToModel(
+            "Managed agent did not complete its turn".to_owned(),
+        ));
+    };
+    let text =
+        replacement.unwrap_or_else(|| match result.output.map(|output| output.final_output) {
+            Some(serde_json::Value::String(text)) => text,
+            Some(value) => value.to_string(),
+            None => message.unwrap_or_default(),
+        });
+    Ok(Box::new(FunctionToolOutput::from_text(text, Some(true))))
+}
