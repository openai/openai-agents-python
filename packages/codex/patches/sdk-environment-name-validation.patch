+/// Optional names-only preflight on the existing metadata request.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields, rename_all = "camelCase")]
+pub struct EnvironmentInfoParams {
+    pub environment_variable_names: Option<Vec<String>>,
+}
+
+impl EnvironmentInfoParams {
+    pub fn environment_variable_names_are_distinct(&self) -> bool {
+        let Some(names) = &self.environment_variable_names else {
+            return true;
+        };
+        if names
+            .iter()
+            .any(|name| name.is_empty() || name.contains(['\0', '=']))
+        {
+            return false;
+        }
+        let variables: std::collections::HashMap<std::ffi::OsString, std::ffi::OsString> = names
+            .iter()
+            .map(|name| (name.into(), std::ffi::OsString::new()))
+            .collect();
+        variables.len() == names.len()
+            && codex_protocol::shell_environment::env_override_names_are_distinct(&variables)
+    }
+}
+
 fn unknown_executor_version() -> String {
     "0.0.0".to_string()
 }
