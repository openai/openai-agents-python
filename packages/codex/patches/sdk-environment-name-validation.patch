+    /// Validates names at the actual executor without sending values or launching a process.
+    pub async fn validate_environment_variable_names(
+        &self,
+        names: Vec<String>,
+    ) -> Result<(), ExecServerError> {
+        match &self.remote_client {
+            Some(client) => {
+                client
+                    .get()
+                    .await?
+                    .validate_environment_variable_names(names)
+                    .await
+            }
+            None => {
+                let params = crate::protocol::EnvironmentInfoParams {
+                    environment_variable_names: Some(names),
+                };
+                if params.environment_variable_names_are_distinct() {
+                    Ok(())
+                } else {
+                    Err(ExecServerError::Protocol(
+                        "invalid explicit environment names for this executor".into(),
+                    ))
+                }
