+        "url": "https://example.com/cited", "title": "Cited"
+    });
+    let file_citation = json!({
+        "type": "file_citation", "file_id": "file-1", "filename": "report.txt", "index": 0
+    });
+    let parts = json!([
+        {"type": "output_text", "text": format!("{hidden}Hello"),
+         "annotations": [citation, {"type": "future_annotation", "custom": {"value": true}}]},
+        {"type": "output_text", "text": " world", "annotations": [file_citation]},
+        {"type": "output_text", "text": "!", "annotations": {"future_container": true}},
+    ]);
+    let sources = json!([{"type": "url", "url": "https://example.com/consulted"}]);
+    let mut search = ev_web_search_call_done("search-1", "completed", "a source");
+    search["item"]["action"]["sources"] = sources.clone();
+    let mut added = ev_message_item_added("msg-1", "");
+    added["item"]["content"] = parts.clone();
+    let mut done = ev_assistant_message("msg-1", "");
+    done["item"]["content"] = parts.clone();
+    mount_sse_once(
+        &server,
+        sse(vec![
+            ev_response_created("resp-1"),
+            search,
+            added,
+            done,
+            ev_completed("resp-1"),
+        ]),
+    )
+    .await;
+
+    codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Find a source".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+
+    let started = wait_for_event_match(&codex, |event| match event {
+        EventMsg::ItemStarted(event) => match &event.item {
+            TurnItem::AgentMessage(message) => Some(message.clone()),
+            _ => None,
+        },
+        _ => None,
+    })
+    .await;
+    let completed = wait_for_event_match(&codex, |event| match event {
+        EventMsg::ItemCompleted(event) => match &event.item {
+            TurnItem::AgentMessage(message) => Some(message.clone()),
+            _ => None,
+        },
+        _ => None,
+    })
+    .await;
+    let visible = wait_for_event_match(&codex, |event| match event {
+        EventMsg::TurnComplete(event) => Some(event.last_agent_message.clone()),
+        _ => None,
+    })
+    .await;
+    let mut event_parts = parts.clone();
+    for part in event_parts.as_array_mut().unwrap() {
+        part["type"] = json!("Text");
+    }
+    for message in [started, completed] {
+        assert_eq!(serde_json::to_value(&message.content)?, event_parts);
+        assert_eq!(message.text().as_ref(), "Hello world!");
+    }
+    assert_eq!(visible.as_deref(), Some("Hello world!"));
+
+    codex.flush_rollout().await?;
+    let rollout = std::fs::read_to_string(codex.rollout_path().expect("paginated rollout path"))?;
+    let rollout_items = rollout
+        .lines()
+        .map(codex_rollout::parse_rollout_line)
+        .collect::<Result<Vec<_>, _>>()?;
+    let saved = rollout_items
