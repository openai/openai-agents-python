+// Responses accepts the documented annotation and search source variants as input.
+// Keep future output-only metadata in history while omitting it from replay.
+pub(crate) fn filter_response_metadata_for_input(items: &mut [ResponseItem]) {
+    for item in items {
+        match item {
+            ResponseItem::Message { content, .. } => {
+                for part in content {
+                    if let ContentItem::OutputText { annotations, .. } = part {
+                        retain_supported_response_metadata(
+                            annotations,
+                            &[
+                                "url_citation",
+                                "file_citation",
+                                "container_file_citation",
+                                "file_path",
+                            ],
+                        );
+                    }
+                }
+            }
+            ResponseItem::WebSearchCall {
+                action: Some(codex_protocol::models::WebSearchAction::Search { sources, .. }),
+                ..
+            } => retain_supported_response_metadata(sources, &["url"]),
+            _ => {}
+        }
+    }
+}
+
+fn retain_supported_response_metadata(value: &mut Option<Value>, kinds: &[&str]) {
+    match value {
+        Some(Value::Array(entries)) => {
+            entries.retain(|entry| {
+                entry
+                    .get("type")
+                    .and_then(Value::as_str)
+                    .is_some_and(|kind| kinds.contains(&kind))
+            });
+        }
+        Some(_) => *value = None,
+        None => {}
+    }
+}
