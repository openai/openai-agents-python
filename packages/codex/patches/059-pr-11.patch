+                    suggested, replay_safety: ModelReplaySafety::Safe,
+                    ..Default::default()
+                }),
+            };
+            assert_eq!(select_retry_delay(&context, Some(&reply), native_retryable,
+                false, &ModelRetryBackoff::default(), 0.5).unwrap().is_some(), expected);
+        }
+    }
+
+    #[test]
+    fn explicit_policy_overrides_opposite_provider_suggestion() {
+        use codex_protocol::model_retry::*;
+        for retry in [false, true] {
+            let reply = ModelRetryResolution {
+                decision: Some(ModelRetryDecision { retry, ..Default::default() }),
+                provider_advice: Some(ModelRetryAdvice {
+                    suggested: Some(!retry), replay_safety: ModelReplaySafety::Safe,
+                    ..Default::default()
+                }),
+            };
+            assert_eq!(select_retry_delay(&retry_context(), Some(&reply), !retry,
+                false, &ModelRetryBackoff::default(), 0.5).unwrap().is_some(), retry);
+        }
+    }
+
+    #[test]
+    fn provider_suggestion_cannot_bypass_native_replay_fences() {
+        use codex_protocol::model_retry::*;
+        for veto in 0..6 {
+            let mut context = retry_context();
+            context.policy_enabled = false;
+            let mut advice = ModelRetryAdvice { suggested: Some(true),
+                replay_safety: ModelReplaySafety::Safe, ..Default::default() };
+            match veto {
+                0 => context.normalized.is_abort = true,
+                1 => context.retry_unsafe_output = true,
+                2 => context.local_effects = true,
+                3 => context.attempt = 2,
+                4 => advice.replay_safety = ModelReplaySafety::Unsafe,
+                _ => { context.stateful = true; advice.replay_safety = ModelReplaySafety::Unknown; }
+            }
+            let reply = ModelRetryResolution { decision: None, provider_advice: Some(advice) };
+            assert_eq!(select_retry_delay(&context, Some(&reply), false,
+                false, &ModelRetryBackoff::default(), 0.5).unwrap(), None);
+        }
+    }
+
+}
