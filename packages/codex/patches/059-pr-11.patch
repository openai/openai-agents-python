+// Provider actions have no local accepted-call deduplication owner. Unknown
+// output has lost its raw type, so its replay safety cannot be established.
+fn provider_event_may_have_effects(event: &ResponseEvent, tools: &[codex_tools::ToolSpec]) -> bool {
+    match event {
+        ResponseEvent::OutputItemAdded(item) | ResponseEvent::OutputItemDone(item) => match item {
+            ResponseItem::ShellCall {
+                provider_fields, ..
+            } => {
+                match provider_fields
+                    .get("environment")
+                    .and_then(|environment| environment.get("type"))
+                    .and_then(serde_json::Value::as_str)
+                {
+                    Some("local") => false,
+                    Some(_) => true,
+                    None => tools
+                        .iter()
+                        .any(|tool| matches!(tool, codex_tools::ToolSpec::Shell(_))),
+                }
+            }
+            ResponseItem::CodeInterpreterCall { .. }
+            | ResponseItem::ImageGenerationCall { .. }
+            | ResponseItem::ShellCallOutput { .. }
+            | ResponseItem::Other => true,
+            _ => false,
+        },
+        ResponseEvent::HostedToolCallProgress(progress) => progress
+            .event
+            .get("type")
+            .and_then(serde_json::Value::as_str)
+            .is_some_and(|kind| {
+                kind.starts_with("response.code_interpreter_call.")
+                    || kind.starts_with("response.code_interpreter_call_code.")
+                    || kind.starts_with("response.image_generation_call.")
+                    || kind.starts_with("response.mcp_call.")
+                    || kind.starts_with("response.shell_call_command.")
+                    || kind.starts_with("response.shell_call_output_content.")
+            }),
+        _ => false,
+    }
+}
