+/// Match the full recorded payload, substituting only the Core-projected body
+/// when history admission truncated a function result for the model window.
+fn matches_recorded_function_payload(
+    raw: &str,
+    projected: &ResponseItem,
+    source: &serde_json::Value,
+) -> bool {
+    let Ok(mut recorded) = serde_json::from_str::<serde_json::Value>(raw) else {
+        return false;
+    };
+    if let ResponseItem::FunctionCallOutput { output, .. } = projected {
+        let Some(body) = recorded.get_mut("output") else {
+            return false;
+        };
+        let Ok(projected_body) = serde_json::to_value(output) else {
+            return false;
+        };
+        *body = projected_body;
+    }
+    &recorded == source
 }
 
