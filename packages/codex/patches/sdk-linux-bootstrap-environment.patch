@@ -0,0 +1,142 @@
+use super::*;
+use codex_sandboxing::SandboxCommand;
+use codex_sandboxing::SandboxManager;
+use codex_sandboxing::SandboxTransformRequest;
+use codex_sandboxing::SandboxType;
+use std::os::unix::process::CommandExt;
+use std::path::Path;
+use std::process::Command;
+
+fn run_payload_environment(
+    workspace: &Path,
+    env: HashMap<String, String>,
+    argv: &[&str],
+) -> Output {
+    let workspace = AbsolutePathBuf::try_from(workspace).unwrap();
+    let command = SandboxCommand {
+        program: argv[0].into(),
+        args: argv[1..].iter().map(|arg| (*arg).to_owned()).collect(),
+        cwd: url::Url::from_directory_path(workspace.as_path())
+            .unwrap()
+            .as_str()
+            .parse()
+            .unwrap(),
+        env,
+        managed_network: None,
+        additional_permissions: None,
+    };
+    let cwd = command.cwd.clone();
+    let permissions = PermissionProfile::workspace_write_with(
+        std::slice::from_ref(&workspace),
+        NetworkSandboxPolicy::Restricted,
+        /*exclude_tmpdir_env_var*/ true,
+        /*exclude_slash_tmp*/ true,
+    );
+    let helper = codex_linux_sandbox_exe();
+    let request = SandboxManager::new()
+        .transform(SandboxTransformRequest {
+            command,
+            permissions: &permissions,
+            sandbox: SandboxType::LinuxSeccomp,
+            enforce_managed_network: false,
+            environment_id: None,
+            network: None,
+            sandbox_policy_cwd: &cwd,
+            sandbox_exe: Some(&helper),
+            use_legacy_landlock: false,
+            windows_sandbox_level: WindowsSandboxLevel::Disabled,
+        })
+        .unwrap();
+    let mut command = Command::new(&request.command[0]);
+    command
+        .args(&request.command[1..])
+        .current_dir(workspace.as_path())
+        .env_clear()
+        .envs(request.env);
+    if let Some(arg0) = request.arg0 {
+        command.arg0(arg0);
+    }
+    command.output().unwrap()
+}
+
+#[test_case::test_case("LD_PRELOAD"; "preload")]
+#[test_case::test_case("LD_AUDIT"; "audit")]
+#[tokio::test]
+async fn loader_constructor_only_runs_with_payload_permissions(variable: &str) {
+    if should_skip_bwrap_tests().await {
+        return;
+    }
+    let root = tempfile::TempDir::new().unwrap();
+    let workspace = root.path().join("workspace");
+    std::fs::create_dir(&workspace).unwrap();
+    let source = workspace.join("loader.c");
+    let library = workspace.join("loader.so");
+    std::fs::write(&source, include_str!("fixtures/environment_loader.c")).unwrap();
+    assert!(
+        Command::new("cc")
+            .args(["-shared", "-fPIC"])
+            .arg(&source)
+            .arg("-o")
+            .arg(&library)
+            .status()
+            .unwrap()
+            .success()
+    );
+    // Neither /tmp nor TMPDIR is writable in this profile. Only workspace is.
+    let outside = root.path().join("outside-marker");
+    let inside = workspace.join("inside-marker");
+    let env = HashMap::from([
+        (variable.to_owned(), library.to_string_lossy().into_owned()),
+        (
+            "CODEX_TEST_OUTSIDE_MARKER".to_owned(),
+            outside.to_string_lossy().into_owned(),
+        ),
+        (
+            "CODEX_TEST_INSIDE_MARKER".to_owned(),
+            inside.to_string_lossy().into_owned(),
+        ),
+    ]);
+    let output = run_payload_environment(&workspace, env, &["/bin/true"]);
+    assert!(output.status.success(), "{output:?}");
+    assert!(
+        !outside.exists(),
+        "loader ran before filesystem confinement"
+    );
+    assert!(inside.is_file(), "payload loader constructor did not run");
+    assert!(String::from_utf8_lossy(&output.stdout).contains("payload-constructor"));
+}
+
+#[tokio::test]
+async fn chunked_environment_preserves_two_individually_valid_large_values() {
+    if should_skip_bwrap_tests().await {
+        return;
+    }
+    let workspace = tempfile::TempDir::new().unwrap();
+    let env = HashMap::from([
+        ("FIRST".to_owned(), "a".repeat(80 * 1024)),
+        ("SECOND".to_owned(), "b".repeat(80 * 1024)),
+    ]);
+    let output = run_payload_environment(
+        workspace.path(),
+        env,
+        &[
+            "/bin/sh",
+            "-c",
+            "test ${#FIRST} -eq 81920 && test ${#SECOND} -eq 81920",
+        ],
+    );
+    assert!(output.status.success(), "{output:?}");
+}
+
+#[tokio::test]
+async fn chunked_environment_preserves_existing_large_control_character_values() {
+    if should_skip_bwrap_tests().await {
+        return;
+    }
+    let workspace = tempfile::TempDir::new().unwrap();
+    let env: HashMap<String, String> = (0..32)
+        .map(|index| (format!("VALUE_{index}"), "\n".repeat(40960)))
+        .collect();
+    let output = run_payload_environment(workspace.path(), env, &["/bin/true"]);
+    assert!(output.status.success(), "{output:?}");
+}
