+#[test]
+fn command_environment_preserves_large_values_and_utf8_chunk_boundaries() {
+    let payload = std::collections::HashMap::from([
+        ("FIRST".to_owned(), "a".repeat(80 * 1024)),
+        ("SECOND".to_owned(), "b".repeat(80 * 1024)),
+        ("UNICODE".to_owned(), "é".repeat(40 * 1024)),
+        (
+            "$serde_json::private::Number".to_owned(),
+            "7301592846".to_owned(),
+        ),
+        (
+            "$serde_json::private::RawValue".to_owned(),
+            "{\"unchanged\":true}".to_owned(),
+        ),
+    ]);
+    let encoded = encode_sandbox_command_environment(&payload).unwrap();
+    assert!(encoded.len() > 3);
+    assert!(
+        encoded
+            .values()
+            .all(|chunk| chunk.len() <= COMMAND_ENV_CHUNK_BYTES)
+    );
+    assert_eq!(
+        decode_sandbox_command_environment(&encoded).unwrap(),
+        Some(payload)
+    );
+}
