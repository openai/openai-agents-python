+        ("LD_AUDIT".to_owned(), "/model-writable/audit.so".to_owned()),
+        ("BASH_ENV".to_owned(), "/model-writable/startup".to_owned()),
+        ("APP_MODE".to_owned(), "payload".to_owned()),
+    ]);
+    let bootstrap = prepare_linux_sandbox_environment(&payload).expect("bootstrap environment");
+    for name in ["LD_PRELOAD", "LD_AUDIT", "BASH_ENV", "APP_MODE"] {
+        assert!(!bootstrap.contains_key(name));
+    }
+    let expected_path = std::env::var("CODEX_SDK_BWRAP_SEARCH_PATH")
+        .or_else(|_| std::env::var("PATH"))
+        .ok();
+    assert_eq!(bootstrap.get("PATH"), expected_path.as_ref());
+    assert_eq!(
+        decode_sandbox_command_environment(&bootstrap).unwrap(),
+        Some(payload)
+    );
+}
