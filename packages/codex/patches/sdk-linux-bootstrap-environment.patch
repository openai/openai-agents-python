index dad16e23..ece326a1 100644
--- a/codex-rs/sandboxing/src/landlock.rs
+++ b/codex-rs/sandboxing/src/landlock.rs
@@ -6,6 +6,181 @@ use std::path::Path;
 /// helper.
 pub const CODEX_LINUX_SANDBOX_ARG0: &str = "codex-linux-sandbox";
 
+/// Payload environment transported as data until the sandbox's final exec boundary.
+pub const CODEX_SANDBOX_COMMAND_ENV_JSON: &str = "CODEX_SANDBOX_COMMAND_ENV_JSON";
+
+const COMMAND_ENV_CHUNK_BYTES: usize = 64 * 1024;
+const MAX_COMMAND_ENV_CHUNKS: usize = 1024;
+const COMMAND_ENV_PREFIX: &str = "CODEX_SANDBOX_COMMAND_ENV_JSON_";
+
+pub fn is_reserved_sandbox_environment_variable(name: &str) -> bool {
+    name.eq_ignore_ascii_case(CODEX_SANDBOX_COMMAND_ENV_JSON)
+        || name
+            .get(..COMMAND_ENV_PREFIX.len())
+            .is_some_and(|prefix| prefix.eq_ignore_ascii_case(COMMAND_ENV_PREFIX))
+}
+
+fn invalid_command_env() -> std::io::Error {
+    std::io::Error::new(
+        std::io::ErrorKind::InvalidInput,
+        "invalid sandbox command environment",
+    )
+}
+
+pub fn encode_sandbox_command_environment(
+    payload: &std::collections::HashMap<String, String>,
+) -> std::io::Result<std::collections::HashMap<String, String>> {
+    if payload
+        .keys()
+        .any(|name| is_reserved_sandbox_environment_variable(name))
+    {
+        return Err(invalid_command_env());
+    }
+    let mut encoded = format!("{}:", payload.len());
+    for (name, value) in payload {
+        if name.contains('\0') || value.contains('\0') {
+            return Err(invalid_command_env());
+        }
+        encoded.push_str(&format!("{}:", name.len()));
+        encoded.push_str(name);
+        encoded.push_str(&format!("{}:", value.len()));
+        encoded.push_str(value);
+    }
+    let mut carrier = std::collections::HashMap::new();
+    let mut offset = 0;
+    let mut count = 0;
+    while offset < encoded.len() {
+        let mut end = (offset + COMMAND_ENV_CHUNK_BYTES).min(encoded.len());
+        while !encoded.is_char_boundary(end) {
+            end -= 1;
+        }
+        carrier.insert(
+            format!("{COMMAND_ENV_PREFIX}{count}"),
+            encoded[offset..end].to_owned(),
+        );
+        offset = end;
+        count += 1;
+        if count > MAX_COMMAND_ENV_CHUNKS {
+            return Err(invalid_command_env());
+        }
+    }
+    carrier.insert(
+        CODEX_SANDBOX_COMMAND_ENV_JSON.to_owned(),
+        format!("1:{count}"),
+    );
+    Ok(carrier)
+}
+
+pub fn decode_sandbox_command_environment(
+    carrier: &std::collections::HashMap<String, String>,
+) -> std::io::Result<Option<std::collections::HashMap<String, String>>> {
+    let chunks = carrier
+        .keys()
+        .filter(|name| name.starts_with(COMMAND_ENV_PREFIX))
+        .count();
+    let reserved = carrier
+        .keys()
+        .filter(|name| is_reserved_sandbox_environment_variable(name))
+        .count();
+    let Some(header) = carrier.get(CODEX_SANDBOX_COMMAND_ENV_JSON) else {
+        return if reserved == 0 {
+            Ok(None)
+        } else {
+            Err(invalid_command_env())
+        };
+    };
+    let count: usize = header
+        .strip_prefix("1:")
+        .ok_or_else(invalid_command_env)?
+        .parse()
+        .map_err(|_| invalid_command_env())?;
+    if count == 0
+        || count > MAX_COMMAND_ENV_CHUNKS
+        || count != chunks
+        || reserved != count + 1
+        || header != &format!("1:{count}")
+    {
+        return Err(invalid_command_env());
+    }
+    let mut encoded = String::new();
+    for index in 0..count {
+        let chunk = carrier
+            .get(&format!("{COMMAND_ENV_PREFIX}{index}"))
+            .ok_or_else(invalid_command_env)?;
+        if chunk.is_empty() || chunk.len() > COMMAND_ENV_CHUNK_BYTES {
+            return Err(invalid_command_env());
+        }
+        encoded.push_str(chunk);
+    }
+    let mut remaining = encoded.as_str();
+    let count = read_command_env_length(&mut remaining)?;
+    if count > remaining.len() / 4 {
+        return Err(invalid_command_env());
+    }
+    let mut payload = std::collections::HashMap::new();
+    for _ in 0..count {
+        let name = read_command_env_string(&mut remaining)?.to_owned();
+        let value = read_command_env_string(&mut remaining)?.to_owned();
+        if name.contains('\0') || value.contains('\0') || payload.insert(name, value).is_some() {
+            return Err(invalid_command_env());
+        }
+    }
+    if !remaining.is_empty() {
+        return Err(invalid_command_env());
+    }
+    if payload
+        .keys()
+        .any(|name| is_reserved_sandbox_environment_variable(name))
+    {
+        return Err(invalid_command_env());
+    }
+    Ok(Some(payload))
+}
+
+fn read_command_env_length(remaining: &mut &str) -> std::io::Result<usize> {
+    let (length, rest) = remaining.split_once(':').ok_or_else(invalid_command_env)?;
+    let parsed: usize = length.parse().map_err(|_| invalid_command_env())?;
+    if length != parsed.to_string() {
+        return Err(invalid_command_env());
+    }
+    *remaining = rest;
+    Ok(parsed)
+}
+
+fn read_command_env_string<'a>(remaining: &mut &'a str) -> std::io::Result<&'a str> {
+    let length = read_command_env_length(remaining)?;
+    let value = remaining.get(..length).ok_or_else(invalid_command_env)?;
+    *remaining = remaining.get(length..).ok_or_else(invalid_command_env)?;
+    Ok(value)
+}
+
+pub fn prepare_linux_sandbox_environment(
+    payload: &std::collections::HashMap<String, String>,
+) -> std::io::Result<std::collections::HashMap<String, String>> {
+    // Bootstrap lookups use the trusted executor environment, never payload PATH
+    // or loader variables. Retain only inputs needed by helper startup/discovery.
+    let mut bootstrap = std::collections::HashMap::new();
+    for name in [
+        "PATH",
+        "TMPDIR",
+        "CARGO_BIN_EXE_bwrap",
+        "CODEX_SDK_BWRAP_SEARCH_PATH",
+        "RUNFILES_DIR",
+        "TEST_SRCDIR",
+        "RUNFILES_MANIFEST_FILE",
+        "TEST_WORKSPACE",
+    ] {
+        if let Ok(value) = std::env::var(name) {
+            bootstrap.insert(name.to_owned(), value);
+        }
+    }
+    if let Some(path) = bootstrap.get("CODEX_SDK_BWRAP_SEARCH_PATH").cloned() {
+        bootstrap.insert("PATH".to_owned(), path);
+    }
+    bootstrap.extend(encode_sandbox_command_environment(payload)?);
+    Ok(bootstrap)
+}
