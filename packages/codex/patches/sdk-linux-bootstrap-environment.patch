+#[test]
+fn command_environment_rejects_incomplete_or_ambiguous_framing() {
+    let encoded = encode_sandbox_command_environment(&std::collections::HashMap::new()).unwrap();
+    for (key, value) in [
+        (CODEX_SANDBOX_COMMAND_ENV_JSON, "0"),
+        (CODEX_SANDBOX_COMMAND_ENV_JSON, "01"),
+        (CODEX_SANDBOX_COMMAND_ENV_JSON, "1025"),
+        ("CODEX_SANDBOX_COMMAND_ENV_JSON_1", "{}"),
+        ("codex_sandbox_command_env_json_0", "{}"),
+        ("CODEX_SANDBOX_COMMAND_ENV_JSON_é", "{}"),
+        ("CODEX_SANDBOX_COMMAND_ENV_JSON_0", "[]"),
+    ] {
+        let mut invalid = encoded.clone();
+        invalid.insert(key.to_owned(), value.to_owned());
+        assert!(decode_sandbox_command_environment(&invalid).is_err());
+    }
+    for missing in encoded.keys() {
+        let mut invalid = encoded.clone();
+        invalid.remove(missing);
+        assert!(decode_sandbox_command_environment(&invalid).is_err());
+    }
+    assert_eq!(
+        decode_sandbox_command_environment(&std::collections::HashMap::new()).unwrap(),
+        None
+    );
+}
