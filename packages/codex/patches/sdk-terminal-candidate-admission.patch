+async fn release_held_tool_results(sess: &Session, step: &StepContext, withheld: bool) {
+    let Some(held) = step
+        .turn
+        .extension_data
+        .get::<codex_extension_api::HeldToolCompletionResults>()
+    else {
+        return;
+    };
+    let outputs =
+        std::mem::take(&mut *held.outputs.lock().expect("held terminal outputs poisoned"));
+    for (mut envelope, mut succeeded) in outputs {
+        if withheld {
+            if let ResponseItem::FunctionCallOutput { output, .. } = &mut envelope.item {
+                *output = codex_protocol::models::FunctionCallOutputPayload::from_text(
+                    "Native terminal tool output withheld by completion policy".into(),
+                );
+                output.success = Some(false);
+                succeeded = false;
+                // Result metadata can contain the same rejected application body.
+                envelope.metadata =
+                    envelope
+                        .metadata
+                        .map(|metadata| codex_history::CodexHarnessMetadata {
+                            sdk_agent_profile: metadata.sdk_agent_profile,
+                            sdk_agent_graph: metadata.sdk_agent_graph,
+                            ..Default::default()
+                        });
+            }
+        }
+        sess.record_tool_result(
+            &step.turn,
+            &step.settings.model_info,
+            DirectToolResult {
+                envelope,
+                succeeded,
+                pending_exec: None,
+            },
+        )
+        .await;
+    }
+}
+
+async fn release_failed_tool_candidates(sess: &Session, step: &StepContext) {
+    if step
+        .turn
+        .extension_data
+        .get::<codex_extension_api::HeldToolCompletionResults>()
+        .is_some_and(|held| held.suspending.load(std::sync::atomic::Ordering::Acquire))
+    {
+        return;
+    }
+    release_held_tool_results(sess, step, true).await;
+}
