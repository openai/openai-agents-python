+/// Process-local authority for a taskless turn's host startup publication.
+/// Tree and thread shutdown cancel their descendants. Replacement and stop
+/// cancel only the exact turn's child.
+#[derive(Clone, Debug, Default)]
+pub struct TurnStartupGate {
+    publication: Arc<Mutex<()>>,
+    cancellation: CancellationToken,
+}
+
+impl TurnStartupGate {
+    pub fn child(&self) -> Self {
+        Self {
+            publication: Arc::clone(&self.publication),
+            cancellation: self.cancellation.child_token(),
+        }
+    }
+
+    pub fn cancel(&self) {
+        let _publication = self.publication.lock().expect("turn startup publication");
+        self.cancellation.cancel();
+    }
+
+    pub fn is_cancelled(&self) -> bool {
+        self.cancellation.is_cancelled()
+    }
+
+    pub async fn cancelled(&self) {
+        self.cancellation.cancelled().await;
+    }
+
+    /// Acquire other required locks first. Hold this guard only through a short,
+    /// synchronous publication without callbacks.
+    pub fn lock_current(&self) -> Option<MutexGuard<'_, ()>> {
+        let publication = self.publication.lock().expect("turn startup publication");
+        (!self.is_cancelled()).then_some(publication)
+    }
+}
