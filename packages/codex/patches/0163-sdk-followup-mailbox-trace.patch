+        .expect("resume should refuse promptly")
+        .expect_err("a live writer precludes reopening the thread");
+    assert_matches!(
+        premature.details(),
+        CodexErrorDetails::InvalidRequest(message)
+            if message == &format!("thread {child_id} is still shutting down")
+    );
+
+    drop(hold_writer);
+    timeout(Duration::from_secs(10), close)
+        .await
+        .expect("close deadline")
+        .expect("child close");
+    assert_eq!(
+        timeout(Duration::from_secs(10), resume())
+            .await
+            .expect("resume deadline")
+            .expect("resume after the original writer exits"),
+        child_id,
+    );
+    let reopened = harness
+        .manager
+        .get_thread(child_id)
+        .await
+        .expect("reopened child");
+    assert!(!Arc::ptr_eq(&reopened, &child));
+    assert!(reopened.is_running());
+    harness
+        .control
+        .shutdown_live_agent(child_id)
+        .await
+        .expect("close reopened child");
+    harness
+        .control
+        .shutdown_live_agent(parent_id)
+        .await
+        .expect("close parent");
+}
