+pub(crate) struct MailboxWakeBatch {
+    pub(crate) len: usize,
+    pub(crate) start_options: TurnStartOptions,
+    pub(crate) initiating_agent_path: Option<AgentPath>,
+    trace: Option<MailboxTrace>,
+}
+
+impl MailboxWakeBatch {
+    pub(crate) fn wake_span(
+        &self,
+        sub_id: &str,
+        restriction: sdk_trace::ScopeRestriction,
+    ) -> Span {
+        let parent = self.trace.as_ref().and_then(|trace| {
+            let context = context_from_w3c_trace_context(&trace.carrier)?;
+            let context = match &trace.policy {
+                Some(policy) => context.with_value(policy.upgrade()?),
+                None => context,
+            };
+            Some((trace, context))
+        });
+        let parent = match parent {
+            Some((trace, parent)) => {
+                let immediate = trace.submission_id == sub_id;
+                if immediate && restriction == sdk_trace::ScopeRestriction::Unrestricted {
+                    return Span::current();
+                }
+                let dispatch = immediate.then(Span::current);
+                restriction.apply(parent, dispatch.as_ref())
+            }
+            // A mixed or unknown owner has no shared parent, storage, or capture consent.
+            None => sdk_trace::suppressed_context(),
+        };
+        let span = info_span!(parent: None, "mailbox_turn_wake");
+        set_parent_from_context(&span, parent);
+        span
+    }
+}
