+#[derive(Clone)]
+pub(super) struct MailboxTrace {
+    submission_id: String,
+    carrier: W3cTraceContext,
+    policy: Option<Weak<sdk_trace::ScopePolicy>>,
+    // A triggering submission owns the wake. Queue-only mail contributes
+    // identity without keeping an ended caller's storage and exporter alive.
+    _trigger_lease: Option<Arc<sdk_trace::ScopePolicy>>,
+}
+
+impl MailboxTrace {
+    pub(super) fn from_submission(
+        submission_id: &str,
+        carrier: Option<W3cTraceContext>,
+        policy: Option<Arc<sdk_trace::ScopePolicy>>,
+        trigger_turn: bool,
+    ) -> Option<Self> {
+        let carrier = carrier?;
+        Some(Self {
+            submission_id: submission_id.to_owned(),
+            carrier,
+            policy: policy.as_ref().map(Arc::downgrade),
+            _trigger_lease: policy.filter(|_| trigger_turn),
+        })
+    }
+
+    fn same_owner(&self, other: &Self) -> bool {
+        self.carrier == other.carrier
+            && self
+                .policy
+                .as_ref()
+                .zip(other.policy.as_ref())
+                .is_some_and(|(left, right)| Weak::ptr_eq(left, right))
+    }
+}
