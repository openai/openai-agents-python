+    finish_old.notify_one();
+    let (reserved, _) = receive(&before_rx).await;
+    let mut owner_b = match (mixed_owner, case) {
+        (Some(owner), _) => Some(owner),
+        (None, MailboxStartupCase::CurrentTurn | MailboxStartupCase::Interrupted) => None,
+        (None, _) if ready_mail => None,
+        (None, _) => Some(
+            submit(
+                &session,
+                "admit-b",
+                LATE,
+                "22",
+                /*disabled*/ true,
+                !queue_after_seal,
+            )
+            .await,
+        ),
+    };
+    assert!(first_request.requests().is_empty());
+    assert!(regular_rx.is_empty());
+    assert!(session.input_queue.has_trigger_turn_mailbox_items().await);
+
+    let expected_first_turn = if case == MailboxStartupCase::Interrupted {
+        let reservation = Arc::clone(
+            &session
+                .active_turn
+                .lock()
+                .await
+                .as_ref()
+                .expect("A reserved")
+                .turn_state,
+        );
+        timeout(Duration::from_secs(10), session.interrupt_task())
+            .await
+            .expect("interrupt should return while the original start hook is held");
+        assert!(
+            session
+                .active_turn
+                .lock()
+                .await
+                .as_ref()
+                .is_none_or(|active| !Arc::ptr_eq(&active.turn_state, &reservation))
+        );
+        assert!(session.input_queue.has_trigger_turn_mailbox_items().await);
+        // The interrupted seal is gone. Accept queue-only mail before the detached
+        // retry is polled, so it has no fence of its own yet.
+        let queued = submit(&session, "admit-between", QUEUED, "22", true, false);
+        tokio::pin!(queued);
+        assert!(futures::poll!(&mut queued).is_ready());
+        let (retried, policy) = receive(&before_rx).await;
+        owner_b = Some(submit(&session, "admit-b", LATE, "33", true, true).await);
+        assert_ne!(retried, reserved);
+        assert!(Arc::ptr_eq(
+            &policy.expect("retried policy"),
+            owner_a.as_ref().expect("trigger owner"),
+        ));
+        let direct = timeout(
+            Duration::from_secs(10),
+            super::turn_input::handle(
+                &session,
+                TurnInputRequest::user_input(vec![UserInput::Text {
+                    text: "synthetic later direct input".to_string(),
+                    text_elements: Vec::new(),
+                }]),
+                TurnInputMode::StartIfIdle,
+                "later-direct".to_string(),
+            ),
+        )
+        .await
+        .expect("mailbox priority decision while the retried start hook is held")
+        .expect("direct admission result");
+        assert_eq!(
+            direct,
+            TurnInputSubmission::NotSubmitted {
+                reason: codex_protocol::turn_input::NotSubmittedReason::PendingTriggerTurn,
+            }
+        );
+        retried
+    } else {
+        reserved
+    };
+    release_registration.add_permits(1);
+    let (first_turn, first_policy) = receive(&regular_rx).await;
+    let first_policy = first_policy.expect("first sampling scope");
+    assert_eq!(first_turn, expected_first_turn);
+    if queue_during_sampling {
+        let queued = InterAgentCommunication::new(
+            AgentPath::try_from("/root/sender").expect("sender path"),
+            AgentPath::root(),
+            Vec::new(),
+            QUEUED.to_owned(),
+            /*trigger_turn*/ false,
+        );
+        handlers::inter_agent_communication(
+            &session,
+            "admit-c".to_owned(),
+            queued,
+            Default::default(),
+            None,
+        )
+        .await;
+    }
+    let first_done = if queue_during_sampling || ready_mail {
+        let active = session.active_turn.lock().await;
+        let task = active
+            .as_ref()
+            .and_then(|turn| turn.task.as_ref())
+            .expect("first task registered");
+        Some(Arc::clone(&task.done).notified_owned())
+    } else {
+        None
+    };
+    release_sampling.add_permits(1);
+    if mixed {
+        assert!(first_policy.disabled);
+        assert!(!first_policy.include_sensitive_data);
+        if let Some(owner_a) = &owner_a {
+            assert!(!Arc::ptr_eq(&first_policy, owner_a));
+        }
+        assert!(!Arc::ptr_eq(
+            &first_policy,
+            owner_b.as_ref().expect("trigger owner")
+        ));
+    } else {
+        assert!(Arc::ptr_eq(
+            &first_policy,
+            owner_a.as_ref().expect("trigger owner"),
+        ));
+    }
+    let completion = async |turn_id: &str| {
+        timeout(Duration::from_secs(10), async {
+            loop {
+                let event = events.recv().await.expect("turn event");
+                if event.id == turn_id && matches!(event.msg, EventMsg::TurnComplete(_)) {
+                    break;
+                }
+            }
+        })
+        .await
+        .expect("turn completion deadline");
+    };
+    completion(&first_turn).await;
+    if let Some(done) = first_done {
+        // The original task finishes after the pending-work scheduler returns.
+        timeout(Duration::from_secs(10), done)
+            .await
+            .expect("queue-only mail must not start another wake");
+        assert!(before_rx.is_empty());
+        assert!(regular_rx.is_empty());
+        assert!(second_request.requests().is_empty());
+        assert!(!session.input_queue.has_trigger_turn_mailbox_items().await);
+    }
+    if ready_mail {
+        owner_b = Some(submit(&session, "admit-ready-b", LATE, "22", true, false).await);
+        submit(&session, "admit-ready-c", QUEUED, "44", true, false).await;
+        assert!(session.input_queue.has_pending_mailbox_items().await);
+        assert!(!session.input_queue.has_trigger_turn_mailbox_items().await);
+        assert!(before_rx.is_empty());
+        assert!(regular_rx.is_empty());
+        assert!(second_request.requests().is_empty());
+    }
+    let input = first_request.single_request().input();
+    let first_position = input
+        .iter()
+        .position(|item| item.to_string().contains(FIRST));
+    let late_position = input
+        .iter()
+        .position(|item| item.to_string().contains(LATE));
+    assert!(first_position.is_some());
+    assert_eq!(
+        input
+            .iter()
+            .filter(|item| item.to_string().contains(FIRST))
+            .count(),
+        1
+    );
+    if mixed {
+        assert!(late_position.is_some());
+        assert!(first_position < late_position);
+        assert_eq!(
+            input
+                .iter()
+                .filter(|item| item.to_string().contains(LATE))
+                .count(),
+            1
+        );
+        assert!(second_request.requests().is_empty());
+        assert!(regular_rx.is_empty());
+    } else if case == MailboxStartupCase::CurrentTurn {
+        assert_eq!(late_position, None);
+        let queued: Vec<_> = input
+            .iter()
+            .enumerate()
+            .filter_map(|(index, item)| item.to_string().contains(QUEUED).then_some(index))
+            .collect();
+        assert_eq!(queued.len(), 1);
+        assert!(first_position.expect("first wake input") < queued[0]);
+    } else {
+        assert_eq!(late_position, None);
+        assert!(!input.iter().any(|item| item.to_string().contains(QUEUED)));
+        let next = if case == MailboxStartupCase::LateQueued {
+            let session = Arc::clone(&session);
+            Some(tokio::spawn(async move {
+                submit(&session, "admit-next", NEXT, "33", false, true).await
+            }))
+        } else {
+            None
+        };
+        let reserve_explicit = async |turn_id: &'static str| {
+            let session = Arc::clone(&session);
+            let context = sdk_trace::suppressed_context();
+            let policy = sdk_trace::policy_for_context(&context).expect("explicit caller policy");
+            let span = tracing::info_span!(parent: None, "explicit_child_start");
+            codex_otel::set_parent_from_context(&span, context);
+            let start = tokio::spawn(
+                async move {
+                    super::turn_input::handle(
+                        &session,
+                        TurnInputRequest::user_input(vec![UserInput::Text {
+                            text: EXPLICIT.to_owned(),
+                            text_elements: Vec::new(),
+                        }]),
+                        TurnInputMode::StartIfIdle,
+                        turn_id.to_owned(),
+                    )
+                    .await
+                }
+                .instrument(span),
+            );
+            let (reservation, _) = receive(&before_rx).await;
+            assert_eq!(reservation, turn_id);
+            (start, policy)
+        };
+        let start_explicit = async |turn_id: &'static str| {
+            let (start, policy) = reserve_explicit(turn_id).await;
+            release_registration.add_permits(1);
+            let (running, running_policy) = receive(&regular_rx).await;
+            assert_eq!(running, turn_id);
+            let result = timeout(Duration::from_secs(10), start)
+                .await
+                .expect("explicit admission deadline")
+                .expect("explicit admission task")
+                .expect("explicit admission result");
+            assert_eq!(
+                result,
+                TurnInputSubmission::Started {
+                    turn_id: running.clone(),
+                }
+            );
+            assert!(Arc::ptr_eq(
+                &running_policy.expect("explicit sampling policy"),
+                &policy,
+            ));
+            (running, policy)
+        };
+        if case == MailboxStartupCase::ReadyQueuedExplicitAbort {
+            let (aborted, _) = reserve_explicit("aborted-explicit").await;
+            assert!(second_request.requests().is_empty());
+            timeout(Duration::from_secs(10), handlers::interrupt(&session))
+                .await
+                .expect("interrupt the taskless explicit reservation");
+            let result = timeout(Duration::from_secs(10), aborted)
+                .await
+                .expect("taskless startup deadline")
+                .expect("taskless startup task");
+            assert!(matches!(
+                result,
+                Err(error)
+                    if codex_protocol::error::CodexErrKind::from(&error)
+                        == codex_protocol::error::CodexErrKind::TurnAborted
+            ));
+            assert!(session.input_queue.has_pending_mailbox_items().await);
+            assert!(regular_rx.is_empty());
+        }
+        if interrupt_explicit {
+            let (interrupted, _) = start_explicit("interrupted-explicit").await;
+            assert!(second_request.requests().is_empty());
+            // Session.cancel_all(force) sends Op::Interrupt, handled here, after the
+            // exact task registers. The RegularTaskStart gate holds it before recording.
+            timeout(Duration::from_secs(10), handlers::interrupt(&session))
+                .await
+                .expect("force interrupt before the first recording");
+            timeout(Duration::from_secs(10), async {
+                loop {
+                    let event = events.recv().await.expect("interrupted turn event");
+                    if event.id == interrupted && matches!(event.msg, EventMsg::TurnAborted(_)) {
+                        break;
+                    }
+                }
+            })
+            .await
+            .expect("interrupted turn abort");
+            assert!(second_request.requests().is_empty());
+            assert!(before_rx.is_empty());
+            assert!(regular_rx.is_empty());
+            assert!(!session.input_queue.has_trigger_turn_mailbox_items().await);
+        }
+        let (second_turn, second_policy) = if explicit_start {
+            start_explicit("later-explicit").await
+        } else {
+            let (late_reservation, _) = receive(&before_rx).await;
+            release_registration.add_permits(1);
+            let (turn, policy) = receive(&regular_rx).await;
+            assert_eq!(late_reservation, turn);
+            (turn, policy.expect("successor sampling policy"))
+        };
+        assert_ne!(first_turn, second_turn);
+        if let Some(next) = next {
+            let next_owner = timeout(Duration::from_secs(10), next)
+                .await
+                .expect("follow-up admission deadline")
+                .expect("follow-up admission");
+            assert!(second_policy.disabled);
+            assert!(!second_policy.include_sensitive_data);
+            assert!(!Arc::ptr_eq(&second_policy, &next_owner));
+        } else if explicit_start {
+            assert!(second_policy.disabled);
+            assert!(!second_policy.include_sensitive_data);
+        } else if case == MailboxStartupCase::Interrupted {
+            assert!(second_policy.disabled);
+            assert!(!second_policy.include_sensitive_data);
+            assert!(!Arc::ptr_eq(
+                &second_policy,
+                owner_b.as_ref().expect("trigger owner"),
+            ));
+        } else {
+            assert!(Arc::ptr_eq(
+                &second_policy,
+                owner_b.as_ref().expect("trigger owner"),
+            ));
+        }
+        let trigger_owner = if late_explicit_trigger {
+            assert!(second_request.requests().is_empty());
+            let owner = submit(
+                &session,
+                "admit-trigger-after-explicit-registration",
+                NEXT,
+                "33",
+                /*disabled*/ false,
+                /*trigger_turn*/ true,
+            )
+            .await;
+            assert!(session.input_queue.has_trigger_turn_mailbox_items().await);
+            assert!(before_rx.is_empty());
+            Some(owner)
+        } else {
+            None
+        };
+        release_sampling.add_permits(1);
+        completion(&second_turn).await;
+        let input =
+            if let Some((trigger_request, trigger_owner)) = trigger_request.zip(trigger_owner) {
+                let direct_input = second_request.single_request().input();
+                assert!(
+                    direct_input
+                        .iter()
+                        .any(|item| item.to_string().contains(EXPLICIT))
+                );
+                assert!(!direct_input.iter().any(|item| {
+                    let item = item.to_string();
+                    [LATE, QUEUED, NEXT].iter().any(|mail| item.contains(mail))
+                }));
+                let (wake_reservation, _) = receive(&before_rx).await;
+                release_registration.add_permits(1);
+                let (wake_turn, wake_policy) = receive(&regular_rx).await;
+                assert_eq!(wake_reservation, wake_turn);
+                assert_ne!(second_turn, wake_turn);
+                let wake_policy = wake_policy.expect("mixed wake policy");
+                assert!(wake_policy.disabled);
+                assert!(!wake_policy.include_sensitive_data);
+                assert!(!Arc::ptr_eq(&wake_policy, &trigger_owner));
+                release_sampling.add_permits(1);
+                completion(&wake_turn).await;
+                trigger_request.single_request().input()
+            } else {
+                second_request.single_request().input()
+            };
+        let late: Vec<_> = input
+            .iter()
+            .enumerate()
+            .filter_map(|(index, item)| item.to_string().contains(LATE).then_some(index))
+            .collect();
+        let queued: Vec<_> = input
+            .iter()
+            .enumerate()
+            .filter_map(|(index, item)| item.to_string().contains(QUEUED).then_some(index))
+            .collect();
+        assert_eq!(
+            late.len(),
+            1,
+            "successor first request must receive the deferred mail"
+        );
+        if queue_after_seal || ready_mail {
+            assert_eq!(queued.len(), 1);
+            assert!(late[0] < queued[0]);
+        }
+        if case == MailboxStartupCase::LateQueued || late_explicit_trigger {
+            let next: Vec<_> = input
+                .iter()
+                .enumerate()
+                .filter_map(|(index, item)| item.to_string().contains(NEXT).then_some(index))
+                .collect();
+            assert_eq!(next.len(), 1);
+            assert!(queued[0] < next[0]);
+        } else if case == MailboxStartupCase::Interrupted {
+            assert_eq!(queued.len(), 1);
+            assert!(queued[0] < late[0]);
+        } else if explicit_start {
+            let user = input
+                .iter()
+                .position(|item| item.to_string().contains(EXPLICIT));
+            assert!(user.expect("explicit user input precedes mailbox input") < late[0]);
+        } else {
+            assert!(queued.is_empty());
+        }
+    }
+    assert!(!session.input_queue.has_trigger_turn_mailbox_items().await);
+}
+
+#[derive(Clone, Copy)]
+enum HeldMailboxShutdown {
+    ChildTeardown,
+    TreeSignal,
+    QueuedClose,
+    BeforeRegistration,
+}
+
+#[test_case(HeldMailboxShutdown::ChildTeardown; "child teardown")]
+#[test_case(HeldMailboxShutdown::TreeSignal; "tree signal before the shutdown submission")]
+#[test_case(HeldMailboxShutdown::QueuedClose; "ordinary queued child close")]
+#[test_case(HeldMailboxShutdown::BeforeRegistration; "close while waiting to commit the prefix")]
+#[tokio::test]
+async fn shutdown_releases_reserved_mailbox_trace_without_consuming_input(
+    shutdown: HeldMailboxShutdown,
+) {
+    use codex_otel::sdk_trace;
+
+    struct HeldStartup {
+        entered: Arc<Notify>,
+        release: Arc<tokio::sync::Semaphore>,
+        held_turn_id: Option<&'static str>,
+    }
+
+    impl codex_extension_api::TurnLifecycleContributor for HeldStartup {
+        fn on_turn_start<'a>(
+            &'a self,
+            input: codex_extension_api::TurnStartInput<'a>,
+        ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+            Box::pin(async move {
+                if self.held_turn_id.is_some_and(|id| input.turn_id != id) {
+                    return;
+                }
+                self.entered.notify_one();
+                self.release.acquire().await.expect("startup gate").forget();
+            })
+        }
+    }
+
+    let server = start_mock_server().await;
+    let home = tempfile::tempdir().expect("synthetic Codex home");
+    let (mut session, _, events) = make_session_and_context_with_auth_config_home_and_rx(
+        CodexAuth::from_api_key("test-key"),
+        Vec::new(),
+        home.path(),
+        |config| {
+            config.model_provider.base_url = Some(format!("{}/v1", server.uri()));
+            config.model_provider.supports_websockets = false;
+        },
+    )
+    .await;
+    let queued_shutdown = matches!(shutdown, HeldMailboxShutdown::QueuedClose);
+    let entered = Arc::new(Notify::new());
+    let release = Arc::new(tokio::sync::Semaphore::new(0));
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::new();
+    builder.turn_lifecycle_contributor(Arc::new(HeldStartup {
+        entered: Arc::clone(&entered),
+        release: Arc::clone(&release),
+        held_turn_id: queued_shutdown.then_some("queued"),
+    }));
+    Arc::get_mut(&mut session)
+        .expect("unique session before startup")
+        .services
+        .extensions = Arc::new(builder.build());
+    let policy =
+        sdk_trace::policy_for_context(&sdk_trace::suppressed_context()).expect("synthetic policy");
+    let lease = Arc::downgrade(&policy);
+    let carrier = W3cTraceContext {
+        traceparent: Some("00-11111111111111111111111111111111-0000000000000066-01".into()),
+        tracestate: None,
+    };
+    let communication = InterAgentCommunication::new(
+        AgentPath::try_from("/root/sender").expect("sender path"),
+        AgentPath::root(),
+        Vec::new(),
+        "synthetic queued input".into(),
+        /*trigger_turn*/ true,
+    );
+
+    let direct_turn = timeout(Duration::from_secs(10), async {
+        if queued_shutdown {
+            let (tx_sub, rx_sub) = async_channel::bounded(4);
+            let session_loop = tokio::spawn(submission_loop(
+                Arc::clone(&session),
+                session.get_config().await,
+                rx_sub,
+            ));
+            let io = SessionIo {
+                tx_sub,
+                rx_event: events.clone(),
+                agent_status: session.agent_status.subscribe(),
+                session_loop_termination: session_loop_termination_from_handle(session_loop),
+                startup_control: Some(session.startup_control()),
+            };
+            io.submit_with_id(Submission {
+                id: "queued".into(),
+                op: Op::InterAgentCommunication {
+                    communication,
+                    start_options: Default::default(),
+                },
+                trace_policy: Some(policy),
+                trace: Some(carrier),
+                turn_extension_init: None,
+                parent_turn_id: None,
+                root_turn_id: None,
+                residency_guard: None,
+            })
+            .await
+            .expect("submit ordinary mailbox operation");
+            entered.notified().await;
+            assert!(lease.upgrade().is_some());
+            // StartOrSteer has always allowed a direct start even when trigger
+            // mail is pending. That mail must stay with its revoked wake.
+            let mut direct = Box::pin(io.submit_turn_input(
+                TurnInputRequest::user_input(vec![UserInput::Text {
+                    text: "synthetic buffered direct input".into(),
+                    text_elements: Vec::new(),
+                }]),
+                TurnInputMode::StartOrSteer,
+            ));
+            assert!(futures::poll!(&mut direct).is_pending());
+            assert_eq!(io.tx_sub.len(), 1);
+            let mut earlier_replies = Vec::new();
+            for _ in 0..3 {
+                let (reply, earlier_reply) = tokio::sync::oneshot::channel();
+                io.submit(Op::InterruptIfNoPendingInput {
+                    turn_id: "unrelated turn".into(),
+                    reply,
+                })
+                .await
+                .expect("fill the submission queue");
+                earlier_replies.push(earlier_reply);
+            }
+            assert!(io.tx_sub.is_full());
+            let mut abandoned = Box::pin(io.submit(Op::Shutdown));
+            assert!(futures::poll!(&mut abandoned).is_pending());
+            drop(abandoned);
+            assert!(!session.mailbox_startup_admission().is_cancelled());
+            assert!(!session.startup_admission().is_cancelled());
+
+            // The ordinary close commits even if its queue is full and its
+            // waiter goes away. The earlier queued operations still run first.
+            let mut close = Box::pin(io.shutdown_and_wait());
+            assert!(futures::poll!(&mut close).is_pending());
+            assert!(session.mailbox_startup_admission().is_cancelled());
+            assert!(!session.startup_admission().is_cancelled());
+            drop(close);
+            let TurnInputSubmission::Started { turn_id } = direct
+                .await
+                .expect("earlier direct admission ran before shutdown")
+            else {
+                panic!("the buffered direct input must start before shutdown");
+            };
+            for reply in earlier_replies {
+                assert!(!reply.await.expect("earlier operation ran before shutdown"));
+            }
+            io.session_loop_termination.clone().await;
+            Some(turn_id)
+        } else {
+            let trace = super::input_queue::MailboxTrace::from_submission(
+                "queued",
+                Some(carrier),
+                Some(policy),
+                /*trigger_turn*/ true,
+            );
+            session
+                .input_queue
+                .enqueue_mailbox_submission(communication, Default::default(), trace, true)
+                .await;
+            let mut wake = session.maybe_start_turn_for_pending_work();
+            if matches!(shutdown, HeldMailboxShutdown::BeforeRegistration) {
+                tokio::select! {
+                    () = entered.notified() => {}
+                    () = &mut wake => panic!("wake returned before the startup gate"),
+                }
+                assert!(lease.upgrade().is_some());
+                let unused_turn = tokio::sync::Mutex::new(crate::state::TurnState::default());
+                let prefix = session.input_queue.lock_mailbox_startup(&unused_turn).await;
+                release.add_permits(1);
+                assert!(futures::poll!(&mut wake).is_pending());
+                assert!(session.active_turn.try_lock().is_err());
+                // The wake has reacquired the active slot and is waiting for the
+                // prefix lock. Revoke it before it can publish the sealed input.
+                session.startup_admission().cancel();
+                drop(prefix);
+                wake.await;
+                handlers::shutdown_session_runtime(&session).await;
+            } else {
+                let wake = tokio::spawn(wake);
+                entered.notified().await;
+                assert!(lease.upgrade().is_some());
+                if matches!(shutdown, HeldMailboxShutdown::TreeSignal) {
+                    session.services.local_agent_runtime.shutdown.cancel();
+                    wake.await
+                        .expect("held wake must return after tree cancellation");
+                    handlers::shutdown_session_runtime(&session).await;
+                } else {
+                    handlers::shutdown_session_runtime(&session).await;
+                    wake.await
+                        .expect("held wake must return after child teardown");
+                }
+            }
+            None
+        }
+    })
+    .await
+    .expect("shutdown must retire the held startup");
+    assert!(lease.upgrade().is_none());
+    assert!(session.active_turn.lock().await.is_none());
+    assert_eq!(session.state.lock().await.last_started_turn_id, direct_turn);
