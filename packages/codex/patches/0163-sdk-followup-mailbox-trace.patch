+async fn failed_interrupt_retires_writer_after_close_waiter_is_cancelled() {
+    assert_held_writer_retirement(ShutdownOwner::CancelledClose).await;
+}
+
+#[tokio::test]
+async fn failed_interrupt_retires_writer_without_agent_close_owner() {
+    assert_held_writer_retirement(ShutdownOwner::Unowned).await;
+}
+
+#[tokio::test]
+async fn failed_interrupt_leaves_v2_idle_unload_to_its_owner() {
+    assert_held_writer_retirement(ShutdownOwner::IdleUnload).await;
+}
+
+#[tokio::test]
+async fn v1_idle_unload_honors_cancelled_close_after_failed_interrupt() {
+    assert_held_writer_retirement(ShutdownOwner::IdleUnloadWithCancelledClose).await;
+}
+
+enum ShutdownOwner {
+    CancelledClose,
+    Unowned,
+    IdleUnload,
+    IdleUnloadWithCancelledClose,
+}
+
+async fn assert_held_writer_retirement(owner: ShutdownOwner) {
+    use core_test_support::responses::{ev_assistant_message, ev_completed, mount_sse_once, sse};
+
+    let server = core_test_support::responses::start_mock_server().await;
+    let (home, mut config) = test_config().await;
+    config.model_provider.base_url = Some(format!("{}/v1", server.uri()));
+    config.model_provider.supports_websockets = false;
+    let legacy_idle_unload = matches!(owner, ShutdownOwner::IdleUnloadWithCancelledClose);
+    let v2_idle_unload = matches!(owner, ShutdownOwner::IdleUnload);
+    let cancel_close = legacy_idle_unload || matches!(owner, ShutdownOwner::CancelledClose);
+    if v2_idle_unload {
+        let _ = config.features.enable(Feature::MultiAgentV2);
+    }
+    if legacy_idle_unload || v2_idle_unload {
+        mount_sse_once(
+            &server,
+            sse(vec![
+                ev_assistant_message("message-1", "settled"),
+                ev_completed("response-1"),
+            ]),
+        )
+        .await;
+    }
+    let harness = AgentControlHarness::new_with_config(home, config).await;
+    let (parent_id, parent) = harness.start_thread().await;
+    if legacy_idle_unload {
+        assert_eq!(
+            parent
+                .session
+                .set_multi_agent_version_if_unset(MultiAgentVersion::V1),
+            MultiAgentVersion::V1
+        );
+    }
+    let child_id = harness
+        .spawn_anonymous_child(parent_id, SpawnAgentOptions::default())
+        .await;
+    let child = harness.manager.get_thread(child_id).await.expect("child");
+    let residency = if legacy_idle_unload || v2_idle_unload {
+        let version = if legacy_idle_unload {
+            MultiAgentVersion::V1
+        } else {
+            MultiAgentVersion::V2
+        };
+        assert_eq!(child.multi_agent_version(), Some(version));
+        timeout(Duration::from_secs(10), async {
+            let mut status = child.subscribe_status();
+            status
+                .wait_for(|status| matches!(status, AgentStatus::Completed(_)))
+                .await
+                .expect("child status channel");
+        })
+        .await
+        .expect("child must settle before idle unload");
+        Some(child.pin_residency_for_unload().await)
+    } else {
+        None
+    };
+    let finalization = child
+        .session
+        .services
+        .thread_extension_data
+        .get_or_init(crate::tasks::TaskFinalization::default);
+    let hold_writer = finalization.0.lock().await;
+
+    let mut close = Box::pin(child.shutdown_and_wait());
+    timeout(Duration::from_secs(10), async {
+        tokio::select! {
+            result = &mut close => panic!("close finished with the writer held: {result:?}"),
+            () = async {
+                while child.is_running() {
+                    tokio::task::yield_now().await;
+                }
+            } => {}
+        }
+    })
+    .await
+    .expect("committed close must close ingress");
+    let mut unload = residency.map(|residency| (residency, close));
+
+    timeout(Duration::from_secs(10), async {
+        while !child.session.is_shutting_down().await {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("shutdown must stop the mailbox receiver");
+    let mail = InterAgentCommunication::new(
+        AgentPath::root(),
+        AgentPath::try_from("/root/worker").expect("child path"),
+        Vec::new(),
+        "retained mail".to_string(),
+        /*trigger_turn*/ false,
+    );
+    let runtime = &harness.control.runtime;
+    runtime
+        .mailboxes
+        .enqueue(child_id, /*id*/ None, vec![mail.clone()])
+        .expect("enqueue unloaded mail");
+
+    for _ in 0..2 {
+        let interrupt = timeout(
+            Duration::from_secs(10),
+            harness.control.interrupt_agent(child_id),
+        )
+        .await
+        .expect("interrupt must return with writer held")
+        .expect_err("closed ingress rejects interrupts");
+        assert_matches!(interrupt.details(), CodexErrorDetails::InternalAgentDied);
+    }
+    let registered = harness
+        .manager
+        .get_thread(child_id)
+        .await
+        .expect("registered writer");
+    assert!(Arc::ptr_eq(&registered, &child));
+    let registry = &harness.control.runtime.registry;
+    let limit = registry
+        .reserve_spawn_slot(Some(1))
+        .err()
+        .expect("the registered writer still owns its spawn slot");
+    assert_matches!(limit.details(), CodexErrorDetails::AgentLimitReached { .. });
+
+    if cancel_close {
+        assert!(child.retirement_scheduled.load(Ordering::Relaxed));
+        let mut close = Box::pin(harness.control.close_agent(child_id));
+        timeout(Duration::from_secs(10), async {
+            tokio::select! {
+                result = &mut close => panic!("close finished with the writer held: {result:?}"),
+                () = async {
+                    while !child.discard_mail_on_retirement.load(Ordering::Relaxed) {
+                        tokio::task::yield_now().await;
+                    }
+                } => {}
+            }
+        })
+        .await
+        .expect("explicit close must commit mailbox deletion");
+        drop(close);
+    }
+
+    drop(hold_writer);
+    timeout(Duration::from_secs(10), child.wait_until_terminated())
+        .await
+        .expect("writer must terminate");
+    if let Some((_, shutdown)) = unload.as_mut() {
+        shutdown.await.expect("idle unload must join the writer");
+        let interrupt = harness
+            .control
+            .interrupt_agent(child_id)
+            .await
+            .expect_err("terminated writer still rejects interrupts during owned unload");
+        assert_matches!(interrupt.details(), CodexErrorDetails::InternalAgentDied);
+        let removed = harness
+            .manager
+            .remove_shutdown_thread_if_matches(&child)
+            .await
+            .expect("the idle unload owner removes the exact runtime");
+        assert!(Arc::ptr_eq(&removed, &child));
+        if legacy_idle_unload {
+            assert!(harness.control.get_agent_metadata(child_id).is_none());
+            assert!(registry.reserve_spawn_slot(Some(1)).is_ok());
+        } else {
+            assert!(harness.control.get_agent_metadata(child_id).is_some());
+            assert!(registry.reserve_spawn_slot(Some(1)).is_err());
+        }
+    } else {
+        timeout(Duration::from_secs(2), async {
+            while harness.manager.get_thread(child_id).await.is_ok() {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("terminated writer must retire without a second request");
+        assert!(registry.reserve_spawn_slot(Some(1)).is_ok());
+    }
+    if cancel_close {
+        assert_eq!(runtime.mailboxes.take(child_id), Vec::new());
