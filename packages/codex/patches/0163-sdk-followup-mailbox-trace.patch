+            .iter()
+            .position(|mail| mail.ends_startup_batch)
+            .map_or(mails.len(), |end| end + 1);
+        let (mails, later) = mails.split_at_mut(len);
+        if let Some(first) = later.first_mut() {
+            // The suffix can start with queue-only mail accepted between reservations.
+            // Keep it intact for a later wake without making that mail a trigger.
+            first.requires_wake = true;
