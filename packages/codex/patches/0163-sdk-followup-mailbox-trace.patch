+#[tokio::test]
+async fn mailbox_stale_start_keeps_replacement_plugin_selection() {
+    use super::TaskStartPreparation;
+    use super::TaskStartup;
+    use crate::state::ActiveTurn;
+
+    let (session, _, _) = make_session_and_context_with_rx().await;
+    let mut stale = session
+        .new_turn_with_default_settings("stale-wake".to_owned(), Default::default())
+        .await;
+    Arc::get_mut(&mut stale).unwrap().disabled_plugin_ids = vec!["stale-plugin".to_owned()];
+    let reservation = {
+        let mut active = session.active_turn.lock().await;
+        let turn = active.insert(ActiveTurn {
+            mailbox_start_sealed: true,
+            ..ActiveTurn::default()
+        });
+        Arc::clone(&turn.turn_state)
+    };
+    let preparation = session
+        .services
+        .thread_extension_data
+        .get_or_init(TaskStartPreparation::default);
+    let guard = preparation.0.lock().await;
+    let startup = session.start_task_inner(
+        stale,
+        Vec::new(),
+        PendingTask,
+        TaskStartup::Mailbox {
+            reservation: &reservation,
+            len: 1,
+        },
+    );
+    tokio::pin!(startup);
+    assert!(futures::poll!(&mut startup).is_pending());
+    assert!(session.active_disabled_plugin_ids().await.is_empty());
+
+    let mut replacement = session
+        .new_turn_with_default_settings("replacement".to_owned(), Default::default())
+        .await;
+    let plugins = vec!["replacement-plugin".to_owned()];
+    Arc::get_mut(&mut replacement).unwrap().disabled_plugin_ids = plugins.clone();
+    let replacement = session.start_task(replacement, Vec::new(), PendingTask);
+    tokio::pin!(replacement);
+    assert!(futures::poll!(&mut replacement).is_pending());
+    assert!(
+        !tokio::time::timeout(std::time::Duration::from_secs(5), startup)
+            .await
+            .expect("superseded startup returns while preparation is held")
+    );
+    assert!(session.active_disabled_plugin_ids().await.is_empty());
+
+    drop(guard);
+    assert!(replacement.await);
+    assert_eq!(session.active_disabled_plugin_ids().await, plugins);
+    session
+        .abort_all_tasks(codex_protocol::protocol::TurnAbortReason::Replaced)
+        .await;
+}
