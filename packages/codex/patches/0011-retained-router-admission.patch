+struct AdmissionRuntime {
+    name: &'static str,
+    custom: bool,
+}
+impl codex_tools::ToolExecutor<crate::tools::context::ToolInvocation> for AdmissionRuntime {
+    fn tool_name(&self) -> codex_tools::ToolName {
+        codex_tools::ToolName::plain(self.name)
+    }
+    fn spec(&self) -> codex_tools::ToolSpec {
+        panic!("admission must not inspect advertised specifications")
+    }
+    fn handle<'a>(
+        &'a self,
+        _: crate::tools::context::ToolInvocation,
+    ) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        crate::tools::context::ToolInvocation: 'a,
+    {
+        panic!("admission must not dispatch")
+    }
+}
+impl crate::tools::registry::CoreToolRuntime for AdmissionRuntime {
+    fn matches_kind(&self, payload: &codex_tools::ToolPayload) -> bool {
+        matches!(
+            (self.custom, payload),
+            (false, codex_tools::ToolPayload::Function { .. })
+                | (true, codex_tools::ToolPayload::Custom { .. })
+        )
+    }
+}
+fn admission_router(
+    name: &'static str,
+    custom: bool,
+    exposure: codex_tools::ToolExposure,
+) -> Arc<ToolRouter> {
+    let mut registry = crate::tools::registry::ToolRegistry::default();
+    registry.add_with_exposure(AdmissionRuntime { name, custom }, exposure);
+    Arc::new(ToolRouter::from_parts(
+        registry,
+        vec![],
+        codex_protocol::openai_models::ToolMode::Direct,
+        Default::default(),
+        None,
+        &[],
+    ))
+}
+#[test]
+fn retained_admission_uses_runtime_kind_and_independent_hidden_or_deferred_plans() {
+    let first_store = Arc::new(ExtensionData::new("same-textual-turn-id"));
+    let second_store = Arc::new(ExtensionData::new("same-textual-turn-id"));
+    let first = tool_admission(
+        "root".into(),
+        first_store.clone(),
+        admission_router("exec_command", false, codex_tools::ToolExposure::Hidden),
+    );
+    let second = tool_admission(
+        "child".into(),
+        second_store.clone(),
+        admission_router("apply_patch", true, codex_tools::ToolExposure::Deferred),
+    );
+    let function: ResponseItem = serde_json::from_value(serde_json::json!({
+        "type":"function_call", "call_id":"same-call", "name":"exec_command",
+        "namespace":"functions", "arguments":"{}"
+    }))
+    .unwrap();
+    let custom: ResponseItem = serde_json::from_value(serde_json::json!({
+        "type":"custom_tool_call", "call_id":"same-call", "name":"apply_patch", "input":"patch"
+    }))
+    .unwrap();
+    let wrong_kind: ResponseItem = serde_json::from_value(serde_json::json!({
+        "type":"function_call", "call_id":"same-call", "name":"apply_patch", "arguments":"{}"
+    }))
+    .unwrap();
+    assert!(first.admits(&function));
+    assert!(!first.admits(&custom));
+    assert!(second.admits(&custom));
+    assert!(!second.admits(&function));
+    assert!(!second.admits(&wrong_kind));
+    let malformed_search: ResponseItem = serde_json::from_value(serde_json::json!({
+        "type":"tool_search_call", "call_id":"same-call", "execution":"client", "arguments":null
+    }))
+    .unwrap();
+    assert!(!first.admits(&malformed_search));
+    assert!(std::ptr::eq(first.turn_store(), first_store.as_ref()));
+    assert!(std::ptr::eq(second.turn_store(), second_store.as_ref()));
+    assert_ne!(first.thread_id(), second.thread_id());
+    // A later independent plan cannot replace the first retained runtime.
+    assert!(first.admits(&function));
+}
