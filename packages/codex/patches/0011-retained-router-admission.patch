+struct AdmissionProbe(Arc<dyn ModelToolAdmission>);
+impl ModelResponseInterceptor for AdmissionProbe {
+    fn intercept(self: Box<Self>, _: ModelResponseStream) -> ModelResponseStream {
+        panic!("bound request must supply its retained admission")
+    }
+    fn intercept_with_tool_admission(
+        self: Box<Self>,
+        stream: ModelResponseStream,
+        admission: Option<Arc<dyn ModelToolAdmission>>,
+    ) -> ModelResponseStream {
+        assert!(Arc::ptr_eq(&self.0, &admission.unwrap()));
+        stream
+    }
+}
+#[derive(Debug)]
+struct AdmissionContributor(Arc<dyn ModelToolAdmission>);
+impl ModelRequestContributor for AdmissionContributor {
+    fn request(&self, _: ModelRequestInput<'_>) -> Option<Box<dyn ModelResponseInterceptor>> {
+        Some(Box::new(AdmissionProbe(self.0.clone())))
+    }
+}
+#[tokio::test]
+async fn prepared_interceptors_keep_the_original_admission_across_overlapping_requests() {
+    let router = admission_router("exec_command", false, codex_tools::ToolExposure::Hidden);
+    let first = tool_admission(
+        "root".into(),
+        Arc::new(ExtensionData::new("same-turn")),
+        router.clone(),
+    );
+    let second = tool_admission(
+        "child".into(),
+        Arc::new(ExtensionData::new("same-turn")),
+        router,
+    );
+    let make = |admission: Arc<dyn ModelToolAdmission>| {
+        let contributors: Vec<Arc<dyn ModelRequestContributor>> =
+            vec![Arc::new(AdmissionContributor(admission.clone()))];
+        prepare(
+            &contributors,
+            admission.thread_id(),
+            "model",
+            ModelRequestKind::Generation,
+            &mut None,
+            Some(admission.clone()),
+        )
+    };
+    let first_interceptors = make(first);
+    let second_interceptors = make(second);
+    for interceptors in [second_interceptors, first_interceptors] {
+        let mut stream = intercept_stream(
+            Box::pin(futures::stream::iter([Ok(ResponseEvent::OutputTextDelta(
+                "kept".into(),
+            ))])),
+            interceptors,
+        );
+        assert!(
+            matches!(stream.next().await, Some(Ok(ResponseEvent::OutputTextDelta(text))) if text == "kept")
+        );
+    }
+}
