+/// Immutable routing and owner evidence captured for one issuing model request.
+/// Admission only parses and checks the retained runtime; it must not execute tools or hooks.
+pub trait ModelToolAdmission: Send + Sync + std::fmt::Debug {
+    /// Thread that owns the captured routing plan.
+    fn thread_id(&self) -> &str;
+    /// Original turn store, allowing hosts to compare their retained owner by object identity.
+    fn turn_store(&self) -> &ExtensionData;
+    /// Whether the exact selected runtime accepts this model item's payload kind.
+    fn admits(&self, item: &ResponseItem) -> bool;
+}
