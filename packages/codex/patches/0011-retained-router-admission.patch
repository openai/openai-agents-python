+    /// Bind immutable routing evidence before wrapping this request's stream.
+    /// Existing interceptors keep their behavior; configured policies can reject missing evidence.
+    fn intercept_with_tool_admission(
+        self: Box<Self>,
+        stream: ModelResponseStream,
+        _admission: Option<Arc<dyn ModelToolAdmission>>,
+    ) -> ModelResponseStream {
+        self.intercept(stream)
+    }
