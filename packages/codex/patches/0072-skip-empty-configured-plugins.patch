+#[test]
+fn absent_configured_plugin_inputs_preserve_remote_merge() {
+    let directory = TempDir::new().unwrap();
+    let stack = ConfigLayerStack::new(
+        vec![user_layer(user_config_path(&directory, "config.toml"), "[plugins]\n")],
+        ConfigRequirements::default(), ConfigRequirementsToml::default(),
+    ).unwrap();
+    let configured = configured_plugins_from_stack(&stack, directory.path());
+    assert!(configured.is_empty());
+    let remote_key = "remote-only@openai-curated-remote".to_string();
+    let remote = HashMap::from([(remote_key.clone(),
+        toml::from_str::<PluginConfig>("enabled = true\n").unwrap())]);
+    let merged = merge_configured_plugins_with_remote_installed(
+        configured, remote, &PluginStore::new(directory.path().to_path_buf()), true,
+    );
+    assert_eq!(merged.len(), 1);
+    assert!(merged[&remote_key].enabled);
+}
