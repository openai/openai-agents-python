+#[test]
+fn absent_plugin_input_ignores_only_disabled_layers_and_stays_current() {
+    let directory = TempDir::new().unwrap();
+    let disabled = ConfigLayerEntry::new_disabled(
+        ConfigLayerSource::Project {
+            dot_codex_folder: user_config_path(&directory, "project/.codex"),
+        },
+        toml::from_str("[plugins.untrusted]\nenabled = true\n").unwrap(),
+        "project is untrusted",
+    );
+    let stack = ConfigLayerStack::new(
+        vec![disabled], ConfigRequirements::default(), ConfigRequirementsToml::default(),
+    ).unwrap();
+    assert!(configured_plugins_from_stack(&stack, directory.path()).is_empty());
+
+    // A later current input must expose its plugin; the empty result is not cached.
+    let stack = ConfigLayerStack::new(
+        vec![user_layer(user_config_path(&directory, "config.toml"),
+            "[plugins.later]\nenabled = true\n")],
+        ConfigRequirements::default(), ConfigRequirementsToml::default(),
+    ).unwrap();
+    assert!(configured_plugins_from_stack(&stack, directory.path())["later"].enabled);
+}
