+#[test]
+#[tracing_test::traced_test]
+fn valid_empty_plugin_tables_stay_empty_without_suppressing_later_entries() {
+    let directory = TempDir::new().unwrap();
+    let empty = ConfigLayerStack::new(
+        vec![user_layer(user_config_path(&directory, "config.toml"), "[plugins]\n")],
+        ConfigRequirements::default(), ConfigRequirementsToml::default(),
+    ).unwrap();
+    assert!(configured_plugins_from_stack(&empty, directory.path()).is_empty());
+    assert!(!logs_contain("invalid plugins config"));
+    let enabled = ConfigLayerStack::new(
+        vec![user_layer(user_config_path(&directory, "config.toml"),
+            "[plugins.current]\nenabled = true\n")],
+        ConfigRequirements::default(), ConfigRequirementsToml::default(),
+    ).unwrap();
+    assert!(configured_plugins_from_stack(&enabled, directory.path())["current"].enabled);
+}
