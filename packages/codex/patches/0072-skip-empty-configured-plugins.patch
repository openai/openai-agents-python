+#[test]
+fn present_disabled_plugin_configuration_is_not_treated_as_absent() {
+    let directory = TempDir::new().unwrap();
+    let stack = ConfigLayerStack::new(
+        vec![user_layer(user_config_path(&directory, "config.toml"),
+            "[plugins.current]\nenabled = false\n")],
+        ConfigRequirements::default(), ConfigRequirementsToml::default(),
+    ).unwrap();
+    let configured = configured_plugins_from_stack(&stack, directory.path());
+    assert_eq!(configured.len(), 1);
+    assert!(!configured["current"].enabled);
+}
