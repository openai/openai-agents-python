+#[test]
+#[tracing_test::traced_test]
+fn malformed_present_plugin_input_retains_its_warning() {
+    let directory = TempDir::new().unwrap();
+    let stack = ConfigLayerStack::new(
+        vec![user_layer(user_config_path(&directory, "config.toml"), "plugins = 7\n")],
+        ConfigRequirements::default(), ConfigRequirementsToml::default(),
+    ).unwrap();
+    assert!(configured_plugins_from_stack(&stack, directory.path()).is_empty());
+    assert!(logs_contain("invalid plugins config"));
+}
