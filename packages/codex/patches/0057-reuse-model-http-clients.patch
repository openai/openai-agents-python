+        a.ca_digest = Some([1; 32]);
+        let mut b = a.clone();
+        b.ca_digest = Some([2; 32]);
+        for current in [a.clone(), a.clone(), b, a.clone()] {
+            pool.client_with_key(current, HeaderMap::new(), |_| {
+                builds.fetch_add(1, Ordering::SeqCst);
+                Some(client())
