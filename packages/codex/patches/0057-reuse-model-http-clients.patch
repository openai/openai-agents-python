+//! Positive parse caching must not cache file authority, errors or TLS clients.
+use super::*;
+use pretty_assertions::assert_eq;
+use std::io::Read;
+use std::io::Write;
+use std::net::TcpListener;
+use std::sync::Barrier;
+use std::time::Duration;
+
+const FIRST_CA: &str = include_str!("../tests/fixtures/test-ca.pem");
+const SECOND_CA: &str = include_str!("../tests/fixtures/test-intermediate.pem");
+
+fn bundle(path: &Path) -> ConfiguredCaBundle {
+    ConfiguredCaBundle {
+        source_env: SSL_CERT_FILE_ENV,
+        path: path.to_owned(),
+    }
+}
+
+#[test]
+fn identical_public_certificates_are_reused_across_files_and_rotation_is_fresh() {
+    let temp = tempfile::TempDir::new().unwrap();
+    let first_path = temp.path().join("first.pem");
+    let second_path = temp.path().join("second.pem");
+    fs::write(&first_path, FIRST_CA).unwrap();
+    fs::write(&second_path, FIRST_CA).unwrap();
+    let cache = Mutex::new(ReqwestCaCache::default());
+    let first = bundle(&first_path)
+        .load_reqwest_certificates(&cache)
+        .unwrap();
+    let same = bundle(&second_path)
+        .load_reqwest_certificates(&cache)
+        .unwrap();
+    assert!(Arc::ptr_eq(&first, &same));
+    fs::write(&first_path, SECOND_CA).unwrap();
+    let rotated = bundle(&first_path)
+        .load_reqwest_certificates(&cache)
+        .unwrap();
+    assert!(!Arc::ptr_eq(&first, &rotated));
+    assert_eq!(rotated.len(), 1);
+    fs::write(&first_path, FIRST_CA).unwrap();
+    assert!(Arc::ptr_eq(
+        &first,
+        &bundle(&first_path)
+            .load_reqwest_certificates(&cache)
+            .unwrap()
+    ));
+}
+
+#[test]
+fn invalid_der_empty_and_missing_files_never_use_a_warm_hit_or_cache_errors() {
+    let temp = tempfile::TempDir::new().unwrap();
+    let path = temp.path().join("current.pem");
+    let cache = Mutex::new(ReqwestCaCache::default());
+    fs::write(&path, FIRST_CA).unwrap();
+    bundle(&path).load_reqwest_certificates(&cache).unwrap();
+    for contents in [
+        "",
+        "-----BEGIN CERTIFICATE-----\nAAAA\n-----END CERTIFICATE-----\n",
+    ] {
+        fs::write(&path, contents).unwrap();
+        for _ in 0..2 {
+            let error = bundle(&path)
+                .load_reqwest_certificates(&cache)
+                .err()
+                .unwrap();
+            match error {
+                BuildCustomCaTransportError::InvalidCaFile {
+                    path: actual,
+                    source_env,
+                    ..
+                }
+                | BuildCustomCaTransportError::RegisterCertificate {
+                    path: actual,
+                    source_env,
+                    ..
+                } => {
+                    assert_eq!(actual, path);
+                    assert_eq!(source_env, SSL_CERT_FILE_ENV);
+                }
+                error => panic!("unexpected error: {error}"),
+            }
+        }
+        assert_eq!(cache.lock().unwrap().entries.len(), 1);
+    }
+    fs::remove_file(&path).unwrap();
+    assert!(matches!(
+        bundle(&path).load_reqwest_certificates(&cache),
+        Err(BuildCustomCaTransportError::ReadCaFile { source, .. })
+            if source.kind() == io::ErrorKind::NotFound
+    ));
+    fs::write(&path, SECOND_CA).unwrap();
+    assert_eq!(
+        bundle(&path)
+            .load_reqwest_certificates(&cache)
+            .unwrap()
+            .len(),
+        1
+    );
+}
