+    #[test]
+    fn bounded_cache_evicts_and_factory_redirect_changes_do_not_hit() {
+        let pool = SdkModelHttpPool::default();
+        let builds = AtomicUsize::new(0);
+        let build = |_| {
+            builds.fetch_add(1, Ordering::SeqCst);
+            Some(client())
+        };
+        for index in 0..=MAX_CLIENTS {
+            pool.client_with_key(
+                key(&format!("https://{index}.test")),
+                HeaderMap::new(),
