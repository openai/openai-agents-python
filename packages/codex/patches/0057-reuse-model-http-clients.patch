+#[test]
+fn cache_evicts_old_entries_and_does_not_retain_oversized_inputs() {
+    let temp = tempfile::TempDir::new().unwrap();
+    let path = temp.path().join("current.pem");
+    let cache = Mutex::new(ReqwestCaCache::default());
+    fs::write(&path, FIRST_CA).unwrap();
+    let first = bundle(&path).load_reqwest_certificates(&cache).unwrap();
+    for index in 0..CA_CACHE_MAX_ENTRIES {
+        fs::write(&path, format!("# distinct content {index}\n{FIRST_CA}")).unwrap();
+        bundle(&path).load_reqwest_certificates(&cache).unwrap();
+    }
+    assert_eq!(cache.lock().unwrap().entries.len(), CA_CACHE_MAX_ENTRIES);
+    fs::write(&path, FIRST_CA).unwrap();
+    assert!(!Arc::ptr_eq(
+        &first,
+        &bundle(&path).load_reqwest_certificates(&cache).unwrap()
+    ));
+    let large = format!(
+        "# {}\n{FIRST_CA}",
+        "padding".repeat(CA_CACHE_MAX_BYTES / 7 + 1)
+    );
+    fs::write(&path, large).unwrap();
+    let uncached = bundle(&path).load_reqwest_certificates(&cache).unwrap();
+    assert!(!Arc::ptr_eq(
+        &uncached,
+        &bundle(&path).load_reqwest_certificates(&cache).unwrap()
+    ));
+    assert_eq!(cache.lock().unwrap().entries.len(), CA_CACHE_MAX_ENTRIES);
+}
