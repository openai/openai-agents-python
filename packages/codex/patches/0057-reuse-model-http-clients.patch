+//! SDK Provider-owned connection reuse, deliberately restricted to legacy unmanaged HTTP.
+//! Ordinary system trust is captured for this owner's lifetime. Explicit SSL_CERT_FILE
+//! trust is revalidated on every checkout; all other transports keep their original builder.
+use std::collections::VecDeque;
+use std::io;
+use std::sync::{Arc, Mutex, Weak};
+
+use http::HeaderMap;
+
+use crate::custom_ca::SdkModelCaSnapshot;
+use crate::{HttpClient, HttpClientBuilder, HttpClientFactory, OutboundProxyPolicy};
+
+const MAX_CLIENTS: usize = 4;
+const MAX_IDLE_PER_HOST: usize = 32;
+const IDLE_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(30);
+const ROUTING_PROXY_ENV: &[&str] = &[
+    "HTTP_PROXY",
+    "http_proxy",
+    "HTTPS_PROXY",
+    "https_proxy",
+    "ALL_PROXY",
+    "all_proxy",
+];
+
+#[derive(Clone, PartialEq, Eq)]
+struct Key {
+    factory: HttpClientFactory,
+    origin: String,
+    reject_redirects: bool,
+    ca_digest: Option<[u8; 32]>,
+}
+struct Entry {
+    key: Key,
+    token: Arc<()>,
+    client: HttpClient,
+}
+#[derive(Default)]
+struct State {
+    closed: bool,
+    clients: VecDeque<Entry>,
+    ca_digest: Option<Option<[u8; 32]>>,
+}
+
+/// An uncredentialed socket owner carried through typed SDK thread extension data.
+/// Dropping a Session does not drop its Provider's idle connections.
+#[derive(Clone, Default)]
+pub struct SdkModelHttpPool {
+    state: Arc<Mutex<State>>,
+}
+impl std::fmt::Debug for SdkModelHttpPool {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SdkModelHttpPool").finish_non_exhaustive()
+    }
+}
+impl SdkModelHttpPool {
+    fn lock(&self) -> std::sync::MutexGuard<'_, State> {
+        self.state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+    }
+
+    /// Called only after the Provider has joined every native owner.
+    pub fn close(&self) {
+        let clients = {
+            let mut state = self.lock();
+            state.closed = true;
+            std::mem::take(&mut state.clients)
+        };
+        // Drop socket clients outside the state lock, before joined close completes.
+        drop(clients);
+    }
+
+    fn invalidate(&self) {
+        let clients = {
+            let mut state = self.lock();
+            state.ca_digest = None;
+            std::mem::take(&mut state.clients)
+        };
+        drop(clients);
+    }
+
+    /// None asks the caller to run its exact existing fresh construction path.
+    /// This function performs no I/O other than existing CA reads and client construction.
+    pub fn client(
+        &self,
+        factory: &HttpClientFactory,
+        request_url: &str,
+        reject_redirects: bool,
+        headers: HeaderMap,
+    ) -> io::Result<Option<HttpClient>> {
+        if self.lock().closed {
+            return Err(io::Error::other("Provider model HTTP pool is closed"));
+        }
+        let Ok(url) = reqwest::Url::parse(request_url) else {
+            return Ok(None);
+        };
+        // Admit only an explicitly captured direct route. The six routing proxy variables
+        // must be absent, including empty/non-Unicode values. NO_PROXY alone cannot route.
+        // Platform proxy services, sandbox bypass, explicit cookies and managed clients
+        // retain their original builder and permit checks.
+        if !cfg!(target_os = "linux")
+            || factory.network_policy().is_managed()
+            || factory.has_chatgpt_cookies()
+            || factory.outbound_proxy_policy() != OutboundProxyPolicy::ReqwestDefault
+            || ROUTING_PROXY_ENV
+                .iter()
+                .any(|name| std::env::var_os(name).is_some())
+            || std::env::var_os("REQUEST_METHOD").is_some()
+            || std::env::var_os("CODEX_SANDBOX").is_some()
+            || std::env::var_os("CODEX_CA_CERTIFICATE").is_some()
+            || std::env::var_os("SSL_CERT_DIR").is_some()
+            || !matches!(url.scheme(), "http" | "https")
+            || !url.username().is_empty()
+            || url.password().is_some()
+            || url.host_str().is_none_or(crate::is_allowed_chatgpt_host)
+        {
+            return Ok(None);
+        }
+        // Empty/non-Unicode file overrides are unsupported, never mistaken for OS defaults.
+        if std::env::var_os("SSL_CERT_FILE").is_some()
+            && std::env::var("SSL_CERT_FILE")
+                .ok()
+                .is_none_or(|value| value.is_empty())
+        {
+            self.invalidate();
+            return Ok(None);
+        }
+        let snapshot = match SdkModelCaSnapshot::load() {
+            Ok(snapshot) => snapshot,
+            Err(_) => {
+                self.invalidate();
+                // Preserve the legacy builder's complete logging/error/fallback behavior.
+                return Ok(None);
+            }
+        };
+        if !snapshot.admissible() {
+            self.invalidate();
+            return Ok(None);
+        }
+        let key = Key {
+            factory: factory.clone(),
+            origin: url.origin().ascii_serialization(),
+            reject_redirects,
+            ca_digest: snapshot.digest(),
+        };
+        let owner = Arc::downgrade(&self.state);
+        self.client_with_key(key, headers, |token| {
+            let mut builder = HttpClientBuilder::new().with_chatgpt_cloudflare_cookie_store();
+            if reject_redirects {
+                builder = builder.without_redirects();
+            }
+            builder
+                .build_sdk_model_snapshot(&snapshot, MAX_IDLE_PER_HOST, IDLE_TIMEOUT, move || {
+                    // A redirected client remains owned by its active request, never the Provider.
+                    // The unique token prevents an old client's callback evicting its replacement.
+                    retire_redirected(&owner, &token);
+                })
+                .ok()
+        })
+    }
+
+    fn client_with_key(
+        &self,
+        key: Key,
+        headers: HeaderMap,
+        build: impl FnOnce(Arc<()>) -> Option<HttpClient>,
+    ) -> io::Result<Option<HttpClient>> {
+        let retired = {
+            let mut state = self.lock();
+            if state.closed {
+                return Err(io::Error::other("Provider model HTTP pool is closed"));
+            }
+            let retired = if state.ca_digest != Some(key.ca_digest) {
+                state.ca_digest = Some(key.ca_digest);
+                std::mem::take(&mut state.clients)
+            } else {
+                VecDeque::new()
+            };
+            if let Some(index) = state.clients.iter().position(|entry| entry.key == key) {
+                let entry = state.clients.remove(index).expect("located SDK client");
+                let client = entry.client.clone().with_sdk_default_headers(headers);
+                state.clients.push_back(entry);
+                return Ok(Some(client));
+            }
+            retired
+        };
+        drop(retired);
+        // Synchronous construction stays owned by the initiating native operation.
+        // No lock spans a build, file read, await, or background task.
+        let token = Arc::new(());
+        let Some(client) = build(token.clone()) else {
+            self.invalidate();
+            return Ok(None);
+        };
+        let neutral = client.with_sdk_default_headers(HeaderMap::new());
+        let mut state = self.lock();
+        if state.closed {
+            return Err(io::Error::other("Provider model HTTP pool is closed"));
+        }
+        if state.ca_digest == Some(key.ca_digest)
+            && !state.clients.iter().any(|entry| entry.key == key)
+        {
+            let evicted = if state.clients.len() == MAX_CLIENTS {
+                state.clients.pop_front()
+            } else {
+                None
+            };
+            state.clients.push_back(Entry {
+                key,
+                token,
+                client: neutral.clone(),
+            });
+            drop(state);
+            drop(evicted);
+        }
+        Ok(Some(neutral.with_sdk_default_headers(headers)))
+    }
+}
+
+fn retire_redirected(owner: &Weak<Mutex<State>>, token: &Arc<()>) {
+    if let Some(owner) = owner.upgrade() {
+        let retired = {
+            let mut state = owner
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            let index = state
+                .clients
+                .iter()
+                .position(|entry| Arc::ptr_eq(&entry.token, token));
+            index.and_then(|index| state.clients.remove(index))
+        };
+        drop(retired);
+    }
+}
+
+#[cfg(test)]
