+            .unwrap();
+        }
+        assert_eq!(builds.load(Ordering::SeqCst), 3);
+        pool.invalidate();
+        pool.client_with_key(a, HeaderMap::new(), |_| {
+            builds.fetch_add(1, Ordering::SeqCst);
+            Some(client())
