+    fn load_reqwest_certificates(
+        &self,
+        cache: &Mutex<ReqwestCaCache>,
+    ) -> Result<Arc<[reqwest::Certificate]>, BuildCustomCaTransportError> {
+        // Only client construction uses this cache. Pool lookups keep a fresh DER
+        // snapshot and avoid certificate wrappers and this lock on a hit.
+        let (certificates, digest, admissible) = self.load_certificates_and_digest()?;
+        let der_bytes = certificates
+            .iter()
+            .map(|certificate| certificate.len())
+            .sum();
+        let parse = || {
+            self.reqwest_certificates(&certificates)
+                .map(|certificates| (Arc::from(certificates), der_bytes))
+        };
+        let result = if admissible {
+            // No file I/O, tracing, await or client construction under the lock.
+            cache
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .load(digest, parse)
+        } else {
+            parse().map(|(certificates, _)| certificates)
+        };
+        result.inspect_err(|error| self.warn_registration_error(error))
+    }
+
+    fn warn_registration_error(&self, error: &BuildCustomCaTransportError) {
+        if let BuildCustomCaTransportError::RegisterCertificate {
+            certificate_index,
+            source,
+            ..
+        } = error
+        {
+            warn!(
+                source_env = self.source_env,
+                ca_path = %self.path.display(),
+                certificate_index = *certificate_index,
+                error = %source,
+                "failed to register CA certificate"
+            );
+        }
+    }
+
+    fn load_certificates_and_digest(
+        &self,
+    ) -> Result<(Vec<CertificateDer<'static>>, [u8; 32], bool), BuildCustomCaTransportError> {
+        // Read and parse again before each pool lookup. Rotation, deletion and
+        // access errors keep their current file/env context; errors are not retained.
+        let result = (|| {
+            let pem_data = self.read_pem_data()?;
+            let digest = Sha256::digest(&pem_data).into();
+            let certificates = self.parse_certificate_bytes(&pem_data)?;
+            let der_bytes: usize = certificates
+                .iter()
+                .map(|certificate| certificate.len())
+                .sum();
+            let admissible = pem_data.len() <= CA_CACHE_MAX_BYTES
+                && certificates.len() <= CA_CACHE_MAX_CERTIFICATES
+                && der_bytes <= CA_CACHE_MAX_BYTES;
+            Ok((certificates, digest, admissible))
+        })();
+        match &result {
+            Ok((certificates, _, _)) => info!(
+                source_env = self.source_env,
+                ca_path = %self.path.display(),
+                certificate_count = certificates.len(),
+                "loaded certificates from custom CA bundle"
+            ),
+            Err(error) => warn!(
+                source_env = self.source_env,
+                ca_path = %self.path.display(),
+                error = %error,
+                "failed to load custom CA bundle"
+            ),
+        }
+        result
+    }
