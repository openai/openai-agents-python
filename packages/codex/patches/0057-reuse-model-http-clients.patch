 #[cfg(test)]
 #[path = "custom_ca_tls_tests.rs"]
 mod tls_tests;
+
+#[cfg(test)]
+#[path = "custom_ca_cache_tests.rs"]
+mod cache_tests;
+
+// The receipt holds freshly parsed public DER for its hash. Certificate wrappers
+// are constructed only when the existing model HTTP pool needs a new client.
+// The construction receipt holds its path only for scoped build errors. Pool entries
+// retain neither that receipt/path nor raw PEM, private material or error values.
+pub(crate) struct SdkModelCaSnapshot {
+    bundle: Option<(
+        ConfiguredCaBundle,
+        Vec<CertificateDer<'static>>,
+        [u8; 32],
+        bool,
+    )>,
+}
+
+impl SdkModelCaSnapshot {
+    pub(crate) fn load() -> Result<Self, BuildCustomCaTransportError> {
+        Self::load_with_env(&ProcessEnv)
+    }
+
+    fn load_with_env(env: &dyn EnvSource) -> Result<Self, BuildCustomCaTransportError> {
+        let bundle = match env.configured_ca_bundle() {
+            Some(bundle) => {
+                let (certificates, digest, admissible) = bundle.load_certificates_and_digest()?;
+                Some((bundle, certificates, digest, admissible))
+            }
+            None => None,
+        };
+        Ok(Self { bundle })
+    }
+
+    pub(crate) fn digest(&self) -> Option<[u8; 32]> {
+        self.bundle.as_ref().map(|(_, _, digest, _)| *digest)
+    }
+
+    pub(crate) fn admissible(&self) -> bool {
+        self.bundle
+            .as_ref()
+            .is_none_or(|(_, _, _, admissible)| *admissible)
+    }
+
+    pub(crate) fn build(
+        &self,
+        mut builder: reqwest::ClientBuilder,
+    ) -> Result<reqwest::Client, BuildCustomCaTransportError> {
+        if let Some((bundle, certificates, _, _)) = &self.bundle {
+            ensure_rustls_crypto_provider();
+            // Only SSL_CERT_FILE with SSL_CERT_DIR absent can reach this SDK path.
+            // rustls-native-certs would otherwise reopen this same file. Its roots
+            // are present in the freshly parsed snapshot; keep webpki roots.
+            builder = builder.use_rustls_tls().tls_built_in_native_certs(false);
+            for certificate in bundle
+                .reqwest_certificates(certificates)
+                .inspect_err(|error| bundle.warn_registration_error(error))?
+            {
+                builder = builder.add_root_certificate(certificate);
+            }
+            return builder.build().map_err(|source| {
+                BuildCustomCaTransportError::BuildClientWithCustomCa {
+                    source_env: bundle.source_env,
+                    path: bundle.path.clone(),
+                    source,
+                }
+            });
+        }
+        builder
+            .build()
+            .map_err(BuildCustomCaTransportError::BuildClientWithSystemRoots)
+    }
+}
