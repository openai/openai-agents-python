+#[test]
+fn retained_certificate_count_and_der_bytes_are_bounded() {
+    let certificate = reqwest::Certificate::from_pem(FIRST_CA.as_bytes()).unwrap();
+    let mut cache = ReqwestCaCache::default();
+    for index in 0..8 {
+        cache
+            .load([index; 32], || {
+                Ok((
+                    Arc::from(vec![certificate.clone(); 256]),
+                    CA_CACHE_MAX_BYTES / 4,
+                ))
+            })
+            .unwrap();
+        assert!(cache.entries.len() <= CA_CACHE_MAX_ENTRIES);
+        assert!(
+            cache
+                .entries
+                .iter()
+                .map(|entry| entry.certificates.len())
+                .sum::<usize>()
+                <= CA_CACHE_MAX_CERTIFICATES
+        );
+        assert!(
+            cache
+                .entries
+                .iter()
+                .map(|entry| entry.der_bytes)
+                .sum::<usize>()
+                <= CA_CACHE_MAX_BYTES
+        );
+    }
+    let prior = cache.entries.len();
+    cache
+        .load([99; 32], || {
+            Ok((
+                Arc::from(vec![certificate.clone(); CA_CACHE_MAX_CERTIFICATES + 1]),
+                1,
+            ))
+        })
+        .unwrap();
+    cache
+        .load([100; 32], || {
+            Ok((Arc::from(vec![certificate]), CA_CACHE_MAX_BYTES + 1))
+        })
+        .unwrap();
+    assert_eq!(cache.entries.len(), prior);
+}
