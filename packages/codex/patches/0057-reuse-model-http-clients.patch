+// Retain public certificates only: a selected PEM file may also contain private keys.
+// Hash freshly read bytes, never paths/metadata. Bound native certificate objects as well
+// as their source DER; the byte bound does not claim to measure native allocations.
+const CA_CACHE_MAX_ENTRIES: usize = 4;
+const CA_CACHE_MAX_CERTIFICATES: usize = 1024;
+const CA_CACHE_MAX_BYTES: usize = 4 * 1024 * 1024;
+static REQWEST_CA_CACHE: LazyLock<Mutex<ReqwestCaCache>> =
+    LazyLock::new(|| Mutex::new(ReqwestCaCache::default()));
+
+struct CachedReqwestCa {
+    digest: [u8; 32],
+    certificates: Arc<[reqwest::Certificate]>,
+    der_bytes: usize,
+}
+
+#[derive(Default)]
+struct ReqwestCaCache {
+    entries: VecDeque<CachedReqwestCa>,
+}
+
+impl ReqwestCaCache {
+    fn load(
+        &mut self,
+        digest: [u8; 32],
+        parse: impl FnOnce()
+            -> Result<(Arc<[reqwest::Certificate]>, usize), BuildCustomCaTransportError>,
+    ) -> Result<Arc<[reqwest::Certificate]>, BuildCustomCaTransportError> {
+        if let Some(index) = self.entries.iter().position(|entry| entry.digest == digest) {
+            let entry = self.entries.remove(index).expect("located CA cache entry");
+            let certificates = entry.certificates.clone();
+            self.entries.push_back(entry);
+            return Ok(certificates);
+        }
+        // Parse before mutating the cache. Errors and panics cannot evict valid entries.
+        let (certificates, der_bytes) = parse()?;
+        if certificates.len() > CA_CACHE_MAX_CERTIFICATES || der_bytes > CA_CACHE_MAX_BYTES {
+            return Ok(certificates);
+        }
+        while self.entries.len() >= CA_CACHE_MAX_ENTRIES
+            || self
+                .entries
+                .iter()
+                .map(|entry| entry.der_bytes)
+                .sum::<usize>()
+                + der_bytes
+                > CA_CACHE_MAX_BYTES
+            || self
+                .entries
+                .iter()
+                .map(|entry| entry.certificates.len())
+                .sum::<usize>()
+                + certificates.len()
+                > CA_CACHE_MAX_CERTIFICATES
+        {
+            self.entries.pop_front();
+        }
+        self.entries.push_back(CachedReqwestCa {
+            digest,
+            certificates: certificates.clone(),
+            der_bytes,
+        });
+        Ok(certificates)
+    }
+}
