+        let pool = SdkModelHttpPool::default();
+        let owner = Arc::downgrade(&pool.state);
+        let mut first = None;
+        pool.client_with_key(key("https://a.test"), HeaderMap::new(), |token| {
+            first = Some(token);
+            Some(client())
+        })
+        .unwrap()
+        .unwrap();
+        let first = first.unwrap();
+        retire_redirected(&owner, &first);
+        let builds = AtomicUsize::new(0);
+        pool.client_with_key(key("https://a.test"), HeaderMap::new(), |_| {
+            builds.fetch_add(1, Ordering::SeqCst);
+            Some(client())
+        })
+        .unwrap()
+        .unwrap();
+        assert_eq!(builds.load(Ordering::SeqCst), 1);
+        retire_redirected(&owner, &first);
+        pool.client_with_key(key("https://a.test"), HeaderMap::new(), |_| {
+            panic!("an old redirect must not evict the replacement client")
+        })
+        .unwrap()
+        .unwrap();
+        pool.close();
+        drop(pool);
+        retire_redirected(&owner, &first); // The callback owns no Provider reference.
+        assert!(owner.upgrade().is_none());
+    }
