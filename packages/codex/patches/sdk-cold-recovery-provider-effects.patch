+// Provider execution has no local accepted-call owner, including capabilities
+// retained by a hosted prompt or a provider-owned history cursor.
+fn sdk_request_may_have_provider_effects(
+    prompt: &Prompt,
+    visible_tools: &[codex_tools::ToolSpec],
+) -> bool {
+    prompt
+        .request_controls
+        .hosted_prompt
+        .as_ref()
+        .is_some_and(Option::is_some)
+        || prompt.canonical_history_input.is_some()
+        || prompt.tools.iter().chain(visible_tools.iter()).any(|tool| {
+            matches!(
+                tool,
+                codex_tools::ToolSpec::Mcp(_)
+                    | codex_tools::ToolSpec::CodeInterpreter(_)
+                    | codex_tools::ToolSpec::Shell(_)
+                    | codex_tools::ToolSpec::ImageGeneration(_)
+            )
+        })
+}
+
+#[cfg(test)]
+#[test]
+fn sdk_cold_recovery_classifies_provider_effect_capabilities() {
+    let mut prompt = Prompt::default();
+    assert!(!sdk_request_may_have_provider_effects(&prompt, &[]));
+    assert!(!sdk_request_may_have_provider_effects(
+        &prompt,
+        &[codex_tools::ToolSpec::ApplyPatch {}]
+    ));
+    let hosted = vec![
+        codex_tools::ToolSpec::Mcp(
+            serde_json::from_value(serde_json::json!({"server_label":"remote"})).unwrap(),
+        ),
+        codex_tools::ToolSpec::CodeInterpreter(
+            serde_json::from_value(serde_json::json!({"container":{"type":"auto"}})).unwrap(),
+        ),
+        codex_tools::ToolSpec::Shell(
+            serde_json::from_value(serde_json::json!({"environment":{"type":"container_auto"}}))
+                .unwrap(),
+        ),
+        codex_tools::ToolSpec::ImageGeneration(
+            serde_json::from_value(serde_json::json!({})).unwrap(),
+        ),
+    ];
+    for tool in hosted {
+        assert!(sdk_request_may_have_provider_effects(
+            &prompt,
+            std::slice::from_ref(&tool)
+        ));
+        prompt.tools = vec![tool].into();
+        assert!(sdk_request_may_have_provider_effects(&prompt, &[]));
+        prompt.tools = Vec::new().into();
+    }
+    prompt.request_controls.hosted_prompt = Some(Some(Default::default()));
+    assert!(sdk_request_may_have_provider_effects(&prompt, &[]));
+    prompt
+        .request_controls
+        .hosted_prompt
+        .as_mut()
+        .unwrap()
+        .as_mut()
+        .unwrap()
+        .omit_tools = true;
+    assert!(sdk_request_may_have_provider_effects(&prompt, &[]));
+}
