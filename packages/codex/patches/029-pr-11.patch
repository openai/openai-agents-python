+/// Resolve exactly one producer after native request admission. No provider
+/// transport may run when a selected producer fails or is cancelled.
+pub(crate) async fn produce_response(
+    interceptors: &[Box<dyn ModelResponseInterceptor>],
+    request: &impl serde::Serialize,
+) -> Result<Option<ModelResponseStream>, String> {
+    let mut producers = interceptors.iter().filter(|interceptor| interceptor.produces_response());
+    let Some(selected) = producers.next() else { return Ok(None); };
+    if producers.next().is_some() { return Err("Multiple native model producers selected".into()); }
+    let request = serde_json::to_value(request).map_err(|_| "Native model request serialization failed")?;
+    let producer = selected.produce_response(request, None).ok_or("Selected native model producer is unavailable")?;
+    producer.await.map(Some)
+}
