 #[cfg(test)]
 mod tests {
+    #[tokio::test]
+    async fn exact_application_update_rejection_preserves_acceptance_and_next_work() {
+        let observer = accepted_observer();
+        let configuration = observer.configuration();
+        let original = configuration.accepted().unwrap();
+        let reservation = configuration.reserve_update(&g711_update()).unwrap();
+        let receipt = reservation.receipt();
+        reservation.arm().unwrap();
+        let observed = observer.observe_frame(&json!({"type":"error","error":{
+            "type":"invalid_request_error", "code":"invalid_value", "message":"private detail", "event_id":reservation.id
+        }}).to_string(), true);
+        let error = observed.request_error.unwrap();
+        assert_eq!(error.event_id.as_deref(), Some(reservation.id.as_str()));
+        assert_eq!(error.code.as_deref(), Some("invalid_value"));
+        assert!(!error.rejected_default_response_create);
+        assert!(receipt.is_definitely_rejected());
+        assert!(receipt.clone().wait().await.is_err());
+        assert!(Arc::ptr_eq(&original, &configuration.accepted().unwrap()));
+        assert!(!observer.mismatched());
+        let next = configuration.reserve_update(&g711_update()).unwrap();
+        let next_receipt = next.receipt();
+        next.arm().unwrap();
+        let accepted = configuration
+            .inner
+            .state
+            .lock()
+            .unwrap()
+            .pending
+            .as_ref()
+            .unwrap()
+            .contract
+            .clone();
+        acknowledge(&observer, accepted);
+        assert!(next_receipt.wait().await.is_ok());
+        assert!(receipt.is_definitely_rejected());
+        assert!(configuration.observe_response_create(&json!({})).is_ok());
+    }
+
+    #[tokio::test]
+    async fn ambiguous_malformed_initial_and_source_update_errors_remain_terminal() {
+        for mode in [
+            "wrong-id",
+            "unarmed",
+            "not-media",
+            "missing-message",
+            "bad-code",
+            "closed",
+            "rate-limit",
+            "source",
+        ] {
+            let observer = accepted_observer();
+            let configuration = observer.configuration();
+            let reservation = if mode == "source" {
+                configuration.reserve_update_with_source(
+                    &g711_update(),
+                    Arc::new(TestSource(AgentProfileReceipt {
+                        profile_id: "source".into(),
+                        epoch: 1,
+                    })),
+                )
+            } else {
+                configuration.reserve_update(&g711_update())
+            }
+            .unwrap();
+            let receipt = reservation.receipt();
+            if mode != "unarmed" {
+                reservation.arm().unwrap();
+            }
+            let mut error = json!({"type":"invalid_request_error","code":"invalid_value","message":"private","event_id":reservation.id});
+            match mode {
+                "wrong-id" => error["event_id"] = json!("another-request"),
+                "missing-message" => {
+                    error.as_object_mut().unwrap().remove("message");
+                }
+                "bad-code" => error["code"] = json!(42),
+                "closed" => error["code"] = json!("session_closed"),
+                "rate-limit" => error["type"] = json!("rate_limit_error"),
+                _ => {}
+            }
+            assert!(
+                observer
+                    .observe_frame(
+                        &json!({"type":"error","error":error}).to_string(),
+                        mode != "not-media"
+                    )
+                    .request_error
+                    .is_none()
+            );
+            assert!(!receipt.is_definitely_rejected(), "{mode}");
+            assert!(receipt.wait().await.is_err(), "{mode}");
+            assert!(configuration.accepted().is_err(), "{mode}");
+        }
+        let (observer, _) = SessionReadiness::channel(Some(json!({})), true);
+        let observer = observer.unwrap();
+        assert!(observer.observe_frame(r#"{"type":"error","error":{"type":"invalid_request_error","code":"invalid_value","message":"private","event_id":"initial"}}"#, true).request_error.is_none());
+        assert!(observer.configuration().accepted().is_err());
+    }
