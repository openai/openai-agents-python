+// A definite provider rejection needs a complete typed error and exact bounded reference.
+fn definite_application_update_error(error: &Value) -> bool {
+    error.is_object()
+        && error["type"] == "invalid_request_error"
+        && error["message"].is_string()
+        && error["event_id"]
+            .as_str()
+            .is_some_and(|id| !id.is_empty() && id.len() <= 256)
+        && error
+            .get("param")
+            .is_none_or(|value| value.is_null() || value.is_string())
+        && error.get("code").is_none_or(|value| {
+            value.is_null()
+                || value.as_str().is_some_and(|code| {
+                    !code.is_empty()
+                        && code.len() <= 128
+                        && code
+                            .bytes()
+                            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_')
+                        && !matches!(code, "session_expired" | "session_closed")
+                })
+        })
+}
