+#[tokio::test]
+async fn checked_shutdown_reports_failed_retirement_of_pruned_remote_process() {
+    let (_, turn) = crate::session::tests::make_session_and_context().await;
+    let manager = UnifiedExecProcessManager::default();
+    let mut remote = crate::unified_exec::process_tests::remote_process(
+        codex_exec_server::WriteStatus::Accepted,
+        Some("termination was not acknowledged".to_string()),
+        codex_sandboxing::SandboxType::None,
+    )
+    .await;
+    remote.own_remote_termination();
+    let remote = Arc::new(remote);
+    let other = Arc::new(
+        crate::unified_exec::process_tests::remote_process(
+            codex_exec_server::WriteStatus::Accepted,
+            /*terminate_error*/ None,
+            codex_sandboxing::SandboxType::None,
+        )
+        .await,
+    );
+    let newest = Instant::now();
+    let cwd = PathUri::parse("file:///tmp").expect("test cwd");
+    let mut store = manager.process_store.lock().await;
+    for index in 0..MAX_UNIFIED_EXEC_PROCESSES {
+        let process_id = i32::try_from(index).expect("process id");
+        store.processes.insert(
+            process_id,
+            ProcessEntry {
+                output_policy_store: None,
+                process: Arc::clone(if index == 0 { &remote } else { &other }),
+                plugin_metrics_sidecar: None,
+                call_id: format!("call-{process_id}"),
+                process_id,
+                cwd: cwd.clone(),
+                initial_exec_command_active: Arc::new(AtomicBool::new(false)),
+                initial_exec_command_returned: Arc::new(AtomicBool::new(true)),
+                hook_command: "command".to_string(),
+                tty: false,
+                environment_id: "remote".to_string(),
+                permissions: super::super::TerminalPermissions::for_launch(
+                    turn.initial_environments
+                        .primary()
+                        .expect("turn environment"),
+                    &turn,
+                    super::super::TerminalSandboxSource::Native,
+                    crate::sandboxing::SandboxPermissions::UseDefault,
+                    /*additional_permissions*/ None,
+                    /*internal_permissions*/ None,
+                ),
+                network_approval: None,
+                session: std::sync::Weak::new(),
+                last_used: if index == 0 {
+                    newest - Duration::from_secs(1)
+                } else {
+                    newest
+                },
+            },
+        );
+    }
+    // Pending retirement shares the existing soft cap. Once it is full, leave
+    // the next live remote in inventory instead of adding more outgoing work.
+    store.retiring_remote_processes = vec![Arc::clone(&remote); MAX_UNIFIED_EXEC_PROCESSES];
+    let removed = UnifiedExecProcessManager::prune_processes_if_needed(&mut store)
+        .expect("an eligible non-owned process can still be pruned");
+    assert_ne!(removed.process_id, 0);
+    assert_eq!(
+        store.retiring_remote_processes.len(),
+        MAX_UNIFIED_EXEC_PROCESSES
+    );
+    store.processes.insert(removed.process_id, removed);
+    store.retiring_remote_processes.clear();
+
+    let removed = UnifiedExecProcessManager::prune_processes_if_needed(&mut store)
+        .expect("evict the least recently used delivered command");
+    assert_eq!(removed.process_id, 0);
+    assert_eq!(store.processes.len(), MAX_UNIFIED_EXEC_PROCESSES - 1);
+    let [retiring] = store.retiring_remote_processes.as_slice() else {
+        panic!("pruned remote process should remain owned by checked close");
+    };
+    assert!(Arc::ptr_eq(retiring, &remote));
+    drop(store);
+    drop(removed);
+
+    assert!(!manager.terminate_all_processes().await);
+    assert!(remote.cancellation_token().is_cancelled());
+    assert!(!remote.needs_remote_cleanup() || remote.failure_message().is_some());
+    {
+        let store = manager.process_store.lock().await;
+        assert!(store.retiring_remote_processes.is_empty());
+        assert!(store.remote_retirement_failed);
+    }
+    assert!(!manager.terminate_all_processes().await);
+}
