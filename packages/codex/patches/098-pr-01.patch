+    let url = format!("ws://{}", listener.local_addr().expect("listener address"));
+    let peer = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.expect("executor connection");
+        let mut peer = tokio_tungstenite::accept_async(stream)
+            .await
+            .expect("executor handshake");
+        let initialize = recv_exec_request(&mut peer).await;
+        assert_eq!(initialize["method"], "initialize");
+        send_exec_message(
+            &mut peer,
+            json!({
+                "id": initialize["id"],
+                "result": { "sessionId": "registered-termination" }
+            }),
+        )
+        .await;
+        assert_eq!(recv_exec_request(&mut peer).await["method"], "initialized");
+
+        let start = recv_exec_request(&mut peer).await;
+        assert_eq!(start["method"], "process/start");
+        assert_eq!(start["params"]["processId"], "registered-process");
+        send_exec_message(
+            &mut peer,
+            json!({
+                "id": start["id"],
+                "result": { "processId": "registered-process" }
+            }),
+        )
