+#[tokio::test]
+async fn owned_remote_termination_checks_retained_exit_after_output_closes(exit_code: Option<i32>) {
+    let (process, mut peer) = start_owned_remote_process().await;
+    let joined = process.join_remote_termination();
+    tokio::pin!(joined);
+    assert!(futures::poll!(joined.as_mut()).is_pending());
+    let request = recv_terminate(&mut peer).await;
+    // The retained status contains the exit while the observable event stream
+    // only has an output-closure event. The stop still owes its own ACK.
+    send_exec_message(
+        &mut peer,
+        json!({
+            "method": "process/closed",
+            "params": { "processId": "registered-process", "seq": 1 }
+        }),
+    )
+    .await;
+    assert!(futures::poll!(joined.as_mut()).is_pending());
+    acknowledge_terminate(&mut peer, &request).await;
+    let read = recv_exec_request(&mut peer).await;
+    assert_eq!(read["method"], "process/read");
+    assert_eq!(read["params"]["processId"], "registered-process");
+    send_exec_message(
+        &mut peer,
+        json!({
+            "id": read["id"],
+            "result": {
+                "chunks": [],
+                "nextSeq": 2,
+                "exited": exit_code.is_some(),
+                "exitCode": exit_code,
+                "closed": true,
+                "sandboxDenied": false
+            }
+        }),
+    )
+    .await;
+    assert_eq!(
+        tokio::time::timeout(Duration::from_secs(3), joined.as_mut())
+            .await
+            .expect("retained peer status should settle termination"),
+        exit_code.is_some()
+    );
+}
