+#[tokio::test]
+async fn owned_remote_termination_does_not_accept_observer_failure_as_exit() {
+    let (process, mut peer) = start_owned_remote_process().await;
+    {
+        let joined = process.join_remote_termination();
+        tokio::pin!(joined);
+        assert!(futures::poll!(joined.as_mut()).is_pending());
+        let request = recv_terminate(&mut peer).await;
+        acknowledge_terminate(&mut peer, &request).await;
+        // Overflow the peer's pending process event buffer by leaving seq 1
+        // missing. The client then publishes an observer failure over this
+        // still-open transport without any peer exit notification.
+        for seq in 2..=258 {
+            send_exec_message(
+                &mut peer,
+                json!({
+                    "method": "process/closed",
+                    "params": { "processId": "registered-process", "seq": seq }
+                }),
+            )
+            .await;
+        }
+        let confirmed = tokio::time::timeout(Duration::from_secs(3), joined.as_mut())
+            .await
+            .expect("observer failure should settle the termination wait");
+        assert!(!confirmed);
+        tokio::time::timeout(Duration::from_secs(3), async {
+            while process.failure_message().is_none() {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("output observer should publish the failure");
+        assert!(
+            process.has_exited(),
+            "failure ends the local output observer"
+        );
+        assert!(process.exit_code().is_none());
+    }
+    drop(process);
+    assert_peer_has_no_more_requests(&mut peer).await;
+}
