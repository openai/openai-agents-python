+#[cfg(test)]
+mod shutdown_tests {
+    use super::*;
+
+    fn control_pair() -> io::Result<(CommandControl, UnixStream)> {
+        let (socket, peer) = UnixStream::pair()?;
+        Ok((CommandControl::new(socket)?, peer))
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn shutdown_waits_for_queued_wrapper_identity() -> io::Result<()> {
+        let (control, mut peer) = control_pair()?;
+        let mut token = AuditToken::current()?;
+        // A stale version for this test process cannot signal a real process.
+        token.0[7] = token.0[7].wrapping_add(1);
+        peer.write_all(&[WRAPPER_STARTED])?;
+        peer.write_all(token.0.map(u32::to_le_bytes).as_flattened())?;
+        // The current-thread reader cannot run until this task yields.
+        assert!(control.state.borrow().started_wrapper.is_none());
+        control.stop();
+        tokio::time::timeout(SETUP_TIMEOUT, control.resume_wrapper_for_shutdown())
+            .await
+            .expect("shutdown did not observe the queued identity");
+        assert!(control.state.borrow().started_wrapper.is_some());
+        // An attempted resume, including a failed signal, never confirms drain.
+        assert!(!control.is_drained());
+        peer.write_all(&[DRAINED])?;
+        assert!(control.wait_drained().await);
+        Ok(())
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn shutdown_accepts_drained_before_started() -> io::Result<()> {
+        let (control, mut peer) = control_pair()?;
+        control.stop();
+        peer.write_all(&[DRAINED])?;
+        tokio::time::timeout(SETUP_TIMEOUT, control.resume_wrapper_for_shutdown())
+            .await
+            .expect("EOF-before-START drain blocked on an identity");
+        assert!(control.state.borrow().started_wrapper.is_none());
+        assert!(control.wait_drained().await);
+        Ok(())
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn shutdown_does_not_confirm_a_closed_control_channel() -> io::Result<()> {
+        let (control, peer) = control_pair()?;
+        control.stop();
+        drop(peer);
+        tokio::time::timeout(SETUP_TIMEOUT, control.resume_wrapper_for_shutdown())
+            .await
+            .expect("closed control channel blocked on an identity");
+        assert!(control.state.borrow().started_wrapper.is_none());
+        assert!(!control.wait_drained().await);
+        Ok(())
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn shutdown_rejects_the_old_started_opcode() -> io::Result<()> {
+        let (control, mut peer) = control_pair()?;
+        peer.write_all(&[STARTED])?;
+        control.stop();
+        tokio::time::timeout(SETUP_TIMEOUT, control.resume_wrapper_for_shutdown())
+            .await
+            .expect("mismatched helper blocked on an identity");
+        assert!(control.wait_started().await.is_err());
+        assert!(!control.wait_drained().await);
+        Ok(())
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn incomplete_wrapper_identity_remains_bounded_and_unconfirmed() -> io::Result<()> {
+        let (control, mut peer) = control_pair()?;
+        peer.write_all(&[WRAPPER_STARTED, 0])?;
+        control.stop();
+        assert!(
+            tokio::time::timeout(
+                Duration::from_millis(20),
+                control.resume_wrapper_for_shutdown(),
+            )
+            .await
+            .is_err()
+        );
+        assert!(control.state.borrow().started_wrapper.is_none());
+        assert!(!control.is_drained());
+        drop(peer);
+        control.resume_wrapper_for_shutdown().await;
+        assert!(!control.wait_drained().await);
+        Ok(())
+    }
