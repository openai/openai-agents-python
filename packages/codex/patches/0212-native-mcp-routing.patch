+#[tokio::test]
+async fn selected_raw_subset_preserves_complete_catalog_names() {
+    let tools = vec![
+        create_test_tool("docs", "a.b"),
+        create_test_tool("docs", "a_b"),
+    ];
+    let client = create_ready_async_managed_client(tools).await;
+    client.client().await.expect("ready client");
+    let approval = Constrained::allow_any(AskForApproval::OnRequest);
+    let permission = Constrained::allow_any(PermissionProfile::default());
+    let mut manager = McpConnectionSet::new_uninitialized(&approval, &permission, true);
+    manager.insert_test_client("docs", client);
+    let full = manager.list_all_tools().await;
+    assert_eq!(full.len(), 2);
+    let expected = full
+        .iter()
+        .find(|tool| tool.tool.name == "a.b")
+        .expect("dotted tool")
+        .canonical_tool_name();
+    manager
+        .servers
+        .get_mut("docs")
+        .expect("docs")
+        .tool_filter
+        .enabled = Some(HashSet::from(["a.b".to_owned()]));
+    let selected = manager.list_all_tools().await;
+    assert_eq!(selected.len(), 1);
+    assert_eq!(selected[0].canonical_tool_name(), expected);
+    assert_eq!(selected[0].tool.name, "a.b");
+    let binding = capture_binding(&Arc::new(manager)).await;
+    assert_eq!(binding.tools().len(), 1);
+    assert_eq!(binding.tools()[0].canonical_tool_name(), expected);
+    assert_eq!(binding.tools()[0].tool.name, "a.b");
+}
+
+#[test]
+fn selected_raw_subset_preserves_complete_catalog_names_golden_vectors() {
+    let expected: serde_json::Value = serde_json::from_str(r#"[{"server": "docs", "raw": "a.b", "namespace": "mcp__docs", "name": "a_b_98fddac4920d"}, {"server": "docs", "raw": "a_b", "namespace": "mcp__docs", "name": "a_b_ad9cfbd56676"}, {"server": "docs", "raw": "récord", "namespace": "mcp__docs", "name": "r_cord"}, {"server": "docs", "raw": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "namespace": "mcp__docs", "name": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_667b55e866b4"}, {"server": "docs", "raw": "", "namespace": "mcp__docs", "name": "__2e3a2e842460"}, {"server": "docs", "raw": "😀", "namespace": "mcp__docs", "name": "__cc10b263be5f"}, {"server": "team-a", "raw": "lookup", "namespace": "mcp__team_a_6c297ddc1d9b", "name": "lookup"}, {"server": "team_a", "raw": "lookup", "namespace": "mcp__team_a_8aa268757a69", "name": "lookup"}, {"server": "ab", "raw": "c", "namespace": "mcp__ab", "name": "c_147906af845b"}, {"server": "a", "raw": "bc", "namespace": "mcp__a", "name": "bc"}]"#).unwrap();
+    let inputs = expected.as_array().unwrap().iter().map(|item| {
+        create_test_tool(
+            item["server"].as_str().unwrap(),
+            item["raw"].as_str().unwrap(),
+        )
+    });
+    let actual = normalize_tools_for_model_with_prefix(inputs, true, &[]);
+    for item in expected.as_array().unwrap() {
+        let tool = actual
+            .iter()
+            .find(|tool| {
+                tool.server_name == item["server"].as_str().unwrap()
+                    && tool.tool.name == item["raw"].as_str().unwrap()
+            })
+            .unwrap();
+        assert_eq!(tool.callable_namespace, item["namespace"].as_str().unwrap());
+        assert_eq!(tool.callable_name, item["name"].as_str().unwrap());
+    }
+}
