+            }
+            if let SdkHistoryEdit::Replace { keep, .. } = &edit
+                && state.sdk_originals.len().is_some_and(|total| *keep > total)
+            {
+                return Err(invalid("history keep exceeds snapshot length"));
+            }
+        }
+        let current = self.sdk_load_original_history().await?;
+        let mut state = self.state.lock().await;
+        if state.sdk_originals.revision() != Some(expected_revision) {
+            return Err(invalid("canonical history revision conflict"));
+        }
