+    #[test]
+    fn repeated_compaction_references_preserve_originals_without_copying_catalog() {
+        let mut originals = SdkOriginalHistory::default();
+        originals.append(SdkOriginalItem {
+            original: json!({"type":"future", "payload":"x".repeat(128 * 1024)}).to_string(),
+            projection: None,
+        });
+        let before = originals.snapshot(None);
+        let seed: crate::RolloutItem = serde_json::from_value(json!({
+            "type":"compacted", "payload":{"message":"seed", "sdk_originals":originals}
+        }))
+        .unwrap();
+        let marker: crate::RolloutItem = serde_json::from_value(json!({
+            "type":"compacted", "payload":{"message":"summary", "replacement_history":[],
+                "sdk_originals":{"preserve":true}}
+        }))
+        .unwrap();
+        assert!(serde_json::to_vec(&marker).unwrap().len() < 1024);
+        let mut journal = vec![seed];
+        let initial_size = serde_json::to_vec(&journal).unwrap().len();
+        journal.extend(std::iter::repeat_n(marker, 4));
+        assert!(serde_json::to_vec(&journal).unwrap().len() - initial_size < 4096);
+        let restored: Vec<crate::RolloutItem> =
+            serde_json::from_slice(&serde_json::to_vec(&journal).unwrap()).unwrap();
+        let replayed =
+            SdkOriginalHistory::replay(&restored, |item| Some(item.clone()), |_, _| vec![]);
+        assert_eq!(replayed.snapshot(None), before);
+        assert!(replayed.items[0].projection.is_none());
+    }
