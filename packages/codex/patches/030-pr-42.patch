+        use codex_protocol::error::CodexErr;
+        let unavailable =
+            || CodexErr::InvalidRequest("Canonical original history is unavailable".into());
+        let (token, total, fallback_policy) = {
+            let state = self.state.lock().await;
+            (
+                (
+                    state.sdk_originals.revision().map(str::to_owned),
+                    state.sdk_originals.read_token().1,
+                ),
+                state.sdk_originals.len(),
+                state.sdk_originals_replay_policy.unwrap_or(
+                    codex_utils_output_truncation::TruncationPolicy::Bytes(usize::MAX),
+                ),
+            )
+        };
+        if total == Some(0) {
+            return Ok(Default::default());
+        }
+        let live = self.live_thread().ok_or_else(unavailable)?;
+        // Reuse the existing canonical failure flag and durability barrier before trusting storage.
+        live.flush().await.map_err(|_| unavailable())?;
+        let persisted = live.load_history(false).await.map_err(|_| unavailable())?;
+        let originals = codex_history::sdk_originals::SdkOriginalHistory::replay(
+            &persisted.items,
+            |row| {
+                let mut projected = crate::context_manager::ContextManager::new();
+                // Captured per-record limits take precedence over the scalar legacy restore policy.
+                let normalized = if matches!(&row.item, ResponseItem::Message { .. }) {
+                    let mut normalized = row.clone();
+                    if let Some(content) =
+                        codex_context_fragments::to_annotated_content(&mut normalized.item)
+                    {
+                        let _ = codex_context_fragments::set_annotated_content(
+                            &mut normalized.item,
+                            content,
+                        );
+                    }
+                    Some(normalized)
+                } else {
+                    None
+                };
+                projected
+                    .replay_annotated_item(normalized.as_ref().unwrap_or(row), fallback_policy);
+                projected.annotated_items().last().cloned()
+            },
+            |items, turns| {
+                let mut history = crate::context_manager::ContextManager::new();
+                history.replace_annotated(items.to_vec());
+                history.drop_last_n_user_turns(turns);
+                history.annotated_items().to_vec()
+            },
+        );
+        let mut state = self.state.lock().await;
+        let current_token = (
+            state.sdk_originals.revision().map(str::to_owned),
+            state.sdk_originals.read_token().1,
+        );
+        if current_token != token
+            || total.is_some_and(|count| originals.items.len() != count)
+            || token
+                .0
+                .as_ref()
+                .is_some_and(|revision| originals.revision() != revision)
+        {
+            return Err(unavailable());
+        }
+        state.sdk_originals =
+            codex_history::sdk_originals::SdkOriginalHistoryCache::from(&originals);
+        Ok(originals)
+    }
+
+    /// Return only previously admitted projections within an original-value prefix.
+    pub(crate) async fn sdk_history_projection(
+        &self,
+        keep: Option<usize>,
+    ) -> codex_protocol::error::Result<Vec<ResponseItem>> {
+        let originals = self.sdk_load_original_history().await?;
+        let keep = keep
+            .unwrap_or(originals.items.len())
+            .min(originals.items.len());
+        Ok(originals.items[..keep]
+            .iter()
+            .filter_map(|item| item.projection.as_ref().map(|row| row.item.clone()))
+            .collect())
+    }
+
+    /// The SDK owns exclusive native ingress and the mutation permit throughout.
+    pub(crate) async fn sdk_replace_history(
+        &self,
+        expected_revision: &str,
+        keep: usize,
+        appended: Vec<String>,
+    ) -> codex_protocol::error::Result<String> {
+        let (revision, _, _) = self
+            .sdk_edit_history(
+                expected_revision,
+                SdkHistoryEdit::Replace { keep, appended },
+            )
+            .await?;
+        Ok(revision)
+    }
+
+    pub(crate) async fn sdk_pop_history(
+        &self,
+        expected_revision: &str,
+        allow_rebuild: bool,
+    ) -> codex_protocol::error::Result<(String, Option<String>, bool)> {
+        self.sdk_edit_history(expected_revision, SdkHistoryEdit::Pop { allow_rebuild })
+            .await
+    }
+
+    async fn sdk_edit_history(
+        &self,
+        expected_revision: &str,
+        edit: SdkHistoryEdit,
+    ) -> codex_protocol::error::Result<(String, Option<String>, bool)> {
+        use crate::context_manager::HistoryReplacement;
+        use codex_history::sdk_originals::{SdkOriginalItem, input_projection};
+        use codex_protocol::error::CodexErr;
