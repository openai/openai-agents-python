+#[tokio::test]
+async fn sdk_original_checkpoint_restore_and_rollback_keep_audit_rows_in_position() {
+    use codex_protocol::protocol::ThreadRolledBackEvent;
+    use serde_json::json;
+    let (mut session, turn, _) = make_session_and_context_with_rx().await;
+    crate::session::tests::attach_thread_persistence(
+        std::sync::Arc::get_mut(&mut session).expect("unique session"),
+    )
+    .await;
+    let originals = vec![
+        json!({"type":"message","role":"user","content":[{"type":"input_text","text":"first"}],"future":1}),
+        json!({"type":"future","audit":"first"}),
+        json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"answer one"}]}),
+        json!({"type":"message","role":"user","content":[{"type":"input_text","text":"second"}],"future":2}),
+        json!({"type":"future","audit":"second"}),
+        json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"answer two"}]}),
+    ].into_iter().map(|value| value.to_string()).collect::<Vec<_>>();
+    let revision = session.sdk_history_snapshot(None).await.unwrap().0;
+    session
+        .sdk_replace_history(&revision, 0, originals.clone())
+        .await
+        .unwrap();
+    let model = session.clone_history().await.into_annotated_items();
+    let catalog = session.sdk_load_original_history().await.unwrap();
+    let mut checkpoint: codex_history::CompactedItem =
+        serde_json::from_value(json!({"message":""})).unwrap();
+    checkpoint.replacement_history = Some(model.clone());
+    checkpoint.sdk_originals = Some(catalog.into());
+    // Core rollback crosses a compaction only with its surviving native prefix.
+    let mut records: Vec<_> = model.into_iter().map(RolloutItem::ResponseItem).collect();
+    records.push(RolloutItem::Compacted(checkpoint));
+    records = serde_json::from_value(serde_json::to_value(records).unwrap()).unwrap();
+    session.apply_rollout_reconstruction(&turn, &records).await;
+    assert_eq!(
+        session.sdk_history_snapshot(None).await.unwrap().2,
+        originals
+    );
+    let rollback = RolloutItem::EventMsg(EventMsg::ThreadRolledBack(ThreadRolledBackEvent {
+        num_turns: 1,
+    }));
+    records.push(rollback.clone());
+    session.persist_rollout_items(&[rollback]).await;
+    session.apply_rollout_reconstruction(&turn, &records).await;
+    assert_eq!(
+        session.sdk_history_snapshot(None).await.unwrap().2,
+        originals[..3]
+    );
+    let retained_model = session.clone_history().await.into_annotated_items();
+    assert_eq!(retained_model.len(), 2);
+    assert_eq!(
+        serde_json::to_value(&retained_model[0].item).unwrap()["content"][0]["text"],
+        "first"
+    );
+}
