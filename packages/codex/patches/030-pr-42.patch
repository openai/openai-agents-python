+    #[test]
+    fn idle_catalog_cache_stays_byte_bounded_across_ten_thousand_originals() {
+        let mut cache = SdkOriginalHistoryCache::default();
+        let mut journal = SdkOriginalHistory::default();
+        for n in 0..10_000 {
+            let original = json!({"type":"audit", "n":n, "text":"x".repeat(128)}).to_string();
+            cache.append(original.clone());
+            journal.append(SdkOriginalItem {
+                original,
+                projection: None,
+            });
+            assert!(cache.retained_bytes() <= SdkOriginalHistoryCache::MAX_RETAINED_BYTES);
+        }
+        assert_eq!(cache.snapshot(Some(0)), Some(journal.snapshot(Some(0))));
+        assert_eq!(cache.snapshot(Some(2)), Some(journal.snapshot(Some(2))));
+        assert!(cache.snapshot(None).is_none());
+        let restored = SdkOriginalHistoryCache::from(&journal);
+        assert!(restored.retained_bytes() <= SdkOriginalHistoryCache::MAX_RETAINED_BYTES);
+        assert_eq!(restored.snapshot(Some(2)), Some(journal.snapshot(Some(2))));
+    }
+
+    #[test]
+    fn preserved_model_checkpoint_keeps_metadata_unloaded_and_append_byte_bounded() {
+        let checkpoint: crate::RolloutItem =
+            serde_json::from_value(json!({"type":"compacted","payload":{
+                "message":"summary", "replacement_history":[], "window_number":1,
+                "sdk_originals":{"preserve":true}
+            }}))
+            .unwrap();
+        let mut cache = SdkOriginalHistoryCache::replay_metadata(&[checkpoint], |_| true);
+        assert_eq!(cache.revision(), None);
+        assert_eq!(cache.len(), None);
+        assert_eq!(cache.snapshot(Some(0)), None);
+        let before = cache.read_token().1;
+        for n in 0..10_000 {
+            cache.append(json!({"type":"audit","n":n,"text":"x".repeat(128)}).to_string());
+            assert!(cache.retained_bytes() <= SdkOriginalHistoryCache::MAX_RETAINED_BYTES);
+        }
+        assert!(cache.read_token().1 > before);
+        assert_eq!(cache.snapshot(Some(1)), None);
+    }
+
+    #[test]
+    fn oversized_originals_stay_in_journal_without_a_live_cache_copy() {
+        let original = json!({"type":"future", "payload":"x".repeat(128 * 1024)}).to_string();
+        let mut journal = SdkOriginalHistory::default();
+        journal.append(SdkOriginalItem {
+            original: original.clone(),
+            projection: None,
+        });
+        let mut cache = SdkOriginalHistoryCache::default();
+        cache.append(original);
+        assert_eq!(cache.retained_bytes(), 0);
+        assert!(cache.snapshot(Some(1)).is_none());
+        assert_eq!(cache.snapshot(Some(0)), Some(journal.snapshot(Some(0))));
+        let restored: SdkOriginalHistory =
+            serde_json::from_slice(&serde_json::to_vec(&journal).unwrap()).unwrap();
+        let cache = SdkOriginalHistoryCache::from(&restored);
+        assert_eq!(cache.retained_bytes(), 0);
+        assert_eq!(restored.snapshot(None), journal.snapshot(None));
+    }
