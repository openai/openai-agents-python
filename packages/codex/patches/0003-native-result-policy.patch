diff --git a/codex-rs/core/src/tools/builtin_result_policy.rs b/codex-rs/core/src/tools/builtin_result_policy.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f4457a8fee6a2e60f9d8e9d0efab184b64ab1da2
--- /dev/null
+++ b/codex-rs/core/src/tools/builtin_result_policy.rs
@@ -0,0 +1,255 @@
+//! Whole-result policy for the three native Environment tools only.
+use crate::function_tool::FunctionCallError;
+use crate::tools::context::ToolInvocation;
+use codex_extension_api::{BuiltinToolResultInput, ExtensionData, ToolLifecycleContributor};
+use codex_protocol::items::TurnItem;
+use codex_protocol::models::ResponseInputItem;
+use codex_protocol::protocol::EventMsg;
+use codex_tools::{JsonToolOutput, ToolOutput, ToolPayload};
+use serde_json::Value;
+use std::collections::HashSet;
+use std::sync::{Arc, Mutex};
+
+const WITHHELD: &str = "Native tool output withheld by result policy";
+
+// A turn can finish before its process watcher. Keep the mark in the original
+// turn store, which that watcher already owns; never clear it at tool finish.
+#[derive(Default)]
+pub(crate) struct ControlledOutputs(Mutex<HashSet<String>>);
+
+pub(crate) fn mark(store: &ExtensionData, call_id: &str) {
+    store
+        .get_or_init(ControlledOutputs::default)
+        .0
+        .lock()
+        .expect("result policy poisoned")
+        .insert(call_id.to_owned());
+}
+pub(crate) fn controlled(store: &ExtensionData, call_id: &str) -> bool {
+    store.get::<ControlledOutputs>().is_some_and(|state| {
+        state
+            .0
+            .lock()
+            .expect("result policy poisoned")
+            .contains(call_id)
+    })
+}
+
+pub(crate) fn capture(invocation: &ToolInvocation) -> Option<Arc<dyn ToolLifecycleContributor>> {
+    if !invocation.tool_name.is_default_namespace()
+        || !matches!(
+            invocation.tool_name.name.as_str(),
+            "exec_command" | "write_stdin" | "apply_patch"
+        )
+    {
+        return None;
+    }
+    let owner = invocation
+        .session
+        .services
+        .extensions
+        .tool_lifecycle_contributors()
+        .iter()
+        .find(|owner| {
+            owner.controls_builtin_result(
+                &invocation.session.services.thread_extension_data,
+                &invocation.tool_name,
+            )
+        })
+        .cloned()?;
+    mark(&invocation.turn.extension_data, &invocation.call_id);
+    Some(owner)
+}
+
+// Redact before lifecycle observers, tracing, legacy projections and rollout.
+// Whole-result callbacks cannot authorize a partial chunk in advance.
+pub(crate) fn filter_item(store: &ExtensionData, item: &mut TurnItem) {
+    match item {
+        TurnItem::CommandExecution(item) if controlled(store, &item.id) => {
+            item.aggregated_output = Some(WITHHELD.into());
+        }
+        TurnItem::FileChange(item) if controlled(store, &item.id) => {
+            item.stdout = Some(WITHHELD.into());
+            item.stderr = None;
+        }
+        _ => {}
+    }
+}
+pub(crate) fn filter_event(store: &ExtensionData, event: &mut EventMsg) -> bool {
+    match event {
+        EventMsg::ExecCommandOutputDelta(item) if controlled(store, &item.call_id) => return false,
+        EventMsg::ExecCommandEnd(item) if controlled(store, &item.call_id) => {
+            item.aggregated_output = WITHHELD.into();
+        }
+        EventMsg::PatchApplyEnd(item) if controlled(store, &item.call_id) => {
+            item.stdout = WITHHELD.into();
+            item.stderr.clear();
+        }
+        EventMsg::ItemCompleted(item) => filter_item(store, &mut item.item),
+        _ => {}
+    }
+    true
+}
+
+struct AcceptedOutput {
+    inner: JsonToolOutput,
+    hook_input: Option<Value>,
+    hook_id: String,
+    hook_response: bool,
+    token_limit: Option<usize>,
+}
+impl ToolOutput for AcceptedOutput {
+    fn log_output(&self) -> String {
+        self.inner.log_output()
+    }
+    fn success_for_logging(&self) -> bool {
+        self.inner.success_for_logging()
+    }
+    fn contains_external_context(&self) -> bool {
+        self.inner.contains_external_context()
+    }
+    fn fallback_token_limit_override(&self) -> Option<usize> {
+        self.token_limit
+    }
+    fn to_response_item(&self, id: &str, payload: &ToolPayload) -> ResponseInputItem {
+        self.inner.to_response_item(id, payload)
+    }
+    fn code_mode_result(&self, payload: &ToolPayload) -> Value {
+        self.inner.code_mode_result(payload)
+    }
+    fn post_tool_use_id(&self, _: &str) -> String {
+        self.hook_id.clone()
+    }
+    fn post_tool_use_input(&self, _: &ToolPayload) -> Option<Value> {
+        self.hook_input.clone()
+    }
+    fn post_tool_use_response(&self, id: &str, payload: &ToolPayload) -> Option<Value> {
+        self.hook_response
+            .then(|| self.inner.post_tool_use_response(id, payload))
+            .flatten()
+    }
+    // No raw backing output or content-bearing tool_result_metadata survives.
+}
+
+pub(crate) fn failure() -> FunctionCallError {
+    FunctionCallError::RespondToModel(WITHHELD.into())
+}
+
+pub(crate) async fn accept(
+    invocation: &ToolInvocation,
+    owner: &dyn ToolLifecycleContributor,
+    raw: Box<dyn ToolOutput>,
+) -> Result<Box<dyn ToolOutput>, FunctionCallError> {
+    let hook_input = raw.post_tool_use_input(&invocation.payload);
+    let hook_id = raw.post_tool_use_id(&invocation.call_id);
+    let hook_response = raw
+        .post_tool_use_response(&invocation.call_id, &invocation.payload)
+        .is_some();
+    let success = raw.success_for_logging();
+    let external = raw.contains_external_context();
+    let token_limit = raw.fallback_token_limit_override();
+    let value = raw.code_mode_result(&invocation.payload);
+    drop(raw);
+    let source = super::lifecycle::extension_tool_call_source(invocation.source.clone());
+    let outer_call_id = if matches!(source, codex_tools::ToolCallSource::CodeMode { .. }) {
+        invocation
+            .originating_call()
+            .await
+            .map(|origin| origin.call_id)
+    } else {
+        None
+    };
+    let accepted = owner
+        .on_builtin_tool_result(BuiltinToolResultInput {
+            model: &invocation.step_context.settings.model_info.slug,
+            thread_store: &invocation.session.services.thread_extension_data,
+            turn_store: &invocation.turn.extension_data,
+            turn_id: &invocation.turn.sub_id,
+            call_id: &invocation.call_id,
+            outer_call_id: outer_call_id.as_deref(),
+            tool_name: &invocation.tool_name,
+            payload: &invocation.payload,
+            source,
+            result: &value,
+            cancelled: Box::pin(invocation.cancellation_token.cancelled()),
+        })
+        .await
+        .map_err(|_| failure())?;
+    let mut inner = JsonToolOutput::with_success(accepted, Some(success));
+    if external {
+        inner = inner.with_external_context();
+    }
+    Ok(Box::new(AcceptedOutput {
+        inner,
+        hook_input,
+        hook_id,
+        hook_response,
+        token_limit,
+    }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::protocol::{ExecCommandOutputDeltaEvent, ExecOutputStream};
+    use serde_json::json;
+
+    #[test]
+    fn original_turn_mark_survives_and_does_not_affect_successor() {
+        let original = ExtensionData::new("original");
+        let successor = ExtensionData::new("successor");
+        let mut delta = EventMsg::ExecCommandOutputDelta(ExecCommandOutputDeltaEvent {
+            call_id: "reused-id".into(),
+            stream: ExecOutputStream::Stdout,
+            chunk: b"private-result".to_vec(),
+        });
+        assert!(filter_event(&original, &mut delta));
+        mark(&original, "reused-id");
+        assert!(!filter_event(&original, &mut delta));
+        assert!(filter_event(&successor, &mut delta));
+    }
+
+    #[test]
+    fn accepted_output_owns_every_projection_without_raw_backing_state() {
+        let output = AcceptedOutput {
+            inner: JsonToolOutput::with_success(json!({"output":"accepted"}), Some(false))
+                .with_external_context(),
+            hook_input: Some(json!({"command":"read"})),
+            hook_id: "original-exec".into(),
+            hook_response: true,
+            token_limit: Some(42),
+        };
+        for payload in [
+            ToolPayload::Function {
+                arguments: "{}".into(),
+            },
+            ToolPayload::Custom {
+                input: "patch".into(),
+            },
+        ] {
+            assert_eq!(
+                output.code_mode_result(&payload),
+                json!({"output":"accepted"})
+            );
+            assert_eq!(
+                output.post_tool_use_response("call", &payload),
+                Some(json!({"output":"accepted"}))
+            );
+            assert!(
+                serde_json::to_string(&output.to_response_item("call", &payload))
+                    .unwrap()
+                    .contains("accepted")
+            );
+            assert_eq!(
+                output.post_tool_use_input(&payload),
+                Some(json!({"command":"read"}))
+            );
+        }
+        assert_eq!(output.log_output(), "{\"output\":\"accepted\"}");
+        assert!(!output.success_for_logging());
+        assert!(output.contains_external_context());
+        assert_eq!(output.post_tool_use_id("call"), "original-exec");
+        assert_eq!(output.fallback_token_limit_override(), Some(42));
+        assert!(output.tool_result_metadata().is_none());
+    }
+}
