+// Validate opaque metadata with typed serde containers, without Value's private-map visitor.
+// Return canonical JSON so escaped strings keep the existing encoded-attribute byte limit.
+fn bounded_metadata_json(
+    encoded: &str,
+    depth: usize,
+) -> Result<Box<serde_json::value::RawValue>, String> {
+    if depth > 8 {
+        return Err("Tracing metadata exceeds maximum depth of 8".into());
+    }
+    let encoded = encoded.trim_start();
+    let serialized = if encoded.starts_with('"') {
+        let value: String =
+            serde_json::from_str(encoded).map_err(|_| "Invalid tracing metadata")?;
+        if value.len() > 4096 {
+            return Err("Tracing string exceeds 4096 UTF-8 bytes".into());
+        }
+        serde_json::value::to_raw_value(&value)
+    } else if encoded.starts_with('[') {
+        let values: Vec<&serde_json::value::RawValue> =
+            serde_json::from_str(encoded).map_err(|_| "Invalid tracing metadata")?;
+        if values.len() > 64 {
+            return Err("Tracing arrays may contain at most 64 entries".into());
+        }
+        let values = values
+            .iter()
+            .map(|value| bounded_metadata_json(value.get(), depth + 1))
+            .collect::<Result<Vec<_>, _>>()?;
+        serde_json::value::to_raw_value(&values)
+    } else if encoded.starts_with('{') {
+        let values: std::collections::BTreeMap<String, &serde_json::value::RawValue> =
+            serde_json::from_str(encoded).map_err(|_| "Invalid tracing metadata")?;
+        if values.len() > 64 {
+            return Err("Tracing objects may contain at most 64 fields".into());
+        }
+        let mut bounded = std::collections::BTreeMap::new();
+        for (key, value) in values {
+            if key.len() > 256 {
+                return Err("Tracing key exceeds 256 UTF-8 bytes".into());
+            }
+            bounded.insert(key, bounded_metadata_json(value.get(), depth + 1)?);
+        }
+        serde_json::value::to_raw_value(&bounded)
+    } else {
+        return serde_json::value::RawValue::from_string(encoded.to_owned())
+            .map_err(|_| "Invalid tracing metadata".into());
+    };
+    serialized.map_err(|_| "Invalid tracing metadata".into())
+}
