+#[test]
+fn acknowledged_window_requires_exact_client_provider_and_auth_scope() {
+    let mut client = test_model_client(SessionSource::Cli);
+    let info = client.state.provider.info().clone();
+    let auth =
+        AuthManager::from_auth_for_testing(CodexAuth::create_dummy_chatgpt_auth_for_testing());
+    Arc::get_mut(&mut client.state).unwrap().provider =
+        create_model_provider(info.clone(), Some(auth.clone()));
+    let same_scope = create_model_provider(info.clone(), Some(auth));
+    assert!(!Arc::ptr_eq(&client.state.provider, &same_scope));
+    let mut receipt = super::NativeProviderResponse {
+        anchor: codex_extension_api::ProviderResponseAnchor {
+            response_id: "response-native".into(),
+            model: Some("model".into()),
+        },
+        owner: Arc::downgrade(&client.state),
+        auth_owner_generation: client.auth_owner_generation(),
+    };
+    assert!(receipt.matches_provider(&client, &same_scope));
+    let other = test_model_client(SessionSource::Cli);
+    assert!(!receipt.matches_provider(&other, &same_scope));
+    let mut different_info = info.clone();
+    different_info.base_url = Some("https://other.example.invalid/v1".into());
+    let different_provider = create_model_provider(different_info, client.auth_manager());
+    assert!(!receipt.matches_provider(&client, &different_provider));
+    let different_auth =
+        AuthManager::from_auth_for_testing(CodexAuth::create_dummy_chatgpt_auth_for_testing());
+    let different_auth_provider = create_model_provider(info, Some(different_auth));
+    assert!(!receipt.matches_provider(&client, &different_auth_provider));
+    receipt.auth_owner_generation = Some(
+        client
+            .auth_owner_generation()
+            .unwrap_or_default()
+            .wrapping_add(1),
+    );
+    assert!(!receipt.matches_provider(&client, &same_scope));
+}
