+#[test]
+fn provider_compaction_projects_latest_window_and_preserves_canonical_history() {
+    let compaction = |id: &str| ResponseItemEnvelope {
+        item: ResponseItem::Compaction {
+            id: None,
+            encrypted_content: id.to_owned(),
+            internal_chat_message_metadata_passthrough: None,
+        },
+        metadata: Some(CodexHarnessMetadata {
+            provider_compaction: true,
+            ..Default::default()
+        }),
+    };
+    let mut history =
+        create_history_with_items(vec![user_msg("original user"), assistant_msg("old")]);
+    history.set_reference_context_item(Some(reference_context_item()));
+    let first = compaction("first");
+    history.replay_annotated_item(&first, TruncationPolicy::Tokens(10_000));
+    assert!(history.reference_context_item().is_none());
+    history.record_items(
+        [&user_msg("middle")].into_iter(),
+        TruncationPolicy::Tokens(10_000),
+    );
+    let latest = compaction("latest");
+    // Persisted provenance survives a cold JSON round trip and ordinary history replay.
+    let latest: ResponseItemEnvelope =
+        serde_json::from_str(&serde_json::to_string(&latest).unwrap()).unwrap();
+    history.replay_annotated_item(&latest, TruncationPolicy::Tokens(10_000));
+    let later = user_msg("later");
+    history.record_items([&later].into_iter(), TruncationPolicy::Tokens(10_000));
+    let audit = raw_items(&history);
+    assert_eq!(
+        history.clone().for_prompt(&default_input_modalities()),
+        vec![latest.item, later]
+    );
+    assert_eq!(raw_items(&history), audit);
+    assert_eq!(audit.len(), 6);
+}
