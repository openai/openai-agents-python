+#[test]
+fn provider_compaction_accounting_ignores_old_files_and_reasoning() {
+    use codex_protocol::input_file::InputFile;
+    let encrypted_reasoning = |text: &str, size: usize| {
+        let mut item = reasoning_msg(text);
+        let ResponseItem::Reasoning {
+            encrypted_content, ..
+        } = &mut item
+        else {
+            unreachable!()
+        };
+        *encrypted_content = Some("A".repeat(size));
+        item
+    };
+    let mut old_file = user_msg("old opaque file");
+    let ResponseItem::Message { content, .. } = &mut old_file else {
+        unreachable!()
+    };
+    content.push(ContentItem::InputFile {
+        file: InputFile::from_file_id("file-before-provider-compaction".into(), None).unwrap(),
+    });
+    let mut history = create_history_with_items(vec![
+        old_file,
+        encrypted_reasoning("old", 1024),
+        assistant_msg("old assistant"),
+    ]);
+    let boundary = ResponseItemEnvelope {
+        item: ResponseItem::Compaction {
+            id: None,
+            encrypted_content: "current opaque window".to_owned(),
+            internal_chat_message_metadata_passthrough: None,
+        },
+        metadata: Some(CodexHarnessMetadata {
+            provider_compaction: true,
+            ..Default::default()
+        }),
+    };
+    history.replay_annotated_item(&boundary, TruncationPolicy::Tokens(10_000));
+    let current = vec![
+        user_msg("current user"),
+        encrypted_reasoning("current", 128),
+        assistant_msg("current assistant"),
+        user_msg("next user"),
+    ];
+    history.record_items(current.iter(), TruncationPolicy::Tokens(10_000));
+    let mut expected =
+        create_history_with_items(std::iter::once(boundary.item).chain(current).collect());
+    for context in [&mut history, &mut expected] {
+        context.update_token_info(
+            &TokenUsage {
+                total_tokens: 321,
+                ..Default::default()
+            },
+            Some(8192),
+        );
+    }
+    let audit = raw_items(&history);
+    assert_eq!(audit.len(), 8);
+    assert!(!history.has_file_content());
+    let base = BaseInstructions {
+        text: "current instructions".to_owned(),
+        provenance: None,
+    };
+    assert_eq!(
+        history.estimate_token_count_with_base_instructions(&base),
+        expected.estimate_token_count_with_base_instructions(&base)
+    );
+    assert!(
+        history
+            .estimate_token_count_with_base_instructions(&base)
+            .is_some()
+    );
+    for server_reasoning_included in [false, true] {
+        assert_eq!(
+            history.get_total_token_usage(server_reasoning_included),
+            expected.get_total_token_usage(server_reasoning_included)
+        );
+    }
+    assert_eq!(
+        history.estimated_tokens_after_last_model_generated_item(),
+        expected.estimated_tokens_after_last_model_generated_item()
+    );
+    assert_eq!(
+        history.token_info().unwrap().last_token_usage.total_tokens,
+        321
+    );
+    assert_eq!(raw_items(&history), audit);
+}
