+/// Provider boundaries affect only the model projection and its current-context baseline.
+fn is_provider_compaction_boundary(envelope: &ResponseItemEnvelope) -> bool {
+    envelope
+        .metadata
+        .as_ref()
+        .is_some_and(|metadata| metadata.provider_compaction)
+        && match &envelope.item {
+            ResponseItem::Compaction {
+                encrypted_content, ..
+            } => !encrypted_content.is_empty(),
+            ResponseItem::ContextCompaction {
+                encrypted_content: Some(content),
+                ..
+            } => !content.is_empty(),
+            _ => false,
+        }
 }
 
