+#[test]
+fn native_compaction_replacement_keeps_its_retained_user_items() {
+    let user = user_msg("retained outside the native summary");
+    let summary = ResponseItem::Compaction {
+        id: None,
+        encrypted_content: "native replacement".to_owned(),
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let mut history = create_history_with_items(vec![user.clone()]);
+    history.set_reference_context_item(Some(reference_context_item()));
+    let envelope = ResponseItemEnvelope {
+        item: summary.clone(),
+        metadata: Some(CodexHarnessMetadata::default()),
+    };
+    let saved = serde_json::to_string(&envelope).unwrap();
+    assert!(!saved.contains("provider_compaction"));
+    let legacy: ResponseItemEnvelope = serde_json::from_str(&saved).unwrap();
+    history.replay_annotated_item(&legacy, TruncationPolicy::Tokens(10_000));
+    assert!(history.reference_context_item().is_some());
+    assert_eq!(
+        history.for_prompt(&default_input_modalities()),
+        vec![user, summary]
+    );
+}
