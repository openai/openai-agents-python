+    #[test]
+    fn protected_mount_backed_by_a_child_of_a_write_grant() -> io::Result<()> {
+        let temp = tempfile::tempdir()?;
+        let workspace = temp.path().join("workspace");
+        let source = workspace.join("source");
+        fs::create_dir_all(&source)?;
+        let protected = temp.path().join("protected");
+        fs::write(&protected, "synthetic bind target")?;
+        let alias = source.join("alias");
+        // A hard link supplies the same file identity without a privileged mount.
+        fs::hard_link(&protected, &alias)?;
+        let mountinfo = format!(
+            "3 1 0:1 / / rw - ext4 /dev/fixture rw\n7 3 0:1 {} {} rw - ext4 /dev/fixture rw\n",
+            alias.display(),
+            protected.display(),
+        );
+        let roots = [AbsolutePathBuf::from_absolute_path(&workspace)?];
+        let grants = LocalWriteRoots {
+            roots: &roots,
+            mounts: WritableMounts::new(&roots, mountinfo.as_bytes())?,
+        };
+
+        assert!(grants.contains_entry(&protected)?);
+        assert!(grants.has_root_at_or_below(&protected)?);
+
+        // Simulate a cover at the mount source with a different visible inode.
+        fs::remove_file(&alias)?;
+        fs::write(&alias, "covered by a different file")?;
+        assert!(!grants.contains_entry(&protected)?);
+        assert!(!grants.has_root_at_or_below(&protected)?);
+
+        // An intermediate symlink can resolve to the same inode outside the grant.
+        fs::remove_dir_all(&source)?;
+        let outside = temp.path().join("outside");
+        fs::create_dir(&outside)?;
+        fs::hard_link(&protected, outside.join("alias"))?;
+        std::os::unix::fs::symlink(outside, source)?;
+        assert!(!grants.contains_entry(&protected)?);
+        assert!(!grants.has_root_at_or_below(&protected)?);
+        Ok(())
+    }
