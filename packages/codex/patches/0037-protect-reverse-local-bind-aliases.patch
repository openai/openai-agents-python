+fn join_mount_relative(path: &Path, relative: &Path) -> PathBuf {
+    // Adding a slash to a file mount's own path makes it unstatable.
+    if relative.as_os_str().is_empty() {
+        path.to_path_buf()
+    } else {
+        path.join(relative)
+    }
+}
