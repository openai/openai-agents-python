+/// Match the same client-owned pairs used by SDK context validation.
+#[doc(hidden)]
+pub fn client_tool_pair_part(item: &ResponseItem) -> Option<(&'static str, Option<&str>, bool)> {
+    let part = match item {
+        ResponseItem::FunctionCall { call_id, .. } => ("function", Some(call_id.as_str()), true),
+        ResponseItem::ApplyPatchCall { call_id, .. } => {
+            ("apply_patch", Some(call_id.as_str()), true)
+        }
+        ResponseItem::ApplyPatchCallOutput { call_id, .. } => {
+            ("apply_patch", Some(call_id.as_str()), false)
+        }
+        ResponseItem::ShellCall {
+            provider_fields, ..
+        }
+        | ResponseItem::ShellCallOutput {
+            provider_fields, ..
+        } => (
+            "shell",
+            provider_fields
+                .get("call_id")
+                .and_then(serde_json::Value::as_str),
+            matches!(item, ResponseItem::ShellCall { .. }),
+        ),
+        ResponseItem::LocalShellCall { call_id, .. } => ("function", call_id.as_deref(), true),
+        ResponseItem::FunctionCallOutput { call_id, .. } => ("function", call_id.as_deref(), false),
+        ResponseItem::ComputerCall { call_id, .. } => ("computer", Some(call_id.as_str()), true),
+        ResponseItem::ComputerCallOutput { call_id, .. } => {
+            ("computer", Some(call_id.as_str()), false)
+        }
+        ResponseItem::CustomToolCall { call_id, .. } => ("custom", Some(call_id.as_str()), true),
+        ResponseItem::CustomToolCallOutput { call_id, .. } => {
+            ("custom", Some(call_id.as_str()), false)
+        }
+        ResponseItem::McpApprovalRequest { id, .. } => {
+            ("mcp-approval", id.as_ref().map(|id| id.as_str()), true)
+        }
+        ResponseItem::McpApprovalResponse {
+            approval_request_id,
+            ..
+        } => ("mcp-approval", Some(approval_request_id.as_str()), false),
+        ResponseItem::ToolSearchCall {
+            call_id, execution, ..
+        } if execution != "server" => ("search", call_id.as_deref(), true),
+        ResponseItem::ToolSearchOutput {
+            call_id, execution, ..
+        } if execution != "server" => ("search", call_id.as_deref(), false),
+        _ => return None,
+    };
+    Some(part)
+}
+
+fn tail_tool_partner(items: &[SdkOriginalItem]) -> Option<usize> {
+    let (tail, retained) = items.split_last()?;
+    let (family, Some(id), false) = client_tool_pair_part(&tail.projection.as_ref()?.item)? else {
+        return None;
+    };
+    // Calls with the same key can occur again after their previous output.
+    // The nearest occurrence must be the call for this exact tail output.
+    for (index, row) in retained.iter().enumerate().rev() {
+        let Some((other_family, Some(other_id), is_call)) = row
+            .projection
+            .as_ref()
+            .and_then(|row| client_tool_pair_part(&row.item))
+        else {
+            continue;
+        };
+        if other_family == family && other_id == id {
+            return is_call.then_some(index);
+        }
+    }
+    None
+}
