+    #[test]
+    fn cold_native_tool_result_pop_preserves_the_prior_summary() {
+        let envelope = |value: serde_json::Value| {
+            ResponseItemEnvelope::new(serde_json::from_value(value).unwrap())
+        };
+        let first_call = envelope(
+            json!({"type":"function_call","id":"before-call","call_id":"repeat","name":"lookup","arguments":"{}"}),
+        );
+        let first_output =
+            envelope(json!({"type":"function_call_output","call_id":"repeat","output":"covered"}));
+        let mut summary = envelope(
+            json!({"type":"message","id":"surviving-summary","role":"user","content":[{"type":"input_text","text":"covered context"}]}),
+        );
+        summary
+            .metadata
+            .get_or_insert_with(Default::default)
+            .compaction_output = true;
+        let post_summary_user = envelope(
+            json!({"type":"message","id":"post-summary-user","role":"user","content":[{"type":"input_text","text":"later request"}]}),
+        );
+        let call = envelope(
+            json!({"type":"function_call","id":"after-call","call_id":"repeat","name":"lookup","arguments":"{}"}),
+        );
+        let output = envelope(
+            json!({"type":"function_call_output","call_id":"repeat","output":"later native result"}),
+        );
+        let mut checkpoint: crate::RolloutItem =
+            serde_json::from_value(json!({"type":"compacted","payload":{
+                "message":"", "sdk_originals":{"preserve":true}
+            }}))
+            .unwrap();
+        let crate::RolloutItem::Compacted(payload) = &mut checkpoint else {
+            panic!("checkpoint")
+        };
+        payload.replacement_history = Some(vec![summary.clone()]);
+        let records = vec![
+            crate::RolloutItem::ResponseItem(first_call),
+            crate::RolloutItem::ResponseItem(first_output),
+            checkpoint.clone(),
+            crate::RolloutItem::ResponseItem(post_summary_user.clone()),
+            crate::RolloutItem::ResponseItem(call.clone()),
+            crate::RolloutItem::ResponseItem(output.clone()),
+        ];
+        let cold: Vec<crate::RolloutItem> =
+            serde_json::from_slice(&serde_json::to_vec(&records).unwrap()).unwrap();
+        let replay = |records: &[crate::RolloutItem]| {
+            SdkOriginalHistory::replay(records, |row| Some(row.clone()), |items, _| items.to_vec())
+        };
+        let history = replay(&cold);
+        let current = vec![
+            summary.clone(),
+            post_summary_user.clone(),
+            call.clone(),
+            output.clone(),
+        ];
+        let pop = history.prepare_pop(&current, false).unwrap().unwrap();
+        assert_eq!(pop.item, serde_json::to_string(&output.item).unwrap());
+        assert_eq!(pop.projection, vec![summary.clone(), post_summary_user]);
+        assert!(!pop.rebuilt_context);
+        assert_eq!(pop.originals.items.len(), 4);
+        assert!(pop.originals.items[0].projection.is_some());
+        assert!(pop.originals.items[1].projection.is_some());
+        assert!(pop.originals.items[2].projection.is_some());
+        assert!(pop.originals.items[3].projection.is_none());
+        let mut committed = cold.clone();
+        let mut append_pop = |pop: SdkOriginalHistoryPop| {
+            let crate::RolloutItem::Compacted(mut payload) = checkpoint.clone() else {
+                panic!("checkpoint")
+            };
+            payload.sdk_originals = Some(pop.originals.into());
+            payload.replacement_history = Some(pop.projection);
+            committed.push(crate::RolloutItem::Compacted(payload));
+            serde_json::from_slice::<Vec<crate::RolloutItem>>(
+                &serde_json::to_vec(&committed).unwrap(),
+            )
+            .unwrap()
+        };
+        let after_result = append_pop(pop);
+        let first_restored = replay(&after_result);
+        assert_eq!(first_restored.post_checkpoint_start, Some(2));
+        let mut changed_summary = after_result.clone();
+        let Some(crate::RolloutItem::Compacted(last)) = changed_summary.last_mut() else {
+            panic!("pop checkpoint")
+        };
+        last.replacement_history.as_mut().unwrap().remove(0);
+        let invalidated = replay(&changed_summary);
+        assert_eq!(
+            invalidated.post_checkpoint_start,
+            Some(invalidated.items.len())
+        );
+        let Some(crate::RolloutItem::Compacted(last)) = after_result.last() else {
+            panic!("pop checkpoint")
+        };
+        let shortened = last.replacement_history.clone().unwrap();
+        let call_pop = first_restored
+            .prepare_pop(&shortened, false)
+            .unwrap()
+            .unwrap();
+        assert!(!call_pop.rebuilt_context);
+        assert_eq!(call_pop.projection, shortened);
+        let after_call = append_pop(call_pop);
+        let user_pop = replay(&after_call)
+            .prepare_pop(&shortened, false)
+            .unwrap()
+            .unwrap();
+        assert!(!user_pop.rebuilt_context);
+        assert_eq!(user_pop.projection, vec![summary]);
+        // Serializing the catalog cannot mint journal-derived subtraction authority.
+        let payload_only: SdkOriginalHistory =
+            serde_json::from_slice(&serde_json::to_vec(&history).unwrap()).unwrap();
+        assert!(payload_only.prepare_pop(&current, false).is_err());
+        // A result after the boundary cannot retire a call covered by that boundary.
+        let split = vec![
+            crate::RolloutItem::ResponseItem(call),
+            checkpoint,
+            crate::RolloutItem::ResponseItem(output),
+        ];
+        assert!(replay(&split).prepare_pop(&current, false).is_err());
+    }
