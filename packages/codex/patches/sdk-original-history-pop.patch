+    #[test]
+    fn pop_tool_output_retires_only_the_matching_call_in_model_context() {
+        let first_call = r#"{"type":"function_call","id":"call-1","call_id":"same","name":"lookup","arguments":"{}"}"#;
+        let first_output =
+            r#"{"type":"function_call_output","id":"output-1","call_id":"same","output":"first"}"#;
+        let last_call = r#"{"type":"function_call","id":"call-2","call_id":"same","name":"lookup","arguments":"{}"}"#;
+        let last_output = r#"{ "type":"function_call_output", "id":"output-2", "call_id":"same", "output":"last" }"#;
+        let mut history = SdkOriginalHistory::default();
+        for original in [first_call, first_output, last_call, last_output] {
+            history.append(SdkOriginalItem {
+                original: original.to_owned(),
+                projection: input_projection(original)
+                    .unwrap()
+                    .map(ResponseItemEnvelope::new),
+            });
+        }
+        let admitted = history.projection();
+        assert_eq!(admitted.len(), 4);
+        let removed = history.prepare_pop(&admitted, false).unwrap().unwrap();
+        assert_eq!(removed.item, last_output);
+        assert_eq!(removed.projection, admitted[..2]);
+        assert!(!removed.rebuilt_context);
+        assert_eq!(
+            removed.originals.snapshot(None).2,
+            [first_call, first_output, last_call]
+        );
+        let cold: SdkOriginalHistory =
+            serde_json::from_str(&serde_json::to_string(&removed.originals).unwrap()).unwrap();
+        assert_eq!(cold.projection(), admitted[..2]);
+        assert_eq!(cold.items.last().unwrap().original, last_call);
+        assert_eq!(history.projection(), admitted);
+    }
