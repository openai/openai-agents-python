+    fn rebuild_after_pop_omits_preexisting_unresolved_client_work() {
+        let user = r#"{"type":"message","id":"user-1","role":"user","content":[{"type":"input_text","text":"keep"}]}"#;
+        let orphan = r#"{"type":"function_call","id":"interrupted","call_id":"interrupted","name":"lookup","arguments":"{}"}"#;
+        let tail = r#"{"type":"message","id":"user-2","role":"user","content":[{"type":"input_text","text":"remove"}]}"#;
