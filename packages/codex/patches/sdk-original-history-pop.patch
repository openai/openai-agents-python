+// Legacy checkpoint decoding represents absent metadata as an empty metadata object.
+// All populated provenance, including retained-source revisions, must still match.
+fn same_admission_envelope(left: &ResponseItemEnvelope, right: &ResponseItemEnvelope) -> bool {
+    left.item == right.item
+        && left.metadata.clone().unwrap_or_default() == right.metadata.clone().unwrap_or_default()
+}
+
+fn resolved_projection(items: Vec<ResponseItemEnvelope>) -> Vec<ResponseItemEnvelope> {
+    let mut keep = vec![false; items.len()];
+    let mut pending = BTreeMap::new();
+    for (index, row) in items.iter().enumerate() {
+        match client_tool_pair_part(&row.item) {
+            None => keep[index] = true,
+            Some((family, Some(id), true)) => {
+                // A repeated call before its output leaves the pairing ambiguous.
+                pending
+                    .entry((family, id))
+                    .and_modify(|slot| *slot = None)
+                    .or_insert(Some(index));
+            }
+            Some((family, Some(id), false)) => {
+                if let Some(Some(call)) = pending.remove(&(family, id)) {
+                    keep[call] = true;
+                    keep[index] = true;
+                }
+            }
+            Some((_, None, _)) => {}
+        }
+    }
+    drop(pending);
+    items
+        .into_iter()
+        .zip(keep)
+        .filter_map(|(row, keep)| keep.then_some(row))
+        .collect()
+}
