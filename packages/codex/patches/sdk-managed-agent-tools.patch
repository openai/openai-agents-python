+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ManagedAgentToolSpec {
+    pub name: String,
+    pub role: String,
+    pub description: String,
+}
+
+/// Installed only in the authorized SDK thread's extension data.
+pub struct ManagedAgentToolCatalog(Vec<Arc<ManagedRoleTool>>);
+
+impl ManagedAgentToolCatalog {
+    pub fn new(declarations: Vec<ManagedAgentToolSpec>) -> Result<Self, String> {
+        let mut names = HashSet::new();
+        let mut tools = Vec::with_capacity(declarations.len());
+        for declaration in declarations {
+            AgentPath::root().join(&declaration.name)?;
+            AgentPath::root().join(&declaration.role)?;
+            if matches!(
+                declaration.name.as_str(),
+                "spawn_agent"
+                    | "wait_agent"
+                    | "send_message"
+                    | "followup_task"
+                    | "interrupt_agent"
+                    | "list_agents"
+                    | "close_agent"
+            ) || !names.insert(declaration.name.clone())
+            {
+                return Err(format!(
+                    "Duplicate or reserved managed agent tool {}",
+                    declaration.name
+                ));
+            }
+            if declaration.description.trim().is_empty() {
+                return Err(format!(
+                    "Managed agent tool {} needs a description",
+                    declaration.name
+                ));
+            }
+            let name = ToolName::new(Some("collaboration".to_owned()), declaration.name.clone());
+            let function = dynamic_tool_to_responses_api_tool(&DynamicToolFunctionSpec {
+                name: declaration.name,
+                description: declaration.description,
+                input_schema: serde_json::json!({
+                    "type": "object",
+                    "properties": { "input": { "type": "string" } },
+                    "required": ["input"],
+                    "additionalProperties": false,
+                }),
+                strict: true,
+                output_schema: None,
+                defer_loading: false,
+            })
+            .map_err(|error| error.to_string())?;
+            tools.push(Arc::new(ManagedRoleTool {
+                name,
+                role: declaration.role,
+                spec: ToolSpec::Namespace(ResponsesApiNamespace {
+                    name: "collaboration".to_owned(),
+                    description: default_namespace_description("collaboration"),
+                    tools: vec![ResponsesApiNamespaceTool::Function(function)],
+                }),
+            }));
+        }
+        Ok(Self(tools))
+    }
+}
+
+pub struct ManagedAgentToolContributor;
+
+impl ToolContributor for ManagedAgentToolContributor {
+    fn tools(
+        &self,
+        _: &ExtensionData,
+        thread_store: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        let Some(catalog) = thread_store.get::<ManagedAgentToolCatalog>() else {
+            return Vec::new();
+        };
+        catalog
+            .0
+            .iter()
+            .cloned()
+            .map(|tool| tool as Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>)
+            .collect()
+    }
+}
+
+struct ManagedRoleTool {
+    name: ToolName,
+    role: String,
+    spec: ToolSpec,
+}
+
+impl<'call> ToolExecutor<ToolCall<'call>> for ManagedRoleTool {
+    fn tool_name(&self) -> ToolName {
+        self.name.clone()
+    }
+
+    fn spec(&self) -> ToolSpec {
+        self.spec.clone()
+    }
+
+    fn managed_agent_role(&self) -> Option<&str> {
+        Some(&self.role)
+    }
+
+    fn supports_parallel_tool_calls(&self) -> bool {
+        true
+    }
+
+    fn handle<'a>(&'a self, _: ToolCall<'call>) -> ToolExecutorFuture<'a>
+    where
+        ToolCall<'call>: 'a,
+    {
+        Box::pin(async {
+            Err(FunctionCallError::Fatal(
+                "managed agent tool requires its native producing step".to_owned(),
+            ))
+        })
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ManagedToolInput {
+    input: String,
+}
+
+pub(crate) async fn run(
+    invocation: ToolInvocation,
+    role: &str,
+) -> Result<Box<dyn ToolOutput>, FunctionCallError> {
+    let ToolInvocation {
+        session,
+        step_context,
+        payload,
+        call_id,
+        ..
+    } = invocation;
+    let turn = &step_context.turn;
+    if turn.multi_agent_version != MultiAgentVersion::V2 {
+        return Err(FunctionCallError::RespondToModel(
+            "Managed agent tools require native multi-agent V2".to_owned(),
+        ));
+    }
+    let args: ManagedToolInput = parse_arguments(&function_arguments(payload)?)?;
+    if args.input.trim().is_empty() {
+        return Err(FunctionCallError::RespondToModel(
+            "Managed agent tool input must contain a message".to_owned(),
+        ));
+    }
+    let prepared = prepare_agent_spawn_config(
+        &session,
+        step_context.as_ref(),
+        SpawnConfigOptions {
+            version: SpawnConfigVersion::V2,
+            full_history_fork: false,
+            role_name: Some(role),
+            model: None,
+            reasoning_effort: None,
+        },
+    )
+    .await
+    .map_err(FunctionCallError::RespondToModel)?;
+    let task_name = format!("tool_{}", uuid::Uuid::now_v7().simple());
+    let source = thread_spawn_source(
+        session.thread_id,
+        &turn.session_source,
+        next_thread_spawn_depth(&turn.session_source),
+        prepared.role_name.as_deref(),
+        Some(task_name),
+    )?;
+    let agent_path = source.get_agent_path().ok_or_else(|| {
+        FunctionCallError::Fatal("managed child is missing its canonical agent path".to_owned())
+    })?;
+    let managed = session
+        .services
+        .agent_control
+        .spawn_managed_tool(SpawnRequest {
+            caller: session.thread_id,
+            config: prepared.config,
+            input: AgentInput::Message {
+                message: AgentMessage::Plaintext(args.input),
+                mode: MessageDeliveryMode::TriggerTurn,
+            },
+            source,
+            options: SpawnAgentOptions {
+                spawning_source: Some(AgentSpawnSource::from_step_context(Arc::clone(
+                    &step_context,
+                ))),
+                parent_thread_id: Some(session.thread_id),
+                parent_turn_id: Some(turn.sub_id.clone()),
+                root_turn_id: turn.turn_metadata_state.root_turn_id(),
+                turn_trigger: turn.turn_metadata_state.current_turn_trigger(),
+                environments: Some(step_context.environments.clone()),
+                cyber_access_program: turn.cyber_access_program,
+                ..Default::default()
+            },
+        })
+        .await
+        .map_err(collab_spawn_error)?;
+    let thread_id = managed.agent.thread_id;
+    let turn_id = managed.turn_id.clone();
+    super::emit_sub_agent_activity(
+        &session,
+        turn,
+        SubAgentActivityItem {
+            id: call_id,
+            agent_thread_id: thread_id,
+            agent_path,
+            kind: SubAgentActivityKind::Started,
+        },
+    )
+    .await;
+    let result = managed.wait().await.map_err(|_| {
+        FunctionCallError::Fatal("managed child did not deliver its terminal outcome".to_owned())
+    })?;
+    if result.thread_id != thread_id || result.turn_id != turn_id {
+        return Err(FunctionCallError::Fatal(
+            "managed child delivered an unrelated terminal outcome".to_owned(),
+        ));
+    }
+    let AgentStatus::Completed(message) = result.status else {
+        return Err(FunctionCallError::RespondToModel(
+            "Managed agent did not complete its turn".to_owned(),
+        ));
+    };
+    let text = match result.output.map(|output| output.final_output) {
+        Some(serde_json::Value::String(text)) => text,
+        Some(value) => value.to_string(),
+        None => message.unwrap_or_default(),
+    };
+    Ok(Box::new(FunctionToolOutput::from_text(text, Some(true))))
+}
