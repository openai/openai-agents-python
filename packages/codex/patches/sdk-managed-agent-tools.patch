+pub struct ManagedAgentTool {
+    pub agent: LiveAgent,
+    pub turn_id: String,
+    pub(crate) completion: oneshot::Receiver<ManagedAgentToolResult>,
+    pub(crate) retire_on_drop: DropGuard,
+}
+
+impl ManagedAgentTool {
+    pub async fn wait(self) -> Result<ManagedAgentToolResult> {
+        let result = self.completion.await.map_err(|_| {
+            CodexErr::Fatal("managed child ended without its terminal outcome".to_string())
+        })?;
+        self.retire_on_drop.disarm();
+        Ok(result)
+    }
+}
+
+pub struct ManagedAgentToolResult {
+    pub thread_id: ThreadId,
+    pub turn_id: String,
+    pub status: AgentStatus,
+    pub output: Option<ToolTurnCompletion>,
+}
+
+/// Ephemeral destination for the first turn admitted by a managed tool. The
+/// initializer is inherited, so retain the first turn's ID after consuming the reply.
+pub(crate) struct ManagedToolCompletion {
+    state: Mutex<ManagedToolCompletionState>,
+    pub(crate) abandonment: CancellationToken,
+    pub(crate) finished: CancellationToken,
+}
+
+struct ManagedToolCompletionState {
+    reply: Option<oneshot::Sender<ManagedAgentToolResult>>,
+    turn_id: Option<String>,
+}
+
+pub(crate) enum ManagedToolTerminal {
+    Reply(oneshot::Sender<ManagedAgentToolResult>),
+    AlreadyRouted,
+    Ordinary,
+}
+
+impl ManagedToolCompletion {
+    pub(crate) fn new(reply: oneshot::Sender<ManagedAgentToolResult>) -> Self {
+        Self {
+            state: Mutex::new(ManagedToolCompletionState {
+                reply: Some(reply),
+                turn_id: None,
+            }),
+            abandonment: CancellationToken::new(),
+            finished: CancellationToken::new(),
+        }
+    }
+
+    pub(crate) fn claim(&self, turn_id: &str) -> ManagedToolTerminal {
+        let mut state = self.state.lock().expect("managed tool completion lock");
+        match state.turn_id.as_deref() {
+            Some(owned) if owned == turn_id => ManagedToolTerminal::AlreadyRouted,
+            Some(_) => ManagedToolTerminal::Ordinary,
+            None => {
+                state.turn_id = Some(turn_id.to_owned());
+                self.finished.cancel();
+                ManagedToolTerminal::Reply(state.reply.take().expect("initial managed tool reply"))
+            }
+        }
+    }
+}
