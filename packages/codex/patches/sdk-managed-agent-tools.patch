+fn spawn_initial_input(
+    caller: ThreadId,
+    input: AgentInput,
+    source: &SessionSource,
+    completion: Option<crate::agent::api::ManagedToolCompletion>,
+) -> Result<SpawnInitialInput> {
+    match input {
+        AgentInput::UserInput(input) if completion.is_none() => {
+            Ok(SpawnInitialInput::UserInput(input))
+        }
+        AgentInput::UserInput(_) => Err(CodexErr::InvalidRequest(
+            "managed agent tools require an agent message".to_string(),
+        )),
+        AgentInput::Message { message, mode } => {
+            if mode != MessageDeliveryMode::TriggerTurn {
+                return Err(CodexErr::InvalidRequest(
+                    "spawn input must start the child turn".to_string(),
+                ));
+            }
+            let recipient = source.get_agent_path().ok_or_else(|| {
+                CodexErr::InvalidRequest(
+                    "spawned agent is missing a canonical task name".to_string(),
+                )
+            })?;
+            let author = recipient
+                .as_str()
+                .rsplit_once('/')
+                .and_then(|(parent, _)| AgentPath::try_from(parent).ok())
+                .ok_or_else(|| {
+                    CodexErr::InvalidRequest("spawn input needs a child path".to_string())
+                })?;
+            Ok(SpawnInitialInput::InterAgentCommunication(
+                message.into_communication(author, recipient, mode),
+                AgentCommunicationContext::new(AgentCommunicationKind::Spawn, caller),
+                completion,
+            ))
+        }
+    }
+}
