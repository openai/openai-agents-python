+            assert!(
+                observation
+                    .configuration
+                    .as_ref()
+                    .unwrap()
+                    .is_detached_response()
+            );
+            assert!(
+                observation
+                    .configuration
+                    .as_ref()
+                    .unwrap()
+                    .allows_detached_function(id)
+            );
+            assert!(!configuration.response_create_pending());
+            assert!(configuration.response_is_detached(id));
+            let event = observer.observe_frame(&json!({"type":"response.output_item.done","response_id":id,
+                "item":{"id":format!("item_{id}"),"type":"function_call","call_id":format!("call_{id}"),
+                "name":id,"arguments":"{}"}}).to_string(), true);
+            assert!(event.out_of_band);
+            assert!(!configuration.response_tools_pending(id));
+        }
+        {
+            let state = configuration.inner.state.lock().unwrap();
+            assert_eq!(
+                state.active_response.as_ref().unwrap().id.as_ref(),
+                "default"
+            );
+            assert_eq!(state.latest_response_id.as_deref(), Some("default"));
+            assert_eq!(state.active_detached_responses.len(), 2);
+        }
+        let done = observer.observe_frame(
+            r#"{"type":"response.done","response":{"id":"detached_b"}}"#,
+            true,
+        );
+        assert!(done.out_of_band);
+        assert!(!default_guard.is_retired());
+        {
+            let state = configuration.inner.state.lock().unwrap();
+            assert!(state.active_detached_responses.contains("detached_a"));
+            assert!(!state.active_detached_responses.contains("detached_b"));
+            assert_eq!(
+                state.active_response.as_ref().unwrap().id.as_ref(),
+                "default"
+            );
+        }
+        let default_event = observer.observe_frame(
+            r#"{"type":"response.output_text.delta","response_id":"default","delta":"hello"}"#,
+            true,
+        );
+        assert!(!default_event.out_of_band);
+        assert!(!default_event.configuration.unwrap().is_detached_response());
+        observer.observe_frame(
+            r#"{"type":"response.done","response":{"id":"default"}}"#,
+            true,
+        );
+        assert!(
+            configuration
+                .inner
+                .state
+                .lock()
+                .unwrap()
+                .active_response
+                .is_none()
+        );
+        assert!(
+            configuration
+                .inner
+                .state
+                .lock()
+                .unwrap()
+                .active_detached_responses
+                .contains("detached_a")
+        );
+    }
