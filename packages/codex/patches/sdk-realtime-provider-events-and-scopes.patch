+        let (connection, send, server) = readiness_connection(json!({}), false).await;
+        send.send(json!({"type":"session.created","session":{"id":"session"}}))
+            .await
+            .unwrap();
+        connection.wait_ready().await.unwrap();
+        send.send(json!({"type":"response.created","response":{"id":"default","conversation_id":"conv_default"}})).await.unwrap();
+        let item = json!({"id":"queued-item","type":"function_call","call_id":"queued-call",
+            "name":"native_function","arguments":"{}"});
+        send.send(json!({"type":"conversation.item.added","response_id":"default","item":item}))
+            .await
+            .unwrap();
+        loop {
+            let event = tokio::time::timeout(Duration::from_secs(1), connection.next_event())
+                .await
+                .unwrap()
+                .unwrap()
+                .unwrap();
+            if matches!(event, RealtimeEvent::ConversationItemAdded { .. }) {
+                break;
+            }
+        }
+        let writer = connection.writer();
+        let guard = writer
+            .configuration()
+            .unwrap()
+            .response_output_guard("default")
+            .unwrap();
+        writer
+            .interrupt_response(Some("default".into()), None, None, None)
+            .await
+            .unwrap();
+        assert!(guard.is_retired());
+        let mut effects =
+            vec![json!({"type":"response.output_item.done","response_id":"default","item":item})];
+        for (id, name) in [
+            ("late-handoff", "background_agent"),
+            ("late-noop", "remain_silent"),
+        ] {
+            effects.push(
+                json!({"type":"response.output_item.done","response_id":"default",
+                "item":{"id":id,"type":"function_call","call_id":id,"name":name,"arguments":"{}"}}),
+            );
+        }
+        for event in &effects {
+            send.send(event.clone()).await.unwrap();
+        }
+        send.send(json!({"type":"input_audio_buffer.speech_started","item_id":"barrier"}))
+            .await
+            .unwrap();
+        let events = connection.events();
+        let mut raw_effects = 0;
+        loop {
+            let (event, _) = tokio::time::timeout(
+                Duration::from_secs(1),
+                events.next_event_with_provider_observations(
+                    codex_protocol::protocol::RealtimeProviderEventObservation::All,
+                ),
+            )
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+            match event {
+                RealtimeEvent::RawProviderEvent(raw) if effects.contains(&raw.event) => {
+                    raw_effects += 1
+                }
+                RealtimeEvent::FunctionCallRequested(_)
+                | RealtimeEvent::HandoffRequested(_)
+                | RealtimeEvent::NoopRequested(_)
+                | RealtimeEvent::DetachedFunctionCall(_) => {
+                    panic!("retired response acquired tool authority")
+                }
+                RealtimeEvent::InputAudioSpeechStarted(_) => break,
+                _ => {}
+            }
+        }
+        assert_eq!(raw_effects, 3);
+        writer.abort_and_join().await;
+        server.abort();
+        let _ = server.await;
+    }
