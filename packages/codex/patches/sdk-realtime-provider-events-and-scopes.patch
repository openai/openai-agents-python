+pub(crate) async fn capture_voice_agent_source(
+    session: &Arc<Session>,
+    generation: &str,
+    expected: Option<&codex_extension_api::AgentProfileReceipt>,
+    target: Arc<codex_extension_api::AgentProfile>,
+) -> codex_protocol::error::Result<codex_extension_api::AgentProfileReceipt> {
+    capture_voice_handoff_source(session, generation, expected, target)
+        .await?
+        .ok_or_else(|| CodexErr::InvalidRequest("Voice Agent source changed during capture".into()))
+}
+
+/// A stale issuing handoff is a scoped refusal, not a failure of newer voice work.
+pub(crate) async fn capture_voice_handoff_source(
+    session: &Arc<Session>,
+    generation: &str,
+    expected: Option<&codex_extension_api::AgentProfileReceipt>,
+    target: Arc<codex_extension_api::AgentProfile>,
+) -> codex_protocol::error::Result<Option<codex_extension_api::AgentProfileReceipt>> {
+    session.validate_voice_agent_profile(&target)?;
+    let accepted = accepted_voice_configuration(session, generation).await?;
+    if accepted.profile_receipt() != expected {
+        return Ok(None);
+    }
+    let registry = session
+        .services
+        .thread_extension_data
+        .get_or_init(VoiceProfileSources::default);
+    if registry.sources.lock().unwrap().len() >= 1024 {
+        return Err(CodexErr::InvalidRequest(
+            "Voice Agent source capacity exceeded".into(),
+        ));
+    }
+    let receipt = codex_extension_api::AgentProfileReceipt {
+        profile_id: target.profile_id.clone(),
+        epoch: registry
+            .next_epoch
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |epoch| {
+                epoch.checked_add(1)
+            })
+            .map_err(|_| CodexErr::InvalidRequest("Voice Agent epoch exhausted".into()))?
+            + 1,
+    };
+    let mut target = target.as_ref().clone();
+    let controls = target.model.request_controls.clone();
+    target.data.insert(VoiceProfileScope {
+        generation: generation.to_owned(),
+    });
+    let profile = Arc::new(codex_extension_api::CapturedAgentProfile {
+        receipt: receipt.clone(),
+        profile: Arc::new(target),
+    });
+    let inputs = session
+        .capture_realtime_source_inputs()
+        .await?
+        .with_voice_profile(profile);
+    let settings = inputs.resolve_settings(session).await?;
+    controls
+        .validate_profile(&settings.model_info)
+        .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+    let captured = capture_declarations(session, &inputs, None, None)?;
+    let source = finish_realtime_native_source(
+        session,
+        RealtimeSourceDraft {
+            inputs,
+            settings,
+            captured,
+            voice_expected: Some(expected.cloned()),
+        },
+    )
+    .await?;
+    if accepted_voice_configuration(session, generation)
+        .await?
+        .profile_receipt()
+        != expected
+    {
+        return Ok(None);
+    }
+    let mut sources = registry.sources.lock().unwrap();
+    if sources.len() >= 1024 {
+        return Err(CodexErr::InvalidRequest(
+            "Voice Agent source capacity exceeded".into(),
+        ));
+    }
+    sources.insert(
+        (
+            generation.to_owned(),
+            receipt.profile_id.clone(),
+            receipt.epoch,
+        ),
+        source,
+    );
+    Ok(Some(receipt))
+}
