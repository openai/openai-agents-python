+pub(super) fn response_tools_json(tools: &[RealtimeResponseTool]) -> serde_json::Result<Value> {
+    let mut names = std::collections::HashSet::new();
+    let mut hosted = Vec::new();
+    for tool in tools {
+        match tool {
+            RealtimeResponseTool::Function(tool) => {
+                if tool.name.is_empty()
+                    || tool.name.len() > 128
+                    || !tool.parameters.is_object()
+                    || !names.insert(tool.name.as_str())
+                {
+                    return Err(serde::ser::Error::custom(
+                        "Invalid Realtime response function declaration",
+                    ));
+                }
+            }
+            RealtimeResponseTool::Mcp(tool) => hosted.push(tool.clone()),
+        }
+    }
+    tools_json_with_reserved(&[], &hosted, false)?;
+    let value = serde_json::to_value(tools)?;
+    if tools.len() > 128 || serde_json::to_vec(&value)?.len() > 1024 * 1024 {
