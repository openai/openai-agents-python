+    fn parallel_detached_responses_preserve_default_owner_and_exact_terminal_scope() {
+        let observer = accepted_hosted_observer();
+        let configuration = observer.configuration();
+        created(&observer, "default");
+        let default_guard = configuration.response_output_guard("default").unwrap();
+        for id in ["detached_a", "detached_b"] {
