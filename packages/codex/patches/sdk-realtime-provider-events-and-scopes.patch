+
+pub(crate) fn release_voice_agent_sources(session: &Arc<Session>, generation: &str) {
+    if let Some(registry) = session
+        .services
+        .thread_extension_data
+        .get::<VoiceProfileSources>()
+    {
+        registry
+            .sources
+            .lock()
+            .unwrap()
+            .retain(|(owner, _, _), _| owner != generation);
+    }
+}
