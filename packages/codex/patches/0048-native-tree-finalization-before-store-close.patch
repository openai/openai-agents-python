+#[tokio::test]
+async fn tree_shutdown_preserves_sibling_completion_activity_with_full_parent_queue() {
+    let harness = AgentControlHarness::new().await;
+    let (parent_id, original_parent) = harness.start_thread().await;
+    let runtime = original_parent.session.services.local_agent_runtime.clone();
+    let control = runtime.control(Default::default());
