+
+#[tokio::test]
+async fn writer_shutdown_joins_tasks_without_waiting_for_session_membership() {
+    let runtime = LocalAgentRuntime::new(Weak::default(), default_thread_id_generator(), None);
+    let session = runtime.admit_start().expect("session admitted");
+    let task = runtime.admit_task().expect("task admitted");
+    let shutdown = runtime.request_shutdown();
+    assert!(
+        runtime.admit_task().is_none(),
+        "tree fence rejects later tasks"
+    );
+    let writers = runtime.wait_for_tasks_before_writer_shutdown();
+    futures::pin_mut!(writers);
+    assert!(futures::poll!(writers.as_mut()).is_pending());
+    drop(task);
+    writers.await;
+    // The live session still owns its writer. Waiting for sessions here would deadlock.
+    let sessions = shutdown.wait();
+    futures::pin_mut!(sessions);
+    assert!(futures::poll!(sessions.as_mut()).is_pending());
+    drop(session);
+    sessions
+        .await
+        .expect("session teardown finishes separately");
+}
