+    /// Owns the whole task future, including terminal delivery after its active slot is cleared.
+    pub(crate) fn admit_task(&self) -> Option<TaskTrackerToken> {
+        if self.shutdown_state.tasks.is_closed() || self.shutdown.is_cancelled() {
+            return None;
+        }
+        let task = self.shutdown_state.tasks.token();
+        // TaskTracker tokens can be created after close. A racing registration must either
+        // retain the barrier before it closes or refuse to start any task afterward.
+        if self.shutdown_state.tasks.is_closed() || self.shutdown.is_cancelled() {
+            return None;
+        }
+        Some(task)
+    }
