+    // Replace only the loaded parent's SQ. Retain its real sender so the actual session
+    // loop stays alive and can exercise tree shutdown while this bounded fixture stays full.
+    let registered = state
+        .threads
+        .write()
+        .await
+        .remove(&parent_id)
+        .expect("registered parent");
+    drop(original_parent);
+    let mut parent = match Arc::try_unwrap(registered) {
+        Ok(parent) => parent,
+        Err(_) => panic!("fixture parent unexpectedly shared"),
+    };
+    let (tx_sub, _rx_sub) = async_channel::bounded(1);
+    let _original_sender = std::mem::replace(&mut parent.io.tx_sub, tx_sub.clone());
+    tx_sub
+        .try_send(crate::session::Submission {
+            id: "fill-parent-queue".to_owned(),
+            op: Op::ReloadUserConfig,
+            trace: None,
+            turn_extension_init: None,
+            parent_turn_id: None,
+            root_turn_id: None,
+            residency_guard: None,
+        })
+        .expect("fill parent queue");
+    let parent = Arc::new(parent);
+    state
+        .threads
+        .write()
+        .await
+        .insert(parent_id, parent.clone());
+    let first_token = runtime
+        .admit_task()
+        .expect("first child finalizer admitted");
+    let second_token = runtime
+        .admit_task()
+        .expect("second child finalizer admitted");
+    let outcome = |turn: &str| crate::agent::api::AgentTurnOutcome {
+        thread_id: ThreadId::new(),
+        turn_id: turn.to_owned(),
+        source: SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id: parent_id,
+            depth: 1,
+            agent_path: Some(AgentPath::try_from(format!("/root/{turn}")).expect("child path")),
+            agent_nickname: None,
+            agent_role: None,
+        }),
+        parent_turn_id: Some("parent-turn".to_owned()),
+        initiating_agent_path: None,
+        status: AgentStatus::Completed(Some("finished".to_owned())),
+        error_info: None,
+    };
+    let first = outcome("first");
+    let first_control = control.clone();
+    let first_delivery = tokio::spawn(async move {
+        let _task = first_token;
+        first_control
+            .notify_parent_of_terminal_turn(
+                first,
+                &codex_rollout_trace::ThreadTraceContext::disabled(),
+            )
+            .await;
+    });
+    // Observing the real completion event proves its canonical append preceded the
+    // queue-only notification. The notification then parks on the full parent SQ.
+    timeout(Duration::from_secs(5), async {
+        loop {
+            if let EventMsg::ItemCompleted(event) =
+                parent.next_event().await.expect("parent event").msg
+                && event.item.id() == "subagent-completed-first"
+            {
+                break;
+            }
+        }
+    })
+    .await
+    .expect("first activity persisted");
+    assert!(
+        !first_delivery.is_finished(),
+        "full queue must park notification"
+    );
+    runtime.request_shutdown();
+    timeout(Duration::from_secs(5), first_delivery)
+        .await
+        .expect("cancellation releases queued notification")
+        .expect("first finalizer");
+    // The first rejected notification must not evict the still-live parent from the
+    // manager. Its writer remains available for the independently finishing sibling.
+    assert!(
+        state.get_thread(parent_id).await.is_ok(),
+        "parent retained during finalizers"
+    );
+    {
+        let _task = second_token;
+        control
+            .notify_parent_of_terminal_turn(
+                outcome("second"),
+                &codex_rollout_trace::ThreadTraceContext::disabled(),
+            )
+            .await;
+    }
+    timeout(
+        Duration::from_secs(5),
+        parent.io.session_loop_termination.clone(),
+    )
+    .await
+    .expect("writer shutdown after both finalizers");
+    let (history, _, parse_errors) = codex_rollout::RolloutRecorder::load_rollout_items(
+        &parent.rollout_path().expect("local parent rollout"),
+    )
+    .await
+    .expect("read canonical history after writer close");
+    assert_eq!(parse_errors, 0, "canonical history parses cleanly");
+    for turn in ["first", "second"] {
+        let id = format!("subagent-completed-{turn}");
+        assert_eq!(history.iter().filter(|item| matches!(item,
+            RolloutItem::EventMsg(EventMsg::ItemCompleted(event))
+                if matches!(&event.item, TurnItem::SubAgentActivity(activity)
+                    if activity.id == id && activity.kind == codex_protocol::protocol::SubAgentActivityKind::Completed)
+        )).count(), 1, "one durable sibling completion after close: {turn}");
+    }
+}
