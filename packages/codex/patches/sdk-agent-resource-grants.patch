+#[derive(Default)]
+struct AgentLifecycleStarted(tokio::sync::Mutex<Option<Option<AgentProfileReceipt>>>);
+
+impl Session {
+    pub(crate) async fn start_agent_activity(
+        &self,
+        context: &Arc<TurnContext>,
+        cancellation: &CancellationToken,
+    ) -> CodexResult<()> {
+        {
+            let active = self.active_turn.lock().or_cancel(cancellation).await?;
+            if !active
+                .as_ref()
+                .and_then(|turn| turn.task.as_ref())
+                .is_some_and(|task| {
+                    task.kind == crate::state::TaskKind::Regular
+                        && Arc::ptr_eq(&task.turn_context, context)
+                        && !task.cancellation_token.is_cancelled()
+                })
+            {
+                return Ok(());
+            }
+        }
+        let selected = context.next_step_settings.load_full();
+        let source = selected.agent_profile.as_deref();
+        let receipt = source.map(|profile| profile.receipt.clone());
+        let owner = context
+            .extension_data
+            .get_or_init(AgentLifecycleStarted::default);
+        // Serialize only this turn's notification, without holding history or profile locks.
+        let mut started = owner.0.lock().or_cancel(cancellation).await?;
+        if started.as_ref() == Some(&receipt) {
+            return Ok(());
+        }
+        self.notify_agent_activity(context, source, None, cancellation)
+            .await?;
+        if context
+            .next_step_settings
+            .load_full()
+            .agent_profile
+            .as_ref()
+            .map(|current| &current.receipt)
+            != receipt.as_ref()
+        {
+            return Err(invalid("Agent lifecycle source changed during start"));
+        }
+        if cancellation.is_cancelled() {
+            return Err(CodexErr::TurnAborted);
+        }
+        *started = Some(receipt);
+        Ok(())
+    }
+
+    async fn notify_agent_activity(
+        &self,
+        context: &Arc<TurnContext>,
+        source: Option<&CapturedAgentProfile>,
+        target_profile_id: Option<&str>,
+        cancellation: &CancellationToken,
+    ) -> CodexResult<()> {
+        for contributor in self.services.extensions.turn_lifecycle_contributors() {
+            let result = contributor
+                .before_agent_lifecycle(codex_extension_api::AgentLifecycleInput {
+                    turn_id: &context.sub_id,
+                    cancellation,
+                    source,
+                    target_profile_id,
+                    session_store: &self.services.session_extension_data,
+                    thread_store: &self.services.thread_extension_data,
+                    turn_store: &context.extension_data,
+                })
+                .await;
+            if cancellation.is_cancelled() {
+                return Err(CodexErr::TurnAborted);
+            }
+            result.map_err(invalid)?;
+        }
+        Ok(())
+    }
+}
