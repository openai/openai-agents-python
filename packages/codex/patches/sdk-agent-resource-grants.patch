+    async fn agent_profile_environment_switch_and_restore_share_the_profile_fence() {
+        let (mut session, context) = make_session_and_context().await;
+        attach_thread_persistence(&mut session).await;
+        let workspace = tempfile::tempdir().unwrap();
+        let root = codex_utils_absolute_path::AbsolutePathBuf::try_from(workspace.path()).unwrap();
+        let initial = session.services.turn_environments.selections()[0].clone();
+        let mut config = session
+            .state
+            .lock()
+            .await
+            .session_configuration
+            .inferred_environment_config();
+        let destination = codex_utils_path_uri::PathUri::from_abs_path(&root);
+        config.workspace_roots = vec![destination.clone()];
+        let selection = codex_protocol::protocol::TurnEnvironmentSelection {
+            environment_id: initial.environment_id.clone(),
+            cwd: destination.clone(),
+            workspace_roots: vec![destination.clone()],
+            config: EnvironmentConfigState::Ready(config),
+        };
+        let a = session
+            .activate_agent_profile(None, profile(&context, "a", "resource-a"))
+            .await
+            .unwrap();
+        let mut b = profile(&context, "b", "resource-b").as_ref().clone();
+        b.data
+            .insert(AgentProfileEnvironment(Some(selection.clone()), true));
+        let b = Arc::new(b);
+        let mut unavailable = b.as_ref().clone();
+        let mut invalid_selection = selection.clone();
+        invalid_selection.environment_id = "unregistered-profile-environment".into();
+        unavailable
+            .data
+            .insert(AgentProfileEnvironment(Some(invalid_selection), true));
+        assert!(
+            session
+                .activate_agent_profile(Some(a.clone()), Arc::new(unavailable))
+                .await
+                .is_err()
+        );
+        assert_eq!(
+            session.agent_profile_receipt().await.unwrap(),
+            Some(a.clone())
+        );
+        assert_eq!(
+            session.services.turn_environments.selections(),
+            vec![initial.clone()]
+        );
+
+        let b_receipt = session
+            .activate_agent_profile(Some(a), Arc::clone(&b))
+            .await
+            .unwrap();
+        let snapshot = session.services.turn_environments.snapshot().await;
+        assert_eq!(snapshot.primary().unwrap().selection.cwd, destination);
+        assert_eq!(
+            session.configured_environment_selections().await,
+            vec![selection.clone()]
+        );
+        assert!(
+            session
+                .state
+                .lock()
+                .await
+                .session_configuration
+                .agent_profile
+                .as_ref()
+                .unwrap()
+                .profile
+                .data
+                .get::<AgentProfileEnvironment>()
+                .unwrap()
+                .requires_process_identity()
+        );
+        assert_eq!(
+            session.agent_profile_receipt().await.unwrap(),
+            Some(b_receipt.clone())
+        );
+
+        // Reopening a bound Agent reselects from the current host graph. History
+        // supplies the Agent receipt and never provides the environment grant.
+        {
+            let mut state = session.state.lock().await;
+            state.session_configuration.agent_profile = None;
+            state.session_configuration.environments = vec![initial.clone()];
+        }
+        session
+            .services
+            .turn_environments
+            .update_selections(&[initial]);
+        assert_eq!(
+            session.activate_agent_profile(None, b).await.unwrap(),
+            b_receipt
+        );
+        assert_eq!(
+            session.configured_environment_selections().await,
+            vec![selection]
+        );
+        assert!(
+            session
+                .state
+                .lock()
+                .await
+                .session_configuration
+                .agent_profile
+                .as_ref()
+                .unwrap()
+                .profile
+                .data
+                .get::<AgentProfileEnvironment>()
+                .unwrap()
+                .requires_process_identity()
+        );
+        assert_eq!(
+            session
+                .services
+                .turn_environments
+                .snapshot()
+                .await
+                .primary()
+                .unwrap()
+                .selection
+                .cwd,
+            destination
+        );
+
+        let mut model_only = profile(&context, "model-only", "no-workspace")
+            .as_ref()
+            .clone();
+        model_only.data.insert(AgentProfileEnvironment(None, false));
+        session
+            .activate_agent_profile(Some(b_receipt), Arc::new(model_only))
+            .await
+            .unwrap();
+        assert!(session.configured_environment_selections().await.is_empty());
+        assert!(
+            session
+                .services
+                .turn_environments
+                .snapshot()
+                .await
+                .primary()
+                .is_none()
+        );
+    }
