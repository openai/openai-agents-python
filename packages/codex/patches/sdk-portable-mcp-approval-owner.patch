+    /// Atomically park exactly one live question, retaining its private identity.
+    pub(crate) fn claim_only_elicitation(
+        &mut self,
+        server: &str,
+        id: &RequestId,
+        identity: &Arc<String>,
+    ) -> Option<ElicitationClaim> {
+        if !self.pending_approvals.is_empty()
+            || !self.pending_request_permissions.is_empty()
+            || !self.pending_user_input.is_empty()
+            || !self.pending_dynamic_tools.is_empty()
+            || self.pending_elicitations.len() != 1
+            || self
+                .claimed_elicitations
+                .values()
+                .any(|marker| marker.strong_count() != 0)
+        {
+            return None;
+        }
+        let key = (server.to_owned(), id.clone());
+        let entry = self.pending_elicitations.get(&key)?;
+        if entry.sender.is_closed() || !Arc::ptr_eq(&entry.identity, identity) {
+            return None;
+        }
+        let marker = Arc::new(ElicitationClaimIdentity {
+            identity: Arc::clone(identity),
+        });
+        let entry = self.pending_elicitations.remove(&key)?;
+        self.claimed_elicitations
+            .insert(key.clone(), Arc::downgrade(&marker));
+        Some(ElicitationClaim { marker, entry, key })
+    }
+
+    /// Rollback never replaces a newer request or revives a finished receiver.
+    pub(crate) fn restore_elicitation_claim(&mut self, claim: ElicitationClaim) -> bool {
+        if claim.entry.sender.is_closed()
+            || self.pending_elicitations.contains_key(&claim.key)
+            || !self
+                .claimed_elicitations
+                .get(&claim.key)
+                .and_then(std::sync::Weak::upgrade)
+                .is_some_and(|marker| Arc::ptr_eq(&marker, &claim.marker))
+        {
+            return false;
+        }
+        self.claimed_elicitations.remove(&claim.key);
+        self.pending_elicitations.insert(claim.key, claim.entry);
+        true
+    }
