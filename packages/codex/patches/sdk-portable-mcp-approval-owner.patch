+#[cfg(test)]
+mod mcp_checkpoint_data_tests {
+    use super::*;
+
+    fn data() -> McpApprovalCheckpointData {
+        let token = uuid::Uuid::now_v7().to_string();
+        McpApprovalCheckpointData {
+            source_thread_id: codex_protocol::ThreadId::new(),
+            turn_id: "turn".into(),
+            call_id: "call".into(),
+            request_id: "mcp_tool_call_approval_call".into(),
+            receipt: format!("sdk-question:{token}"),
+            token,
+            version: 1,
+            server_name: "docs".into(),
+            tool_name: "find-record".into(),
+            callable_namespace: "mcp__docs".into(),
+            callable_name: "reviewed".into(),
+            declaration_sha256: "0".repeat(64),
+            arguments: Some(serde_json::json!({"key": "A"})),
+        }
+    }
+
+    #[test]
+    fn canonical_mcp_match_rejects_raw_name_substitution_and_changed_arguments() {
+        let saved = data();
+        let value = serde_json::json!({"type":"function_call", "call_id":"call",
+            "namespace":"mcp__docs", "name":"reviewed", "arguments":" { \"key\": \"A\" } "});
+        let call: codex_protocol::models::ResponseItem =
+            serde_json::from_value(value.clone()).unwrap();
+        assert!(saved.matches_canonical_call(&call));
+        for (field, changed) in [
+            ("name", serde_json::json!("find-record")),
+            ("namespace", serde_json::json!("mcp__other")),
+            ("arguments", serde_json::json!("{\"key\":\"B\"}")),
+            ("asynchronous", serde_json::json!(true)),
+            ("encrypted_function_args", serde_json::json!([])),
+        ] {
+            let mut changed_call = value.clone();
+            changed_call[field] = changed;
+            let changed_call = serde_json::from_value(changed_call).unwrap();
+            assert!(!saved.matches_canonical_call(&changed_call));
+        }
+        let codex_protocol::models::ResponseItem::FunctionCall { arguments, .. } = call else {
+            panic!("call");
+        };
+        assert_eq!(arguments, " { \"key\": \"A\" } ");
+    }
+
+    #[test]
+    fn checkpoint_data_does_not_accept_descriptor_or_connection_fields() {
+        let mut value = serde_json::to_value(data()).unwrap();
+        value["tool"] =
+            serde_json::json!({"server_origin":"https://user:synthetic-secret@example.invalid"});
+        assert!(serde_json::from_value::<McpApprovalCheckpointData>(value).is_err());
+        let mut value = serde_json::to_value(data()).unwrap();
+        value["config"] = serde_json::json!({"authorization":"synthetic-secret"});
+        assert!(serde_json::from_value::<McpApprovalCheckpointData>(value).is_err());
+    }
+
+    #[test]
+    fn checkpoint_arguments_leave_room_for_the_portable_frame_envelope() {
+        let mut saved = data();
+        let mut nested = serde_json::Value::Null;
+        for _ in 0..70 {
+            nested = serde_json::json!([nested]);
+        }
+        saved.arguments = Some(nested);
+        assert!(saved.validate_bounds().is_err());
+        assert!(data().validate_bounds().is_ok());
+    }
+
+    #[test]
+    fn oversized_checkpoint_data_fails_without_echoing_untrusted_content() {
+        let private = "SYNTHETIC_PRIVATE_DESCRIPTOR".repeat(MAX_MCP_APPROVAL_CHECKPOINT_BYTES);
+        let error = bounded_checkpoint_json(&private)
+            .err()
+            .expect("bounded rejection");
+        assert!(!error.to_string().contains("SYNTHETIC_PRIVATE_DESCRIPTOR"));
+        assert!(bounded_checkpoint_json(&data()).is_ok());
+    }
+}
