+/// Checkpoint data only. Deserializing it cannot recreate a native question grant.
+#[derive(Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct McpApprovalCheckpointData {
+    pub source_thread_id: codex_protocol::ThreadId,
+    pub turn_id: String,
+    pub call_id: String,
+    pub request_id: String,
+    pub receipt: String,
+    pub token: String,
+    pub version: u32,
+    pub server_name: String,
+    pub tool_name: String,
+    pub callable_namespace: String,
+    pub callable_name: String,
+    pub declaration_sha256: String,
+    pub arguments: Option<serde_json::Value>,
+}
+
+/// The original question and prepared call stay live until sealing is implemented.
+/// Neither this capture nor validation settles, suspends, or restores the call.
+#[derive(Clone)]
+pub struct CapturedMcpApproval {
+    question: OwnedQuestion,
+    call: codex_mcp::PreparedMcpCall,
+    data: McpApprovalCheckpointData,
+}
+
+const MAX_MCP_APPROVAL_CHECKPOINT_BYTES: usize = 65_536;
+
+fn bounded_checkpoint_json<T: serde::Serialize>(value: &T) -> anyhow::Result<Vec<u8>> {
+    struct Buffer(Vec<u8>);
+    impl std::io::Write for Buffer {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            if bytes.len() > MAX_MCP_APPROVAL_CHECKPOINT_BYTES.saturating_sub(self.0.len()) {
+                return Err(std::io::Error::other(
+                    "MCP approval checkpoint limit exceeded",
+                ));
+            }
+            self.0.extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut buffer = Buffer(Vec::new());
+    serde_json::to_writer(&mut buffer, value)
+        .map_err(|_| anyhow::anyhow!("MCP approval checkpoint data exceeds its supported bound"))?;
+    Ok(buffer.0)
+}
+
+fn mcp_approval_declaration_fingerprint(
+    call: &codex_mcp::PreparedMcpCall,
+) -> anyhow::Result<String> {
+    use sha2::{Digest, Sha256};
+    let registration = call
+        .config()
+        .mcp_server_catalog
+        .server(call.server_name())
+        .ok_or_else(|| anyhow::anyhow!("MCP approval requires a current server declaration"))?;
+    let config = registration.config();
+    let codex_config::McpServerTransportConfig::StreamableHttp {
+        url,
+        bearer_token_env_var,
+        http_headers,
+        env_http_headers,
+        http_headers_helper,
+    } = &config.transport
+    else {
+        anyhow::bail!("MCP approval checkpoint requires an ordinary host HTTP declaration");
+    };
+    anyhow::ensure!(
+        config.is_local_environment()
+            && call.server_environment_id() == codex_config::DEFAULT_MCP_SERVER_ENVIRONMENT_ID
+            && !call.is_host_owned_apps()
+            && !call.is_selected_plugin_server()
+            && bearer_token_env_var.is_none()
+            && http_headers.as_ref().is_none_or(|v| v.is_empty())
+            && env_http_headers.as_ref().is_none_or(|v| v.is_empty())
+            && http_headers_helper.is_none()
+            && config.oauth.is_none()
+            && config.oauth_resource.is_none()
+            && config.scopes.is_none(),
+        "MCP approval checkpoint cannot prove this declaration's credential or environment identity"
+    );
+    let endpoint = url::Url::parse(url)
+        .map_err(|_| anyhow::anyhow!("MCP approval checkpoint endpoint is unsupported"))?;
+    anyhow::ensure!(
+        matches!(endpoint.scheme(), "http" | "https")
+            && endpoint.has_host()
+            && endpoint.username().is_empty()
+            && endpoint.password().is_none()
+            && endpoint.query().is_none()
+            && endpoint.fragment().is_none(),
+        "MCP approval checkpoint endpoint is unsupported"
+    );
+    let tool = call.tool_info();
+    let encoded = bounded_checkpoint_json(&(
+        1u32,
+        call.server_name(),
+        endpoint.as_str(),
+        &config.auth,
+        call.server_environment_id(),
+        call.permission_profile(),
+        call.config().approval_policy.value(),
+        call.config().approvals_reviewer,
+        call.tool_approval_mode(),
+        config.tool_timeout_sec,
+        call.output_token_limit(),
+        &tool.callable_namespace,
+        &tool.callable_name,
+        &(
+            &tool.tool,
+            tool.supports_parallel_tool_calls,
+            &tool.namespace_description,
+            &tool.openai_file_input_optional_fields,
+            &tool.connector_id,
+            &tool.connector_name,
+            &tool.plugin_display_names,
+        ),
+    ))?;
+    let mut canonical: serde_json::Value = serde_json::from_slice(&encoded)
+        .map_err(|_| anyhow::anyhow!("MCP approval declaration could not be fingerprinted"))?;
+    canonical.sort_all_objects();
+    let digest = Sha256::digest(bounded_checkpoint_json(&canonical)?);
+    Ok(digest.iter().map(|byte| format!("{byte:02x}")).collect())
+}
