+/// Current declaration preparation only; no old receipt or token can settle it.
+#[derive(Clone)]
+pub struct PreparedMcpApproval {
+    pub(crate) destination_thread_id: codex_protocol::ThreadId,
+    pub(crate) call: codex_mcp::PreparedMcpCall,
+    pub(crate) source: McpApprovalCheckpointData,
+}
+
+impl McpApprovalCheckpointData {
+    fn validate_bounds(&self) -> anyhow::Result<()> {
+        bounded_checkpoint_json(self)?;
+        fn supported(value: &serde_json::Value, depth: usize) -> bool {
+            depth <= 64
+                && match value {
+                    serde_json::Value::Array(values) => {
+                        values.iter().all(|value| supported(value, depth + 1))
+                    }
+                    serde_json::Value::Object(values) => {
+                        values.values().all(|value| supported(value, depth + 1))
+                    }
+                    _ => true,
+                }
+        }
+        anyhow::ensure!(
+            self.arguments
+                .as_ref()
+                .is_none_or(|value| supported(value, 0)),
+            "MCP approval checkpoint arguments exceed their supported nesting bound"
+        );
+        Ok(())
+    }
+
+    /// Match the retained canonical call without rewriting its argument bytes.
+    pub fn matches_canonical_call(&self, item: &codex_protocol::models::ResponseItem) -> bool {
+        crate::mcp_approval_recovery::matches_call(self, item)
+    }
+
+    pub fn prepare(
+        &self,
+        current: &codex_mcp::McpBinding,
+        destination_thread_id: codex_protocol::ThreadId,
+    ) -> anyhow::Result<PreparedMcpApproval> {
+        self.validate_bounds()?;
+        anyhow::ensure!(
+            destination_thread_id != self.source_thread_id,
+            "MCP approval restore requires a new native thread"
+        );
+        anyhow::ensure!(
+            self.version == 1
+                && !self.call_id.is_empty()
+                && !self.turn_id.is_empty()
+                && self.call_id.len() <= 1024
+                && self.turn_id.len() <= 1024
+                && uuid::Uuid::parse_str(&self.token).is_ok()
+                && self.request_id
+                    == format!(
+                        "{}_{}",
+                        crate::mcp_tool_call::MCP_TOOL_APPROVAL_QUESTION_ID_PREFIX,
+                        self.call_id
+                    )
+                && self.receipt == format!("sdk-question:{}", self.token),
+            "Invalid MCP approval checkpoint identity"
+        );
+        let call = current
+            .prepare_call(&self.server_name, &self.tool_name)
+            .ok_or_else(|| anyhow::anyhow!("MCP approval declaration is no longer selected"))?;
+        let tool = call.tool_info();
+        anyhow::ensure!(
+            tool.callable_namespace == self.callable_namespace
+                && tool.callable_name == self.callable_name
+                && mcp_approval_declaration_fingerprint(&call)? == self.declaration_sha256,
+            "MCP approval declaration changed"
+        );
+        Ok(PreparedMcpApproval {
+            destination_thread_id,
+            call,
+            source: self.clone(),
+        })
+    }
+}
+
+impl PreparedMcpApproval {
+    pub(crate) fn validate_current(&self, current: &codex_mcp::McpBinding) -> anyhow::Result<()> {
+        let call = current
+            .prepare_call(&self.source.server_name, &self.source.tool_name)
+            .ok_or_else(|| anyhow::anyhow!("MCP approval declaration is no longer selected"))?;
+        anyhow::ensure!(
+            self.call.has_same_approval_declaration(&call)
+                && mcp_approval_declaration_fingerprint(&call)? == self.source.declaration_sha256,
+            "MCP approval declaration changed"
+        );
+        Ok(())
+    }
+
+    /// Bind only a newly issued native question for the same admitted call.
+    pub async fn bind_fresh(
+        &self,
+        question: &OwnedQuestion,
+        current: &codex_mcp::McpBinding,
+    ) -> anyhow::Result<CapturedMcpApproval> {
+        anyhow::ensure!(
+            question.session.thread_id == self.destination_thread_id,
+            "MCP approval belongs to a different restore destination"
+        );
+        let captured = question
+            .capture_mcp_approval(current)
+            .await?
+            .ok_or_else(|| anyhow::anyhow!("Restore requires a fresh native MCP approval"))?;
+        let data = &captured.data;
+        anyhow::ensure!(
+            self.call.has_same_approval_declaration(&captured.call)
+                && data.token != self.source.token
+                && data.receipt != self.source.receipt
+                && data.turn_id == self.source.turn_id
+                && data.call_id == self.source.call_id
+                && data.request_id == self.source.request_id
+                && data.server_name == self.source.server_name
+                && data.tool_name == self.source.tool_name
+                && data.callable_namespace == self.source.callable_namespace
+                && data.callable_name == self.source.callable_name
+                && data.declaration_sha256 == self.source.declaration_sha256
+                && data.arguments == self.source.arguments,
+            "Restored MCP approval does not match a fresh native owner"
+        );
+        Ok(captured)
+    }
+}
