+#[tokio::test]
+async fn approval_checkpoint_rejects_changed_raw_declaration_and_authority() {
+    let source = test_step("new", AppToolApproval::Prompt, false).await;
+    let original = source.step.prepare_call(SERVER_NAME, TOOL_NAME).unwrap();
+    assert!(original.has_same_approval_declaration(&original.clone()));
+
+    let mut changed = original.clone();
+    changed.tool_info.callable_name = "different_alias".into();
+    assert!(!original.has_same_approval_declaration(&changed));
+
+    let mut changed = original.clone();
+    changed.tool_info.tool.name = "another_raw_tool".into();
+    assert!(!original.has_same_approval_declaration(&changed));
+
