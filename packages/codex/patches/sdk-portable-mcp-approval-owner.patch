 impl OwnedQuestion {
+    /// Capture a direct ordinary MCP approval through its original native owner.
+    /// Current SDK suspension guards remain until sealing and restoration are wired.
+    pub async fn capture_mcp_approval(
+        &self,
+        current: &codex_mcp::McpBinding,
+    ) -> anyhow::Result<Option<CapturedMcpApproval>> {
+        let QuestionKey::Elicitation(server, RequestId::String(request_id)) = &self.key else {
+            return Ok(None);
+        };
+        let prefix = format!(
+            "{}_",
+            crate::mcp_tool_call::MCP_TOOL_APPROVAL_QUESTION_ID_PREFIX
+        );
+        let Some(call_id) = request_id.as_ref().strip_prefix(&prefix) else {
+            return Ok(None);
+        };
+        let Some(token) = self.identity.as_ref() else {
+            return Ok(None);
+        };
+        let Some(context) = self.session.mcp_tool_approval_metadata(server, call_id) else {
+            return Ok(None);
+        };
+        let Some((invocation, call)) = context.checkpoint_call else {
+            return Ok(None);
+        };
+        anyhow::ensure!(
+            invocation.server == *server
+                && call.server_name() == server
+                && invocation.tool == call.tool_info().tool.name.as_ref(),
+            "MCP approval does not match its original raw declaration"
+        );
+        let captured = CapturedMcpApproval {
+            data: McpApprovalCheckpointData {
+                source_thread_id: self.session.thread_id,
+                turn_id: self.turn.sub_id.clone(),
+                call_id: call_id.to_owned(),
+                request_id: request_id.to_string(),
+                receipt: format!("sdk-question:{}", token.as_str()),
+                token: token.as_ref().clone(),
+                version: 1,
+                server_name: invocation.server,
+                tool_name: invocation.tool,
+                callable_namespace: call.tool_info().callable_namespace.clone(),
+                callable_name: call.tool_info().callable_name.clone(),
+                declaration_sha256: mcp_approval_declaration_fingerprint(&call)?,
+                arguments: invocation.arguments,
+            },
+            question: self.clone(),
+            call,
+        };
+        captured.data.validate_bounds()?;
+        captured.validate(&captured.data, current).await?;
+        Ok(Some(captured))
+    }
