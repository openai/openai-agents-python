+    /// Compares the raw declaration and its captured permission authority.
+    /// Transport instances may differ after reconnecting. This check never grants execution.
+    pub fn has_same_approval_declaration(&self, current: &Self) -> bool {
+        self.server_name == current.server_name
+            && self.tool_info == current.tool_info
+            && self.config.mcp_server_catalog.server(&self.server_name)
+                == current
+                    .config
+                    .mcp_server_catalog
+                    .server(&current.server_name)
+            && self.permission_profile() == current.permission_profile()
+            && self.config.approval_policy.value() == current.config.approval_policy.value()
+            && self.config.approvals_reviewer == current.config.approvals_reviewer
+            && self.server_environment_id() == current.server_environment_id()
+            && self.server_origin() == current.server_origin()
+            && self.tool_approval_mode() == current.tool_approval_mode()
+            && self.plugin_id == current.plugin_id
+            && self.selected_plugin_server == current.selected_plugin_server
+            && self.client.tool_timeout == current.client.tool_timeout
     }

