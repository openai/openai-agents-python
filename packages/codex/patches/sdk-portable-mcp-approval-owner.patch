+/// A live sender retained while the original Core turn is being suspended.
+/// Dropping this handle cannot approve a call. Rollback restores only its original owner.
+pub struct ClaimedMcpApproval {
+    captured: CapturedMcpApproval,
+    claim: crate::state::ElicitationClaim,
+}
+
+impl ClaimedMcpApproval {
+    pub fn is_live(&self) -> bool {
+        self.claim.is_live()
+    }
+
+    pub fn checkpoint_data(&self) -> McpApprovalCheckpointData {
+        self.captured.checkpoint_data()
+    }
+
+    pub async fn rollback(self) -> bool {
+        let question = &self.captured.question;
+        let active = question.session.active_turn.lock().await;
+        let Some(active) = active.as_ref() else {
+            return false;
+        };
+        if !Arc::ptr_eq(&active.turn_state, &question.state)
+            || !active.task.as_ref().is_some_and(|task| {
+                Arc::ptr_eq(&task.turn_context, &question.turn)
+                    && !task.cancellation_token.is_cancelled()
+            })
+        {
+            return false;
+        }
+        question
+            .state
+            .lock()
+            .await
+            .restore_elicitation_claim(self.claim)
+    }
+}
+
+impl CapturedMcpApproval {
+    pub async fn is_pending(&self) -> bool {
+        self.question.is_pending().await
+    }
+
+    /// Reserve the exact native sender before a suspension transaction starts.
+    pub async fn claim_for_suspension(
+        self,
+        current: &codex_mcp::McpBinding,
+    ) -> anyhow::Result<ClaimedMcpApproval> {
+        self.validate(&self.data, current).await?;
+        let question = &self.question;
+        let claim = {
+            let active = question.session.active_turn.lock().await;
+            let active = active
+                .as_ref()
+                .ok_or_else(|| anyhow::anyhow!("MCP approval request expired"))?;
+            anyhow::ensure!(
+                Arc::ptr_eq(&active.turn_state, &question.state)
+                    && active.task.as_ref().is_some_and(|task| {
+                        Arc::ptr_eq(&task.turn_context, &question.turn)
+                            && !task.cancellation_token.is_cancelled()
+                    }),
+                "MCP approval request expired"
+            );
+            let QuestionKey::Elicitation(server, id) = &question.key else {
+                anyhow::bail!("MCP approval requires its native elicitation owner");
+            };
+            let identity = question
+                .identity
+                .as_ref()
+                .ok_or_else(|| anyhow::anyhow!("MCP approval lacks a native identity"))?;
+            let mut state = question.state.lock().await;
+            state
+                .claim_only_elicitation(server, id, identity)
+                .ok_or_else(|| anyhow::anyhow!("MCP approval boundary is no longer isolated"))?
+        };
+        Ok(ClaimedMcpApproval {
+            captured: self,
+            claim,
+        })
+    }
+
+    pub fn checkpoint_data(&self) -> McpApprovalCheckpointData {
+        self.data.clone()
+    }
+
+    /// Recheck the original receipt and the current raw catalog before a future seal.
+    /// Success is a point-in-time check, not a reservation or execution grant.
+    pub async fn validate(
+        &self,
+        data: &McpApprovalCheckpointData,
+        current: &codex_mcp::McpBinding,
+    ) -> anyhow::Result<()> {
+        anyhow::ensure!(self.data == *data, "MCP approval checkpoint data changed");
+        anyhow::ensure!(
+            self.question.is_pending().await,
+            "MCP approval request expired"
+        );
+        let call = current
+            .prepare_call(&data.server_name, &data.tool_name)
+            .ok_or_else(|| anyhow::anyhow!("MCP approval declaration is no longer selected"))?;
+        anyhow::ensure!(
+            data.declaration_sha256 == mcp_approval_declaration_fingerprint(&call)?
+                && self.call.has_same_approval_declaration(&call),
+            "MCP approval declaration changed"
+        );
+        anyhow::ensure!(
+            self.question.is_pending().await,
+            "MCP approval request expired"
+        );
+        Ok(())
+    }
+}
