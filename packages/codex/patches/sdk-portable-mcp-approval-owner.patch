+#[cfg(test)]
+mod mcp_approval_claim_tests {
+    use super::*;
+
+    fn request() -> RequestId {
+        RequestId::String("mcp_tool_call_approval_call".into())
+    }
+
+    #[tokio::test]
+    async fn claim_requires_original_identity_and_preserves_live_sender_until_rollback() {
+        let mut state = TurnState::default();
+        let (sender, mut receiver) = oneshot::channel();
+        state.insert_pending_elicitation("raw-server".into(), request(), sender);
+        let identity = state
+            .elicitation_identity("raw-server", &request())
+            .unwrap();
+        let copied_token = Arc::new(identity.as_ref().clone());
+        assert!(
+            state
+                .claim_only_elicitation("raw-server", &request(), &copied_token)
+                .is_none()
+        );
+        assert!(
+            state
+                .claim_only_elicitation("other-server", &request(), &identity)
+                .is_none()
+        );
+        let claim = state
+            .claim_only_elicitation("raw-server", &request(), &identity)
+            .unwrap();
+        assert!(
+            state
+                .remove_pending_elicitation("raw-server", &request())
+                .is_none()
+        );
+        assert!(state.has_pending_waiters());
+        assert!(Arc::ptr_eq(
+            &identity,
+            &state
+                .elicitation_identity("raw-server", &request())
+                .unwrap()
+        ));
+        assert!(matches!(
+            receiver.try_recv(),
+            Err(oneshot::error::TryRecvError::Empty)
+        ));
+        assert!(state.restore_elicitation_claim(claim));
+        assert!(Arc::ptr_eq(
+            &identity,
+            &state
+                .elicitation_identity("raw-server", &request())
+                .unwrap()
+        ));
+        drop(state.remove_pending_elicitation("raw-server", &request()));
+        assert!(matches!(
+            receiver.try_recv(),
+            Err(oneshot::error::TryRecvError::Closed)
+        ));
+    }
+
+    #[tokio::test]
+    async fn rollback_never_overwrites_a_successor_or_reopens_a_closed_receiver() {
+        let mut state = TurnState::default();
+        let (sender, receiver) = oneshot::channel();
+        state.insert_pending_elicitation("raw-server".into(), request(), sender);
+        let identity = state
+            .elicitation_identity("raw-server", &request())
+            .unwrap();
+        let claim = state
+            .claim_only_elicitation("raw-server", &request(), &identity)
+            .unwrap();
+        let (successor, _successor_receiver) = oneshot::channel();
+        state.insert_pending_elicitation("raw-server".into(), request(), successor);
+        let fresh = state
+            .elicitation_identity("raw-server", &request())
+            .unwrap();
+        assert!(!state.restore_elicitation_claim(claim));
+        assert!(Arc::ptr_eq(
+            &fresh,
+            &state
+                .elicitation_identity("raw-server", &request())
+                .unwrap()
+        ));
+        drop(receiver);
+        let claim = state
+            .claim_only_elicitation("raw-server", &request(), &fresh)
+            .unwrap();
+        drop(_successor_receiver);
+        assert!(!state.restore_elicitation_claim(claim));
+        assert!(!state.has_pending_waiters());
+    }
+
+    #[tokio::test]
+    async fn dropping_a_claim_expires_its_reservation_without_granting_a_reply() {
+        let mut state = TurnState::default();
+        let (sender, mut receiver) = oneshot::channel();
+        state.insert_pending_elicitation("raw-server".into(), request(), sender);
+        let identity = state
+            .elicitation_identity("raw-server", &request())
+            .unwrap();
+        let claim = state
+            .claim_only_elicitation("raw-server", &request(), &identity)
+            .unwrap();
+        assert!(state.has_pending_waiters());
+        drop(claim);
+        assert!(!state.has_pending_waiters());
+        assert!(
+            state
+                .elicitation_identity("raw-server", &request())
+                .is_none()
+        );
+        assert!(matches!(
+            receiver.try_recv(),
+            Err(oneshot::error::TryRecvError::Closed)
+        ));
+    }
+
+    #[tokio::test]
+    async fn claim_refuses_an_unsettled_sibling() {
+        let mut state = TurnState::default();
+        let (sender, _receiver) = oneshot::channel();
+        state.insert_pending_elicitation("raw-server".into(), request(), sender);
+        let identity = state
+            .elicitation_identity("raw-server", &request())
+            .unwrap();
+        let (sibling, _sibling_receiver) = oneshot::channel();
+        state.insert_pending_elicitation(
+            "raw-server".into(),
+            RequestId::String("other".into()),
+            sibling,
+        );
+        assert!(
+            state
+                .claim_only_elicitation("raw-server", &request(), &identity)
+                .is_none()
+        );
+        assert!(
+            state
+                .elicitation_identity("raw-server", &request())
+                .is_some()
+        );
+    }
