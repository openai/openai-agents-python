--- /dev/null
+++ b/codex-rs/core/src/mcp_approval_recovery.rs
@@ -0,0 +1,335 @@
+//! In-memory reentry for one admitted ordinary MCP call, before another model sample.
+use crate::owned_question::PreparedMcpApproval;
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use codex_protocol::models::ResponseItem;
+use rmcp::model::RequestId;
+use std::sync::{Arc, Mutex};
+
+#[derive(Clone)]
+pub struct NativeMcpRecovery {
+    prepared: PreparedMcpApproval,
+    response_observation_id: String,
+    state: Arc<Mutex<RecoveryState>>,
+}
+
+struct RecoveryState {
+    call: Option<ResponseItem>,
+    fresh_identity: Option<Arc<String>>,
+    replied: bool,
+    finished: bool,
+}
+
+pub(crate) fn matches_call(
+    data: &crate::owned_question::McpApprovalCheckpointData,
+    item: &ResponseItem,
+) -> bool {
+    let ResponseItem::FunctionCall {
+        call_id,
+        namespace,
+        name,
+        arguments,
+        encrypted_function_args,
+        asynchronous,
+        ..
+    } = item
+    else {
+        return false;
+    };
+    let arguments = if arguments.is_empty() {
+        Some(None)
+    } else {
+        serde_json::from_str::<serde_json::Value>(arguments)
+            .ok()
+            .map(Some)
+    };
+    call_id == &data.call_id
+        && namespace.as_deref().unwrap_or_default() == data.callable_namespace
+        && name == &data.callable_name
+        && encrypted_function_args.is_none()
+        && *asynchronous != Some(true)
+        && arguments.as_ref() == Some(&data.arguments)
+}
+
+fn matches_native_runtime(
+    runtime: &dyn crate::tools::registry::CoreToolRuntime,
+    server: &str,
+    tool: &str,
+) -> bool {
+    runtime.type_id() == std::any::TypeId::of::<crate::tools::handlers::mcp::McpHandler>()
+        && runtime.mcp_server_name() == Some(server)
+        && runtime.mcp_tool_name() == Some(tool)
+}
+
+impl NativeMcpRecovery {
+    pub(crate) fn validate_runtime(
+        &self,
+        runtime: &dyn crate::tools::registry::CoreToolRuntime,
+    ) -> anyhow::Result<()> {
+        anyhow::ensure!(
+            matches_native_runtime(
+                runtime,
+                &self.prepared.source.server_name,
+                &self.prepared.source.tool_name
+            ),
+            "MCP recovery requires its exact native runtime"
+        );
+        Ok(())
+    }
+
+    /// Accept only the canonical sampled call already validated by the native frame.
+    pub fn new(
+        prepared: PreparedMcpApproval,
+        call: ResponseItem,
+        response_observation_id: String,
+    ) -> anyhow::Result<Self> {
+        anyhow::ensure!(
+            !response_observation_id.is_empty() && response_observation_id.len() <= 1024,
+            "MCP recovery requires its completed sample identity"
+        );
+        anyhow::ensure!(
+            matches_call(&prepared.source, &call),
+            "MCP recovery call changed"
+        );
+        Ok(Self {
+            prepared,
+            response_observation_id,
+            state: Arc::new(Mutex::new(RecoveryState {
+                call: Some(call),
+                fresh_identity: None,
+                replied: false,
+                finished: false,
+            })),
+        })
+    }
+
+    pub(crate) fn take_call(
+        &self,
+        session: &Session,
+        turn: &TurnContext,
+        current: &codex_mcp::McpBinding,
+        history: &[codex_history::RolloutItem],
+    ) -> anyhow::Result<ResponseItem> {
+        anyhow::ensure!(
+            session.thread_id == self.prepared.destination_thread_id
+                && turn.sub_id == self.prepared.source.turn_id
+                && crate::owned_question::sdk_owns_prompts(session, turn),
+            "MCP recovery requires its current native prompt owner"
+        );
+        self.prepared.validate_current(current)?;
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| anyhow::anyhow!("MCP recovery poisoned"))?;
+        let call = state
+            .call
+            .as_ref()
+            .ok_or_else(|| anyhow::anyhow!("MCP recovery already started"))?;
+        use codex_history::RolloutItem;
+        use codex_protocol::protocol::{EventMsg, ResponseObservationStatus};
+        let anchors: Vec<_> = history
+            .iter()
+            .enumerate()
+            .filter_map(|(index, row)| match row {
+                RolloutItem::ResponseObservationRecord(record)
+                    if record.id == self.response_observation_id =>
+                {
+                    Some((index, record))
+                }
+                _ => None,
+            })
+            .collect();
+        let [(anchor, record)] = anchors.as_slice() else {
+            anyhow::bail!("MCP recovery lacks its unique completed sample");
+        };
+        anyhow::ensure!(
+            record.thread_id == session.thread_id
+                && record.turn_id == turn.sub_id
+                && record.observation.status == ResponseObservationStatus::Completed,
+            "MCP recovery sample owner changed"
+        );
+        let original_start = history[..*anchor]
+            .iter()
+            .rposition(|row| matches!(row, RolloutItem::EventMsg(EventMsg::TurnStarted(_))))
+            .ok_or_else(|| anyhow::anyhow!("MCP recovery sample has no original turn"))?;
+        anyhow::ensure!(
+            matches!(&history[original_start],
+                RolloutItem::EventMsg(EventMsg::TurnStarted(start)) if start.turn_id == turn.sub_id),
+            "MCP recovery sample has a different original turn"
+        );
+        let start = history[original_start + 1..*anchor]
+            .iter()
+            .rposition(|row| matches!(row, RolloutItem::ResponseObservationRecord(_)))
+            .map_or(original_start, |index| original_start + index + 1);
+        let mut sampled = Vec::new();
+        for row in &history[start + 1..*anchor] {
+            if let RolloutItem::ResponseItem(item) = row {
+                match &item.item {
+                    ResponseItem::FunctionCall { .. } => sampled.push(&item.item),
+                    ResponseItem::CustomToolCall { .. }
+                    | ResponseItem::ComputerCall { .. }
+                    | ResponseItem::ApplyPatchCall { .. }
+                    | ResponseItem::ShellCall { .. }
+                    | ResponseItem::ToolSearchCall { .. } => {
+                        anyhow::bail!("MCP recovery sample contains another native operation")
+                    }
+                    ResponseItem::Message { .. } | ResponseItem::Reasoning { .. } => {}
+                    _ => anyhow::bail!("MCP recovery sample contains another response operation"),
+                }
+            }
+        }
+        anyhow::ensure!(!state.finished && sampled.as_slice() == [call]
+            && !history[start + 1..].iter().any(|row| matches!(row,
+                RolloutItem::ResponseItem(item) if matches!(&item.item,
+                    ResponseItem::FunctionCallOutput { call_id: Some(id), .. }
+                        if id == &self.prepared.source.call_id)))
+            && !history[*anchor + 1..].iter().any(|row| match row {
+                RolloutItem::ResponseObservationRecord(record) => record.thread_id == session.thread_id && record.turn_id == turn.sub_id,
+                RolloutItem::ResponseItem(item) => matches!(&item.item,
+                    ResponseItem::FunctionCallOutput { call_id: Some(id), .. } if id == &self.prepared.source.call_id),
+                _ => false,
+            }), "MCP recovery no longer matches the accepted pending call");
+        state
+            .call
+            .take()
+            .ok_or_else(|| anyhow::anyhow!("MCP recovery already started"))
+    }
+
+    /// Bind the actual new sender before publishing its request, never a stored token.
+    pub(crate) async fn bind_question(
+        &self,
+        session: &Session,
+        turn: &TurnContext,
+        server: &str,
+        request: &RequestId,
+    ) -> anyhow::Result<()> {
+        let data = &self.prepared.source;
+        anyhow::ensure!(
+            session.thread_id == self.prepared.destination_thread_id
+                && turn.sub_id == data.turn_id
+                && server == data.server_name
+                && *request == RequestId::String(data.request_id.clone().into()),
+            "MCP recovery question changed"
+        );
+        let context = session
+            .mcp_tool_approval_metadata(server, &data.call_id)
+            .ok_or_else(|| anyhow::anyhow!("MCP recovery lacks its current call owner"))?;
+        let (invocation, call) = context
+            .checkpoint_call
+            .ok_or_else(|| anyhow::anyhow!("MCP recovery requires a direct ordinary MCP call"))?;
+        anyhow::ensure!(
+            invocation.server == data.server_name
+                && invocation.tool == data.tool_name
+                && invocation.arguments == data.arguments
+                && self.prepared.call.has_same_approval_declaration(&call),
+            "MCP recovery declaration changed before its new question"
+        );
+        let active = session.active_turn.lock().await;
+        let active = active
+            .as_ref()
+            .ok_or_else(|| anyhow::anyhow!("MCP recovery turn expired"))?;
+        anyhow::ensure!(
+            active.task.as_ref().is_some_and(|task| {
+                std::ptr::eq(task.turn_context.as_ref(), turn)
+                    && !task.cancellation_token.is_cancelled()
+            }),
+            "MCP recovery turn expired"
+        );
+        let native_state = active.turn_state.lock().await;
+        let identity = native_state
+            .elicitation_identity(server, request)
+            .ok_or_else(|| anyhow::anyhow!("MCP recovery lacks a live native sender"))?;
+        anyhow::ensure!(
+            identity.as_str() != data.token
+                && format!("sdk-question:{}", identity.as_str()) != data.receipt,
+            "MCP recovery cannot reuse its old receipt"
+        );
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| anyhow::anyhow!("MCP recovery poisoned"))?;
+        anyhow::ensure!(
+            state.call.is_none() && state.fresh_identity.is_none() && !state.finished,
+            "MCP recovery question already bound"
+        );
+        state.fresh_identity = Some(identity);
+        Ok(())
+    }
+
+    pub(crate) fn question_replied(&self, received: bool) {
+        if let Ok(mut state) = self.state.lock() {
+            state.replied = received && state.fresh_identity.is_some() && !state.finished;
+        }
+    }
+
+    /// Normal native decision parsing still decides allow/deny; this only fences reentry.
+    pub(crate) fn validate_effect(
+        &self,
+        turn: &TurnContext,
+        call_id: &str,
+        invocation: &codex_protocol::protocol::McpInvocation,
+        call: &codex_mcp::PreparedMcpCall,
+    ) -> anyhow::Result<()> {
+        let data = &self.prepared.source;
+        let state = self
+            .state
+            .lock()
+            .map_err(|_| anyhow::anyhow!("MCP recovery poisoned"))?;
+        anyhow::ensure!(
+            state.replied
+                && state.fresh_identity.is_some()
+                && !state.finished
+                && turn.sub_id == data.turn_id
+                && call_id == data.call_id
+                && invocation.server == data.server_name
+                && invocation.tool == data.tool_name
+                && invocation.arguments == data.arguments
+                && self.prepared.call.has_same_approval_declaration(call),
+            "MCP recovery requires its fresh native decision before an effect"
+        );
+        Ok(())
+    }
+
+    pub(crate) fn finish(&self) -> anyhow::Result<()> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| anyhow::anyhow!("MCP recovery poisoned"))?;
+        anyhow::ensure!(
+            state.replied && state.fresh_identity.is_some() && !state.finished,
+            "MCP recovery did not settle through its fresh native question"
+        );
+        state.finished = true;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod runtime_identity_tests {
+    use super::*;
+
+    #[test]
+    fn native_runtime_keeps_raw_identity_separate_from_its_callable_alias() {
+        let info = codex_mcp::ToolInfo {
+            server_name: "docs".into(),
+            supports_parallel_tool_calls: false,
+            server_origin: None,
+            callable_namespace: "mcp__docs".into(),
+            callable_name: "reviewed".into(),
+            namespace_description: None,
+            tool: rmcp::model::Tool::new(
+                "find-record".to_owned(),
+                "fixture".to_owned(),
+                Arc::new(rmcp::model::JsonObject::default()),
+            ),
+            openai_file_input_optional_fields: Default::default(),
+            connector_id: None,
+            connector_name: None,
+            plugin_display_names: Vec::new(),
+        };
+        let runtime = crate::tools::handlers::mcp::McpHandler::new(info).unwrap();
+        assert!(matches_native_runtime(&runtime, "docs", "find-record"));
+        assert!(!matches_native_runtime(&runtime, "docs", "reviewed"));
+        assert!(!matches_native_runtime(&runtime, "other", "find-record"));
+    }
+}
