+
+    let mut changed = original.clone();
+    changed.server_name = "another_raw_server".into();
+    assert!(!original.has_same_approval_declaration(&changed));
+
+    let mut changed = original.clone();
+    changed.server_metadata.origin = Some(McpServerOrigin::StreamableHttp(
+        "https://different.example".into(),
+    ));
+    assert!(!original.has_same_approval_declaration(&changed));
+
+    let mut changed = original.clone();
+    changed.server_metadata.default_tools_approval_mode = Some(AppToolApproval::Approve);
+    assert!(!original.has_same_approval_declaration(&changed));
+
+    let mut changed = original.clone();
+    changed.server_metadata.environment_id = "different-environment".into();
+    assert!(!original.has_same_approval_declaration(&changed));
+}
