+#[test]
+fn mcp_category_never_promotes_a_name_without_its_server() {
+    let spec = ToolSpec::Mcp(crate::HostedMcpTool {
+        server_label: "search".into(),
+        provider_data:
+            json!({"server_url":"https://fixture.invalid/mcp","allowed_tools":["lookup"]})
+                .as_object()
+                .unwrap()
+                .clone(),
+    });
+    assert_eq!(
+        spec.captured_hosted_choice(&Choice::Mcp {
+            server_label: None,
+            name: None
+        }),
+        Some(Choice::Mcp {
+            server_label: None,
+            name: None
+        })
+    );
+    assert_eq!(
+        spec.captured_hosted_choice(&Choice::Mcp {
+            server_label: None,
+            name: Some("lookup".into())
+        }),
+        None
+    );
+}
