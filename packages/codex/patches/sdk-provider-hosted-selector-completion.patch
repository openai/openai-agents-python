+#[test]
+fn hosted_selector_preview_and_mcp_category_preserve_exact_wire() {
+    for value in [json!({"type":"web_search_preview"}), json!({"type":"mcp"})] {
+        let selected: HostedToolChoice = serde_json::from_value(value.clone()).unwrap();
+        selected.validate().unwrap();
+        assert_eq!(serde_json::to_value(selected).unwrap(), value);
+    }
+    let invalid: HostedToolChoice =
+        serde_json::from_value(json!({"type":"mcp","name":"lookup"})).unwrap();
+    assert!(invalid.validate().is_err());
+}
