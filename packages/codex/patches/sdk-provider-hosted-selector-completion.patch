+#[test]
+fn preview_search_selects_the_offered_hosted_search_without_renaming_it() {
+    let spec = ToolSpec::WebSearch {
+        external_web_access: None,
+        indexed_web_access: None,
+        filters: None,
+        user_location: None,
+        search_context_size: None,
+        image_settings: None,
+        search_content_types: None,
+    };
+    assert_eq!(
+        spec.captured_hosted_choice(&Choice::WebSearchPreview {}),
+        Some(Choice::WebSearchPreview {})
+    );
+    assert_eq!(serde_json::to_value(spec).unwrap()["type"], "web_search");
+}
