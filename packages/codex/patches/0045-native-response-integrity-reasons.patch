+
+#[test]
+fn map_response_integrity_reason_preserves_existing_invalid_request_semantics() {
+    use codex_protocol::error::ResponseIntegrityReason;
+    for reason in [
+        ResponseIntegrityReason::UndecodableOutputItem,
+        ResponseIntegrityReason::ProviderOwnedToolReceipt,
+        ResponseIntegrityReason::UnfinishedAssistantItem,
+        ResponseIntegrityReason::MissingSupportedTerminalOutput,
+    ] {
+        let message = "Native model response ended without complete supported output";
+        let typed = ApiError::ResponseIntegrity { reason };
+        let plain = ApiError::InvalidRequest {
+            message: message.to_string(),
+        };
+        assert_eq!(typed.to_string(), plain.to_string());
+        let plain = map_api_error(plain);
+        let mapped = map_api_error(typed);
+        assert!(
+            matches!(mapped.details(), CodexErrorDetails::InvalidRequest(value) if value == message)
+        );
+        assert_eq!(mapped.to_string(), plain.to_string());
+        assert_eq!(
+            mapped.to_codex_protocol_error(),
+            plain.to_codex_protocol_error()
+        );
+        assert_eq!(mapped.retry_delay(1), None);
+        assert_eq!(mapped.retry_after(), None);
+        assert_eq!(mapped.response_integrity_reason(), Some(reason));
+        assert_eq!(
+            mapped.to_error_event(None).response_integrity_reason,
+            Some(reason)
+        );
+        assert_eq!(plain.response_integrity_reason(), None);
+    }
+}
