+#[test]
+fn response_integrity_reason_follows_only_its_error_and_live_event() {
+    use crate::protocol::ErrorEvent;
+    use crate::protocol::TurnCompleteEvent;
+    let message = "Native model response ended without complete supported output";
+    for reason in [
+        ResponseIntegrityReason::UndecodableOutputItem,
+        ResponseIntegrityReason::ProviderOwnedToolReceipt,
+        ResponseIntegrityReason::UnfinishedAssistantItem,
+        ResponseIntegrityReason::MissingSupportedTerminalOutput,
+    ] {
+        let plain = CodexErr::InvalidRequest(message.to_string());
+        let annotated =
+            CodexErr::InvalidRequest(message.to_string()).with_response_integrity_reason(reason);
+        assert_eq!(annotated.to_string(), plain.to_string());
+        assert_eq!(format!("{annotated:?}"), format!("{plain:?}"));
+        assert_eq!(
+            annotated.to_codex_protocol_error(),
+            plain.to_codex_protocol_error()
+        );
+        assert_eq!(annotated.retry_delay(1), plain.retry_delay(1));
+        assert_eq!(annotated.retry_after(), None);
+        assert_eq!(annotated.response_integrity_reason(), Some(reason));
+        let event = annotated.to_error_event(None);
+        assert_eq!(event.response_integrity_reason, Some(reason));
+        assert_eq!(event.clone().response_integrity_reason, Some(reason));
+        assert_eq!(plain.to_error_event(None).response_integrity_reason, None);
+        let wire = serde_json::to_value(&event).unwrap();
+        assert_eq!(
+            wire,
+            serde_json::to_value(plain.to_error_event(None)).unwrap()
+        );
+        let restored: ErrorEvent = serde_json::from_value(wire).unwrap();
+        assert_eq!(restored.response_integrity_reason, None);
+        let terminal = TurnCompleteEvent {
+            turn_id: "owned-turn".into(),
+            last_agent_message: None,
+            error: Some(event),
+            started_at: None,
+            completed_at: None,
+            duration_ms: None,
+            time_to_first_token_ms: None,
+        };
+        assert_eq!(
+            terminal.clone().error.unwrap().response_integrity_reason,
+            Some(reason)
+        );
+        let restored: TurnCompleteEvent =
+            serde_json::from_value(serde_json::to_value(&terminal).unwrap()).unwrap();
+        assert_eq!(restored.error.unwrap().response_integrity_reason, None);
+    }
+}
+
+#[test]
+fn response_integrity_reason_survives_retry_advice_without_changing_retry_policy() {
+    let reason = ResponseIntegrityReason::UndecodableOutputItem;
+    let error = CodexErr::InvalidRequest("fixed message".into())
+        .with_response_integrity_reason(reason)
+        .with_retry_after(RetryAfter::from_delay(Duration::ZERO).unwrap());
+    assert_eq!(error.response_integrity_reason(), Some(reason));
+    assert!(error.retry_after().is_some());
+    assert_eq!(error.retry_delay(1), None);
+    assert_eq!(CodexErr::Timeout.response_integrity_reason(), None);
+}
+
+#[test]
+fn response_integrity_reason_has_only_the_four_safe_wire_values() {
+    for (reason, value) in [
+        (
+            ResponseIntegrityReason::UndecodableOutputItem,
+            "undecodable_output_item",
+        ),
+        (
+            ResponseIntegrityReason::ProviderOwnedToolReceipt,
+            "provider_owned_tool_receipt",
+        ),
+        (
+            ResponseIntegrityReason::UnfinishedAssistantItem,
+            "unfinished_assistant_item",
+        ),
+        (
+            ResponseIntegrityReason::MissingSupportedTerminalOutput,
+            "missing_supported_terminal_output",
+        ),
+    ] {
+        assert_eq!(serde_json::to_value(reason).unwrap(), value);
+        assert_eq!(
+            serde_json::from_value::<ResponseIntegrityReason>(serde_json::json!(value)).unwrap(),
+            reason
+        );
+    }
+    assert!(
+        serde_json::from_value::<ResponseIntegrityReason>(serde_json::json!(
+            "private-provider-detail"
+        ))
+        .is_err()
+    );
+}
