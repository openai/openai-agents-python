+#[tokio::test]
+async fn response_integrity_reason_tracks_the_originating_terminal_error_event() {
+    use codex_protocol::error::ResponseIntegrityReason;
+    let (session, turn_context, _rx) = make_session_and_context_with_rx().await;
+    let make_error = || CodexErr::InvalidRequest("fixed safe message".to_string());
+    let first = make_error()
+        .with_response_integrity_reason(ResponseIntegrityReason::UndecodableOutputItem)
+        .to_error_event(None);
+    session
+        .send_event(&turn_context, EventMsg::Error(first.clone()))
+        .await;
+    assert_eq!(
+        turn_context
+            .terminal_error
+            .lock()
+            .await
+            .as_ref()
+            .unwrap()
+            .response_integrity_reason,
+        Some(ResponseIntegrityReason::UndecodableOutputItem)
+    );
+    let second = make_error()
+        .with_response_integrity_reason(ResponseIntegrityReason::UnfinishedAssistantItem)
+        .to_error_event(None);
+    assert_eq!(first.codex_error_info, second.codex_error_info);
+    session
+        .send_event(&turn_context, EventMsg::Error(second))
+        .await;
+    assert_eq!(
+        turn_context
+            .terminal_error
+            .lock()
+            .await
+            .as_ref()
+            .unwrap()
+            .response_integrity_reason,
+        Some(ResponseIntegrityReason::UnfinishedAssistantItem)
+    );
+    let ordinary = make_error().to_error_event(None);
+    assert_eq!(first.codex_error_info, ordinary.codex_error_info);
+    session
+        .send_event(&turn_context, EventMsg::Error(ordinary))
+        .await;
+    assert_eq!(
+        turn_context
+            .terminal_error
+            .lock()
+            .await
+            .as_ref()
+            .unwrap()
+            .response_integrity_reason,
+        None
+    );
+    assert_eq!(
+        first.response_integrity_reason,
+        Some(ResponseIntegrityReason::UndecodableOutputItem)
+    );
+}
