+pub(crate) fn unpublished_tool_output_id(item: &ResponseItem) -> Option<&str> {
+    match item {
+        ResponseItem::FunctionCallOutput { call_id, .. } => call_id.as_deref(),
+        ResponseItem::CustomToolCallOutput { call_id, .. }
+        | ResponseItem::ApplyPatchCallOutput { call_id, .. } => Some(call_id),
+        ResponseItem::ShellCallOutput { provider_fields, .. } => {
+            provider_fields.get("call_id")?.as_str()
+        }
+        _ => None,
+    }
