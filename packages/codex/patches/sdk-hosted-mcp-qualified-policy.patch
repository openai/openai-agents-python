+// MCP's wire type is shared, but its authority is captured per server.
+fn hosted_tool_policy_name(spec: &ToolSpec) -> ToolName {
+    match spec {
+        ToolSpec::Mcp(config) => ToolName::new(
+            Some("hosted_mcp".into()),
+            config.server_label.clone(),
+        ),
+        _ => ToolName::plain(spec.name()),
+    }
+}
