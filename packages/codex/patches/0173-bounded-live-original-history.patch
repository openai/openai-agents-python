+#[tokio::test]
+async fn sdk_cold_legacy_projection_reuses_the_captured_restore_policy() {
+    use serde_json::json;
+    let (mut session, _, _) = make_session_and_context_with_rx().await;
+    crate::session::tests::attach_thread_persistence(
+        std::sync::Arc::get_mut(&mut session).expect("unique session"),
+    )
+    .await;
+    let raw = vec![
+        json!({"type":"message","id":"legacy-user","role":"user","content":[{"type":"input_text","text":"first"}]}),
+        json!({"type":"function_call","id":"legacy-call","name":"lookup","call_id":"legacy-output","arguments":"{}"}),
+        json!({"type":"function_call_output","id":"legacy-result","call_id":"legacy-output","output":"legacy untruncated output ".repeat(100_000)}),
+        json!({"type":"message","id":"legacy-next","role":"user","content":[{"type":"input_text","text":"second"}]}),
+    ];
+    let rows = raw
+        .into_iter()
+        .map(|item| {
+            RolloutItem::ResponseItem(ResponseItemEnvelope::new(
+                serde_json::from_value(item).unwrap(),
+            ))
+        })
+        .collect();
+    session
+        .record_initial_history(codex_history::InitialHistory::Forked(rows))
+        .await;
+    let before = session.clone_history().await.into_annotated_items();
+    let projected = session.sdk_history_projection(None).await.unwrap();
+    assert_eq!(
+        serde_json::to_value(&projected[2]).unwrap()["output"],
+        serde_json::to_value(&before[2].item).unwrap()["output"]
+    );
+    let revision = session.sdk_history_snapshot(Some(0)).await.unwrap().0;
+    session
+        .sdk_replace_history(&revision, 3, Vec::new())
+        .await
+        .unwrap();
+    assert_eq!(
+        session.clone_history().await.into_annotated_items(),
+        before[..3]
+    );
+}
