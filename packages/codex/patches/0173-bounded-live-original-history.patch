+/// Bounded hot originals plus constant-size revision metadata; the journal owns the full catalog.
+#[derive(Clone, Debug, Default)]
+pub struct SdkOriginalHistoryCache {
+    index: OriginalIndex,
+    total: usize,
+    tail: std::collections::VecDeque<String>,
+    payload_bytes: usize,
+}
+
+impl SdkOriginalHistoryCache {
+    // Cache policy only: older/oversized originals remain in the canonical journal.
+    const MAX_RETAINED_BYTES: usize = 64 * 1024;
+
+    pub fn revision(&self) -> &str {
+        &self.index.revision
+    }
+    pub fn len(&self) -> usize {
+        self.total
+    }
+    pub fn is_empty(&self) -> bool {
+        self.total == 0
+    }
+    pub fn retained_bytes(&self) -> usize {
+        self.payload_bytes + self.tail.capacity() * std::mem::size_of::<String>()
+    }
+
+    pub fn append(&mut self, original: String) {
+        self.index.append(self.total, &original);
+        self.total += 1;
+        self.cache(original);
+    }
+
+    fn cache(&mut self, original: String) {
+        self.payload_bytes += original.capacity();
+        self.tail.push_back(original);
+        while self.retained_bytes() > Self::MAX_RETAINED_BYTES {
+            if self.tail.len() == 1 {
+                self.tail.shrink_to_fit();
+                if self.retained_bytes() <= Self::MAX_RETAINED_BYTES {
+                    break;
+                }
+            }
+            let removed = self
+                .tail
+                .pop_front()
+                .expect("over-budget cache has a value");
+            self.payload_bytes -= removed.capacity();
+            if self.tail.is_empty() {
+                self.tail = Default::default();
+            }
+        }
+    }
+
+    pub fn snapshot(&self, limit: Option<usize>) -> Option<(String, usize, Vec<String>)> {
+        let count = limit.unwrap_or(self.total).min(self.total);
+        if count > self.tail.len() {
