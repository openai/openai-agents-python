+#[tokio::test]
+async fn sdk_idle_catalog_is_bounded_with_lossless_cold_reads_and_fork_restore() {
+    use serde_json::json;
+    let (mut session, _, _) = make_session_and_context_with_rx().await;
+    crate::session::tests::attach_thread_persistence(
+        std::sync::Arc::get_mut(&mut session).expect("unique session"),
+    )
+    .await;
+    let full_output = "untruncated original output ".repeat(8192);
+    let mut originals = vec![
+        json!({"type":"message","role":"user","content":[{"type":"input_text","text":"known original"}]}).to_string(),
+        json!({"type":"function_call","name":"lookup","call_id":"stored-output","arguments":"{}"}).to_string(),
+        json!({"type":"function_call_output","call_id":"stored-output","output":full_output}).to_string(),
+    ];
+    originals.extend(
+        (0..2048)
+            .map(|n| json!({"type":"future_audit", "n":n, "payload":"x".repeat(128)}).to_string()),
+    );
+    let revision = session.sdk_history_snapshot(Some(0)).await.unwrap().0;
+    session
+        .sdk_replace_history(&revision, 0, originals.clone())
+        .await
+        .unwrap();
+    assert!(session.state.lock().await.sdk_originals.retained_bytes() <= 64 * 1024);
+    assert_eq!(
+        session.sdk_history_snapshot(None).await.unwrap().2,
+        originals
+    );
+    assert_eq!(
+        session.sdk_history_snapshot(Some(2)).await.unwrap().2,
+        originals[originals.len() - 2..]
+    );
+    let stored = session
+        .live_thread()
+        .unwrap()
+        .load_history(false)
+        .await
+        .unwrap();
+    let (mut restored, _, _) = make_session_and_context_with_rx().await;
+    crate::session::tests::attach_thread_persistence(
+        std::sync::Arc::get_mut(&mut restored).expect("unique session"),
+    )
+    .await;
+    restored
+        .record_initial_history(codex_history::InitialHistory::Forked(stored.items))
+        .await;
+    assert!(restored.state.lock().await.sdk_originals.retained_bytes() <= 64 * 1024);
+    assert_eq!(
+        restored.sdk_history_snapshot(None).await.unwrap().2,
+        originals
+    );
+}
