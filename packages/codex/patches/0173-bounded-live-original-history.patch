+#[tokio::test]
+async fn sdk_ordinary_compacted_resume_defers_originals_until_explicit_read() {
+    use codex_rollout::ModelContextScan;
+    use codex_rollout::ModelContextScanProgress;
+    use serde_json::json;
+    let (mut session, turn, _) = make_session_and_context_with_rx().await;
+    crate::session::tests::attach_thread_persistence(
+        std::sync::Arc::get_mut(&mut session).expect("unique session"),
+    )
+    .await;
+    let mut originals =
+        vec![json!({"type":"future_audit","payload":"x".repeat(128 * 1024)}).to_string()];
+    originals.extend(
+        (0..2048).map(|n| json!({"type":"audit","n":n,"payload":"x".repeat(128)}).to_string()),
+    );
+    let revision = session.sdk_history_snapshot(Some(0)).await.unwrap().0;
+    session
+        .sdk_replace_history(&revision, 0, originals.clone())
+        .await
+        .unwrap();
+    let compacted: RolloutItem = serde_json::from_value(json!({"type":"compacted","payload":{
+        "message":"summary", "replacement_history":[], "window_number":1,
+        "sdk_originals":{"preserve":true}
+    }}))
+    .unwrap();
+    session
+        .persist_rollout_items(std::slice::from_ref(&compacted))
+        .await;
+    // The owning scanner returns only the complete model checkpoint, not the raw prefix.
+    let mut scan = ModelContextScan::default();
+    assert_eq!(
+        scan.push(compacted.clone()),
+        ModelContextScanProgress::Complete
+    );
+    let bounded = scan.finish();
+    assert_eq!(bounded.len(), 1);
+    session.apply_rollout_reconstruction(&turn, &bounded).await;
+    {
+        let state = session.state.lock().await;
+        assert_eq!(state.sdk_originals.revision(), None);
+        assert_eq!(state.sdk_originals.len(), None);
+        assert_eq!(state.sdk_originals.retained_bytes(), 0);
+        assert!(state.history.annotated_items().is_empty());
+    }
+    let input: ResponseItem = serde_json::from_value(json!({"type":"message","role":"user","content":[{"type":"input_text","text":"after resume"}]})).unwrap();
+    let admitted = session
+        .record_initial_response_items(&turn, vec![input])
+        .await
+        .unwrap();
+    originals.extend(
+        admitted
+            .iter()
+            .map(|item| serde_json::to_string(item).unwrap()),
+    );
+    assert_eq!(session.state.lock().await.sdk_originals.revision(), None);
+    assert!(session.state.lock().await.sdk_originals.retained_bytes() <= 64 * 1024);
+    // Another ordinary model checkpoint also remains independent of catalog hydration.
+    session
+        .persist_rollout_items(std::slice::from_ref(&compacted))
