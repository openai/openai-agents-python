+    // Cache policy only: older/oversized originals remain in the canonical journal.
+    const MAX_RETAINED_BYTES: usize = 64 * 1024;
+
+    pub fn revision(&self) -> Option<&str> {
+        self.index.as_ref().map(|index| index.revision.as_str())
+    }
+    pub fn len(&self) -> Option<usize> {
+        self.index.as_ref().map(|_| self.total)
