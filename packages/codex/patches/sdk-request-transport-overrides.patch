diff --git a/codex-rs/codex-api/src/request_transport.rs b/codex-rs/codex-api/src/request_transport.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e6e44372d1cec1fcae829e29885b6c7f8c476528
--- /dev/null
+++ b/codex-rs/codex-api/src/request_transport.rs
@@ -0,0 +1,123 @@
+use crate::ApiError;
+use codex_client::Request;
+use codex_protocol::model_request_transport::RequestTransportOverrides;
+use http::header::{HeaderMap, HeaderName, HeaderValue};
+use serde_json::Value;
+use url::Url;
+
+/// Validated values for the existing pre-authentication request configuration hook.
+pub struct PreparedRequestTransport {
+    url: Option<String>,
+    headers: HeaderMap,
+    omitted: Vec<HeaderName>,
+}
+
+impl PreparedRequestTransport {
+    pub fn apply(&self, request: &mut Request) {
+        self.apply_parts(&mut request.url, &mut request.headers);
+    }
+
+    pub fn apply_parts(&self, url: &mut String, headers: &mut HeaderMap) {
+        if let Some(prepared_url) = &self.url {
+            url.clone_from(prepared_url);
+        }
+        for name in &self.omitted {
+            headers.remove(name);
+        }
+        headers.extend(self.headers.clone());
+    }
+}
+
+fn invalid(message: &str) -> ApiError {
+    ApiError::InvalidRequest {
+        message: message.into(),
+    }
+}
+
+fn query_pairs(
+    key: &str,
+    value: &Value,
+    nulls_as_empty: bool,
+    depth: usize,
+    pairs: &mut Vec<(String, String)>,
+) -> Result<(), ApiError> {
+    if depth > 64 {
+        return Err(invalid("request query nesting exceeds its limit"));
+    }
+    match value {
+        Value::Null if nulls_as_empty => pairs.push((key.into(), String::new())),
+        Value::Null => {}
+        Value::Bool(value) => pairs.push((key.into(), value.to_string())),
+        Value::Number(value) => pairs.push((key.into(), value.to_string())),
+        Value::String(value) => pairs.push((key.into(), value.clone())),
+        Value::Array(values) => {
+            for value in values {
+                query_pairs(&format!("{key}[]"), value, nulls_as_empty, depth + 1, pairs)?;
+            }
+        }
+        Value::Object(values) => {
+            for (name, value) in values {
+                query_pairs(
+                    &format!("{key}[{name}]"),
+                    value,
+                    nulls_as_empty,
+                    depth + 1,
+                    pairs,
+                )?;
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Prepare without mutating a provider, a request, or its credential owner.
+pub fn prepare_request_transport(
+    url: &str,
+    overrides: Option<&RequestTransportOverrides>,
+) -> Result<PreparedRequestTransport, ApiError> {
+    let mut prepared = PreparedRequestTransport {
+        url: None,
+        headers: HeaderMap::new(),
+        omitted: Vec::new(),
+    };
+    let Some(overrides) = overrides else {
+        return Ok(prepared);
+    };
+    overrides
+        .validate()
+        .map_err(|message| ApiError::InvalidRequest { message })?;
+    if let Some(Some(headers)) = &overrides.headers {
+        for (name, value) in headers {
+            let name = HeaderName::from_bytes(name.as_bytes())
+                .map_err(|_| invalid("invalid request header name"))?;
+            match value {
+                Some(value) => {
+                    let mut value = HeaderValue::from_str(value)
+                        .map_err(|_| invalid("invalid request header value"))?;
+                    value.set_sensitive(true);
+                    prepared.headers.insert(name, value);
+                }
+                None => prepared.omitted.push(name),
+            }
+        }
+    }
+    if let Some(Some(query)) = &overrides.query
+        && !query.is_empty()
+    {
+        let mut url = Url::parse(url).map_err(|_| invalid("invalid request query URL"))?;
+        let mut pairs = url
+            .query_pairs()
+            .into_owned()
+            .filter(|(name, _)| !query.contains_key(name))
+            .collect::<Vec<_>>();
+        for (name, value) in query {
+            query_pairs(name, value, overrides.query_nulls_as_empty, 0, &mut pairs)?;
+        }
+        url.set_query(None);
+        if !pairs.is_empty() {
+            url.query_pairs_mut().extend_pairs(pairs);
+        }
+        prepared.url = Some(url.into());
+    }
+    Ok(prepared)
+}
diff --git a/codex-rs/codex-api/tests/request_transport_overrides.rs b/codex-rs/codex-api/tests/request_transport_overrides.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0e626dca99e6add268f142fb26d21b697eb2e949
--- /dev/null
+++ b/codex-rs/codex-api/tests/request_transport_overrides.rs
@@ -0,0 +1,310 @@
+use codex_api::{AuthHeadersFuture, AuthProvider, prepare_request_transport};
+use codex_client::{HttpTransport, Provider, ReqwestTransport, RetryConfig};
+use codex_protocol::model_request_transport::RequestTransportOverrides;
+use http::{HeaderMap, HeaderValue, Method};
+use serde_json::json;
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::Duration;
+use wiremock::{Mock, MockServer, ResponseTemplate};
+
+struct RefreshingAuth(AtomicUsize);
+impl AuthProvider for RefreshingAuth {
+    fn add_auth_headers(&self, _: &mut HeaderMap) {}
+    fn resolve_auth_headers(&self) -> AuthHeadersFuture<'_> {
+        Box::pin(async {
+            let next = self.0.fetch_add(1, Ordering::SeqCst) + 1;
+            let mut headers = HeaderMap::new();
+            headers.insert(
+                http::header::AUTHORIZATION,
+                HeaderValue::from_str(&format!("Bearer non-credential-{next}")).unwrap(),
+            );
+            Ok(headers)
+        })
+    }
+}
+
+fn provider(base: String) -> Provider {
+    let mut headers = HeaderMap::new();
+    headers.insert("x-routing", HeaderValue::from_static("default"));
+    headers.insert("x-omit", HeaderValue::from_static("default"));
+    Provider {
+        name: "request-transport-control".into(),
+        base_url: base,
+        query_params: Some(HashMap::from([("dup".into(), "provider".into())])),
+        headers,
+        retry: RetryConfig {
+            max_attempts: 1,
+            base_delay: Duration::from_millis(1),
+            retry_429: false,
+            retry_5xx: false,
+            retry_transport: false,
+        },
+        stream_idle_timeout: Duration::from_secs(5),
+    }
+}
+
+#[tokio::test]
+async fn request_overrides_reach_the_wire_without_replacing_provider_defaults_or_credentials() {
+    let server = MockServer::start().await;
+    Mock::given(wiremock::matchers::method("POST"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({"ok":true})))
+        .expect(2)
+        .mount(&server)
+        .await;
+    let provider = provider(format!("{}/v1?keep=one&keep=two&dup=base", server.uri()));
+    let auth = Arc::new(RefreshingAuth(AtomicUsize::new(0)));
+    let transport = ReqwestTransport::from_http_client(
+        codex_http_client::HttpClientBuilder::new()
+            .build_direct()
+            .unwrap(),
+    );
+    let overrides: RequestTransportOverrides = serde_json::from_value(json!({
+        "headers":{"x-routing":"request", "x-omit":null},
+        "query":{"dup":"request","count":2,"filter":{"enabled":true},"tags":["one","two"],"empty":null}
+    })).unwrap();
+    for overrides in [Some(&overrides), None] {
+        let mut request = provider.build_request(Method::POST, "/responses");
+        let prepared = prepare_request_transport(&request.url, overrides).unwrap();
+        prepared.apply(&mut request);
+        // The same native credential owner resolves after request preferences.
+        let request = auth.apply_auth(request).await.unwrap();
+        transport.execute(request).await.unwrap();
+    }
+    let requests = server.received_requests().await.unwrap();
+    assert_eq!(requests.len(), 2);
+    let first = &requests[0];
+    assert_eq!(first.url.path(), "/v1/responses");
+    let query = first.url.query_pairs().into_owned().collect::<Vec<_>>();
+    assert_eq!(
+        query
+            .iter()
+            .filter(|(key, _)| key == "keep")
+            .map(|(_, v)| v.as_str())
+            .collect::<Vec<_>>(),
+        ["one", "two"]
+    );
+    assert_eq!(
+        query
+            .iter()
+            .filter(|(key, _)| key == "dup")
+            .map(|(_, v)| v.as_str())
+            .collect::<Vec<_>>(),
+        ["request"]
+    );
+    assert!(query.contains(&("count".into(), "2".into())));
+    assert!(query.contains(&("filter[enabled]".into(), "true".into())));
+    assert_eq!(
+        query
+            .iter()
+            .filter(|(key, _)| key == "tags[]")
+            .map(|(_, v)| v.as_str())
+            .collect::<Vec<_>>(),
+        ["one", "two"]
+    );
+    assert!(!query.iter().any(|(key, _)| key == "empty"));
+    assert_eq!(first.headers["x-routing"], "request");
+    assert!(!first.headers.contains_key("x-omit"));
+    assert_eq!(
+        first.headers[http::header::AUTHORIZATION],
+        "Bearer non-credential-1"
+    );
+    let second = &requests[1];
+    assert_eq!(second.headers["x-routing"], "default");
+    assert_eq!(second.headers["x-omit"], "default");
+    assert_eq!(
+        second.headers[http::header::AUTHORIZATION],
+        "Bearer non-credential-2"
+    );
+    assert_eq!(auth.0.load(Ordering::SeqCst), 2);
+    assert_eq!(provider.headers["x-routing"], "default");
+    assert!(
+        second
+            .url
+            .query_pairs()
+            .any(|(key, value)| key == "dup" && value == "provider")
+    );
+}
+
+#[test]
+fn javascript_null_and_python_none_keep_their_query_distinction() {
+    for (empty, expected) in [(false, false), (true, true)] {
+        let overrides: RequestTransportOverrides = serde_json::from_value(json!({
+            "query":{"old":null},"query_nulls_as_empty":empty
+        }))
+        .unwrap();
+        let provider = provider("https://example.invalid/v1?old=default&keep=value".into());
+        let mut request = provider.build_request(Method::POST, "/responses");
+        prepare_request_transport(&request.url, Some(&overrides))
+            .unwrap()
+            .apply(&mut request);
+        let url = url::Url::parse(&request.url).unwrap();
+        assert_eq!(
+            url.query_pairs()
+                .any(|(key, value)| key == "old" && value.is_empty()),
+            expected
+        );
+        assert!(
+            url.query_pairs()
+                .any(|(key, value)| key == "keep" && value == "value")
+        );
+    }
+}
+
+#[test]
+fn native_auth_protocol_and_private_hop_headers_cannot_be_set_or_omitted() {
+    for name in [
+        "Authorization",
+        "api-key",
+        "x-codex-turn-state",
+        "x-sdk-sentinel-grant",
+        "Host",
+        "Sec-WebSocket-Key",
+    ] {
+        for value in [json!("replacement"), serde_json::Value::Null] {
+            let overrides: RequestTransportOverrides = serde_json::from_value(json!({
+                "headers":{name:value}
+            }))
+            .unwrap();
+            assert!(
+                prepare_request_transport("https://example.invalid/responses", Some(&overrides))
+                    .is_err(),
+                "{name}"
+            );
+        }
+    }
+    let overrides: RequestTransportOverrides = serde_json::from_value(json!({
+        "headers":{"x-private":"non-credential-value"}, "query":{"tenant":"private-routing-value"}
+    }))
+    .unwrap();
+    let debug = format!("{overrides:?}");
+    assert!(!debug.contains("non-credential-value"));
+    assert!(!debug.contains("private-routing-value"));
+}
+
+#[tokio::test]
+async fn responses_client_applies_transport_automatically_before_native_auth() {
+    let server = MockServer::start().await;
+    Mock::given(wiremock::matchers::method("POST"))
+        .respond_with(ResponseTemplate::new(200).set_body_string(
+            "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"output\":[]}}\n\n",
+        ))
+        .expect(2)
+        .mount(&server)
+        .await;
+    let auth = Arc::new(RefreshingAuth(AtomicUsize::new(0)));
+    let overrides = serde_json::from_value(json!({
+        "headers":{"x-routing":"request", "x-omit":null},
+        "query":{"dup":"request", "empty":null}, "query_nulls_as_empty":true
+    }))
+    .unwrap();
+    for overrides in [Some(overrides), None] {
+        let transport = ReqwestTransport::from_http_client(
+            codex_http_client::HttpClientBuilder::new()
+                .build_direct()
+                .unwrap(),
+        );
+        let client = codex_api::ResponsesClient::new(
+            transport,
+            provider(format!("{}/v1?keep=base", server.uri())),
+            auth.clone(),
+        )
+        .with_request_transport(overrides);
+        let _stream = client
+            .stream(
+                json!({"model":"test", "stream":true}),
+                HeaderMap::new(),
+                codex_api::Compression::None,
+                None,
+            )
+            .await
+            .unwrap();
+    }
+    let requests = server.received_requests().await.unwrap();
+    assert_eq!(requests[0].url.path(), "/v1/responses");
+    let pairs = requests[0]
+        .url
+        .query_pairs()
+        .into_owned()
+        .collect::<Vec<_>>();
+    assert!(pairs.contains(&("keep".into(), "base".into())));
+    assert!(pairs.contains(&("dup".into(), "request".into())));
+    assert!(pairs.contains(&("empty".into(), "".into())));
+    assert_eq!(requests[0].headers["x-routing"], "request");
+    assert!(!requests[0].headers.contains_key("x-omit"));
+    assert_eq!(
+        requests[0].headers["authorization"],
+        "Bearer non-credential-1"
+    );
+    assert_eq!(
+        requests[1].headers["authorization"],
+        "Bearer non-credential-2"
+    );
+    assert_eq!(requests[1].headers["x-routing"], "default");
+    assert_eq!(requests[1].headers["x-omit"], "default");
+    assert_eq!(
+        serde_json::from_slice::<serde_json::Value>(&requests[0].body).unwrap(),
+        json!({"model":"test", "stream":true})
+    );
+}
+
+struct StaticAuth;
+impl AuthProvider for StaticAuth {
+    fn add_auth_headers(&self, headers: &mut HeaderMap) {
+        headers.insert(
+            http::header::AUTHORIZATION,
+            HeaderValue::from_static("Bearer native-owner"),
+        );
+    }
+}
+
+#[tokio::test]
+async fn websocket_client_applies_transport_to_real_handshake_before_native_auth() {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let (send, received) = tokio::sync::oneshot::channel();
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        let mut send = Some(send);
+        let mut config = tungstenite::protocol::WebSocketConfig::default();
+        config.extensions.permessage_deflate = Some(tungstenite::extensions::compression::deflate::DeflateConfig::default());
+        let _socket = tokio_tungstenite::accept_hdr_async_with_config(
+            stream,
+            move |request: &tungstenite::handshake::server::Request, response| {
+                send.take().unwrap().send(request.clone()).unwrap();
+                Ok(response)
+            },
+            Some(config),
+        )
+        .await
+        .unwrap();
+    });
+    let overrides = serde_json::from_value(json!({
+        "headers":{"x-routing":"request", "x-omit":null},
+        "query":{"dup":"request", "empty":null}, "query_nulls_as_empty":true
+    }))
+    .unwrap();
+    let factory = codex_http_client::HttpClientFactory::new(
+        codex_http_client::OutboundProxyPolicy::ReqwestDefault,
+    );
+    let client = codex_api::ResponsesWebsocketClient::new(
+        provider(format!("http://{address}/v1?keep=base")),
+        Arc::new(StaticAuth),
+    )
+    .with_request_transport(Some(overrides));
+    let connection = client
+        .connect(&factory, HeaderMap::new(), HeaderMap::new(), None, None)
+        .await
+        .unwrap();
+    let request = received.await.unwrap();
+    assert_eq!(request.uri().path(), "/v1/responses");
+    assert!(request.uri().query().unwrap().contains("dup=request"));
+    assert!(request.uri().query().unwrap().contains("keep=base"));
+    assert!(request.uri().query().unwrap().contains("empty="));
+    assert_eq!(request.headers()["x-routing"], "request");
+    assert!(!request.headers().contains_key("x-omit"));
+    assert_eq!(request.headers()["authorization"], "Bearer native-owner");
+    drop(connection);
+    server.await.unwrap();
+}
