+//! Captured, request-scoped transport preferences. These never supply native credentials.
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, BTreeSet};
+use ts_rs::TS;
+
+#[derive(Clone, Default, Deserialize, Serialize, PartialEq, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct RequestTransportOverrides {
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, type = "Record<string, string | null> | null")]
+    #[schemars(with = "Option<BTreeMap<String, Option<String>>>")]
+    pub headers: Option<Option<BTreeMap<String, Option<String>>>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, type = "Record<string, unknown> | null")]
+    #[schemars(with = "Option<BTreeMap<String, serde_json::Value>>")]
+    pub query: Option<Option<BTreeMap<String, serde_json::Value>>>,
+    /// The JavaScript SDK encodes null as an empty query value; Python omits None.
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub query_nulls_as_empty: bool,
+}
+
+// Like Provider's Debug implementation, retain names while withholding routing values.
+impl std::fmt::Debug for RequestTransportOverrides {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("RequestTransportOverrides")
+            .field(
+                "headers",
+                &self
+                    .headers
+                    .as_ref()
+                    .and_then(Option::as_ref)
+                    .map(|values| values.keys().collect::<Vec<_>>()),
+            )
+            .field(
+                "query",
+                &self
+                    .query
+                    .as_ref()
+                    .and_then(Option::as_ref)
+                    .map(|values| values.keys().collect::<Vec<_>>()),
+            )
+            .field("query_nulls_as_empty", &self.query_nulls_as_empty)
+            .finish()
+    }
+}
+
+impl RequestTransportOverrides {
+    pub fn apply_patch(&mut self, patch: &Self) {
+        if patch.headers.is_some() {
+            self.headers = patch.headers.clone();
+        }
+        if patch.query.is_some() {
+            self.query = patch.query.clone();
+            self.query_nulls_as_empty = patch.query_nulls_as_empty;
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), String> {
+        const RESERVED: &[&str] = &[
+            "authorization",
+            "proxy-authorization",
+            "api-key",
+            "cookie",
+            "host",
+            "connection",
+            "upgrade",
+            "content-length",
+            "transfer-encoding",
+            "te",
+            "trailer",
+            "keep-alive",
+            "proxy-connection",
+            "content-type",
+            "accept",
+            "accept-encoding",
+            "user-agent",
+            "openai-beta",
+            "originator",
+            "session_id",
+            "x-client-request-id",
+            "x-request-id",
+            "chatgpt-account-id",
+            "openai-organization",
+            "openai-project",
+            "x-responsesapi-include-timing-metrics",
+            "x-sdk-sentinel-grant",
+        ];
+        let mut seen = BTreeSet::new();
+        if let Some(Some(headers)) = &self.headers {
+            for (name, value) in headers {
+                let lower = name.to_ascii_lowercase();
+                if name.is_empty()
+                    || !name.bytes().all(|byte| {
+                        byte.is_ascii_alphanumeric() || b"!#$%&'*+-.^_`|~".contains(&byte)
+                    })
+                    || RESERVED.contains(&lower.as_str())
+                    || ["sec-websocket-", "x-codex-", "x-openai-"]
+                        .iter()
+                        .any(|prefix| lower.starts_with(prefix))
+                    || !seen.insert(lower)
+                {
+                    return Err("request header name is invalid, duplicated, or owned by native transport/auth".into());
+                }
+                if value
+                    .as_ref()
+                    .is_some_and(|value| !value.bytes().all(|byte| (0x20..=0x7e).contains(&byte)))
+                {
+                    return Err("request header values must contain printable ASCII".into());
+                }
+            }
+        }
+        if self.query_nulls_as_empty && self.query.is_none() {
+            return Err("query null behavior requires an explicit query patch".into());
+        }
+        if let Some(Some(query)) = &self.query {
+            if query.keys().any(String::is_empty) {
+                return Err("request query names must be nonempty".into());
+            }
+        }
+        Ok(())
+    }
+}
