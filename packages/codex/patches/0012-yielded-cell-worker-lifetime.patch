+    session: std::sync::Weak<Session>,
+    step_context: std::sync::Weak<StepContext>,
+    tracker: SharedTurnDiffTracker,
+    parallel_execution: Arc<RwLock<()>>,
+}
+impl WeakToolCallRuntime {
+    pub(crate) fn belongs_to(&self, step_context: &Arc<StepContext>) -> bool {
+        std::sync::Weak::ptr_eq(&self.step_context, &Arc::downgrade(step_context))
+    }
+    pub(crate) fn upgrade(&self) -> Option<(Arc<Session>, Arc<StepContext>, ToolCallRuntime)> {
+        let session = self.session.upgrade()?;
+        let step_context = self.step_context.upgrade()?;
+        let runtime = ToolCallRuntime {
+            session: Arc::clone(&session),
+            step_context: Arc::clone(&step_context),
+            tracker: Arc::clone(&self.tracker),
+            parallel_execution: Arc::clone(&self.parallel_execution),
+        };
+        Some((session, step_context, runtime))
+    }
+}
