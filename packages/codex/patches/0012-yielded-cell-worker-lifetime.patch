+    let (release_tx, release_rx) = oneshot::channel();
+    let physical = Arc::clone(&receipt);
+    let response = broker
+        .spawn(&receipt, &cell_id, async move {
+            physical.closed.cancelled().await;
+            let _ = entered_tx.send(());
+            let _ = release_rx.await;
+        })
+        .unwrap();
+    broker.close_receipt(&receipt);
+    entered_rx.await.unwrap();
+    let mut first_join = Box::pin(receipt.join());
+    assert!(futures::poll!(first_join.as_mut()).is_pending());
+    drop(first_join);
+    drop(delegate);
+    assert!(
+        broker.receipt(&cell_id).is_some(),
+        "retired physical work must remain reachable"
+    );
+    let late_ran = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let late_effect = Arc::clone(&late_ran);
+    assert!(
+        broker
+            .spawn(&receipt, &cell_id, async move {
+                late_effect.store(true, std::sync::atomic::Ordering::SeqCst);
+            })
+            .is_err()
+    );
+    let mut retry_join = Box::pin(receipt.join());
+    assert!(futures::poll!(retry_join.as_mut()).is_pending());
+    release_tx.send(()).unwrap();
+    retry_join.await.unwrap();
+    response.await.unwrap();
+    assert!(!late_ran.load(std::sync::atomic::Ordering::SeqCst));
+    assert!(receipt.tasks.is_empty());
+}
