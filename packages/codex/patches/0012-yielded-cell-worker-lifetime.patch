+struct StartupBackend {
+    start_entered: CancellationToken,
+    start_release: CancellationToken,
+    initial_entered: CancellationToken,
+    initial_release: CancellationToken,
+    terminate_entered: CancellationToken,
+    terminate_release: CancellationToken,
+    terminated: Mutex<Vec<CellId>>,
+    delegate: Mutex<Option<Arc<dyn CodeModeSessionDelegate>>>,
+    fast_terminal: bool,
+    fail_terminate: bool,
+    wait_error: bool,
+    yielded: bool,
+}
+impl StartupBackend {
+    fn new(fast_terminal: bool) -> Self {
+        Self {
+            start_entered: CancellationToken::new(),
+            start_release: CancellationToken::new(),
+            initial_entered: CancellationToken::new(),
+            initial_release: CancellationToken::new(),
+            terminate_entered: CancellationToken::new(),
+            terminate_release: CancellationToken::new(),
+            terminated: Mutex::default(),
+            delegate: Mutex::default(),
+            fast_terminal,
+            fail_terminate: false,
+            wait_error: false,
+            yielded: false,
+        }
+    }
+}
+impl codex_code_mode::CodeModeSession for StartupBackend {
+    fn execute<'a>(
+        &'a self,
+        _: codex_code_mode::ExecuteRequest,
+        delegate: Arc<dyn CodeModeSessionDelegate>,
+        _: Option<CancellationToken>,
+    ) -> codex_code_mode::CodeModeSessionResultFuture<'a, codex_code_mode::StartedCell> {
+        Box::pin(async move {
+            self.start_entered.cancel();
+            self.start_release.cancelled().await;
+            let id = CellId::new("claimed-cell".into());
+            if self.fast_terminal {
+                delegate.cell_closed(&id);
+            }
+            *self.delegate.lock().unwrap() = Some(delegate);
+            let entered = self.initial_entered.clone();
+            let release = self.initial_release.clone();
+            let yielded = self.yielded;
+            Ok(codex_code_mode::StartedCell::from_future(
+                id.clone(),
+                async move {
+                    entered.cancel();
+                    release.cancelled().await;
+                    if yielded {
+                        return Ok(codex_code_mode::RuntimeResponse::Yielded {
+                            cell_id: id,
+                            content_items: Vec::new(),
+                            code_mode_host_duration: Some(std::time::Duration::ZERO),
+                        });
+                    }
+                    Ok(codex_code_mode::RuntimeResponse::Result {
+                        cell_id: id,
+                        content_items: Vec::new(),
+                        error_text: None,
+                        code_mode_host_duration: Some(std::time::Duration::ZERO),
+                    })
+                },
+            ))
+        })
+    }
+    fn wait<'a>(
+        &'a self,
+        _: codex_code_mode::WaitRequest,
+        _: Option<CancellationToken>,
+    ) -> codex_code_mode::CodeModeSessionResultFuture<'a, codex_code_mode::WaitOutcome> {
+        Box::pin(async move {
+            if self.wait_error {
+                Err("backend wait failed".into())
+            } else {
+                panic!("this test does not issue wait")
+            }
+        })
+    }
+    fn terminate<'a>(
+        &'a self,
+        cell_id: CellId,
+    ) -> codex_code_mode::CodeModeSessionResultFuture<'a, codex_code_mode::WaitOutcome> {
+        Box::pin(async move {
+            self.terminated.lock().unwrap().push(cell_id.clone());
+            self.terminate_entered.cancel();
+            self.terminate_release.cancelled().await;
+            if self.fail_terminate {
+                return Err("backend cleanup failed".into());
+            }
+            if let Some(delegate) = self.delegate.lock().unwrap().take() {
+                delegate.cell_closed(&cell_id);
+            }
+            Ok(codex_code_mode::WaitOutcome::MissingCell(
+                codex_code_mode::RuntimeResponse::Terminated {
+                    cell_id,
+                    content_items: Vec::new(),
+                    code_mode_host_duration: Some(std::time::Duration::ZERO),
+                },
+            ))
+        })
+    }
+    fn shutdown<'a>(&'a self) -> codex_code_mode::CodeModeSessionResultFuture<'a, ()> {
+        Box::pin(async { Ok(()) })
+    }
+}
+fn startup_request() -> codex_code_mode::ExecuteRequest {
+    codex_code_mode::ExecuteRequest {
+        tool_call_id: "start".into(),
+        enabled_tools: Vec::new(),
+        source: "text('done')".into(),
+        yield_time_ms: None,
+        max_output_tokens: None,
+    }
+}
