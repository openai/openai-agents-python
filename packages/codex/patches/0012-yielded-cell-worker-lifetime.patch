+        inner.initial_release.cancel();
+        let backend = Arc::new(PreparedStartupBackend {
+            inner,
+            issuing_tasks: Mutex::default(),
+            captures: Arc::default(),
+            close_on_capture: None,
+        });
+        let issuing_task = tokio::task::id();
+        let started = broker
+            .execute(backend.clone(), startup_request(), delegate, None)
+            .await
+            .unwrap();
+        assert_eq!(*backend.issuing_tasks.lock().unwrap(), vec![issuing_task]);
+        assert!(matches!(
+            started.initial_response().await.unwrap(),
+            codex_code_mode::RuntimeResponse::Result { .. }
+        ));
+        receipt.join().await.unwrap();
+        assert_eq!(
+            backend.captures.load(std::sync::atomic::Ordering::SeqCst),
+            0
+        );
+        assert!(backend.inner.terminated.lock().unwrap().is_empty());
+    })
+    .await
+    .unwrap();
+}
+
+#[tokio::test]
+async fn close_during_owned_capture_drops_unpolled_start_without_backend_effect() {
+    tokio::spawn(async {
+        let (session, turn) = make_session_and_context().await;
+        let session = Arc::new(session);
+        let step = StepContext::for_test(Arc::new(turn));
+        let broker = Arc::new(CodeModeDispatchBroker::new(
+            session.thread_id,
+            Default::default(),
+        ));
+        broker.bind_step_runtime(
+            Arc::clone(&session),
+            Arc::clone(&step),
+            Arc::new(tokio::sync::Mutex::new(TurnDiffTracker::new())),
+        );
+        let delegate = broker.delegate(step).unwrap();
+        let receipt = Arc::clone(&delegate.receipt);
+        let backend = Arc::new(PreparedStartupBackend {
+            inner: Arc::new(StartupBackend::new(false)),
+            issuing_tasks: Mutex::default(),
+            captures: Arc::default(),
+            close_on_capture: Some((Arc::clone(&broker), Arc::clone(&receipt))),
+        });
+        let result = broker
+            .execute(backend.clone(), startup_request(), delegate, None)
+            .await;
+        assert_eq!(
+            result.err().as_deref(),
+            Some("code mode execution was interrupted before startup")
+        );
+        assert_eq!(
+            *backend.issuing_tasks.lock().unwrap(),
+            vec![tokio::task::id()]
+        );
+        assert!(!backend.inner.start_entered.is_cancelled());
+        assert!(backend.inner.terminated.lock().unwrap().is_empty());
+        assert_eq!(
+            backend.captures.load(std::sync::atomic::Ordering::SeqCst),
+            0
+        );
+        assert!(!receipt.startup.load(std::sync::atomic::Ordering::Acquire));
+        receipt.join().await.unwrap();
+    })
+    .await
+    .unwrap();
 }
