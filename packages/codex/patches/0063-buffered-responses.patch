@@ -0,0 +1,522 @@
+use super::*;
+use bytes::Bytes;
+use codex_client::TransportError;
+use futures::Stream;
+use http::HeaderMap;
+use http::StatusCode;
+use serde_json::json;
+use std::pin::Pin;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::task::{Context, Poll};
+
+type Events = Vec<Result<ResponseEvent, ApiError>>;
+
+// Even absent quota headers emit Core's explicit default-reset snapshot. Do not
+// discard arbitrary events: every fixture here expects this exact header prefix.
+fn default_header_reset(event: Option<&Result<ResponseEvent, ApiError>>) -> bool {
+    matches!(event, Some(Ok(ResponseEvent::RateLimits(
+        codex_protocol::protocol::RateLimitSnapshot {
+            limit_id: Some(id), limit_name: None, normal_model_slug: None,
+            primary: None, secondary: None, credits: None, individual_limit: None,
+            spend_control_reached: None, plan_type: None, rate_limit_reached_type: None,
+        }
+    ))) if id == "codex")
+}
+fn terminal(status: &str, output: Value) -> Value {
+    json!({"id":"resp-json","status":status,"output":output,"usage":{
+        "input_tokens":10,"output_tokens":4,"total_tokens":14,
+        "input_tokens_details":{"cached_tokens":2},"output_tokens_details":{"reasoning_tokens":1}}})
+}
+fn message(id: &str, text: &str) -> Value {
+    json!({"type":"message","id":id,"role":"assistant","phase":"final_answer", "content":[
+        {"type":"output_text","text":text,"annotations":[{"type":"url_citation","url":"https://example.com","start_index":0,"end_index":1,"title":"source"}]}]})
+}
+fn from_bytes(body: Vec<u8>) -> BoxStream<'static, Result<ResponseEvent, ApiError>> {
+    response_stream(
+        StreamResponse {
+            status: StatusCode::OK,
+            headers: HeaderMap::new(),
+            bytes: Box::pin(futures::stream::iter([Ok(Bytes::from(body))])),
+        },
+        Duration::from_secs(5),
+        None,
+    )
+    .1
+}
+async fn collect(value: Value) -> Events {
+    tokio::time::timeout(
+        Duration::from_secs(5),
+        from_bytes(serde_json::to_vec(&value).unwrap()).collect(),
+    )
+    .await
+    .expect("lazy projection must settle")
+}
+#[tokio::test]
+async fn unicode_multi_item_blank_tail_and_citations_retain_full_done_items() {
+    let first = message("msg-first", "Résumé 👋\n終わり");
+    let last = message("msg-last", " \n");
+    let events = collect(terminal("completed", json!([first.clone(), last.clone()]))).await;
+    let text: Vec<_> = events
+        .iter()
+        .filter_map(|e| match e {
+            Ok(ResponseEvent::OutputTextDelta(s)) => Some(s.as_str()),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(text, ["Résumé 👋\n終わり", " \n"]);
+    let done: Vec<_> = events
+        .iter()
+        .filter_map(|e| match e {
+            Ok(ResponseEvent::OutputItemDone(item)) => Some(serde_json::to_value(item).unwrap()),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(done, [first, last]);
+    assert!(
+        events
+            .iter()
+            .filter_map(|e| match e {
+                Ok(ResponseEvent::OutputItemAdded(ResponseItem::Message { content, .. })) =>
+                    Some(content),
+                _ => None,
+            })
+            .all(Vec::is_empty)
+    );
+    assert!(
+        matches!(events.last(), Some(Ok(ResponseEvent::Completed {response_id,..})) if response_id=="resp-json")
+    );
+}
+#[tokio::test]
+async fn complete_received_facts_precede_late_refusal_without_earlier_tool_effect() {
+    let call = json!({"type":"function_call","id":"fc-first","call_id":"call-first","name":"f","arguments":"{}"});
+    let refusal = json!({"type":"message","role":"assistant","content":[{"type":"refusal","refusal":"unsupported"}]});
+    let events = collect(terminal("completed", json!([call, refusal]))).await;
+    assert!(default_header_reset(events.first()));
+    let events = &events[1..];
+    assert_eq!(events.len(), 3);
+    assert!(
+        matches!(&events[0], Ok(ResponseEvent::Created {response_id: Some(id)}) if id == "resp-json")
+    );
+    assert!(
+        matches!(&events[1], Ok(ResponseEvent::ResponseObserved(observation)) if observation.response_id.as_deref()==Some("resp-json") && observation.usage.as_ref().is_some_and(|u| u.total_tokens==Some(14) && u.cached_input_tokens==Some(2)))
+    );
+    assert!(!events.iter().any(|e| matches!(
+        e,
+        Ok(ResponseEvent::OutputItemAdded(_) | ResponseEvent::OutputItemDone(_))
+    )));
+    assert!(matches!(
+        events.last(),
+        Some(Err(ApiError::ResponseIntegrity {
+            reason: ResponseIntegrityReason::UndecodableOutputItem
+        }))
+    ));
+}
+#[tokio::test]
+async fn terminal_error_precedes_bad_items_and_interruption_retains_real_partial_output() {
+    for (status, reason) in [
+        ("failed", "context_length_exceeded"),
+        ("incomplete", "content_filter"),
+        ("incomplete", "max_output_tokens"),
+    ] {
+        let mut body = terminal(status, json!([{"type":"message","content":"malformed"}]));
+        if status == "failed" {
+            body["error"] = json!({"code":reason,"message":"synthetic rejection"});
+        } else {
+            body["incomplete_details"] = json!({"reason":reason});
+        }
+        let events = collect(body).await;
+        assert!(default_header_reset(events.first()));
+        let events = &events[1..];
+        assert_eq!(events.len(), 3);
+        assert!(
+            matches!(&events[0], Ok(ResponseEvent::Created {response_id: Some(id)}) if id == "resp-json")
+        );
+        assert!(matches!(&events[1], Ok(ResponseEvent::ResponseObserved(_))));
+        match reason {
+            "context_length_exceeded" => assert!(matches!(
+                events.last(),
+                Some(Err(ApiError::ContextWindowExceeded))
+            )),
+            "content_filter" => {
+                assert!(matches!(events.last(), Some(Err(ApiError::ContentFilter))))
+            }
+            _ => assert!(
+                matches!(events.last(),Some(Err(ApiError::Stream(message))) if message.contains("max_output_tokens"))
+            ),
+        }
+        assert!(
+            !events
+                .iter()
+                .any(|e| matches!(e, Ok(ResponseEvent::OutputItemAdded(_))))
+        );
+    }
+    for status in ["incomplete", "completed"] {
+        let mut body = terminal(status, json!([message("msg-partial", "partial")]));
+        body["incomplete_details"] = json!({"reason":"interrupted"});
+        body["end_turn"] = json!(false);
+        let events = collect(body).await;
+        assert!(
+            events
+                .iter()
+                .any(|e| matches!(e,Ok(ResponseEvent::OutputTextDelta(text)) if text=="partial"))
+        );
+        assert!(matches!(
+            events.last(),
+            Some(Ok(ResponseEvent::Completed {
+                end_turn: Some(false),
+                ..
+            }))
+        ));
+    }
+}
+#[tokio::test]
+async fn reasoning_projection_preserves_summary_indices_raw_content_and_encrypted_done() {
+    let reasoning = json!({"type":"reasoning","id":"rs-real","summary":[{"type":"summary_text","text":"first"},{"type":"summary_text","text":"second"}],
+        "content":[{"type":"reasoning_text","text":"raw one"},{"type":"text","text":"raw two"}],"encrypted_content":"opaque"});
+    let events = collect(terminal(
+        "completed",
+        json!([reasoning.clone(), message("msg-answer", "answer")]),
+    ))
+    .await;
+    assert!(events.iter().any(|e| matches!(e,Ok(ResponseEvent::OutputItemAdded(ResponseItem::Reasoning {summary,content:None,encrypted_content:None,..})) if summary.is_empty())));
+    for (index, text) in [(0, "first"), (1, "second")] {
+        assert!(events.iter().any(|e| matches!(e,Ok(ResponseEvent::ReasoningSummaryPartAdded {summary_index}) if *summary_index==index)));
+        assert!(events.iter().any(|e| matches!(e,Ok(ResponseEvent::ReasoningSummaryDelta {summary_index,delta}) if *summary_index==index && delta==text)));
+        assert!(events.iter().any(|e| matches!(e,Ok(ResponseEvent::ReasoningSummaryDone {item_id,summary_index,text:actual}) if item_id=="rs-real" && *summary_index==index && actual==text)));
+    }
+    let raw: Vec<_> = events
+        .iter()
+        .filter_map(|e| match e {
+            Ok(ResponseEvent::ReasoningContentDelta {
+                delta,
+                content_index,
+            }) => Some((*content_index, delta.as_str())),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(raw, [(0, "raw one"), (1, "raw two")]);
+    assert!(events.iter().any(|e| matches!(e,Ok(ResponseEvent::OutputItemDone(item @ ResponseItem::Reasoning {..})) if serde_json::to_value(item).unwrap()==reasoning)));
