index 0000000000000000000000000000000000000000..5d544f8c6ceb711d7d635583e82194782711dd1b
--- /dev/null
+++ b/codex-rs/codex-api/src/endpoint/responses_json.rs
@@ -0,0 +1,209 @@
+//! Lazy buffered Responses ingress. The caller's mapper owns and polls the body.
+use crate::api_rate_limits::parse_api_rate_limits;
+use crate::common::ResponseEvent;
+use crate::error::ApiError;
+use crate::rate_limits::parse_all_rate_limits;
+use crate::sse::ResponsesStreamEvent;
+use crate::sse::process_responses_event;
+use codex_client::StreamResponse;
+use codex_protocol::error::ResponseIntegrityReason;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ReasoningItemContent;
+use codex_protocol::models::ReasoningItemReasoningSummary;
+use codex_protocol::models::ResponseItem;
+use futures::StreamExt;
+use futures::stream::BoxStream;
+use serde_json::Value;
+use std::sync::Arc;
+use std::sync::OnceLock;
+use std::time::Duration;
+
+pub(super) fn response_stream(
+    response: StreamResponse,
+    idle_timeout: Duration,
+    turn_state: Option<Arc<OnceLock<String>>>,
+) -> (
+    Option<String>,
+    BoxStream<'static, Result<ResponseEvent, ApiError>>,
+) {
+    let headers = response.headers;
+    let request_id = headers
+        .get("x-request-id")
+        .and_then(|v| v.to_str().ok())
+        .map(str::to_owned);
+    if let Some(turn_state) = turn_state
+        && let Some(value) = headers
+            .get("x-codex-turn-state")
+            .and_then(|v| v.to_str().ok())
+    {
+        let _ = turn_state.set(value.to_owned());
+    }
+    let events = async_stream::try_stream! {
+        if let Some(model) = headers.get("openai-model").and_then(|v| v.to_str().ok()) {
+            yield ResponseEvent::ServerModel(model.to_owned());
+        }
+        for snapshot in parse_all_rate_limits(&headers) {
+            yield ResponseEvent::RateLimits(snapshot);
+        }
+        if let Some(snapshot) = parse_api_rate_limits(&headers) {
+            yield ResponseEvent::ApiRateLimits(snapshot);
+        }
+        if let Some(etag) = headers.get("x-models-etag").and_then(|v| v.to_str().ok()) {
+            yield ResponseEvent::ModelsEtag(etag.to_owned());
+        }
+        if headers.contains_key("x-reasoning-included") {
+            yield ResponseEvent::ServerReasoningIncluded(true);
+        }
+        let mut bytes = response.bytes;
+        let mut body = Vec::new();
+        loop {
+            let next = tokio::time::timeout(idle_timeout, bytes.next())
+                .await
+                .map_err(|_| ApiError::Stream("idle timeout waiting for Responses JSON".into()))?;
+            let Some(next) = next else {
+                break;
+            };
+            let chunk = next.map_err(|error| match error {
+                error @ codex_client::TransportError::Policy(_) => ApiError::Transport(error),
+                error => ApiError::Stream(error.to_string()),
+            })?;
+            body.extend_from_slice(&chunk);
+        }
+        let mut response: Value = serde_json::from_slice(&body)
+            .map_err(|error| ApiError::Stream(format!("failed to decode Responses JSON: {error}")))?;
+        drop(body);
+        // Move output aside without validating it or cloning the large body.
+        let output = response
+            .as_object_mut()
+            .and_then(|object| object.remove("output"));
+        let response_id = response
+            .get("id")
+            .and_then(Value::as_str)
+            .map(str::to_owned);
+        let terminal = ResponsesStreamEvent::from_json_response(response)?;
+        yield ResponseEvent::Created { response_id };
+        if let Some(observation) = terminal.response_observation() {
+            yield ResponseEvent::ResponseObserved(observation);
+        }
+        if let Some(model) = terminal.response_model() {
+            yield ResponseEvent::ServerModel(model);
+        }
+        if let Some(limits) = terminal.api_rate_limits() {
+            yield ResponseEvent::ApiRateLimits(limits);
+        }
+        // A known terminal rejection precedes local output conversion or policy
+        // interception. The mapper acknowledges the genuine observation first.
+        let completed = process_responses_event(terminal).map_err(|error| error.into_api_error())?;
+        let output = match output {
+            Some(Value::Array(output)) => output,
+            _ => Err(invalid_item())?,
+        };
+        // Decode the whole available body before any tool can run. Per-item
+        // authorization still belongs to the existing ordered interceptors.
+        let output = output
+            .into_iter()
+            .map(|raw| serde_json::from_value::<ResponseItem>(raw).map_err(|_| invalid_item()))
+            .collect::<Result<Vec<_>, _>>()?;
+        for item in output {
+            // Added seeds only identity, never full text followed by the same delta.
+            let added = match &item {
+                ResponseItem::Message {
+                    id,
+                    role,
+                    phase,
+                    internal_chat_message_metadata_passthrough,
+                    ..
+                } => ResponseItem::Message {
+                    id: id.clone(),
+                    role: role.clone(),
+                    content: Vec::new(),
+                    phase: phase.clone(),
+                    internal_chat_message_metadata_passthrough:
+                        internal_chat_message_metadata_passthrough.clone(),
+                },
+                ResponseItem::Reasoning {
+                    id,
+                    internal_chat_message_metadata_passthrough,
+                    ..
+                } => ResponseItem::Reasoning {
+                    id: id.clone(),
+                    summary: Vec::new(),
+                    content: None,
+                    encrypted_content: None,
+                    internal_chat_message_metadata_passthrough:
+                        internal_chat_message_metadata_passthrough.clone(),
+                },
+                _ => item.clone(),
+            };
+            yield ResponseEvent::OutputItemAdded(added);
+            match &item {
+                ResponseItem::Message { content, .. } => {
+                    for part in content {
+                        if let ContentItem::OutputText { text, .. } = part {
+                            yield ResponseEvent::OutputTextDelta(text.clone());
+                        }
+                    }
+                }
+                ResponseItem::Reasoning {
+                    id,
+                    summary,
+                    content,
+                    ..
+                } => {
+                    for (index, ReasoningItemReasoningSummary::SummaryText { text }) in
+                        summary.iter().enumerate()
+                    {
+                        let summary_index = index as i64;
+                        yield ResponseEvent::ReasoningSummaryPartAdded { summary_index };
+                        yield ResponseEvent::ReasoningSummaryDelta {
+                            delta: text.clone(),
+                            summary_index,
+                        };
+                        // Sequential-summary models consume Done; ordinary models
+                        // consume Delta instead. Match Core's absent-ID projection.
+                        yield ResponseEvent::ReasoningSummaryDone {
+                            item_id: id.as_deref().unwrap_or_default().to_owned(),
+                            text: text.clone(),
+                            summary_index,
+                        };
+                    }
+                    for (index, part) in content.iter().flatten().enumerate() {
+                        let (ReasoningItemContent::ReasoningText { text }
+                        | ReasoningItemContent::Text { text }) = part;
+                        yield ResponseEvent::ReasoningContentDelta {
+                            delta: text.clone(),
+                            content_index: index as i64,
+                        };
+                    }
+                }
+                ResponseItem::CustomToolCall {
+                    id, call_id, input, ..
+                } => {
+                    yield ResponseEvent::ToolCallInputDelta {
+                        item_id: id.as_deref().unwrap_or(call_id).to_owned(),
+                        call_id: Some(call_id.clone()),
+                        delta: input.clone(),
+                    };
+                }
+                _ => {}
+            }
+            // Full annotations, encrypted reasoning and call arguments travel
+            // through the existing Core history/policy path, not a parallel runner.
+            yield ResponseEvent::OutputItemDone(item);
+        }
+        if let Some(completed) = completed {
+            yield completed;
+        }
+    };
+    (request_id, Box::pin(events))
+}
+
+fn invalid_item() -> ApiError {
+    ApiError::ResponseIntegrity {
+        reason: ResponseIntegrityReason::UndecodableOutputItem,
+    }
+}
+
+#[cfg(test)]
+#[path = "responses_json_tests.rs"]
+mod tests;
