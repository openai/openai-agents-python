+async fn body_timeout_transport_error_and_truncation_are_stream_failures_without_terminal_facts() {
+    let dropped = Arc::new(AtomicBool::new(false));
+    let (_, mut pending) = response_stream(
+        StreamResponse {
+            status: StatusCode::OK,
+            headers: HeaderMap::new(),
+            bytes: Box::pin(PendingBody {
+                polls: Arc::new(AtomicUsize::new(0)),
