+    let reset = pending.next().await;
+    assert!(default_header_reset(reset.as_ref()));
+    assert!(
+        matches!(pending.next().await,Some(Err(ApiError::Stream(message))) if message.contains("idle timeout"))
+    );
+    drop(pending);
+    assert!(dropped.load(Ordering::SeqCst));
+    let (_, events) = response_stream(
+        StreamResponse {
+            status: StatusCode::OK,
+            headers: HeaderMap::new(),
+            bytes: Box::pin(futures::stream::iter([Err(TransportError::Network(
+                "synthetic body failure".into(),
+            ))])),
+        },
+        Duration::from_secs(5),
+        None,
+    );
+    let events: Events = events.collect().await;
+    assert!(default_header_reset(events.first()));
+    assert!(
+        matches!(&events[1..],[Err(ApiError::Stream(message))] if message.contains("synthetic body failure"))
+    );
+    for bytes in [b"{\"id\":\"partial\"".to_vec(), vec![0xff], b"{}".to_vec()] {
+        let events: Events = from_bytes(bytes).collect().await;
+        assert!(default_header_reset(events.first()));
+        assert!(matches!(&events[1..], [Err(ApiError::Stream(_))]));
