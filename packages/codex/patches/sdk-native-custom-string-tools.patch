+/// A Responses custom tool bound to the SDK's current application callback.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct DynamicCustomToolSpec {
+    pub name: String,
+    pub description: String,
+    pub format: DynamicCustomToolFormat,
+    pub input_field: String,
+    pub input_schema: JsonValue,
+    #[serde(default)]
+    pub defer_loading: bool,
+}
+
+impl DynamicCustomToolSpec {
+    pub fn callback_spec(&self) -> DynamicToolFunctionSpec {
+        DynamicToolFunctionSpec {
+            name: self.name.clone(),
+            description: self.description.clone(),
+            input_schema: self.input_schema.clone(),
+            strict: false,
+            defer_loading: self.defer_loading,
+            output_schema: None,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, JsonSchema, TS)]
+#[serde(tag = "type", rename_all = "snake_case", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub enum DynamicCustomToolFormat {
+    Text,
+    Grammar { syntax: String, definition: String },
+}
+
