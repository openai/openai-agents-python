+#[test]
+fn tool_terminal_recovery_held_results_keep_kind_and_outcome_authority() {
+    use codex_history::ResponseItemEnvelope;
+    for custom in [false, true] {
+        let (thread, mut candidates, mut history) = recovered_batch_fixture();
+        let mut output = match history.remove(10) {
+            RolloutItem::ResponseItem(envelope) => envelope,
+            _ => unreachable!(),
+        };
+        if custom {
+            history[5] = RolloutItem::ResponseItem(ResponseItemEnvelope::new(
+                serde_json::from_value(serde_json::json!({
+                    "type":"custom_tool_call", "call_id":"fresh", "name":"answer", "input":"raw",
+                }))
+                .unwrap(),
+            ));
+            output.item = serde_json::from_value(serde_json::json!({
+                "type":"custom_tool_call_output", "call_id":"fresh", "output":"held body",
+            }))
+            .unwrap();
+        }
+        candidates.held_outputs = vec![(output.clone(), true)];
+        let tools =
+            recovered_tools_from_history(&candidates, thread, "recovered", &history).unwrap();
+        assert!(tools.all_succeeded);
+        assert_eq!(tools.outputs[1], output.item);
+
+        // The held channel cannot change the retained call's provider kind.
+        candidates.held_outputs[0].0.item = serde_json::from_value(serde_json::json!({
+            "type": if custom { "function_call_output" } else { "custom_tool_call_output" },
+            "call_id":"fresh", "output":"wrong kind",
+        }))
+        .unwrap();
+        assert!(recovered_tools_from_history(&candidates, thread, "recovered", &history).is_err());
+
+        // An ordinary history record cannot become a held tool receipt.
+        candidates.held_outputs[0].0.item = serde_json::from_value(serde_json::json!({
+            "type":"message", "role":"assistant", "content":[],
+        }))
+        .unwrap();
+        assert!(recovered_tools_from_history(&candidates, thread, "recovered", &history).is_err());
+        candidates.held_outputs = vec![(output.clone(), false)];
+        assert!(recovered_tools_from_history(&candidates, thread, "recovered", &history).is_err());
+        candidates.held_outputs = vec![(output.clone(), true), (output, true)];
+        assert!(recovered_tools_from_history(&candidates, thread, "recovered", &history).is_err());
+    }
+}
