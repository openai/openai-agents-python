 use crate::ResponseItemEnvelope;
 
+/// A constant-size compaction reference, or the legacy complete replacement payload.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(untagged, deny_unknown_fields)]
+pub enum SdkOriginalHistoryCheckpoint {
+    Replace(SdkOriginalHistory),
+    Preserve {
+        #[serde(deserialize_with = "deserialize_preserve")]
+        preserve: bool,
+    },
+}
+
+fn deserialize_preserve<'de, D: Deserializer<'de>>(deserializer: D) -> Result<bool, D::Error> {
+    if bool::deserialize(deserializer)? {
+        Ok(true)
+    } else {
+        Err(serde::de::Error::custom(
+            "original history preservation must be true",
+        ))
+    }
+}
+
+impl SdkOriginalHistoryCheckpoint {
+    pub fn preserve() -> Self {
+        Self::Preserve { preserve: true }
+    }
+
+    pub fn is_preserve(&self) -> bool {
+        matches!(self, Self::Preserve { preserve: true })
+    }
+}
+
+impl From<SdkOriginalHistory> for SdkOriginalHistoryCheckpoint {
+    fn from(history: SdkOriginalHistory) -> Self {
+        Self::Replace(history)
+    }
+}
