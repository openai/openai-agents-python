+// Compare completed native capture, not mutable next-step settings that prefetch can advance.
+// A same-profile refresh retains its span unless an accepted transfer owns this exact epoch.
+fn sdk_agent_entry_changed(
+    previous: Option<&codex_protocol::agent_profile::AgentProfileReceipt>,
+    current: Option<&codex_protocol::agent_profile::AgentProfileReceipt>,
+    handoff: Option<&codex_protocol::agent_profile::AgentProfileHandoff>,
+) -> bool {
+    let (Some(previous), Some(current)) = (previous, current) else {
+        return false;
+    };
+    previous.profile_id != current.profile_id
+        || handoff.is_some_and(|handoff| {
+            &handoff.source == previous && handoff.matches_destination(current)
+        })
+}
+
+#[cfg(test)]
+mod sdk_agent_entry_tests {
+    use super::sdk_agent_entry_changed;
+    use codex_protocol::agent_profile::{AgentProfileHandoff, AgentProfileReceipt};
+
+    fn receipt(id: &str, epoch: u64) -> AgentProfileReceipt {
+        AgentProfileReceipt { profile_id: id.into(), epoch }
+    }
+
+    #[test]
+    fn captured_distinct_profile_starts_an_entry() {
+        assert!(sdk_agent_entry_changed(Some(&receipt("a", 0)), Some(&receipt("b", 1)), None));
+    }
+
+    #[test]
+    fn same_profile_refresh_keeps_its_entry() {
+        for epoch in [0, 1, 5] {
+            assert!(!sdk_agent_entry_changed(Some(&receipt("a", 0)), Some(&receipt("a", epoch)), None));
+        }
+        assert!(!sdk_agent_entry_changed(None, Some(&receipt("a", 0)), None));
+    }
+
+    #[test]
+    fn same_profile_transfer_requires_exact_source_and_destination() {
+        let transfer = AgentProfileHandoff {
+            source: receipt("a", 2), target_profile_id: "a".into(), call_id: "call".into(),
+        };
+        assert!(sdk_agent_entry_changed(Some(&receipt("a", 2)), Some(&receipt("a", 3)), Some(&transfer)));
+        assert!(!sdk_agent_entry_changed(Some(&receipt("a", 1)), Some(&receipt("a", 3)), Some(&transfer)));
+        assert!(!sdk_agent_entry_changed(Some(&receipt("a", 2)), Some(&receipt("a", 4)), Some(&transfer)));
+        assert!(!sdk_agent_entry_changed(Some(&receipt("a", 2)), Some(&receipt("a", 2)), Some(&transfer)));
+    }
+}
