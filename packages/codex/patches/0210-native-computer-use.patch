diff --git a/codex-rs/tools/src/computer.rs b/codex-rs/tools/src/computer.rs
new file mode 100644
index 00000000..a77deb32
--- /dev/null
+++ b/codex-rs/tools/src/computer.rs
@@ -0,0 +1,229 @@
+use crate::FunctionCallError;
+use crate::ToolOutput;
+use crate::ToolPayload;
+use crate::ToolSpec;
+use codex_protocol::dynamic_tools::DynamicComputerToolSpec;
+use codex_protocol::dynamic_tools::DynamicToolCallOutputContentItem;
+use codex_protocol::dynamic_tools::DynamicToolResponse;
+use codex_protocol::models::ResponseInputItem;
+use serde_json::Value;
+
+pub fn computer_tool_spec(spec: &DynamicComputerToolSpec) -> Result<ToolSpec, String> {
+    spec.validate()?;
+    Ok(if spec.tool_type == "computer" {
+        ToolSpec::Computer {}
+    } else {
+        ToolSpec::ComputerUsePreview {
+            display_width: spec.display_width.ok_or("missing display width")?,
+            display_height: spec.display_height.ok_or("missing display height")?,
+            environment: spec.environment.clone().ok_or("missing environment")?,
+        }
+    })
+}
+
+/// Validate provider structure before invoking a host callback. Action execution remains host-owned.
+pub fn validate_computer_call(call: &Value) -> Result<(), String> {
+    let invalid = || "invalid native computer call".to_string();
+    if call["type"] != "computer_call" || call["call_id"].as_str().is_none_or(str::is_empty) {
+        return Err(invalid());
+    }
+    let valid_action = |action: &Value| {
+        action.is_object() && action["type"].as_str().is_some_and(|kind| !kind.is_empty())
+    };
+    if let Some(action) = call.get("action").filter(|value| !value.is_null())
+        && !valid_action(action)
+    {
+        return Err(invalid());
+    }
+    if let Some(actions) = call.get("actions").filter(|value| !value.is_null()) {
+        let Some(actions) = actions.as_array() else {
+            return Err(invalid());
+        };
+        if !actions.iter().all(valid_action) {
+            return Err(invalid());
+        }
+    }
+    // Host compatibility: nonempty actions take precedence, then action; neither requests a screenshot.
+    let mut ids = std::collections::HashSet::new();
+    match call.get("pending_safety_checks") {
+        None => {}
+        Some(Value::Array(checks)) => {
+            for check in checks {
+                let Some(id) = check
+                    .get("id")
+                    .and_then(Value::as_str)
+                    .filter(|id| !id.is_empty())
+                else {
+                    return Err(invalid());
+                };
+                if !ids.insert(id) {
+                    return Err(invalid());
+                }
+            }
+        }
+        _ => return Err(invalid()),
+    }
+    Ok(())
+}
+
+/// Validated native output; screenshots never pass through function-output truncation.
+pub struct ComputerToolOutput {
+    output: Value,
+    acknowledged_safety_checks: Vec<Value>,
+}
+impl ComputerToolOutput {
+    pub fn from_dynamic_response(
+        arguments: &str,
+        response: DynamicToolResponse,
+    ) -> Result<Self, FunctionCallError> {
+        let invalid = || {
+            FunctionCallError::Fatal(
+                "computer execution failed or returned invalid screenshot/safety acknowledgements"
+                    .to_string(),
+            )
+        };
+        if !response.success {
+            return Err(invalid());
+        }
+        let [DynamicToolCallOutputContentItem::InputText { text }] =
+            response.content_items.as_slice()
+        else {
+            return Err(invalid());
+        };
+        let result: Value = serde_json::from_str(text).map_err(|_| invalid())?;
+        let call: Value = serde_json::from_str(arguments).map_err(|_| invalid())?;
+        validate_computer_call(&call).map_err(|_| invalid())?;
+        let pending = match call.get("pending_safety_checks") {
+            None => Vec::new(),
+            Some(Value::Array(checks)) => checks.clone(),
+            _ => return Err(invalid()),
+        };
+        let acknowledged = match result.get("acknowledged_safety_checks") {
+            None => Vec::new(),
+            Some(Value::Array(checks)) => checks.clone(),
+            _ => return Err(invalid()),
+        };
+        // Compare full objects; IDs were validated before dispatch. Reject extra ACKs.
+        if acknowledged.len() != pending.len()
+            || pending.iter().any(|check| !acknowledged.contains(check))
+        {
+            return Err(invalid());
+        }
+        let output = result.get("output").ok_or_else(invalid)?;
+        if output["type"] != "computer_screenshot"
+            || !output["image_url"].as_str().is_some_and(|url| {
+                [
+                    "data:image/png;base64,",
+                    "data:image/jpeg;base64,",
+                    "data:image/webp;base64,",
+                ]
+                .iter()
+                .any(|prefix| {
+                    url.strip_prefix(prefix)
+                        .is_some_and(|body| !body.is_empty())
+                })
+            })
+        {
+            return Err(invalid());
+        }
+        Ok(Self {
+            output: output.clone(),
+            acknowledged_safety_checks: acknowledged,
+        })
+    }
+}
+impl ToolOutput for ComputerToolOutput {
+    fn log_output(&self) -> String {
+        "[computer screenshot]".to_string()
+    }
+    fn success_for_logging(&self) -> bool {
+        true
+    }
+    fn contains_external_context(&self) -> bool {
+        true
+    }
+    fn to_response_item(&self, call_id: &str, _payload: &ToolPayload) -> ResponseInputItem {
+        ResponseInputItem::ComputerCallOutput {
+            call_id: call_id.to_owned(),
+            output: self.output.clone(),
+            acknowledged_safety_checks: self.acknowledged_safety_checks.clone(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    fn response(checks: Value) -> DynamicToolResponse {
+        DynamicToolResponse { success: true, content_items: vec![DynamicToolCallOutputContentItem::InputText { text: json!({"output":{"type":"computer_screenshot","image_url":"data:image/png;base64,aA=="}, "acknowledged_safety_checks":checks}).to_string() }] }
+    }
+    #[test]
+    fn validates_safety_before_accepting_native_output() {
+        let check = json!({"id":"s1","code":"domain","message":"confirm"});
+        let call=json!({"type":"computer_call","call_id":"c1","actions":[{"type":"screenshot"}],"pending_safety_checks":[check.clone()]}).to_string();
+        assert!(ComputerToolOutput::from_dynamic_response(&call, response(json!([]))).is_err());
+        assert!(
+            ComputerToolOutput::from_dynamic_response(&call, response(json!([{"id":"s1"}])))
+                .is_err()
+        );
+        let output =
+            ComputerToolOutput::from_dynamic_response(&call, response(json!([check]))).unwrap();
+        assert!(
+            matches!(output.to_response_item("c1",&ToolPayload::Computer{arguments:call}),ResponseInputItem::ComputerCallOutput{call_id,..} if call_id=="c1")
+        );
+    }
+    #[test]
+    fn failed_or_non_screenshot_responses_cannot_become_native_output() {
+        let call = json!({"type":"computer_call","call_id":"c1"}).to_string();
+        let mut denied = response(json!([]));
+        denied.success = false;
+        assert!(ComputerToolOutput::from_dynamic_response(&call, denied).is_err());
+        for output in [
+            json!({"type":"computer_screenshot","image_url":"https://example.invalid/screenshot.png"}),
+            json!({"type":"input_text","text":"done"}),
+        ] {
+            let invalid = DynamicToolResponse {
+                success: true,
+                content_items: vec![DynamicToolCallOutputContentItem::InputText {
+                    text: json!({"output":output}).to_string(),
+                }],
+            };
+            assert!(ComputerToolOutput::from_dynamic_response(&call, invalid).is_err());
+        }
+    }
+    #[test]
+    fn action_precedence_and_empty_actions_remain_host_owned() {
+        for fields in [
+            json!({}),
+            json!({"actions":[]}),
+            json!({"actions":null,"action":null}),
+            json!({"action":null,"actions":[{"type":"screenshot"}]}),
+            json!({"action":{"type":"screenshot"},"actions":[{"type":"click","x":1,"y":2}]}),
+        ] {
+            let mut call = json!({"type":"computer_call","call_id":"c1"});
+            call.as_object_mut()
+                .unwrap()
+                .extend(fields.as_object().unwrap().clone());
+            assert!(validate_computer_call(&call).is_ok());
+        }
+        assert!(
+            validate_computer_call(&json!({"type":"computer_call","call_id":"c1","actions":"bad"}))
+                .is_err()
+        );
+        assert!(validate_computer_call(&json!({"type":"computer_call","call_id":"c1","pending_safety_checks":[{"id":"s1"},{"id":"s1"}]})).is_err());
+    }
+    #[test]
+    fn computer_specs_are_native() {
+        let spec = DynamicComputerToolSpec {
+            tool_type: "computer".into(),
+            display_width: None,
+            display_height: None,
+            environment: None,
+        };
+        assert_eq!(
+            serde_json::to_value(computer_tool_spec(&spec).unwrap()).unwrap(),
+            json!({"type":"computer"})
+        );
+    }
+}
