@@ -0,0 +1,89 @@
+use crate::function_tool::FunctionCallError;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolOutput;
+use crate::tools::context::ToolPayload;
+use crate::tools::registry::CoreToolRuntime;
+use crate::tools::registry::ToolExecutor;
+use crate::tools::registry::ToolExposure;
+use codex_protocol::dynamic_tools::DynamicComputerToolSpec;
+use codex_tools::ComputerToolOutput;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use codex_tools::computer_tool_spec;
+
+pub(crate) struct ComputerToolHandler {
+    spec: ToolSpec,
+}
+impl ComputerToolHandler {
+    pub(crate) fn new(spec: &DynamicComputerToolSpec) -> Result<Self, String> {
+        Ok(Self {
+            spec: computer_tool_spec(spec)?,
+        })
+    }
+}
+impl ToolExecutor<ToolInvocation> for ComputerToolHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("computer")
+    }
+    fn spec(&self) -> ToolSpec {
+        self.spec.clone()
+    }
+    fn exposure(&self) -> ToolExposure {
+        ToolExposure::DirectModelOnly
+    }
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let ToolPayload::Computer { arguments } = &invocation.payload else {
+                return Err(FunctionCallError::Fatal(
+                    "computer handler requires native computer call".into(),
+                ));
+            };
+            let args = serde_json::from_str(arguments)
+                .map_err(|err| FunctionCallError::Fatal(format!("invalid computer call: {err}")))?;
+            let response = super::dynamic::request_dynamic_tool(
+                &invocation.session,
+                &invocation.turn,
+                invocation.call_id,
+                self.tool_name(),
+                args,
+            )
+            .await
+            .ok_or_else(|| FunctionCallError::Fatal("computer call cancelled".into()))?;
+            Ok(Box::new(ComputerToolOutput::from_dynamic_response(
+                arguments, response,
+            )?) as Box<dyn ToolOutput>)
+        })
+    }
+}
+impl CoreToolRuntime for ComputerToolHandler {
+    fn matches_kind(&self, payload: &ToolPayload) -> bool {
+        matches!(payload, ToolPayload::Computer { .. })
+    }
+    fn is_third_party_tool(&self) -> bool {
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn generic_functions_cannot_masquerade_as_native_computer_calls() {
+        let spec = DynamicComputerToolSpec {
+            tool_type: "computer".into(),
+            display_width: None,
+            display_height: None,
+            environment: None,
+        };
+        let handler = ComputerToolHandler::new(&spec).unwrap();
+        assert!(!handler.matches_kind(&ToolPayload::Function {
