+impl DynamicComputerToolSpec {
+    /// Internal callback binding only; never advertise this function schema to a provider.
+    pub fn callback_spec(&self) -> DynamicToolFunctionSpec {
+        DynamicToolFunctionSpec {
+            name: "computer".into(),
+            description: "Native computer callback".into(),
+            input_schema: serde_json::json!({"type":"object"}),
+            defer_loading: false,
+        }
+    }
+    pub fn validate(&self) -> Result<(), String> {
+        match self.tool_type.as_str() {
+            "computer" => Ok(()),
+            "computer_use_preview"
+                if self.display_width.is_some_and(|n| n > 0)
+                    && self.display_height.is_some_and(|n| n > 0)
+                    && self
+                        .environment
+                        .as_deref()
+                        .is_some_and(|e| matches!(e, "browser" | "mac" | "windows" | "ubuntu")) =>
+            {
+                Ok(())
+            }
+            _ => Err("invalid native computer declaration".to_string()),
+        }
+    }
+}
