 const MAX_EVENTS: usize = 2048;
 const MAX_BYTES: usize = 4 * 1024 * 1024;
 
+/// Process-wide settings for the existing native-to-host lifecycle queue.
+#[derive(Clone, Debug, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct HostTraceDeliverySettings {
+    max_queue_size: u32,
+    max_queue_bytes: u32,
+    max_batch_size: u32,
+    schedule_delay_ms: u32,
+    export_trigger_ratio: f64,
+}
+
+impl Default for HostTraceDeliverySettings {
+    fn default() -> Self {
+        Self {
+            max_queue_size: MAX_EVENTS as u32,
+            max_queue_bytes: MAX_BYTES as u32,
+            max_batch_size: 512,
+            schedule_delay_ms: 0,
+            export_trigger_ratio: 0.7,
+        }
+    }
+}
+
+impl HostTraceDeliverySettings {
+    pub fn parse(value: Value) -> Result<Self, String> {
+        let settings: Self =
+            serde_json::from_value(value).map_err(|_| "invalid host trace delivery options")?;
+        if settings.max_queue_size == 0
+            || settings.max_queue_bytes == 0
+            || settings.max_batch_size == 0
+            || !settings.export_trigger_ratio.is_finite()
+            || !(0.0..=1.0).contains(&settings.export_trigger_ratio)
+        {
+            return Err("invalid host trace delivery options".into());
+        }
+        Ok(settings)
+    }
+}
+
+/// Install validated settings before enabling the process trace provider.
+pub fn configure_host_trace_delivery(settings: HostTraceDeliverySettings) {
+    lock().delivery = settings;
+}
