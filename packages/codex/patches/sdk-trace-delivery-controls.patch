+    #[test]
+    fn host_delivery_options_reject_invalid_bounds_and_allow_small_queues() {
+        for value in [
+            json!(null),
+            json!({"unknown": 1}),
+            json!({"max_queue_size": 0}),
+            json!({"max_queue_bytes": 0}),
+            json!({"max_batch_size": 0}),
+            json!({"schedule_delay_ms": -1}),
+            json!({"schedule_delay_ms": 4294967296_u64}),
+            json!({"export_trigger_ratio": -0.1}),
+            json!({"export_trigger_ratio": 1.1}),
+        ] {
+            assert!(HostTraceDeliverySettings::parse(value).is_err());
+        }
+        assert!(
+            HostTraceDeliverySettings::parse(json!({
+                "max_queue_size": 1,
+                "max_batch_size": 128,
+                "export_trigger_ratio": 0,
