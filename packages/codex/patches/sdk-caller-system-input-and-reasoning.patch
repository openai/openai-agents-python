+#[test]
+fn contributor_receives_typed_reasoning_context_provenance() {
+    #[derive(Debug)]
+    struct Capture(std::sync::Mutex<Vec<bool>>);
+    impl ModelRequestContributor for Capture {
+        fn request(
+            &self,
+            input: ModelRequestInput<'_>,
+        ) -> Option<Box<dyn ModelResponseInterceptor>> {
+            self.0.lock().unwrap().push(input.native_reasoning_context);
+            None
+        }
+    }
+    let captured = Arc::new(Capture(std::sync::Mutex::new(Vec::new())));
+    let contributors: Vec<Arc<dyn ModelRequestContributor>> = vec![captured.clone()];
+    for implicit in [false, true] {
+        assert!(
+            prepare(
+                &contributors,
+                "thread",
+                "model",
+                false,
+                implicit,
+                ModelRequestKind::Generation,
+                &mut None,
+                None,
+            )
+            .is_empty()
+        );
+    }
+    assert_eq!(*captured.0.lock().unwrap(), vec![false, true]);
+}
