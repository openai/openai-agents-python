diff --git a/codex-rs/codex-api/src/api_rate_limits.rs b/codex-rs/codex-api/src/api_rate_limits.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a7bec674e43676bcc3a77aed1fc50c0785738b9f
--- /dev/null
+++ b/codex-rs/codex-api/src/api_rate_limits.rs
@@ -0,0 +1,116 @@
+//! Reads only documented API rate-limit and retry fields from a provider response.
+
+use codex_http_client::RetryAfter;
+use codex_protocol::protocol::ApiRateLimitWindow;
+use codex_protocol::protocol::ApiRateLimits;
+use http::HeaderMap;
+use regex_lite::Regex;
+use std::sync::OnceLock;
+
+pub(crate) fn parse_api_rate_limits(headers: &HeaderMap) -> Option<ApiRateLimits> {
+    let snapshot = ApiRateLimits {
+        requests: parse_window(headers, "requests"),
+        tokens: parse_window(headers, "tokens"),
+        project_tokens: parse_window(headers, "project-tokens"),
+        retry_after: header(headers, "retry-after")
+            .filter(|value| value.len() <= 64 && RetryAfter::from_header(value).is_some())
+            .map(str::to_owned),
+    };
+    (snapshot != ApiRateLimits::default()).then_some(snapshot)
+}
+
+fn parse_window(headers: &HeaderMap, unit: &str) -> Option<ApiRateLimitWindow> {
+    let window = ApiRateLimitWindow {
+        limit: count(headers, &format!("x-ratelimit-limit-{unit}")),
+        remaining: count(headers, &format!("x-ratelimit-remaining-{unit}")),
+        reset_after: header(headers, &format!("x-ratelimit-reset-{unit}"))
+            .filter(|value| is_duration(value))
+            .map(str::to_owned),
+    };
+    (window != ApiRateLimitWindow::default()).then_some(window)
+}
+
+fn header<'a>(headers: &'a HeaderMap, name: &str) -> Option<&'a str> {
+    let value = headers.get(name)?.to_str().ok()?.trim();
+    (!value.is_empty()).then_some(value)
+}
+
+fn count(headers: &HeaderMap, name: &str) -> Option<u64> {
+    let value = header(headers, name)?;
+    if !value.bytes().all(|byte| byte.is_ascii_digit()) {
+        return None;
+    }
+    value.parse().ok()
+}
+
+#[expect(clippy::expect_used, reason = "the duration expression is fixed")]
+fn is_duration(value: &str) -> bool {
+    static DURATION: OnceLock<Regex> = OnceLock::new();
+    value.len() <= 64
+        && DURATION
+            .get_or_init(|| {
+                Regex::new(r"\A(?:[0-9]+(?:\.[0-9]+)?(?:ms|us|ns|h|m|s))+\z")
+                    .expect("valid duration expression")
+            })
+            .is_match(value)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use http::HeaderValue;
+
+    #[test]
+    fn projects_only_valid_rate_limit_fields() {
+        let mut headers = HeaderMap::new();
+        headers.insert(
+            "authorization",
+            HeaderValue::from_static("Bearer fake-secret"),
+        );
+        headers.insert(
+            "x-ratelimit-limit-tokens",
+            HeaderValue::from_static("invalid"),
+        );
+        headers.insert(
+            "x-ratelimit-reset-requests",
+            HeaderValue::from_static("fake-secret"),
+        );
+        headers.insert("retry-after", HeaderValue::from_static("fake-secret"));
+        assert_eq!(parse_api_rate_limits(&headers), None);
+
+        headers.insert(
+            "x-ratelimit-limit-requests",
+            HeaderValue::from_static("120"),
+        );
+        headers.insert(
+            "x-ratelimit-remaining-requests",
+            HeaderValue::from_static("0"),
+        );
+        headers.insert("x-ratelimit-reset-tokens", HeaderValue::from_static("6m0s"));
+        headers.insert(
+            "x-ratelimit-reset-project-tokens",
+            HeaderValue::from_static("1.25s"),
+        );
+        headers.insert("retry-after", HeaderValue::from_static("56"));
+
+        assert_eq!(
+            parse_api_rate_limits(&headers),
+            Some(ApiRateLimits {
+                requests: Some(ApiRateLimitWindow {
+                    limit: Some(120),
+                    remaining: Some(0),
+                    reset_after: None,
+                }),
+                tokens: Some(ApiRateLimitWindow {
+                    reset_after: Some("6m0s".to_string()),
+                    ..Default::default()
+                }),
+                project_tokens: Some(ApiRateLimitWindow {
+                    reset_after: Some("1.25s".to_string()),
+                    ..Default::default()
+                }),
+                retry_after: Some("56".to_string()),
+            }),
+        );
+    }
+}
