+    /// Registers a lazy local launcher without selecting a default environment.
+    /// This explicit application configuration does not discover ambient environments.
+    pub fn with_unselected_local_environment(
+        local_runtime_paths: ExecServerRuntimeOptions,
+        http_client_factory: HttpClientFactory,
+    ) -> Result<Self, ExecServerError> {
+        Self::from_snapshot(
+            EnvironmentProviderSnapshot {
+                environments: Default::default(),
+                default: EnvironmentDefault::Disabled,
+                include_local: true,
+            },
+            Some(local_runtime_paths),
+            http_client_factory,
+        )
+    }
