+    #[tokio::test]
+    async fn unselected_local_launcher_does_not_supply_a_default_or_remote_fallback() {
+        let manager = EnvironmentManager::with_unselected_local_environment(
+            test_runtime_paths(),
+            HttpClientFactory::new(OutboundProxyPolicy::RespectSystemProxy),
+        )
+        .expect("create explicit local launcher");
+        assert!(manager.default_environment().is_none());
+        assert!(manager.default_environment_ids().is_empty());
+        assert!(manager.try_local_environment().is_some());
+        assert!(manager.get_environment(REMOTE_ENVIRONMENT_ID).is_none());
+        assert!(manager.get_environment("missing-remote").is_none());
+        assert_eq!(
+            manager.http_client_factory().outbound_proxy_policy(),
+            OutboundProxyPolicy::RespectSystemProxy
+        );
+        manager
+            .upsert_environment(
+                REMOTE_ENVIRONMENT_ID.into(),
+                "wss://127.0.0.1:1/exec".into(),
+                None,
+            )
+            .expect("register selected remote without connecting");
+        assert!(
+            manager
+                .get_environment(REMOTE_ENVIRONMENT_ID)
+                .unwrap()
+                .is_remote()
+        );
+        assert!(!manager.try_local_environment().unwrap().is_remote());
+        assert!(manager.default_environment().is_none());
+        assert!(manager.default_environment_ids().is_empty());
+        assert!(manager.get_environment("missing-remote").is_none());
+    }
