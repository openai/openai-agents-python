+#[test]
+fn detects_proc_mount_failures_at_proc_root() {
+    for reason in [
+        "Invalid argument",
+        "Operation not permitted",
+        "Permission denied",
+    ] {
+        let stderr = format!("bwrap: Can't mount proc on /proc: {reason}");
+        assert!(is_proc_mount_failure(&stderr), "{stderr}");
+    }
+}
+
+#[test]
+fn detects_proc_mount_failure_among_diagnostic_lines() {
+    let stderr = "earlier diagnostic\nbwrap: Can't mount proc on /proc: Operation not permitted\r\nlater diagnostic\n";
+    assert!(is_proc_mount_failure(stderr));
+}
+
+#[test]
+fn ignores_misleading_proc_mount_diagnostics() {
+    for stderr in [
+        "bwrap: Can't mount proc on /proc-other: Operation not permitted",
+        "bwrap: Can't mount proc on /newroot/proc-other: Operation not permitted",
+        "bwrap: Can't mount proc on /proc: No such file or directory",
+        "bwrap: Can't bind mount /proc: Operation not permitted",
+        "bwrap: Can't mount proc\n/newroot/proc\nOperation not permitted",
+        "bwrap: Can't mount proc on /proc: Operation not permitted by another operation",
+    ] {
+        assert!(!is_proc_mount_failure(stderr), "{stderr}");
+    }
+}
