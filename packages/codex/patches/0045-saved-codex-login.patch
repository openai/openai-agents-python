+// The SDK opts into the exact file-backed Codex OAuth login. Unlike the
+// regular loader, this path never looks at environment or in-memory auth.
+type SavedChatgptOwner = (Option<String>, String);
+
+fn saved_chatgpt_owner(auth: &AuthDotJson) -> Option<SavedChatgptOwner> {
+    let tokens = auth.tokens.as_ref()?;
+    let account_id = tokens.account_id.as_ref();
+    let user_id = tokens.id_token.chatgpt_user_id.as_ref()?;
+    if auth.resolved_mode() != AuthMode::Chatgpt
+        || auth.last_refresh.is_none()
+        || account_id.is_some_and(|account| account.trim().is_empty())
+        || tokens.id_token.chatgpt_account_id.as_ref() != account_id
+        || tokens.id_token.is_fedramp_account()
+        || user_id.trim().is_empty()
+        || tokens.access_token.trim().is_empty()
+        || tokens.refresh_token.trim().is_empty()
+    {
+        return None;
+    }
+    Some((account_id.cloned(), user_id.clone()))
+}
+
+fn load_saved_chatgpt(
+    codex_home: &Path,
+    auth_route_config: &AuthRouteConfig,
+    expected_owner: Option<&SavedChatgptOwner>,
+) -> std::io::Result<Option<(CodexAuth, SavedChatgptOwner)>> {
+    let storage = create_auth_storage(
+        codex_home.to_path_buf(),
+        AuthCredentialsStoreMode::File,
+        AuthKeyringBackendKind::default(),
+    );
+    let Some(auth) = storage.load()? else {
+        return Ok(None);
+    };
+    let Some(owner) = saved_chatgpt_owner(&auth) else {
+        return Ok(None);
+    };
+    if expected_owner.is_some_and(|expected| *expected != owner) {
+        return Ok(None);
+    }
+    let state = ChatgptAuthState {
+        auth_dot_json: Arc::new(Mutex::new(Some(auth))),
+        client: create_default_auth_client(REFRESH_TOKEN_URL, auth_route_config)?,
+    };
+    Ok(Some((
+        CodexAuth::Chatgpt(ChatgptAuth { state, storage }),
+        owner,
+    )))
+}
