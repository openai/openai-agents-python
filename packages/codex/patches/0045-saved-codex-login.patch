+#[tokio::test]
+async fn saved_chatgpt_refresh_reloads_personal_login_on_unauthorized() -> anyhow::Result<()> {
+    let home = tempdir()?;
+    write_auth_file(
+        AuthFileParams {
+            openai_api_key: None,
+            chatgpt_plan_type: Some("pro".to_string()),
+            chatgpt_account_id: None,
+        },
+        home.path(),
+    )?;
+    let manager = AuthManager::shared_saved_chatgpt(
+        home.path().to_path_buf(),
+        crate::test_support::transport_default_auth_route_config(),
+    )?;
+    let mut recovery = manager.unauthorized_recovery();
+    assert_eq!(recovery.next().await?.auth_state_changed(), Some(false));
+    assert_eq!(recovery.step_name(), "refresh_token");
+
+    let Some(CodexAuth::Chatgpt(auth)) = manager.auth_cached() else {
+        anyhow::bail!("expected saved ChatGPT auth");
+    };
+    let mut replacement = auth.current_auth_json().expect("saved login");
+    let tokens = replacement.tokens.as_mut().expect("login tokens");
+    tokens.access_token = "rotated-personal-access-token".to_string();
+    tokens.refresh_token = "rotated-personal-refresh-token".to_string();
+    auth.storage().save(&replacement)?;
+    let mut recovery = manager.unauthorized_recovery();
+    assert_eq!(recovery.next().await?.auth_state_changed(), Some(true));
+    assert_eq!(
+        manager.auth_cached().expect("cached login").get_token()?,
+        "rotated-personal-access-token"
+    );
+
+    std::fs::remove_file(get_auth_file(home.path()))?;
+    let mut recovery = manager.unauthorized_recovery();
+    assert!(matches!(
+        recovery.next().await,
+        Err(RefreshTokenError::Permanent(_))
+    ));
+    Ok(())
+}
