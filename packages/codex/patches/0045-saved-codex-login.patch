+#[tokio::test]
+async fn saved_chatgpt_refresh_adopts_a_concurrent_same_owner_update() -> anyhow::Result<()> {
+    for (other_workspace, authority_rejected) in [(false, true), (false, false), (true, true)] {
+        let home = tempdir()?;
+        write_auth_file(
+            AuthFileParams {
+                openai_api_key: None,
+                chatgpt_plan_type: Some("pro".to_string()),
+                chatgpt_account_id: None,
+            },
+            home.path(),
+        )?;
+        let manager = AuthManager::shared_saved_chatgpt(
+            home.path().to_path_buf(),
+            crate::test_support::transport_default_auth_route_config(),
+        )?;
+        let Some(CodexAuth::Chatgpt(auth)) = manager.auth_cached() else {
+            anyhow::bail!("expected saved ChatGPT auth");
+        };
+        let attempted = auth.current_auth_json().expect("saved login");
+        let mut replacement = attempted.clone();
+        let tokens = replacement.tokens.as_mut().expect("login tokens");
+        tokens.access_token = "other-process-access-token".to_string();
+        tokens.refresh_token = "other-process-refresh-token".to_string();
+        if other_workspace {
+            let workspace = Some(WORKSPACE_ID_DISALLOWED.to_string());
+            let jwt = fake_jwt_for_auth_file_params(&AuthFileParams {
+                openai_api_key: None,
+                chatgpt_plan_type: Some("pro".to_string()),
+                chatgpt_account_id: workspace.clone(),
+            })?;
+            tokens.id_token = parse_chatgpt_jwt_claims(&jwt)?;
+            tokens.account_id = workspace;
+        }
+        auth.storage().save(&replacement)?;
+
+        let response = if authority_rejected {
+            Err(RefreshTokenFailedError::new(
+                RefreshTokenFailedReason::Exhausted,
+                "Refresh token already used.".to_string(),
+            )
+            .into())
+        } else {
+            Ok(RefreshResponse {
+                id_token: None,
+                access_token: Some("stale-response-access-token".to_string()),
+                refresh_token: Some("stale-response-refresh-token".to_string()),
+            })
+        };
+        let result = manager
+            .finish_chatgpt_refresh(&auth, Some(&attempted), response)
+            .await;
+        let expected_token = if other_workspace {
+            assert!(matches!(result, Err(RefreshTokenError::Permanent(_))));
+            "test-access-token"
+        } else {
+            result?;
+            "other-process-access-token"
+        };
+        assert_eq!(
+            manager.auth_cached().expect("cached login").get_token()?,
+            expected_token
+        );
+        assert_eq!(auth.storage().load()?.as_ref(), Some(&replacement));
+    }
+    Ok(())
+}
