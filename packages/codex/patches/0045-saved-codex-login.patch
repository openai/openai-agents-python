+#[test]
+fn saved_chatgpt_refresh_persists_only_for_the_current_owner() -> anyhow::Result<()> {
+    let home = tempdir()?;
+    write_auth_file(
+        AuthFileParams {
+            openai_api_key: None,
+            chatgpt_plan_type: Some("pro".to_string()),
+            chatgpt_account_id: Some(WORKSPACE_ID_ALLOWED.to_string()),
+        },
+        home.path(),
+    )?;
+    let storage = create_auth_storage(
+        home.path().to_path_buf(),
+        AuthCredentialsStoreMode::File,
+        AuthKeyringBackendKind::default(),
+    );
+    let mut saved = storage.load()?.expect("saved login");
+    saved.tokens.as_mut().expect("login tokens").account_id =
+        Some(WORKSPACE_ID_ALLOWED.to_string());
+    storage.save(&saved)?;
+
+    let other_workspace = fake_jwt_for_auth_file_params(&AuthFileParams {
+        openai_api_key: None,
+        chatgpt_plan_type: Some("pro".to_string()),
+        chatgpt_account_id: Some(WORKSPACE_ID_DISALLOWED.to_string()),
+    })?;
+    assert!(persist_tokens(&storage, Some(other_workspace), None, None, Some(&saved)).is_err());
+    assert_eq!(storage.load()?.as_ref(), Some(&saved));
+
+    let renewed = persist_tokens(
+        &storage,
+        None,
+        Some("renewed-access-token".to_string()),
+        Some("renewed-refresh-token".to_string()),
+        Some(&saved),
+    )?;
+    assert!(persist_tokens(&storage, None, None, None, Some(&saved)).is_err());
+    assert_eq!(storage.load()?.as_ref(), Some(&renewed));
+    Ok(())
+}
