+    #[ts(type = "number")]
+    pub request_attempt: u64,
+    pub max_retries: u32,
+    pub policy_enabled: bool,
+    pub thread_id: String,
+    pub turn_id: String,
+    pub model: String,
+    pub transport: String,
+    pub normalized: ModelRetryError,
+    pub provider_advice: ModelRetryAdvice,
+    pub response_started: bool,
+    pub retry_unsafe_output: bool,
+    pub local_effects: bool,
+    pub stateful: bool,
+    pub previous_response_id: Option<String>,
+    pub conversation_id: Option<String>,
+    pub usage: Option<TokenUsage>,
+}
+
+/// Cumulative native facts for one exact turn. Explicit host reports stay separate.
+/// Live events, final results and checkpoints carry the same authoritative totals.
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelAttemptUsage {
+    #[ts(type = "number")]
+    pub requests: u64,
+    pub token_usage: TokenUsage,
+    #[ts(type = "number")]
+    pub requests_without_token_usage: u64,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelAttemptSnapshot {
+    /// First existing attempt UUID; stable within this ledger, fresh after restore.
+    pub owner_attempt_id: Option<String>,
+    pub usage: ModelAttemptUsage,
+    pub terminal_attempt_id: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelProducerFailure {
+    pub attempt_id: String,
+    pub normalized: ModelRetryError,
+    #[serde(default)]
+    pub usage: Option<TokenUsage>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRetryResolution {
+    /// None retains Core's decision while allowing captured backend advice.
+    pub decision: Option<ModelRetryDecision>,
+    #[serde(default)]
+    pub provider_advice: Option<ModelRetryAdvice>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(rename_all = "snake_case")]
+pub enum ModelAttemptPhase {
+    Started,
+    Finished,
+    Retry,
+    Terminal,
+    Cancelled,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn captures_configuration_without_executable_policy() {
+        let retry: ModelRetrySettings =
+            serde_json::from_str(r#"{"max_retries":0,"backoff":{"multiplier":1.5}}"#).unwrap();
+        assert_eq!(retry.max_retries, Some(0));
+        let backoff = retry.backoff.unwrap();
+        assert_eq!(backoff.initial_delay_ms, 250.0);
+        assert_eq!(backoff.multiplier, 1.5);
+        assert!(serde_json::from_str::<ModelRetrySettings>(r#"{"policy":true}"#).is_err());
+    }
+
+    #[test]
+    fn rejects_invalid_policy_delay_and_backoff() {
+        for delay in [-1.0, f64::NAN, f64::INFINITY] {
+            assert!(
+                ModelRetryDecision {
+                    retry: true,
+                    delay_ms: Some(delay),
+                    ..Default::default()
+                }
+                .validate()
+                .is_err()
+            );
+            assert!(
+                ModelRetrySettings {
+                    backoff: Some(ModelRetryBackoff {
+                        multiplier: delay,
+                        ..Default::default()
+                    }),
+                    ..Default::default()
+                }
+                .validate()
+                .is_err()
+            );
+        }
+    }
+}
