+                _ => { context.stateful = true; advice.replay_safety = ModelReplaySafety::Unknown; }
+            }
+            let reply = ModelRetryResolution { decision: None, provider_advice: Some(advice) };
+            assert_eq!(select_retry_delay(&context, Some(&reply), false,
+                false, &ModelRetryBackoff::default(), 0.5).unwrap(), None);
+        }
+    }
