+//! Logical-generation identity and accounting in the existing native turn store.
+//! No transport or retry executor lives here; the sampling loop owns both.
+use codex_extension_api::{ModelAttemptAdmission, TurnSamplingStop};
+use codex_protocol::model_retry::{ModelAttemptSnapshot, ModelProducerFailure, ModelRetryBackoff};
+use codex_protocol::protocol::TokenUsage;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, Weak};
+use std::time::Duration;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Debug, Default)]
+pub(crate) struct AttemptLedger(Mutex<LedgerState>);
+
+#[derive(Debug, Default)]
+struct LedgerState {
+    snapshot: ModelAttemptSnapshot,
+    current: Option<Weak<Attempt>>,
+    last_settled: Option<String>,
+}
+
+#[derive(Debug)]
+pub(crate) struct Attempt {
+    ledger: Arc<AttemptLedger>,
+    id: String,
+    ordinal: u64,
+    retry_configured: bool,
+    disable_provider_retries: bool,
+    stop: Arc<TurnSamplingStop>,
+    cancellation: CancellationToken,
+    measurement: Mutex<Measurement>,
+    request: Mutex<RequestState>,
+    pub(crate) response_started: AtomicBool,
+    pub(crate) unsafe_output: AtomicBool,
+    pub(crate) local_effects: AtomicBool,
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct RequestState {
+    pub(crate) transport: String,
+    pub(crate) previous_response_id: Option<String>,
+    pub(crate) conversation_id: Option<String>,
+}
+
+#[derive(Debug, Default)]
+struct Measurement {
+    settled: bool,
+    usage: Option<TokenUsage>,
+    failure: Option<ModelProducerFailure>,
+}
+
+impl AttemptLedger {
+    pub(crate) fn begin(
+        self: &Arc<Self>,
+        attempt_ordinal: u64,
+        parent: &Arc<TurnSamplingStop>,
+        cancellation: &CancellationToken,
+        retry_configured: bool,
+        disable_provider_retries: bool,
+    ) -> Result<Arc<Attempt>, String> {
+        let mut state = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.current.is_some() {
+            return Err("Previous native model attempt has not settled".into());
+        }
+        if parent.requested() || cancellation.is_cancelled() {
+            return Err("Native model turn is cancelled".into());
+        }
+        let ordinal = state
+            .snapshot
+            .usage
+            .requests
+            .checked_add(1)
+            .ok_or("Native model attempt counter overflow")?;
+        let missing = state
+            .snapshot
+            .usage
+            .requests_without_token_usage
+            .checked_add(1)
+            .ok_or("Native model missing-usage counter overflow")?;
+        let attempt = Arc::new(Attempt {
+            ledger: self.clone(),
+            id: uuid::Uuid::new_v4().to_string(),
+            ordinal: attempt_ordinal,
+            retry_configured,
+            disable_provider_retries,
+            stop: Arc::new(parent.for_turn()),
+            cancellation: cancellation.child_token(),
+            measurement: Mutex::default(),
+            request: Mutex::new(RequestState {
+                transport: "responses_sse".into(),
+                previous_response_id: None,
+                conversation_id: None,
+            }),
+            response_started: AtomicBool::new(false),
+            unsafe_output: AtomicBool::new(false),
+            local_effects: AtomicBool::new(false),
+        });
+        state
+            .snapshot
+            .owner_attempt_id
+            .get_or_insert_with(|| attempt.id.clone());
+        state.snapshot.usage.requests = ordinal;
+        state.snapshot.usage.requests_without_token_usage = missing;
+        state.snapshot.terminal_attempt_id = None;
+        state.current = Some(Arc::downgrade(&attempt));
+        Ok(attempt)
+    }
+
+    /// Called only after the sampler, stream tasks and application callback joined.
+    pub(crate) fn settle(&self, attempt: &Arc<Attempt>) -> Result<(), String> {
+        let mut state = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if !state
+            .current
+            .as_ref()
+            .and_then(Weak::upgrade)
+            .is_some_and(|current| Arc::ptr_eq(&current, attempt))
+        {
+            return Err("Native attempt accounting owner mismatch".into());
+        }
+        let mut measurement = attempt
+            .measurement
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if measurement.settled {
+            return Err("Native model attempt already settled".into());
+        }
+        if let Some(usage) = &measurement.usage {
+            let combined = add_usage(&state.snapshot.usage.token_usage, usage)?;
+            state.snapshot.usage.token_usage = combined;
+            state.snapshot.usage.requests_without_token_usage -= 1;
+        }
+        measurement.settled = true;
+        state.last_settled = Some(attempt.id.clone());
+        state.current = None;
+        Ok(())
+    }
+
+    pub(crate) fn terminal(&self, attempt: &Attempt) -> Result<(), String> {
+        let mut state = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.last_settled.as_deref() != Some(attempt.id.as_str()) || state.current.is_some() {
+            return Err("Native terminal model attempt owner mismatch".into());
+        }
+        state.snapshot.terminal_attempt_id = Some(attempt.id.clone());
+        Ok(())
+    }
+
+    pub(crate) fn snapshot(&self) -> ModelAttemptSnapshot {
+        let state = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let mut snapshot = state.snapshot.clone();
+        if let Some(attempt) = state.current.as_ref().and_then(Weak::upgrade) {
+            let measurement = attempt
+                .measurement
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if let Some(usage) = &measurement.usage {
+                // Reporting validated this sum under the same ledger lock. The
+                // projection remains identical after physical settlement commits it.
+                snapshot.usage.token_usage = add_usage(&snapshot.usage.token_usage, usage)
+                    .expect("validated current native attempt usage");
+                snapshot.usage.requests_without_token_usage -= 1;
+            }
+        }
+        snapshot
+    }
+}
+
+impl Attempt {
+    pub(crate) fn request_state(&self) -> RequestState {
+        self.request
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone()
+    }
+
+    fn with_measurement<T>(
+        &self,
+        update: impl FnOnce(&LedgerState, &mut Measurement) -> Result<T, String>,
+    ) -> Result<T, String> {
+        let ledger = &self.ledger;
+        let state = ledger
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if !state
+            .current
+            .as_ref()
+            .and_then(Weak::upgrade)
+            .is_some_and(|current| current.id == self.id)
+        {
+            return Err("Native model usage owner is settled".into());
+        }
+        let mut measurement = self
+            .measurement
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if measurement.settled {
+            return Err("Native model usage owner is settled".into());
+        }
+        update(&state, &mut measurement)
+    }
+
+    pub(crate) fn failure(&self) -> Option<ModelProducerFailure> {
+        self.measurement
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .failure
+            .clone()
+    }
+
+    pub(crate) fn usage(&self) -> Option<TokenUsage> {
+        self.measurement
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .usage
+            .clone()
+    }
+
+    pub(crate) fn release_failure(&self) {
+        self.measurement
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .failure = None;
+    }
+}
+
+impl ModelAttemptAdmission for Attempt {
+    fn mark_response_started(&self) {
+        self.response_started.store(true, Ordering::Release);
+    }
+    fn mark_unsafe_output(&self) {
+        self.unsafe_output.store(true, Ordering::Release);
+    }
+    fn mark_local_effect(&self) {
+        self.local_effects.store(true, Ordering::Release);
+    }
+
+    fn id(&self) -> &str {
+        &self.id
+    }
+    fn attempt(&self) -> u64 {
+        self.ordinal
+    }
+    fn retry_configured(&self) -> bool {
+        self.retry_configured
+    }
+    fn disable_provider_retries(&self) -> bool {
+        self.disable_provider_retries
+    }
+    fn cancellation(&self) -> CancellationToken {
+        self.cancellation.clone()
+    }
+    fn sampling_stop(&self) -> Arc<TurnSamplingStop> {
+        self.stop.clone()
+    }
+
+    fn snapshot(&self) -> Result<ModelAttemptSnapshot, String> {
+        Ok(self.ledger.snapshot())
+    }
+    fn observe_request(
+        &self,
+        transport: &str,
+        previous_response_id: Option<&str>,
+        conversation_id: Option<&str>,
+    ) -> Result<(), String> {
+        self.with_measurement(|_, _| {
+            let mut request = self
+                .request
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            request.transport = transport.to_owned();
+            // A fallback does not erase earlier observed stateful request uncertainty.
+            if let Some(id) = previous_response_id {
+                request.previous_response_id = Some(id.to_owned());
+            }
+            if let Some(id) = conversation_id {
+                request.conversation_id = Some(id.to_owned());
+            }
+            Ok(())
+        })
+    }
+
+    fn report_failure(&self, failure: ModelProducerFailure) -> Result<(), String> {
+        if failure.attempt_id != self.id {
+            return Err("Native model failure attempt mismatch".into());
+        }
+        if let Some(delay) = failure.normalized.retry_after_ms {
+            if !delay.is_finite() || delay < 0.0 {
+                return Err("Invalid model failure retry-after".into());
+            }
+        }
+        if let Some(usage) = &failure.usage {
+            validate_usage(usage)?;
+        }
+        self.with_measurement(|state, measurement| {
+            if measurement.failure.is_some() {
+                return Err("Native model failure already recorded".into());
+            }
+            if let Some(usage) = &failure.usage {
+                add_usage(&state.snapshot.usage.token_usage, usage)?;
+                measurement.usage = Some(usage.clone());
+            }
+            measurement.failure = Some(failure);
+            Ok(())
+        })
+    }
+
+    fn report_usage(&self, usage: TokenUsage) -> Result<(), String> {
+        validate_usage(&usage)?;
+        self.with_measurement(|state, measurement| {
+            add_usage(&state.snapshot.usage.token_usage, &usage)?;
+            // Replaces only this attempt's measurement. Snapshot projection and
+            // final settlement never add repeated reports a second time.
+            measurement.usage = Some(usage);
+            Ok(())
+        })
+    }
+}
+
+fn validate_usage(usage: &TokenUsage) -> Result<(), String> {
+    if [
+        usage.input_tokens,
+        usage.cached_input_tokens,
+        usage.cache_write_input_tokens,
+        usage.output_tokens,
+        usage.reasoning_output_tokens,
+        usage.total_tokens,
+    ]
+    .iter()
+    .any(|count| *count < 0)
+    {
+        return Err("Native model usage must be nonnegative".into());
+    }
+    Ok(())
+}
+
+fn add_usage(left: &TokenUsage, right: &TokenUsage) -> Result<TokenUsage, String> {
+    let add = |a: i64, b: i64| {
+        a.checked_add(b)
+            .ok_or_else(|| "Native token usage overflow".to_owned())
+    };
+    Ok(TokenUsage {
+        input_tokens: add(left.input_tokens, right.input_tokens)?,
+        cached_input_tokens: add(left.cached_input_tokens, right.cached_input_tokens)?,
+        cache_write_input_tokens: add(
+            left.cache_write_input_tokens,
+            right.cache_write_input_tokens,
+        )?,
+        output_tokens: add(left.output_tokens, right.output_tokens)?,
+        reasoning_output_tokens: add(left.reasoning_output_tokens, right.reasoning_output_tokens)?,
+        total_tokens: add(left.total_tokens, right.total_tokens)?,
+        // Rollout currency remains with the existing native budget observer.
+        codex_rollout_budget_units: None,
+    })
+}
+
+/// Delay quotation only; the sampling loop performs its cancellation-aware wait.
+pub(crate) fn backoff_delay(
+    settings: &ModelRetryBackoff,
+    failed_attempt: u64,
+    jitter_sample: f64,
+) -> Result<Duration, String> {
+    let base = if settings.initial_delay_ms == 0.0 {
+        0.0
+    } else {
+        (settings.initial_delay_ms
+            * settings
+                .multiplier
+                .powf(failed_attempt.saturating_sub(1) as f64))
+        .min(settings.max_delay_ms)
+    };
+    let millis = if settings.jitter {
+        (base * (0.875 + jitter_sample.clamp(0.0, 1.0) * 0.25)).min(settings.max_delay_ms)
+    } else {
+        base
+    };
+    Duration::try_from_secs_f64(millis / 1_000.0)
+        .map_err(|_| "Retry delay exceeds native timer range".to_owned())
+}
+
+/// Native replay fences remain authoritative after the captured policy returns.
+/// `native_retryable` retains the existing transport default when no policy is selected.
+pub(crate) fn select_retry_delay(
+    context: &codex_protocol::model_retry::ModelRetryContext,
+    resolution: Option<&codex_protocol::model_retry::ModelRetryResolution>,
+    native_retryable: bool,
+    streamed: bool,
+    backoff: &ModelRetryBackoff,
+    jitter_sample: f64,
+) -> Result<Option<Duration>, String> {
+    use codex_protocol::model_retry::ModelReplaySafety;
+    let advice = resolution
+        .and_then(|reply| reply.provider_advice.as_ref())
+        .unwrap_or(&context.provider_advice);
+    if context.normalized.is_abort
+        || context.retry_unsafe_output
+        || context.local_effects
+        || (streamed && advice.replay_safety == ModelReplaySafety::Unsafe)
+        || context.attempt == 0
+        || context.attempt > u64::from(context.max_retries)
+    {
+        return Ok(None);
+    }
+    let decision = resolution.and_then(|reply| reply.decision.as_ref());
+    if !context.policy_enabled && decision.is_some() {
+        return Err("Retry policy reply has no selected callback".into());
+    }
+    if let Some(decision) = decision {
+        decision.validate()?;
+    }
+    if !decision.map_or(advice.suggested.unwrap_or(native_retryable), |decision| decision.retry) {
+        return Ok(None);
+    }
+    let approves_unsafe = decision.is_some_and(|decision| decision.approve_unsafe_replay);
+    let safe = advice.replay_safety == ModelReplaySafety::Safe;
+    let unsafe_provider = advice.replay_safety == ModelReplaySafety::Unsafe;
+    // Approval is scoped to provider-marked unsafety; unknown state is not approval.
+    if (context.stateful && !(safe || (unsafe_provider && approves_unsafe)))
+        || (unsafe_provider && !approves_unsafe)
+    {
+        return Ok(None);
+    }
+    let selected_ms = decision
+        .and_then(|decision| decision.delay_ms)
+        .or(advice.retry_after_ms)
+        .or(context.normalized.retry_after_ms);
+    match selected_ms {
+        Some(ms) if ms.is_finite() && ms >= 0.0 => Duration::try_from_secs_f64(ms / 1_000.0)
+            .map(Some)
+            .map_err(|_| "Retry delay exceeds native timer range".to_owned()),
+        Some(_) => Err("Retry delay must be finite and nonnegative".into()),
+        None => backoff_delay(backoff, context.attempt, jitter_sample).map(Some),
+    }
+}
+
+/// Preserve only native fields actually retained by the transport error owner.
+pub(crate) fn normalize_error(
+    error: &codex_protocol::error::CodexErr,
+) -> codex_protocol::model_retry::ModelRetryError {
+    use codex_protocol::error::CodexErrorDetails;
+    let mut result = codex_protocol::model_retry::ModelRetryError {
+        message: error.to_string().chars().take(8_192).collect(),
+        status_code: error.http_status_code_value(),
+        retry_after_ms: error
+            .server_retry_delay()
+            .map(|delay| delay.as_secs_f64() * 1_000.0),
+        is_abort: matches!(
+            error.details(),
+            CodexErrorDetails::TurnAborted | CodexErrorDetails::Interrupted
+        ),
+        is_network_error: matches!(
+            error.details(),
+            CodexErrorDetails::ConnectionFailed(_)
+                | CodexErrorDetails::ResponseStreamFailed(_)
+                | CodexErrorDetails::Stream(_)
+        ),
+        is_timeout: matches!(
+            error.details(),
+            CodexErrorDetails::RequestTimeout
+                | CodexErrorDetails::ModelAttemptDeadlineExceeded(_)
+                | CodexErrorDetails::ModelInvocationDeadlineExceeded(_)
+        ),
+        ..Default::default()
+    };
+    match error.details() {
+        CodexErrorDetails::UnexpectedStatus(status) => {
+            result.request_id = status.request_id.clone();
+            if status.body.len() <= 16_384 {
+                if let Ok(body) = serde_json::from_str::<serde_json::Value>(&status.body) {
+                    result.error_code = body
+                        .get("error")
+                        .and_then(|error| error.get("code"))
+                        .and_then(serde_json::Value::as_str)
+                        .map(|code| code.chars().take(256).collect());
+                }
+            }
+        }
+        CodexErrorDetails::ResponseStreamFailed(error) => {
+            result.request_id = error.request_id.clone()
+        }
+        CodexErrorDetails::RetryLimit(error) => result.request_id = error.request_id.clone(),
+        _ => {}
+    }
+    result
+}
