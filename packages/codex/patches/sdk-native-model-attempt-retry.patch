+    #[test]
+    fn policy_delay_then_provider_hint_then_native_hint_then_backoff() {
+        use codex_protocol::model_retry::*;
+        let mut context = retry_context();
+        context.normalized.retry_after_ms = Some(300.0);
+        let mut reply = ModelRetryResolution {
+            decision: Some(ModelRetryDecision {
+                retry: true,
+                delay_ms: Some(100.0),
+                ..Default::default()
+            }),
+            provider_advice: Some(ModelRetryAdvice {
+                retry_after_ms: Some(200.0),
+                ..Default::default()
+            }),
+        };
+        assert_eq!(
+            select_retry_delay(
+                &context,
+                Some(&reply),
+                true,
+                false,
+                &ModelRetryBackoff::default(),
+                0.5
+            )
+            .unwrap(),
+            Some(Duration::from_millis(100))
+        );
+        reply.decision.as_mut().unwrap().delay_ms = None;
+        assert_eq!(
+            select_retry_delay(
+                &context,
+                Some(&reply),
+                true,
+                false,
+                &ModelRetryBackoff::default(),
+                0.5
+            )
+            .unwrap(),
