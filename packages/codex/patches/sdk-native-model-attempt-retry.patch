+//! Captured retry configuration and logical-attempt facts. Core owns execution.
+use crate::protocol::TokenUsage;
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+use ts_rs::TS;
+
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRetrySettings {
+    /// Distinguishes explicit empty settings from an inherited policy-disable marker.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub configured: Option<bool>,
+    /// Captured runtime declaration marker; never executable callback data.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub has_policy: Option<bool>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub max_retries: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub backoff: Option<ModelRetryBackoff>,
+}
+
+#[derive(Debug, Clone, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(default, deny_unknown_fields)]
+pub struct ModelRetryBackoff {
+    pub initial_delay_ms: f64,
+    pub max_delay_ms: f64,
+    pub multiplier: f64,
+    pub jitter: bool,
+}
+
+impl Default for ModelRetryBackoff {
+    fn default() -> Self {
+        Self {
+            initial_delay_ms: 250.0,
+            max_delay_ms: 2_000.0,
+            multiplier: 2.0,
+            jitter: true,
+        }
+    }
+}
+
+impl ModelRetrySettings {
+    pub fn apply_patch(&mut self, patch: &Self) {
+        if patch.configured.is_some() {
+            self.configured = patch.configured;
+        }
+        if patch.has_policy.is_some() {
+            self.has_policy = patch.has_policy;
+        }
+        if patch.max_retries.is_some() {
+            self.max_retries = patch.max_retries;
+        }
+        if patch.backoff.is_some() {
+            self.backoff = patch.backoff.clone();
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), String> {
+        if let Some(backoff) = &self.backoff {
+            for (name, value) in [
+                ("initial_delay_ms", backoff.initial_delay_ms),
+                ("max_delay_ms", backoff.max_delay_ms),
+                ("multiplier", backoff.multiplier),
+            ] {
+                if !value.is_finite() || value < 0.0 {
+                    return Err(format!(
+                        "retry.backoff.{name} must be finite and nonnegative"
+                    ));
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRetryError {
+    pub message: String,
+    #[serde(default)]
+    pub status_code: Option<u16>,
+    #[serde(default)]
+    pub error_code: Option<String>,
+    #[serde(default)]
+    pub request_id: Option<String>,
+    #[serde(default)]
+    pub retry_after_ms: Option<f64>,
+    #[serde(default)]
+    pub is_abort: bool,
+    #[serde(default)]
+    pub is_network_error: bool,
+    #[serde(default)]
+    pub is_timeout: bool,
+}
+
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(rename_all = "snake_case")]
+pub enum ModelReplaySafety {
+    Safe,
+    Unsafe,
+    #[default]
+    Unknown,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRetryAdvice {
+    #[serde(default)]
+    pub suggested: Option<bool>,
+    #[serde(default)]
+    pub retry_after_ms: Option<f64>,
+    #[serde(default)]
+    pub replay_safety: ModelReplaySafety,
+    #[serde(default)]
+    pub reason: Option<String>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRetryDecision {
+    pub retry: bool,
+    #[serde(default)]
+    pub delay_ms: Option<f64>,
+    #[serde(default)]
+    pub reason: Option<String>,
+    #[serde(default)]
+    pub approve_unsafe_replay: bool,
+}
+
+impl ModelRetryDecision {
+    pub fn validate(&self) -> Result<(), String> {
+        if self
+            .delay_ms
+            .is_some_and(|delay| !delay.is_finite() || delay < 0.0)
+        {
+            return Err("Retry decision delay_ms must be finite and nonnegative".into());
+        }
+        Ok(())
+    }
+}
+
+/// One Core-owned logical generation attempt, not an opaque client HTTP retry.
+#[derive(Debug, Clone, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
