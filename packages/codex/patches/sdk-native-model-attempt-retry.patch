+    #[test]
+    fn advice_selects_default_retry_without_a_policy() {
+        use codex_protocol::model_retry::*;
+        for (suggested, native_retryable, expected) in [
+            (Some(true), false, true), (Some(false), true, false),
+            (None, true, true), (None, false, false),
