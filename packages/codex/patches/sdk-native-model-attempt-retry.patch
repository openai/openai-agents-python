+#[cfg(test)]
+mod sampling_stop_tests {
+    use super::TurnSamplingStop;
+
+    #[test]
+    fn attempt_retirement_preserves_its_turn_and_follows_graph_cancellation() {
+        let graph = TurnSamplingStop::default();
+        let turn = graph.for_turn();
+        let first = turn.for_turn();
+        first.request();
+        assert!(first.requested());
+        assert!(!turn.requested());
+        assert!(!graph.requested());
+        let retry = turn.for_turn();
+        assert_eq!(retry.try_commit(|| 7), Some(7));
+        graph.request();
+        assert!(retry.requested());
+        assert_eq!(retry.try_commit(|| 8), None);
+    }
+
+    #[test]
+    fn attempt_follows_logical_turn_cancellation_without_stopping_its_sibling() {
+        let graph = TurnSamplingStop::default();
+        let turn = graph.for_turn();
+        let sibling = graph.for_turn();
+        let attempt = turn.for_turn();
+        turn.request();
+        assert!(attempt.requested());
+        assert!(!sibling.requested());
+    }
+
+    #[test]
+    fn context_commit_respects_turn_and_parent_stops() {
+        let parent = TurnSamplingStop::default();
+        let turn = parent.for_turn();
+        let sibling = parent.for_turn();
+        assert_eq!(turn.try_commit(|| 1), Some(1));
+        turn.clone().request();
+        assert_eq!(
+            turn.try_commit(|| panic!("stopped turn committed")),
+            None::<()>
+        );
+        assert_eq!(sibling.try_commit(|| 2), Some(2));
+        parent.request();
+        assert_eq!(
+            sibling.try_commit(|| panic!("stopped parent committed")),
+            None::<()>
+        );
+        assert_eq!(TurnSamplingStop::default().try_commit(|| 3), Some(3));
+    }
+}
