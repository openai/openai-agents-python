+                false, &ModelRetryBackoff::default(), 0.5).unwrap().is_some(), retry);
+        }
+    }
+
+    #[test]
+    fn provider_suggestion_cannot_bypass_native_replay_fences() {
+        use codex_protocol::model_retry::*;
+        for veto in 0..6 {
+            let mut context = retry_context();
+            context.policy_enabled = false;
+            let mut advice = ModelRetryAdvice { suggested: Some(true),
+                replay_safety: ModelReplaySafety::Safe, ..Default::default() };
