+/// Reuse native prompt normalization without changing the captured/live window.
+fn validate_compaction_window(history: &ContextManager, items: &[ResponseItem]) -> CodexResult<()> {
+    use codex_protocol::openai_models::InputModality;
+    let mut candidate = history.clone();
+    candidate.replace_annotated(
+        items
+            .iter()
+            .cloned()
+            .map(ResponseItemEnvelope::new)
+            .collect(),
+    );
+    let projected = candidate.for_prompt(&[
+        InputModality::Text,
+        InputModality::Image,
+        InputModality::Audio,
+    ]);
+    if projected != items {
+        return Err(CodexErr::InvalidRequest(
+            "Compacted window must contain complete tool pairs".into(),
+        ));
+    }
+    Ok(())
+}
+
+/// Only conversation candidates participate in the optional default predicate.
+fn compaction_candidate_indexes(items: &[ResponseItem]) -> Vec<usize> {
+    items
+        .iter()
+        .enumerate()
+        .filter_map(|(index, item)| {
+            (!matches!(item,
+            ResponseItem::Message { role, .. } if role == "user" || role == "system" || role == "developer")
+                && !matches!(
+                    item,
+                    ResponseItem::Compaction { .. }
+                        | ResponseItem::ContextCompaction { .. }
+                        | ResponseItem::ConfigurationUpdate { .. }
+                        | ResponseItem::CompactionTrigger { .. }
+                        | ResponseItem::AdditionalTools { .. }
+                        | ResponseItem::AgentMessage { .. }
+                )
+                && crate::context_manager::rollback_context_update(item).is_none())
+                .then_some(index)
+        })
+        .collect()
+}
