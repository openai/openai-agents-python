+/// Best-effort conversion leaves the normal non-strict schema intact on fallback.
+pub fn mcp_tool_to_best_effort_strict_responses_api_tool(
+    tool_name: &ToolName,
+    tool: &rmcp::model::Tool,
+    schema_max_bytes: Option<usize>,
+) -> Result<ResponsesApiTool, serde_json::Error> {
+    let mut output = mcp_tool_to_responses_api_tool(tool_name, tool, schema_max_bytes)?;
+    if let Some(mut schema) = parse_strict_mcp_tool_schema(tool, schema_max_bytes) {
+        schema.mcp_input_schema_max_bytes = schema_max_bytes;
+        output.strict = true;
+        output.parameters = schema;
+    }
+    Ok(output)
+}
