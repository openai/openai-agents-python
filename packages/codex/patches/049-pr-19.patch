+            &self.non_prefixed_mcp_tool_servers,
+        )
+        .into_iter()
+        .filter(|tool| {
+            self.servers
+                .get(&tool.server_name)
+                .is_some_and(|view| view.tool_filter.allows(&tool.tool.name))
+        })
+        .collect()
+    }
