+struct SdkAgentSpanOwner {
+    parent: codex_otel::sdk_trace::ContextLease,
+    active: Arc<std::sync::Mutex<(bool, Option<codex_otel::sdk_trace::ProviderResponseSpan>)>>,
+}
+struct SdkAgentSpanState(Arc<std::sync::Mutex<(bool, Option<codex_otel::sdk_trace::ProviderResponseSpan>)>>);
+struct SdkAgentRunGuard(Option<Arc<SdkAgentSpanOwner>>);
+impl Drop for SdkAgentRunGuard {
+    fn drop(&mut self) {
+        if let Some(owner) = &self.0 {
+            owner.finish(codex_otel::sdk_trace::ProviderResponseOutcome::Cancelled);
+        }
+    }
+}
+
+impl SdkAgentSpanOwner {
+    fn finish(&self, outcome: codex_otel::sdk_trace::ProviderResponseOutcome) {
+        if let Some(span) = self.active.lock().unwrap_or_else(|e| e.into_inner()).1.take() {
+            span.finish(outcome);
+        }
+    }
+}
+
+pub(crate) fn sdk_agent_span_parent(
+    step: &StepContext,
+) -> Result<Option<codex_otel::sdk_trace::ContextLease>, String> {
+    let Some(owner) = step.turn.extension_data.get::<SdkAgentSpanState>() else {
+        return Ok(None);
+    };
+    let active = owner.0.lock().unwrap_or_else(|e| e.into_inner());
+    active.1.as_ref().map(|span| span.agent_parent_lease()).transpose()
+}
+
+async fn admit_sdk_agent_lifetime(
+    sess: &Session,
+    step: &Arc<StepContext>,
+    owner: &SdkAgentSpanOwner,
+    new_entry: bool,
+    cancellation: CancellationToken,
+) -> CodexResult<()> {
+    if step.extension_data.get::<codex_extension_api::SdkTurnReceiptSeed>().is_none() {
+        return Ok(());
+    }
+    if owner.active.lock().unwrap_or_else(|e| e.into_inner()).0 && !new_entry {
+        return Ok(());
+    }
+    if new_entry {
+        owner.finish(codex_otel::sdk_trace::ProviderResponseOutcome::Ok);
+    }
+    let admission = crate::model_request::tool_admission_for_step(
+        sess.thread_id.to_string(), step.clone(), Vec::new(),
+    );
+    let mut selected = None;
+    for contributor in sess.services.extensions.model_request_contributors() {
+        if cancellation.is_cancelled() { return Err(CodexErr::TurnAborted); }
+        let reply = contributor.admit_agent_span(codex_extension_api::SdkAgentSpanInput {
+            admission: admission.clone(),
+            parent_context: owner.parent.token().to_owned(), cancellation: cancellation.clone(),
+        }).await.map_err(CodexErr::Fatal)?;
+        if !matches!(reply, codex_extension_api::SdkAgentSpanAdmission::Unhandled)
+            && selected.replace(reply).is_some() {
+            return Err(CodexErr::Fatal("Multiple SDK Agent span admissions".into()));
+        }
+    }
+    if cancellation.is_cancelled() { return Err(CodexErr::TurnAborted); }
+    let Some(selected) = selected else { return Ok(()); };
+    // The accepted transition already committed. Only observation changes here.
+    owner.finish(codex_otel::sdk_trace::ProviderResponseOutcome::Ok);
+    let span = match selected {
+        codex_extension_api::SdkAgentSpanAdmission::Record(record) => Some(
+            codex_otel::sdk_trace::start_sdk_semantic_span(
+                &owner.parent, record.span_id, record.name, "agent",
+            ).map_err(CodexErr::Fatal)?
+        ),
+        codex_extension_api::SdkAgentSpanAdmission::Suppress => None,
+        codex_extension_api::SdkAgentSpanAdmission::Unhandled => unreachable!(),
+    };
+    *owner.active.lock().unwrap_or_else(|e| e.into_inner()) = (true, span);
+    Ok(())
+}
