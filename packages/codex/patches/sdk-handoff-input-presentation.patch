+/// Retire a derived view only after its native publication leaves canonical context.
+pub(super) fn profile_after_history_replacement(
+    captured: &Arc<CapturedAgentProfile>,
+    replacement: &[ResponseItemEnvelope],
+) -> Arc<CapturedAgentProfile> {
+    use codex_protocol::agent_profile::AgentProfileHandoffPresentation;
+    if captured
+        .profile
+        .data
+        .get::<AgentProfileHandoffPresentation>()
+        .is_none()
+        || retains_publication(replacement, &captured.profile.application_instructions.item)
+    {
+        return Arc::clone(captured);
+    }
+    let mut profile = captured.profile.as_ref().clone();
+    profile.data.remove::<AgentProfileHandoffPresentation>();
+    Arc::new(CapturedAgentProfile {
+        receipt: captured.receipt.clone(),
+        profile: Arc::new(profile),
+    })
+}
