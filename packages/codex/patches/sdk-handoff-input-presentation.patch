+pub(crate) fn check_handoff_budget<'a, T: Serialize + 'a>(
+    values: impl IntoIterator<Item = &'a T>,
+) -> Result<(), String> {
+    let mut budget = crate::client::provider_history::HistoryBudget::default();
+    for value in values {
+        budget.observe(value).map_err(|error| error.to_string())?;
+    }
+    Ok(())
+}
+
+fn protected_handoff_item(item: &ResponseItem) -> bool {
+    matches!(item, ResponseItem::Message { role, .. } if role != "user" && role != "assistant")
+}
+
+fn handoff_input(
+    presentation: &codex_protocol::agent_profile::AgentProfileHandoffPresentation,
+) -> Result<Vec<ResponseItem>, String> {
+    // Reuse the native original/provider-history aggregate admission ceiling.
+    // Count borrowed JSON before cloning or parsing any application item.
+    check_handoff_budget(
+        presentation
+            .input
+            .iter()
+            .chain(&presentation.previous)
+            .chain(&presentation.generated),
+    )?;
+    presentation
+        .input
+        .iter()
+        .chain(&presentation.previous)
+        .chain(&presentation.generated)
+        .map(|value| {
+            let item: ResponseItem = parse_preserving(value.clone())?;
+            if protected_handoff_item(&item) {
+                return Err("Handoff presentation cannot supply protected message roles".into());
+            }
+            Ok(item)
+        })
+        .collect()
+}
+
+pub(crate) fn validate_handoff_presentation(
+    presentation: &codex_protocol::agent_profile::AgentProfileHandoffPresentation,
+) -> Result<(), String> {
+    handoff_input(presentation).map(|_| ())
+}
+
+/// Build a sampling copy; canonical effect history and tool admission remain unchanged.
+pub(crate) fn apply_handoff_presentation(
+    original: &Prompt,
+    presentation: &codex_protocol::agent_profile::AgentProfileHandoffPresentation,
+    committed: &codex_extension_api::AgentProfileReceipt,
+    publication: &ResponseItem,
+) -> Result<Prompt, String> {
+    if !presentation.belongs_to(committed) {
+        return Err("Handoff presentation belongs to another committed destination".into());
+    }
+    if original.canonical_history_input.is_some() {
+        return Err("Handoff presentation does not support provider-owned opaque history".into());
+    }
+    let projected = handoff_input(presentation)?;
+    let publication_id = publication
+        .id()
+        .ok_or("Handoff destination publication lacks identity")?;
+    let anchors: Vec<_> = original
+        .input
+        .iter()
+        .enumerate()
+        .filter_map(|(index, item)| (item.id() == Some(publication_id)).then_some(index))
+        .collect();
+    if anchors.len() != 1 || original.input[anchors[0]] != *publication {
+        return Err("Handoff destination publication is missing, ambiguous or changed".into());
+    }
+    let mut input: Vec<_> = original
+        .input
+        .iter()
+        .filter(|item| protected_handoff_item(item))
+        .cloned()
+        .collect();
+    if projected.iter().any(|item| {
+        item.id()
+            .is_some_and(|id| input.iter().any(|protected| protected.id() == Some(id)))
+    }) {
+        return Err("Handoff presentation reuses protected publication identity".into());
+    }
+    input.extend(projected);
+    // New native effects and subsequent user input follow the actual committed
+    // destination publication. Keep this suffix through every sampling step.
+    input.extend(
+        original.input[anchors[0] + 1..]
+            .iter()
+            .filter(|item| !protected_handoff_item(item))
+            .cloned(),
+    );
+    check_handoff_budget(&input)?;
+    let mut result = original.clone();
+    result.input = input;
+    Ok(result)
+}
