+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct HandoffInputFrontiers {
+    root_count: usize,
+    root_sha256: String,
+    sample_count: usize,
+    sample_sha256: String,
+}
+#[derive(Default)]
+struct HandoffInputFrontierOwner(std::sync::Mutex<Option<HandoffInputFrontiers>>);
+
+pub(crate) fn forget_handoff_sampling_frontier(store: &codex_extension_api::ExtensionData) {
+    store.remove::<HandoffInputFrontierOwner>();
+}
+
+pub(crate) fn handoff_sampling_frontier(store: &codex_extension_api::ExtensionData) -> Option<serde_json::Value> {
+    let owner = store.get::<HandoffInputFrontierOwner>()?;
+    let frontier = owner.0.lock().ok()?.clone()?;
+    serde_json::to_value(frontier).ok()
+}
+
+fn handoff_prefix_digest(items: &[&ResponseItem]) -> CodexResult<String> {
+    use sha2::{Digest, Sha256};
+    let bytes = serde_json::to_vec(items).map_err(|error| invalid(error.to_string()))?;
+    Ok(format!("{:x}", Sha256::digest(bytes)))
+}
+
+impl Session {
+    pub(crate) async fn record_handoff_input_frontier(&self, context: &Arc<TurnContext>) -> CodexResult<()> {
+        if self.services.thread_extension_data.get::<
+            codex_protocol::agent_profile::AgentProfileHandoffInputCapture,
+        >().is_none() { return Ok(()); }
+        let history = self.clone_history().await;
+        crate::prepared_request::check_handoff_budget(history.raw_items()).map_err(invalid)?;
+        let items: Vec<_> = history.raw_items().collect();
+        let owner = context.extension_data.get_or_init(HandoffInputFrontierOwner::default);
+        let mut prior = owner.0.lock().map_err(|_| invalid("Handoff frontier owner poisoned"))?.clone();
+        if prior.is_none() {
+            prior = self.restored_handoff_input_frontier(context).await?;
+        }
+        let (root_count, root_sha256) = if let Some(prior) = prior {
+            if prior.root_count > items.len() || handoff_prefix_digest(&items[..prior.root_count])? != prior.root_sha256 {
+                return Err(invalid("Handoff original input prefix changed"));
+            }
+            (prior.root_count, prior.root_sha256)
+        } else { (items.len(), handoff_prefix_digest(&items)?) };
+        let frontier = HandoffInputFrontiers { root_count, root_sha256,
+            sample_count:items.len(), sample_sha256:handoff_prefix_digest(&items)? };
+        *owner.0.lock().map_err(|_| invalid("Handoff frontier owner poisoned"))? = Some(frontier);
+        Ok(())
+    }
+
+    async fn restored_handoff_input_frontier(
+        &self, context: &Arc<TurnContext>,
+    ) -> CodexResult<Option<HandoffInputFrontiers>> {
+        let saved = self.live_thread().ok_or_else(|| invalid("Handoff input requires retained history"))?
+            .load_history(true).await.map_err(|_| persistence_failure())?;
+        let receipt = saved.items.iter().rev().find_map(|row| match row {
+            RolloutItem::TurnContext(row) if row.turn_id.as_deref() == Some(context.sub_id.as_str()) => row.sdk_receipt.as_ref(),
+            _ => None,
+        });
+        receipt.map(|receipt| serde_json::from_value(receipt.get("handoff_input_frontiers")
+            .ok_or_else(|| invalid("Restored handoff input lacks original native frontiers"))?.clone())
+            .map_err(|_| invalid("Invalid restored handoff input frontiers"))).transpose()
+    }
+
+    async fn prepare_handoff_input(
+        &self, context: &Arc<TurnContext>,
+        source: Option<&Arc<codex_extension_api::CapturedAgentProfile>>,
+        handoff: &codex_protocol::agent_profile::AgentProfileHandoff,
+    ) -> CodexResult<codex_protocol::agent_profile::AgentProfileHandoffPresentation> {
+        use codex_protocol::agent_profile::AgentProfileHandoffPresentation;
+        if self.services.model_client.provider_history_selection().is_some() {
+            return Err(invalid("Handoff preparation does not support provider-owned opaque history"));
+        }
+        if self.services.extensions.model_request_contributors().iter()
+            .any(|contributor| contributor.prepares_request(&context.extension_data)) {
+            return Err(invalid("Handoff preparation cannot combine with prepare_request"));
+        }
+        if source.is_some_and(|source| source.profile.data.get::<
+            crate::realtime_conversation::VoiceProfileScope,
+        >().is_some()) {
+            return Err(invalid("Handoff preparation does not support Realtime"));
+        }
+        let retained = context.extension_data.get::<HandoffInputFrontierOwner>()
+            .map(|owner| owner.0.lock().map_err(|_| invalid("Handoff frontier owner poisoned"))
+                .map(|frontier| frontier.clone())).transpose()?.flatten();
+        let frontier = match retained {
+            Some(frontier) => frontier,
+            None => self.restored_handoff_input_frontier(context).await?
+                .ok_or_else(|| invalid("Accepted handoff lacks native input frontiers"))?,
+        };
+        let history = self.clone_history().await;
+        crate::prepared_request::check_handoff_budget(history.raw_items()).map_err(invalid)?;
+        let items: Vec<_> = history.raw_items().collect();
+        if frontier.root_count > frontier.sample_count || frontier.sample_count > items.len()
+            || handoff_prefix_digest(&items[..frontier.root_count])? != frontier.root_sha256
+            || handoff_prefix_digest(&items[..frontier.sample_count])? != frontier.sample_sha256 {
+            return Err(invalid("Accepted handoff input frontiers changed"));
+        }
+        let values = |items: &[&ResponseItem]| -> CodexResult<Vec<serde_json::Value>> {
+            items.iter().filter(|item| !matches!(item, ResponseItem::Message { role, .. }
+                if role != "user" && role != "assistant"))
+                .map(|item| serde_json::to_value(item).map_err(|error| invalid(error.to_string()))).collect()
+        };
+        let mut input = values(&items[..frontier.root_count])?;
+        let mut previous = values(&items[frontier.root_count..frontier.sample_count])?;
+        if let Some(source) = source {
+            if let Some(presentation) = source.profile.data.get::<AgentProfileHandoffPresentation>() {
+                if !presentation.belongs_to(&source.receipt) { return Err(invalid("Source handoff presentation is stale")); }
+                let publication = &source.profile.application_instructions.item;
+                let anchors: Vec<_> = items.iter().enumerate().filter_map(|(index,item)|
+                    (item.id() == publication.id()).then_some(index)).collect();
+                if anchors.len() != 1 || *items[anchors[0]] != *publication || anchors[0] >= frontier.sample_count {
+                    return Err(invalid("Source handoff publication is missing or changed"));
+                }
+                let anchor = anchors[0] + 1;
+                input = presentation.input.clone();
+                if anchor > frontier.root_count {
+                    previous = presentation.previous.iter().chain(&presentation.generated).cloned().collect();
+                    previous.extend(values(&items[anchor..frontier.sample_count])?);
+                } else {
+                    input.extend(presentation.previous.iter().chain(&presentation.generated).cloned());
+                    input.extend(values(&items[anchor..frontier.root_count])?);
+                }
+            }
+        }
+        let presentation = AgentProfileHandoffPresentation {
+            handoff:handoff.clone(), destination:AgentProfileReceipt {
+                profile_id:handoff.target_profile_id.clone(),
+                epoch:handoff.source.epoch.checked_add(1).ok_or_else(|| invalid("Agent profile epoch exhausted"))?,
+            }, input, previous, generated:values(&items[frontier.sample_count..])?,
+        };
+        crate::prepared_request::validate_handoff_presentation(&presentation).map_err(invalid)?;
+        Ok(presentation)
+    }
+}
