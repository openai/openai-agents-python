+    #[test]
+    fn handoff_sampling_keeps_publication_and_settled_pair_across_steps() {
+        let (original, presentation, receipt, publication) = handoff_case();
+        let projected =
+            apply_handoff_presentation(&original, &presentation, &receipt, &publication).unwrap();
+        assert_eq!(projected.input[0], publication);
+        for (index, group) in [
+            &presentation.input,
+            &presentation.previous,
+            &presentation.generated,
+        ]
+        .iter()
+        .enumerate()
+        {
+            assert_eq!(
+                serde_json::to_value(&projected.input[index + 1]).unwrap(),
+                group[0]
+            );
+        }
+        assert_eq!(&projected.input[4..], &original.input[2..]);
+        assert!(
+            !serde_json::to_string(&projected.input)
+                .unwrap()
+                .contains("old source secret")
+        );
+        assert_eq!(projected.tools, original.tools);
+        assert_eq!(
+            projected.base_instructions.text,
+            original.base_instructions.text
+        );
+        let mut later = original.clone();
+        later.input.push(parse_preserving(json!({"type":"message","role":"user","content":[{"type":"input_text","text":"later input"}]})).unwrap());
+        let second =
+            apply_handoff_presentation(&later, &presentation, &receipt, &publication).unwrap();
+        assert_eq!(&second.input[4..], &later.input[2..]);
+        assert!(
+            serde_json::to_string(&original.input)
+                .unwrap()
+                .contains("old source secret")
+        );
+    }
