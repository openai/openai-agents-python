+fn retains_publication(items: &[ResponseItemEnvelope], publication: &ResponseItem) -> bool {
+    let Some(id) = publication.id() else {
+        return false;
+    };
+    let mut matching = items.iter().filter(|item| item.item.id() == Some(id));
+    matching
+        .next()
+        .is_some_and(|item| item.item == *publication)
+        && matching.next().is_none()
+}
