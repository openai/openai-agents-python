+impl AgentProfileHandoff {
+    /// The accepted transfer consumes exactly the next epoch of its destination.
+    pub fn matches_destination(&self, committed: &AgentProfileReceipt) -> bool {
+        self.target_profile_id == committed.profile_id
+            && self.source.epoch.checked_add(1) == Some(committed.epoch)
+    }
+}
