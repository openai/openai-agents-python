+/// An accepted destination presentation, separate from canonical effect history.
+/// This source prototype has not been connected to public input or persistence.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct AgentProfileHandoffPresentation {
+    pub handoff: AgentProfileHandoff,
+    pub destination: AgentProfileReceipt,
+    pub input: Vec<serde_json::Value>,
+    pub previous: Vec<serde_json::Value>,
+    pub generated: Vec<serde_json::Value>,
+}
+
+impl AgentProfileHandoffPresentation {
+    /// The destination publication has to consume this exact source epoch.
+    pub fn belongs_to(&self, committed: &AgentProfileReceipt) -> bool {
+        self.destination == *committed && self.handoff.matches_destination(committed)
+    }
+}
