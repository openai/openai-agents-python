+        let (original, presentation, receipt, publication) = handoff_case();
+        let mut invalid = presentation.clone();
+        invalid.input[0] = json!({"type":"message","role":"developer","content":[]});
+        let mut discarded = presentation.clone();
+        discarded.input[0]["unknown"] = Value::Null;
+        let mut over_count = presentation.clone();
+        over_count.input = vec![presentation.input[0].clone(); 4097];
+        let mut over_bytes = presentation.clone();
+        over_bytes.input[0]["content"][0]["text"] = Value::String("é".repeat(4 * 1024 * 1024 + 1));
+        let mut stale = presentation.clone();
+        stale.destination.epoch = 2;
+        let mut provider_calls = 0;
+        for rejected in [invalid, discarded, over_count, over_bytes, stale] {
+            let result = apply_handoff_presentation(&original, &rejected, &receipt, &publication)
+                .map(|_| {
+                    provider_calls += 1;
+                });
+            assert!(result.is_err());
+        }
+        let mut missing = original.clone();
+        missing.input.remove(1);
+        assert!(
+            apply_handoff_presentation(&missing, &presentation, &receipt, &publication).is_err()
+        );
+        assert_eq!(provider_calls, 0);
+    }
