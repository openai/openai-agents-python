+// Durable snapshots retain model preferences and rebind transport at runtime.
+mod persisted_request_controls {
+    use crate::model_request_controls::ModelRequestControls;
+    use serde::{Deserialize, Deserializer, Serialize, Serializer};
+
+    pub fn serialize<S: Serializer>(
+        value: &ModelRequestControls,
+        serializer: S,
+    ) -> Result<S::Ok, S::Error> {
+        value.for_persistence().serialize(serializer)
+    }
+
+    pub fn deserialize<'de, D: Deserializer<'de>>(
+        deserializer: D,
+    ) -> Result<ModelRequestControls, D::Error> {
+        Ok(ModelRequestControls::deserialize(deserializer)?.for_persistence())
+    }
+}
+
+mod persisted_model_settings_override {
+    use crate::model_request_controls::RunModelSettingsOverride;
+    use serde::{Deserialize, Deserializer, Serialize, Serializer};
+
+    pub fn serialize<S: Serializer>(
+        value: &Option<RunModelSettingsOverride>,
+        serializer: S,
+    ) -> Result<S::Ok, S::Error> {
+        value
+            .as_ref()
+            .map(RunModelSettingsOverride::for_persistence)
+            .serialize(serializer)
+    }
+
+    pub fn deserialize<'de, D: Deserializer<'de>>(
+        deserializer: D,
+    ) -> Result<Option<RunModelSettingsOverride>, D::Error> {
+        Ok(
+            Option::<RunModelSettingsOverride>::deserialize(deserializer)?
+                .map(|value| value.for_persistence()),
+        )
+    }
+}
