+/// An opaque provider declaration with no local executor or approval authority.
+#[derive(Clone, Serialize, PartialEq)]
+#[serde(transparent)]
+pub struct ProviderToolDefinition {
+    definition: serde_json::Map<String, serde_json::Value>,
+}
+
+impl ProviderToolDefinition {
+    pub fn new(definition: serde_json::Map<String, serde_json::Value>) -> Result<Self, String> {
+        let Some(kind) = definition.get("type").and_then(serde_json::Value::as_str) else {
+            return Err("Provider-only tool requires a nonempty type".into());
+        };
+        if kind.is_empty() || kind.trim() != kind || kind.contains('\0') {
+            return Err("Provider-only tool requires a nonempty type".into());
+        }
+        if matches!(
+            kind,
+            "function"
+                | "namespace"
+                | "custom"
+                | "apply_patch"
+                | "computer"
+                | "computer_use_preview"
+                | "local_shell"
+                | "shell"
+                | "tool_search"
+                | "mcp"
+                | "web_search"
+                | "file_search"
+                | "code_interpreter"
+                | "image_generation"
+                | "provider_only"
+        ) {
+            return Err("Use the typed declaration for this tool category".into());
+        }
+        Ok(Self { definition })
+    }
+
+    pub fn tool_type(&self) -> &str {
+        self.definition["type"]
+            .as_str()
+            .expect("validated provider tool type")
+    }
+
+    pub fn declared_name(&self) -> Option<&str> {
+        self.definition
+            .get("name")
+            .and_then(serde_json::Value::as_str)
+    }
+}
+
+impl<'de> Deserialize<'de> for ProviderToolDefinition {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let definition = serde_json::Map::deserialize(deserializer)?;
+        Self::new(definition).map_err(serde::de::Error::custom)
+    }
+}
+
+impl std::fmt::Debug for ProviderToolDefinition {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ProviderToolDefinition")
+            .field("provider_field_count", &self.definition.len())
+            .finish_non_exhaustive()
+    }
+}
