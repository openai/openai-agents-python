+#[cfg(test)]
+mod provider_only_tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn opaque_provider_definition_keeps_wire_fields_without_callable_authority() {
+        let definition = json!({
+            "type":"future_hosted", "name":"remote_action",
+            "kind":"opaque-provider-field", "future":{"values":[true,null,{"format":"vendor"}]}
+        });
+        let hosted: HostedToolSpec = serde_json::from_value(json!({
+            "type":"provider_only", "definition":definition
+        }))
+        .unwrap();
+        let spec = crate::ToolSpec::from(hosted);
+        assert_eq!(serde_json::to_value(&spec).unwrap(), definition);
+        assert_eq!(spec.name(), "future_hosted");
+        assert!(!spec.has_eager_callable(&codex_protocol::ToolName::plain("future_hosted")));
+        assert!(!spec.has_eager_callable(&codex_protocol::ToolName::plain("remote_action")));
+        assert!(crate::ToolSearchInfo::from_tool_spec(spec.clone(), None).is_none());
+        assert!(crate::tool_spec_to_code_mode_tool_definition(&spec).is_none());
+        assert!(spec.deferred_for_provider_search().is_none());
+    }
+
+    #[test]
+    fn provider_definition_rejects_native_and_approval_categories_and_redacts_debug() {
+        for kind in [
+            "function",
+            "namespace",
+            "custom",
+            "apply_patch",
+            "computer",
+            "computer_use_preview",
+            "local_shell",
+            "shell",
+            "tool_search",
+            "mcp",
+            "web_search",
+            "file_search",
+            "code_interpreter",
+            "image_generation",
+            "provider_only",
+        ] {
+            assert!(
+                serde_json::from_value::<HostedToolSpec>(json!({
+                    "type":"provider_only", "definition":{"type":kind}
+                }))
+                .is_err()
+            );
+        }
+        for definition in [
+            json!({}),
+            json!({"type":null}),
+            json!({"type":""}),
+            json!({"type":" future "}),
+        ] {
+            assert!(
+                serde_json::from_value::<HostedToolSpec>(json!({
+                    "type":"provider_only", "definition":definition
+                }))
+                .is_err()
+            );
+        }
+        let spec: HostedToolSpec = serde_json::from_value(json!({
+            "type":"provider_only", "definition":{"type":"future_hosted", "private_option":"synthetic-provider-value"}
+        })).unwrap();
+        assert!(!format!("{spec:?}").contains("synthetic-provider-value"));
+    }
+}
