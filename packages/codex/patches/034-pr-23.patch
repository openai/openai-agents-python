+            json!({"actions":[{"type":"screenshot"}]}),
+        ] {
+            let mut item = json!({"type":"computer_call","id":"cu_1","call_id":"c1","status":"completed","pending_safety_checks":[{"id":"s1","code":"domain","message":"confirm"}],"future_field":{"keep":true}});
+            item.as_object_mut()
+                .unwrap()
+                .extend(action.as_object().unwrap().clone());
+            let parsed: ResponseItem = serde_json::from_value(item.clone()).unwrap();
+            assert!(matches!(parsed, ResponseItem::ComputerCall { .. }));
+            assert_eq!(serde_json::to_value(parsed).unwrap(), item);
+        }
+    }
+}
