+// A finite bind view can exceed PATH_MAX even when its original tree does not.
+// Keep the ordinary path walk fast; reopen only overlong paths one component at
+// a time. Retain the final descriptor until its ReadDir entries have been used.
+#[cfg(target_os = "linux")]
+fn read_helper_directory(
+    root: &Path,
+    directory: &Path,
+) -> io::Result<(Option<fs::File>, fs::ReadDir)> {
+    match fs::read_dir(directory) {
+        Ok(entries) => Ok((None, entries)),
+        Err(error) if error.raw_os_error() == Some(libc::ENAMETOOLONG) => {
+            let relative = directory.strip_prefix(root).map_err(io::Error::other)?;
+            // Preserve the existing grant-root lookup, including an explicit
+            // root alias. Descendants are still never followed through symlinks.
+            let mut opened = fs::File::open(root)?;
+            for component in relative {
+                let path =
+                    PathBuf::from(format!("/proc/self/fd/{}", opened.as_raw_fd())).join(component);
+                opened = fs::OpenOptions::new()
+                    .read(true)
+                    .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW)
+                    .open(path)?;
+            }
+            let entries = fs::read_dir(format!("/proc/self/fd/{}", opened.as_raw_fd()))?;
+            Ok((Some(opened), entries))
+        }
+        Err(error) => Err(error),
+    }
+}
