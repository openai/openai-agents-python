+                "result": { "sessionId": "registered-termination" }
+            }),
+        )
+        .await;
+        assert_eq!(recv_exec_request(&mut peer).await["method"], "initialized");
+
+        let start = recv_exec_request(&mut peer).await;
+        assert_eq!(start["method"], "process/start");
+        assert_eq!(start["params"]["processId"], "registered-process");
+        send_exec_message(
+            &mut peer,
