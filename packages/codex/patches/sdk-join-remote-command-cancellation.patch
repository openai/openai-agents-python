+async fn owned_remote_termination_waits_for_ack_and_peer_exit(ack_first: bool) {
+    let (process, mut peer) = start_owned_remote_process().await;
+    {
+        let first = process.join_remote_termination();
+        let second = process.join_remote_termination();
+        tokio::pin!(first, second);
+        assert!(futures::poll!(first.as_mut()).is_pending());
+        assert!(futures::poll!(second.as_mut()).is_pending());
+
+        let request = recv_terminate(&mut peer).await;
+        if ack_first {
+            acknowledge_terminate(&mut peer, &request).await;
+        } else {
+            send_peer_exit(&mut peer).await;
+        }
+        assert!(
+            tokio::time::timeout(Duration::from_millis(100), first.as_mut())
+                .await
+                .is_err(),
+            "a single gate must not complete termination"
+        );
+        assert!(futures::poll!(second.as_mut()).is_pending());
+
+        if ack_first {
+            send_peer_exit(&mut peer).await;
+        } else {
+            acknowledge_terminate(&mut peer, &request).await;
+        }
+        assert_eq!(
+            tokio::time::timeout(Duration::from_secs(3), async {
+                tokio::join!(first.as_mut(), second.as_mut())
+            })
+            .await
+            .expect("both termination callers should finish"),
+            (true, true)
+        );
+    }
+    drop(process);
+    assert_peer_has_no_more_requests(&mut peer).await;
+}
