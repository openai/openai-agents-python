+        let (stream, _) = listener.accept().await.expect("executor connection");
+        let mut peer = tokio_tungstenite::accept_async(stream)
+            .await
+            .expect("executor handshake");
+        let initialize = recv_exec_request(&mut peer).await;
+        assert_eq!(initialize["method"], "initialize");
+        send_exec_message(
