diff --git a/codex-rs/core/src/session/sdk_raw_usage.rs b/codex-rs/core/src/session/sdk_raw_usage.rs
new file mode 100644
index 00000000..82503709
--- /dev/null
+++ b/codex-rs/core/src/session/sdk_raw_usage.rs
@@ -0,0 +1,198 @@
+use crate::session::turn_context::TurnContext;
+use std::io;
+use std::io::Write;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::Weak;
+
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::ResponseObservation;
+use serde::Serialize;
+use serde_json::Value;
+
+const MAX_RECORDS: usize = 4096;
+const MAX_BYTES: usize = 8 * 1024 * 1024;
+
+#[derive(Serialize)]
+pub(crate) struct RawUsage {
+    response_id: String,
+    upstream_request_id: Option<String>,
+    usage: Value,
+}
+
+impl RawUsage {
+    pub(crate) fn from_observation(
+        observation: &ResponseObservation,
+        usage: Option<Value>,
+    ) -> Option<Self> {
+        if observation.status != codex_protocol::protocol::ResponseObservationStatus::Completed {
+            return None;
+        }
+        Some(Self {
+            usage: usage.filter(Value::is_object)?,
+            response_id: observation.response_id.clone()?,
+            upstream_request_id: observation.upstream_request_id.clone(),
+        })
+    }
+
+    pub(crate) fn matches_response(&self, response_id: &str) -> bool {
+        self.response_id == response_id
+    }
+}
+
+struct Capture {
+    turn_id: Option<String>,
+    records: Vec<RawUsage>,
+    remaining_bytes: usize,
+    overflowed: bool,
+    finished: bool,
+}
+
+impl Default for Capture {
+    fn default() -> Self {
+        Self {
+            turn_id: None,
+            records: Vec::new(),
+            remaining_bytes: MAX_BYTES - 2,
+            overflowed: false,
+            finished: false,
+        }
+    }
+}
+
+enum CaptureOwner {
+    Root(Arc<Mutex<Capture>>),
+    Child(Weak<Mutex<Capture>>),
+}
+
+/// A link for an admitted child thread to record usage in the root invocation.
+pub struct SdkRawUsageLink(Weak<Mutex<Capture>>);
+
+impl SdkRawUsageLink {
+    /// Reports whether this existing invocation still accepts capture.
+    pub fn is_active(&self) -> bool {
+        self.0.upgrade().is_some_and(|capture| {
+            !capture.lock().unwrap_or_else(|error| error.into_inner()).finished
+        })
+    }
+
+    /// Attach this invocation's capture without extending its lifetime.
+    pub fn attach(&self, store: &codex_extension_api::ExtensionData) {
+        if self.0.strong_count() == 0 {
+            store.remove::<SdkRawUsage>();
+        } else {
+            store.insert(SdkRawUsage(CaptureOwner::Child(self.0.clone())));
+        }
+    }
+}
+
+pub(crate) struct SdkRawUsage(CaptureOwner);
+
+impl Default for SdkRawUsage {
+    fn default() -> Self {
+        Self(CaptureOwner::Root(Arc::default()))
+    }
+}
+
+impl SdkRawUsage {
+    pub(crate) fn child_link(&self) -> SdkRawUsageLink {
+        match &self.0 {
+            CaptureOwner::Root(capture) => SdkRawUsageLink(Arc::downgrade(capture)),
+            CaptureOwner::Child(capture) => SdkRawUsageLink(capture.clone()),
+        }
+    }
+
+    pub(crate) fn record_for_turn(&self, turn_context: &TurnContext, record: RawUsage) {
+        let root_turn_id = turn_context.turn_metadata_state.root_turn_id();
+        self.record(
+            root_turn_id.as_deref().unwrap_or(&turn_context.sub_id),
+            record.response_id,
+            record.upstream_request_id,
+            record.usage,
+        );
+    }
+
+    pub(crate) fn record(
+        &self,
+        turn_id: &str,
+        response_id: String,
+        upstream_request_id: Option<String>,
+        usage: Value,
+    ) {
+        let (capture, turn_id) = match &self.0 {
+            CaptureOwner::Root(capture) => (Arc::clone(capture), Some(turn_id)),
+            CaptureOwner::Child(link) => {
+                let Some(capture) = link.upgrade() else {
+                    return;
+                };
+                (capture, None)
+            }
+        };
+        let mut capture = capture.lock().unwrap_or_else(|error| error.into_inner());
+        if capture.finished || capture.overflowed {
+            return;
+        }
+        if let Some(turn_id) = turn_id {
+            if capture.turn_id.as_deref().is_some_and(|id| id != turn_id) {
+                return;
+            }
+            capture.turn_id.get_or_insert_with(|| turn_id.to_owned());
+        }
+        let record = RawUsage {
+            response_id,
+            upstream_request_id,
+            usage,
+        };
+        let mut budget = CaptureBudget(capture.remaining_bytes.saturating_sub(1));
+        if capture.records.len() == MAX_RECORDS
+            || serde_json::to_writer(&mut budget, &record).is_err()
+        {
+            capture.overflowed = true;
+            capture.records.clear();
+            return;
+        }
+        capture.remaining_bytes = budget.0;
+        capture.records.push(record);
+    }
+
+    pub(crate) fn finish(&self, turn_id: &str) -> CodexResult<String> {
+        let CaptureOwner::Root(capture) = &self.0 else {
+            return Err(CodexErr::InvalidRequest(
+                "Provider usage belongs to the root invocation".into(),
+            ));
+        };
+        let mut capture = capture.lock().unwrap_or_else(|error| error.into_inner());
+        capture.finished = true;
+        if capture.turn_id.as_deref().is_some_and(|id| id != turn_id) {
+            capture.records.clear();
+            return Err(CodexErr::InvalidRequest(
+                "Provider usage belongs to a different turn".into(),
+            ));
+        }
+        if capture.overflowed {
+            return Err(CodexErr::InvalidRequest(
+                "Provider usage exceeds the SDK capture limit".into(),
+            ));
+        }
+        serde_json::to_string(&std::mem::take(&mut capture.records)).map_err(|_| {
+            CodexErr::InvalidRequest("Unable to encode captured provider usage".into())
+        })
+    }
+}
+
+struct CaptureBudget(usize);
+
+impl Write for CaptureBudget {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        self.0 = self
+            .0
+            .checked_sub(buf.len())
+            .ok_or(io::ErrorKind::WriteZero)?;
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
