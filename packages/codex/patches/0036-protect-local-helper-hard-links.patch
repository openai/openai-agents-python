+    /// Detect ordinary hard links to resolved helper files in Linux write grants.
+    #[cfg(target_os = "linux")]
+    pub fn contains_hard_link_to_any(&self, paths: &[PathBuf]) -> io::Result<bool> {
+        let mut linked_helpers = HashSet::new();
+        for path in paths {
+            let metadata = fs::symlink_metadata(path)?;
+            if metadata.is_file() && metadata.nlink() > 1 {
+                linked_helpers.insert((metadata.dev(), metadata.ino()));
+            }
+        }
+        if linked_helpers.is_empty() {
+            return Ok(false);
+        }
+
+        // A package manager may keep other links outside the grants. Walk the
+        // grants once for all multiply linked helpers and never follow symlinks.
+        let mut directories = Vec::new();
+        for root in self.roots {
+            if !self
+                .roots
+                .iter()
+                .any(|other| root != other && root.as_path().starts_with(other.as_path()))
+            {
+                directories.push(root.as_path().to_path_buf());
+            }
+        }
+        while let Some(directory) = directories.pop() {
+            for entry in fs::read_dir(directory)? {
+                let entry = entry?;
+                let kind = entry.file_type()?;
+                if kind.is_dir() {
+                    directories.push(entry.path());
+                } else if kind.is_file() {
+                    let metadata = entry.metadata()?;
+                    if linked_helpers.contains(&(metadata.dev(), metadata.ino())) {
+                        return Ok(true);
+                    }
+                }
+            }
+        }
+        Ok(false)
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub fn contains_hard_link_to_any(&self, _paths: &[PathBuf]) -> io::Result<bool> {
+        Ok(false)
+    }
