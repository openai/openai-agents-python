+#[derive(Debug, Clone, Serialize, PartialEq)]
+pub struct ApplicationShellEnvironment {
+    #[serde(rename = "type")]
+    kind: &'static str,
+    #[serde(skip_serializing_if = "Vec::is_empty")]
+    skills: Vec<LocalShellSkill>,
+}
+
+pub fn application_shell_spec(spec: &DynamicShellToolSpec) -> ToolSpec {
+    ToolSpec::ApplicationShell {
+        environment: ApplicationShellEnvironment {
+            kind: "local",
+            skills: spec.skills.clone(),
+        },
+    }
+}
+
+#[derive(Deserialize)]
+pub struct ApplicationShellCall {
+    pub call_id: String,
+    pub action: ApplicationShellAction,
+}
+
+#[derive(Deserialize)]
+pub struct ApplicationShellAction {
+    pub commands: Vec<String>,
+    pub timeout_ms: Option<u64>,
+    pub max_output_length: Option<u64>,
+}
+
+impl ApplicationShellCall {
+    pub fn parse(arguments: &str) -> Result<Self, FunctionCallError> {
+        let call: Self = serde_json::from_str(arguments)
+            .map_err(|_| FunctionCallError::Fatal("invalid native shell call".into()))?;
+        if call.call_id.is_empty() {
+            return Err(FunctionCallError::Fatal(
+                "missing native shell call ID".into(),
+            ));
+        }
+        Ok(call)
+    }
+}
+
+#[derive(Deserialize)]
+pub struct ApplicationShellOutput {
+    output: Vec<ShellCommandOutput>,
+    max_output_length: Option<u64>,
+    #[serde(skip)]
+    succeeded: bool,
+}
+
+impl ApplicationShellOutput {
+    pub fn from_dynamic_response(
+        arguments: &str,
+        response: DynamicToolResponse,
+    ) -> Result<Self, FunctionCallError> {
+        if !response.success {
+            let message = response
+                .content_items
+                .into_iter()
+                .find_map(|item| match item {
+                    DynamicToolCallOutputContentItem::InputText { text } => Some(text),
+                    _ => None,
+                });
+            return Ok(Self::error(
+                arguments,
+                message.unwrap_or_else(|| "Native shell execution failed".into()),
+            ));
+        }
+        let [DynamicToolCallOutputContentItem::InputText { text }] =
+            response.content_items.as_slice()
+        else {
+            return Err(FunctionCallError::Fatal(
+                "invalid native shell output".into(),
+            ));
+        };
+        let mut result: Self = serde_json::from_str(text)
+            .map_err(|_| FunctionCallError::Fatal("invalid native shell output".into()))?;
+        result.succeeded = true;
+        result.apply_limit(
+            ApplicationShellCall::parse(arguments)?
+                .action
+                .max_output_length,
+        );
+        Ok(result)
+    }
+
+    pub fn error(arguments: &str, message: String) -> Self {
+        let mut result = Self {
+            output: vec![ShellCommandOutput {
+                stdout: String::new(),
+                stderr: message,
+                outcome: ShellCommandOutcome::Exit { exit_code: 1 },
+            }],
+            max_output_length: None,
+            succeeded: false,
+        };
+        let requested = ApplicationShellCall::parse(arguments)
+            .ok()
+            .and_then(|call| call.action.max_output_length);
+        result.apply_limit(requested);
+        result
+    }
+
+    fn apply_limit(&mut self, requested: Option<u64>) {
+        self.max_output_length = requested.into_iter().chain(self.max_output_length).min();
+        if let Some(limit) = self.max_output_length {
+            let mut remaining = usize::try_from(limit).unwrap_or(usize::MAX);
+            for part in &mut self.output {
+                truncate(&mut part.stdout, &mut remaining);
+                truncate(&mut part.stderr, &mut remaining);
+            }
+        }
+    }
+}
+
+fn truncate(text: &mut String, remaining: &mut usize) {
+    if let Some((offset, _)) = text.char_indices().nth(*remaining) {
+        text.truncate(offset);
+        *remaining = 0;
+    } else {
+        *remaining -= text.chars().count();
+    }
+}
+
+impl ToolOutput for ApplicationShellOutput {
+    fn log_output(&self) -> String {
+        format!("{} native shell command results", self.output.len())
+    }
+
+    fn success_for_logging(&self) -> bool {
+        self.succeeded
+    }
+
+    fn to_response_item(&self, call_id: &str, _payload: &ToolPayload) -> ResponseInputItem {
+        ResponseInputItem::ShellCallOutput {
+            call_id: call_id.to_string(),
+            output: self.output.clone(),
+            max_output_length: self.max_output_length,
+        }
+    }
+
+    fn code_mode_result(&self, _payload: &ToolPayload) -> Value {
+        serde_json::json!({
+            "output": self.output,
+            "max_output_length": self.max_output_length,
+        })
+    }
+}
