+                "max_output_length": 3,
+                "output": [
+                    {"stdout": "éλ", "stderr": "1", "outcome": {"type": "exit", "exit_code": 3_221_225_477_i64}},
+                    {"stdout": "", "stderr": "", "outcome": {"type": "timeout"}},
