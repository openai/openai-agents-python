+    #[test]
+    fn application_shell_keeps_the_provider_declaration_and_result_shape() {
+        let spec = DynamicShellToolSpec {
+            skills: vec![LocalShellSkill {
+                name: "build".into(),
+                description: "Build the project".into(),
+                path: "skills/build/SKILL.md".into(),
+            }],
+        };
+        assert_eq!(
+            serde_json::to_value(application_shell_spec(&spec)).unwrap(),
+            json!({
+                "type": "shell",
+                "environment": {
+                    "type": "local",
+                    "skills": [{"name": "build", "description": "Build the project", "path": "skills/build/SKILL.md"}],
+                },
+            }),
+        );
+
+        let arguments = json!({
+            "type": "shell_call", "call_id": "call-1",
+            "action": {"commands": ["first", "second"], "timeout_ms": 100, "max_output_length": 8},
+        })
+        .to_string();
+        let response = DynamicToolResponse {
+            content_items: vec![DynamicToolCallOutputContentItem::InputText {
+                text: json!({
+                    "output": [
+                        {"stdout": "éλ", "stderr": "1234", "outcome": {"type": "exit", "exit_code": 3_221_225_477_i64}},
+                        {"stdout": "partial", "stderr": "", "outcome": {"type": "timeout"}},
+                    ],
+                    "max_output_length": 3,
+                })
+                .to_string(),
+            }],
+            success: true,
+        };
+        let output = ApplicationShellOutput::from_dynamic_response(&arguments, response).unwrap();
