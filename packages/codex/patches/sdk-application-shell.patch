+#[derive(Default)]
+// A true entry owns one pending hosted receipt. Other entries reserve the ID
+// against ambiguous ownership or reuse after the receipt is consumed.
+struct HostedShellCalls(Mutex<HashMap<String, bool>>);
+
+fn observe_hosted_shell_pair(store: &ExtensionData, item: &ResponseItem, passive: bool) -> bool {
+    let (fields, is_call) = match item {
+        ResponseItem::ShellCall {
+            provider_fields, ..
+        } => (provider_fields, true),
+        ResponseItem::ShellCallOutput {
+            provider_fields, ..
+        } => (provider_fields, false),
+        _ => return false,
+    };
+    let Some(call_id) = fields
+        .get("call_id")
+        .and_then(serde_json::Value::as_str)
+        .filter(|call_id| !call_id.is_empty())
+    else {
+        return false;
+    };
+    if is_call {
+        let hosted = passive
+            && match fields.get("environment") {
+                Some(environment) => {
+                    match environment.get("type").and_then(serde_json::Value::as_str) {
+                        Some("container_auto") => true,
+                        Some("container_reference") => environment
+                            .get("container_id")
+                            .and_then(serde_json::Value::as_str)
+                            .is_some_and(|container_id| !container_id.trim().is_empty()),
+                        _ => false,
+                    }
+                }
+                None => fields
+                    .get("container_id")
+                    .and_then(serde_json::Value::as_str)
+                    .is_some_and(|container_id| !container_id.trim().is_empty()),
+            };
+        store
+            .get_or_init(HostedShellCalls::default)
+            .0
+            .lock()
+            .unwrap()
+            .entry(call_id.to_owned())
+            .and_modify(|pending| *pending = false)
+            .or_insert(hosted);
+        return false;
+    }
+    store.get::<HostedShellCalls>().is_some_and(|calls| {
+        calls
+            .0
+            .lock()
+            .unwrap()
+            .get_mut(call_id)
+            .is_some_and(std::mem::take)
+    })
+}
