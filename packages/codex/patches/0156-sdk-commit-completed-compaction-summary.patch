+// Model-backed automatic-compaction controls cover sampling separately. This task uses
+// the same registered owner and completed-output publication boundary without inference.
+struct CompactionCheckpointTask;
+
+impl SessionTask for CompactionCheckpointTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+
+    fn span_name(&self) -> &'static str {
+        "session_task.compaction_checkpoint_test"
+    }
+
+    async fn run(
+        self: Arc<Self>,
+        session: Arc<Session>,
+        turn: Arc<TurnContext>,
+        _input: Vec<TurnInput>,
+        cancel: CancellationToken,
+    ) -> crate::tasks::SessionTaskResult {
+        session.emit_turn_started(&turn).await;
+        commit_compaction_checkpoint(session, turn, cancel).await?;
+        Ok(None)
+    }
+}
