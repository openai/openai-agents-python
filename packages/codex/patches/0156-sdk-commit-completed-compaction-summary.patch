+async fn compaction_checkpoint_live_state(session: &Session) -> serde_json::Value {
+    let state = session.state.lock().await;
+    let ids = state.auto_compact_window_ids();
+    serde_json::json!({
+        "model_context": state.history.annotated_items(),
+        "catalog": state.sdk_originals.snapshot(None),
+        "window_number": state.auto_compact_window_number(),
+        "first_window_id": ids.first_window_id.to_string(),
+        "previous_window_id": ids.previous_window_id.map(|id| id.to_string()),
+        "window_id": ids.window_id.to_string(),
+        "prefill": state.auto_compact_window_snapshot().prefill_input_tokens,
+        "reference": state.reference_context_item(),
+        "world_state": state.history.world_state_checkpoint(),
+        "guardian": state.history.guardian_history_checkpoint(),
+        "retained": state.history.retained_context(),
+        "effort": state.reasoning_effort_pin.get("synthetic-model"),
+        "effort_compacted": matches!(state.reasoning_effort_pin, ReasoningEffortPin::Compacted),
+        "pending_hooks": state.pending_session_start_sources.len(),
+    })
+}
