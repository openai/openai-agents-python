+async fn hold_owned_compaction_flush(
+    session: &Arc<Session>,
+    turn: &Arc<TurnContext>,
+    fences: &mut mpsc::UnboundedReceiver<TerminalFlush>,
+) -> TerminalFlush {
+    session
+        .spawn_task(turn.clone(), Vec::new(), CompactionCheckpointTask)
+        .await;
+    let append = timeout(Duration::from_secs(2), fences.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    append.release.send(Ok(())).unwrap();
+    timeout(Duration::from_secs(2), fences.recv())
+        .await
+        .unwrap()
+        .unwrap()
+}
