+            (original_text.to_string(), original_order),
+            (steer_text.to_string(), original_order + 1),
+        ]
+    );
+    let live = session.sdk_history_snapshot(None).await.unwrap();
+    let original_at = live.2.iter().position(|row| row.contains(original_text));
+    let steer_at = live.2.iter().position(|row| row.contains(steer_text));
+    assert!(original_at.unwrap() < steer_at.unwrap());
+    let (mut restored, restored_turn, _events) = compaction_checkpoint_context().await;
+    Arc::get_mut(&mut restored).unwrap().services.live_thread = session.live_thread().cloned();
+    restored
+        .apply_rollout_reconstruction(&restored_turn, &stored)
+        .await;
+    assert_eq!(live, restored.sdk_history_snapshot(None).await.unwrap());
+}
