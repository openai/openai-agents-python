+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compaction_checkpoint_steer_flush_failure_preserves_published_error() {
+    let (session, turn, events, mut fences, store) = compaction_checkpoint_session().await;
+    let recording = turn
+        .extension_data
+        .get_or_init(crate::tasks::CompactionPromptRecording::default);
+    let held_prompt = recording.0.lock().await;
+    let checkpoint = hold_owned_compaction_flush(&session, &turn, &mut fences).await;
+    assert_eq!(
+        submit_steer_only(
+            &session,
+            vec![UserInput::Text {
+                text: "steer accepted before abort".into(),
+                text_elements: Vec::new(),
+            }],
+            &turn.sub_id,
+        )
+        .await,
+        TurnInputSubmission::Steered {
+            turn_id: turn.sub_id.clone(),
+        }
+    );
+    let primary = CodexErr::InvalidRequest("earlier reported error".into()).to_error_event(None);
+    session
+        .send_event(&turn, EventMsg::Error(primary.clone()))
+        .await;
+    let retired = retire_checkpoint_owner(&session, &turn).await;
+    checkpoint.release.send(Ok(())).unwrap();
+    timeout(Duration::from_secs(2), async {
+        while turn
+            .extension_data
+            .get::<crate::tasks::CommittedCompactionCheckpoint>()
+            .is_none()
+        {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    store
+        .terminal_seen
+        .store(true, std::sync::atomic::Ordering::SeqCst);
+    drop(held_prompt);
+    let steering_flush = timeout(Duration::from_secs(2), fences.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    steering_flush
+        .release
+        .send(Err("synthetic steering flush failure".into()))
+        .unwrap();
+    assert!(
+        timeout(Duration::from_secs(2), retired)
+            .await
+            .unwrap()
+            .unwrap()
+    );
+
+    let mut errors = Vec::new();
+    let mut terminal = None;
+    while let Ok(event) = events.try_recv() {
+        match event.msg {
+            EventMsg::Error(error) => errors.push(error),
+            EventMsg::TurnAborted(event) => assert!(terminal.replace(event).is_none()),
+            EventMsg::TurnComplete(_) => panic!("interrupted checkpoint reported success"),
+            _ => {}
+        }
+    }
+    assert_eq!(errors, vec![primary.clone()]);
+    assert_eq!(terminal.unwrap().error, Some(primary));
+}
