+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compaction_checkpoint_owned_retirement_preserves_accepted_steer_after_flush() {
+    let (session, turn, events, mut fences, store) = compaction_checkpoint_session().await;
+    let original_guardian = session
+        .clone_history()
+        .await
+        .guardian_history_checkpoint()
+        .unwrap();
+    assert_eq!(original_guardian.0.len(), 2);
+    let flush = hold_owned_compaction_flush(&session, &turn, &mut fences).await;
+    let expected_order = session
+        .clone_history()
+        .await
+        .retained_context()
+        .clone()
+        .reserve_order();
+    let steer_text = "steer accepted during checkpoint flush";
+    let steer = timeout(
+        Duration::from_secs(2),
+        submit_steer_only(
+            &session,
+            vec![UserInput::Text {
+                text: steer_text.into(),
+                text_elements: Vec::new(),
+            }],
+            &turn.sub_id,
+        ),
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        steer,
+        TurnInputSubmission::Steered {
+            turn_id: turn.sub_id.clone(),
+        }
+    );
+    let before = compaction_checkpoint_live_state(&session).await;
+    let retired = retire_checkpoint_owner(&session, &turn).await;
+    let early_drain = timeout(Duration::from_millis(100), async {
+        loop {
+            if compaction_checkpoint_live_state(&session).await != before {
+                break;
+            }
+            sleep(Duration::from_millis(1)).await;
+        }
+    })
+    .await;
+    flush.release.send(Ok(())).unwrap();
+    assert!(
+        timeout(Duration::from_secs(2), retired)
+            .await
+            .unwrap()
+            .unwrap()
+    );
+    assert!(
+        early_drain.is_err(),
+        "steer was recorded before publication"
+    );
+    let aborted = recv_terminal_event(&events, TerminalEventKind::TurnAborted).await;
+    assert!(matches!(aborted.msg, EventMsg::TurnAborted(event) if event.error.is_none()));
+
+    let stored = stored_compaction_checkpoints(&store, &session).await;
+    let (compacted_at, checkpoint) = stored
+        .iter()
+        .enumerate()
+        .find_map(|(index, item)| match item {
+            RolloutItem::Compacted(checkpoint) => Some((index, checkpoint)),
+            _ => None,
+        })
+        .unwrap();
+    assert_eq!(
+        checkpoint.guardian_history.as_ref().unwrap().0,
+        original_guardian.0,
+    );
+    let mut stored_steers = stored.iter().enumerate().filter_map(|(index, item)| {
+        let RolloutItem::ResponseItem(envelope) = item else {
+            return None;
+        };
+        matches!(
+            crate::parse_turn_item(&envelope.item),
+            Some(TurnItem::UserMessage(message)) if message.message() == steer_text
+        )
+        .then_some((index, envelope))
+    });
+    let (steer_at, stored_steer) = stored_steers.next().unwrap();
+    assert!(compacted_at < steer_at);
+    assert!(stored_steers.next().is_none());
+    let stored_metadata = stored_steer.metadata.as_ref().unwrap();
+    assert_eq!(stored_steer.item.turn_id(), Some(turn.sub_id.as_str()));
+    assert_eq!(stored_metadata.user_input_order, Some(expected_order));
+    let source = stored_metadata.retained_source.as_ref().unwrap();
+    assert_eq!(source.id.turn_id, turn.sub_id);
+    assert_eq!(
+        source.id.message_id,
+        stored_steer.item.id().unwrap().as_str()
+    );
+    assert_eq!(source.id.role, codex_history::RetainedSourceRole::User);
+    assert!(source.complete);
+
+    let (mut restored, restored_turn, _events) = compaction_checkpoint_context().await;
+    // Read the replayed catalog through the SDK snapshot's normal cold-store path.
+    Arc::get_mut(&mut restored).unwrap().services.live_thread = session.live_thread().cloned();
+    restored
+        .apply_rollout_reconstruction(&restored_turn, &stored)
+        .await;
+    let live = session.clone_history().await;
+    let replay = restored.clone_history().await;
+    assert_eq!(
+        live.raw_items().collect::<Vec<_>>(),
+        replay.raw_items().collect::<Vec<_>>()
+    );
+    let live_guardian = live.guardian_history_checkpoint().unwrap();
+    let replay_guardian = replay.guardian_history_checkpoint().unwrap();
+    let (live_steer, live_evidence) = live_guardian.0.split_last().unwrap();
+    let (replayed_steer, replayed_evidence) = replay_guardian.0.split_last().unwrap();
+    assert_eq!(live_evidence, original_guardian.0.as_slice());
+    assert_eq!(replayed_evidence, original_guardian.0.as_slice());
+    for history in [&live, &replay] {
+        let retained = history.retained_context();
+        let mut steers = retained.ordered_entries().filter(|(_, entry)| {
+            matches!(entry, codex_history::RetainedContextEntry::UserMessage(message)
+                if message.text == steer_text)
+        });
+        let (order, entry) = steers.next().unwrap();
+        assert_eq!(
+            order,
+            codex_history::RetainedContextOrder::Local(expected_order)
+        );
+        assert_eq!(retained.source(entry).as_ref(), Some(source));
+        assert!(steers.next().is_none());
+    }
+    assert_eq!(replayed_steer, stored_steer);
+    // Live Guardian capture precedes the retained-source stamp on the stored steer.
+    let mut replayed_without_source = replayed_steer.clone();
+    let metadata = replayed_without_source.metadata.as_mut().unwrap();
+    assert_eq!(metadata.retained_source.take().as_ref(), Some(source));
+    assert_eq!(live_steer, &replayed_without_source);
+    let live_originals = session.sdk_history_snapshot(None).await.unwrap();
+    let raw = live_originals
+        .2
+        .iter()
+        .position(|row| row.contains("raw summary output"))
+        .unwrap();
+    let steer = live_originals
+        .2
+        .iter()
