+async fn stored_compaction_checkpoints(
+    store: &TerminalStore,
+    session: &Session,
+) -> Vec<RolloutItem> {
+    store
+        .inner
+        .load_history(LoadThreadHistoryParams {
+            thread_id: session.thread_id,
+            include_archived: true,
+        })
+        .await
+        .unwrap()
+        .items
+}
+
+async fn retire_checkpoint_owner(
+    session: &Arc<Session>,
+    turn: &Arc<TurnContext>,
+) -> tokio::task::JoinHandle<bool> {
+    let retired = tokio::spawn({
+        let session = Arc::clone(session);
+        let turn_id = turn.sub_id.clone();
+        async move {
+            session
+                .abort_turn_if_active(&turn_id, TurnAbortReason::Interrupted, None)
+                .await
+        }
+    });
+    // The native abort has removed the captured owner but still waits on its checkpoint.
+    timeout(Duration::from_secs(2), async {
+        while session.active_turn.lock().await.is_some() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    retired
+}
