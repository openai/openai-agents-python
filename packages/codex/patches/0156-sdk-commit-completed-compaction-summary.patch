+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compaction_checkpoint_failed_flush_waits_for_original_prompt_before_retirement() {
+    let (session, turn, events, mut fences, store) = compaction_checkpoint_session().await;
+    let recording = turn
+        .extension_data
+        .get_or_init(crate::tasks::CompactionPromptRecording::default);
+    let held_prompt = recording.0.lock().await;
+    let before = compaction_checkpoint_live_state(&session).await;
+    let flush = hold_owned_compaction_flush(&session, &turn, &mut fences).await;
+    let mut retired = retire_checkpoint_owner(&session, &turn).await;
+    flush
+        .release
+        .send(Err("synthetic flush failure".into()))
+        .unwrap();
+    timeout(Duration::from_secs(2), async {
+        while turn
+            .extension_data
+            .get::<crate::tasks::PendingCompactionFatal>()
+            .is_none()
+        {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    assert!(
+        timeout(Duration::from_millis(150), &mut retired)
+            .await
+            .is_err()
+    );
+    while let Ok(event) = events.try_recv() {
+        assert!(!matches!(
+            event.msg,
+            EventMsg::Error(_) | EventMsg::TurnAborted(_)
+        ));
+    }
+    assert_eq!(compaction_checkpoint_live_state(&session).await, before);
+    let retained = stored_compaction_checkpoints(&store, &session).await;
+    assert_eq!(
+        retained
+            .iter()
+            .filter(|item| matches!(item, RolloutItem::Compacted(_)))
+            .count(),
+        1
+    );
+
+    let prompt = "original input awaiting recording after checkpoint failure";
+    crate::session::turn::run_hooks_and_record_inputs(
+        &session,
+        &turn,
+        &turn.capture_current_model_info(),
+        &[TurnInput::UserInput {
+            content: vec![UserInput::Text {
+                text: prompt.into(),
+                text_elements: Vec::new(),
+            }],
+            client_id: None,
+            metadata: Default::default(),
+        }],
+        PersistContext::Standard,
+    )
+    .await
+    .unwrap();
+    drop(held_prompt);
+    assert!(
+        timeout(Duration::from_secs(2), retired)
+            .await
+            .unwrap()
+            .unwrap()
+    );
+
+    let history = session.clone_history().await;
+    assert!(history.raw_items().any(|item| {
+        matches!(crate::parse_turn_item(item), Some(TurnItem::UserMessage(message))
+            if message.message() == prompt)
+    }));
+    let mut notice = None;
+    let mut terminal = None;
+    while let Ok(event) = events.try_recv() {
+        match event.msg {
+            EventMsg::Error(error) => assert!(notice.replace(error).is_none()),
+            EventMsg::TurnAborted(event) => assert!(terminal.replace(event).is_none()),
+            EventMsg::TurnComplete(_) => panic!("failed checkpoint reported success"),
+            _ => {}
+        }
+    }
+    let notice = notice.unwrap();
+    assert!(
+        notice
+            .message
+            .contains("Canonical thread persistence failed")
+    );
+    assert_eq!(terminal.unwrap().error, Some(notice));
+}
