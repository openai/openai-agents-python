+#[cfg(test)]
+mod sdk_extension_tests {
+    use super::ModelRequestControls;
+    use serde_json::json;
+
+    #[test]
+    fn extended_controls_preserve_omission_clears_and_values() {
+        let mut controls: ModelRequestControls = serde_json::from_value(json!({
+            "truncation": "auto", "include": ["message.output_text.logprobs"],
+            "context_management": [{"type": "compaction", "compact_threshold": 1024}],
+            "extra_body": {"provider_feature": {"mode": "captured"}}
+        }))
+        .unwrap();
+        controls.validate_shape().unwrap();
+        assert!(controls.has_wire_values());
+        let original = controls.clone();
+        controls.apply_patch(&ModelRequestControls::default());
+        assert_eq!(controls, original);
+        let clear: ModelRequestControls = serde_json::from_value(json!({
+            "truncation": null, "include": null, "context_management": null, "extra_body": null
+        }))
+        .unwrap();
+        controls.apply_patch(&clear);
+        assert!(!controls.has_wire_values());
+        assert!(!controls.is_empty());
+        assert_eq!(
+            serde_json::to_value(controls).unwrap(),
+            serde_json::to_value(clear).unwrap()
+        );
+    }
+
+    #[test]
+    fn body_extensions_cannot_replace_native_history_or_tools() {
+        for key in [
+            "type",
+            "generate",
+            "input",
+            "tools",
+            "instructions",
+            "model",
+            "stream",
+            "previous_response_id",
+            "include",
+        ] {
+            let controls: ModelRequestControls =
+                serde_json::from_value(json!({"extra_body": {key: "replacement"}})).unwrap();
+            assert!(controls.validate_shape().is_err(), "{key}");
+        }
+    }
