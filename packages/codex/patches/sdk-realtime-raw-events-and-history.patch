+                let record = state
+                    .received_audio
+                    .iter_mut()
+                    .find(|record| {
+                        record.item_id == item_id && record.content_index == content_index
+                    })
+                    .ok_or_else(|| {
+                        invalid("Playback item is unknown or outside the retained media window")
+                    })?;
+                let rate = record
+                    .configuration
+                    .output_format
+                    .ok_or_else(|| invalid("Playback format is unknown"))?
+                    .sample_rate();
+                if u128::from(audio_end_ms) * u128::from(rate) > u128::from(record.samples) * 1000 {
