+
+type Reply<T> = oneshot::Sender<CodexResult<T>>;
+
+#[derive(Deserialize)]
+#[serde(tag = "type", deny_unknown_fields)]
+enum ClientEvent {
+    #[serde(rename = "response.create")]
+    ResponseCreate { response: Option<Value> },
+    #[serde(rename = "response.cancel")]
+    ResponseCancel { response_id: Option<String> },
+    #[serde(rename = "conversation.item.create")]
+    ItemCreate {
+        item: Value,
+        previous_item_id: Option<String>,
+    },
+    #[serde(rename = "conversation.item.retrieve")]
+    ItemRetrieve { item_id: String },
+    #[serde(rename = "conversation.item.delete")]
+    ItemDelete { item_id: String },
+    #[serde(rename = "conversation.item.truncate")]
+    ItemTruncate {
+        item_id: String,
+        content_index: u32,
+        audio_end_ms: u32,
+    },
+    #[serde(rename = "input_audio_buffer.append")]
+    AudioAppend { audio: String },
+    #[serde(rename = "input_audio_buffer.clear")]
+    AudioClear {},
+    #[serde(rename = "input_audio_buffer.commit")]
+    AudioCommit {},
+    #[serde(rename = "output_audio_buffer.clear")]
+    OutputClear {},
+    #[serde(rename = "session.update")]
+    SessionUpdate { session: Value },
+}
+
+#[derive(Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Response {
+    instructions: Option<String>,
+    output_modalities: Option<[RealtimeOutputModality; 1]>,
+    max_output_tokens: Option<RealtimeMaxOutputTokens>,
+    metadata: Option<BTreeMap<String, String>>,
+    parallel_tool_calls: Option<bool>,
+    reasoning: Option<Reasoning>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Reasoning {
+    effort: Option<String>,
+}
+
+fn invalid(message: &str) -> CodexErr {
+    CodexErr::InvalidRequest(message.into())
+}
+
+fn response_options(
+    response: Option<Value>,
+    event_id: Option<String>,
+) -> CodexResult<RealtimeResponseOptions> {
+    let response: Response = match response {
+        Some(value @ Value::Object(_)) => serde_json::from_value(value)
+            .map_err(|_| invalid("Unsupported or invalid raw Realtime response options"))?,
+        Some(_) => return Err(invalid("Raw Realtime response options must be an object")),
+        None => Response::default(),
+    };
+    if response.metadata.as_ref().is_some_and(|metadata| {
+        metadata.len() > 16
+            || metadata
+                .iter()
+                .any(|(key, value)| key.chars().count() > 64 || value.chars().count() > 512)
+    }) {
+        return Err(invalid(
+            "Raw Realtime response metadata exceeds provider limits",
+        ));
+    }
+    Ok(RealtimeResponseOptions {
+        instructions: response.instructions,
+        output_modality: response.output_modalities.map(|[modality]| modality),
+        max_output_tokens: response.max_output_tokens,
+        metadata: response.metadata,
+        parallel_tool_calls: response.parallel_tool_calls,
+        reasoning: response
+            .reasoning
+            .map(|Reasoning { effort }| RealtimeReasoning { effort }),
+        event_id,
+    })
+}
+
+fn completion<T: Send + 'static>(
+    mut reply: Reply<Option<Value>>,
+    convert: fn(T) -> Option<Value>,
+) -> Reply<T> {
+    let (tx, rx) = oneshot::channel();
+    // The session dispatcher must remain free to process close while a
+    // generation-owned command waits for its provider receipt.
+    tokio::spawn(async move {
+        tokio::select! {
+            result = rx => {
+                let _ = reply.send(result.unwrap_or(Err(CodexErr::TurnAborted)).map(convert));
+            }
+            () = reply.closed() => {}
+        }
+    });
+    tx
+}
+
+async fn validate_connection(sess: &Arc<Session>, generation: &str) -> CodexResult<()> {
+    let state = sess.conversation.state.lock().await;
+    let conversation = state
+        .conversation
+        .as_ref()
+        .filter(|conversation| {
+            conversation.handoff.sdk.as_ref().is_some_and(|sdk| {
+                sdk.generation == generation && sdk.active.load(Ordering::Acquire)
+            })
+        })
+        .ok_or_else(|| invalid("SDK Realtime generation is stale"))?;
+    if conversation.handoff.event_parser != RealtimeEventParser::RealtimeV2 {
+        return Err(invalid("Raw client events require RealtimeV2"));
+    }
+    Ok(())
+}
+
+pub(crate) async fn handle_send_event_sdk(
+    sess: &Arc<Session>,
+    generation: String,
+    value: Value,
+    reply: Reply<Option<Value>>,
+) {
+    let (event, event_id) = match parse_event(value) {
+        Ok(event) => event,
+        Err(error) => {
+            let _ = reply.send(Err(error));
+            return;
+        }
+    };
+    if let Err(error) = validate_connection(sess, &generation).await {
+        let _ = reply.send(Err(error));
+        return;
+    }
+    match event {
+        ClientEvent::ResponseCreate { response } => {
+            let result = match response_options(response, event_id) {
+                Ok(options) => {
+                    sess.conversation
+                        .sdk_enqueue(&generation, SdkRealtimeCommand::RequestResponse(options))
+                        .await
+                }
+                Err(error) => Err(error),
+            };
+            let _ = reply.send(result.map(|()| None));
+        }
+        ClientEvent::ResponseCancel { response_id } => {
+            if response_id
+                .as_ref()
+                .is_some_and(|id| id.is_empty() || id.len() > 512)
+            {
+                let _ = reply.send(Err(invalid("Raw Realtime response ID is invalid")));
+                return;
+            }
+            dispatch_interrupt_sdk(
+                sess,
+                generation,
+                response_id,
+                event_id,
+                None,
+                None,
+                completion(reply, |receipt: RealtimeInterruptReceipt| {
+                    Some(serde_json::json!(receipt))
+                }),
+            )
+            .await;
+        }
+        ClientEvent::ItemCreate {
+            item,
+            previous_item_id,
+        } => {
+            let mut item = match item {
+                Value::Object(item)
+                    if item.get("type").and_then(Value::as_str) == Some("message") =>
+                {
+                    item
+                }
+                _ => {
+                    let _ = reply.send(Err(invalid(
+                        "Raw Realtime item creation requires a supported message",
+                    )));
+                    return;
+                }
+            };
+            item.entry("id").or_insert_with(|| {
+                Value::String(format!("item_{}", uuid::Uuid::new_v4().simple()))
+            });
+            handle_history_sdk(
+                sess,
+                generation,
+                Request::Create {
+                    item: Value::Object(item),
+                    previous: previous_item_id,
+                    event_id,
+                    reply: completion(reply, |_| None),
+                },
+            )
+            .await;
+        }
+        ClientEvent::ItemRetrieve { item_id } => {
+            handle_history_sdk(
+                sess,
+                generation,
+                Request::Item {
+                    id: item_id,
+                    event_id,
+                    reply: completion(reply, Some),
+                },
+            )
+            .await;
+        }
+        ClientEvent::ItemDelete { item_id } => {
+            handle_delete_item_sdk(
+                sess,
+                generation,
+                item_id,
+                event_id,
+                completion(reply, |_| None),
+            )
+            .await;
+        }
+        ClientEvent::AudioAppend { audio } => {
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::RawAudio {
+                    audio,
+                    event_id,
+                    reply,
+                }
+            })
+            .await;
+        }
+        ClientEvent::AudioClear {} | ClientEvent::AudioCommit {} => {
+            let control = if matches!(event, ClientEvent::AudioClear {}) {
+                AudioBufferControl::Clear
+            } else {
+                AudioBufferControl::Commit
+            };
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::AudioControl {
+                    control,
+                    event_id,
+                    reply,
+                }
+            })
+            .await;
+        }
+        ClientEvent::ItemTruncate {
+            item_id,
+            content_index,
+            audio_end_ms,
+        } => {
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::PlaybackControl {
+                    control: RealtimePlaybackControl::Truncate {
+                        item_id,
+                        content_index,
+                        audio_end_ms,
+                    },
+                    event_id,
+                    reply,
+                }
+            })
+            .await;
+        }
+        ClientEvent::OutputClear {} => {
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::PlaybackControl {
+                    control: RealtimePlaybackControl::Clear,
+                    event_id,
+                    reply,
+                }
+            })
+            .await;
+        }
+        ClientEvent::SessionUpdate { session } => match session_update(session) {
+            Ok(update) => {
+                dispatch_update_sdk(
+                    sess,
+                    generation,
+                    update,
+                    None,
+                    event_id,
+                    completion(reply, |_| None),
+                )
+                .await
+            }
+            Err(error) => {
+                let _ = reply.send(Err(error));
+            }
+        },
+    }
+}
+
+fn parse_event(mut value: Value) -> CodexResult<(ClientEvent, Option<String>)> {
+    let mut retained_bytes = 0;
+    codex_api::charge_realtime_json_storage(&value, &mut retained_bytes)
+        .map_err(|_| invalid("Raw Realtime event exceeds its 8 MiB estimated storage limit"))?;
+    let fields = value
+        .as_object_mut()
+        .ok_or_else(|| invalid("Raw Realtime event must be an object"))?;
+    let event_id = match fields.remove("event_id") {
+        Some(Value::String(id)) if !id.is_empty() && id.len() <= 512 => Some(id),
+        None | Some(Value::Null) => None,
+        Some(_) => return Err(invalid("Raw Realtime event ID is invalid")),
+    };
+    let event: ClientEvent = serde_json::from_value(value)
+        .map_err(|_| invalid("Unsupported or invalid raw Realtime client event"))?;
+    Ok((event, event_id))
+}
diff --git a/codex-rs/core/src/realtime_conversation/raw_settings.rs b/codex-rs/core/src/realtime_conversation/raw_settings.rs
new file mode 100644
index 0000000000000000000000000000000000000000..01a85ce0ff36fd8dd23672ed4e48cf67a2845172
--- /dev/null
+++ b/codex-rs/core/src/realtime_conversation/raw_settings.rs
@@ -0,0 +1,255 @@
+//! Translate provider session patches into the existing native settings path.
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::realtime_settings::RealtimeSessionUpdate;
+use serde_json::Map;
+use serde_json::Value;
+
+fn invalid() -> CodexErr {
+    CodexErr::InvalidRequest("Unsupported or invalid raw Realtime session settings".into())
+}
+
+fn object<'a>(value: &'a Value, keys: &[&str]) -> CodexResult<&'a Map<String, Value>> {
+    let fields = value.as_object().ok_or_else(invalid)?;
+    if fields.keys().any(|key| !keys.contains(&key.as_str())) {
+        return Err(invalid());
+    }
+    Ok(fields)
+}
+
+fn format(value: &Value) -> CodexResult<Value> {
+    let fields = object(value, &["type", "rate"])?;
+    let name = match fields.get("type").and_then(Value::as_str) {
+        Some("audio/pcm") if fields.get("rate").and_then(Value::as_u64) == Some(24000) => "pcm16",
+        Some("audio/pcmu") if !fields.contains_key("rate") => "g711_ulaw",
+        Some("audio/pcma") if !fields.contains_key("rate") => "g711_alaw",
+        _ => return Err(invalid()),
+    };
+    Ok(Value::String(name.into()))
+}
+
+// Protocol DTOs intentionally tolerate extra fields on several settings. Raw
+// provider input must name only supported leaves before those DTOs decode it.
+fn nested(name: &str, value: &Value) -> CodexResult<()> {
+    if value.is_null() {
+        return if matches!(
+            name,
+            "noise_reduction" | "transcription" | "turn_detection" | "prompt" | "tracing"
+        ) {
+            Ok(())
+        } else {
+            Err(invalid())
+        };
+    }
+    match name {
+        "noise_reduction" => {
+            object(value, &["type"])?;
+        }
+        "transcription" => {
+            object(
+                value,
+                &[
+                    "model",
+                    "language",
+                    "prompt",
+                    "keywords",
+                    "languages",
+                    "delay",
+                ],
+            )?;
+        }
+        "turn_detection" => {
+            let keys: &[&str] = match value.get("type").and_then(Value::as_str) {
+                Some("server_vad") => &[
+                    "type",
+                    "model_version",
+                    "create_response",
+                    "interrupt_response",
+                    "threshold",
+                    "prefix_padding_ms",
+                    "silence_duration_ms",
+                    "idle_timeout_ms",
+                ],
+                Some("semantic_vad") => &[
+                    "type",
+                    "model_version",
+                    "create_response",
+                    "interrupt_response",
+                    "eagerness",
+                ],
+                _ => return Err(invalid()),
+            };
+            object(value, keys)?;
+        }
+        "voice" if value.is_object() => {
+            object(value, &["id"])?;
+        }
+        "tool_choice" if value.is_object() => {
+            object(value, &["type", "name"])?;
+        }
+        "reasoning" => {
+            object(value, &["effort"])?;
+        }
+        "tracing" if value.is_object() => {
+            object(value, &["workflow_name", "group_id", "metadata"])?;
+        }
+        "prompt" => {
+            let fields = object(value, &["id", "version", "variables"])?;
+            if let Some(variables) = fields.get("variables").filter(|value| !value.is_null()) {
+                for value in variables.as_object().ok_or_else(invalid)?.values() {
+                    if value.is_string() {
+                        continue;
+                    }
+                    let keys: &[&str] = match value.get("type").and_then(Value::as_str) {
+                        Some("input_text") => &["type", "text"],
+                        Some("input_image") => &["type", "image_url", "file_id", "detail"],
+                        Some("input_file") => {
+                            &["type", "file_url", "file_id", "file_data", "filename"]
+                        }
+                        _ => return Err(invalid()),
+                    };
+                    object(value, keys)?;
+                }
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+/// Decode the `session` object, never an entire client event. Tool declarations
+/// cannot enter through this path; native typed update admission retains policy.
+pub(super) fn session_update(value: Value) -> CodexResult<RealtimeSessionUpdate> {
+    let fields = object(
+        &value,
+        &[
+            "type",
+            "model",
+            "instructions",
+            "output_modalities",
+            "audio",
+            "tool_choice",
+            "prompt",
+            "tracing",
+            "max_output_tokens",
+            "parallel_tool_calls",
+            "reasoning",
+        ],
+    )?;
+    if fields
+        .get("type")
+        .is_some_and(|value| value.as_str() != Some("realtime"))
+    {
+        return Err(invalid());
+    }
+    let mut update = Map::new();
+    for name in [
+        "model",
+        "instructions",
+        "tool_choice",
+        "prompt",
+        "tracing",
+        "max_output_tokens",
+        "parallel_tool_calls",
+        "reasoning",
+    ] {
+        if let Some(value) = fields.get(name) {
+            nested(name, value)?;
+            update.insert(name.into(), value.clone());
+        }
+    }
+    if let Some(value) = fields.get("output_modalities") {
+        let modalities = value
+            .as_array()
+            .filter(|values| values.len() == 1)
+            .ok_or_else(invalid)?;
+        if !matches!(modalities[0].as_str(), Some("text" | "audio")) {
+            return Err(invalid());
+        }
+        update.insert("output_modality".into(), modalities[0].clone());
+    }
+    if let Some(audio) = fields.get("audio") {
+        for (direction, section) in object(audio, &["input", "output"])? {
+            let names: &[&str] = if direction == "input" {
+                &[
+                    "format",
+                    "noise_reduction",
+                    "transcription",
+                    "turn_detection",
+                ]
+            } else {
+                &["format", "voice", "speed"]
+            };
+            for (name, value) in object(section, names)? {
+                let (key, translated) = if name == "format" {
+                    (
+                        if direction == "input" {
+                            "input_format"
+                        } else {
+                            "output_format"
+                        },
+                        format(value)?,
+                    )
+                } else {
+                    nested(name, value)?;
+                    (
+                        match name.as_str() {
+                            "voice" => "output_voice",
+                            "speed" => "output_speed",
+                            name => name,
+                        },
+                        value.clone(),
+                    )
+                };
+                update.insert(key.into(), translated);
+            }
+        }
+    }
+    serde_json::from_value(Value::Object(update)).map_err(|_| invalid())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn maps_wire_audio_and_preserves_sparse_nulls() {
+        let update = session_update(json!({"type":"realtime", "output_modalities":["text"],
+            "audio":{"input":{"format":{"type":"audio/pcm","rate":24000},
+                "noise_reduction":null,"transcription":null,"turn_detection":null},
+                "output":{"format":{"type":"audio/pcmu"},"voice":"marin","speed":1.2}},
+            "prompt":null,"tracing":null}))
+        .unwrap();
+        assert_eq!(
+            serde_json::to_value(update).unwrap(),
+            json!({"output_modality":"text",
+            "input_format":"pcm16","output_format":"g711_ulaw","output_voice":"marin",
+            "output_speed":1.2,"noise_reduction":null,"transcription":null,
+            "turn_detection":null,"prompt":null,"tracing":null})
+        );
+        assert_eq!(
+            session_update(json!({})).unwrap(),
+            RealtimeSessionUpdate::default()
+        );
+    }
+
+    #[test]
+    fn rejects_unknown_nested_fields_and_authority_changes() {
+        for value in [
+            json!([]),
+            json!({"tools":[]}),
+            json!({"function_tools":[]}),
+            json!({"hosted_mcp_tools":[]}),
+            json!({"type":"transcription"}),
+            json!({"output_modalities":["text","audio"]}),
+            json!({"model":null}),
+            json!({"audio":{"output":{"voice":{"id":"custom","extra":true}}}}),
+            json!({"audio":{"input":{"format":{"type":"audio/pcm","rate":16000}}}}),
+            json!({"audio":{"input":{"turn_detection":{"type":"semantic_vad","threshold":0.5}}}}),
+            json!({"reasoning":{"effort":"low","unknown":true}}),
+        ] {
+            assert!(session_update(value).is_err());
+        }
+    }
+}
