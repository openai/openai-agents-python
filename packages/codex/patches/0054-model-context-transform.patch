+/// A detached input projection for one model request, before transport retries.
+pub struct ModelContextInput<'a> {
+    pub thread_id: &'a str,
+    pub turn_id: &'a str,
+    pub model: &'a str,
+    pub compaction: bool,
+    pub items: &'a mut Vec<ResponseItem>,
+}
+
 /// Creates request-scoped interceptors without delaying inference.
 /// Return None for requests this host does not manage.
 pub trait ModelRequestContributor: Send + Sync + std::fmt::Debug {
     fn request(&self, input: ModelRequestInput<'_>) -> Option<Box<dyn ModelResponseInterceptor>>;
+
+    /// Whether this thread requires an awaited context policy before sending input.
+    fn transforms_context(&self, _thread_id: &str) -> bool {
+        false
+    }
+
+    /// Transform only the request's detached input, never canonical history.
+    fn transform_context<'a>(
+        &'a self,
+        _input: ModelContextInput<'a>,
+    ) -> ExtensionFuture<'a, Result<(), String>> {
+        Box::pin(async { Ok(()) })
+    }
 }
 
