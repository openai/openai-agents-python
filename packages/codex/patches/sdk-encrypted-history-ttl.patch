+    pub(crate) fn with_sdk_history_retention(
+        mut self,
+        policy: &crate::SdkHistoryRetention,
+        now: &serde_json::Number,
+    ) -> codex_protocol::error::Result<Self> {
+        if policy.ttl_seconds.is_none() {
+            return Ok(self);
+        }
+        // Select the existing provider-compaction suffix before expiry. Removing its
+        // boundary must never make the excluded audit prefix visible again.
+        let model_items = self.model_items();
+        let keep = model_items
+            .iter()
+            .map(|envelope| policy.retain(envelope, now))
+            .collect::<codex_protocol::error::Result<Vec<_>>>()?;
+        if model_items.len() != self.items.len() || keep.iter().any(|keep| !keep) {
+            self.items = Arc::new(
+                model_items
+                    .iter()
+                    .zip(keep)
+                    .filter_map(|(envelope, keep)| keep.then(|| envelope.clone()))
+                    .collect(),
+            );
+        }
+        Ok(self)
+    }
