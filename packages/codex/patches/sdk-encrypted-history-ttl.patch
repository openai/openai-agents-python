diff --git a/codex-rs/core/src/sdk_history_retention.rs b/codex-rs/core/src/sdk_history_retention.rs
new file mode 100644
index 00000000..f33cf41f
--- /dev/null
+++ b/codex-rs/core/src/sdk_history_retention.rs
@@ -0,0 +1,156 @@
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::error::{CodexErr, Result};
+use codex_protocol::models::ResponseItem;
+use serde_json::Number;
+
+/// Current SDK retention policy. This value is deliberately not serialized into history.
+#[derive(Clone, Debug)]
+pub struct SdkHistoryRetention {
+    pub ttl_seconds: Option<u64>,
+}
+
+impl SdkHistoryRetention {
+    pub fn new(ttl_seconds: Option<u64>) -> Self {
+        Self { ttl_seconds }
+    }
+
+    /// Stamps only newly accepted items. Restored or retained envelopes must not pass here.
+    pub fn stamp_new_items(&self, items: &mut [ResponseItemEnvelope]) {
+        let created_at = crate::session::session::Session::response_item_create_time();
+        for envelope in items {
+            if expires(&envelope.item) && envelope.item.create_time().is_none() {
+                envelope
+                    .metadata
+                    .get_or_insert_default()
+                    .sdk_created_at
+                    .get_or_insert_with(|| created_at.clone());
+            }
+        }
+    }
+
+    pub(crate) fn retain(&self, envelope: &ResponseItemEnvelope, now: &Number) -> Result<bool> {
+        let Some(ttl) = self.ttl_seconds else {
+            return Ok(true);
+        };
+        if !expires(&envelope.item) {
+            return Ok(true);
+        }
+        let created_at = envelope.item.create_time().or_else(|| {
+            envelope
+                .metadata
+                .as_ref()
+                .and_then(|metadata| metadata.sdk_created_at.as_ref())
+        });
+        let created_at = created_at.and_then(epoch_seconds).ok_or_else(|| {
+            CodexErr::InvalidRequest("Encrypted history TTL cannot prove this item's creation time. Open this older snapshot without TTL, or import history with authenticated item ages; reopening never renews an item's age.".to_owned())
+        })?;
+        let now = epoch_seconds(now).ok_or_else(|| {
+            CodexErr::Fatal("Native history retention clock is invalid".to_owned())
+        })?;
+        Ok(now <= created_at.saturating_add(ttl))
+    }
+}
+
+fn expires(item: &ResponseItem) -> bool {
+    match item {
+        ResponseItem::Message { role, .. } if matches!(role.as_str(), "system" | "developer") => {
+            false
+        }
+        ResponseItem::AdditionalTools { .. }
+        | ResponseItem::ConfigurationUpdate { .. }
+        | ResponseItem::CompactionTrigger { .. } => false,
+        _ => true,
+    }
+}
+
+fn epoch_seconds(number: &Number) -> Option<u64> {
+    number.as_u64().or_else(|| {
+        number
+            .as_f64()
+            .filter(|value| value.is_finite() && *value >= 0.0 && *value < u64::MAX as f64)
+            .map(|value| value.floor() as u64)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn message(role: &str, created_at: Option<u64>) -> ResponseItemEnvelope {
+        let mut value = json!({"type":"message", "role":role, "content":[{"type":"input_text", "text":"retained"}]});
+        if let Some(created_at) = created_at {
+            value["internal_chat_message_metadata_passthrough"] = json!({"create_time":created_at});
+        }
+        ResponseItemEnvelope::new(serde_json::from_value(value).unwrap())
+    }
+
+    #[test]
+    fn default_opens_older_items_without_an_age() {
+        assert!(
+            SdkHistoryRetention::new(None)
+                .retain(&message("assistant", None), &100.into())
+                .unwrap()
+        );
+    }
+
+    #[test]
+    fn explicit_ttl_rejects_missing_age_without_restamping() {
+        let envelope = message("assistant", None);
+        assert!(
+            SdkHistoryRetention::new(Some(10))
+                .retain(&envelope, &100.into())
+                .unwrap_err()
+                .to_string()
+                .contains("Open this older snapshot without TTL")
+        );
+        assert!(envelope.metadata.is_none());
+    }
+
+    #[test]
+    fn preserved_native_creation_time_controls_expiry() {
+        let envelope = message("user", Some(50));
+        let policy = SdkHistoryRetention::new(Some(10));
+        assert!(policy.retain(&envelope, &60.into()).unwrap());
+        assert!(!policy.retain(&envelope, &61.into()).unwrap());
+    }
+
+    #[test]
+    fn zero_ttl_preserves_only_the_creation_second() {
+        let envelope = message("user", Some(50));
+        let policy = SdkHistoryRetention::new(Some(0));
+        assert!(policy.retain(&envelope, &50.into()).unwrap());
+        assert!(!policy.retain(&envelope, &51.into()).unwrap());
+    }
+
+    #[test]
+    fn current_instructions_are_not_conversation_expiry() {
+        let policy = SdkHistoryRetention::new(Some(0));
+        for role in ["developer", "system"] {
+            assert!(policy.retain(&message(role, None), &100.into()).unwrap());
+        }
+    }
+
+    #[test]
+    fn fallback_survives_serialization_and_never_renews() {
+        let policy = SdkHistoryRetention::new(Some(10));
+        let mut envelope = message("assistant", None);
+        envelope.metadata.get_or_insert_default().sdk_created_at = Some(50.into());
+        let mut restored: ResponseItemEnvelope =
+            serde_json::from_value(serde_json::to_value(envelope).unwrap()).unwrap();
+        policy.stamp_new_items(std::slice::from_mut(&mut restored));
+        assert_eq!(
+            restored.metadata.as_ref().unwrap().sdk_created_at,
+            Some(50.into())
+        );
+        assert!(!policy.retain(&restored, &61.into()).unwrap());
+    }
+
+    #[test]
+    fn existing_native_clock_does_not_receive_another_clock() {
+        let policy = SdkHistoryRetention::new(None);
+        let mut envelope = message("user", Some(50));
+        policy.stamp_new_items(std::slice::from_mut(&mut envelope));
+        assert!(envelope.metadata.is_none());
+    }
+}
