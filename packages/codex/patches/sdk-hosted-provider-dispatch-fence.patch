+    #[test]
+    fn only_the_current_managed_transport_can_fence_replay() {
+        use ProviderRequestAccounting::{Create, Dispatch, Manage};
+
+        let ledger = Arc::new(AttemptLedger::default());
+        let parent = Arc::new(TurnSamplingStop::default());
+        let first = begin(&ledger, &parent);
+        first.account_provider_request(Manage).unwrap();
+        let lineage = first.account_provider_request(Create).unwrap().unwrap();
+        first
+            .account_provider_request(Dispatch {
+                lineage: lineage.clone(),
+            })
+            .unwrap();
+        assert!(first.provider_effects.load(Ordering::Acquire));
+        ledger.settle(&first).unwrap();
+
+        let second = begin(&ledger, &parent);
+        assert!(
+            second
+                .account_provider_request(Dispatch {
+                    lineage: lineage.clone()
+                })
+                .is_err()
+        );
+        second.account_provider_request(Manage).unwrap();
+        assert!(
+            second
+                .account_provider_request(Dispatch {
+                    lineage: "wrong owner".to_owned()
+                })
+                .is_err()
+        );
+        assert!(!second.provider_effects.load(Ordering::Acquire));
+        second
+            .account_provider_request(Dispatch { lineage })
+            .unwrap();
+        assert!(second.provider_effects.load(Ordering::Acquire));
+        assert_eq!(ledger.snapshot().usage.requests, 1);
+    }
