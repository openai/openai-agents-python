+// Provider actions have no local accepted-call deduplication owner. Unknown
+// output has lost its raw type, so its replay safety cannot be established.
+fn provider_event_may_have_effects(event: &ResponseEvent) -> bool {
+    match event {
+        ResponseEvent::OutputItemAdded(item) | ResponseEvent::OutputItemDone(item) => matches!(
+            item,
+            ResponseItem::CodeInterpreterCall { .. }
+                | ResponseItem::ImageGenerationCall { .. }
+                | ResponseItem::Other
+        ),
+        ResponseEvent::HostedToolCallProgress(progress) => progress
+            .event
+            .get("type")
+            .and_then(serde_json::Value::as_str)
+            .is_some_and(|kind| {
+                kind.starts_with("response.code_interpreter_call.")
+                    || kind.starts_with("response.code_interpreter_call_code.")
+                    || kind.starts_with("response.image_generation_call.")
+                    || kind.starts_with("response.mcp_call.")
+            }),
+        _ => false,
+    }
+}
