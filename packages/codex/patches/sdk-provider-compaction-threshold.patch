+const MAX_PROVIDER_COMPACTION_THRESHOLD: u64 = 9_007_199_254_740_991;
+
+/// SDK policy for the in-band Responses compaction threshold.
+#[derive(Debug, Clone, Copy, Deserialize, Serialize, PartialEq, JsonSchema, TS)]
+#[serde(tag = "type", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ProviderCompactionPolicy {
+    Static {
+        threshold: u64,
+    },
+    Dynamic {
+        threshold_ratio: f64,
+        fallback_threshold: u64,
+    },
+}
+
+impl ProviderCompactionPolicy {
+    fn threshold(self, context_window: Option<i64>) -> u64 {
+        match self {
+            Self::Static { threshold } => threshold,
+            Self::Dynamic {
+                threshold_ratio,
+                fallback_threshold,
+            } => context_window
+                .filter(|window| (1..=MAX_PROVIDER_COMPACTION_THRESHOLD as i64).contains(window))
+                .map_or(fallback_threshold, |window| {
+                    (window as f64 * threshold_ratio).floor() as u64
+                }),
+        }
+    }
+}
