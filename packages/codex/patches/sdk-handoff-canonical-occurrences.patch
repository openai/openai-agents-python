diff --git a/codex-rs/core/src/session/handoff_history.rs b/codex-rs/core/src/session/handoff_history.rs
new file mode 100644
index 00000000..e3cec362
--- /dev/null
+++ b/codex-rs/core/src/session/handoff_history.rs
@@ -0,0 +1,184 @@
+//! Canonical removal of current, occurrence-bound assistant text at an accepted transfer.
+use std::collections::HashSet;
+
+use codex_history::CompactedItem;
+use codex_history::ResponseItemEnvelope;
+use codex_history::sdk_originals::SdkOriginalHistory;
+use codex_protocol::agent_profile::AgentProfileHandoffPresentation;
+use codex_protocol::error::CodexErr;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+
+use super::Session;
+use super::TurnContext;
+
+pub(super) struct Replacement {
+    pub checkpoint: CompactedItem,
+    pub originals: SdkOriginalHistory,
+    pub envelopes: Vec<ResponseItemEnvelope>,
+}
+
+impl Session {
+    /// The caller retains the profile persistence/task gates through publication.
+    pub(super) async fn prepare_handoff_history_replacement(
+        &self,
+        context: &TurnContext,
+        selection: &codex_extension_api::HandoffGeneratedHistorySelection,
+    ) -> Result<Option<Replacement>, CodexErr> {
+        let invalid = |message: &str| CodexErr::InvalidRequest(message.into());
+        let source = context
+            .extension_data
+            .get::<AgentProfileHandoffPresentation>()
+            .ok_or_else(|| invalid("Canonical handoff history lacks its native source"))?;
+        if selection.handoff != source.handoff
+            || selection.keep.windows(2).any(|pair| pair[0] >= pair[1])
+            || selection
+                .keep
+                .iter()
+                .any(|index| *index >= source.generated.len())
+        {
+            return Err(invalid(
+                "Canonical handoff history has another source selection",
+            ));
+        }
+        if selection.keep.len() == source.generated.len() {
+            return Ok(None);
+        }
+        let current = self.sdk_load_original_history().await?;
+        if current.items.len() > 4096
+            || current
+                .items
+                .iter()
+                .map(|item| item.original.len())
+                .sum::<usize>()
+                > 8 * 1024 * 1024
+        {
+            return Err(invalid(
+                "Canonical handoff history exceeds 4096 records or 8 MiB",
+            ));
+        }
+        let state = self.state.lock().await;
+        if state.sdk_originals.revision() != Some(current.revision()) {
+            return Err(invalid(
+                "Canonical handoff history changed during source capture",
+            ));
+        }
+        let rows = state.history.annotated_items();
+        let approved = rows
+            .iter()
+            .filter_map(|row| match &row.item {
+                ResponseItem::McpApprovalResponse {
+                    approve: true,
+                    approval_request_id,
+                    ..
+                } => Some(approval_request_id.clone()),
+                _ => None,
+            })
+            .collect::<HashSet<_>>();
+        // The complete sampled suffix pins occurrences, including byte-equal IDs across steps.
+        let mut generated = Vec::new();
+        for (index, row) in rows.iter().enumerate().rev() {
+            let values = super::agent_profile::handoff_source_values(&approved, &[&row.item])?;
+            if let Some(value) = values.into_iter().next() {
+                generated.push((index, value));
+                if generated.len() == source.generated.len() {
+                    break;
+                }
+            }
+        }
+        generated.reverse();
+        if generated
+            .iter()
+            .map(|(_, value)| value)
+            .ne(source.generated.iter())
+        {
+            return Err(invalid("Canonical handoff generated occurrences changed"));
+        }
+        let keep = selection.keep.iter().copied().collect::<HashSet<_>>();
+        let mut drop_rows = HashSet::new();
+        let mut drop_originals = HashSet::new();
+        for (ordinal, (index, _)) in generated.iter().enumerate() {
+            if keep.contains(&ordinal) {
+                continue;
+            }
+            let row = &rows[*index];
+            if !matches!(&row.item, ResponseItem::Message { role, content, .. }
+                if role == "assistant" && content.iter().all(|item| matches!(item, ContentItem::OutputText { .. })))
+            {
+                return Err(invalid(
+                    "Canonical handoff history preserves tool, policy and non-text source rows",
+                ));
+            }
+            let origin = row
+                .metadata
+                .as_ref()
+                .and_then(|metadata| metadata.retained_source.as_ref())
+                .ok_or_else(|| {
+                    invalid("Canonical handoff message lacks native occurrence provenance")
+                })?;
+            let order = row.metadata.as_ref().and_then(|metadata| metadata.user_input_order)
+                .ok_or_else(|| invalid("Canonical handoff message lacks native occurrence order"))?;
+            let matches = current
+                .items
+                .iter()
+                .enumerate()
+                .filter_map(|(index, original)| {
+                    let projection = original.projection.as_ref()?;
+                    (projection.item == row.item
+                        && projection
+                            .metadata
+                            .as_ref()
+                            .and_then(|metadata| metadata.retained_source.as_ref())
+                            == Some(origin)
+                        && projection.metadata.as_ref().and_then(|metadata| metadata.user_input_order)
+                            == Some(order))
+                    .then_some(index)
+                })
+                .collect::<Vec<_>>();
+            if matches.len() != 1 || !drop_originals.insert(matches[0]) {
+                return Err(invalid(
+                    "Canonical handoff message has no unique original occurrence",
+                ));
+            }
+            drop_rows.insert(*index);
+        }
+        let envelopes = rows
+            .iter()
+            .enumerate()
+            .filter_map(|(index, row)| (!drop_rows.contains(&index)).then(|| row.clone()))
+            .collect::<Vec<_>>();
+        let mut originals = SdkOriginalHistory::default();
+        for (index, original) in current.items.into_iter().enumerate() {
+            if !drop_originals.contains(&index) {
+                originals.append(original);
+            }
+        }
+        let checkpoint = CompactedItem {
+            sdk_originals: Some(originals.clone().into()),
+            message: String::new(),
+            replacement_history: Some(envelopes.clone()),
+            guardian_history: None,
+            retained_context: Some(Default::default()),
+            mcp_resource_origins: self.services.mcp_runtime.resource_origin_checkpoint(),
+            window_number: Some(state.auto_compact_window_number()),
+            first_window_id: Some(state.auto_compact_window_ids().first_window_id.to_string()),
+            previous_window_id: state
+                .auto_compact_window_ids()
+                .previous_window_id
+                .map(|id| id.to_string()),
+            window_id: Some(state.auto_compact_window_ids().window_id.to_string()),
+            compaction_response_id: None,
+            latest_token_usage_record: state.latest_token_usage_record.clone(),
+            resume_metadata: Some(codex_history::CompactionResumeMetadata {
+                multi_agent_version: self.multi_agent_version(),
+                last_started_turn_id: state.last_started_turn_id.clone(),
+                previous_turn_settings: state.previous_turn_settings(),
+            }),
+        };
+        Ok(Some(Replacement {
+            checkpoint,
+            originals,
+            envelopes,
+        }))
+    }
+}
