+/// Build the provider's SIP accept session object with the native V2 settings mapping.
+pub fn sip_session_config_json(config: RealtimeSessionConfig) -> JsonResult<Value> {
+    if let Some(settings) = &config.v2 {
+        super::settings::validate_sip(settings)?;
+    }
+    let mut session = session_update_session_json(config)?;
+    session
+        .as_object_mut()
+        .expect("typed session object")
+        .remove("id");
+    if let Some(vad) = session
+        .pointer_mut("/audio/input/turn_detection")
+        .and_then(Value::as_object_mut)
+    {
+        vad.remove("threshold");
+        vad.remove("prefix_padding_ms");
+        vad.remove("silence_duration_ms");
+    }
+    Ok(session)
+}
