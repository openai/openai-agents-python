+/// A current snapshot only: no generation reservation, credentials, or voice transport.
+pub(crate) async fn handle_config_sdk(
+    sess: &Arc<Session>,
+    mut params: ConversationStartParams,
+    settings: Option<RealtimeV2SessionSettings>,
+    function_tools: Option<Vec<codex_protocol::realtime_settings::RealtimeFunctionTool>>,
+    expected_selection_id: Option<String>,
+) -> CodexResult<serde_json::Value> {
+    if params.version != Some(RealtimeWsVersion::V2) {
+        return Err(CodexErr::InvalidRequest(
+            "SIP configuration requires RealtimeV2".into(),
+        ));
+    }
+    let draft = tool_task::capture_realtime_source_draft(sess).await?;
+    draft
+        .validate_selection_identity(function_tools.as_deref(), expected_selection_id.as_deref())?;
+    if params.prompt.is_none() {
+        params.prompt = Some(draft.application_instructions());
+    }
+    let mut config = build_realtime_session_config_from_config(
+        sess,
+        &params,
+        RealtimeWsVersion::V2,
+        ConfiguredRealtimeVoice::Use,
+        Arc::clone(draft.inputs.config()),
+    )
+    .await?;
+    let source = tool_task::finish_realtime_native_source(sess, draft).await?;
+    config.v2 = settings;
+    config.function_tools =
+        tool_task::select_source_tools(&source, function_tools, expected_selection_id.as_deref())?;
+    codex_api::sip_session_config_json(config)
+        .map_err(|error| CodexErr::InvalidRequest(error.to_string()))
+}
+
+fn serialize_sdk_configuration(config: RealtimeSessionConfig) -> CodexResult<serde_json::Value> {
+    codex_api::session_update_session_json(config)
+        .map_err(|error| CodexErr::InvalidRequest(error.to_string()))
+}
