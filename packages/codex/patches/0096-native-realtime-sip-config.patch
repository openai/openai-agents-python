+#[tokio::test]
+async fn sdk_sip_config_uses_native_source_and_serializer_without_reserving_voice() {
+    let (session, _, _events, policy, http, _) = realtime_tool_fixture(false, false).await;
+    super::handle_close_sdk(&session, "tools-generation".into())
+        .await
+        .unwrap();
+    let mut params = prepared_voice_params();
+    params.prompt = Some(Some("Use this accepted application instruction".into()));
+    let settings = codex_api::RealtimeV2SessionSettings::default();
+    let actual = super::handle_config_sdk(
+        &session,
+        params.clone(),
+        Some(settings.clone()),
+        None,
+        None,
+    )
+    .await
+    .unwrap();
+    let draft = super::tool_task::capture_realtime_source_draft(&session)
+        .await
+        .unwrap();
+    let mut expected = super::build_realtime_session_config_from_config(
+        &session,
+        &params,
+        codex_config::config_toml::RealtimeWsVersion::V2,
+        super::ConfiguredRealtimeVoice::Use,
+        Arc::clone(draft.inputs.config()),
+    )
+    .await
+    .unwrap();
+    let source = super::tool_task::finish_realtime_native_source(&session, draft)
+        .await
+        .unwrap();
+    expected.v2 = Some(settings);
+    expected.function_tools = super::tool_task::select_source_tools(&source, None, None).unwrap();
+    assert_eq!(
+        actual,
+        codex_api::sip_session_config_json(expected).unwrap()
+    );
+    assert_eq!(
+        actual["instructions"],
+        "Use this accepted application instruction"
+    );
+    assert!(
+        actual["tools"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .any(|tool| tool["name"] == "approved_function")
+    );
+    assert_eq!(
+        policy.admissions.load(std::sync::atomic::Ordering::Acquire),
+        0
+    );
+    assert!(http.received_requests().await.unwrap().is_empty());
+    super::handle_prepare_sdk(
+        &session,
+        "after-sip-projection".into(),
+        prepared_voice_params(),
+        Some(Default::default()),
+        None,
+        None,
+        true,
+        None,
+    )
+    .await
+    .unwrap();
+    super::handle_close_sdk(&session, "after-sip-projection".into())
+        .await
+        .unwrap();
+}
