+/// SIP accepts fewer server VAD controls than a media WebSocket session.
+pub(super) fn validate_sip(settings: &RealtimeV2SessionSettings) -> serde_json::Result<()> {
+    validate(settings)?;
+    if let Some(Some(RealtimeTurnDetection::ServerVad {
+        threshold,
+        prefix_padding_ms,
+        silence_duration_ms,
+        ..
+    })) = &settings.turn_detection
+    {
+        if threshold.is_some() || prefix_padding_ms.is_some() || silence_duration_ms.is_some() {
+            return Err(serde::ser::Error::custom(
+                "SIP server VAD does not support threshold, prefix_padding_ms, or silence_duration_ms",
+            ));
+        }
+    }
+    Ok(())
+}
