+#[tokio::test]
+async fn reported_context_window_distinguishes_catalog_fallback_and_explicit_override() {
+    let mut known = model_info_from_slug("catalog-context-window");
+    known.context_window = None;
+    known.max_context_window = Some(400_000);
+    let manager = StaticModelsManager::new(
+        None,
+        ModelsResponse {
+            models: vec![known],
+        },
+    );
+    for (slug, override_window, expected_report, expected_operational) in [
+        ("catalog-context-window", None, Some(380_000), Some(400_000)),
+        ("unknown-context-window", None, None, Some(272_000)),
+        (
+            "unknown-context-window",
+            Some(160_000),
+            Some(152_000),
+            Some(160_000),
+        ),
+        (
+            "unknown-context-window",
+            Some(400_000),
+            Some(258_400),
+            Some(272_000),
+        ),
+    ] {
+        let overrides = ModelInfoOverrides {
+            context_window: override_window,
+            ..Default::default()
+        };
+        let mut selected = configured_settings();
+        selected.collaboration_mode.settings.model = slug.to_string();
+        let model = selected.resolve_model_info(&manager, &overrides).await;
+        let fallback = model.used_fallback_model_metadata;
+        let compact_limit = model.auto_compact_token_limit();
+        let settings =
+            ResolvedStepSettings::new(Arc::new(selected), Arc::new(model), false, override_window);
+        assert_eq!(settings.reported_context_window(), expected_report);
+        assert_eq!(
+            settings.model_info.resolved_context_window(),
+            expected_operational
+        );
+        assert_eq!(settings.model_info.used_fallback_model_metadata, fallback);
+        assert_eq!(
+            settings.model_info.auto_compact_token_limit(),
+            compact_limit
+        );
+        assert_eq!(fallback, slug == "unknown-context-window");
+
+        let next = settings
+            .apply_update(
+                &StepSettingsUpdate {
+                    model: Some("another-unknown-context-window".to_string()),
+                    ..Default::default()
+                },
+                &step_settings_constraints(&ConfigRequirements::default()),
+                &manager,
+                &overrides,
+                false,
+            )
+            .await
+            .unwrap();
+        assert_eq!(
+            next.reported_context_window(),
+            override_window.map(|window| window.min(272_000) * 95 / 100)
+        );
+        assert_eq!(settings.reported_context_window(), expected_report);
+    }
+}
+
+pub(crate) fn refresh_reported_context_window_for_test(
+    settings: &mut ResolvedStepSettings,
