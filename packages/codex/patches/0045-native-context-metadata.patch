+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::rollout::recorder::RolloutRecorder;
+    use crate::session::tests::attach_thread_persistence;
+    use crate::session::tests::make_session_and_context_with_auth_and_config_and_rx;
+    use codex_history::InitialHistory;
+    use codex_login::CodexAuth;
+
+    #[tokio::test]
+    async fn transcript_recording_start_reports_unknown_context_without_starting_a_ui_turn() {
+        let (mut session, _, rx) = make_session_and_context_with_auth_and_config_and_rx(
+            CodexAuth::from_api_key("Test API Key"),
+            Vec::new(),
+            |config| {
+                config.model = Some("unknown-transcript-context-test".to_string());
+            },
+        )
+        .await;
+        let path = attach_thread_persistence(Arc::get_mut(&mut session).unwrap()).await;
+        record(&session, "Terminal speech.".to_string())
+            .await
+            .unwrap();
+        assert!(session.active_turn.lock().await.is_none());
+        while let Ok(event) = rx.try_recv() {
+            assert!(!matches!(event.msg, EventMsg::TurnStarted(_)));
+        }
+        let InitialHistory::Resumed(history) =
+            RolloutRecorder::get_rollout_history(&path).await.unwrap()
+        else {
+            panic!("recorded history");
+        };
+        let starts = history
+            .history
+            .iter()
+            .filter_map(|item| match item {
+                RolloutItem::EventMsg(EventMsg::TurnStarted(start)) => Some(start),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(starts.len(), 1);
+        assert_eq!(starts[0].model_context_window, None);
+    }
+}
diff --git a/codex-rs/core/src/session/context_metadata_tests.rs b/codex-rs/core/src/session/context_metadata_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e48bdb5e4622c05435a3a59683e476a58bef9b7f
--- /dev/null
+++ b/codex-rs/core/src/session/context_metadata_tests.rs
@@ -0,0 +1,238 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn unknown_context_metadata_replaces_prior_usage_without_changing_limits() {
+    let (session, turn, rx) = make_session_and_context_with_auth_and_config_and_rx(
+        CodexAuth::from_api_key("Test API Key"),
+        Vec::new(),
+        |config| {
+            config.model = Some("unknown-context-metadata-test".to_string());
+        },
+    )
+    .await;
+    let step = StepContext::for_test(Arc::clone(&turn));
+    assert!(step.settings.model_info.used_fallback_model_metadata);
+    assert_eq!(turn.model_context_window(), Some(258_400));
+    assert_eq!(
+        step.settings.model_info.auto_compact_token_limit(),
+        Some(244_800)
+    );
+    session.emit_turn_started(&turn).await;
+    let EventMsg::TurnStarted(start) = rx.recv().await.unwrap().msg else {
+        panic!("turn start");
+    };
+    assert_eq!(start.model_context_window, None);
+
+    // No usage must remain absent, even when this model has an operational limit.
+    session
+        .record_token_usage_info(&turn, &step.settings, None)
+        .await
+        .unwrap();
+    assert_eq!(session.token_usage_info().await, None);
+    session
+        .state
+        .lock()
+        .await
+        .set_token_info(Some(TokenUsageInfo {
+            total_token_usage: TokenUsage {
+                total_tokens: 10,
+                ..Default::default()
+            },
+            last_token_usage: TokenUsage::default(),
+            model_context_window: Some(258_400),
+        }));
+    let sample = TokenUsage {
+        input_tokens: 7,
+        total_tokens: 7,
+        ..Default::default()
+    };
+    session
+        .record_token_usage_info(&turn, &step.settings, Some(&sample))
+        .await
+        .unwrap();
+    let info = session.token_usage_info().await.unwrap();
+    assert_eq!(info.model_context_window, None);
+    assert_eq!(info.total_token_usage.total_tokens, 17);
+    assert_eq!(info.last_token_usage, sample);
+
+    // Synthetic accounting still fills the operational window, then reports unknown.
+    session.set_total_tokens_full(&turn, &step.settings).await;
+    let info = session.token_usage_info().await.unwrap();
+    assert_eq!(info.total_token_usage.total_tokens, 258_400);
+    assert_eq!(info.model_context_window, None);
+    session.recompute_token_usage(&step).await;
+    assert_eq!(
+        session
+            .token_usage_info()
+            .await
+            .unwrap()
+            .model_context_window,
+        None
+    );
+}
+
+#[tokio::test]
+async fn context_metadata_uses_the_response_snapshot_and_replaces_null_in_both_directions() {
+    let (session, turn) = make_session_and_context().await;
+    let original = Arc::clone(&turn.initial_settings);
+    let mut unknown = original.selected().clone();
+    unknown.collaboration_mode.settings.model = "unknown-context-metadata-test".to_string();
+    let model = unknown
+        .resolve_model_info(
+            session.services.models_manager.as_ref(),
+            &Default::default(),
+        )
+        .await;
+    let unknown = Arc::new(ResolvedStepSettings::new(
+        Arc::new(unknown),
+        Arc::new(model),
+        false,
+        None,
+    ));
+    turn.next_step_settings.store(Arc::clone(&unknown));
+    let sample = TokenUsage {
+        total_tokens: 3,
+        ..Default::default()
+    };
+    // The old response completes after the new selection has been installed.
+    for settings in [&unknown, &original, &unknown] {
+        session
+            .record_token_usage_info(&turn, settings, Some(&sample))
+            .await
+            .unwrap();
+        assert_eq!(
+            session
+                .token_usage_info()
+                .await
+                .unwrap()
+                .model_context_window,
+            settings.reported_context_window()
+        );
+    }
+    assert_eq!(
+        session
+            .token_usage_info()
+            .await
+            .unwrap()
+            .total_token_usage
+            .total_tokens,
+        9
+    );
+    // A serializer-only event must not reinterpret the stored null through the old turn.
+    session.send_token_count_event(&turn).await;
+    assert_eq!(
+        session
+            .token_usage_info()
+            .await
+            .unwrap()
+            .model_context_window,
+        None
+    );
+}
+
+#[tokio::test]
+async fn context_metadata_round_trips_null_and_historical_numbers_through_resume_and_fork() {
+    for window in [None, Some(258_400)] {
+        let expected = TokenUsageInfo {
+            total_token_usage: TokenUsage {
+                total_tokens: 123,
+                ..Default::default()
+            },
+            last_token_usage: TokenUsage {
+                total_tokens: 7,
+                ..Default::default()
+            },
+            model_context_window: window,
+        };
+        let items = vec![RolloutItem::EventMsg(EventMsg::TokenCount(
+            TokenCountEvent {
+                info: Some(expected.clone()),
+                rate_limits: None,
+                api_rate_limits: None,
+            },
+        ))];
+        let items: Vec<RolloutItem> =
+            serde_json::from_value(serde_json::to_value(items).unwrap()).unwrap();
+        for fork in [false, true] {
+            let (session, _) = make_session_and_context().await;
+            let history = if fork {
+                InitialHistory::Forked(items.clone())
+            } else {
+                InitialHistory::Resumed(ResumedHistory {
+                    history_revision: None,
+                    conversation_id: session.thread_id,
+                    history: Arc::new(items.clone()),
+                    rollout_path: None,
+                })
+            };
+            session.record_initial_history(history).await;
+            assert_eq!(session.token_usage_info().await, Some(expected.clone()));
+        }
+    }
+}
+
+#[tokio::test]
+async fn idle_model_update_keeps_historical_usage_until_the_next_response() {
+    let (session, _) = make_session_and_context().await;
+    let historical = TokenUsageInfo {
+        total_token_usage: TokenUsage {
+            total_tokens: 42,
+            ..Default::default()
+        },
+        last_token_usage: TokenUsage::default(),
+        model_context_window: Some(258_400),
+    };
+    session
+        .state
+        .lock()
+        .await
+        .set_token_info(Some(historical.clone()));
+    session
+        .update_settings(SessionSettingsUpdate {
+            step_settings: StepSettingsUpdate {
+                model: Some("unknown-idle-context-test".to_string()),
+                ..Default::default()
+            },
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    let next_turn = session.new_default_turn().await;
+    assert_eq!(next_turn.reported_model_context_window(), None);
+    assert_eq!(session.token_usage_info().await, Some(historical));
+    session
+        .record_token_usage_info(
+            &next_turn,
+            &next_turn.initial_settings,
+            Some(&TokenUsage {
+                total_tokens: 5,
+                ..Default::default()
+            }),
+        )
+        .await
+        .unwrap();
+    let info = session.token_usage_info().await.unwrap();
+    assert_eq!(info.model_context_window, None);
+    assert_eq!(info.total_token_usage.total_tokens, 47);
+}
+
+#[tokio::test]
+async fn synthetic_overflow_fills_the_window_of_the_captured_sampling_model() {
+    let (session, turn) = make_session_and_context().await;
+    let mut replacement = turn.initial_settings.selected().clone();
+    replacement.collaboration_mode.settings.model = "gpt-daybreak-red-latest".to_string();
+    let model = replacement
+        .resolve_model_info(
+            session.services.models_manager.as_ref(),
+            &Default::default(),
+        )
+        .await;
+    let settings = ResolvedStepSettings::new(Arc::new(replacement), Arc::new(model), false, None);
+    let limit = settings.model_info.usable_context_window().unwrap();
+    assert_ne!(turn.model_context_window(), Some(limit));
+    session.set_total_tokens_full(&turn, &settings).await;
+    let usage = session.token_usage_info().await.unwrap();
+    assert_eq!(usage.model_context_window, Some(limit));
+    assert_eq!(usage.total_token_usage.total_tokens, limit);
+}
