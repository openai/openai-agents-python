+#[test]
+fn bundled_sdk_reasoning_defaults_use_medium() {
+    use codex_protocol::openai_models::ReasoningEffort;
+
+    // Sol model references checked on 2026-11-04:
+    // https://developers.openai.com/api/docs/models/gpt-6.1-sol
+    // https://developers.openai.com/api/docs/models/gpt-5.6-sol
+    let response = crate::bundled_models_response().expect("bundled models should parse");
+    for slug in ["gpt-6-astra", "gpt-6.1-sol", "gpt-5.6-sol"] {
+        let model = response
+            .models
+            .iter()
+            .find(|model| model.slug == slug)
+            .expect("supported SDK model should have bundled metadata");
+        assert_eq!(model.default_reasoning_level, Some(ReasoningEffort::Medium));
+    }
+}
