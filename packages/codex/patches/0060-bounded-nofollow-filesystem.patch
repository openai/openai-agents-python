+#[tokio::test]
+async fn per_call_cap_rejects_files_and_bounds_growth() -> anyhow::Result<()> {
+    use std::io::Write;
+    use std::sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    };
+    let temp = TempDir::new()?;
+    let path = temp.path().canonicalize()?.join("growing");
+    std::fs::write(&path, vec![b'x'; 4096])?;
+    let stop = Arc::new(AtomicBool::new(false));
+    let worker_stop = stop.clone();
+    let worker_path = path.clone();
+    let worker = std::thread::spawn(move || {
+        let mut file = std::fs::OpenOptions::new()
+            .append(true)
+            .open(worker_path)
+            .unwrap();
+        while !worker_stop.load(Ordering::Acquire) {
+            file.write_all(&[b'x'; 4096]).unwrap();
+            std::thread::yield_now();
+        }
+    });
+    for _ in 0..50 {
+        let result = LOCAL_FS
+            .read_file(
+                &PathUri::from_host_native_path(&path)?,
+                ReadFileOptions {
+                    follow_symlinks: false,
+                    max_bytes: Some(8192),
+                },
+                None,
+            )
+            .await;
+        match result {
+            Ok(bytes) => assert!(bytes.len() <= 8192),
+            Err(error) => assert_eq!(error.kind(), std::io::ErrorKind::InvalidInput),
+        }
+    }
+    stop.store(true, Ordering::Release);
+    worker.join().unwrap();
+    Ok(())
+}
