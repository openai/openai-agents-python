+
+// Query the no-reparse directory handle itself; never reopen its path for enumeration.
+pub(super) fn read_directory_bounded(
+    path: &Path,
+    limit: usize,
+    cancelled: &tokio_util::sync::CancellationToken,
+) -> io::Result<Vec<io::Result<String>>> {
+    #[link(name = "ntdll")]
+    unsafe extern "system" {
+        fn NtQueryDirectoryFile(
+            handle: HANDLE,
+            event: HANDLE,
+            apc: *const c_void,
+            context: *const c_void,
+            status: *mut IO_STATUS_BLOCK,
+            buffer: *mut c_void,
+            length: u32,
+            class: u32,
+            single: u8,
+            name: *const UNICODE_STRING,
+            restart: u8,
+        ) -> NTSTATUS;
+    }
+    let handle = open_handle(path, FILE_GENERIC_READ, FILE_OPEN, FILE_DIRECTORY_FILE)?;
+    let mut names = Vec::new();
+    // FILE_DIRECTORY_INFORMATION: filename byte length at offset 60, UTF-16 at 64.
+    let mut buffer = vec![0u64; 8192];
+    while names.len() < limit {
+        if cancelled.is_cancelled() {
+            return Err(io::Error::new(io::ErrorKind::Interrupted, "walk cancelled"));
+        }
+        let mut status = IO_STATUS_BLOCK {
+            Anonymous: IO_STATUS_BLOCK_0 { Status: 0 },
+            Information: 0,
+        };
+        let result = unsafe {
+            NtQueryDirectoryFile(
+                handle.as_raw_handle(),
+                ptr::null_mut(),
+                ptr::null(),
+                ptr::null(),
+                &mut status,
+                buffer.as_mut_ptr().cast(),
+                (buffer.len() * 8) as u32,
+                1,
+                1,
+                ptr::null(),
+                0,
+            )
+        };
+        if result == 0x80000006_u32 as i32 {
+            break;
+        } // STATUS_NO_MORE_FILES
+        if result < 0 {
+            names.push(Err(io::Error::from_raw_os_error(
+                unsafe { RtlNtStatusToDosError(result) } as i32,
+            )));
+            break;
+        }
+        let bytes =
+            unsafe { std::slice::from_raw_parts(buffer.as_ptr().cast::<u8>(), buffer.len() * 8) };
+        let length = u32::from_ne_bytes(bytes[60..64].try_into().unwrap()) as usize;
+        if length % 2 != 0 || length + 64 > status.Information || length + 64 > bytes.len() {
+            names.push(Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "invalid directory entry",
+            )));
+            break;
+        }
+        let units: Vec<u16> = bytes[64..64 + length]
+            .chunks_exact(2)
+            .map(|v| u16::from_ne_bytes([v[0], v[1]]))
+            .collect();
+        let name = String::from_utf16(&units)
+            .map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "invalid filename"));
+        if matches!(name.as_deref(), Ok("." | "..")) {
+            continue;
+        }
+        names.push(name);
+    }
+    Ok(names)
+}
