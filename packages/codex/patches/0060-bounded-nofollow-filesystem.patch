+    fn sync_walk_no_follow(
+        root: &PathUri,
+        options: WalkOptions,
+        cancelled: &CancellationToken,
+    ) -> io::Result<WalkOutcome> {
+        let native = root.to_abs_path()?;
+        if !no_follow::walk_metadata_sync(native.as_path())?.is_directory {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "walk root is not a directory",
+            ));
+        }
+        let mut outcome = WalkOutcome::default();
+        let mut queue = VecDeque::from([(root.clone(), 0usize)]);
+        let mut directories = 1usize;
+        let mut examined = 0usize;
+        let mut response_bytes = 0usize;
+        while let Some((directory, depth)) = queue.pop_front() {
+            check_walk_cancelled(cancelled)?;
+            let native = directory.to_abs_path()?;
+            let remaining = options.max_entries - examined;
+            let names =
+                match no_follow::read_directory_bounded(native.as_path(), remaining + 1, cancelled)
+                {
+                    Ok(names) => names,
+                    Err(error) => {
+                        check_walk_cancelled(cancelled)?;
+                        if !push_walk_error(
+                            &mut outcome,
+                            &mut response_bytes,
+                            directory,
+                            error.to_string(),
+                        ) {
+                            break;
+                        }
+                        continue;
+                    }
+                };
+            if names.len() > remaining {
+                outcome.truncated = true;
+            }
+            for name in names.into_iter().take(remaining) {
+                check_walk_cancelled(cancelled)?;
+                examined += 1;
+                let name = match name {
+                    Ok(name) => name,
+                    Err(error) => {
+                        if !push_walk_error(
+                            &mut outcome,
+                            &mut response_bytes,
+                            directory.clone(),
+                            error.to_string(),
+                        ) {
+                            return Ok(outcome);
+                        }
+                        continue;
+                    }
+                };
+                let path = directory.join(&name).map_err(io::Error::other)?;
+                let native = path.to_abs_path()?;
+                let metadata = match no_follow::walk_metadata_sync(native.as_path()) {
+                    Ok(metadata) => metadata,
+                    Err(error) => {
+                        if !push_walk_error(
+                            &mut outcome,
+                            &mut response_bytes,
+                            path,
+                            error.to_string(),
+                        ) {
+                            return Ok(outcome);
+                        }
+                        continue;
+                    }
+                };
+                let kind = if metadata.is_directory {
+                    WalkEntryKind::Directory
+                } else if metadata.is_file {
+                    WalkEntryKind::File
+                } else {
+                    continue;
+                };
+                if !reserve_walk_response_bytes(
+                    &mut outcome,
+                    &mut response_bytes,
+                    path.to_string().len(),
+                ) {
+                    return Ok(outcome);
+                }
+                outcome.entries.push(WalkEntry {
+                    path: path.clone(),
+                    kind,
+                });
+                if kind == WalkEntryKind::Directory {
+                    if options.prune_hidden_directories && name.starts_with('.') {
+                        continue;
+                    }
+                    if depth >= options.max_depth || directories >= options.max_directories {
+                        outcome.truncated = true;
+                    } else {
+                        directories += 1;
+                        queue.push_back((path, depth + 1));
+                    }
+                }
+            }
+            if examined == options.max_entries {
+                if !queue.is_empty() {
+                    outcome.truncated = true;
+                }
+                break;
+            }
+        }
+        Ok(outcome)
+    }
