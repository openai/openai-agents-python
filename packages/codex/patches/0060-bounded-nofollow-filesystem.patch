+        let temp = tempfile::tempdir()?;
+        let base = temp.path().canonicalize()?;
+        std::fs::write(base.join("good.txt"), "needle")?;
+        std::fs::write(base.join(invalid_filename(0)), "unrepresentable")?;
+        std::fs::create_dir(base.join("nested"))?;
+        std::fs::write(base.join("nested/match.txt"), "needle")?;
+        let root = PathUri::from_host_native_path(&base)?;
+        let result = DirectFileSystem::sync_walk(&root, options(), &CancellationToken::new())?;
+        assert_eq!(result.entries.len(), 3);
+        for name in ["good.txt", "nested", "nested/match.txt"] {
+            let expected = root.join(name).unwrap();
+            assert!(result.entries.iter().any(|entry| entry.path == expected));
+        }
+        assert_eq!(result.errors.len(), 1);
+        assert_eq!(result.errors[0].path, root);
+        assert!(
+            !result.truncated,
+            "the error is not an entry-limit truncation"
+        );
+        Ok(())
+    }
