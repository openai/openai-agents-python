+#[cfg(test)]
+mod websocket_option_config_tests {
+    use super::WebsocketOptions;
+    #[test]
+    fn omission_inherits_but_null_and_config_disabled_clear_phase_limits() {
+        let omitted: WebsocketOptions = serde_json::from_str("{}").unwrap();
+        assert_eq!(omitted.connect_timeout_ms, None);
+        assert_eq!(omitted.max_message_bytes, None);
+        let null: WebsocketOptions =
+            serde_json::from_str(r#"{"connect_timeout_ms":null,"max_message_bytes":null}"#)
+                .unwrap();
+        let disabled: WebsocketOptions = serde_json::from_str(
+            r#"{"connect_timeout_ms":"disabled","max_message_bytes":"disabled"}"#,
+        )
+        .unwrap();
+        assert_eq!(null, disabled);
+        assert_eq!(null.connect_timeout_ms, Some(None));
+        assert_eq!(null.max_message_bytes, Some(None));
+        let configured: WebsocketOptions =
+            serde_json::from_str(r#"{"connect_timeout_ms":7,"max_message_bytes":256}"#).unwrap();
+        assert_eq!(configured.connect_timeout_ms, Some(Some(7)));
+        assert_eq!(configured.max_message_bytes, Some(Some(256)));
+        assert!(
+            serde_json::from_str::<WebsocketOptions>(r#"{"connect_timeout_ms":"inherit"}"#)
+                .is_err()
+        );
+        assert_eq!(
+            serde_json::to_value(null).unwrap()["connect_timeout_ms"],
+            serde_json::Value::Null
+        );
+    }
