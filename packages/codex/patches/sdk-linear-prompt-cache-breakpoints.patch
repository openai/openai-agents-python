+    #[test]
+    fn large_annotated_part_fixture_stays_within_native_frame_budget() {
+        const PARTS: usize = 32_768;
+        let content = (0..PARTS)
+            .map(|index| ContentItem::InputText {
+                text: format!("part-{index}"),
+            })
+            .collect::<Vec<_>>();
+        let breakpoints = (0..PARTS)
+            .map(|index| (index, marker()))
+            .collect::<Vec<_>>();
+        let binding = PromptCacheAnnotation::bind("msg_many_parts".into(), &content, &breakpoints)
+            .unwrap()
+            .unwrap();
+        assert!(serde_json::to_vec(&(&content, &binding)).unwrap().len() < 8 * 1024 * 1024);
+        let original = item(serde_json::to_value(&content).unwrap());
+        let destinations = (0..PARTS).map(|index| (index, index)).collect::<Vec<_>>();
+        let prepared = binding
+            .after_preparation("msg_many_parts", &content, &content, &destinations)
+            .unwrap()
+            .unwrap();
+        let PromptCacheProjection::Annotated(projected) =
+            prepared.project("msg_many_parts", &original).unwrap()
+        else {
+            panic!()
+        };
+        assert_eq!(prepared.parts.len(), PARTS);
+        for index in [0, PARTS - 1] {
+            assert_eq!(
+                projected["content"][index]["prompt_cache_breakpoint"],
+                json!({"mode":"explicit"})
+            );
+            assert_eq!(projected["content"][index]["text"], format!("part-{index}"));
+        }
+    }
