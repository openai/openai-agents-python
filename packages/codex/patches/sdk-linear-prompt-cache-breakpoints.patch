+    #[test]
+    fn duplicate_part_bindings_refuse_only_the_annotation() {
+        let original = item(json!([{"type":"input_text","text":"unchanged"}]));
+        let before = serde_json::to_value(&original).unwrap();
+        let mut binding = bind("msg_duplicate_parts", &original, 0);
+        binding.parts.push(binding.parts[0].clone());
+        assert_eq!(
+            binding.project("msg_duplicate_parts", &original).unwrap(),
+            PromptCacheProjection::Refused
+        );
+        let ResponseItem::Message { content, .. } = &original else {
+            panic!()
+        };
+        assert!(
+            binding
+                .after_preparation("msg_duplicate_parts", content, content, &[(0, 0)])
+                .unwrap()
+                .is_none()
+        );
+        assert!(
+            PromptCacheAnnotation::bind(
+                "msg_duplicate_parts".into(),
+                content,
+                &[(0, marker()), (0, marker())]
+            )
+            .unwrap()
+            .is_none()
+        );
+        assert_eq!(serde_json::to_value(&original).unwrap(), before);
+    }
