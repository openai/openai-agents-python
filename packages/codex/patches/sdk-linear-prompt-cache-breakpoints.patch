+fn fingerprint_counts(
+    content: &[ContentItem],
+) -> Result<HashMap<String, usize>, serde_json::Error> {
+    let mut counts = HashMap::new();
+    for part in content {
+        *counts.entry(content_fingerprint(part)?).or_default() += 1;
+    }
+    Ok(counts)
+}
+
+fn unique_items(items: &[ResponseItem]) -> HashMap<String, Option<&ResponseItem>> {
+    let mut indexed = HashMap::new();
+    for item in items {
+        if let Some(id) = item.id() {
+            indexed
+                .entry(id.to_string())
+                .and_modify(|value| *value = None)
+                .or_insert(Some(item));
+        }
+    }
+    indexed
+}
