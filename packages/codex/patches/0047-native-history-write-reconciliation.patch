+#[tokio::test]
+async fn ambiguous_rollout_write_commits_exactly_one_original_line() -> std::io::Result<()> {
+    let home = TempDir::new().expect("temp dir");
+    let path = home.path().join("rollout.jsonl");
+    let old = b"existing line\n";
+    let next = b"original serialized item\n";
+    for count in [0, 5, next.len()] {
+        fs::write(&path, [old.as_slice(), &next[..count]].concat())?;
+        let mut writer = JsonlWriter {
+            file: tokio::fs::File::from_std(open_log_file(&path, false)?),
+        };
+        let mut pending = Some(PendingLine {
+            offset: old.len() as u64,
+            bytes: next.to_vec(),
+        });
+        writer
+            .write_rollout_item(&agent_message_item("retry"), Some(1), &mut pending)
+            .await?;
+        assert!(pending.is_none());
+        assert_eq!(fs::read(&path)?, [old.as_slice(), next.as_slice()].concat());
+    }
+    fs::write(&path, [old.as_slice(), b"unexpected"].concat())?;
+    let mut writer = JsonlWriter {
+        file: tokio::fs::File::from_std(open_log_file(&path, false)?),
+    };
+    let mut pending = Some(PendingLine {
+        offset: old.len() as u64,
+        bytes: next.to_vec(),
+    });
+    assert!(
+        writer
+            .write_rollout_item(&agent_message_item("retry"), Some(1), &mut pending)
+            .await
+            .is_err()
+    );
+    assert!(pending.is_some());
+    assert_eq!(fs::read(&path)?, [old.as_slice(), b"unexpected"].concat());
+    Ok(())
+}
