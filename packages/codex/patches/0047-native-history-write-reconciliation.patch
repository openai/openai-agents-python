+#[tokio::test]
+async fn writer_advances_once_after_an_acknowledgment_is_lost() -> std::io::Result<()> {
+    let home = TempDir::new().expect("temp dir");
+    let path = home.path().join("rollout.jsonl");
+    let first = agent_message_item("first");
+    let bytes = format!(
+        "{}\n",
+        serde_json::to_string(&RolloutLineRef {
+            timestamp: "2026-11-04T00:00:00.000Z".into(),
+            ordinal: Some(0),
+            item: &first,
+        })?
+    )
+    .into_bytes();
+    fs::write(&path, &bytes)?;
+    let mut state = RolloutWriterState {
+        writer: None,
+        deferred_creation: false,
+        pending_items: vec![first, agent_message_item("second")],
+        meta: None,
+        cwd: home.path().to_path_buf(),
+        rollout_path: path.clone(),
+        ordinal_state: RolloutOrdinalState::Paginated { next: Some(0) },
+        last_logged_error: None,
+        unacknowledged: Some(PendingLine { offset: 0, bytes }),
+    };
+    state.flush().await?;
+    state.flush().await?;
+    let lines = read_rollout_lines(&path)?;
+    assert_eq!(
+        lines.iter().map(|line| line.ordinal).collect::<Vec<_>>(),
+        vec![Some(0), Some(1)]
+    );
+    assert!(state.pending_items.is_empty());
+    Ok(())
+}
