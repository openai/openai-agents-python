diff --git a/codex-rs/core/src/session/sdk_produced_items.rs b/codex-rs/core/src/session/sdk_produced_items.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/session/sdk_produced_items.rs
@@ -0,0 +1,158 @@
+use std::io;
+use std::io::Write;
+use std::sync::Mutex;
+
+use codex_history::RolloutItem;
+use codex_protocol::agent_profile::AgentProfileReceipt;
+use codex_protocol::error::CodexErr;
+use codex_protocol::models::ResponseItem;
+use serde::Serialize;
+
+const MAX_ITEMS: usize = 4096;
+const MAX_BYTES: usize = 8 * 1024 * 1024;
+const LIMIT_ERROR: &str = "Produced run items exceed the one-shot result limit";
+
+/// Opt-in capture of accepted items for a single SDK invocation.
+#[derive(Default)]
+pub(crate) struct SdkProducedItems(Mutex<Capture>);
+
+#[derive(Default)]
+struct Capture {
+    turn_id: Option<String>,
+    json: Vec<u8>,
+    count: usize,
+    failed: bool,
+    finished: bool,
+}
+
+#[derive(Serialize)]
+struct ProducedItem<'a> {
+    record: &'a RolloutItem,
+    agent: Option<&'a AgentProfileReceipt>,
+}
+
+impl SdkProducedItems {
+    pub(super) fn start(&self, turn_id: &str) {
+        self.0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .turn_id
+            .get_or_insert_with(|| turn_id.to_owned());
+    }
+
+    pub(super) fn record(
+        &self,
+        turn_id: &str,
+        agent: Option<&AgentProfileReceipt>,
+        items: &[RolloutItem],
+    ) {
+        let mut capture = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if capture.failed || capture.finished || capture.turn_id.as_deref() != Some(turn_id) {
+            return;
+        }
+        for record in items {
+            let RolloutItem::ResponseItem(envelope) = record else {
+                continue;
+            };
+            if !is_produced_response(&envelope.item)
+                || envelope
+                    .metadata
+                    .as_ref()
+                    .is_some_and(|metadata| metadata.compaction_output)
+            {
+                continue;
+            }
+
+            let agent = envelope
+                .metadata
+                .as_ref()
+                .and_then(|metadata| metadata.sdk_agent_handoff.as_ref())
+                .map(|handoff| &handoff.source)
+                .or(agent);
+            if capture.count == MAX_ITEMS {
+                capture.failed = true;
+                break;
+            }
+            let delimiter = if capture.count == 0 { b'[' } else { b',' };
+            if capture.json.len() >= MAX_BYTES - 1 {
+                capture.failed = true;
+                break;
+            }
+            capture.json.push(delimiter);
+            let mut writer = BoundedJson(&mut capture.json);
+            if serde_json::to_writer(&mut writer, &ProducedItem { record, agent }).is_err() {
+                capture.failed = true;
+                break;
+            }
+            capture.count += 1;
+        }
+        if capture.failed {
+            capture.json = Vec::new();
+        }
+    }
+
+    pub(crate) fn finish(&self, turn_id: &str) -> Result<String, CodexErr> {
+        let mut capture = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        capture.finished = true;
+        if capture.turn_id.as_deref().is_some_and(|id| id != turn_id) {
+            return Err(CodexErr::InvalidRequest(
+                "Produced items belong to a different turn".into(),
+            ));
+        }
+        if capture.failed {
+            return Err(CodexErr::InvalidRequest(LIMIT_ERROR.into()));
+        }
+        if capture.count == 0 {
+            return Ok("[]".into());
+        }
+        let mut json = std::mem::take(&mut capture.json);
+        capture.count = 0;
+        json.push(b']');
+        String::from_utf8(json).map_err(|err| CodexErr::InvalidRequest(err.to_string()))
+    }
+}
+
+fn is_produced_response(item: &ResponseItem) -> bool {
+    match item {
+        ResponseItem::Message { role, .. } => role == "assistant",
+        ResponseItem::Reasoning { .. }
+        | ResponseItem::FunctionCall { .. }
+        | ResponseItem::FunctionCallOutput {
+            call_id: Some(_), ..
+        }
+        | ResponseItem::CustomToolCall { .. }
+        | ResponseItem::CustomToolCallOutput { .. }
+        | ResponseItem::ComputerCall { .. }
+        | ResponseItem::ComputerCallOutput { .. }
+        | ResponseItem::LocalShellCall { .. }
+        | ResponseItem::ToolSearchCall { .. }
+        | ResponseItem::ToolSearchOutput { .. }
+        | ResponseItem::WebSearchCall { .. }
+        | ResponseItem::FileSearchCall { .. }
+        | ResponseItem::CodeInterpreterCall { .. }
+        | ResponseItem::ImageGenerationCall { .. } => true,
+        _ => false,
+    }
+}
+
+struct BoundedJson<'a>(&'a mut Vec<u8>);
+
+impl Write for BoundedJson<'_> {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        if bytes.len() > (MAX_BYTES - 1).saturating_sub(self.0.len()) {
+            return Err(io::Error::other(LIMIT_ERROR));
+        }
+        self.0.extend_from_slice(bytes);
+        Ok(bytes.len())
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
