+async fn codex_apps_auth_prepared_call(
+    session: &Session,
+    turn_context: &TurnContext,
+) -> (wiremock::MockServer, codex_mcp::McpRuntime, PreparedMcpCall) {
+    assert!(!session.has_personal_apps_registration());
+    let server = wiremock::MockServer::start().await;
+    wiremock::Mock::given(wiremock::matchers::method("POST"))
+        .respond_with(|request: &wiremock::Request| {
+            let request: serde_json::Value = request.body_json().expect("MCP JSON request");
+            let Some(id) = request.get("id") else {
+                return wiremock::ResponseTemplate::new(202);
+            };
+            let result = match request["method"].as_str().expect("MCP method") {
+                "initialize" => serde_json::json!({
+                    "protocolVersion": request["params"]["protocolVersion"],
+                    "capabilities": {"tools": {}},
+                    "serverInfo": {"name": "auth-elicitation-fixture", "version": "1"},
+                }),
+                "tools/list" => serde_json::json!({"tools": [{
+                    "name": "search", "inputSchema": {"type": "object"},
+                }]}),
+                method => panic!("unexpected MCP method: {method}"),
+            };
+            wiremock::ResponseTemplate::new(200)
+                .set_body_json(serde_json::json!({"jsonrpc": "2.0", "id": id, "result": result}))
+        })
+        .mount(&server)
+        .await;
+    let server_config: McpServerConfig = serde_json::from_value(serde_json::json!({
+        "url": server.uri(),
+    }))
+    .expect("test MCP server config");
+    let mut config = (*mcp_config_for_test(&turn_context.config)).clone();
+    let mut catalog = codex_mcp::ResolvedMcpCatalog::builder();
+    catalog.register(codex_mcp::McpServerRegistration::from_hosted_apps(
+        "auth-elicitation-fixture",
+        0,
+        server_config.clone(),
+    ));
+    config.mcp_server_catalog = catalog.build();
+    let mcp_servers = HashMap::from([(
+        CODEX_APPS_MCP_SERVER_NAME.to_string(),
+        codex_mcp::EffectiveMcpServer::from_host_config(server_config),
+    )]);
+    config.set_server_permission_profiles(&mcp_servers, std::iter::empty());
+    let runtime = codex_mcp::McpRuntime::new(codex_mcp::McpRuntimeInput {
+        startup_policy: codex_mcp::McpStartupPolicy::Eager,
+        config: Arc::new(config),
+        plugins_available: false,
+        ready_selected_capability_roots: Vec::new(),
+        mcp_servers,
+        submit_id: "auth-elicitation-fixture".to_string(),
+        tx_event: None,
+        startup_cancellation_token: tokio_util::sync::CancellationToken::new(),
+        runtime_context: codex_mcp::McpRuntimeContext::new(
+            session.services.turn_environments.environment_manager(),
+            turn_context.config.cwd.to_path_buf(),
+        ),
+        codex_apps_tools_cache: codex_connectors::ConnectorRuntimeManager::new_without_cache(),
+        tool_catalog_cache: codex_mcp::McpToolCatalogCache::default(),
+        codex_apps_tools_cache_key: codex_connectors::ConnectorRuntimeContextKey::personal(
+            None, None,
+        ),
+        client_mcp_extensions: codex_protocol::mcp::ClientMcpExtensions::default(),
+        auth: None,
+        auth_manager: None,
+        elicitation_reviewer: None,
+        elicitation_lifecycle: None,
+    })
+    .await;
+    let binding = runtime
+        .current_binding_for_call(CODEX_APPS_MCP_SERVER_NAME)
+        .await
+        .expect("fixture server started");
+    let prepared_call = binding
+        .prepare_call(CODEX_APPS_MCP_SERVER_NAME, "search")
+        .expect("fixture tool has a captured client and permission authority");
+    assert_eq!(prepared_call.server_name(), CODEX_APPS_MCP_SERVER_NAME);
+    assert_eq!(
+        prepared_call.config().approval_policy.value(),
+        turn_context.config.permissions.approval_policy.value()
+    );
+    (server, runtime, prepared_call)
+}
+
