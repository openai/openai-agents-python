+use sha2::{Digest, Sha256};
+use std::collections::{HashMap, HashSet};
+use ts_rs::TS;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct PromptCacheBreakpoint {
+    pub mode: PromptCacheMode,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+pub struct PromptCacheUserInput {
+    #[serde(flatten)]
+    pub input: crate::user_input::UserInput,
+    #[serde(default, deserialize_with = "present_breakpoint")]
+    pub prompt_cache_breakpoint: Option<PromptCacheBreakpoint>,
+}
+
+fn present_breakpoint<'de, D: serde::Deserializer<'de>>(
+    deserializer: D,
+) -> Result<Option<PromptCacheBreakpoint>, D::Error> {
+    PromptCacheBreakpoint::deserialize(deserializer).map(Some)
+}
+
+pub fn split_user_input(
+    input: Vec<PromptCacheUserInput>,
+) -> (Vec<crate::user_input::UserInput>, Vec<InputCacheBreakpoint>) {
+    let mut content = Vec::with_capacity(input.len());
+    let mut breakpoints = Vec::new();
+    for (input_index, part) in input.into_iter().enumerate() {
+        if let Some(breakpoint) = part.prompt_cache_breakpoint {
+            breakpoints.push(InputCacheBreakpoint {
+                input_index,
+                breakpoint,
+            });
+        }
+        content.push(part.input);
+    }
+    (content, breakpoints)
+}
+
+/// Fresh canonical-history input; annotations remain data beside the typed projection.
+pub fn response_breakpoints(
+    raw: &str,
+) -> Result<Vec<(usize, PromptCacheBreakpoint)>, serde_json::Error> {
+    if !raw.contains("prompt_cache_breakpoint") {
+        return Ok(Vec::new());
+    }
+    let value: serde_json::Value = serde_json::from_str(raw)?;
+    if value.get("type").and_then(serde_json::Value::as_str) != Some("message") {
+        return Ok(Vec::new());
+    }
+    let Some(content) = value.get("content").and_then(serde_json::Value::as_array) else {
+        return Ok(Vec::new());
+    };
+    content
+        .iter()
+        .enumerate()
+        .filter_map(|(index, part)| {
+            part.get("prompt_cache_breakpoint").map(|marker| {
+                serde_json::from_value(marker.clone()).map(|breakpoint| (index, breakpoint))
+            })
+        })
+        .collect()
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct InputCacheBreakpoint {
+    pub input_index: usize,
+    pub breakpoint: PromptCacheBreakpoint,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct BoundCacheBreakpoint {
+    pub content_index: usize,
+    pub content_sha256: String,
+    pub breakpoint: PromptCacheBreakpoint,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct PromptCacheAnnotation {
+    pub occurrence: String,
+    pub parts: Vec<BoundCacheBreakpoint>,
+}
+
+/// Annotation-only refusal; underlying content and request policy remain available.
+#[derive(Debug, PartialEq)]
+pub enum PromptCacheProjection {
+    Annotated(serde_json::Value),
+    Refused,
+}
+
+pub fn content_fingerprint(content: &ContentItem) -> Result<String, serde_json::Error> {
+    Ok(format!(
+        "{:x}",
+        Sha256::digest(serde_json::to_vec(content)?)
+    ))
+}
+
+impl PromptCacheAnnotation {
+    pub fn bind(
+        occurrence: String,
+        content: &[ContentItem],
+        breakpoints: &[(usize, PromptCacheBreakpoint)],
+    ) -> Result<Option<Self>, serde_json::Error> {
+        if occurrence.is_empty() || breakpoints.is_empty() || breakpoints.len() > content.len() {
+            return Ok(None);
+        }
+        let mut indices = HashSet::with_capacity(breakpoints.len());
+        if breakpoints
+            .iter()
+            .any(|(index, _)| *index >= content.len() || !indices.insert(*index))
+        {
+            return Ok(None);
+        }
+        let parts = breakpoints
+            .iter()
+            .map(|(index, breakpoint)| {
+                Ok(BoundCacheBreakpoint {
+                    content_index: *index,
+                    content_sha256: content_fingerprint(&content[*index])?,
+                    breakpoint: *breakpoint,
+                })
+            })
+            .collect::<Result<Vec<_>, serde_json::Error>>()?;
+        Ok(Some(Self { occurrence, parts }))
+    }
+
+    /// An explicit source-to-prepared map, without content searches or inferred anchors.
+    pub fn after_preparation(
+        &self,
+        occurrence: &str,
+        original: &[ContentItem],
+        prepared: &[ContentItem],
+        destinations: &[(usize, usize)],
+    ) -> Result<Option<Self>, serde_json::Error> {
+        if occurrence != self.occurrence
+            || occurrence.is_empty()
+            || self.parts.len() > original.len()
+            || self.parts.len() > prepared.len()
+        {
+            return Ok(None);
+        }
+        let mut sources = HashSet::with_capacity(self.parts.len());
+        if self
+            .parts
+            .iter()
+            .any(|part| !sources.insert(part.content_index))
+        {
+            return Ok(None);
+        }
+        let mut mappings = HashMap::<usize, Option<usize>>::with_capacity(self.parts.len());
+        for (from, to) in destinations {
+            if sources.contains(from) {
+                mappings
+                    .entry(*from)
+                    .and_modify(|target| *target = None)
+                    .or_insert(Some(*to));
+            }
+        }
+        let mut source_counts = None;
+        let mut target_counts = None;
+        let mut targets = HashSet::with_capacity(self.parts.len());
+        let mut breakpoints = Vec::with_capacity(self.parts.len());
+        for part in &self.parts {
+            let Some(source) = original.get(part.content_index) else {
+                return Ok(None);
+            };
+            let source_fingerprint = content_fingerprint(source)?;
+            if source_fingerprint != part.content_sha256 {
+                return Ok(None);
+            }
+            let Some(target) = mappings.get(&part.content_index).copied().flatten() else {
+                return Ok(None);
+            };
+            let Some(prepared_part) = prepared.get(target) else {
+                return Ok(None);
+            };
+            if !targets.insert(target) {
+                return Ok(None);
+            }
+            let same_prepared_content = match (source, prepared_part) {
+                (ContentItem::InputImage { .. }, ContentItem::InputImage { .. }) => true,
+                _ => source == prepared_part,
+            };
+            if !same_prepared_content {
+                return Ok(None);
+            }
+            if target != part.content_index {
+                if source_counts.is_none() {
+                    source_counts = Some(fingerprint_counts(original)?);
+                    target_counts = Some(fingerprint_counts(prepared)?);
+                }
+                let target_fingerprint = content_fingerprint(prepared_part)?;
+                if source_counts
+                    .as_ref()
+                    .and_then(|counts| counts.get(&source_fingerprint))
+                    != Some(&1)
+                    || target_counts
+                        .as_ref()
+                        .and_then(|counts| counts.get(&target_fingerprint))
+                        != Some(&1)
+                {
+                    return Ok(None);
+                }
+            }
+            breakpoints.push((target, part.breakpoint));
+        }
+        Self::bind(self.occurrence.clone(), prepared, &breakpoints)
+    }
+
+    pub fn project(
+        &self,
+        occurrence: &str,
+        item: &ResponseItem,
+    ) -> Result<PromptCacheProjection, serde_json::Error> {
+        let ResponseItem::Message { content, .. } = item else {
+            return Ok(PromptCacheProjection::Refused);
+        };
+        if occurrence != self.occurrence
+            || occurrence.is_empty()
+            || self.parts.len() > content.len()
+        {
+            return Ok(PromptCacheProjection::Refused);
+        }
+        let mut indices = HashSet::with_capacity(self.parts.len());
+        for binding in &self.parts {
+            let Some(part) = content.get(binding.content_index) else {
+                return Ok(PromptCacheProjection::Refused);
+            };
+            if matches!(part, ContentItem::OutputText { .. })
+                || !indices.insert(binding.content_index)
+                || content_fingerprint(part)? != binding.content_sha256
+            {
+                return Ok(PromptCacheProjection::Refused);
+            }
+        }
+        let mut wire = serde_json::to_value(item)?;
+        for binding in &self.parts {
+            // ResponseItem::Message fixes this shape; validation above fixes every index.
+            wire["content"][binding.content_index]["prompt_cache_breakpoint"] =
+                serde_json::to_value(binding.breakpoint)?;
+        }
+        Ok(PromptCacheProjection::Annotated(wire))
+    }
+}
+
+fn fingerprint_counts(
+    content: &[ContentItem],
+) -> Result<HashMap<String, usize>, serde_json::Error> {
+    let mut counts = HashMap::new();
+    for part in content {
+        *counts.entry(content_fingerprint(part)?).or_default() += 1;
+    }
+    Ok(counts)
+}
+
+fn unique_items(items: &[ResponseItem]) -> HashMap<String, Option<&ResponseItem>> {
+    let mut indexed = HashMap::new();
+    for item in items {
+        if let Some(id) = item.id() {
+            indexed
+                .entry(id.to_string())
+                .and_modify(|value| *value = None)
+                .or_insert(Some(item));
+        }
+    }
+    indexed
+}
+
+/// The caller owns an in-place preparation step; item identities and part counts remain fixed.
+pub fn after_in_place_item_preparation(
+    annotations: &[PromptCacheAnnotation],
+    original: &[ResponseItem],
+    prepared: &[ResponseItem],
+) -> Vec<PromptCacheAnnotation> {
+    if annotations.is_empty() {
+        return Vec::new();
+    }
+    let mut occurrences = HashSet::with_capacity(annotations.len());
+    let mut duplicates = HashSet::new();
+    for annotation in annotations {
+        if !occurrences.insert(annotation.occurrence.as_str()) {
+            duplicates.insert(annotation.occurrence.as_str());
+        }
+    }
+    let sources = unique_items(original);
+    let targets = unique_items(prepared);
+    annotations
+        .iter()
+        .filter_map(|annotation| {
+            if duplicates.contains(annotation.occurrence.as_str()) {
+                return None;
+            }
+            let source = sources.get(&annotation.occurrence).copied().flatten()?;
+            let target = targets.get(&annotation.occurrence).copied().flatten()?;
+            let (
+                ResponseItem::Message {
+                    content: source, ..
+                },
+                ResponseItem::Message {
+                    content: target, ..
+                },
+            ) = (source, target)
+            else {
+                return None;
+            };
+            if source.len() != target.len() {
+                return None;
+            }
+            let destinations = (0..source.len())
+                .map(|index| (index, index))
+                .collect::<Vec<_>>();
+            annotation
+                .after_preparation(&annotation.occurrence, source, target, &destinations)
+                .ok()
+                .flatten()
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn item(parts: serde_json::Value) -> ResponseItem {
+        serde_json::from_value(json!({"type":"message", "role":"user", "content":parts})).unwrap()
+    }
+    fn marker() -> PromptCacheBreakpoint {
+        PromptCacheBreakpoint {
+            mode: PromptCacheMode::Explicit,
+        }
+    }
+    fn bind(occurrence: &str, item: &ResponseItem, index: usize) -> PromptCacheAnnotation {
+        let ResponseItem::Message { content, .. } = item else {
+            panic!()
+        };
+        PromptCacheAnnotation::bind(occurrence.into(), content, &[(index, marker())])
+            .unwrap()
+            .unwrap()
+    }
+
+    #[test]
+    fn portable_binding_preserves_canonical_content_and_exact_occurrence() {
+        let original = item(json!([
+            {"type":"input_text","text":"first"},
+            {"type":"input_text","text":"second"}
+        ]));
+        let canonical = serde_json::to_value(&original).unwrap();
+        let saved = bind("occurrence-a", &original, 1);
+        let restored: PromptCacheAnnotation =
+            serde_json::from_str(&serde_json::to_string(&saved).unwrap()).unwrap();
+        let PromptCacheProjection::Annotated(wire) =
+            restored.project("occurrence-a", &original).unwrap()
+        else {
+            panic!()
+        };
+        assert_eq!(
+            wire["content"][1]["prompt_cache_breakpoint"],
+            json!({"mode":"explicit"})
+        );
+        assert!(wire["content"][0].get("prompt_cache_breakpoint").is_none());
+        assert_eq!(serde_json::to_value(&original).unwrap(), canonical);
+        assert_eq!(
+            restored.project("occurrence-b", &original).unwrap(),
+            PromptCacheProjection::Refused
+        );
+    }
+
+    #[test]
+    fn reorder_and_changed_payload_refuse_annotation_without_mutating_content() {
+        let original = item(json!([
+            {"type":"input_text","text":"first"},
+            {"type":"input_text","text":"second"}
+        ]));
+        let saved = bind("occurrence-a", &original, 1);
+        for content in [
+            json!([{"type":"input_text","text":"second"},{"type":"input_text","text":"first"}]),
+            json!([{"type":"input_text","text":"first"},{"type":"input_text","text":"changed"}]),
+        ] {
+            let changed = item(content);
+            let before = serde_json::to_value(&changed).unwrap();
+            assert_eq!(
+                saved.project("occurrence-a", &changed).unwrap(),
+                PromptCacheProjection::Refused
+            );
+            assert_eq!(serde_json::to_value(&changed).unwrap(), before);
+        }
+    }
+
+    #[test]
+    fn duplicate_content_keeps_exact_part_anchor() {
+        let repeated = item(json!([
+            {"type":"input_text","text":"same"},
+            {"type":"input_text","text":"same"}
+        ]));
+        let saved = bind("occurrence-a", &repeated, 1);
+        let PromptCacheProjection::Annotated(wire) =
+            saved.project("occurrence-a", &repeated).unwrap()
+        else {
+            panic!()
+        };
+        assert!(wire["content"][0].get("prompt_cache_breakpoint").is_none());
+        assert_eq!(
+            wire["content"][1]["prompt_cache_breakpoint"],
+            json!({"mode":"explicit"})
+        );
+    }
+    #[test]
+    fn supported_media_keeps_its_canonical_shape() {
+        for part in [
+            json!({"type":"input_text","text":"<user_instructions>untrusted</user_instructions>"}),
+            json!({"type":"input_image","file_id":"file_synthetic_image"}),
+            json!({"type":"input_audio","audio_url":"data:audio/wav;base64,UklGRg=="}),
+            json!({"type":"input_file","file_id":"file_synthetic_document"}),
+        ] {
+            let original = item(json!([part]));
+            let canonical = serde_json::to_value(&original).unwrap();
+            let binding = bind("occurrence-media", &original, 0);
+            let PromptCacheProjection::Annotated(mut projected) =
+                binding.project("occurrence-media", &original).unwrap()
+            else {
+                panic!()
+            };
+            projected["content"][0]
+                .as_object_mut()
+                .unwrap()
+                .remove("prompt_cache_breakpoint");
+            assert_eq!(projected, canonical);
+        }
+    }
+
+    #[test]
+    fn explicit_reorder_map_preserves_unique_occurrence_without_guessing() {
+        let original = item(
+            json!([{"type":"input_text","text":"first"},{"type":"input_text","text":"second"}]),
+        );
+        let prepared = item(
+            json!([{"type":"input_text","text":"second"},{"type":"input_text","text":"first"}]),
+        );
+        let binding = bind("occurrence-a", &original, 1);
+        let ResponseItem::Message {
+            content: source, ..
+        } = &original
+        else {
+            panic!()
+        };
+        let ResponseItem::Message {
+            content: target, ..
+        } = &prepared
+        else {
+            panic!()
+        };
+        let mapped = binding
+            .after_preparation("occurrence-a", source, target, &[(1, 0)])
+            .unwrap()
+            .unwrap();
+        let PromptCacheProjection::Annotated(projected) =
+            mapped.project("occurrence-a", &prepared).unwrap()
+        else {
+            panic!()
+        };
+        assert_eq!(
+            projected["content"][0]["prompt_cache_breakpoint"],
+            json!({"mode":"explicit"})
+        );
+        assert!(
+            projected["content"][1]
+                .get("prompt_cache_breakpoint")
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn ambiguous_update_refuses_only_annotation_and_preserves_original_anchor() {
+        let repeated =
+            item(json!([{"type":"input_text","text":"same"},{"type":"input_text","text":"same"}]));
+        let binding = bind("occurrence-a", &repeated, 1);
+        let before = binding.clone();
+        let ResponseItem::Message { content, .. } = &repeated else {
+            panic!()
+        };
+        assert!(
+            binding
+                .after_preparation("occurrence-a", content, content, &[(1, 0)])
+                .unwrap()
+                .is_none()
+        );
+        assert_eq!(binding, before);
+        assert_eq!(
+            serde_json::to_value(&repeated).unwrap()["content"],
+            json!([{"type":"input_text","text":"same"},{"type":"input_text","text":"same"}])
+        );
+    }
+
+    #[test]
+    fn invalid_breakpoint_shape_has_no_annotation() {
+        assert!(
+            serde_json::from_value::<PromptCacheBreakpoint>(json!({"mode":"invalid"})).is_err()
+        );
+        assert!(
+            serde_json::from_value::<PromptCacheBreakpoint>(
+                json!({"mode":"explicit","extra":true})
+            )
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn duplicate_part_bindings_refuse_only_the_annotation() {
+        let original = item(json!([{"type":"input_text","text":"unchanged"}]));
+        let before = serde_json::to_value(&original).unwrap();
+        let mut binding = bind("msg_duplicate_parts", &original, 0);
+        binding.parts.push(binding.parts[0].clone());
+        assert_eq!(
+            binding.project("msg_duplicate_parts", &original).unwrap(),
+            PromptCacheProjection::Refused
+        );
+        let ResponseItem::Message { content, .. } = &original else {
+            panic!()
+        };
+        assert!(
+            binding
+                .after_preparation("msg_duplicate_parts", content, content, &[(0, 0)])
+                .unwrap()
+                .is_none()
+        );
+        assert!(
+            PromptCacheAnnotation::bind(
+                "msg_duplicate_parts".into(),
+                content,
+                &[(0, marker()), (0, marker())]
+            )
+            .unwrap()
+            .is_none()
+        );
+        assert_eq!(serde_json::to_value(&original).unwrap(), before);
+    }
+
+    #[test]
+    fn large_annotated_part_fixture_stays_within_native_frame_budget() {
+        const PARTS: usize = 32_768;
+        let content = (0..PARTS)
+            .map(|index| ContentItem::InputText {
+                text: format!("part-{index}"),
+            })
+            .collect::<Vec<_>>();
+        let breakpoints = (0..PARTS)
+            .map(|index| (index, marker()))
+            .collect::<Vec<_>>();
+        let binding = PromptCacheAnnotation::bind("msg_many_parts".into(), &content, &breakpoints)
+            .unwrap()
+            .unwrap();
+        assert!(serde_json::to_vec(&(&content, &binding)).unwrap().len() < 8 * 1024 * 1024);
+        let original = item(serde_json::to_value(&content).unwrap());
+        let destinations = (0..PARTS).map(|index| (index, index)).collect::<Vec<_>>();
+        let prepared = binding
+            .after_preparation("msg_many_parts", &content, &content, &destinations)
+            .unwrap()
+            .unwrap();
+        let PromptCacheProjection::Annotated(projected) =
+            prepared.project("msg_many_parts", &original).unwrap()
+        else {
+            panic!()
+        };
+        assert_eq!(prepared.parts.len(), PARTS);
+        for index in [0, PARTS - 1] {
+            assert_eq!(
+                projected["content"][index]["prompt_cache_breakpoint"],
+                json!({"mode":"explicit"})
+            );
+            assert_eq!(projected["content"][index]["text"], format!("part-{index}"));
+        }
+    }
+
+    #[test]
+    fn many_occurrences_keep_unique_annotations_and_refuse_ambiguous_owners() {
+        let original = (0..4096).map(|index| serde_json::from_value(json!({"type":"message","role":"user","id":format!("msg_many_{index}"),"content":[{"type":"input_text","text":"unchanged"}]})).unwrap()).collect::<Vec<ResponseItem>>();
+        let annotations = original
+            .iter()
+            .enumerate()
+            .map(|(index, item)| bind(&format!("msg_many_{index}"), item, 0))
+            .collect::<Vec<_>>();
+        let retained = after_in_place_item_preparation(&annotations, &original, &original);
+        assert_eq!(retained, annotations);
+        let mut duplicates = annotations.clone();
+        duplicates.push(annotations[0].clone());
+        let retained = after_in_place_item_preparation(&duplicates, &original, &original);
+        assert_eq!(retained.len(), annotations.len() - 1);
+        assert!(
+            retained
+                .iter()
+                .all(|annotation| annotation.occurrence != "msg_many_0")
+        );
+        let mut duplicated_source = original.clone();
+        duplicated_source.push(original[0].clone());
+        let retained = after_in_place_item_preparation(&annotations, &duplicated_source, &original);
+        assert_eq!(retained.len(), annotations.len() - 1);
+        assert!(
+            retained
+                .iter()
+                .all(|annotation| annotation.occurrence != "msg_many_0")
+        );
+    }
+}
