+#[derive(Clone, Debug)]
+struct OriginalIndex {
+    hash: Sha256,
+    revision: String,
+}
+
+impl OriginalIndex {
+    fn append(&mut self, total: usize, original: &str) {
+        if total != 0 {
+            self.hash.update(b",");
+        }
+        self.hash.update(original.as_bytes());
+        self.complete();
+    }
+
+    fn complete(&mut self) {
+        let mut completed = self.hash.clone();
+        completed.update(b"]");
+        self.revision = format!("{:x}", completed.finalize());
+    }
+}
+
+/// Folds a complete effective original stream while retaining only its requested suffix.
+///
+/// The first pass supplies the complete count. Readers must then feed every effective original,
+/// in order, using decoded UTF-8 chunks. No full catalog or skipped original string is required
+/// merely to compute the complete revision. Journal selection and JSON validation remain with
+/// the reader; this fold grants no replacement authority to a partial stream.
+pub struct SdkOriginalSnapshotFold {
+    expected_total: usize,
+    completed: usize,
+    skip: usize,
+    index: OriginalIndex,
+    items: Vec<String>,
+    active: bool,
+    current: Option<Vec<u8>>,
+}
+
+impl SdkOriginalSnapshotFold {
+    pub fn new(total: usize, limit: usize) -> Self {
+        Self {
+            expected_total: total,
+            completed: 0,
+            skip: total.saturating_sub(limit),
+            index: OriginalIndex::default(),
+            items: Vec::new(),
+            active: false,
+            current: None,
+        }
+    }
+
+    pub fn begin_item(&mut self) -> Result<(), &'static str> {
+        if self.active || self.completed == self.expected_total {
+            return Err("inconsistent original stream");
+        }
+        if self.completed != 0 {
+            self.index.hash.update(b",");
+        }
+        self.active = true;
+        self.current = (self.completed >= self.skip).then(Vec::new);
+        Ok(())
+    }
+
+    pub fn write_item(&mut self, bytes: &[u8]) -> Result<(), &'static str> {
+        if !self.active {
+            return Err("inconsistent original stream");
+        }
+        self.index.hash.update(bytes);
+        if let Some(current) = &mut self.current {
+            current.extend_from_slice(bytes);
+        }
+        Ok(())
+    }
+
+    pub fn end_item(&mut self) -> Result<(), &'static str> {
+        if !self.active {
+            return Err("inconsistent original stream");
+        }
+        if let Some(current) = self.current.take() {
+            self.items
+                .push(String::from_utf8(current).map_err(|_| "invalid original stream encoding")?);
+        }
+        self.active = false;
+        self.completed += 1;
+        self.index.complete();
+        Ok(())
+    }
+
+    pub fn finish(self) -> Result<(String, usize, Vec<String>), &'static str> {
+        if self.active || self.completed != self.expected_total {
+            return Err("incomplete original stream");
+        }
+        Ok((self.index.revision, self.completed, self.items))
+    }
+}
+
+impl Default for OriginalIndex {
+    fn default() -> Self {
+        let mut hash = Sha256::new();
+        hash.update(b"[");
+        let mut completed = hash.clone();
+        completed.update(b"]");
+        Self {
+            hash,
+            revision: format!("{:x}", completed.finalize()),
+        }
+    }
+}
+
+impl Default for SdkOriginalHistory {
+    fn default() -> Self {
+        Self {
+            format_version: 1,
+            items: Vec::new(),
+            index: OriginalIndex::default(),
+            post_checkpoint_start: None,
+        }
+    }
+}
+
+impl PartialEq for SdkOriginalHistory {
+    fn eq(&self, other: &Self) -> bool {
+        self.format_version == other.format_version && self.items == other.items
+    }
+}
+
+impl<'de> Deserialize<'de> for SdkOriginalHistory {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        struct Stored {
+            format_version: u32,
+            items: Vec<SdkOriginalItem>,
+        }
+        let stored = Stored::deserialize(deserializer)?;
+        if stored.format_version != 1 {
+            return Err(serde::de::Error::custom(
+                "unsupported original history format",
+            ));
+        }
+        let mut history = Self::default();
+        for item in stored.items {
+            if serde_json::from_str::<BTreeMap<String, &RawValue>>(&item.original).is_err() {
+                return Err(serde::de::Error::custom("invalid original history value"));
+            }
+            history.append(item);
+        }
+        Ok(history)
+    }
+}
