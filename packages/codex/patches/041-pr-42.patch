+        });
+        let second = json!({"type":"message","id":"covered-2","role":"user","content":[{"type":"input_text","text":"second covered original"}]}).to_string();
+        history.append(SdkOriginalItem {
+            projection: input_projection(&second)
+                .unwrap()
+                .map(ResponseItemEnvelope::new),
+            original: second,
+        });
+        // The exact audit value has never been admitted to the model.
+        let audit =
+            r#"{ "type":"future_record", "large":123456789012345678901234567890 }"#.to_string();
+        history.append(SdkOriginalItem {
+            original: audit.clone(),
+            projection: None,
+        });
+        let mut summary = input_projection(&summary)
+            .unwrap()
+            .map(ResponseItemEnvelope::new)
+            .unwrap();
+        summary
+            .metadata
+            .get_or_insert_with(Default::default)
+            .compaction_output = true;
+        let checkpoint = crate::RolloutItem::Compacted(crate::CompactedItem {
+            sdk_originals: Some(history.into()),
+            message: String::new(),
+            replacement_history: Some(vec![summary]),
+            guardian_history: None,
+            retained_context: Some(Default::default()),
+            mcp_resource_origins: None,
+            window_number: None,
+            first_window_id: None,
+            previous_window_id: None,
+            window_id: None,
+            compaction_response_id: None,
+            latest_token_usage_record: None,
+            resume_metadata: None,
+        });
+        let restored: crate::RolloutItem =
+            serde_json::from_slice(&serde_json::to_vec(&checkpoint).unwrap()).unwrap();
+        let crate::RolloutItem::Compacted(mut checkpoint) = restored else {
+            panic!("compacted record")
+        };
+        let Some(SdkOriginalHistoryCheckpoint::Replace(history)) = checkpoint.sdk_originals.take()
+        else {
+            panic!("original catalog")
+        };
+        let current = checkpoint.replacement_history.take().unwrap();
+        let before = history.snapshot(None);
+        let removed = history.prepare_pop(&current, false).unwrap().unwrap();
+        assert_eq!(removed.item, audit);
+        assert_eq!(removed.projection, current);
+        assert!(!removed.rebuilt_context);
+        assert_eq!(history.snapshot(None), before);
+        // Ordinary transactions still cannot silently retain an ambiguous summary.
+        assert!(history.retained_projection(&current, 2).is_err());
+        let retained = removed.originals;
+        assert!(retained.prepare_pop(&current, false).is_err());
+        assert_eq!(retained.snapshot(None).2, before.2[..2]);
+        let rebuilt = retained.prepare_pop(&current, true).unwrap().unwrap();
