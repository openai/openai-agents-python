+        let orphan = r#"{"type":"function_call","id":"interrupted","call_id":"interrupted","name":"lookup","arguments":"{}"}"#;
+        let tail = r#"{"type":"message","id":"user-2","role":"user","content":[{"type":"input_text","text":"remove"}]}"#;
+        let summary = r#"{"type":"message","id":"summary","role":"user","content":[{"type":"input_text","text":"covered context"}]}"#;
+        let mut history = SdkOriginalHistory::default();
+        for original in [user, orphan, tail] {
+            history.append(SdkOriginalItem {
+                original: original.to_owned(),
+                projection: input_projection(original)
+                    .unwrap()
+                    .map(ResponseItemEnvelope::new),
+            });
+        }
+        let compacted = vec![ResponseItemEnvelope::new(
+            input_projection(summary).unwrap().unwrap(),
