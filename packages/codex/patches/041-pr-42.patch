+    fn audit_only_pop_preserves_compacted_projection_after_cold_restore() {
+        let original = json!({"type":"message","id":"covered","role":"user","content":[{"type":"input_text","text":"covered original"}]}).to_string();
+        let summary = json!({"type":"message","id":"summary","role":"user","content":[{"type":"input_text","text":"compacted context"}]}).to_string();
