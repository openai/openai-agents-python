+/// Await application work once, before any native summarization attempts.
+/// Both compaction implementations keep their existing lifecycle and publication.
+pub(crate) async fn try_custom_compaction(
+    sess: &Session,
+    turn_context: &TurnContext,
+    replacement_step_context: &StepContext,
+    world_state: &WorldState,
+    metadata: CompactionTurnMetadata,
+) -> CodexResult<Option<String>> {
+    let thread_id = sess.thread_id.to_string();
+    let contributors = sess.services.extensions.model_request_contributors();
+    if !contributors
+        .iter()
+        .any(|c| c.customizes_compaction(&thread_id))
+    {
+        return Ok(None);
+    }
+    let history = sess.clone_history().await;
+    let input_goal_ids = UserGoalUpdate::message_ids(history.raw_items());
+    let items = history.for_prompt(&turn_context.model_info().input_modalities);
+    for contributor in contributors {
+        if !contributor.customizes_compaction(&thread_id) {
+            continue;
+        }
+        let summary = contributor
+            .before_compact(codex_extension_api::CompactionInput {
+                thread_id: &thread_id,
+                turn_id: &turn_context.sub_id,
+                model: &turn_context.model_info().slug,
+                automatic: matches!(metadata.trigger(), CompactionTrigger::Auto),
+                items: &items,
+            })
+            .await
+            .map_err(CodexErr::InvalidRequest)?;
+        if let Some(summary) = summary {
+            publish_compaction_summary(
+                sess,
+                turn_context,
+                replacement_step_context,
+                world_state,
+                &summary,
+                input_goal_ids,
+                None,
+            )
+            .await;
+            return Ok(Some(summary));
+        }
+    }
+    Ok(None)
+}
+
+async fn publish_compaction_summary(
+    sess: &Session,
+    turn_context: &TurnContext,
+    replacement_step_context: &StepContext,
+    world_state: &WorldState,
+    summary_suffix: &str,
+    input_goal_ids: HashSet<ResponseItemId>,
+    compaction_response_id: Option<String>,
+) {
+    let history_snapshot = sess.clone_history().await;
+    let history_items = history_snapshot.annotated_items();
+    let compaction_model_hash = compaction_response_id
+        .as_ref()
+        .and_then(|_| turn_context.model_info().comp_hash.clone());
+    let summary_text = format!("{SUMMARY_PREFIX}\n{summary_suffix}");
+    let user_messages = collect_annotated_user_messages(history_items);
+
+    let mut new_history = build_compacted_history(Vec::new(), &user_messages, &summary_text);
+    if let Some(summary_item) = new_history.last_mut() {
+        // This replacement history skips `record_conversation_items`; only the appended summary
+        // belongs to this compaction turn.
+        summary_item.set_turn_id_if_missing(&turn_context.sub_id);
+    }
+    let (window_number, window_ids) = sess.advance_auto_compact_window().await;
+
+    let (initial_context, world_state_baseline) =
+        build_compaction_initial_context(sess, replacement_step_context, world_state).await;
+    new_history =
+        insert_initial_context_before_last_real_user_or_summary(new_history, initial_context);
+    sess.replace_compacted_history(
+        new_history,
+        replacement_step_context.to_turn_context_item(),
+        world_state_baseline,
+        CompactedHistoryMetadata {
+            input_goal_ids,
+            message: summary_text,
+            window_number,
+            window_ids,
+            compaction_response_id: compaction_response_id,
+            compaction_model_hash,
+            reviewer_compaction_hash: None,
+        },
+    )
+    .await;
+    sess.recompute_token_usage(replacement_step_context).await;
+}
