+// Older SDKs accept an empty token-count event and ignore its extension fields.
+// Current readers recover the original model-invisible record before replay.
+#[derive(Serialize, Deserialize, JsonSchema)]
+#[serde(tag = "kind", content = "data", rename_all = "snake_case")]
+pub(super) enum SdkRolloutRecord<'a> {
+    ModelAttempt(Cow<'a, ModelAttemptEvent>),
+    ResponseFact(Cow<'a, ResponseFactRecord>),
+}
+
+impl<'a> RolloutItemWire<'a> {
+    fn sdk_record(record: SdkRolloutRecord<'a>) -> Self {
+        Self::EventMsg {
+            payload: Cow::Owned(EventMsg::TokenCount(TokenCountEvent {
+                info: None,
+                rate_limits: None,
+                api_rate_limits: None,
+            })),
+            sdk_record: Some(record),
+        }
+    }
+
+    pub(super) fn validate(&self) -> Result<(), &'static str> {
+        if let Self::EventMsg {
+            payload,
+            sdk_record: Some(_),
+            ..
+        } = self
+            && !matches!(
+                payload.as_ref(),
+                EventMsg::TokenCount(TokenCountEvent {
+                    info: None,
+                    rate_limits: None,
+                    api_rate_limits: None,
+                })
+            )
+        {
+            return Err("SDK rollout records require an empty token-count carrier");
+        }
+        Ok(())
+    }
+}
