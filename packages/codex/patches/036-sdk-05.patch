+#[cfg(test)]
+mod sdk_rollback_tests {
+    use super::*;
+    use serde_json::Value;
+    use serde_json::json;
+
+    fn records() -> [Value; 2] {
+        [
+            json!({"type": "event_msg", "payload": {
+                "type": "_sdk_model_attempt", "thread": "thread", "turn_id": "turn",
+                "data": {"attempt_id": "attempt", "phase": "finished",
+                    "owner_attempt_id": "attempt", "terminal_attempt_id": null,
+                    "usage": {"requests": 1, "token_usage": {
+                        "input_tokens": 7, "cached_input_tokens": 0,
+                        "cache_write_input_tokens": 0, "output_tokens": 3,
+                        "reasoning_output_tokens": 0, "total_tokens": 10
+                    }, "requests_without_token_usage": 0}}
+            }}),
+            json!({"type": "response_fact_record", "payload": {
+                "id": "fact", "thread_id": "00000000-0000-4000-8000-000000000001",
+                "turn_id": "turn", "request_id": "request", "response_id": "response",
+                "fact": {"kind": "refusal", "item_id": "item", "content_index": 0,
+                    "snapshot": true, "text": "Synthetic refusal", "capture_complete": true}
+            }}),
+        ]
+    }
+
+    #[test]
+    fn newer_records_round_trip_through_older_readable_carriers() {
+        for (original, kind) in records()
+            .into_iter()
+            .zip(["model_attempt", "response_fact"])
+        {
+            // Legacy alpha.8 direct records remain readable without changing their contents.
+            let item: RolloutItem = serde_json::from_value(original.clone()).unwrap();
+            let wire = serde_json::to_value(&item).unwrap();
+            assert_eq!(wire["type"], "event_msg");
+            assert_eq!(
+                wire["payload"],
+                json!({"type": "token_count", "info": null, "rate_limits": null})
+            );
+            assert_eq!(wire["sdk_record"]["kind"], kind);
+            let expected = if kind == "model_attempt" {
+                let mut data = original["payload"].clone();
+                data.as_object_mut().unwrap().remove("type");
+                data
+            } else {
+                original["payload"].clone()
+            };
+            assert_eq!(wire["sdk_record"]["data"], expected);
+            let restored: RolloutItem = serde_json::from_value(wire.clone()).unwrap();
+            if kind == "model_attempt" {
+                assert!(matches!(
+                    restored,
+                    RolloutItem::EventMsg(EventMsg::SdkModelAttempt(_))
+                ));
+            } else {
+                assert!(matches!(restored, RolloutItem::ResponseFactRecord(_)));
+            }
+            assert_eq!(serde_json::to_value(restored).unwrap(), wire);
+        }
+    }
+
+    #[test]
+    fn carrier_cannot_suppress_another_event_or_usage() {
+        let item: RolloutItem = serde_json::from_value(records()[0].clone()).unwrap();
+        let wire = serde_json::to_value(item).unwrap();
+        for payload in [
+            json!({"type": "task_complete", "turn_id": "turn", "last_agent_message": null}),
+            json!({"type": "token_count", "info": null, "rate_limits": null,
+                "api_rate_limits": {}}),
+            json!({"type": "token_count", "info": null, "rate_limits": {}}),
+        ] {
+            let mut invalid = wire.clone();
+            invalid["payload"] = payload;
+            assert!(serde_json::from_value::<RolloutItem>(invalid).is_err());
+        }
+    }
+
+    #[test]
+    fn ordinary_empty_token_count_keeps_its_wire_shape() {
+        let wire = json!({"type": "event_msg", "payload": {
+            "type": "token_count", "info": null, "rate_limits": null}});
+        let item: RolloutItem = serde_json::from_value(wire.clone()).unwrap();
+        assert_eq!(serde_json::to_value(item).unwrap(), wire);
+    }
+}
