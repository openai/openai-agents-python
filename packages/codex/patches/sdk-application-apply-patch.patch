+#[test]
+fn application_patch_replaces_only_builtin_and_retains_other_environment_tools() {
+    let mut registry = ToolRegistry::default();
+    registry.add(crate::tools::handlers::apply_patch::ApplyPatchHandler::new(false));
+    let other: Arc<dyn CoreToolRuntime> = Arc::new(TestHandler { tool_name: ToolName::plain("project_grep") });
+    registry.register_trusted(Arc::clone(&other));
+    assert!(registry.register_external(Arc::new(crate::tools::handlers::application_apply_patch::ApplicationApplyPatchHandler::new())));
+    assert_eq!(registry.tools.len(), 2);
+    let patch = registry.tools.get(&ToolName::plain("apply_patch").with_default_namespace()).unwrap();
+    assert!(matches!(patch.runtime.spec(), ToolSpec::ApplyPatch {}));
+    let retained = registry.tools.get(&ToolName::plain("project_grep").with_default_namespace()).unwrap();
+    assert!(Arc::ptr_eq(&retained.runtime, &other));
+    assert!(registry.first_collision().is_none());
+    assert!(!registry.register_external(Arc::new(crate::tools::handlers::application_apply_patch::ApplicationApplyPatchHandler::new())));
+    assert_eq!(registry.tools.len(), 2);
+    assert_eq!(registry.first_collision(), Some(&ToolName::plain("apply_patch").with_default_namespace()));
