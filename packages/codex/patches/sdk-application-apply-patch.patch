diff --git a/codex-rs/core/src/tools/handlers/application_apply_patch.rs b/codex-rs/core/src/tools/handlers/application_apply_patch.rs
new file mode 100644
index 00000000..1935fea5
--- /dev/null
+++ b/codex-rs/core/src/tools/handlers/application_apply_patch.rs
@@ -0,0 +1,85 @@
+use crate::function_tool::FunctionCallError;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolOutput;
+use crate::tools::context::ToolPayload;
+use crate::tools::registry::CoreToolRuntime;
+use crate::tools::registry::ToolExecutor;
+use crate::tools::registry::ToolExposure;
+use codex_tools::ApplyPatchToolOutput;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+
+pub(crate) struct ApplicationApplyPatchHandler {
+    spec: ToolSpec,
+}
+impl ApplicationApplyPatchHandler {
+    pub(crate) fn new() -> Self {
+        Self {
+            spec: ToolSpec::ApplyPatch {},
+        }
+    }
+}
+impl ToolExecutor<ToolInvocation> for ApplicationApplyPatchHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("apply_patch")
+    }
+    fn spec(&self) -> ToolSpec {
+        self.spec.clone()
+    }
+    fn exposure(&self) -> ToolExposure {
+        ToolExposure::DirectModelOnly
+    }
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let ToolPayload::ApplyPatch { arguments } = &invocation.payload else {
+                return Err(FunctionCallError::Fatal(
+                    "application patch handler requires native apply patch call".into(),
+                ));
+            };
+            let args = serde_json::from_str(arguments).map_err(|err| {
+                FunctionCallError::Fatal(format!("invalid application patch call: {err}"))
+            })?;
+            let response = super::dynamic::request_dynamic_tool(
+                &invocation.session,
+                &invocation.turn,
+                invocation.call_id,
+                self.tool_name(),
+                args,
+            )
+            .await
+            .ok_or_else(|| FunctionCallError::Fatal("application patch call cancelled".into()))?;
+            Ok(Box::new(ApplyPatchToolOutput::from_dynamic_response(
+                arguments, response,
+            )?) as Box<dyn ToolOutput>)
+        })
+    }
+}
+impl CoreToolRuntime for ApplicationApplyPatchHandler {
+    fn matches_kind(&self, payload: &ToolPayload) -> bool {
+        matches!(payload, ToolPayload::ApplyPatch { .. })
+    }
+    fn is_third_party_tool(&self) -> bool {
+        true
+    }
+}
+
+#[cfg(test)]
