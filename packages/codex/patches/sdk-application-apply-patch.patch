+#[test]
+fn application_patch_extension_retains_typed_payload_admission_and_replaces_builtin() {
+    let runtime = crate::tools::handlers::extension_tools::ExtensionToolAdapter::new(Arc::new(ApplicationPatchExtension));
+    assert!(runtime.matches_kind(&ToolPayload::ApplyPatch { arguments:"{}".into() }));
+    assert!(!runtime.matches_kind(&ToolPayload::Function { arguments:"{}".into() }));
+    assert!(!runtime.matches_kind(&ToolPayload::Custom { input:"patch".into() }));
