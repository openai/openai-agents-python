diff --git a/codex-rs/tools/src/apply_patch.rs b/codex-rs/tools/src/apply_patch.rs
new file mode 100644
index 00000000..c4063006
--- /dev/null
+++ b/codex-rs/tools/src/apply_patch.rs
@@ -0,0 +1,119 @@
+use crate::{FunctionCallError, ToolOutput, ToolPayload};
+use codex_protocol::dynamic_tools::{DynamicToolCallOutputContentItem, DynamicToolResponse};
+use codex_protocol::models::{
+    ApplyPatchOperation, ApplyPatchResult, ApplyPatchStatus, ResponseInputItem,
+};
+use serde_json::Value;
+
+pub fn validate_apply_patch_call(call: &Value) -> Result<(), String> {
+    if call["type"] != "apply_patch_call" || call["call_id"].as_str().is_none_or(str::is_empty) {
+        return Err("invalid application apply patch call".into());
+    }
+    let operation: ApplyPatchOperation = serde_json::from_value(call["operation"].clone())
+        .map_err(|_| "invalid application apply patch operation".to_owned())?;
+    if let ApplyPatchOperation::UpdateFile {
+        move_to: Some(destination),
+        ..
+    } = operation
+        && destination.is_empty()
+    {
+        return Err("invalid application apply patch move destination".into());
+    }
+    Ok(())
+}
+
+pub struct ApplyPatchToolOutput {
+    result: ApplyPatchResult,
+}
+impl ApplyPatchToolOutput {
+    pub fn from_dynamic_response(
+        arguments: &str,
+        response: DynamicToolResponse,
+    ) -> Result<Self, FunctionCallError> {
+        let invalid = || FunctionCallError::Fatal("invalid application apply patch result".into());
+        let call: Value = serde_json::from_str(arguments).map_err(|_| invalid())?;
+        validate_apply_patch_call(&call).map_err(FunctionCallError::Fatal)?;
+        let [DynamicToolCallOutputContentItem::InputText { text }] =
+            response.content_items.as_slice()
+        else {
+            return Err(invalid());
+        };
+        let result: ApplyPatchResult = serde_json::from_str(text).unwrap_or_else(|_| ApplyPatchResult {
+            status: if response.success { ApplyPatchStatus::Completed } else { ApplyPatchStatus::Failed },
+            output: Some(text.clone()),
+        });
+        if response.success != (result.status == ApplyPatchStatus::Completed) {
+            return Err(invalid());
+        }
+        Ok(Self { result })
+    }
+}
+impl ToolOutput for ApplyPatchToolOutput {
+    fn log_output(&self) -> String {
+        self.result.output.clone().unwrap_or_default()
+    }
+    fn success_for_logging(&self) -> bool {
+        self.result.status == ApplyPatchStatus::Completed
+    }
+    fn contains_external_context(&self) -> bool {
+        true
+    }
+    fn to_response_item(&self, call_id: &str, _payload: &ToolPayload) -> ResponseInputItem {
+        ResponseInputItem::ApplyPatchCallOutput {
+            call_id: call_id.to_owned(),
+            status: self.result.status,
+            output: self.result.output.clone(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    #[test]
+    fn operation_paths_remain_application_owned_and_malformed_operations_are_rejected() {
+        let call = json!({"type":"apply_patch_call","call_id":"patch-1","operation":{"type":"update_file","path":"virtual://workspace/custom/path","diff":"@@\n-a\n+b","move_to":"tenant://other/path"}});
+        assert!(validate_apply_patch_call(&call).is_ok());
+        for operation in [
+            json!({"type":"update_file","path":"x","diff":17}),
+            json!({"type":"update_file","path":"x","diff":"d","move_to":""}),
+            json!({"type":"delete_file","path":null}),
+            json!({"type":"unknown","path":"x"}),
+        ] {
+            let mut invalid = call.clone();
+            invalid["operation"] = operation;
+            assert!(validate_apply_patch_call(&invalid).is_err());
+        }
+    }
+    #[test]
+    fn ordinary_policy_error_text_keeps_failed_typed_disposition() {
+        let arguments=serde_json::json!({"type":"apply_patch_call","call_id":"p1","operation":{"type":"delete_file","path":"custom"}}).to_string();
+        let output=ApplyPatchToolOutput::from_dynamic_response(&arguments,DynamicToolResponse { success:false, content_items:vec![DynamicToolCallOutputContentItem::InputText { text:"policy refused".into() }] }).unwrap();
+        assert!(matches!(output.to_response_item("p1",&ToolPayload::ApplyPatch { arguments }),ResponseInputItem::ApplyPatchCallOutput { status:ApplyPatchStatus::Failed, output:Some(text), .. } if text=="policy refused"));
+    }
+    #[test]
+    fn typed_result_retains_status_text_and_native_call_identity() {
+        let call=json!({"type":"apply_patch_call","call_id":"patch-1","operation":{"type":"delete_file","path":"application-owned-path"}}).to_string();
+        for (status, success) in [("completed", true), ("failed", false)] {
+            let response = DynamicToolResponse {
+                success,
+                content_items: vec![DynamicToolCallOutputContentItem::InputText {
+                    text: json!({"status":status,"output":"exact result"}).to_string(),
+                }],
+            };
+            let output = ApplyPatchToolOutput::from_dynamic_response(&call, response).unwrap();
+            let item = serde_json::to_value(output.to_response_item(
+                "patch-1",
+                &ToolPayload::ApplyPatch {
+                    arguments: call.clone(),
+                },
+            ))
+            .unwrap();
+            assert_eq!(
+                item,
+                json!({"type":"apply_patch_call_output","call_id":"patch-1","status":status,"output":"exact result"})
+            );
+        }
+    }
+}
