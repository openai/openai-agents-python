diff --git a/codex-rs/protocol/src/prompt_cache.rs b/codex-rs/protocol/src/prompt_cache.rs
new file mode 100644
index 00000000..da9f0d04
--- /dev/null
+++ b/codex-rs/protocol/src/prompt_cache.rs
@@ -0,0 +1,468 @@
+//! Content cache annotations, separate from canonical content and tool authority.
+use crate::model_request_controls::PromptCacheMode;
+use crate::models::ContentItem;
+use crate::models::ResponseItem;
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use ts_rs::TS;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct PromptCacheBreakpoint {
+    pub mode: PromptCacheMode,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+pub struct PromptCacheUserInput {
+    #[serde(flatten)]
+    pub input: crate::user_input::UserInput,
+    #[serde(default, deserialize_with = "present_breakpoint")]
+    pub prompt_cache_breakpoint: Option<PromptCacheBreakpoint>,
+}
+
+fn present_breakpoint<'de, D: serde::Deserializer<'de>>(
+    deserializer: D,
+) -> Result<Option<PromptCacheBreakpoint>, D::Error> {
+    PromptCacheBreakpoint::deserialize(deserializer).map(Some)
+}
+
+pub fn split_user_input(
+    input: Vec<PromptCacheUserInput>,
+) -> (Vec<crate::user_input::UserInput>, Vec<InputCacheBreakpoint>) {
+    let mut content = Vec::with_capacity(input.len());
+    let mut breakpoints = Vec::new();
+    for (input_index, part) in input.into_iter().enumerate() {
+        if let Some(breakpoint) = part.prompt_cache_breakpoint {
+            breakpoints.push(InputCacheBreakpoint {
+                input_index,
+                breakpoint,
+            });
+        }
+        content.push(part.input);
+    }
+    (content, breakpoints)
+}
+
+/// Fresh canonical-history input; annotations remain data beside the typed projection.
+pub fn response_breakpoints(
+    raw: &str,
+) -> Result<Vec<(usize, PromptCacheBreakpoint)>, serde_json::Error> {
+    if !raw.contains("prompt_cache_breakpoint") {
+        return Ok(Vec::new());
+    }
+    let value: serde_json::Value = serde_json::from_str(raw)?;
+    if value.get("type").and_then(serde_json::Value::as_str) != Some("message") {
+        return Ok(Vec::new());
+    }
+    let Some(content) = value.get("content").and_then(serde_json::Value::as_array) else {
+        return Ok(Vec::new());
+    };
+    content
+        .iter()
+        .enumerate()
+        .filter_map(|(index, part)| {
+            part.get("prompt_cache_breakpoint").map(|marker| {
+                serde_json::from_value(marker.clone()).map(|breakpoint| (index, breakpoint))
+            })
+        })
+        .collect()
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct InputCacheBreakpoint {
+    pub input_index: usize,
+    pub breakpoint: PromptCacheBreakpoint,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct BoundCacheBreakpoint {
+    pub content_index: usize,
+    pub content_sha256: String,
+    pub breakpoint: PromptCacheBreakpoint,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct PromptCacheAnnotation {
+    pub occurrence: String,
+    pub parts: Vec<BoundCacheBreakpoint>,
+}
+
+/// Annotation-only refusal; underlying content and request policy remain available.
+#[derive(Debug, PartialEq)]
+pub enum PromptCacheProjection {
+    Annotated(serde_json::Value),
+    Refused,
+}
+
+pub fn content_fingerprint(content: &ContentItem) -> Result<String, serde_json::Error> {
+    Ok(format!(
+        "{:x}",
+        Sha256::digest(serde_json::to_vec(content)?)
+    ))
+}
+
+impl PromptCacheAnnotation {
+    pub fn bind(
+        occurrence: String,
+        content: &[ContentItem],
+        breakpoints: &[(usize, PromptCacheBreakpoint)],
+    ) -> Result<Option<Self>, serde_json::Error> {
+        if occurrence.is_empty()
+            || breakpoints.is_empty()
+            || breakpoints.iter().any(|(index, _)| *index >= content.len())
+            || breakpoints
+                .iter()
+                .enumerate()
+                .any(|(at, (index, _))| breakpoints[..at].iter().any(|(prior, _)| prior == index))
+        {
+            return Ok(None);
+        }
+        let parts = breakpoints
+            .iter()
+            .map(|(index, breakpoint)| {
+                Ok(BoundCacheBreakpoint {
+                    content_index: *index,
+                    content_sha256: content_fingerprint(&content[*index])?,
+                    breakpoint: *breakpoint,
+                })
+            })
+            .collect::<Result<Vec<_>, serde_json::Error>>()?;
+        Ok(Some(Self { occurrence, parts }))
+    }
+
+    /// An explicit source-to-prepared map, without content searches or inferred anchors.
+    pub fn after_preparation(
+        &self,
+        occurrence: &str,
+        original: &[ContentItem],
+        prepared: &[ContentItem],
+        destinations: &[(usize, usize)],
+    ) -> Result<Option<Self>, serde_json::Error> {
+        if occurrence != self.occurrence || occurrence.is_empty() {
+            return Ok(None);
+        }
+        let mut breakpoints = Vec::new();
+        for part in &self.parts {
+            let Some(source) = original.get(part.content_index) else {
+                return Ok(None);
+            };
+            if content_fingerprint(source)? != part.content_sha256 {
+                return Ok(None);
+            }
+            let mut matches = destinations
+                .iter()
+                .filter(|(from, _)| *from == part.content_index);
+            let Some((_, target)) = matches.next() else {
+                return Ok(None);
+            };
+            let Some(prepared_part) = prepared.get(*target) else {
+                return Ok(None);
+            };
+            if matches.next().is_some() {
+                return Ok(None);
+            }
+            let same_prepared_content = match (source, prepared_part) {
+                (ContentItem::InputImage { .. }, ContentItem::InputImage { .. }) => true,
+                _ => source == prepared_part,
+            };
+            if !same_prepared_content {
+                return Ok(None);
+            }
+            if *target != part.content_index {
+                let repeated_source = original.iter().filter(|item| *item == source).count() > 1;
+                let repeated_target = prepared
+                    .iter()
+                    .filter(|item| *item == prepared_part)
+                    .count()
+                    > 1;
+                if repeated_source || repeated_target {
+                    return Ok(None);
+                }
+            }
+            breakpoints.push((*target, part.breakpoint));
+        }
+        Self::bind(self.occurrence.clone(), prepared, &breakpoints)
+    }
+
+    pub fn project(
+        &self,
+        occurrence: &str,
+        item: &ResponseItem,
+    ) -> Result<PromptCacheProjection, serde_json::Error> {
+        let ResponseItem::Message { content, .. } = item else {
+            return Ok(PromptCacheProjection::Refused);
+        };
+        if occurrence != self.occurrence || occurrence.is_empty() {
+            return Ok(PromptCacheProjection::Refused);
+        }
+        for (at, binding) in self.parts.iter().enumerate() {
+            let Some(part) = content.get(binding.content_index) else {
+                return Ok(PromptCacheProjection::Refused);
+            };
+            if matches!(part, ContentItem::OutputText { .. })
+                || self.parts[..at]
+                    .iter()
+                    .any(|prior| prior.content_index == binding.content_index)
+                || content_fingerprint(part)? != binding.content_sha256
+            {
+                return Ok(PromptCacheProjection::Refused);
+            }
+        }
+        let mut wire = serde_json::to_value(item)?;
+        for binding in &self.parts {
+            // ResponseItem::Message fixes this shape; validation above fixes every index.
+            wire["content"][binding.content_index]["prompt_cache_breakpoint"] =
+                serde_json::to_value(binding.breakpoint)?;
+        }
+        Ok(PromptCacheProjection::Annotated(wire))
+    }
+}
+
+/// The caller owns an in-place preparation step; item identities and part counts remain fixed.
+pub fn after_in_place_item_preparation(
+    annotations: &[PromptCacheAnnotation],
+    original: &[ResponseItem],
+    prepared: &[ResponseItem],
+) -> Vec<PromptCacheAnnotation> {
+    annotations
+        .iter()
+        .filter_map(|annotation| {
+            if annotations
+                .iter()
+                .filter(|other| other.occurrence == annotation.occurrence)
+                .count()
+                != 1
+            {
+                return None;
+            }
+            let same_occurrence = |item: &&ResponseItem| {
+                item.id()
+                    .is_some_and(|id| id.to_string() == annotation.occurrence)
+            };
+            let mut sources = original.iter().filter(same_occurrence);
+            let source = sources.next()?;
+            if sources.next().is_some() {
+                return None;
+            }
+            let mut targets = prepared.iter().filter(same_occurrence);
+            let target = targets.next()?;
+            if targets.next().is_some() {
+                return None;
+            }
+            let (
+                ResponseItem::Message {
+                    content: source, ..
+                },
+                ResponseItem::Message {
+                    content: target, ..
+                },
+            ) = (source, target)
+            else {
+                return None;
+            };
+            if source.len() != target.len() {
+                return None;
+            }
+            let destinations = (0..source.len())
+                .map(|index| (index, index))
+                .collect::<Vec<_>>();
+            annotation
+                .after_preparation(&annotation.occurrence, source, target, &destinations)
+                .ok()
+                .flatten()
+        })
+        .collect()
+}
