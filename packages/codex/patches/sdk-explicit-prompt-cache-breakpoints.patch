+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn item(parts: serde_json::Value) -> ResponseItem {
+        serde_json::from_value(json!({"type":"message", "role":"user", "content":parts})).unwrap()
+    }
+    fn marker() -> PromptCacheBreakpoint {
+        PromptCacheBreakpoint {
+            mode: PromptCacheMode::Explicit,
+        }
+    }
+    fn bind(occurrence: &str, item: &ResponseItem, index: usize) -> PromptCacheAnnotation {
+        let ResponseItem::Message { content, .. } = item else {
+            panic!()
+        };
+        PromptCacheAnnotation::bind(occurrence.into(), content, &[(index, marker())])
+            .unwrap()
+            .unwrap()
+    }
+
+    #[test]
+    fn portable_binding_preserves_canonical_content_and_exact_occurrence() {
+        let original = item(json!([
+            {"type":"input_text","text":"first"},
+            {"type":"input_text","text":"second"}
+        ]));
+        let canonical = serde_json::to_value(&original).unwrap();
+        let saved = bind("occurrence-a", &original, 1);
+        let restored: PromptCacheAnnotation =
+            serde_json::from_str(&serde_json::to_string(&saved).unwrap()).unwrap();
+        let PromptCacheProjection::Annotated(wire) =
+            restored.project("occurrence-a", &original).unwrap()
+        else {
+            panic!()
+        };
+        assert_eq!(
+            wire["content"][1]["prompt_cache_breakpoint"],
+            json!({"mode":"explicit"})
+        );
+        assert!(wire["content"][0].get("prompt_cache_breakpoint").is_none());
+        assert_eq!(serde_json::to_value(&original).unwrap(), canonical);
+        assert_eq!(
+            restored.project("occurrence-b", &original).unwrap(),
+            PromptCacheProjection::Refused
+        );
+    }
+
+    #[test]
+    fn reorder_and_changed_payload_refuse_annotation_without_mutating_content() {
+        let original = item(json!([
+            {"type":"input_text","text":"first"},
+            {"type":"input_text","text":"second"}
+        ]));
+        let saved = bind("occurrence-a", &original, 1);
+        for content in [
+            json!([{"type":"input_text","text":"second"},{"type":"input_text","text":"first"}]),
+            json!([{"type":"input_text","text":"first"},{"type":"input_text","text":"changed"}]),
+        ] {
+            let changed = item(content);
+            let before = serde_json::to_value(&changed).unwrap();
+            assert_eq!(
+                saved.project("occurrence-a", &changed).unwrap(),
+                PromptCacheProjection::Refused
+            );
+            assert_eq!(serde_json::to_value(&changed).unwrap(), before);
+        }
+    }
+
+    #[test]
+    fn duplicate_content_keeps_exact_part_anchor() {
+        let repeated = item(json!([
+            {"type":"input_text","text":"same"},
+            {"type":"input_text","text":"same"}
+        ]));
+        let saved = bind("occurrence-a", &repeated, 1);
+        let PromptCacheProjection::Annotated(wire) =
+            saved.project("occurrence-a", &repeated).unwrap()
+        else {
+            panic!()
+        };
+        assert!(wire["content"][0].get("prompt_cache_breakpoint").is_none());
+        assert_eq!(
+            wire["content"][1]["prompt_cache_breakpoint"],
+            json!({"mode":"explicit"})
+        );
+    }
+    #[test]
+    fn supported_media_keeps_its_canonical_shape() {
+        for part in [
+            json!({"type":"input_text","text":"<user_instructions>untrusted</user_instructions>"}),
+            json!({"type":"input_image","file_id":"file_synthetic_image"}),
+            json!({"type":"input_audio","audio_url":"data:audio/wav;base64,UklGRg=="}),
+            json!({"type":"input_file","file_id":"file_synthetic_document"}),
+        ] {
+            let original = item(json!([part]));
+            let canonical = serde_json::to_value(&original).unwrap();
+            let binding = bind("occurrence-media", &original, 0);
+            let PromptCacheProjection::Annotated(mut projected) =
+                binding.project("occurrence-media", &original).unwrap()
+            else {
+                panic!()
+            };
+            projected["content"][0]
+                .as_object_mut()
+                .unwrap()
+                .remove("prompt_cache_breakpoint");
+            assert_eq!(projected, canonical);
+        }
+    }
+
+    #[test]
+    fn explicit_reorder_map_preserves_unique_occurrence_without_guessing() {
+        let original = item(
+            json!([{"type":"input_text","text":"first"},{"type":"input_text","text":"second"}]),
+        );
+        let prepared = item(
+            json!([{"type":"input_text","text":"second"},{"type":"input_text","text":"first"}]),
+        );
+        let binding = bind("occurrence-a", &original, 1);
+        let ResponseItem::Message {
+            content: source, ..
+        } = &original
+        else {
+            panic!()
+        };
+        let ResponseItem::Message {
+            content: target, ..
+        } = &prepared
+        else {
+            panic!()
+        };
+        let mapped = binding
+            .after_preparation("occurrence-a", source, target, &[(1, 0)])
+            .unwrap()
+            .unwrap();
+        let PromptCacheProjection::Annotated(projected) =
+            mapped.project("occurrence-a", &prepared).unwrap()
+        else {
+            panic!()
+        };
+        assert_eq!(
+            projected["content"][0]["prompt_cache_breakpoint"],
+            json!({"mode":"explicit"})
+        );
+        assert!(
+            projected["content"][1]
+                .get("prompt_cache_breakpoint")
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn ambiguous_update_refuses_only_annotation_and_preserves_original_anchor() {
+        let repeated =
+            item(json!([{"type":"input_text","text":"same"},{"type":"input_text","text":"same"}]));
+        let binding = bind("occurrence-a", &repeated, 1);
+        let before = binding.clone();
+        let ResponseItem::Message { content, .. } = &repeated else {
+            panic!()
+        };
+        assert!(
+            binding
+                .after_preparation("occurrence-a", content, content, &[(1, 0)])
+                .unwrap()
+                .is_none()
+        );
+        assert_eq!(binding, before);
+        assert_eq!(
+            serde_json::to_value(&repeated).unwrap()["content"],
+            json!([{"type":"input_text","text":"same"},{"type":"input_text","text":"same"}])
+        );
+    }
+
+    #[test]
+    fn invalid_breakpoint_shape_has_no_annotation() {
+        assert!(
+            serde_json::from_value::<PromptCacheBreakpoint>(json!({"mode":"invalid"})).is_err()
+        );
+        assert!(
+            serde_json::from_value::<PromptCacheBreakpoint>(
+                json!({"mode":"explicit","extra":true})
+            )
+            .is_err()
+        );
+    }
+}
