diff --git a/codex-rs/codex-api/src/request_input.rs b/codex-rs/codex-api/src/request_input.rs
new file mode 100644
index 00000000..f1a4945f
--- /dev/null
+++ b/codex-rs/codex-api/src/request_input.rs
@@ -0,0 +1,213 @@
+//! Request-only cache annotation projection; canonical content retains its existing representation.
+use codex_protocol::models::ResponseItem;
+use codex_protocol::prompt_cache::{PromptCacheAnnotation, PromptCacheProjection};
+use serde::Serialize;
+use serde::ser::SerializeSeq;
+use std::collections::BTreeMap;
+use std::ops::{Deref, DerefMut};
+use std::sync::Arc;
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct CacheAnnotatedInput<T> {
+    items: T,
+    annotations: Arc<Vec<PromptCacheAnnotation>>,
+}
+
+impl<T> CacheAnnotatedInput<T> {
+    pub fn with_annotations(items: T, annotations: Vec<PromptCacheAnnotation>) -> Self {
+        Self {
+            items,
+            annotations: Arc::new(annotations),
+        }
+    }
+
+    pub fn with_items<U>(&self, items: U) -> CacheAnnotatedInput<U> {
+        CacheAnnotatedInput {
+            items,
+            annotations: self.annotations.clone(),
+        }
+    }
+
+    pub fn borrow_with<'a>(
+        &self,
+        items: &'a [ResponseItem],
+    ) -> CacheAnnotatedInput<&'a [ResponseItem]> {
+        CacheAnnotatedInput {
+            items,
+            annotations: self.annotations.clone(),
+        }
+    }
+}
+
+impl From<Vec<ResponseItem>> for CacheAnnotatedInput<Vec<ResponseItem>> {
+    fn from(items: Vec<ResponseItem>) -> Self {
+        Self::with_annotations(items, Vec::new())
+    }
+}
+
+impl<'a> From<&'a [ResponseItem]> for CacheAnnotatedInput<&'a [ResponseItem]> {
+    fn from(items: &'a [ResponseItem]) -> Self {
+        Self::with_annotations(items, Vec::new())
+    }
+}
+
+impl<'a> From<&'a Vec<ResponseItem>> for CacheAnnotatedInput<&'a [ResponseItem]> {
+    fn from(items: &'a Vec<ResponseItem>) -> Self {
+        Self::from(items.as_slice())
+    }
+}
+
+impl<'a, const N: usize> From<&'a [ResponseItem; N]> for CacheAnnotatedInput<&'a [ResponseItem]> {
+    fn from(items: &'a [ResponseItem; N]) -> Self {
+        Self::from(items.as_slice())
+    }
+}
+
+impl Default for CacheAnnotatedInput<Vec<ResponseItem>> {
+    fn default() -> Self {
+        Vec::new().into()
+    }
+}
+
+impl<T> Deref for CacheAnnotatedInput<T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        &self.items
+    }
+}
+
+impl<T> DerefMut for CacheAnnotatedInput<T> {
+    fn deref_mut(&mut self) -> &mut T {
+        &mut self.items
+    }
+}
+
+impl<T: AsRef<[ResponseItem]>> AsRef<[ResponseItem]> for CacheAnnotatedInput<T> {
+    fn as_ref(&self) -> &[ResponseItem] {
+        self.items.as_ref()
+    }
+}
+
+impl<T: AsRef<[ResponseItem]> + Serialize> Serialize for CacheAnnotatedInput<T> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        if self.annotations.is_empty() {
+            return self.items.serialize(serializer);
+        }
+        let mut annotations = BTreeMap::<&str, Option<&PromptCacheAnnotation>>::new();
+        for annotation in self.annotations.iter() {
+            annotations
+                .entry(&annotation.occurrence)
+                .and_modify(|value| *value = None)
+                .or_insert(Some(annotation));
+        }
+        let mut occurrences = BTreeMap::<String, usize>::new();
+        for item in self.items.as_ref() {
+            if let Some(id) = item.id() {
+                *occurrences.entry(id.to_string()).or_default() += 1;
+            }
+        }
+        let mut seq = serializer.serialize_seq(Some(self.items.as_ref().len()))?;
+        for item in self.items.as_ref() {
+            let occurrence = item.id().map(ToString::to_string);
+            let annotation = occurrence
+                .as_ref()
+                .and_then(|id| {
+                    (occurrences.get(id) == Some(&1))
+                        .then(|| annotations.get(id.as_str()))
+                        .flatten()
+                })
+                .and_then(|annotation| *annotation);
+            if let Some(annotation) = annotation.filter(|annotation| !annotation.parts.is_empty()) {
+                match annotation
+                    .project(&annotation.occurrence, item)
+                    .map_err(serde::ser::Error::custom)?
+                {
+                    PromptCacheProjection::Annotated(wire) => {
+                        seq.serialize_element(&wire)?;
+                        continue;
+                    }
+                    PromptCacheProjection::Refused => {}
+                }
+            }
+            // Refused annotations have been leaving the canonical payload untouched.
+            seq.serialize_element(item)?;
+        }
+        seq.end()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::model_request_controls::PromptCacheMode;
+    use codex_protocol::models::ContentItem;
+    use codex_protocol::prompt_cache::PromptCacheBreakpoint;
+    use serde_json::json;
+
+    fn input(id: &str, text: &str) -> ResponseItem {
+        serde_json::from_value(json!({"type":"message","id":id,"role":"user","content":[{"type":"input_text","text":text}]})).unwrap()
+    }
+    fn annotation(item: &ResponseItem) -> PromptCacheAnnotation {
+        let ResponseItem::Message { content, .. } = item else {
+            panic!()
+        };
+        assert!(matches!(&content[0], ContentItem::InputText { .. }));
+        PromptCacheAnnotation::bind(
+            item.id().unwrap().to_string(),
+            content,
+            &[(
+                0,
+                PromptCacheBreakpoint {
+                    mode: PromptCacheMode::Explicit,
+                },
+            )],
+        )
+        .unwrap()
+        .unwrap()
+    }
+
+    #[test]
+    fn owned_and_websocket_views_keep_occurrence_across_reorder() {
+        let first = input("msg_first", "first");
+        let second = input("msg_second", "second");
+        let cached = annotation(&first);
+        let mut owned = CacheAnnotatedInput::with_annotations(vec![first, second], vec![cached]);
+        owned.swap(0, 1);
+        let wire = serde_json::to_value(&owned).unwrap();
+        assert!(
+            wire[0]["content"][0]
+                .get("prompt_cache_breakpoint")
+                .is_none()
+        );
+        assert_eq!(
+            wire[1]["content"][0]["prompt_cache_breakpoint"],
+            json!({"mode":"explicit"})
+        );
+        assert_eq!(
+            serde_json::to_value(owned.borrow_with(&owned[1..])).unwrap(),
+            json!([wire[1]])
+        );
+    }
+
+    #[test]
+    fn duplicated_occurrence_refuses_only_its_annotation() {
+        let item = input("msg_duplicate", "same");
+        let cached = annotation(&item);
+        let input =
+            CacheAnnotatedInput::with_annotations(vec![item.clone(), item.clone()], vec![cached]);
+        assert_eq!(
+            serde_json::to_value(input).unwrap(),
+            serde_json::to_value(vec![item.clone(), item]).unwrap()
+        );
+    }
+
+    #[test]
+    fn ordinary_input_has_identical_serialization() {
+        let items = vec![input("msg_plain", "plain")];
+        let expected = serde_json::to_string(&items).unwrap();
+        assert_eq!(
+            serde_json::to_string(&CacheAnnotatedInput::from(items)).unwrap(),
+            expected
+        );
+    }
+}
