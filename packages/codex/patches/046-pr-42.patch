--- /dev/null
+++ b/codex-rs/core/src/session/original_history_stream.rs
@@ -0,0 +1,453 @@
+//! Selective local JSONL source. Replacement catalogs never become a whole line or Vec.
+use super::{Action, Entry, FoldWriter, OriginalSource, Position, Scan, SnapshotReader, invalid};
+use codex_history::ResponseItemEnvelope;
+use codex_history::sdk_originals::SdkOriginalSnapshotFold;
+use codex_thread_store::OriginalHistorySegment;
+use std::fs::File;
+use std::io::{self, BufReader, Read, Seek, SeekFrom};
+
+#[path = "original_history_cursor.rs"]
+mod cursor;
+use cursor::{Cursor, Span};
+
+struct Prefix {
+    file: File,
+    end: u64,
+}
+impl Read for Prefix {
+    fn read(&mut self, output: &mut [u8]) -> io::Result<usize> {
+        let left = self.end.saturating_sub(self.file.stream_position()?);
+        let count = output
+            .len()
+            .min(usize::try_from(left).unwrap_or(usize::MAX));
+        self.file.read(&mut output[..count])
+    }
+}
+impl Seek for Prefix {
+    fn seek(&mut self, from: SeekFrom) -> io::Result<u64> {
+        let target = match from {
+            SeekFrom::Start(value) => value,
+            SeekFrom::Current(delta) => self
+                .file
+                .stream_position()?
+                .checked_add_signed(delta)
+                .ok_or_else(invalid)?,
+            SeekFrom::End(delta) => self.end.checked_add_signed(delta).ok_or_else(invalid)?,
+        };
+        if target > self.end {
+            return Err(invalid());
+        }
+        self.file.seek(SeekFrom::Start(target))
+    }
+}
+type Input = Cursor<BufReader<Prefix>>;
+#[derive(Clone, Copy)]
+struct Array {
+    segment: usize,
+    next: u64,
+    first: bool,
+    legacy: bool,
+}
+struct Frame {
+    kind: Option<String>,
+    payload: Option<Span>,
+    metadata: Option<Span>,
+    end: u64,
+}
+
+pub(super) struct LocalSource<'a> {
+    segments: &'a [OriginalHistorySegment],
+    segment: usize,
+    next_record: u64,
+    array: Option<Array>,
+    input: Option<(usize, Input)>,
+    generation: (usize, u64, Option<Array>),
+}
+impl<'a> LocalSource<'a> {
+    pub(super) fn new(segments: &'a [OriginalHistorySegment]) -> Self {
+        Self {
+            segments,
+            segment: 0,
+            next_record: 0,
+            array: None,
+            input: None,
+            generation: (0, 0, None),
+        }
+    }
+    fn cursor(&mut self, segment: usize, position: u64) -> io::Result<&mut Input> {
+        if self.input.as_ref().map(|(index, _)| *index) != Some(segment) {
+            let source = self.segments.get(segment).ok_or_else(invalid)?;
+            let file = codex_rollout::open_rollout_seekable_reader(&source.rollout_path)?;
+            if file.metadata()?.len() < source.end_byte_offset {
+                return Err(invalid());
+            }
+            self.input = Some((
+                segment,
+                Cursor::new(BufReader::with_capacity(
+                    16 * 1024,
+                    Prefix {
+                        file,
+                        end: source.end_byte_offset,
+                    },
+                )),
+            ));
+        }
+        let (_, input) = self.input.as_mut().unwrap();
+        input.seek(position)?;
+        Ok(input)
+    }
+    fn frame(&mut self, segment: usize, position: u64) -> io::Result<Frame> {
+        let input = self.cursor(segment, position)?;
+        let mut kind = None;
+        let mut payload = None;
+        let mut metadata = None;
+        input.object(|key, input| {
+            match key {
+                Some("type") => {
+                    if kind.is_some() {
+                        return Err(invalid());
+                    }
+                    kind = input.small_string()?;
+                }
+                Some("payload") => {
+                    if payload.is_some() {
+                        return Err(invalid());
+                    }
+                    payload = Some(input.skip()?);
+                }
+                Some("metadata") => {
+                    if metadata.is_some() {
+                        return Err(invalid());
+                    }
+                    metadata = Some(input.skip()?);
+                }
+                _ => {
+                    input.skip()?;
+                }
+            }
+            Ok(())
+        })?;
+        Ok(Frame {
+            kind,
+            payload,
+            metadata,
+            end: input.line_end()?,
+        })
+    }
+    fn native(
+        &mut self,
+        position: Position,
+        reader: &SnapshotReader,
+    ) -> io::Result<ResponseItemEnvelope> {
+        let segment = usize::try_from(position.record).map_err(|_| invalid())?;
+        let frame = self.frame(segment, position.item)?;
+        if frame.kind.as_deref() != Some("response_item") {
+            return Err(invalid());
+        }
+        let payload_span = frame.payload.ok_or_else(invalid)?;
+        if let Some(max_bytes) = reader.max_bytes {
+            let span_len = |span: Span| span.end.checked_sub(span.start).ok_or_else(invalid);
+            let decode_bytes = span_len(payload_span)?
+                .checked_add(frame.metadata.map(span_len).transpose()?.unwrap_or(0))
+                .ok_or(io::ErrorKind::FileTooLarge)?;
+            if decode_bytes > max_bytes as u64 {
+                return Err(io::ErrorKind::FileTooLarge.into());
+            }
+        }
+        let payload = self
+            .cursor(segment, payload_span.start)?
+            .value::<serde_json::Value>()?;
+        let mut value = serde_json::Map::new();
+        value.insert("type".into(), "response_item".into());
+        value.insert("payload".into(), payload);
+        if let Some(metadata) = frame.metadata {
+            value.insert(
+                "metadata".into(),
+                self.cursor(segment, metadata.start)?.value()?,
+            );
+        }
+        // Reuse the canonical RolloutItem decoder, including its persisted response normalization.
+        match serde_json::from_value::<codex_history::RolloutItem>(serde_json::Value::Object(value))
+            .map_err(|_| invalid())?
+        {
+            codex_history::RolloutItem::ResponseItem(row) => Ok(row),
+            _ => Err(invalid()),
+        }
+    }
+    fn envelope(
+        &mut self,
+        position: Position,
+        reader: &SnapshotReader,
+    ) -> io::Result<Option<ResponseItemEnvelope>> {
+        let input = self.cursor(position.record as usize, position.item)?;
+        if let Some(max) = reader.max_bytes {
+            let span = input.skip()?;
+            if span.end.checked_sub(span.start).ok_or_else(invalid)? > max as u64 {
+                return Err(io::ErrorKind::FileTooLarge.into());
+            }
+            input.seek(span.start)?;
+        }
+        let value = input.value::<serde_json::Value>()?;
+        serde_json::from_value(value).map_err(|_| invalid())
+    }
+    fn array(&mut self, segment: usize, start: u64, legacy: bool) -> io::Result<()> {
+        let input = self.cursor(segment, start)?;
+        input.begin_array()?;
+        let next = input.position()?;
+        self.array = Some(Array {
+            segment,
+            next,
+            first: true,
+            legacy,
+        });
+        Ok(())
+    }
+    fn compacted(&mut self, segment: usize, payload: Span) -> io::Result<Option<Action>> {
+        let input = self.cursor(segment, payload.start)?;
+        let mut originals = None;
+        let mut replacement = None;
+        input.object(|key, input| {
+            match key {
+                Some("sdk_originals") => {
+                    if originals.is_some() {
+                        return Err(invalid());
+                    }
+                    originals = Some(input.skip()?);
+                }
+                Some("replacement_history") => {
+                    if replacement.is_some() {
+                        return Err(invalid());
+                    }
+                    replacement = Some(input.skip()?);
+                }
+                _ => {
+                    input.skip()?;
+                }
+            }
+            Ok(())
+        })?;
+        if let Some(originals) = originals {
+            let input = self.cursor(segment, originals.start)?;
+            if input.peek_value()? != Some(b'n') {
+                let mut preserve = None;
+                let mut version = None;
+                let mut items = None;
+                input.object(|key, input| {
+                    match key {
+                        Some("preserve") => {
+                            if preserve.is_some() {
+                                return Err(invalid());
+                            }
+                            preserve = Some(input.value::<bool>()?);
+                        }
+                        Some("format_version") => {
+                            if version.is_some() {
+                                return Err(invalid());
+                            }
+                            version = Some(input.unsigned()?);
+                        }
+                        Some("items") => {
+                            if items.is_some() {
+                                return Err(invalid());
+                            }
+                            items = Some(input.skip()?);
+                        }
+                        _ => {
+                            input.skip()?;
+                        }
+                    }
+                    Ok(())
+                })?;
+                if preserve == Some(true) && version.is_none() && items.is_none() {
+                    return Ok(None);
+                }
+                if preserve.is_some() || version != Some(1) {
+                    return Err(invalid());
+                }
+                self.array(segment, items.ok_or_else(invalid)?.start, false)?;
+                return Ok(Some(Action::Reset));
+            }
+        }
+        if let Some(replacement) = replacement {
+            if self.cursor(segment, replacement.start)?.peek_value()? != Some(b'n') {
+                self.array(segment, replacement.start, true)?;
+                return Ok(Some(Action::Reset));
+            }
+        }
+        Ok(None)
+    }
+}
+impl OriginalSource for LocalSource<'_> {
+    fn mark_generation(&mut self) {
+        self.generation = (self.segment, self.next_record, self.array);
+    }
+    fn rewind(&mut self) -> io::Result<()> {
+        (self.segment, self.next_record, self.array) = self.generation;
+        Ok(())
+    }
+    fn next(&mut self, reader: &SnapshotReader, scan: Scan) -> io::Result<Option<Action>> {
+        loop {
+            if let Some(mut array) = self.array.take().filter(|_| scan == Scan::Entries) {
+                let input = self.cursor(array.segment, array.next)?;
+                let Some(item) = input.next_array(array.first)? else {
+                    continue;
+                };
+                array.first = false;
+                array.next = input.position()?;
+                self.array = Some(array);
+                if array.legacy {
+                    let position = Position {
+                        kind: 13,
+                        record: array.segment as u64,
+                        item: item.start,
+                    };
+                    let row = self.envelope(position, reader)?.ok_or_else(invalid)?;
+                    if !crate::context_manager::is_api_message(&row.item, row.metadata.as_ref()) {
+                        continue;
+                    }
+                    return Ok(Some(Action::Append(Entry {
+                        original: position,
+                        projection: position,
+                        ..Default::default()
+                    })));
+                }
+                let input = self.cursor(array.segment, item.start)?;
+                let mut original = None;
+                let mut projection = None;
+                input.object(|key, input| {
+                    match key {
+                        Some("original") => {
+                            if original.is_some() || input.peek_value()? != Some(b'"') {
+                                return Err(invalid());
+                            }
+                            original = Some(input.skip()?);
+                        }
+                        Some("projection") => {
+                            if projection.is_some() {
+                                return Err(invalid());
+                            }
+                            let present = input.peek_value()? != Some(b'n');
+                            let span = input.skip()?;
+                            projection = Some((present, span));
+                        }
+                        _ => {
+                            input.skip()?;
+                        }
+                    }
+                    Ok(())
+                })?;
+                let original = Position {
+                    kind: 11,
+                    record: array.segment as u64,
+                    item: original.ok_or_else(invalid)?.start,
+                };
+                let projection = projection
+                    .filter(|(present, _)| *present)
+                    .map(|(_, span)| Position {
+                        kind: 12,
+                        record: array.segment as u64,
+                        item: span.start,
+                    })
+                    .unwrap_or_default();
+                return Ok(Some(Action::Append(Entry {
+                    original,
+                    projection,
+                    ..Default::default()
+                })));
+            }
+            if self.segment >= self.segments.len() {
+                return Ok(None);
+            }
+            let segment = self.segment;
+            let position = self.next_record;
+            if self.cursor(segment, position)?.eof()? {
+                self.segment += 1;
+                self.next_record = 0;
+                continue;
+            }
+            let frame = self.frame(segment, position)?;
+            self.next_record = frame.end;
+            match frame.kind.as_deref() {
+                Some("response_item") if scan == Scan::Entries => {
+                    let position = Position {
+                        kind: 10,
+                        record: segment as u64,
+                        item: position,
+                    };
+                    let row = self.native(position, reader)?;
+                    if crate::context_manager::is_api_message(&row.item, row.metadata.as_ref()) {
+                        return Ok(Some(Action::Append(Entry {
+                            original: position,
+                            projection: position,
+                            ..Default::default()
+                        })));
+                    }
+                }
+                Some("compacted") => {
+                    if let Some(action) =
+                        self.compacted(segment, frame.payload.ok_or_else(invalid)?)?
+                    {
+                        return Ok(Some(action));
+                    }
+                }
+                Some("event_msg") => {
+                    let input = self.cursor(segment, frame.payload.ok_or_else(invalid)?.start)?;
+                    let mut kind = None;
+                    let mut turns = None;
+                    input.object(|key, input| {
+                        match key {
+                            Some("type") => kind = input.small_string()?,
+                            Some("num_turns") => turns = Some(input.skip()?),
+                            _ => {
+                                input.skip()?;
+                            }
+                        }
+                        Ok(())
+                    })?;
+                    if kind.as_deref() == Some("thread_rolled_back") {
+                        let turns = self
+                            .cursor(segment, turns.ok_or_else(invalid)?.start)?
+                            .value::<u32>()?;
+                        return Ok(Some(Action::Rollback(turns)));
+                    }
+                }
+                Some(_) => {}
+                None => return Err(invalid()),
+            }
+        }
+    }
+    fn projection(
+        &mut self,
+        position: Position,
+        reader: &SnapshotReader,
+    ) -> io::Result<Option<ResponseItemEnvelope>> {
+        match position.kind {
+            10 => Ok(reader.native_projection(&self.native(position, reader)?)),
+            12 => self.envelope(position, reader),
+            13 => Ok(self
+                .envelope(position, reader)?
+                .and_then(|row| reader.native_projection(&row))),
+            _ => Err(invalid()),
+        }
+    }
+    fn original(
+        &mut self,
+        position: Position,
+        reader: &SnapshotReader,
+        fold: &mut SdkOriginalSnapshotFold,
+    ) -> io::Result<()> {
+        match position.kind {
+            11 => self
+                .cursor(position.record as usize, position.item)?
+                .string(|bytes| fold.write_item(bytes).map_err(|_| invalid())),
+            10 => serde_json::to_writer(FoldWriter(fold), &self.native(position, reader)?.item)
+                .map_err(|_| invalid()),
+            13 => serde_json::to_writer(
+                FoldWriter(fold),
+                &self.envelope(position, reader)?.ok_or_else(invalid)?.item,
+            )
+            .map_err(|_| invalid()),
+            _ => Err(invalid()),
+        }
+    }
+}
