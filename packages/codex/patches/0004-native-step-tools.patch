+
+struct StepSelector {
+    calls: std::sync::atomic::AtomicUsize,
+    names: Vec<ToolName>,
+}
+
+impl codex_extension_api::ToolContributor for StepSelector {
+    fn tools(
+        &self,
+        _: &codex_extension_api::ExtensionData,
+        _: &codex_extension_api::ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ExtensionToolCall<'call>>>> {
+        Vec::new()
+    }
+
+    fn select_tools_for_step<'a>(
+        &'a self,
+        _: &'a codex_extension_api::ExtensionData,
+        _: &'a codex_extension_api::ExtensionData,
+        _: &'a codex_extension_api::ExtensionData,
+        _: &'a codex_extension_api::ExtensionData,
+        _: &'a [ToolName],
+    ) -> codex_extension_api::ExtensionFuture<'a, Result<Option<Vec<ToolName>>, String>> {
+        Box::pin(async move {
+            self.calls.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            Ok(Some(self.names.clone()))
+        })
+    }
+}
+
+#[tokio::test]
+async fn selected_empty_plan_removes_builtin_runtimes_and_generated_helpers() {
+    let (mut session, mut turn) = make_session_and_context().await;
+    Arc::make_mut(&mut turn.config).update_plan_enabled = true;
+    set_feature(&mut turn, Feature::CodeMode, true);
+    let selector = Arc::new(StepSelector {
+        calls: Default::default(),
+        names: Vec::new(),
+    });
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::default();
+    extensions.tool_contributor(selector.clone());
+    session.services.extensions = Arc::new(extensions.build());
+    let turn = Arc::new(turn);
+    let step = StepContext::for_test(turn);
+    for _ in 0..2 {
+        let router = super::build_tool_router(
+            &session,
+            step.turn.as_ref(),
+            &step.settings.model_info,
+            &step.environments,
+            &step.mcp,
+            false,
+            &step.extension_data,
+            None,
+        )
+        .await
+        .expect("empty selected plan");
+        assert!(router.model_visible_specs().is_empty());
+        for name in ["update_plan", "exec", "wait", "tool_search"] {
+            assert!(!router.exposes_tool(&ToolName::plain(name)), "{name}");
+        }
+    }
+    assert_eq!(selector.calls.load(std::sync::atomic::Ordering::SeqCst), 1);
+}
