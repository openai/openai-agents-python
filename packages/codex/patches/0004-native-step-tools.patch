+    /// Projects only schema-addition metadata for a complete selected catalog.
+    /// Call IDs, arguments, results and stored history remain unchanged.
+    pub(crate) fn project_tool_catalog_item(&self, item: &mut ResponseItem) -> bool {
+        match item {
+            ResponseItem::AdditionalTools { .. } => false,
+            ResponseItem::ToolSearchOutput { tools, .. } => {
+                tools.retain_mut(|spec| {
+                    let Some(name) = spec["name"].as_str().map(str::to_owned) else {
+                        return false;
+                    };
+                    if spec["type"] == "namespace" {
+                        let Some(members) = spec["tools"].as_array_mut() else {
+                            return false;
+                        };
+                        members.retain(|member| {
+                            member["name"].as_str().is_some_and(|leaf| {
+                                self.exposes_tool(&ToolName::namespaced(&name, leaf))
+                            })
+                        });
+                        !members.is_empty()
+                    } else {
+                        self.exposes_tool(&ToolName::plain(name))
+                    }
+                });
+                true
+            }
+            _ => true,
+        }
+    }
+
     pub(crate) fn deferred_tool_namespaces(&self) -> BTreeMap<String, String> {
         self.registry.deferred_tool_namespaces()
     }
