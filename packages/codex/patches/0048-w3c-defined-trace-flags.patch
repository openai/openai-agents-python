+    #[test]
+    fn defined_trace_flags_survive_child_header_propagation() {
+        use super::span_w3c_trace_context;
+        use tracing_opentelemetry::OpenTelemetrySpanExt;
+
+        for flags in ["00", "01", "02", "03"] {
+            let provider = SdkTracerProvider::builder().build();
+            let subscriber = tracing_subscriber::registry()
+                .with(tracing_opentelemetry::layer().with_tracer(provider.tracer("flags")));
+            tracing::subscriber::with_default(subscriber, || {
+                let parent =
+                    format!("00-11111111111111111111111111111111-2222222222222222-{flags}");
+                let context =
+                    context_from_trace_headers(Some(&parent), Some("vendor=value")).unwrap();
+                assert_eq!(
+                    context.span().span_context().trace_flags().to_u8(),
+                    u8::from_str_radix(flags, 16).unwrap()
+                );
+                let span = tracing::info_span!("child");
+                super::set_parent_from_context(&span, context);
+                let headers = span_w3c_trace_context(&span).unwrap();
+                let header = headers.traceparent.unwrap();
+                assert_eq!(&header[3..35], &parent[3..35]);
+                assert_eq!(&header[53..], flags);
+                assert_ne!(&header[36..52], &parent[36..52]);
+                let grandchild = tracing::info_span!("grandchild");
+                super::set_parent_from_context(&grandchild, span.context());
+                let grandchild_header = span_w3c_trace_context(&grandchild)
+                    .unwrap()
+                    .traceparent
+                    .unwrap();
+                assert_eq!(&grandchild_header[3..35], &parent[3..35]);
+                assert_eq!(&grandchild_header[53..], flags);
+                assert_ne!(&grandchild_header[36..52], &header[36..52]);
+                assert_eq!(headers.tracestate.as_deref(), Some("vendor=value"));
+            });
+        }
+        assert!(
+            context_from_trace_headers(
+                Some("00-00000000000000000000000000000000-2222222222222222-03"),
+                None
+            )
+            .is_none()
+        );
+        assert!(context_from_trace_headers(Some("00-bad-2222222222222222-03"), None).is_none());
+    }
