+    use codex_protocol::realtime_settings::RealtimeSessionUpdate;
+    use codex_protocol::realtime_settings::RealtimeV2SessionSettings;
+    let (manager, sdk) = sdk_manager("settings-1");
+    let invalid = RealtimeSessionUpdate {
+        settings: RealtimeV2SessionSettings {
+            output_speed: Some(f64::NAN),
+            ..Default::default()
+        },
+        ..Default::default()
+    };
+    assert!(
+        manager
+            .sdk_enqueue("settings-1", SdkRealtimeCommand::Update(invalid))
+            .await
+            .is_err()
+    );
+    assert!(sdk.commands_rx.is_empty());
+    assert!(sdk.active.load(std::sync::atomic::Ordering::Acquire));
+    let valid = RealtimeSessionUpdate::default();
+    manager
+        .sdk_enqueue("settings-1", SdkRealtimeCommand::Update(valid.clone()))
+        .await
+        .unwrap();
+    assert!(matches!(
+        sdk.commands_rx.try_recv().unwrap(),
+        SdkRealtimeCommand::Update(_)
+    ));
+    manager
+        .state
+        .lock()
+        .await
+        .conversation
+        .as_mut()
+        .unwrap()
+        .handoff
+        .event_parser = RealtimeEventParser::V1;
+    assert!(
+        manager
+            .sdk_enqueue("settings-1", SdkRealtimeCommand::Update(valid))
+            .await
+            .is_err()
+    );
+    assert!(sdk.commands_rx.is_empty());
+    assert!(sdk.active.load(std::sync::atomic::Ordering::Acquire));
+}
