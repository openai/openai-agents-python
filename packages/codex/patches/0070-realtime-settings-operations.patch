+//! Typed public Realtime V2 settings. Omitted update fields retain provider state.
+use std::collections::BTreeMap;
+
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+
+use crate::protocol::RealtimeOutputModality;
+
+// serde's ordinary nested Option decoding collapses a present null into None.
+fn present_nullable<'de, D, T>(deserializer: D) -> Result<Option<Option<T>>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+    T: Deserialize<'de>,
+{
+    Option::<T>::deserialize(deserializer).map(Some)
+}
+
+/// Optional initial overrides and sparse updates. Nullable fields distinguish omission from disabling.
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+pub struct RealtimeV2SessionSettings {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub input_format: Option<RealtimeAudioFormat>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub output_format: Option<RealtimeAudioFormat>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "present_nullable"
+    )]
+    pub noise_reduction: Option<Option<RealtimeNoiseReduction>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "present_nullable"
+    )]
+    pub transcription: Option<Option<RealtimeTranscription>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "present_nullable"
+    )]
+    pub turn_detection: Option<Option<RealtimeTurnDetection>>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub output_voice: Option<RealtimeOutputVoice>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub output_speed: Option<f64>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "present_nullable"
+    )]
+    pub prompt: Option<Option<RealtimePrompt>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "present_nullable"
+    )]
+    pub tracing: Option<Option<RealtimeProviderTracing>>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub max_output_tokens: Option<RealtimeMaxOutputTokens>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub parallel_tool_calls: Option<bool>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub reasoning: Option<RealtimeReasoning>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+pub struct RealtimeSessionUpdate {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub model: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub instructions: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub output_modality: Option<RealtimeOutputModality>,
+    #[serde(flatten)]
+    pub settings: RealtimeV2SessionSettings,
+}
+
+/// Canonical wire formats; PCM is always 24 kHz and G.711 has no rate field.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum RealtimeAudioFormat {
+    #[serde(rename = "pcm16")]
+    Pcm24k,
+    #[serde(rename = "g711_ulaw")]
+    G711Ulaw,
+    #[serde(rename = "g711_alaw")]
+    G711Alaw,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum RealtimeNoiseReduction {
+    NearField,
+    FarField,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+pub struct RealtimeTranscription {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub model: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub language: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub prompt: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub keywords: Option<Vec<String>>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub languages: Option<Vec<String>>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub delay: Option<RealtimeTranscriptionDelay>,
+}
