+#[tokio::test]
+async fn sdk_settings_update_is_sparse_and_fenced_by_generation() {
+    use super::SdkRealtimeCommand;
+    use codex_protocol::realtime_settings::RealtimeSessionUpdate;
+    use codex_protocol::realtime_settings::RealtimeV2SessionSettings;
+    let (connection, mut wire, server) = sdk_wire_connection().await;
+    assert_eq!(wire.recv().await.unwrap()["type"], "session.update");
+    let (manager, sdk) = sdk_manager("settings-1");
+    let update = RealtimeSessionUpdate {
+        settings: RealtimeV2SessionSettings {
+            output_speed: Some(1.25),
+            turn_detection: Some(None),
+            ..Default::default()
+        },
+        ..Default::default()
+    };
+    assert!(
+        manager
+            .sdk_enqueue("old-generation", SdkRealtimeCommand::Update(update.clone()))
+            .await
+            .is_err()
+    );
+    assert!(sdk.commands_rx.is_empty());
+    manager
+        .sdk_enqueue("settings-1", SdkRealtimeCommand::Update(update.clone()))
+        .await
+        .unwrap();
+    let handoff = manager
+        .state
+        .lock()
+        .await
+        .conversation
+        .as_ref()
+        .unwrap()
+        .handoff
+        .clone();
+    let mut responses = super::RealtimeResponseCreateQueue::default();
+    super::handle_sdk_realtime_command(
+        sdk.commands_rx.recv().await,
+        &connection.writer(),
+        &handoff,
+        &mut responses,
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        wire.recv().await.unwrap(),
+        serde_json::json!({
+            "type": "session.update", "session": {"type": "realtime", "audio": {
+                "input": {"turn_detection": null}, "output": {"speed": 1.25}
+            }}
+        })
+    );
+    // A command accepted before retirement must not reach this or a later connection.
+    manager
+        .sdk_enqueue("settings-1", SdkRealtimeCommand::Update(update))
+        .await
+        .unwrap();
+    sdk.active
+        .store(false, std::sync::atomic::Ordering::Release);
+    super::handle_sdk_realtime_command(
+        sdk.commands_rx.recv().await,
+        &connection.writer(),
+        &handoff,
+        &mut responses,
+    )
+    .await
+    .unwrap();
+    assert!(
+        tokio::time::timeout(std::time::Duration::from_millis(20), wire.recv())
+            .await
+            .is_err()
+    );
+    connection.close().await.unwrap();
+    server.await.unwrap();
+}
