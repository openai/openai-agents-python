{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {}
  },
  "release-type": "python",
  "versioning": "prerelease",
  "prerelease": true,
  "prerelease-type": "alpha",
  "skip-github-release": true,
  "changelog-path": "CHANGELOG-alpha.md",
  "always-update": true,
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "draft-pull-request": false,
  "pull-request-title-pattern": "release: ${version}",
  "pull-request-header": "Private alpha release candidate. Qualify the exact commit and publish its Tests artifacts manually. See .github/RELEASING.md.",
  "extra-files": [
    {
      "type": "toml",
      "path": "uv.lock",
      "jsonpath": "$.package[?(@.name.value=='openai-agents')].version"
    },
    "src/agents/version.py"
  ],
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    }
  ]
}
