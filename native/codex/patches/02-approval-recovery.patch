+    CancellableReader {
+        reader: reader.take(max_bytes + 1),
+        cancelled,
+    }
+    .read_to_end(&mut bytes)?;
+    if bytes.len() as u64 > max_bytes {
+        return Err(file_too_large_error(max_bytes));
+    }
