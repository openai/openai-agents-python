+//! Resume one direct native tool through the ordinary user review and tool runtime.
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+use std::sync::{Arc, OnceLock, Weak};
+
+use codex_file_system::EnvironmentAccess;
+use codex_protocol::config_types::ApprovalsReviewer;
+use codex_protocol::error::{CodexErr, Result};
+use codex_protocol::models::ResponseItem;
+use codex_protocol::openai_models::ToolMode;
+use codex_protocol::protocol::{EventMsg, FileChange, ReviewDecision};
+use futures::future::BoxFuture;
+use serde_json::Value;
+use tokio_util::sync::CancellationToken;
+
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::session::turn_context::TurnContext;
+use crate::tools::ApprovalContext;
+use crate::tools::sandboxing::{ApprovalAction, ToolCtx};
+
+/// The first pre-execution request. The lease expires when review returns.
+pub struct FirstApproval<'a> {
+    pub call_id: &'a str,
+    pub changes: Option<&'a HashMap<PathBuf, FileChange>>,
+    pub live: Weak<()>,
+}
+
+/// A host may refuse an action or redact the review event. It cannot modify
+/// the executable action, skip policy review, or grant a decision here.
+pub trait ApprovalCheck: Send + Sync {
+    fn check<'a>(
+        &'a self,
+        policy: Value,
+        fs: &'a dyn EnvironmentAccess,
+        first: Option<FirstApproval<'a>>,
+    ) -> BoxFuture<'a, Result<()>>;
+    fn review(&self, event: &mut EventMsg) -> bool;
+}
+
+pub struct NativeApproval {
+    check: Arc<dyn ApprovalCheck>,
+    call: Option<ResponseItem>,
+    owner: OnceLock<String>,
+    requested: OnceLock<()>,
+    approved: OnceLock<()>,
+    attempted: OnceLock<()>,
+}
+
+fn refused() -> CodexErr {
+    CodexErr::InvalidRequest("Cannot restore this native approval under current policy.".into())
+}
+
+impl NativeApproval {
+    pub fn new(check: Arc<dyn ApprovalCheck>, call: Option<ResponseItem>) -> Self {
+        Self {
+            check,
+            call,
+            owner: OnceLock::new(),
+            requested: OnceLock::new(),
+            approved: OnceLock::new(),
+            attempted: OnceLock::new(),
+        }
+    }
+
+    pub(crate) fn is_patch(&self) -> bool {
+        matches!(self.call, Some(ResponseItem::CustomToolCall { .. }))
+    }
+
+    async fn check(
+        &self,
+        session: &Session,
+        step: &StepContext,
+        first: Option<FirstApproval<'_>>,
+    ) -> Result<()> {
+        let env = step
+            .environments
+            .single_local_environment()
+            .ok_or_else(refused)?;
+        let turn = &step.turn;
+        let config = session.get_config().await;
+        let requirements = config.config_layer_stack.requirements();
+        let hooks = session.hooks().list_with_environment_hooks(
+            crate::hook_environment_executor::environment_hook_sources(&step.environments, &[]),
+        );
+        if requirements.auto_review_required_for_model(&step.settings.model_info.slug)
+            || requirements
+                .approvals_reviewer
+                .can_set(&ApprovalsReviewer::User)
+                .is_err()
+            || step.tool_router.tool_mode() != ToolMode::Direct
+            || step.settings.approvals_reviewer() != ApprovalsReviewer::User
+            || turn.strict_auto_review_enabled()
+            || !hooks.hooks.is_empty()
+            || !hooks.warnings.is_empty()
+            || !step.executor_hook_sources.is_empty()
+        {
+            return Err(refused());
+        }
+        let grants = turn.granted_permissions(&env.selection.environment_id);
+        let policy = serde_json::json!({
+            "approval_policy": step.settings.approval_policy(), "reviewer": step.settings.approvals_reviewer(),
+            "managed_network": turn.config.permissions.network.as_ref().map(|net| net.environment_policy()),
+            "environments": [{
+                "id": env.selection.environment_id,
+                "profile": env.permission_profile_with_workspace_roots(),
+                "symbolic_profile": env.permission_profile(),
+                "network": env.config().network_policy, "grants": grants,
+            }],
+        });
+        self.check
+            .check(policy, &env.fs_accessor(grants), first)
+            .await
+    }
+
+    pub(crate) async fn run(
+        &self,
+        session: Arc<Session>,
+        turn: Arc<TurnContext>,
+        cancellation: CancellationToken,
+    ) -> crate::tasks::SessionTaskResult {
+        self.owner.set(turn.sub_id.clone()).map_err(|_| refused())?;
+        let item = self.call.as_ref().ok_or_else(refused)?;
+        let namespace = match item {
+            ResponseItem::FunctionCall {
+                name, namespace, ..
+            } if name == "exec_command" => namespace,
+            ResponseItem::CustomToolCall {
+                name, namespace, ..
+            } if name == "apply_patch" => namespace,
+            _ => return Err(refused()),
+        };
+        if namespace.as_deref().is_some_and(|ns| ns != "functions") {
+            return Err(refused());
+        }
+        session
+            .emit_turn_started(&turn, crate::state::TaskKind::Regular)
+            .await;
+        let step = session.capture_step_context(turn, &cancellation).await?;
+        self.check(&session, &step, None).await?;
+        let call = crate::tools::router::ToolRouter::build_tool_call(item.clone())
+            .map_err(|_| refused())?
+            .ok_or_else(refused)?;
+        if !step.tool_router.exposes_tool(&call.tool_name) {
+            return Err(refused());
+        }
+        use crate::stream_events_utils::record_completed_response_item;
+        record_completed_response_item(&session, &step, item).await;
+        let result = crate::tools::parallel::ToolCallRuntime::new(
+            session.clone(),
+            step.clone(),
+            Default::default(),
+        )
+        .handle_tool_call(call, cancellation)
+        .await?;
+        record_completed_response_item(&session, &step, &result.item).await;
+        Ok(None)
+    }
+}
+
+pub(crate) fn restore(turn: &TurnContext) -> Option<Arc<NativeApproval>> {
+    turn.extension_data
+        .get::<NativeApproval>()
+        .filter(|r| r.call.is_some())
+}
+
+pub(crate) fn active(turn: &TurnContext) -> Option<Arc<NativeApproval>> {
+    restore(turn).filter(|r| r.owner.get() == Some(&turn.sub_id))
+}
+
+pub(crate) fn allowed(ctx: &ApprovalContext, action: &ApprovalAction) -> bool {
+    let Some(restore) = restore(ctx.review_context.turn()) else {
+        return true;
+    };
+    restore.owner.get() == Some(&ctx.review_context.turn().sub_id)
+        && ctx.retry_reason.is_none()
+        && ctx.network_approval_context.is_none()
+        && !ctx.strict_auto_review
+        && restore.requested.get().is_none()
+        && matches!((&restore.call, action),
+            (Some(ResponseItem::FunctionCall { call_id, .. }), ApprovalAction::ExecCommand { .. })
+            | (Some(ResponseItem::CustomToolCall { call_id, .. }), ApprovalAction::ApplyPatch { .. })
+                if call_id == &ctx.call_id)
+}
+
+// Called only at the first NeedsApproval, never on a retry or network prompt.
+pub(crate) async fn capture(ctx: &ToolCtx, action: &ApprovalAction) -> Option<Arc<()>> {
+    let step = &ctx.step_context;
+    let approval = step.turn.extension_data.get::<NativeApproval>()?;
+    if approval.call.is_some() {
+        return None;
+    }
+    let changes = match action {
+        ApprovalAction::ExecCommand { .. } => None,
+        ApprovalAction::ApplyPatch { changes, .. } => Some(changes.as_ref()),
+        _ => return None,
+    };
+    let lease = Arc::new(());
+    let first = FirstApproval {
+        call_id: &ctx.call_id,
+        changes,
+        live: Arc::downgrade(&lease),
+    };
+    approval.check(&ctx.session, step, Some(first)).await.ok()?;
+    Some(lease)
+}
+
+pub(crate) fn review(turn: &TurnContext, event: &mut EventMsg) -> bool {
+    let Some(approval) = turn.extension_data.get::<NativeApproval>() else {
+        return true;
+    };
+    if approval.call.is_some()
+        && (approval.owner.get() != Some(&turn.sub_id) || approval.requested.set(()).is_err())
+    {
+        return false;
+    }
+    approval.check.review(event)
+}
+
+pub(crate) fn decision(turn: &TurnContext, decision: ReviewDecision) -> ReviewDecision {
+    let Some(approval) = active(turn) else {
+        return decision;
+    };
+    match decision {
+        ReviewDecision::Approved
+            if approval.requested.get().is_some() && approval.approved.set(()).is_ok() =>
+        {
+            decision
+        }
+        ReviewDecision::Denied { .. } => decision,
+        _ => ReviewDecision::Abort,
+    }
+}
+
+pub(crate) async fn validate_before_execution(ctx: &ToolCtx) -> Result<()> {
+    if let Some(approval) = active(&ctx.step_context.turn) {
+        if approval.approved.get().is_none() || approval.attempted.set(()).is_err() {
+            return Err(refused());
+        }
+        approval
+            .check(&ctx.session, &ctx.step_context, None)
+            .await?;
+    }
+    Ok(())
+}
